(task-entry (id "random/distributions/standard-normal-quantile") (skill random) (module distributions) (tier 1) (difficulty 12915) (name standard-normal-quantile) (type "(-> Number Number)") (description "Standard normal quantile via rational approximation") (notes ()) (section standard-normal) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs*)) (answer "(define (standard-normal-quantile p) (if (or (<= p 0) (>= p 1)) (error 'standard-normal-quantile \"p must be in (0,1)\" p) (let* ((sign (if (< p 0.5) -1 1)) (p* (if (< p 0.5) p (- 1 p))) (t (sqrt (* -2 (log-num p*))))) (* sign (- t (/ (horner-eval *quantile-num-coeffs* t) (horner-eval *quantile-den-coeffs* t)))))))"))
(task-entry (id "random/probability/sample") (skill random) (module probability) (tier 1) (difficulty 12915) (name sample) (type "") (description "") (notes ()) (section sampling-from-distributions) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap)) (answer "(define (sample dist) (make-prob (make-state (lambda (ps) (let* ((prng (car ps)) (weight (cdr ps)) (result (run-state dist prng)) (value (car result)) (new-prng (cdr result))) (cons value (cons new-prng weight)))))))"))
