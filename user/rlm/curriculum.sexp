(task-entry (id "data/kdtree/kdtree-build") (skill data) (module kdtree) (tier 0) (difficulty 1312) (name kdtree-build) (type "(-> (List Point) KDTree)") (description "Build k-d tree from list of points. O(n log² n) using sorting-based median.\nPoints must all have the same dimensionality. Note: True O(n log n) would require\nlinear-time median selection (median-of-medians); this implementation uses sorting.") (notes ()) (section construction) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance)) (answer "(define (kdtree-build points) (if (null? points) kdtree-empty (let ((k (point-dimension (car points)))) (kdtree-build-rec points k 0))))"))
