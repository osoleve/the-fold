(task-entry (id "control-systems/controller-design/complementary-sensitivity-tf") (skill control-systems) (module controller-design) (tier 2) (difficulty 22644) (name complementary-sensitivity-tf) (type "TF × TF → TF") (description "Compute complementary sensitivity T(s) = G(s)C(s)/(1 + G(s)C(s))") (notes ("S + T = 1")) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local dlqr solve-dare lqg hinf-norm vector-max hinf-bounded? closed-loop-tf sensitivity-tf)) (answer "(define (complementary-sensitivity-tf plant controller) (closed-loop-tf plant controller))"))
(task-entry (id "control-systems/hinf-synthesis/poly-eval-complex") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22644) (name poly-eval-complex) (type "Poly × Complex → Complex") (description "Evaluate polynomial at complex value using Horner's method") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm ss->tf ss-numerator-poly ss-eval-complex matrix-scale-complex matrix-sub-scalar-diag matrix-inverse-complex matrix-mul-complex matrix-ref-complex)) (answer "(define (poly-eval-complex poly s) (let* ((coeffs (poly-coeffs poly)) (n (vector-length coeffs))) (let loop ((i 0) (result (make-complex 0 0))) (if (>= i n) result (loop (+ i 1) (complex-add (complex-mul result s) (make-complex (vector-ref coeffs i) 0)))))))"))
(task-entry (id "control-systems/poly-algebra/tf-coprime?") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22644) (name tf-coprime?) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify tf-simplify-exact routh-array-exact make-routh-row routh-array-exact-iter make-routh-new-row routh-hurwitz-exact has-sign-changes-exact? tf-char-poly tf-char-poly-factored tf-bezout)) (answer "(define (tf-coprime? tf) (let* ((num-alg (numeric->algebra-poly (tf-num tf) Q-field)) (den-alg (numeric->algebra-poly (tf-den tf) Q-field)) (gcd-alg (alg-poly-gcd num-alg den-alg))) (<= (alg-poly-degree gcd-alg) 0)))"))
(task-entry (id "control-systems/stability/stability-report") (skill control-systems) (module stability) (tier 2) (difficulty 22645) (name stability-report) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols matrix-hcat-list controllable? observability-matrix build-observability-rows matrix-vcat-list observable? stability-matrix-rank matrix-copy matrix-swap-rows! pi)) (answer "(define (stability-report tf) (let* ((poles (tf-poles tf)) (stable (tf-stable? tf)) (rh-stable (routh-hurwitz-stable? (tf-den tf))) (margins (stability-margins tf)) (gm (car margins)) (pm (cadr margins))) (string-append \"=== Stability Report ===\n\" \"Poles: \" (poles->string poles) \"\n\" \"Pole-based stable: \" (if stable \"YES\" \"NO\") \"\n\" \"Routh-Hurwitz stable: \" (if rh-stable \"YES\" \"NO\") \"\n\" \"Gain margin: \" (if (eq? gm 'infinite) \"infinite\" (number->string gm)) \" dB\n\" \"Phase margin: \" (if (eq? pm 'infinite) \"infinite\" (number->string pm)) \" deg\n\")))"))
(task-entry (id "control-systems/controller-design/lead-compensator") (skill control-systems) (module controller-design) (tier 2) (difficulty 22645) (name lead-compensator) (type "Number × Number × Number → TF") (description "Create a lead compensator: C(s) = Kc * (s + z)/(s + p) where z < p. Lead compensators add phase lead at crossover frequency") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local dlqr solve-dare lqg hinf-norm vector-max hinf-bounded? closed-loop-tf sensitivity-tf complementary-sensitivity-tf)) (answer "(define (lead-compensator Kc zero pole) (tf-from-lists (list Kc (* Kc zero)) (list 1 pole)))"))
(task-entry (id "control-systems/hinf-synthesis/poly-from-complex-samples") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22645) (name poly-from-complex-samples) (type "(List Complex) × (List Complex) × Nat → Poly") (description "Fit polynomial to complex samples using least squares.\n  Given samples (s_k, y_k) where y_k = p(s_k), recover polynomial p of given degree.\n  Uses the structure of purely imaginary samples to extract real coefficients.\n\n  For p(s) = c_n*s^n + ... + c_1*s + c_0 evaluated at s = iω:\n    Re[p(iω)] uses even powers: c_0 - c_2*ω² + c_4*ω⁴ - ...\n    Im[p(iω)] uses odd powers:  c_1*ω - c_3*ω³ + c_5*ω⁵ - ...") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm ss->tf ss-numerator-poly ss-eval-complex matrix-scale-complex matrix-sub-scalar-diag matrix-inverse-complex matrix-mul-complex matrix-ref-complex poly-eval-complex)) (answer "(define (poly-from-complex-samples s-vals num-vals degree) (let* ((n degree) (n-coeffs (+ n 1)) (n-samples (length s-vals)) (A (make-matrix (* 2 n-samples) n-coeffs 0)) (b (make-vector (* 2 n-samples) 0))) (let fill-loop ((k 0) (s-rest s-vals) (y-rest num-vals)) (if (or (null? s-rest) (null? y-rest)) (let ((coeffs-vec (matrix-least-squares A b))) (if (and (pair? coeffs-vec) (eq? (car coeffs-vec) 'error)) (make-poly (vector (complex-real (car num-vals)))) (make-poly coeffs-vec))) (let* ((s (car s-rest)) (y (car y-rest)) (omega (complex-imag s)) (y-re (complex-real y)) (y-im (complex-imag y)) (row-re (* 2 k)) (row-im (+ (* 2 k) 1))) (vector-set! b row-re y-re) (vector-set! b row-im y-im) (do ((j 0 (+ j 1))) ((= j n-coeffs)) (let* ((power (- n j)) (i^pow-re (ipow-real power)) (i^pow-im (ipow-imag power)) (omega^pow (expt omega power)) (contrib-re (* i^pow-re omega^pow)) (contrib-im (* i^pow-im omega^pow))) (matrix-set! A row-re j contrib-re) (matrix-set! A row-im j contrib-im))) (fill-loop (+ k 1) (cdr s-rest) (cdr y-rest)))))))"))
(task-entry (id "control-systems/poly-algebra/tf-canceled-poles") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22645) (name tf-canceled-poles) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify tf-simplify-exact routh-array-exact make-routh-row routh-array-exact-iter make-routh-new-row routh-hurwitz-exact has-sign-changes-exact? tf-char-poly tf-char-poly-factored tf-bezout tf-coprime?)) (answer "(define (tf-canceled-poles tf) (let* ((num-alg (numeric->algebra-poly (tf-num tf) Q-field)) (den-alg (numeric->algebra-poly (tf-den tf) Q-field)) (gcd-alg (alg-poly-gcd num-alg den-alg))) (if (> (alg-poly-degree gcd-alg) 0) (list (algebra->numeric-poly gcd-alg)) '())))"))
