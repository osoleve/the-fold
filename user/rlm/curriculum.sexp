(task-entry (id "fp/proof-tactics/prove-with-tactics") (skill fp) (module proof-tactics) (tier 1) (difficulty 10652) (name prove-with-tactics) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;engine \x27;rewrite/laws)) (available (make-proof-goal proof-goal? goal-lhs goal-rhs goal-context goal-trivial? tactic-success tactic-failure tactic-success? tactic-failure? tactic-subgoals tactic-builder tactic-error tactic-refl tactic-sym tactic-trans tactic-rewrite tactic-topdown tactic-bottomup tactic-try *tactic-repeat-fuel* tactic-repeat fold-proofs tactic-then build-combined-proof take-n drop-n tactic-orelse tactic-id tactic-fail *auto-laws-base* *auto-law-categories* *auto-laws-extra* register-auto-law! register-auto-category! unregister-auto-category! auto-laws auto-laws-by-category *auto-laws* tactic-auto *search-max-depth* expr->key tactic-search search-dfs strategy->tactic law->tactic simplify-tactic tactic-simplify tactic-arith tactic-monoid tactic-functor tactic-monad)) (answer "(define (prove-with-tactics lhs rhs tactics) (let ((initial-goal (make-proof-goal lhs rhs '()))) (let loop ((current-goal initial-goal) (remaining tactics) (builders '())) (cond ((goal-trivial? current-goal) (quasiquote (ok (unquote (fold-proofs (reverse builders) '()))))) ((null? remaining) (if (goal-trivial? current-goal) (quasiquote (ok (unquote (fold-proofs (reverse builders) '())))) (quasiquote (error (remaining-goal (unquote current-goal)))))) (else (let* ((tactic (car remaining)) (result (tactic current-goal))) (if (tactic-failure? result) (quasiquote (error (unquote (tactic-error result)))) (let ((subgoals (tactic-subgoals result)) (builder (tactic-builder result))) (if (null? subgoals) (quasiquote (ok (unquote (fold-proofs (cons builder (reverse builders)) '())))) (loop (car subgoals) (cdr remaining) (cons builder builders)))))))))))"))
