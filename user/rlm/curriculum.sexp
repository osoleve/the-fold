(task-entry (id "game-theory/mcdm/sorting-algorithm-example") (skill game-theory) (module mcdm) (tier 1) (difficulty 13232) (name sorting-algorithm-example) (type "") (description "") (notes ()) (section examples) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index list-update robustness-profile min-robustness has-condorcet-cycle? cycle-participants method-agreement unanimous-winner? mcdm-summary)) (answer "(define (sorting-algorithm-example) (make-decision-problem '(quicksort mergesort heapsort insertion-sort) '(avg-time worst-time memory stability) '((quicksort avg-time 4) (quicksort worst-time 1) (quicksort memory 4) (quicksort stability 1) (mergesort avg-time 3) (mergesort worst-time 4) (mergesort memory 1) (mergesort stability 4) (heapsort avg-time 2) (heapsort worst-time 3) (heapsort memory 3) (heapsort stability 2) (insertion-sort avg-time 1) (insertion-sort worst-time 2) (insertion-sort memory 4) (insertion-sort stability 4))))"))
(task-entry (id "game-theory/extensive-form/entry-deterrence") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13233) (name entry-deterrence) (type "") (description "") (notes ()) (section classic-games) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game make-centipede-game centipede-4)) (answer "(define entry-deterrence (make-extensive-game 2 (make-decision 0 '(enter stay-out) (list (make-decision 1 '(fight accommodate) (list (make-terminal '(-1 -1)) (make-terminal '(2 2)))) (make-terminal '(0 5))))))"))
(task-entry (id "game-theory/coop-games/extract-nucleolus-allocation") (skill game-theory) (module coop-games) (tier 1) (difficulty 13233) (name extract-nucleolus-allocation) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions)) (answer "(define (extract-nucleolus-allocation g n v-grand fixed-constraints) (let* ((is-cost (coop-game-cost? g)) (num-constraints (+ 1 (length fixed-constraints))) (A (make-matrix num-constraints n 0)) (b (make-vector num-constraints 0))) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! A 0 i 1)) (vector-set! b 0 v-grand) (let loop ((constraints fixed-constraints) (row 1)) (if (null? constraints) (let ((result (matrix-least-squares A b))) (if (pair? result) (shapley-value g 10000) result)) (let* ((constraint (car constraints)) (S (car constraint)) (eps (cdr constraint)) (v-S (coop-game-value g S))) (do ((i 0 (+ i 1))) ((= i n)) (when (coalition-member? i S) (matrix-set! A row i 1))) (vector-set! b row (if is-cost (+ v-S eps) (- v-S eps))) (loop (cdr constraints) (+ row 1)))))))"))
(task-entry (id "game-theory/matching/stable-match-receiver-optimal") (skill game-theory) (module matching) (tier 1) (difficulty 13233) (name stable-match-receiver-optimal) (type "") (description "") (notes ()) (section optimal-assignment) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank)) (answer "(define (stable-match-receiver-optimal market fuel) (let ((reversed-market (make-matching-market% (market-receivers market) (market-proposers market) (matching-market%-r-prefs market) (matching-market%-p-prefs market)))) (let ((matching (stable-match reversed-market fuel))) (map (lambda (pair) (cons (cdr pair) (car pair))) matching))))"))
(task-entry (id "game-theory/voting/minimax-winner") (skill game-theory) (module voting) (tier 1) (difficulty 13233) (name minimax-winner) (type "") (description "") (notes ()) (section minimax-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score)) (answer "(define (minimax-winner profile) (if (profile-empty? profile) #f (argmax (lambda (c) (minimax-score c profile)) (profile-candidates profile))))"))
(task-entry (id "game-theory/multi-winner/cc-total-satisfaction") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13233) (name cc-total-satisfaction) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction cc-greedy cc-loop cc-marginal-score)) (answer "(define (cc-total-satisfaction profile committee) (let ((num-candidates (if (null? profile) 0 (length (car profile))))) (apply + (map (lambda (ranking) (best-satisfaction ranking committee num-candidates)) profile))))"))
(task-entry (id "game-theory/fair-division/find-value-endpoint") (skill game-theory) (module fair-division) (tier 1) (difficulty 13233) (name find-value-endpoint) (type "") (description "") (notes ()) (section selfridge-conway) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim)) (answer "(define (find-value-endpoint c i start target fuel) (binary-search-cut-from c i start target start 1 fuel))"))
(task-entry (id "game-theory/mechanism/k-double-auction") (skill game-theory) (module mechanism) (tier 1) (difficulty 13233) (name k-double-auction) (type "(-> (Vector Number) (Vector Number) Number DoubleAuctionOutcome)") (description "k-double auction: price = k × (marginal winning bid) + (1-k) × (marginal winning ask)") (notes ("k=0: seller's price (highest winning ask). k=1: buyer's price (lowest winning bid). k=0.5: split the difference. Only k=0.5 is budget-balanced in expectation.")) (section double-auction) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations vcg-enumerate-helper pivot-mechanism myerson-virtual-value optimal-reserve-uniform)) (answer "(define (k-double-auction buyer-bids seller-asks k) (let* ((sorted-buyers (sort-by > (vector->list buyer-bids))) (sorted-sellers (sort-by < (vector->list seller-asks))) (qty (let loop ((b sorted-buyers) (s sorted-sellers) (q 0)) (if (or (null? b) (null? s) (< (car b) (car s))) q (loop (cdr b) (cdr s) (+ q 1)))))) (if (= qty 0) (make-double-auction-outcome% '() 0 0 0) (let* ((clearing-buyer (list-ref sorted-buyers (- qty 1))) (clearing-seller (list-ref sorted-sellers (- qty 1))) (price (+ (* k clearing-buyer) (* (- 1 k) clearing-seller))) (buyer-surplus (let loop ((bids sorted-buyers) (n qty) (sum 0)) (if (= n 0) sum (loop (cdr bids) (- n 1) (+ sum (- (car bids) price)))))) (seller-surplus (let loop ((asks sorted-sellers) (n qty) (sum 0)) (if (= n 0) sum (loop (cdr asks) (- n 1) (+ sum (- price (car asks)))))))) (make-double-auction-outcome% (list (list 'aggregate-trade price qty)) buyer-surplus seller-surplus qty)))))"))
(task-entry (id "game-theory/evolutionary/incumbent-fitness") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13233) (name incumbent-fitness) (type "") (description "") (notes ()) (section invasion) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge is-ess? find-all-ess is-nash-equilibrium? find-pure-nash can-invade? invasion-fitness)) (answer "(define (incumbent-fitness game incumbent mutant epsilon) (let ((aii (sg-payoff game incumbent incumbent)) (aij (sg-payoff game incumbent mutant))) (+ (* (- 1 epsilon) aii) (* epsilon aij))))"))
(task-entry (id "game-theory/mcdm/tech-choice-example") (skill game-theory) (module mcdm) (tier 1) (difficulty 13233) (name tech-choice-example) (type "") (description "") (notes ()) (section examples) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index list-update robustness-profile min-robustness has-condorcet-cycle? cycle-participants method-agreement unanimous-winner? mcdm-summary sorting-algorithm-example)) (answer "(define (tech-choice-example) (make-decision-problem '(react vue svelte) '(performance ecosystem learning-curve bundle-size) '((react performance 3) (react ecosystem 5) (react learning-curve 2) (react bundle-size 2) (vue performance 4) (vue ecosystem 3) (vue learning-curve 4) (vue bundle-size 3) (svelte performance 5) (svelte ecosystem 2) (svelte learning-curve 3) (svelte bundle-size 5))))"))
(task-entry (id "game-theory/extensive-form/stackelberg-simple") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13234) (name stackelberg-simple) (type "") (description "") (notes ()) (section classic-games) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game make-centipede-game centipede-4 entry-deterrence)) (answer "(define stackelberg-simple (let* ((quantities '(1 2 3 4)) (payoff (lambda (q1 q2) (let ((total (+ q1 q2))) (* q1 (max 0 (- 10 total)))))) (make-follower-decision (lambda (q1) (make-decision 1 quantities (map (lambda (q2) (make-terminal (list (payoff q1 q2) (payoff q2 q1)))) (map (lambda (q) (+ q 1)) (iota 4))))))) (make-extensive-game 2 (make-decision 0 quantities (map make-follower-decision (map (lambda (q) (+ q 1)) (iota 4)))))))"))
(task-entry (id "game-theory/coop-games/bargaining-set") (skill game-theory) (module coop-games) (tier 1) (difficulty 13234) (name bargaining-set) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation)) (answer "(define (bargaining-set g) (if (not (= 2 (coop-game-players g))) (error 'bargaining-set \"requires 2-player game\") (let* ((v0 (coop-game-value g 1)) (v1 (coop-game-value g 2)) (v01 (coop-game-value g 3)) (u0 (- v01 v1)) (u1 (- v01 v0))) (vector v0 v1 u0 u1))))"))
(task-entry (id "game-theory/matching/same-matched-agents?") (skill game-theory) (module matching) (tier 1) (difficulty 13234) (name same-matched-agents?) (type "") (description "") (notes ()) (section optimal-assignment) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank stable-match-receiver-optimal)) (answer "(define (same-matched-agents? matching1 matching2) (let ((props1 (sort-by symbol<? (map car matching1))) (props2 (sort-by symbol<? (map car matching2))) (recvs1 (sort-by symbol<? (map cdr matching1))) (recvs2 (sort-by symbol<? (map cdr matching2)))) (and (equal? props1 props2) (equal? recvs1 recvs2))))"))
(task-entry (id "game-theory/voting/minimax-ranking") (skill game-theory) (module voting) (tier 1) (difficulty 13234) (name minimax-ranking) (type "") (description "") (notes ()) (section minimax-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score minimax-winner)) (answer "(define (minimax-ranking profile) (sort-by (lambda (a b) (> (minimax-score a profile) (minimax-score b profile))) (profile-candidates profile)))"))
(task-entry (id "game-theory/multi-winner/proportionality-score") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13234) (name proportionality-score) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction cc-greedy cc-loop cc-marginal-score cc-total-satisfaction)) (answer "(define (proportionality-score profile committee) (if (or (profile-empty? profile) (null? committee)) 0 (let* ((num-candidates (length (car profile))) (sats (map (lambda (ranking) (best-satisfaction ranking committee num-candidates)) profile)) (max-sat (- num-candidates 1)) (normalized (map (lambda (s) (if (> max-sat 0) (/ s max-sat) 1)) sats)) (mean (/ (apply + normalized) (length normalized))) (variance (/ (apply + (map (lambda (x) (expt (- x mean) 2)) normalized)) (length normalized)))) (max 0 (- 1 (* 2 (sqrt variance)))))))"))
(task-entry (id "game-theory/fair-division/argmax") (skill game-theory) (module fair-division) (tier 1) (difficulty 13234) (name argmax) (type "") (description "") (notes ()) (section selfridge-conway) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint)) (answer "(define (argmax lst) (let loop ((lst (cdr lst)) (i 1) (max-val (car lst)) (max-idx 0)) (cond ((null? lst) max-idx) ((> (car lst) max-val) (loop (cdr lst) (+ i 1) (car lst) i)) (else (loop (cdr lst) (+ i 1) max-val max-idx)))))"))
