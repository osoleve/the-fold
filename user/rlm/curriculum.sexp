(task-entry (id "numeric/convolution/normalize-signal") (skill numeric) (module convolution) (tier 0) (difficulty 2511) (name normalize-signal) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;vec)) (available (convolve-direct-full convolve-direct-same convolve-direct-valid convolve-fft convolve correlate-direct correlate autocorrelate matched-filter find-peaks vector-reverse)) (answer "(define (normalize-signal signal) (let ((n (vector-length signal))) (if (= n 0) (vector) (let* ((sum 0) (mean 0) (var-sum 0) (variance 0) (stddev 0) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n)) (set! sum (+ sum (vector-ref signal i)))) (set! mean (/ sum n)) (do ((i 0 (+ i 1))) ((= i n)) (let ((diff (- (vector-ref signal i) mean))) (set! var-sum (+ var-sum (* diff diff))))) (set! variance (/ var-sum n)) (set! stddev (sqrt variance)) (if (< stddev 1e-10) result (begin (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (/ (- (vector-ref signal i) mean) stddev)))))))))"))
(task-entry (id "numeric/wavelet/dwt") (skill numeric) (module wavelet) (tier 0) (difficulty 2511) (name dwt) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (haar-scaling-filter haar-wavelet-filter daubechies-4-scaling-filter qmf-wavelet-from-scaling daubechies-4-wavelet-filter daubechies-6-scaling-filter daubechies-6-wavelet-filter reverse-filter convolve-downsample upsample-convolve dwt-step)) (answer "(define (dwt signal levels h g) (let loop ((current signal) (level 0) (details '())) (if (= level levels) (cons current details) (let* ((result (dwt-step current h g)) (approx (car result)) (detail (cdr result))) (loop approx (+ level 1) (cons detail details))))))"))
(task-entry (id "numeric/spectral-analysis/spectral-bandwidth") (skill numeric) (module spectral-analysis) (tier 0) (difficulty 2511) (name spectral-bandwidth) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;window-functions)) (available (stft-frame stft istft spectrogram power-spectrogram log-spectrogram periodogram welch-psd spectrogram-frequencies spectrogram-times spectral-centroid)) (answer "(define (spectral-bandwidth freqs power-spectrum centroid) (let ((n (vector-length power-spectrum))) (let loop ((k 0) (weighted-variance 0) (total-power 0)) (if (= k n) (if (< total-power 1e-10) 0 (sqrt (/ weighted-variance total-power))) (let ((freq (vector-ref freqs k)) (power (vector-ref power-spectrum k)) (diff (- (vector-ref freqs k) centroid))) (loop (+ k 1) (+ weighted-variance (* diff diff power)) (+ total-power power)))))))"))
