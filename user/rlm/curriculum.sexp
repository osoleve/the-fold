(task-entry (id "fp/simplify/simplify-pythagorean-identity") (skill fp) (module simplify) (tier 1) (difficulty 10632) (name simplify-pythagorean-identity) (type "(-> (List Expr) Expr)") (description "Apply Pythagorean identity: sin^2(x) + cos^2(x) = 1") (notes ()) (section trigonometric-identities) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow simplify-app expand expand-once expand-product expand-power-of-sum factor factor-sum find-common-factor get-factors divides? divide-out simplify-trig simplify-trig-once)) (answer "(define (simplify-pythagorean-identity terms) (let loop ((remaining terms) (checked '())) (if (null? remaining) (make-sum-from-list (reverse checked)) (let ((sin-sq-match (find-sin-squared (car remaining))) (cos-sq (find-matching-cos-squared (car remaining) (cdr remaining)))) (if cos-sq (let ((new-terms (cons (num 1) (append (reverse checked) (remove-first cos-sq (cdr remaining)))))) (simplify-pythagorean-identity new-terms)) (loop (cdr remaining) (cons (car remaining) checked)))))))"))
