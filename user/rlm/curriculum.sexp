(task-entry (id "diffgeo/symbolic-metrics/cylindrical-christoffel-exact") (skill diffgeo) (module symbolic-metrics) (tier 1) (difficulty 10715) (name cylindrical-christoffel-exact) (type "(-> Vec ChristoffelTensor)") (description "Pre-computed Christoffel symbols for cylindrical coordinates") (notes ("Non-zero: Γ^ρ_{φφ} = -ρ, Γ^φ_{ρφ} = Γ^φ_{φρ} = 1/ρ" "Returns +inf.0 at ρ=0 (coordinate singularity)")) (section metric-derivative-protocol) (deps (\x27;curvature)) (available (metric-symbolic? make-metric-symbolic metric-symbolic-deriv-fn metric-chart* metric-fn* metric-dim* metric-at* make-polar-metric-exact make-spherical-metric-exact make-cylindrical-metric-exact make-euclidean-metric-exact christoffel-symbols-exact christoffel-symbols* polar-christoffel-exact spherical-christoffel-exact)) (answer "(define (cylindrical-christoffel-exact coords) (let* ((rho (vector-ref coords 0)) (inv-rho (/ 1.0 rho)) (gamma (make-vector 3 #f))) (let ((gr (make-vector 3 #f))) (vector-set! gr 0 (vector 0 0 0)) (vector-set! gr 1 (vector 0 (- rho) 0)) (vector-set! gr 2 (vector 0 0 0)) (vector-set! gamma 0 gr)) (let ((gp (make-vector 3 #f))) (vector-set! gp 0 (vector 0 inv-rho 0)) (vector-set! gp 1 (vector inv-rho 0 0)) (vector-set! gp 2 (vector 0 0 0)) (vector-set! gamma 1 gp)) (let ((gz (make-vector 3 #f))) (vector-set! gz 0 (vector 0 0 0)) (vector-set! gz 1 (vector 0 0 0)) (vector-set! gz 2 (vector 0 0 0)) (vector-set! gamma 2 gz)) gamma))"))
