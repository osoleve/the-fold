(task-entry (id "statistics/summary-stats/vec-kurtosis") (skill statistics) (module summary-stats) (tier 1) (difficulty 11229) (name vec-kurtosis) (type "(-> Vec Num)") (description "Excess kurtosis (vector version)") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max vec-median vec-quantile vec-quantiles vec-covariance vec-correlation sem vec-sem skewness kurtosis vec-skewness)) (answer "(define (vec-kurtosis v) (let* ((n (vector-length v)) (mu (vec-mean v)) (m2 (let loop ((i 0) (s 0)) (if (= i n) (/ s n) (let ((d (- (vector-ref v i) mu))) (loop (+ i 1) (+ s (* d d))))))) (sigma (sqrt m2)) (m4 (let loop ((i 0) (s 0)) (if (= i n) (/ s n) (let ((d (- (vector-ref v i) mu))) (loop (+ i 1) (+ s (* d d d d)))))))) (if (= sigma 0) 0 (- (/ m4 (* sigma sigma sigma sigma)) 3))))"))
