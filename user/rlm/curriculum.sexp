(task-entry (id "sim/bifurcation/orient-tangent") (skill sim) (module bifurcation) (tier 2) (difficulty 23328) (name orient-tangent) (type "(-> (Pair Vec Number) (Pair Vec Number) (Pair Vec Number))") (description "Orient new tangent to point in same direction as old tangent") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix)) (answer "(define (orient-tangent new-tangent old-tangent) (let* ((dot (+ (vec-dot (car new-tangent) (car old-tangent)) (* (cdr new-tangent) (cdr old-tangent))))) (if (< dot 0) (cons (vec-scale -1.0 (car new-tangent)) (- (cdr new-tangent))) new-tangent)))"))
