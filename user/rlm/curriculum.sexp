(task-entry (id "random/bayesian/normal-normal-posterior") (skill random) (module bayesian) (tier 1) (difficulty 12913) (name normal-normal-posterior) (type "") (description "") (notes ()) (section conjugate-prior-normal-normal-known-variance) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance)) (answer "(define (normal-normal-posterior prior sample-mean n known-variance) (let* ((mu0 (normal-prior-mean prior)) (tau0 (/ 1 (normal-prior-variance prior))) (tau (/ 1 known-variance)) (tau-n (+ tau0 (* n tau))) (mu-n (/ (+ (* tau0 mu0) (* n tau sample-mean)) tau-n)) (variance-n (/ 1 tau-n))) (make-normal-prior mu-n variance-n)))"))
(task-entry (id "random/monte-carlo/rejection-sample") (skill random) (module monte-carlo) (tier 1) (difficulty 12913) (name rejection-sample) (type "") (description "") (notes ()) (section rejection-sampling) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample)) (answer "(define (rejection-sample target-density M proposal-sampler proposal-density) (make-state (lambda (gen) (let loop ((g gen)) (let* ((result1 (run-state proposal-sampler g)) (x (car result1)) (g1 (cdr result1)) (result2 (run-state random-float g1)) (u (car result2)) (g2 (cdr result2)) (acceptance-prob (/ (target-density x) (* M (proposal-density x))))) (if (< u acceptance-prob) (cons x g2) (loop g2)))))))"))
