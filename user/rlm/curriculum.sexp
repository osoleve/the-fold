(task-entry (id "optimization/optimize/rosenbrock") (skill optimization) (module optimize) (tier 1) (difficulty 12804) (name rosenbrock) (type "(-> (List Number) Number)") (description "Rosenbrock function: f(x,y) = (1-x)^2 + 100*(y-x^2)^2") (notes ("Minimum at (1, 1) with f = 0")) (section test-functions) (deps (\x27;prelude \x27;convergence \x27;line-search \x27;first-order \x27;newton \x27;lbfgs)) (available (minimize minimize-bounded find-learning-rate minimize-callback)) (answer "(define (rosenbrock args) (let ((x (car args)) (y (cadr args))) (+ (* (- 1 x) (- 1 x)) (* 100 (- y (* x x)) (- y (* x x))))))"))
