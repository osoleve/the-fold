(task-entry (id "random/probability/sample-many") (skill random) (module probability) (tier 1) (difficulty 12935) (name sample-many) (type "") (description "") (notes ()) (section inference-primitives) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist condition assume sample-once)) (answer "(define (sample-many p seed n) (if (<= n 0) '() (let loop ((prng (make-pcg seed 1)) (count n) (acc '())) (if (= count 0) (reverse acc) (let* ((result (run-prob p prng)) (value (car (car result))) (new-prng (cdr result))) (loop new-prng (- count 1) (cons value acc)))))))"))
(task-entry (id "random/bayesian/kl-divergence-normal") (skill random) (module bayesian) (tier 1) (difficulty 12935) (name kl-divergence-normal) (type "") (description "") (notes ()) (section variational-inference-elbo-computation) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode log-beta-pdf log-beta log-normal-pdf log-gamma-pdf log-poisson-pmf log-factorial)) (answer "(define (kl-divergence-normal q p) (let* ((mu-q (normal-prior-mean q)) (var-q (normal-prior-variance q)) (mu-p (normal-prior-mean p)) (var-p (normal-prior-variance p)) (sigma-q (sqrt var-q)) (sigma-p (sqrt var-p)) (diff (- mu-q mu-p))) (+ (- (log sigma-p) (log sigma-q)) (/ (+ var-q (* diff diff)) (* 2 var-p)) -0.5)))"))
(task-entry (id "random/monte-carlo/integrated-autocorrelation-time") (skill random) (module monte-carlo) (tier 1) (difficulty 12935) (name integrated-autocorrelation-time) (type "") (description "") (notes ()) (section convergence-diagnostics) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate antithetic-integrate control-variate-estimate stratified-sample effective-sample-size split-into-batches gelman-rubin autocorrelation)) (answer "(define (integrated-autocorrelation-time samples) (let* ((n (length samples)) (max-lag (min 100 (quotient n 4)))) (let loop ((k 1) (sum 0.5)) (if (>= k max-lag) (* 2 sum) (let ((rho-k (autocorrelation samples k))) (if (< (abs rho-k) 0.05) (* 2 sum) (loop (+ k 1) (+ sum rho-k))))))))"))
(task-entry (id "random/variational-inference/traced-log-normal-pdf-sum") (skill random) (module variational-inference) (tier 1) (difficulty 12935) (name traced-log-normal-pdf-sum) (type "") (description "") (notes ()) (section traced-log-joint-construction) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf)) (answer "(define (traced-log-normal-pdf-sum observations t-mu variance) (let ((log-norm-const (make-traced-const (* -0.5 (log (* 2 3.141592653589793 variance))) #f)) (half (make-traced-const 0.5 #f)) (var-const (make-traced-const variance #f))) (let loop ((obs observations) (acc (make-traced-const 0.0 #f))) (if (null? obs) acc (let* ((xi (car obs)) (xi-const (make-traced-const xi #f)) (diff (traced-sub xi-const t-mu)) (diff-sq (traced-mul diff diff)) (scaled (traced-div diff-sq var-const)) (term (traced-sub log-norm-const (traced-mul half scaled)))) (loop (cdr obs) (traced-add acc term)))))))"))
