(task-entry (id "control-systems/stability/ss-stable?") (skill control-systems) (module stability) (tier 2) (difficulty 22601) (name ss-stable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles)) (answer "(define (ss-stable? sys) (let ((poles (ss-poles sys))) (all? (lambda (p) (< (complex-real p) 0)) poles)))"))
(task-entry (id "control-systems/controller-design/pid-design-zn-open-loop") (skill control-systems) (module controller-design) (tier 2) (difficulty 22601) (name pid-design-zn-open-loop) (type "Number × Number × Number → (Kp Ki Kd)") (description "Ziegler-Nichols open-loop tuning from step response") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf)) (answer "(define (pid-design-zn-open-loop K L T) (let* ((Kp (* (/ 1.2 K) (/ T L))) (Ti (* 2 L)) (Td (* 0.5 L)) (Ki (/ Kp Ti)) (Kd (* Kp Td))) (list Kp Ki Kd)))"))
