(task-entry (id "info/entropy/gaussian-entropy") (skill info) (module entropy) (tier 1) (difficulty 11119) (name gaussian-entropy) (type "(-> Number Number)") (description "Differential entropy of Gaussian with standard deviation sigma") (notes ()) (section differential-entropy) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy conditional-entropy-direct mutual-information mutual-information-from-joint compute-marginal-x compute-marginal-y cross-entropy kl-divergence symmetric-kl jensen-shannon-divergence)) (answer "(define (gaussian-entropy sigma) (let ((e-val (exp-num 1))) (* 0.5 (log2 (* 2 (pi-value) e-val (* sigma sigma))))))"))
(task-entry (id "info/statistical-measures/valid-distribution?") (skill info) (module statistical-measures) (tier 1) (difficulty 11119) (name valid-distribution?) (type "(-> (List Real) Boolean)") (description "Check if list is a valid probability distribution") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared jeffreys-divergence alpha-divergence squared-hellinger-distance triangular-discrimination pearson-divergence neyman-divergence k-divergence squared-loss euclidean-distance matusita-distance fidelity all-divergences)) (answer "(define (valid-distribution? p) (and (not (null? p)) (andmap (lambda (pi) (>= pi 0)) p) (let ((sum (fold-left + 0 p))) (< (abs (- sum 1.0)) 1e-6))))"))
