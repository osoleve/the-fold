(task-entry (id "physics/classical3d/collision-detection3d/aabb-to-cells-3d") (skill physics/classical3d) (module collision-detection3d) (tier 2) (difficulty 22430) (name aabb-to-cells-3d) (type "") (description "") (notes ()) (section point-in-shape-tests) (deps (\x27;prelude \x27;vec3 \x27;shapes3d)) (available (point-in-aabb3d? point-in-sphere3d? point-in-box3d? closest-point-on-segment-3d closest-point-on-aabb3d closest-point-on-box3d sphere-sphere? sphere-sphere-manifold aabb3d-aabb3d? aabb3d-aabb3d-manifold sphere-aabb3d? sphere-aabb3d-manifold sphere-inside-aabb-normal sphere-box3d? sphere-box3d-manifold sphere-inside-box-normal box3d-box3d? box3d-box3d-manifold shape-type-3d shape-aabb-3d shapes-collide-3d? shapes-manifold-3d manifold-normal manifold-penetration manifold-contact cell-key-3d make-spatial-hash-3d spatial-hash-3d-cell-size spatial-hash-3d-table point-to-cell-3d)) (answer "(define (aabb-to-cells-3d aabb cell-size) (let* ((min-cell (point-to-cell-3d (aabb3d-min aabb) cell-size)) (max-cell (point-to-cell-3d (aabb3d-max aabb) cell-size)) (min-x (car min-cell)) (min-y (cadr min-cell)) (min-z (caddr min-cell)) (max-x (car max-cell)) (max-y (cadr max-cell)) (max-z (caddr max-cell))) (let x-loop ((x min-x) (cells '())) (if (> x max-x) cells (x-loop (+ x 1) (let y-loop ((y min-y) (cells cells)) (if (> y max-y) cells (y-loop (+ y 1) (let z-loop ((z min-z) (cells cells)) (if (> z max-z) cells (z-loop (+ z 1) (cons (list x y z) cells))))))))))))"))
