(task-entry (id "topology/simplicial-complex/sc-add-simplex") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11824) (name sc-add-simplex) (type "(-> SC Simplex SC)") (description "Add a simplex and all its faces to the complex") (notes ("This ensures the closure property is maintained")) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list?)) (answer "(define (sc-add-simplex sc s) (let loop ((sc sc) (to-add (cons s (simplex-proper-faces s)))) (if (null? to-add) sc (loop (sc-add-simplex-only sc (car to-add)) (cdr to-add)))))"))
(task-entry (id "topology/homology/sc-homology-summary") (skill topology) (module homology) (tier 1) (difficulty 11824) (name sc-homology-summary) (type "(-> SC Void)") (description "Print a summary of the homology of a simplicial complex") (notes ()) (section betti-numbers) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti sc-betti-numbers)) (answer "(define (sc-homology-summary sc) (let* ((betti (sc-betti-numbers sc)) (euler (sc-euler sc)) (f-vec (sc-f-vector sc))) (printf \"~n=== Homology Summary ===~n\") (printf \"f-vector:      ~a~n\" f-vec) (printf \"Betti numbers: ~a~n\" betti) (printf \"Euler char:    ~a~n\" euler) (let ((euler-from-betti (let loop ((bs betti) (k 0) (sum 0)) (if (null? bs) sum (loop (cdr bs) (+ k 1) (+ sum (* (if (even? k) 1 -1) (car bs)))))))) (printf \"X from B:      ~a~n\" euler-from-betti) (unless (= euler euler-from-betti) (printf \"WARNING: Euler characteristic mismatch!~n\"))) (printf \"========================~n\")))"))
