(task-entry (id "meta/inspect/first-line") (skill meta) (module inspect) (tier 1) (difficulty 11902) (name first-line) (type "") (description "") (notes ()) (section none) (deps ()) (available (lattice-describe lattice-describe-pretty)) (answer "(define (first-line str) (if (not (string? str)) \"\" (let ((len (string-length str))) (let loop ((i 0)) (cond ((>= i len) (string-trim str)) ((char=? (string-ref str i) #\\\n) (let ((line (string-trim (substring str 0 i)))) (if (string=? line \"\") (first-line (substring str (+ i 1) len)) line))) (else (loop (+ i 1))))))))"))
