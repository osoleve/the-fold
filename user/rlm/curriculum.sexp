(task-entry (id "algebra/tropical/adjacency->tropical") (skill algebra) (module tropical) (tier 0) (difficulty 323) (name adjacency->tropical) (type "") (description "") (notes ()) (section conversion-utilities) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add tropical-matrix-power tropical-matrix-closure tropical-eigenvalue tropical-critical-edges tropical-poly-eval newton-polygon trim-hull tropical-poly-roots)) (answer "(define (adjacency->tropical sr adj) (let* ((n (matrix-rows adj)) (zero (semiring-zero sr)) (data (make-vector (* n n) zero))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let ((idx (+ (* i n) j)) (val (matrix-ref adj i j))) (cond ((= i j) (vector-set! data idx val)) ((and (number? val) (zero? val)) (vector-set! data idx zero)) ((and (number? val) (>= val 1e308)) (vector-set! data idx zero)) (else (vector-set! data idx val)))))) (list 'matrix n n data)))"))
(task-entry (id "algebra/group/list-set") (skill algebra) (module group) (tier 0) (difficulty 324) (name list-set) (type "(-> List Integer Value List)") (description "Functional update of list at index") (notes ()) (section permutation-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse)) (answer "(define (list-set lst idx val) (let loop ((i 0) (rest lst) (acc '())) (if (null? rest) (reverse acc) (loop (+ i 1) (cdr rest) (cons (if (= i idx) val (car rest)) acc)))))"))
(task-entry (id "algebra/ring/make-ring-zn") (skill algebra) (module ring) (tier 0) (difficulty 324) (name make-ring-zn) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product is-commutative-ring? is-zero-divisor? has-zero-divisors? is-integral-domain? is-unit? ring-units)) (answer "(define (make-ring-zn n) (let ((elements (range 0 n))) (make-ring elements (lambda (a b) (modulo (+ a b) n)) (lambda (a b) (modulo (* a b) n)) 0 1 (lambda (a) (modulo (- a) n)) =)))"))
(task-entry (id "algebra/field/make-field-zp") (skill algebra) (module field) (tier 0) (difficulty 324) (name make-field-zp) (type "") (description "") (notes ()) (section field-representation) (deps (\x27;prelude \x27;ring)) (available (make-field make-field* field? field-elements field-add-op field-mul-op field-zero field-one field-neg-fn field-div-fn field-equal-fn field-metadata field-meta-ref field-add field-mul field-neg field-sub field-div field-inv field-equal? field-power field->ring Q-field R-field)) (answer "(define (make-field-zp p) (make-field* (if (< p 1000000) (range 0 p) '()) (lambda (a b) (modulo (+ a b) p)) (lambda (a b) (modulo (* a b) p)) 0 1 (lambda (a) (modulo (- a) p)) (lambda (a b) (modulo (* a (mod-inverse b p)) p)) = (quasiquote ((order unquote p) (characteristic unquote p)))))"))
(task-entry (id "algebra/polynomial/poly-divmod-loop") (skill algebra) (module polynomial) (tier 0) (difficulty 324) (name poly-divmod-loop) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod)) (answer "(define (poly-divmod-loop remainder divisor quotient F) (let ((d-rem (poly-degree remainder)) (d-div (poly-degree divisor))) (if (or (poly-zero? remainder) (< d-rem d-div)) (cons quotient remainder) (let* ((lc-rem (poly-leading-coeff remainder)) (lc-div (poly-leading-coeff divisor)) (coeff (field-div F lc-rem lc-div)) (deg-diff (- d-rem d-div)) (term (poly-monomial F coeff deg-diff)) (new-quotient (poly-add quotient term)) (subtrahend (poly-mul term divisor)) (new-remainder (poly-sub remainder subtrahend))) (poly-divmod-loop new-remainder divisor new-quotient F)))))"))
