(task-entry (id "statistics/ar/ar-forecast-se") (skill statistics) (module ar) (tier 1) (difficulty 11206) (name ar-forecast-se) (type "") (description "") (notes ()) (section ar-model-fitting) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (ar-fit center-series make-toeplitz-matrix ar-compute-diagnostics ar-predict-one ar-forecast)) (answer "(define (ar-forecast-se phi sigma h) (let* ((p (vector-length phi)) (psi (make-vector h 0)) (se (make-vector h))) (vector-set! psi 0 1) (do ((j 1 (+ j 1))) ((= j h)) (let ((sum (let loop ((k 1) (s 0)) (if (or (> k p) (> k j)) s (loop (+ k 1) (+ s (* (vector-ref phi (- k 1)) (vector-ref psi (- j k))))))))) (vector-set! psi j sum))) (do ((t 0 (+ t 1))) ((= t h) se) (let ((var (* sigma sigma (let loop ((j 0) (s 0)) (if (> j t) s (loop (+ j 1) (+ s (expt (vector-ref psi j) 2)))))))) (vector-set! se t (sqrt var))))))"))
