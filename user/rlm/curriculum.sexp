)) (map (lambda (pair) (cons (car pair) (lambda args (wrap-op (car pair) (apply (cdr pair) args))))) (dict-ops base-dict))))"))
(task-entry (id "topology/simplicial-complex/simplex-dim") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11806) (name simplex-dim) (type "(-> Simplex Integer)") (description "Get the dimension of a simplex (number of vertices - 1)") (notes ("A 0-simplex (single vertex) has dimension 0")) (section simplex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices)) (answer "(define (simplex-dim s) (- (length (simplex-vertices s)) 1))"))
(task-entry (id "topology/homology/z2-matrix-set!") (skill topology) (module homology) (tier 1) (difficulty 11806) (name z2-matrix-set!) (type "(-> Z2Matrix Integer Integer Integer Void)") (description "Mutate matrix entry (used during Gaussian elimination)") (notes ()) (section z2-matrix-operations) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref)) (answer "(define (z2-matrix-set! m i j v) (vector-set! (z2-matrix-data m) (+ (* i (z2-matrix-cols m)) j) (mod v 2)))"))
