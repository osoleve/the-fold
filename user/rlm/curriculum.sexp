(task-entry (id "sim/ode-system/ode-system?") (skill sim) (module ode-system) (tier 2) (difficulty 23300) (name ode-system?) (type "(-> Any Bool)") (description "Check if value is an ODE system") (notes ()) (section ode-system-representation) (deps (\x27;prelude \x27;vec \x27;matrix)) (available ()) (answer "(define (ode-system? sys) (and (pair? sys) (eq? (car sys) 'ode-system) (= (length sys) 4) (procedure? (cadr sys)) (integer? (caddr sys)) (boolean? (cadddr sys))))"))
(task-entry (id "sim/stability/find-fixed-point-newton") (skill sim) (module stability) (tier 2) (difficulty 23300) (name find-fixed-point-newton) (type "(-> Any Any Number Number Nat Any)") (description "Find a fixed point using Newton's method") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available ()) (answer "(define (find-fixed-point-newton sys initial-guess tolerance step-size max-iter) (let loop ((x initial-guess) (iter 0)) (if (>= iter max-iter) #f (let* ((fx (eval-vector-field sys 0 x)) (norm-fx (vec-norm fx))) (if (< norm-fx tolerance) x (let* ((jac (compute-jacobian sys x step-size)) (jac-inv (matrix-invert-simple jac)) (delta (matrix-vec-mul jac-inv fx)) (x-new (vec-sub x delta))) (loop x-new (+ iter 1))))))))"))
(task-entry (id "sim/chaos/rk4-step") (skill sim) (module chaos) (tier 2) (difficulty 23300) (name rk4-step) (type "(-> ODE Number Vec Number Vec)") (description "Single RK4 integration step") (notes ()) (section rk4-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available ()) (answer "(define (rk4-step sys t state dt) (let* ((k1 (eval-vector-field sys t state)) (k2 (eval-vector-field sys (+ t (/ dt 2)) (vec-add state (vec-scale (/ dt 2) k1)))) (k3 (eval-vector-field sys (+ t (/ dt 2)) (vec-add state (vec-scale (/ dt 2) k2)))) (k4 (eval-vector-field sys (+ t dt) (vec-add state (vec-scale dt k3))))) (vec-add state (vec-scale (/ dt 6) (vec-add k1 (vec-add (vec-scale 2 k2) (vec-add (vec-scale 2 k3) k4)))))))"))
(task-entry (id "sim/bifurcation/any") (skill sim) (module bifurcation) (tier 2) (difficulty 23300) (name any) (type "(-> (-> α Boolean) (List α) Boolean)") (description "Return #t if pred is true for any element") (notes ()) (section utilities) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available ()) (answer "(define (any pred lst) (cond ((null? lst) #f) ((pred (car lst)) #t) (else (any pred (cdr lst)))))"))
