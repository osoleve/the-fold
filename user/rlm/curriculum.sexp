(task-entry (id "numeric/pde-time/backward-euler-linear-step") (skill numeric) (module pde-time) (tier 0) (difficulty 2510) (name backward-euler-linear-step) (type "") (description "") (notes ()) (section backward-euler) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step)) (answer "(define (backward-euler-linear-step M A u b dt tol max-iter) (let* ((n (sparse-csr-rows M)) (LHS (sparse-csr-add M (sparse-csr-scale (- dt) A))) (Mu (sparse-csr-vec-mul M u)) (RHS (pde-vec-madd Mu dt b)) (result (sparse-cg-solve LHS RHS u tol max-iter))) (values (car result) (cadr result) (caddr result))))"))
