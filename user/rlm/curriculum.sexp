(task-entry (id "fp/proof-tactics/fold-proofs") (skill fp) (module proof-tactics) (tier 1) (difficulty 10622) (name fold-proofs) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;engine \x27;rewrite/laws)) (available (make-proof-goal proof-goal? goal-lhs goal-rhs goal-context goal-trivial? tactic-success tactic-failure tactic-success? tactic-failure? tactic-subgoals tactic-builder tactic-error tactic-refl tactic-sym tactic-trans tactic-rewrite tactic-topdown tactic-bottomup tactic-try *tactic-repeat-fuel* tactic-repeat)) (answer "(define (fold-proofs builders proofs) (if (null? builders) (if (null? proofs) '(refl) (car proofs)) (let ((b (car builders)) (rest (fold-proofs (cdr builders) proofs))) (if (procedure? b) (guard (exn (else (b (list rest)))) (b)) rest))))"))
