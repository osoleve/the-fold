(task-entry (id "game-theory/voting/for-all?") (skill game-theory) (module voting) (tier 1) (difficulty 13208) (name for-all?) (type "") (description "") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=?)) (answer "(define (for-all? pred lst) (or (null? lst) (and (pred (car lst)) (for-all? pred (cdr lst)))))"))
(task-entry (id "game-theory/strategic-voting/price-of-anarchy") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13208) (name price-of-anarchy) (type "(-> PreferenceProfile VotingRule (Union Number Symbol))") (description "Price of anarchy: truthful welfare / worst equilibrium welfare. Measures social cost of strategic behavior") (notes ()) (section price-of-anarchy) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium all-strategic-equilibria cartesian-product-n)) (answer "(define (price-of-anarchy true-profile voting-rule) (let* ((truthful-winner (voting-rule true-profile)) (truthful-welfare (social-welfare truthful-winner true-profile)) (equilibria (all-strategic-equilibria true-profile voting-rule))) (if (null? equilibria) 'no-equilibrium (let* ((eq-welfares (map (lambda (eq) (social-welfare (voting-rule eq) true-profile)) equilibria)) (worst-welfare (apply min eq-welfares))) (if (= worst-welfare 0) +inf.0 (/ truthful-welfare worst-welfare))))))"))
(task-entry (id "game-theory/voting-games/banzhaf-weighted") (skill game-theory) (module voting-games) (tier 1) (difficulty 13208) (name banzhaf-weighted) (type "") (description "") (notes ()) (section power-indices) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power)) (answer "(define (banzhaf-weighted profile weights) (let* ((game (profile->weighted-voting-game profile weights)) (n (profile-voters profile)) (fuel (* n (expt 2 n)))) (banzhaf-index game fuel)))"))
(task-entry (id "game-theory/multi-winner/stv") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13208) (name stv) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes)) (answer "(define (stv profile num-seats quota-fn) (if (profile-empty? profile) '() (let* ((candidates (profile-candidates profile)) (num-voters (profile-voters profile)) (quota (quota-fn num-voters num-seats)) (ballots (map make-weighted-ballot profile))) (stv-loop ballots candidates '() num-seats quota))))"))
(task-entry (id "game-theory/fair-division/piece-empty") (skill game-theory) (module fair-division) (tier 1) (difficulty 13208) (name piece-empty) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece)) (answer "(define piece-empty '())"))
(task-entry (id "game-theory/mechanism/bids-winners") (skill game-theory) (module mechanism) (tier 1) (difficulty 13208) (name bids-winners) (type "(-> (Vector Number) (List Nat))") (description "List of bidders with the maximum bid (handles ties)") (notes ()) (section bid-representation) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max)) (answer "(define (bids-winners bids) (let* ((n (bids-length bids)) (max-bid (bids-max bids))) (filter (lambda (i) (= (bids-ref bids i) max-bid)) (iota n))))"))
(task-entry (id "game-theory/evolutionary/stag-hunt-symmetric") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13208) (name stag-hunt-symmetric) (type "") (description "") (notes ()) (section classic-symmetric-games) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game)) (answer "(define stag-hunt-symmetric (make-symmetric-game '(stag hare) '((4 0) (3 3))))"))
(task-entry (id "game-theory/mcdm/criterion-ranking") (skill game-theory) (module mcdm) (tier 1) (difficulty 13208) (name criterion-ranking) (type "(-> DecisionProblem Criterion (List Alternative))") (description "Rank alternatives by score on a single criterion (highest score first)") (notes ()) (section criterion-ranking) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar)) (answer "(define (criterion-ranking dp criterion) (let ((alts (dp-alternatives dp))) (sort-by (lambda (a b) (> (dp-score dp a criterion) (dp-score dp b criterion))) alts)))"))
(task-entry (id "game-theory/normal-form/chicken") (skill game-theory) (module normal-form) (tier 1) (difficulty 13209) (name chicken) (type "") (description "") (notes ()) (section classic-games) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt)) (answer "(define chicken (make-game '(dare swerve) '(dare swerve) '(((0 . 0) (7 . 2)) ((2 . 7) (6 . 6)))))"))
(task-entry (id "game-theory/extensive-form/decision-child") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13209) (name decision-child) (type "(-> DecisionNode Symbol Node)") (description "Get the child node reached by taking action") (notes ()) (section node-types) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children)) (answer "(define (decision-child node action) (let loop ((as (decision-actions node)) (cs (decision-children node))) (cond ((null? as) (error 'decision-child \"action not found\" action)) ((eq? (car as) action) (car cs)) (else (loop (cdr as) (cdr cs))))))"))
(task-entry (id "game-theory/coop-games/list->coalition") (skill game-theory) (module coop-games) (tier 1) (difficulty 13209) (name list->coalition) (type "(-> (List Nat) Coalition)") (description "Convert list of player indices to coalition") (notes ()) (section coalition-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list)) (answer "(define (list->coalition players) (fold-left coalition-union coalition-empty (map coalition-singleton players)))"))
(task-entry (id "game-theory/matching/market-num-receivers") (skill game-theory) (module matching) (tier 1) (difficulty 13209) (name market-num-receivers) (type "") (description "") (notes ()) (section matching-market-data-structures) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers)) (answer "(define (market-num-receivers m) (vector-length (market-receivers m)))"))
(task-entry (id "game-theory/voting/position-of") (skill game-theory) (module voting) (tier 1) (difficulty 13209) (name position-of) (type "") (description "") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all?)) (answer "(define (position-of x lst) (let loop ((lst lst) (i 0)) (cond ((null? lst) #f) ((equal? (car lst) x) i) (else (loop (cdr lst) (+ i 1))))))"))
(task-entry (id "game-theory/strategic-voting/price-of-stability") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13209) (name price-of-stability) (type "(-> PreferenceProfile VotingRule (Union Number Symbol))") (description "Price of stability: truthful welfare / best equilibrium welfare. Measures best-case cost of strategic behavior") (notes ()) (section price-of-anarchy) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium all-strategic-equilibria cartesian-product-n price-of-anarchy)) (answer "(define (price-of-stability true-profile voting-rule) (let* ((truthful-winner (voting-rule true-profile)) (truthful-welfare (social-welfare truthful-winner true-profile)) (equilibria (all-strategic-equilibria true-profile voting-rule))) (if (null? equilibria) 'no-equilibrium (let* ((eq-welfares (map (lambda (eq) (social-welfare (voting-rule eq) true-profile)) equilibria)) (best-welfare (apply max eq-welfares))) (if (= best-welfare 0) +inf.0 (/ truthful-welfare best-welfare))))))"))
(task-entry (id "game-theory/voting-games/voter-is-dictator?") (skill game-theory) (module voting-games) (tier 1) (difficulty 13209) (name voter-is-dictator?) (type "(-> PreferenceProfile Nat Boolean)") (description "Is voter i a dictator? (singleton coalition is winning)") (notes ()) (section power-analysis) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted)) (answer "(define (voter-is-dictator? profile voter-idx) (let ((game (profile->majority-game profile))) (is-winning? game (coalition-singleton voter-idx))))"))
(task-entry (id "game-theory/multi-winner/stv-loop") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13209) (name stv-loop) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv)) (answer "(define (stv-loop ballots remaining elected seats-left quota) (cond ((= seats-left 0) (reverse elected)) ((<= (length remaining) seats-left) (reverse (append (reverse remaining) elected))) (else (let* ((vote-counts (count-votes ballots remaining)) (sorted (sort-by (lambda (a b) (> (cdr a) (cdr b))) vote-counts)) (top-candidate (caar sorted)) (top-votes (cdar sorted))) (if (>= top-votes quota) (let* ((surplus (- top-votes quota)) (transfer-value (if (> top-votes 0) (/ surplus top-votes) 0)) (new-ballots (transfer-surplus ballots top-candidate transfer-value remaining)) (new-remaining (remove top-candidate remaining))) (stv-loop new-ballots new-remaining (cons top-candidate elected) (- seats-left 1) quota)) (let* ((bottom-candidate (caar (reverse sorted))) (new-ballots (transfer-eliminated ballots bottom-candidate remaining)) (new-remaining (remove bottom-candidate remaining))) (stv-loop new-ballots new-remaining elected seats-left quota)))))))"))
(task-entry (id "game-theory/fair-division/piece-singleton") (skill game-theory) (module fair-division) (tier 1) (difficulty 13209) (name piece-singleton) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty)) (answer "(define (piece-singleton a b) (list (cons a b)))"))
(task-entry (id "game-theory/mechanism/make-auction-outcome") (skill game-theory) (module mechanism) (tier 1) (difficulty 13209) (name make-auction-outcome) (type "(-> (U Nat (List Nat)) (U Number (Vector Number)) AuctionOutcome)") (description "Create an auction outcome with winner(s) and payment(s)") (notes ()) (section auction-outcome) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners)) (answer "(define (make-auction-outcome winner payment) (let ((revenue (if (vector? payment) (let loop ((i 0) (sum 0)) (if (>= i (vector-length payment)) sum (loop (+ i 1) (+ sum (vector-ref payment i))))) payment))) (make-auction-outcome% winner payment revenue)))"))
(task-entry (id "game-theory/evolutionary/pd-symmetric") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13209) (name pd-symmetric) (type "") (description "") (notes ()) (section classic-symmetric-games) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric)) (answer "(define pd-symmetric (make-symmetric-game '(cooperate defect) '((3 0) (5 1))))"))
(task-entry (id "game-theory/mcdm/dp->profile") (skill game-theory) (module mcdm) (tier 1) (difficulty 13209) (name dp->profile) (type "(-> DecisionProblem PreferenceProfile)") (description "Convert decision problem to voting profile. Each criterion becomes a 'voter' that ranks alternatives by its scores") (notes ("This is the core insight: treat criteria as voters. Aggregation rules that work for human preferences also work for metric-based rankings")) (section criterion-ranking) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking)) (answer "(define (dp->profile dp) (let ((criteria (dp-criteria dp))) (make-preference-profile (map (lambda (c) (criterion-ranking dp c)) criteria))))"))
(task-entry (id "game-theory/normal-form/best-response-p1") (skill game-theory) (module normal-form) (tier 1) (difficulty 13210) (name best-response-p1) (type "(-> Game Nat (List Nat))") (description "Find Player 1's best responses to Player 2 playing strategy j. Returns list of strategy indices that maximize P1's payoff") (notes ()) (section best-response) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken)) (answer "(define (best-response-p1 game j) (let ((n (game-num-strategies game 0))) (if (= n 0) '() (let* ((payoffs (map (lambda (i) (game-payoff-p1 game i j)) (iota n))) (max-payoff (apply max payoffs))) (filter (lambda (i) (= (list-ref payoffs i) max-payoff)) (iota n))))))"))
(task-entry (id "game-theory/extensive-form/make-chance") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13210) (name make-chance) (type "(-> (List Symbol) (List Number) (List Node) ChanceNode)") (description "Create a chance node where nature picks outcome with given probabilities") (notes ()) (section node-types) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child)) (answer "(define (make-chance outcomes probs children) (when (not (= (length outcomes) (length probs) (length children))) (error 'make-chance \"outcomes, probs, and children must have same length\")) (let ((sum (fold-right + 0 probs))) (when (> (abs (- sum 1.0)) 1e-10) (error 'make-chance \"probabilities must sum to 1\" sum))) (list 'chance outcomes probs children))"))
(task-entry (id "game-theory/coop-games/all-coalitions") (skill game-theory) (module coop-games) (tier 1) (difficulty 13210) (name all-coalitions) (type "(-> Nat (List Coalition))") (description "Generate all 2^n coalitions for n players") (notes ()) (section coalition-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition)) (answer "(define (all-coalitions n) (iota (bitwise-arithmetic-shift-left 1 n)))"))
(task-entry (id "game-theory/matching/stable-match") (skill game-theory) (module matching) (tier 1) (difficulty 13210) (name stable-match) (type "(-> Market Nat (List (Id . Id)))") (description "Compute proposer-optimal stable matching via deferred acceptance. Returns list of (proposer . receiver) pairs. fuel bounds iterations (set to n² for guaranteed completion)") (notes ()) (section gale-shapley) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers)) (answer "(define (stable-match market fuel) (let* ((proposers (market-proposers market)) (receivers (market-receivers market)) (n-prop (vector-length proposers)) (n-recv (vector-length receivers)) (recv-match (make-vector n-recv #f)) (prop-match (make-vector n-prop #f)) (prop-next (make-vector n-prop 0)) (free-props (iota n-prop)) (recv-ranks (build-receiver-ranks market))) (gs-loop proposers receivers recv-match prop-match prop-next recv-ranks market free-props fuel)))"))
(task-entry (id "game-theory/voting/count-if") (skill game-theory) (module voting) (tier 1) (difficulty 13210) (name count-if) (type "") (description "") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of)) (answer "(define (count-if pred lst) (length (filter pred lst)))"))
(task-entry (id "game-theory/strategic-voting/count-manipulable-profiles") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13210) (name count-manipulable-profiles) (type "(-> VotingRule Nat Nat (Pair Nat Nat))") (description "Count profiles where some voter can manipulate. Useful for comparing strategy-proofness of different rules") (notes ()) (section strategy-proofness) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium all-strategic-equilibria cartesian-product-n price-of-anarchy price-of-stability)) (answer "(define (count-manipulable-profiles voting-rule num-candidates num-voters) (let* ((candidates (map (lambda (i) (string->symbol (string (integer->char (+ i 97))))) (iota num-candidates))) (all-rankings (permutations candidates)) (all-profiles (cartesian-product-n all-rankings num-voters)) (manipulable-count (count-if (lambda (profile) (let check-voter ((i 0)) (if (>= i num-voters) #f (if (manipulation-possible? profile voting-rule i) #t (check-voter (+ i 1)))))) all-profiles))) (cons manipulable-count (length all-profiles))))"))
(task-entry (id "game-theory/voting-games/voter-is-dummy?") (skill game-theory) (module voting-games) (tier 1) (difficulty 13210) (name voter-is-dummy?) (type "") (description "") (notes ()) (section power-analysis) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator?)) (answer "(define (voter-is-dummy? profile voter-idx) (let* ((ss-index (shapley-shubik-index profile))) (= 0 (vector-ref ss-index voter-idx))))"))
(task-entry (id "game-theory/multi-winner/transfer-surplus") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13210) (name transfer-surplus) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop)) (answer "(define (transfer-surplus ballots elected transfer-value remaining) (map (lambda (b) (if (eq? (ballot-top-choice b remaining) elected) (ballot-with-weight b (* (ballot-weight b) transfer-value)) b)) ballots))"))
(task-entry (id "game-theory/fair-division/piece-value") (skill game-theory) (module fair-division) (tier 1) (difficulty 13210) (name piece-value) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton)) (answer "(define (piece-value c i piece) (fold-left + 0 (map (lambda (interval) (cake-valuation c i (car interval) (cdr interval))) piece)))"))
(task-entry (id "game-theory/mechanism/auction-outcome-winner") (skill game-theory) (module mechanism) (tier 1) (difficulty 13210) (name auction-outcome-winner) (type "(-> AuctionOutcome (U Nat (List Nat)))") (description "") (notes ()) (section auction-outcome) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome)) (answer "(define (auction-outcome-winner outcome) (auction-outcome%-winner outcome))"))
(task-entry (id "game-theory/evolutionary/rps-game") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13210) (name rps-game) (type "") (description "") (notes ()) (section classic-symmetric-games) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric)) (answer "(define rps-game (make-symmetric-game '(rock paper scissors) '((0 -1 1) (1 0 -1) (-1 1 0))))"))
(task-entry (id "game-theory/mcdm/dp->weighted-profile") (skill game-theory) (module mcdm) (tier 1) (difficulty 13210) (name dp->weighted-profile) (type "(-> DecisionProblem (List Real) PreferenceProfile)") (description "Convert decision problem to weighted profile. Higher weights give criteria more influence. Weights are discretized to vote counts (minimum 1)") (notes ("Weight of 2.5 becomes 3 votes. For continuous weighting, use weighted-borda-scores instead")) (section criterion-ranking) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile)) (answer "(define (dp->weighted-profile dp weights) (let ((criteria (dp-criteria dp))) (if (not (= (length criteria) (length weights))) (error 'dp->weighted-profile \"weights length must match criteria count\") (make-preference-profile (apply append (map (lambda (c w) (let ((ranking (criterion-ranking dp c)) (votes (max 1 (exact (round w))))) (make-list votes ranking))) criteria weights))))))"))
(task-entry (id "game-theory/normal-form/best-response-p2") (skill game-theory) (module normal-form) (tier 1) (difficulty 13211) (name best-response-p2) (type "(-> Game Nat (List Nat))") (description "Find Player 2's best responses to Player 1 playing strategy i") (notes ()) (section best-response) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1)) (answer "(define (best-response-p2 game i) (let ((n (game-num-strategies game 1))) (if (= n 0) '() (let* ((payoffs (map (lambda (j) (game-payoff-p2 game i j)) (iota n))) (max-payoff (apply max payoffs))) (filter (lambda (j) (= (list-ref payoffs j) max-payoff)) (iota n))))))"))
(task-entry (id "game-theory/extensive-form/chance?") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13211) (name chance?) (type "(-> Node Bool)") (description "") (notes ()) (section node-types) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance)) (answer "(define (chance? node) (and (pair? node) (eq? (car node) 'chance)))"))
(task-entry (id "game-theory/coop-games/coalition-subset?") (skill game-theory) (module coop-games) (tier 1) (difficulty 13211) (name coalition-subset?) (type "(-> Coalition Coalition Boolean)") (description "Is S a subset of T?") (notes ()) (section coalition-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions)) (answer "(define (coalition-subset? S T) (= S (coalition-intersection S T)))"))
(task-entry (id "game-theory/matching/gs-loop") (skill game-theory) (module matching) (tier 1) (difficulty 13211) (name gs-loop) (type "") (description "") (notes ()) (section gale-shapley) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match)) (answer "(define (gs-loop proposers receivers recv-match prop-match prop-next recv-ranks market free fuel) (cond ((null? free) (extract-matching proposers prop-match)) ((<= fuel 0) (extract-matching proposers prop-match)) (else (let* ((p-idx (car free)) (p-id (vector-ref proposers p-idx)) (p-prefs (market-proposer-prefs market p-id)) (next-idx (vector-ref prop-next p-idx))) (if (>= next-idx (length p-prefs)) (gs-loop proposers receivers recv-match prop-match prop-next recv-ranks market (cdr free) (- fuel 1)) (let* ((r-id (list-ref p-prefs next-idx)) (r-idx (find-receiver-idx receivers r-id))) (vector-set! prop-next p-idx (+ next-idx 1)) (gs-process-proposal proposers receivers recv-match prop-match prop-next recv-ranks market free fuel p-idx p-id r-id r-idx)))))))"))
(task-entry (id "game-theory/voting/argmax") (skill game-theory) (module voting) (tier 1) (difficulty 13211) (name argmax) (type "") (description "") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if)) (answer "(define (argmax f lst) (if (null? lst) (error 'argmax \"Empty list\") (let loop ((best (car lst)) (best-val (f (car lst))) (rest (cdr lst))) (if (null? rest) best (let ((val (f (car rest)))) (if (> val best-val) (loop (car rest) val (cdr rest)) (loop best best-val (cdr rest))))))))"))
(task-entry (id "game-theory/strategic-voting/strategy-proofness-ratio") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13211) (name strategy-proofness-ratio) (type "(-> VotingRule Nat Nat Number)") (description "Fraction of profiles where NO voter can manipulate. Higher = more strategy-proof") (notes ()) (section strategy-proofness) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium all-strategic-equilibria cartesian-product-n price-of-anarchy price-of-stability count-manipulable-profiles)) (answer "(define (strategy-proofness-ratio voting-rule num-candidates num-voters) (let ((counts (count-manipulable-profiles voting-rule num-candidates num-voters))) (/ (- (cdr counts) (car counts)) (cdr counts))))"))
(task-entry (id "game-theory/voting-games/voter-has-veto?") (skill game-theory) (module voting-games) (tier 1) (difficulty 13211) (name voter-has-veto?) (type "") (description "") (notes ()) (section power-analysis) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy?)) (answer "(define (voter-has-veto? profile voter-idx) (let* ((game (profile->majority-game profile)) (n (profile-voters profile)) (everyone-but-i (coalition-difference (coop-game-grand-coalition game) (coalition-singleton voter-idx)))) (not (is-winning? game everyone-but-i))))"))
(task-entry (id "game-theory/multi-winner/transfer-eliminated") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13211) (name transfer-eliminated) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus)) (answer "(define (transfer-eliminated ballots eliminated remaining) ballots)"))
(task-entry (id "game-theory/fair-division/piece-length") (skill game-theory) (module fair-division) (tier 1) (difficulty 13211) (name piece-length) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value)) (answer "(define (piece-length piece) (fold-left + 0 (map (lambda (interval) (- (cdr interval) (car interval))) piece)))"))
(task-entry (id "game-theory/mechanism/auction-outcome-payment") (skill game-theory) (module mechanism) (tier 1) (difficulty 13211) (name auction-outcome-payment) (type "(-> AuctionOutcome (U Number (Vector Number)))") (description "") (notes ()) (section auction-outcome) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner)) (answer "(define (auction-outcome-payment outcome) (auction-outcome%-payment outcome))"))
(task-entry (id "game-theory/evolutionary/make-population") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13211) (name make-population) (type "(-> (List Number) Population)") (description "") (notes ()) (section population-state) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game)) (answer "(define (make-population weights) (if (null? weights) (list 'error 'empty-population) (let* ((n (length weights)) (total (apply + weights)) (normalized (if (= total 0) (make-list n (/ 1.0 n)) (map (lambda (w) (/ w total)) weights)))) (list 'population (list->vector normalized)))))"))
(task-entry (id "game-theory/mcdm/mcdm-borda") (skill game-theory) (module mcdm) (tier 1) (difficulty 13211) (name mcdm-borda) (type "(-> DecisionProblem Alternative)") (description "Find best alternative using Borda count. Good for compromise solutions: rewards consistent good performance across criteria") (notes ()) (section aggregation-methods) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile)) (answer "(define (mcdm-borda dp) (borda-winner (dp->profile dp)))"))
(task-entry (id "game-theory/normal-form/strictly-dominates-p1?") (skill game-theory) (module normal-form) (tier 1) (difficulty 13212) (name strictly-dominates-p1?) (type "(-> Game Nat Nat Boolean)") (description "Does strategy i strictly dominate strategy i' for Player 1? (i.e., u1(i,j) > u1(i',j) for all j)") (notes ()) (section dominated-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2)) (answer "(define (strictly-dominates-p1? game i i-prime) (let ((n2 (game-num-strategies game 1))) (andmap (lambda (j) (> (game-payoff-p1 game i j) (game-payoff-p1 game i-prime j))) (iota n2))))"))
(task-entry (id "game-theory/extensive-form/chance-outcomes") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13212) (name chance-outcomes) (type "(-> ChanceNode (List Symbol))") (description "") (notes ()) (section node-types) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance?)) (answer "(define (chance-outcomes node) (cadr node))"))
(task-entry (id "game-theory/coop-games/make-coop-game") (skill game-theory) (module coop-games) (tier 1) (difficulty 13212) (name make-coop-game) (type "(-> Nat (-> Coalition Real) (Symbol) CoopGame)") (description "Create a cooperative game with n players and characteristic function v") (notes ()) (section cooperative-game-record-type) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset?)) (answer "(define (make-coop-game n v . args) (let ((game-type (if (null? args) ':value (car args)))) (unless (memq game-type '(:value :cost)) (error 'make-coop-game \"game-type must be :value or :cost\" game-type)) (make-coop-game% n v game-type)))"))
(task-entry (id "game-theory/matching/gs-process-proposal") (skill game-theory) (module matching) (tier 1) (difficulty 13212) (name gs-process-proposal) (type "") (description "") (notes ()) (section gale-shapley) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop)) (answer "(define (gs-process-proposal proposers receivers recv-match prop-match prop-next recv-ranks market free fuel p-idx p-id r-id r-idx) (if (not r-idx) (gs-loop proposers receivers recv-match prop-match prop-next recv-ranks market free (- fuel 1)) (let* ((current-match (vector-ref recv-match r-idx)) (ranks (vector-ref recv-ranks r-idx)) (p-acceptable? (assoc p-id ranks))) (if (not p-acceptable?) (gs-loop proposers receivers recv-match prop-match prop-next recv-ranks market free (- fuel 1)) (if (not current-match) (begin (vector-set! recv-match r-idx p-id) (vector-set! prop-match p-idx r-id) (gs-loop proposers receivers recv-match prop-match prop-next recv-ranks market (cdr free) (- fuel 1))) (let ((current-idx (find-proposer-idx proposers current-match))) (if (receiver-prefers? ranks p-id current-match) (begin (vector-set! recv-match r-idx p-id) (vector-set! prop-match p-idx r-id) (vector-set! prop-match current-idx #f) (gs-loop proposers receivers recv-match prop-match prop-next recv-ranks market (cons current-idx (cdr free)) (- fuel 1))) (gs-loop proposers receivers recv-match prop-match prop-next recv-ranks market free (- fuel 1)))))))))"))
(task-entry (id "game-theory/voting/all-maxima") (skill game-theory) (module voting) (tier 1) (difficulty 13212) (name all-maxima) (type "") (description "") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax)) (answer "(define (all-maxima f lst) (if (null? lst) '() (let ((max-val (apply max (map f lst)))) (filter (lambda (x) (= (f x) max-val)) lst))))"))
(task-entry (id "game-theory/strategic-voting/compare-strategy-proofness") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13212) (name compare-strategy-proofness) (type "(-> (List (Pair Symbol VotingRule)) Nat Nat (List (Pair Symbol Number)))") (description "Compare multiple voting rules by strategy-proofness. Returns sorted list with most strategy-proof first") (notes ()) (section strategy-proofness) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium all-strategic-equilibria cartesian-product-n price-of-anarchy price-of-stability count-manipulable-profiles strategy-proofness-ratio)) (answer "(define (compare-strategy-proofness rules-alist num-candidates num-voters) (let ((results (map (lambda (rule-pair) (cons (car rule-pair) (strategy-proofness-ratio (cdr rule-pair) num-candidates num-voters))) rules-alist))) (sort-by (lambda (a b) (> (cdr a) (cdr b))) results)))"))
(task-entry (id "game-theory/voting-games/minimal-winning-coalitions") (skill game-theory) (module voting-games) (tier 1) (difficulty 13212) (name minimal-winning-coalitions) (type "") (description "") (notes ()) (section power-analysis) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto?)) (answer "(define (minimal-winning-coalitions profile) (let* ((game (profile->majority-game profile)) (n (profile-voters profile)) (grand (coop-game-grand-coalition game))) (filter (lambda (S) (and (is-winning? game S) (is-minimal-winning? game S))) (all-coalitions n))))"))
(task-entry (id "game-theory/multi-winner/stv-droop") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13212) (name stv-droop) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated)) (answer "(define (stv-droop profile num-seats) (stv profile num-seats droop-quota))"))
