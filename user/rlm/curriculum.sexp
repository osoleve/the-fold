(task-entry (id "random/bayesian/beta-posterior-mean") (skill random) (module bayesian) (tier 1) (difficulty 12905) (name beta-posterior-mean) (type "") (description "") (notes ()) (section conjugate-prior-beta-binomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior)) (answer "(define (beta-posterior-mean prior) (let ((alpha (beta-prior-alpha prior)) (beta (beta-prior-beta prior))) (/ alpha (+ alpha beta))))"))
