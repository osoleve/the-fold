(task-entry (id "optimization/lp/compute-reduced-costs") (skill optimization) (module lp) (tier 1) (difficulty 12822) (name compute-reduced-costs) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize extract-basis-matrix extract-basis-costs)) (answer "(define (compute-reduced-costs c A basis B-inv) (let* ((n (vector-length c)) (m (matrix-rows A)) (cb (extract-basis-costs c basis)) (y (matrix-vec-mul (matrix-transpose B-inv) cb)) (reduced (make-vector n 0))) (do ((j 0 (+ j 1))) ((= j n) reduced) (let* ((Aj (matrix-col A j)) (y-Aj (vec-dot y Aj))) (vector-set! reduced j (- (vector-ref c j) y-Aj))))))"))
(task-entry (id "optimization/ilp/solution-is-integer?") (skill optimization) (module ilp) (tier 1) (difficulty 12822) (name solution-is-integer?) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp make-ilp-optimal make-ilp-infeasible make-ilp-unbounded ilp-optimal? ilp-infeasible? ilp-unbounded? ilp-result-x ilp-result-z is-integer?)) (answer "(define (solution-is-integer? x integer-vars) (let loop ((vars integer-vars)) (or (null? vars) (and (is-integer? (vector-ref x (car vars))) (loop (cdr vars))))))"))
