(task-entry (id "info/entropy/compute-marginal-y") (skill info) (module entropy) (tier 1) (difficulty 11114) (name compute-marginal-y) (type "(-> (List (List Number)) (List Number))") (description "Compute marginal P(Y) by summing columns") (notes ()) (section mutual-information) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy conditional-entropy-direct mutual-information mutual-information-from-joint compute-marginal-x)) (answer "(define (compute-marginal-y joint-probs) (if (null? joint-probs) '() (let ((n-cols (length (car joint-probs)))) (map (lambda (j) (fold-left + 0 (map (lambda (row) (list-ref row j)) joint-probs))) (iota n-cols)))))"))
(task-entry (id "info/statistical-measures/squared-loss") (skill info) (module statistical-measures) (tier 1) (difficulty 11114) (name squared-loss) (type "(-> (List Real) (List Real) Real)") (description "Squared loss (squared L2 distance): sum((p_i - q_i)^2)") (notes ()) (section squared-loss-divergence) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared jeffreys-divergence alpha-divergence squared-hellinger-distance triangular-discrimination pearson-divergence neyman-divergence k-divergence)) (answer "(define (squared-loss p q) (if (or (null? p) (null? q)) 0 (fold-left + 0 (map (lambda (pi qi) (let ((diff (- pi qi))) (* diff diff))) p q))))"))
(task-entry (id "info/channel-capacity/make-uniform-dist") (skill info) (module channel-capacity) (tier 1) (difficulty 11114) (name make-uniform-dist) (type "(-> Nat (List Real))") (description "Create uniform distribution over n outcomes") (notes ()) (section discrete-memoryless-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity awgn-capacity-db awgn-capacity-bandwidth snr-for-capacity dmc-mutual-information dmc-output-distribution dmc-joint-distribution dmc-capacity-symmetric)) (answer "(define (make-uniform-dist n) (if (<= n 0) '() (let ((p (/ 1.0 n))) (map (lambda (_) p) (iota n)))))"))
(task-entry (id "info/rate-distortion/binary-rate-distortion") (skill info) (module rate-distortion) (tier 1) (difficulty 11114) (name binary-rate-distortion) (type "(-> Real Real)") (description "Rate-distortion function for binary symmetric source") (notes ()) (section rate-distortion-functions) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr snr-db psnr mean variance gaussian-rate-distortion gaussian-distortion-rate)) (answer "(define (binary-rate-distortion distortion) (cond ((<= distortion 0) 1) ((>= distortion 0.5) 0) (else (- 1 (binary-entropy distortion)))))"))
