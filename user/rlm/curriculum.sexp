(task-entry (id "fp/natural-transform/nat-compose") (skill fp) (module natural-transform) (tier 1) (difficulty 10608) (name nat-compose) (type "(-> NatTransform NatTransform NatTransform)") (description "Vertical composition: (ε ∘ η) where η : F ⟹ G and ε : G ⟹ H\nPrecondition: both arguments are valid nat-transforms,\n              target of η equals source of ε.\nThis is pure lattice code; use boundary/fp/category.ss for validated entry points.") (notes ()) (section vertical-composition) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-nat-transform nat-transform? nat-transform-name nat-transform-source nat-transform-target nat-transform-component nat-apply nat-id)) (answer "(define (nat-compose ε η) (let ((source (nat-transform-source η)) (target (nat-transform-target ε)) (η-comp (nat-transform-component η)) (ε-comp (nat-transform-component ε))) (make-nat-transform (string->symbol (format \"~a∘~a\" (nat-transform-name ε) (nat-transform-name η))) source target (lambda (x) (ε-comp (η-comp x))))))"))
(task-entry (id "fp/adjunction/verify-triangle-right") (skill fp) (module adjunction) (tier 1) (difficulty 10608) (name verify-triangle-right) (type "") (description "") (notes ()) (section adjunction-definition) (deps (\x27;natural-transform)) (available (make-adjunction adjunction? adjunction-name adjunction-left adjunction-right adjunction-unit adjunction-counit verify-triangle-left)) (answer "(define (verify-triangle-right adj val) (let* ((G (adjunction-right adj)) (η (adjunction-unit adj)) (ε (adjunction-counit adj)) (η-comp (nat-transform-component η)) (ε-comp (nat-transform-component ε)) (G-fmap (functor-fmap G))) (let* ((step1 (η-comp val)) (result (G-fmap ε-comp step1))) (equal? result val))))"))
