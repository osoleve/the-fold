(task-entry (id "egraph/match/eclass-ref?") (skill egraph) (module match) (tier 1) (difficulty 10014) (name eclass-ref?) (type "") (description "") (notes ()) (section application) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref)) (answer "(define (eclass-ref? x) (and (vector? x) (= (vector-length x) 2) (eq? (vector-ref x 0) eclass-ref-tag)))"))
(task-entry (id "egraph/saturation/result-final-nodes") (skill egraph) (module saturation) (tier 1) (difficulty 10014) (name result-final-nodes) (type "") (description "") (notes ()) (section result) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes)) (answer "(define (result-final-nodes r) (vector-ref r 5))"))
(task-entry (id "egraph/cost/cpu-op-costs") (skill egraph) (module cost) (tier 1) (difficulty 10014) (name cpu-op-costs) (type "") (description "") (notes ()) (section cpu) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost ast-size-cost ast-depth-cost leaf-count-cost make-weighted-cost cuda-op-costs cuda-cost)) (answer "(define cpu-op-costs (let ((ht (make-hashtable symbol-hash eq?))) (hashtable-set! ht 'load 10) (hashtable-set! ht 'store 10) (hashtable-set! ht 'index 5) (hashtable-set! ht '+ 1) (hashtable-set! ht '- 1) (hashtable-set! ht '* 3) (hashtable-set! ht 'neg 1) (hashtable-set! ht '/ 20) (hashtable-set! ht 'mod 20) (hashtable-set! ht 'div 20) (hashtable-set! ht 'sqrt 15) (hashtable-set! ht 'exp 25) (hashtable-set! ht 'log 25) (hashtable-set! ht 'sin 25) (hashtable-set! ht 'cos 25) (hashtable-set! ht 'pow 40) (hashtable-set! ht 'if 3) ht))"))
(task-entry (id "egraph/extract/optimize-debug") (skill egraph) (module extract) (tier 1) (difficulty 10014) (name optimize-debug) (type "(-> Term (List Rule) CostModel Term)") (description "Optimize with debug output.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/cost \x27;egraph/saturation)) (available (extraction-state-tag make-extraction-state extraction-state? state-egraph state-costs state-best-nodes extract extract-term extract-all optimize optimize-with-config extraction-report compare-extractions extraction-debug)) (answer "(define (optimize-debug term rules cost-model) (let ((eg (make-egraph))) (printf \"Input term: ~a~n\" term) (let ((root (egraph-add-term! eg term))) (printf \"Initial e-graph: ~a classes, ~a nodes~n\" (egraph-class-count eg) (egraph-node-count eg)) (let ((result (saturate-simple eg rules))) (printf \"After saturation: ~a classes, ~a nodes (~a rules applied)~n\" (result-final-classes result) (result-final-nodes result) (result-rules-applied result)) (let ((state (make-extraction-state eg cost-model))) (printf \"~n~a~n\" (extraction-report state root)) (let ((extracted (extract state root))) (printf \"Extracted: ~a~n\" extracted) extracted))))))"))
