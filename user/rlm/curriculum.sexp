(task-entry (id "algebra/poly-bridge/alg-poly-from-roots") (skill algebra) (module poly-bridge) (tier 0) (difficulty 347) (name alg-poly-from-roots) (type "(-> Field (List Coeff) AlgebraPoly)") (description "Create polynomial from roots: (x - r_1)(x - r_2)...(x - r_n)") (notes ("For real roots only (complex roots need numeric/polynomial.ss)")) (section polynomial-from-roots) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul alg-poly-scale alg-poly-divmod alg-poly-div alg-poly-mod alg-poly-gcd alg-poly-extended-gcd alg-poly-derivative alg-poly-eval alg-poly-monic alg-poly->string alg-make-polynomial Q-field numeric->algebra numeric->algebra-with-field algebra->numeric alg-make alg-coeffs alg-degree alg-field alg-zero? alg-leading alg-add alg-sub alg-mul alg-scale alg-divmod alg-div alg-mod alg-gcd alg-extended-gcd alg-derivative alg-eval alg-monic bridge-gcd bridge-divmod bridge-simplify bridge-coprime? alg->string numeric->string)) (answer "(define (alg-poly-from-roots field roots) (if (null? roots) (alg-make-polynomial field '(1)) (let loop ((rs roots) (acc (alg-make-polynomial field '(1)))) (if (null? rs) acc (let* ((r (car rs)) (linear (alg-make-polynomial field (list (- r) 1)))) (loop (cdr rs) (alg-poly-mul acc linear)))))))"))
