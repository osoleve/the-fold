(task-entry (id "linalg/dep-linalg/diff-compose") (skill linalg) (module dep-linalg) (tier 0) (difficulty 420) (name diff-compose) (type "Π A B C. Diff B C → Diff A B → Diff A C") (description "Compose two differentiable functions. Chain rule: ∇(g∘f)(x) = ∇g(f(x)) · ∇f(x)") (notes ()) (section differentiable-operations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (dep-linalg-types vec-append-typed vec-zip-typed vec-head-typed vec-tail-typed vec-map-typed vec-fold-typed matrix-mul-typed matrix-add-typed matrix-transpose-typed matrix-scale-typed vec-ref-safe matrix-ref-safe vec-nil-typed vec-cons-typed make-dep-linalg-ctx extend-ctx-with-dep-linalg diff-grad diff-jacobian diff-hessian)) (answer "(define (diff-compose A B C diff-g diff-f) (let ((primal-f (cdr (assq 'primal diff-f))) (primal-g (cdr (assq 'primal diff-g))) (grad-f (cdr (assq 'gradient diff-f))) (grad-g (cdr (assq 'gradient diff-g)))) (quasiquote ((primal unquote (lambda (x) (primal-g (primal-f x)))) (gradient unquote (lambda (x) (let ((fx (primal-f x)) (df-at-x (grad-f x)) (dg-at-fx (grad-g fx))) (if (number? df-at-x) (* dg-at-fx df-at-x) (error 'diff-compose \"Non-scalar chain rule not yet implemented\")))))))))"))
(task-entry (id "linalg/vec/vec-scale") (skill linalg) (module vec) (tier 0) (difficulty 421) (name vec-scale) (type "(-> Num (Vec Num) (Vec Num))") (description "Scalar multiplication") (notes ()) (section vector-arithmetic) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop vec-slice vec-add vec-sub vec-mul vec-div)) (answer "(define (vec-scale k v) (vec-map (lambda (x) (* k x)) v))"))
(task-entry (id "linalg/quaternion/quat-neg") (skill linalg) (module quaternion) (tier 0) (difficulty 421) (name quat-neg) (type "") (description "") (notes ()) (section quaternion-arithmetic) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at quat? quat-identity? quat-unit? quat-w quat-x quat-y quat-z quat-scalar quat-vector quat->list list->quat quat-add quat-sub)) (answer "(define (quat-neg q) (quat (- (quat-w q)) (- (quat-x q)) (- (quat-y q)) (- (quat-z q))))"))
(task-entry (id "linalg/matrix/matrix-mul") (skill linalg) (module matrix) (tier 0) (difficulty 421) (name matrix-mul) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose matrix-map matrix-map2 matrix-fold matrix-add matrix-sub matrix-hadamard matrix-scale matrix-negate)) (answer "(define (matrix-mul m1 m2) (let ((r1 (matrix-rows m1)) (c1 (matrix-cols m1)) (r2 (matrix-rows m2)) (c2 (matrix-cols m2))) (if (not (= c1 r2)) (quasiquote (error dimension-mismatch ((unquote r1) (unquote c1)) ((unquote r2) (unquote c2)))) (let* ((data1 (matrix-data m1)) (data2 (matrix-data m2)) (result (make-vector (* r1 c2) 0))) (do ((i 0 (+ i 1))) ((= i r1)) (do ((k 0 (+ k 1))) ((= k c1)) (let ((a-ik (vector-ref data1 (+ (* i c1) k))) (b-row-k (* k c2)) (c-row-i (* i c2))) (do ((j 0 (+ j 1))) ((= j c2)) (let ((idx (+ c-row-i j))) (vector-set! result idx (+ (vector-ref result idx) (* a-ik (vector-ref data2 (+ b-row-k j)))))))))) (list 'matrix r1 c2 result)))))"))
(task-entry (id "linalg/matrix-eigen/eigenvalues") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 421) (name eigenvalues) (type "") (description "") (notes ()) (section symmetric-eigen) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop eigen-decomposition symmetric-eigen symmetric-eigen-loop symmetric-converged? spectral-radius eigenvalue-condition)) (answer "(define (eigenvalues a) (if (matrix-symmetric? a) (let ((result (symmetric-eigen a))) (if (and (pair? result) (eq? (car result) 'error)) result (car result))) (qr-algorithm-shifted a)))"))
(task-entry (id "linalg/iterative-solvers/vector-copy") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 421) (name vector-copy) (type "") (description "") (notes ()) (section utilities) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres gmres-outer gmres-arnoldi gmres-arnoldi-loop apply-givens-rotations compute-givens gmres-solve-update)) (answer "(define (vector-copy v) (let* ((n (vector-length v)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (vector-ref v i)))))"))
(task-entry (id "linalg/sparse/sparse-csr-row-alist") (skill linalg) (module sparse) (tier 0) (difficulty 421) (name sparse-csr-row-alist) (type "") (description "") (notes ()) (section csr-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr? make-sparse-csr sparse-csr-rows sparse-csr-cols sparse-csr-row-ptrs sparse-csr-col-indices sparse-csr-values sparse-csr-nnz sparse-csr-ref sparse-csr-row)) (answer "(define (sparse-csr-row-alist m i) (let* ((row-ptrs (sparse-csr-row-ptrs m)) (col-idx (sparse-csr-col-indices m)) (vals (sparse-csr-values m)) (start (vector-ref row-ptrs i)) (end (vector-ref row-ptrs (+ i 1)))) (do ((k (- end 1) (- k 1)) (result '() (cons (cons (vector-ref col-idx k) (vector-ref vals k)) result))) ((< k start) result))))"))
(task-entry (id "linalg/graph-laplacian/laplacian-summary") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 421) (name laplacian-summary) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue is-bipartite-spectral? effective-resistance total-effective-resistance)) (answer "(define (laplacian-summary adj) (let* ((L (laplacian adj)) (n (matrix-rows L)) (eigs (eigenvalues L))) (if (and (pair? eigs) (eq? (car eigs) 'error)) eigs (let* ((sorted (vector-sort-by < eigs)) (lambda-1 (vector-ref sorted 0)) (lambda-2 (if (>= n 2) (vector-ref sorted 1) 0)) (lambda-max (vector-ref sorted (- n 1)))) (quasiquote ((nodes unquote n) (smallest-eigenvalue unquote lambda-1) (algebraic-connectivity unquote lambda-2) (largest-eigenvalue unquote lambda-max) (connected-components unquote (laplacian-connected-components adj)) (trace unquote (laplacian-trace L)) (energy unquote (laplacian-energy adj))))))))"))
(task-entry (id "linalg/svd/singular-values") (skill linalg) (module svd) (tier 0) (difficulty 421) (name singular-values) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin matrix-slice-cols matrix-slice pseudoinverse build-sigma-pseudoinverse low-rank-approx matrix-rank matrix-condition-number)) (answer "(define (singular-values a . opts) (let* ((m (matrix-rows a)) (n (matrix-cols a)) (tol (if (pair? opts) (car opts) *svd-tolerance*)) (at (matrix-transpose a)) (gram (if (<= n m) (matrix-mul at a) (matrix-mul a at))) (eigen-result (symmetric-eigen gram *svd-max-iterations* tol))) (if (and (pair? eigen-result) (eq? (car eigen-result) 'error)) eigen-result (let* ((eigenvalues (car eigen-result)) (k (vector-length eigenvalues)) (sorted (sort-vector-descending eigenvalues)) (singular (eigenvalues->singular-values sorted tol))) singular))))"))
