(task-entry (id "tiles/topology-analysis/board-topology-analysis") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12312) (name board-topology-analysis) (type "") (description "") (notes ()) (section topological-analysis) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<? collect-square-faces coords-adjacent? board-betti-numbers board-connected-regions board-terrain-holes)) (answer "(define (board-topology-analysis board neighbor-fn) (let* ((sc (board->simplicial-complex board neighbor-fn)) (betti (sc-betti-numbers sc)) (beta0 (if (null? betti) 0 (car betti))) (beta1 (if (< (length betti) 2) 0 (cadr betti))) (weighted-bridges (find-bridges-with-weights board neighbor-fn)) (bottleneck-scores (board-bottleneck-scores-all board neighbor-fn)) (walkable-count (length (filter (lambda (c) (let ((t (board-get board c))) (and t (tile-walkable? t)))) (board-coords board))))) (quasiquote ((betti-numbers unquote betti) (connected-regions unquote beta0) (terrain-holes unquote beta1) (critical-edges unquote weighted-bridges) (bottleneck-scores unquote bottleneck-scores) (walkable-count unquote walkable-count) (is-connected unquote (= beta0 1))))))"))
