(task-entry (id "diffgeo/symbolic-metrics/polar-christoffel-exact") (skill diffgeo) (module symbolic-metrics) (tier 1) (difficulty 10713) (name polar-christoffel-exact) (type "(-> Vec ChristoffelTensor)") (description "Pre-computed Christoffel symbols for polar coordinates") (notes ("Non-zero: Γ^r_{θθ} = -r, Γ^θ_{rθ} = Γ^θ_{θr} = 1/r" "Returns +inf.0 at r=0 (coordinate singularity)")) (section metric-derivative-protocol) (deps (\x27;curvature)) (available (metric-symbolic? make-metric-symbolic metric-symbolic-deriv-fn metric-chart* metric-fn* metric-dim* metric-at* make-polar-metric-exact make-spherical-metric-exact make-cylindrical-metric-exact make-euclidean-metric-exact christoffel-symbols-exact christoffel-symbols*)) (answer "(define (polar-christoffel-exact coords) (let* ((r (vector-ref coords 0)) (gamma (make-vector 2 #f))) (let ((gamma-r (make-vector 2 #f))) (vector-set! gamma-r 0 (vector 0 0)) (vector-set! gamma-r 1 (vector 0 (- r))) (vector-set! gamma 0 gamma-r)) (let ((gamma-theta (make-vector 2 #f)) (inv-r (/ 1.0 r))) (vector-set! gamma-theta 0 (vector 0 inv-r)) (vector-set! gamma-theta 1 (vector inv-r 0)) (vector-set! gamma 1 gamma-theta)) gamma))"))
