(task-entry (id "fp/parser/parser-or") (skill fp) (module parser) (tier 1) (difficulty 10658) (name parser-or) (type "(-> (Parser α) (Parser α) (Parser α))") (description "Try first parser, if it fails without consuming input, try second (<|>)") (notes ()) (section alternation) (deps (\x27;prelude \x27;combinators)) (available (%newline %tab %return %backspace %page make-pos pos? pos-line pos-col pos-offset parser-initial-pos advance-pos parser-make-state parser-state? parser-state-input parser-state-index parser-state-pos parser-state-remaining parser-state-at-end? parser-state-current-char parser-initial-state make-parse-error parse-error? error-pos error-message error-expected merge-errors format-error format-expected make-parser parser? run-parser parser-parse parse-all parser-pure parser-fail parser-eof parser-any-char parser-satisfy parser-char parser-char-ci parser-one-of parser-none-of parser-digit parser-letter parser-alpha-num parser-space parser-lower parser-upper newline-char tab-char parser-string parser-bind parser-then parser-left parser-right parser-map parser-ap)) (answer "(define (parser-or p1 p2) (make-parser (lambda (state) (let ((result1 (run-parser p1 state))) (if (right? result1) result1 (let ((err1 (from-left result1)) (start-offset (pos-offset (parser-state-pos state))) (err-offset (pos-offset (error-pos (from-left result1))))) (if (> err-offset start-offset) result1 (let ((result2 (run-parser p2 state))) (if (right? result2) result2 (left (merge-errors err1 (from-left result2))))))))))))"))
