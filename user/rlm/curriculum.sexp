(task-entry (id "fp/effect-category/make-effect-adjunction") (skill fp) (module effect-category) (tier 1) (difficulty 10608) (name make-effect-adjunction) (type "(-> Signature Adjunction)") (description "Construct Free ⊣ Forgetful for an effect signature.\nThis is the categorical foundation underlying algebraic effects.") (notes ()) (section free-effect-adjunction) (deps (\x27;free-algebra \x27;effects)) (available (effect-sig-to-signature sig-effect-state sig-effect-reader sig-effect-writer sig-effect-exception sig-effect-nondet handler-to-algebra algebra-to-handler)) (answer "(define (make-effect-adjunction sig) (let* ((free-functor (make-named-functor (string->symbol (format \"Free-~a\" (signature-name sig))) (lambda (f eff) (eff-map f eff)))) (forgetful-functor (make-named-functor (string->symbol (format \"Forget-~a\" (signature-name sig))) (lambda (f x) (f x)))) (unit (make-nat-transform (string->symbol (format \"η-~a\" (signature-name sig))) functor-id forgetful-functor eff-return)) (counit (make-nat-transform (string->symbol (format \"ε-~a\" (signature-name sig))) free-functor functor-id (lambda (eff) (if (eff-pure? eff) (eff-pure-value eff) eff))))) (make-adjunction (string->symbol (format \"free-eff-~a\" (signature-name sig))) free-functor forgetful-functor unit counit)))"))
