(task-entry (id "fp/proof-tactics/tactic-topdown") (skill fp) (module proof-tactics) (tier 1) (difficulty 10617) (name tactic-topdown) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;engine \x27;rewrite/laws)) (available (make-proof-goal proof-goal? goal-lhs goal-rhs goal-context goal-trivial? tactic-success tactic-failure tactic-success? tactic-failure? tactic-subgoals tactic-builder tactic-error tactic-refl tactic-sym tactic-trans tactic-rewrite)) (answer "(define (tactic-topdown strategy) (lambda (goal) (if (not (proof-goal? goal)) (tactic-failure '(not-a-goal)) (let* ((lhs (goal-lhs goal)) (rhs (goal-rhs goal)) (ctx (goal-context goal)) (topdown-strat (topdown strategy)) (result (topdown-strat lhs))) (if (not result) (tactic-failure '(strategy-did-not-apply-topdown)) (if (equal? result rhs) (tactic-success '() (lambda () (quasiquote (topdown-rewrite (unquote lhs) (unquote result))))) (let ((new-goal (make-proof-goal result rhs ctx))) (tactic-success (list new-goal) (lambda (proofs) (quasiquote (trans (topdown-rewrite (unquote lhs) (unquote result)) (unquote (if (null? proofs) '(refl) (car proofs))))))))))))))"))
