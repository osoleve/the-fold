ion-list dsl-program-depth dsl-uses-tag? dsl-tag-histogram dsl-optimize-dead-code dsl-fuse dsl-fix dsl-lazy make-bounce make-done bounce? done? bounce-thunk done-value run-trampoline run-dsl-trampolined run-dsl-trampoline-helper)) (answer "(define (make-mock-interpreter mock-values) (let ((call-counts (map (lambda (p) (cons (car p) 0)) mock-values))) (make-interpreter (lambda (tag payload) (set! call-counts (map (lambda (p) (if (eq? (car p) tag) (cons tag (+ 1 (cdr p))) p)) call-counts)) (let ((mock (assoc tag mock-values))) (if mock (let ((val (cdr mock))) (cond ((and (pair? val) (eq? (car val) 'fn)) ((cdr val) payload)) ((and (pair? val) (eq? (car val) 'values)) (let* ((vals (cdr val)) (count (cdr (assoc tag call-counts))) (idx (modulo (- count 1) (length vals)))) (list-ref vals idx))) (else val))) (error 'mock-interpreter \"No mock for instruction\" tag)))))))"))
