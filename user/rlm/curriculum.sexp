(task-entry (id "game-theory/mcdm/find-score") (skill game-theory) (module mcdm) (tier 1) (difficulty 13206) (name find-score) (type "") (description "") (notes ()) (section decision-problem) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score)) (answer "(define (find-score scores alt crit) (cond ((null? scores) #f) ((and (eq? (caar scores) alt) (eq? (cadar scores) crit)) (car scores)) (else (find-score (cdr scores) alt crit))))"))
(task-entry (id "game-theory/normal-form/battle-of-sexes") (skill game-theory) (module normal-form) (tier 1) (difficulty 13207) (name battle-of-sexes) (type "") (description "") (notes ()) (section classic-games) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies)) (answer "(define battle-of-sexes (make-game '(opera football) '(opera football) '(((3 . 2) (0 . 0)) ((0 . 0) (2 . 3)))))"))
