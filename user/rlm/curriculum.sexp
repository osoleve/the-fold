(task-entry (id "optics/format-iso/make-tag-iso") (skill optics) (module format-iso) (tier 1) (difficulty 11019) (name make-tag-iso) (type "(-> Symbol (PIso a (Pair Symbol a)))") (description "Create an iso that wraps/unwraps a value with a tag.") (notes ()) (section wrapped-values) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string sexpr->bytevector bytevector->sexpr iso-sexpr-bytevector iso-list-vector iso-alist-keys-sorted iso-number-string iso-exact-inexact iso-bool-int iso-bool-symbol iso-null-nothing iso-false-nothing string-split iso-time-unix iso-symbol-string)) (answer "(define (make-tag-iso tag) (make-p-iso (lambda (v) (cons tag v)) (lambda (tagged) (if (and (pair? tagged) (eq? (car tagged) tag)) (cdr tagged) (error 'make-tag-iso \"Tag mismatch\" tag (car tagged))))))"))
