(task-entry (id "numeric/pde-time/make-time-stepper") (skill numeric) (module pde-time) (tier 0) (difficulty 2525) (name make-time-stepper) (type "") (description "") (notes ()) (section factory) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step mol-rk4-step cfl-parabolic cfl-hyperbolic estimate-mesh-spacing adaptive-euler-step integrate-adaptive sparse-csr-identity sparse-cg-solve cg-loop)) (answer "(define (make-time-stepper method M A b) (case method ((forward-euler) (let ((M-diag (sparse-csr-diagonal-vec M))) (lambda (u t dt) (forward-euler-mass-step M-diag A u b dt 1e-10 1000)))) ((mol-euler) (lambda (u t dt) (mol-euler-step A b u t dt))) ((mol-rk4) (lambda (u t dt) (mol-rk4-step A b u t dt))) ((backward-euler) (lambda (u t dt) (let-values (((u-new residual iters) (backward-euler-linear-step M A u b dt 1e-10 1000))) u-new))) ((crank-nicolson) (lambda (u t dt) (let-values (((u-new residual iters) (crank-nicolson-step M A u b dt 1e-10 1000))) u-new))) (else (error 'make-time-stepper \"Unknown method\" method))))"))
