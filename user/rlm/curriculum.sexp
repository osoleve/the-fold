(task-entry (id "random/prng/splitmix-next") (skill random) (module prng) (tier 1) (difficulty 12911) (name splitmix-next) (type "") (description "") (notes ()) (section splitmix64) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state)) (answer "(define (splitmix-next sm) (let* ((s (u64 (+ (splitmix-state sm) 11400714819323198485))) (z (u64 (* (bitwise-xor s (ash s -30)) 13787848793156543929))) (z (u64 (* (bitwise-xor z (ash z -27)) 10723151780598845931))) (z (bitwise-xor z (ash z -31)))) (cons z (make-splitmix s))))"))
(task-entry (id "random/distributions/standard-normal-cdf") (skill random) (module distributions) (tier 1) (difficulty 12911) (name standard-normal-cdf) (type "(-> Number Number)") (description "Standard normal CDF via Abramowitz & Stegun erfc approximation") (notes ()) (section standard-normal) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p*)) (answer "(define (standard-normal-cdf x) (let* ((sign (if (< x 0) -1 1)) (x (abs x)) (t (/ 1 (+ 1 (* *erfc-p* (/ x (sqrt 2)))))) (y (- 1 (* (horner-eval *erfc-coeffs* t) t (exp-num (* -0.5 x x)))))) (* 0.5 (+ 1 (* sign y)))))"))
