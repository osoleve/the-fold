(task-entry (id "topology/simplicial-complex/sc-from-simplices") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11825) (name sc-from-simplices) (type "(-> (List Simplex) SC)") (description "Build a simplicial complex from a list of simplices") (notes ("Automatically adds all faces to maintain closure property")) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex)) (answer "(define (sc-from-simplices simplices) (let loop ((sc sc-empty) (remaining simplices)) (if (null? remaining) sc (loop (sc-add-simplex sc (car remaining)) (cdr remaining)))))"))
(task-entry (id "topology/homology/make-sphere") (skill topology) (module homology) (tier 1) (difficulty 11825) (name make-sphere) (type "(-> Integer SC)") (description "Create a triangulation of the n-sphere S^n") (notes ("We use the boundary of the (n+1)-simplex, which is homeomorphic to S^n" "Expected Betti numbers for S^n:\n  B_0 = 1 (connected)\n  B_k = 0 for 0 < k < n\n  B_n = 1 (the fundamental class)")) (section standard-spaces) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti sc-betti-numbers sc-homology-summary)) (answer "(define (make-sphere n) (sc-boundary-of-simplex (+ n 1)))"))
