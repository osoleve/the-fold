(task-entry (id "statistics/model-protocol/cv-split") (skill statistics) (module model-protocol) (tier 1) (difficulty 11207) (name cv-split) (type "") (description "") (notes ()) (section cross-validation) (deps (\x27;prelude \x27;protocol \x27;result-types \x27;sort)) (available (model-mse model-rmse model-mae compare-models-aic compare-models-bic model-summary cv-score)) (answer "(define (cv-split X y start end n) (let* ((p (matrix-cols X)) (n-test (- end start)) (n-train (- n n-test)) (X-train-data (make-vector (* n-train p))) (X-test-data (make-vector (* n-test p))) (y-train (make-vector n-train)) (y-test (make-vector n-test)) (train-idx 0) (test-idx 0)) (do ((i 0 (+ i 1))) ((= i n)) (if (and (>= i start) (< i end)) (begin (vector-set! y-test test-idx (vector-ref y i)) (do ((j 0 (+ j 1))) ((= j p)) (vector-set! X-test-data (+ (* test-idx p) j) (matrix-ref X i j))) (set! test-idx (+ test-idx 1))) (begin (vector-set! y-train train-idx (vector-ref y i)) (do ((j 0 (+ j 1))) ((= j p)) (vector-set! X-train-data (+ (* train-idx p) j) (matrix-ref X i j))) (set! train-idx (+ train-idx 1))))) (list (list 'matrix n-train p X-train-data) y-train (list 'matrix n-test p X-test-data) y-test)))"))
