(task-entry (id "fp/integrate/find-antiderivative-match") (skill fp) (module integrate) (tier 1) (difficulty 10611) (name find-antiderivative-match) (type "") (description "") (notes ()) (section u-substitution) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power integrate-quotient integrate-by-substitution try-substitution-pattern)) (answer "(define (find-antiderivative-match other-factors potential-du var-sym depth) (let ((candidates (find-u-candidates (fold-left product (num 1) other-factors) var-sym))) (let loop ((u-list candidates)) (if (null? u-list) #f (let* ((u (car u-list)) (du (simplify (deriv u var-sym)))) (if (expr=? du (simplify potential-du)) (let* ((f-of-u (substitute-u other-factors u var-sym)) (int-f (and f-of-u (integrate-internal f-of-u 'u (+ depth 1))))) (if int-f (subst int-f 'u u) (loop (cdr u-list)))) (loop (cdr u-list))))))))"))
(task-entry (id "fp/solve/polynomial-degree") (skill fp) (module solve) (tier 1) (difficulty 10611) (name polynomial-degree) (type "") (description "") (notes ()) (section equation-representation) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial?)) (answer "(define (polynomial-degree expr var-sym) (cond ((num? expr) 0) ((var? expr) (if (eq? (var-name expr) var-sym) 1 0)) ((sum? expr) (apply max (map (lambda (t) (polynomial-degree t var-sym)) (sum-terms expr)))) ((product? expr) (apply + (map (lambda (f) (polynomial-degree f var-sym)) (product-factors expr)))) ((difference? expr) (max (polynomial-degree (diff-left expr) var-sym) (if (diff-right expr) (polynomial-degree (diff-right expr) var-sym) 0))) ((power? expr) (if (and (num? (pow-exp expr)) (integer? (num-val (pow-exp expr)))) (* (polynomial-degree (pow-base expr) var-sym) (num-val (pow-exp expr))) 0)) ((quotient? expr) (if (contains-var? (quot-denom expr) var-sym) -1 (polynomial-degree (quot-numer expr) var-sym))) (else 0)))"))
(task-entry (id "fp/poly-canonical/simplify-rational") (skill fp) (module poly-canonical) (tier 1) (difficulty 10611) (name simplify-rational) (type "(-> Expr Symbol Expr)") (description "Simplify rational expression using polynomial GCD") (notes ("Cancels common polynomial factors in numerator and denominator")) (section gcd-simplification) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial polynomial-expr? expr-degree extract-poly-coeffs extract-coeff-at extract-coeff-expanded extract-coeff-product expr-eval-at-zero polynomial->expr make-term)) (answer "(define (simplify-rational expr var-sym) (if (not (quotient? expr)) expr (let* ((numer (quot-numer expr)) (denom (quot-denom expr)) (numer-poly (expr->polynomial numer var-sym Q-field-sym)) (denom-poly (expr->polynomial denom var-sym Q-field-sym))) (if (or (not numer-poly) (not denom-poly)) expr (let* ((gcd-poly (poly-gcd numer-poly denom-poly)) (gcd-deg (poly-degree gcd-poly))) (if (<= gcd-deg 0) expr (let* ((numer-reduced (poly-div numer-poly gcd-poly)) (denom-reduced (poly-div denom-poly gcd-poly))) (division (polynomial->expr numer-reduced var-sym) (polynomial->expr denom-reduced var-sym)))))))))"))
