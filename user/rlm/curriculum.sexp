(task-entry (id "data/collection-utils/map-collection") (skill data) (module collection-utils) (tier 0) (difficulty 1304) (name map-collection) (type "(-> FSCap (-> Block A) Block (List A))") (description "Map function over all members of a collection. Loads each member block and applies function") (notes ()) (section higher-order-collection-functions) (deps (\x27;block \x27;sha256)) (available (foldr collection-hashes collection-size collection-empty?)) (answer "(define (map-collection fs f collection) (let ((hashes (collection-hashes collection))) (map (lambda (h) (let ((block (fs-fetch fs h))) (if block (f block) (error 'map-collection \"Block not found\" h)))) hashes)))"))
