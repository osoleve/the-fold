e* *continuation-max-newton*)) grid)) (unique (remove-duplicate-points candidates tolerance))) unique))"))
(task-entry (id "sim/bifurcation/generate-nd-grid") (skill sim) (module bifurcation) (tier 2) (difficulty 23349) (name generate-nd-grid) (type "(-> (List (Pair Number Number)) Nat (List Vec))") (description "Generate a grid in n-dimensional space") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points)) (answer "(define (generate-nd-grid ranges density) (if (null? ranges) '(#()) (let* ((range (car ranges)) (rest-grid (generate-nd-grid (cdr ranges) density)) (step (/ (- (cdr range) (car range)) (max 1 (- density 1))))) (append-map (lambda (i) (let ((val (+ (car range) (* i step)))) (map (lambda (pt) (list->vector (cons val (vector->list pt)))) rest-grid))) (iota density)))))"))
(task-entry (id "sim/bifurcation/remove-duplicate-points") (skill sim) (module bifurcation) (tier 2) (difficulty 23350) (name remove-duplicate-points) (type "(-> (List Vec) Number (List Vec))") (description "Remove points that are within tolerance of each other") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid)) (answer "(define (remove-duplicate-points points tolerance) (let loop ((pts points) (unique '())) (if (null? pts) (reverse unique) (let ((pt (car pts))) (if (any (lambda (u) (< (vec-norm (vec-sub pt u)) tolerance)) unique) (loop (cdr pts) unique) (loop (cdr pts) (cons pt unique)))))))"))
