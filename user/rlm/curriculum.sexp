(task-entry (id "optimization/lbfgs/converged-bound?") (skill optimization) (module lbfgs) (tier 1) (difficulty 12820) (name converged-bound?) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list lbfgs-history-push take-n lbfgs-direction lbfgs-two-loop initial-hessian-scale lbfgs lbfgs-full minimize minimize-with lbfgs-b lbfgs-b-full project-box projected-gradient)) (answer "(define (converged-bound? criteria state x grad lower upper) (let* ((pg (projected-gradient x grad lower upper)) (pg-norm (vec-norm pg))) (cond ((< pg-norm (cc-grad-tol criteria)) 'grad-converged) ((and (> (cs-iter state) 0) (< (cs-f-change state) (cc-f-tol criteria))) 'f-converged) ((>= (cs-iter state) (cc-max-iter criteria)) 'max-iter) (else #f))))"))
(task-entry (id "optimization/lp/extract-basis-matrix") (skill optimization) (module lp) (tier 1) (difficulty 12820) (name extract-basis-matrix) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize)) (answer "(define (extract-basis-matrix A basis) (let* ((m (matrix-rows A)) (k (vector-length basis)) (result (make-matrix m k 0))) (do ((j 0 (+ j 1))) ((= j k) result) (let ((col-idx (vector-ref basis j))) (do ((i 0 (+ i 1))) ((= i m)) (matrix-set! result i j (matrix-ref A i col-idx)))))))"))
