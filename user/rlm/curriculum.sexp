(task-entry (id "algebra/polynomial/poly->string") (skill algebra) (module polynomial) (tier 0) (difficulty 346) (name poly->string) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm poly-eval poly-derivative poly-scalar-mul-int poly-square-free poly-square-free-factorization poly-sqf-loop poly-lagrange-interpolate poly-lagrange-sum poly-lagrange-basis poly-newton-interpolate poly-divided-differences poly-newton-form make-polynomial-ring)) (answer "(define (poly->string p . opts) (let* ((var (if (null? opts) 'x (car opts))) (F (poly-field p)) (coeffs (poly-coeffs p)) (n (length coeffs))) (if (and (= n 1) ((field-equal-fn F) (car coeffs) (field-zero F))) \"0\" (let loop ((i (- n 1)) (first? #t) (result \"\")) (if (< i 0) result (let* ((c (list-ref coeffs i)) (term (poly-term->string c i var first? F))) (loop (- i 1) (and first? (string=? term \"\")) (string-append result term))))))))"))
(task-entry (id "algebra/multivariate/mpoly-neg") (skill algebra) (module multivariate) (tier 0) (difficulty 346) (name mpoly-neg) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms assoc-mono update-assoc-mono mpoly-zero mpoly-one mpoly-constant mpoly-var mpoly-from-terms mpoly-zero? mpoly-degree mpoly-degree-in mpoly-leading-term mpoly-leading-coeff mpoly-leading-mono mpoly-add)) (answer "(define (mpoly-neg p) (let* ((F (mpoly-field p)) (neg (field-neg-fn F))) (make-mpoly (mpoly-field p) (mpoly-vars p) (mpoly-ordering p) (map (lambda (t) (cons (neg (car t)) (cdr t))) (mpoly-terms p)))))"))
