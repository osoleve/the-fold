(task-entry (id "statistics/ar/make-toeplitz-matrix") (skill statistics) (module ar) (tier 1) (difficulty 11202) (name make-toeplitz-matrix) (type "") (description "") (notes ()) (section ar-model-fitting) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (ar-fit center-series)) (answer "(define (make-toeplitz-matrix acf-vals p) (let* ((data (make-vector (* p p)))) (do ((i 0 (+ i 1))) ((= i p)) (do ((j 0 (+ j 1))) ((= j p)) (vector-set! data (+ (* i p) j) (vector-ref acf-vals (abs (- i j)))))) (list 'matrix p p data)))"))
