(task-entry (id "clp/domain/domain-from-list") (skill clp) (module domain) (tier 1) (difficulty 10802) (name domain-from-list) (type "(-> (List Int) Domain)") (description "Create a domain from an explicit list of values") (notes ("Values need not be sorted or unique")) (section domain-constructors) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton)) (answer "(define (domain-from-list vals) (if (null? vals) '() (let ((sorted (sort-by < (list-uniq vals)))) (intervals-from-sorted sorted))))"))
(task-entry (id "clp/store/cstore-subst") (skill clp) (module store) (tier 1) (difficulty 10802) (name cstore-subst) (type "(-> CStore Substitution)") (description "Get substitution from store") (notes ()) (section constraint-store-structure) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore?)) (answer "(define (cstore-subst cs) (list-ref cs 1))"))
(task-entry (id "clp/fd-constraints/=fd") (skill clp) (module fd-constraints) (tier 1) (difficulty 10802) (name =fd) (type "(-> (Or LVar Int) (Or LVar Int) (-> CStore (Maybe CStore)))") (description "Constrain two values to be equal (in the FD sense)") (notes ()) (section equality-constraints) (deps (\x27;store)) (available (in-range in-domain)) (answer "(define (=fd x y) (lambda (cs) (cond ((and (integer? x) (integer? y)) (if (= x y) cs #f)) ((integer? x) (=fd-var-const cs y x)) ((integer? y) (=fd-var-const cs x y)) (else (=fd-var-var cs x y)))))"))
(task-entry (id "clp/global-constraints/remove-singletons") (skill clp) (module global-constraints) (tier 1) (difficulty 10802) (name remove-singletons) (type "(-> CStore (List LVar) (Maybe CStore))") (description "For each singleton variable, remove its value from all other domains") (notes ()) (section all-different-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate)) (answer "(define (remove-singletons cs vars) (let loop ((vars vars) (cs cs)) (if (null? vars) cs (let* ((var (car vars)) (dom (cstore-get-domain cs var))) (if (and dom (domain-singleton? dom)) (let ((val (domain-min dom)) (others (filter (lambda (v) (not (eq? v var))) vars))) (let ((cs1 (remove-value-from-all cs val others))) (if cs1 (loop (cdr vars) cs1) #f))) (loop (cdr vars) cs))))))"))
(task-entry (id "clp/propagate/filter-constraints-by-var-id") (skill clp) (module propagate) (tier 1) (difficulty 10802) (name filter-constraints-by-var-id) (type "(-> (List Constraint) LVarId (List Constraint))") (description "Find constraints involving a specific variable ID") (notes ()) (section propagation-loop) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel)) (answer "(define (filter-constraints-by-var-id constraints var-id) (filter (lambda (c) (any (lambda (v) (= (lvar-id v) var-id)) (constraint-vars c))) constraints))"))
(task-entry (id "clp/label/most-constrained") (skill clp) (module label) (tier 1) (difficulty 10802) (name most-constrained) (type "(-> CStore (List LVar) (Maybe LVar))") (description "Select variable with smallest domain-to-constraint ratio (dom/deg)") (notes ("Uses number of constraints as tie-breaker for first-fail")) (section variable-ordering-strategies) (deps (\x27;propagate)) (available (input-order first-fail)) (answer "(define (most-constrained cs vars) (let loop ((vars vars) (best #f) (best-score +inf.0)) (if (null? vars) best (let* ((var (car vars)) (dom (cstore-get-domain cs var))) (cond ((not dom) (loop (cdr vars) (or best var) best-score)) ((domain-singleton? dom) (loop (cdr vars) best best-score)) (else (let* ((size (domain-size dom)) (degree (length (cstore-constraints-for-var cs var))) (score (/ size (+ degree 1)))) (if (< score best-score) (loop (cdr vars) var score) (loop (cdr vars) best best-score)))))))))"))
(task-entry (id "clp/clp/clp-goal") (skill clp) (module clp) (tier 1) (difficulty 10802) (name clp-goal) (type "(-> (-> CStore (Maybe CStore)) (-> CStore (Stream CStore)))") (description "Lift a propagator to a goal") (notes ()) (section goal-constructors) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail)) (answer "(define (clp-goal propagator) (lambda (cs) (let ((result (propagator cs))) (if result (clp-succeed result) (clp-fail cs)))))"))
(task-entry (id "fp/dsl/dsl-schema?") (skill fp) (module dsl) (tier 1) (difficulty 10803) (name dsl-schema?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;free \x27;effects)) (available (make-instruction instruction-tag instruction-payload instruction-cont dsl-fmap dsl-pure dsl-pure? dsl-suspended? dsl-pure-value dsl-instruction dsl-bind dsl-map dsl-emit dsl-request make-interpreter interpreter? interpreter-handler run-dsl run-dsl-helper run-dsl-eff run-dsl-state dsl-trace layered-interpreter composed-interpreter expr-lit expr-var expr-binop expr-unop expr-app expr-if expr-let expr-lambda expr-lit? expr-var? expr-binop? expr-unop? expr-app? expr-if? expr-let? expr-lambda? expr-lit-value expr-var-name expr-binop-op expr-binop-left expr-binop-right expr-unop-op expr-unop-operand expr-app-fn expr-app-args expr-if-cond expr-if-then expr-if-else expr-let-name expr-let-value expr-let-body expr-lambda-params expr-lambda-body eval-expr apply-binop apply-unop apply-closure stmt-assign stmt-seq stmt-if stmt-while stmt-return stmt-expr stmt-assign? stmt-seq? stmt-if? stmt-while? stmt-return? stmt-expr? stmt-assign-var stmt-assign-expr stmt-seq-stmts stmt-if-cond stmt-if-then stmt-if-else stmt-while-cond stmt-while-body stmt-return-expr stmt-expr-expr run-stmt run-stmt-seq run-stmt-while dsl-sequence dsl-for-each dsl-fold dsl-when dsl-unless dsl-replicate dsl-ap dsl-ap2 dsl-ap3 dsl-join dsl-kleisli dsl-fish dsl-compose make-tagless-dsl tagless-dsl? tagless-ops instantiate-tagless tagless-op make-source-pos source-pos? source-pos-line source-pos-col source-pos-offset no-source-pos make-located located? located-value located-pos make-located-instruction instruction-pos dsl-emit-at dsl-request-at format-source-pos dsl-error-at middleware-identity middleware-compose middleware-stack middleware-logging middleware-timing current-time middleware-cache middleware-guard middleware-transform with-middleware dsl-fold-program dsl-instruction-list dsl-program-depth dsl-uses-tag? dsl-tag-histogram dsl-optimize-dead-code dsl-fuse dsl-fix dsl-lazy make-bounce make-done bounce? done? bounce-thunk done-value run-trampoline run-dsl-trampolined run-dsl-trampoline-helper make-mock-interpreter dsl-test-case dsl-test-error dsl-programs-equiv? dsl-interpreter-equiv? make-recording-interpreter verify-instruction-sequence calc-push! calc-add! calc-sub! calc-mul! calc-div! calc-dup! calc-swap! calc-pop! make-calc-interpreter run-calc forward! back! left! right! penup! pendown! getpos! make-turtle-interpreter run-turtle repeat dsl-ok dsl-err dsl-ok? dsl-err? dsl-ok-value dsl-err-tag dsl-err-message dsl-result-map dsl-result-bind run-dsl-safe dsl-fail dsl-assert make-fail-handler dsl-peek dsl-count-instructions dsl-trace-when dsl-trace-tags dsl-pretty-print dsl-collect-tags dsl-left-tag dsl-right-tag dsl-left-tag? dsl-right-tag? dsl-unwrap-tag dsl-inject-left dsl-inject-right union-interpreter make-dsl-schema)) (answer "(define (dsl-schema? x) (and (pair? x) (eq? (car x) 'dsl-schema)))"))
(task-entry (id "clp/domain/intervals-from-sorted") (skill clp) (module domain) (tier 1) (difficulty 10803) (name intervals-from-sorted) (type "(-> (List Int) Domain)") (description "Convert sorted unique list to interval representation") (notes ()) (section domain-constructors) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list)) (answer "(define (intervals-from-sorted sorted) (if (null? sorted) '() (let loop ((vals (cdr sorted)) (start (car sorted)) (end (car sorted)) (acc '())) (cond ((null? vals) (reverse (cons (cons start end) acc))) ((= (car vals) (+ end 1)) (loop (cdr vals) start (car vals) acc)) (else (loop (cdr vals) (car vals) (car vals) (cons (cons start end) acc)))))))"))
(task-entry (id "clp/store/cstore-domains") (skill clp) (module store) (tier 1) (difficulty 10803) (name cstore-domains) (type "(-> CStore (Alist LVarId Domain))") (description "Get domain bindings from store") (notes ()) (section constraint-store-structure) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst)) (answer "(define (cstore-domains cs) (list-ref cs 2))"))
(task-entry (id "clp/fd-constraints/=fd-var-const") (skill clp) (module fd-constraints) (tier 1) (difficulty 10803) (name =fd-var-const) (type "(-> CStore LVar Int (Maybe CStore))") (description "Constrain variable to equal a constant") (notes ()) (section equality-constraints) (deps (\x27;store)) (available (in-range in-domain =fd)) (answer "(define (=fd-var-const cs var val) (let ((dom (cstore-get-domain cs var))) (cond ((not dom) (cstore-set-domain cs var (domain-singleton val))) ((domain-contains? dom val) (cstore-set-domain cs var (domain-singleton val))) (else #f))))"))
(task-entry (id "clp/global-constraints/remove-value-from-all") (skill clp) (module global-constraints) (tier 1) (difficulty 10803) (name remove-value-from-all) (type "(-> CStore Int (List LVar) (Maybe CStore))") (description "Remove a value from all variables in list") (notes ()) (section all-different-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons)) (answer "(define (remove-value-from-all cs val vars) (let loop ((vars vars) (cs cs)) (if (null? vars) cs (let* ((var (car vars)) (dom (cstore-get-domain cs var))) (if dom (let ((new-dom (domain-subtract-value dom val))) (if (domain-empty? new-dom) #f (let ((cs1 (cstore-set-domain cs var new-dom))) (if cs1 (loop (cdr vars) cs1) #f)))) (loop (cdr vars) cs))))))"))
(task-entry (id "clp/propagate/propagate-constraints") (skill clp) (module propagate) (tier 1) (difficulty 10803) (name propagate-constraints) (type "(-> CStore (List Constraint) Nat (Maybe CStore))") (description "Run each constraint's propagator and continue propagation") (notes ()) (section propagation-loop) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id)) (answer "(define (propagate-constraints cs constraints fuel) (if (null? constraints) (propagate-with-fuel cs fuel) (let* ((constraint (car constraints)) (propagator (constraint-propagator constraint)) (cs1 (propagator cs))) (if (not cs1) #f (propagate-constraints cs1 (cdr constraints) fuel)))))"))
(task-entry (id "clp/label/max-regret") (skill clp) (module label) (tier 1) (difficulty 10803) (name max-regret) (type "(-> CStore (List LVar) (Maybe LVar))") (description "Select variable with largest difference between two smallest values") (notes ()) (section variable-ordering-strategies) (deps (\x27;propagate)) (available (input-order first-fail most-constrained)) (answer "(define (max-regret cs vars) (let loop ((vars vars) (best #f) (best-regret -1)) (if (null? vars) best (let* ((var (car vars)) (dom (cstore-get-domain cs var))) (cond ((not dom) (loop (cdr vars) (or best var) best-regret)) ((domain-singleton? dom) (loop (cdr vars) best best-regret)) (else (let* ((vals (domain->list dom)) (regret (if (< (length vals) 2) 0 (- (cadr vals) (car vals))))) (if (> regret best-regret) (loop (cdr vars) var regret) (loop (cdr vars) best best-regret)))))))))"))
(task-entry (id "clp/clp/clp-conj") (skill clp) (module clp) (tier 1) (difficulty 10803) (name clp-conj) (type "(-> Goal Goal Goal)") (description "Conjunction: run g1 then g2") (notes ()) (section goal-combinators) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal)) (answer "(define (clp-conj g1 g2) (lambda (cs) (stream-flatmap (lambda (cs1) (g2 cs1)) (g1 cs))))"))
(task-entry (id "fp/dsl/dsl-schema-instructions") (skill fp) (module dsl) (tier 1) (difficulty 10804) (name dsl-schema-instructions) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;free \x27;effects)) (available (make-instruction instruction-tag instruction-payload instruction-cont dsl-fmap dsl-pure dsl-pure? dsl-suspended? dsl-pure-value dsl-instruction dsl-bind dsl-map dsl-emit dsl-request make-interpreter interpreter? interpreter-handler run-dsl run-dsl-helper run-dsl-eff run-dsl-state dsl-trace layered-interpreter composed-interpreter expr-lit expr-var expr-binop expr-unop expr-app expr-if expr-let expr-lambda expr-lit? expr-var? expr-binop? expr-unop? expr-app? expr-if? expr-let? expr-lambda? expr-lit-value expr-var-name expr-binop-op expr-binop-left expr-binop-right expr-unop-op expr-unop-operand expr-app-fn expr-app-args expr-if-cond expr-if-then expr-if-else expr-let-name expr-let-value expr-let-body expr-lambda-params expr-lambda-body eval-expr apply-binop apply-unop apply-closure stmt-assign stmt-seq stmt-if stmt-while stmt-return stmt-expr stmt-assign? stmt-seq? stmt-if? stmt-while? stmt-return? stmt-expr? stmt-assign-var stmt-assign-expr stmt-seq-stmts stmt-if-cond stmt-if-then stmt-if-else stmt-while-cond stmt-while-body stmt-return-expr stmt-expr-expr run-stmt run-stmt-seq run-stmt-while dsl-sequence dsl-for-each dsl-fold dsl-when dsl-unless dsl-replicate dsl-ap dsl-ap2 dsl-ap3 dsl-join dsl-kleisli dsl-fish dsl-compose make-tagless-dsl tagless-dsl? tagless-ops instantiate-tagless tagless-op make-source-pos source-pos? source-pos-line source-pos-col source-pos-offset no-source-pos make-located located? located-value located-pos make-located-instruction instruction-pos dsl-emit-at dsl-request-at format-source-pos dsl-error-at middleware-identity middleware-compose middleware-stack middleware-logging middleware-timing current-time middleware-cache middleware-guard middleware-transform with-middleware dsl-fold-program dsl-instruction-list dsl-program-depth dsl-uses-tag? dsl-tag-histogram dsl-optimize-dead-code dsl-fuse dsl-fix dsl-lazy make-bounce make-done bounce? done? bounce-thunk done-value run-trampoline run-dsl-trampolined run-dsl-trampoline-helper make-mock-interpreter dsl-test-case dsl-test-error dsl-programs-equiv? dsl-interpreter-equiv? make-recording-interpreter verify-instruction-sequence calc-push! calc-add! calc-sub! calc-mul! calc-div! calc-dup! calc-swap! calc-pop! make-calc-interpreter run-calc forward! back! left! right! penup! pendown! getpos! make-turtle-interpreter run-turtle repeat dsl-ok dsl-err dsl-ok? dsl-err? dsl-ok-value dsl-err-tag dsl-err-message dsl-result-map dsl-result-bind run-dsl-safe dsl-fail dsl-assert make-fail-handler dsl-peek dsl-count-instructions dsl-trace-when dsl-trace-tags dsl-pretty-print dsl-collect-tags dsl-left-tag dsl-right-tag dsl-left-tag? dsl-right-tag? dsl-unwrap-tag dsl-inject-left dsl-inject-right union-interpreter make-dsl-schema dsl-schema?)) (answer "(define (dsl-schema-instructions schema) (cadr schema))"))
(task-entry (id "clp/domain/list-uniq") (skill clp) (module domain) (tier 1) (difficulty 10804) (name list-uniq) (type "(-> (List α) (List α))") (description "Remove duplicates from a list (preserves first occurrence)") (notes ()) (section domain-constructors) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted)) (answer "(define (list-uniq lst) (let loop ((lst lst) (seen '()) (acc '())) (cond ((null? lst) (reverse acc)) ((member (car lst) seen) (loop (cdr lst) seen acc)) (else (loop (cdr lst) (cons (car lst) seen) (cons (car lst) acc))))))"))
(task-entry (id "clp/store/cstore-constraints") (skill clp) (module store) (tier 1) (difficulty 10804) (name cstore-constraints) (type "(-> CStore (List Constraint))") (description "Get active constraints from store") (notes ()) (section constraint-store-structure) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains)) (answer "(define (cstore-constraints cs) (list-ref cs 3))"))
(task-entry (id "clp/fd-constraints/=fd-var-var") (skill clp) (module fd-constraints) (tier 1) (difficulty 10804) (name =fd-var-var) (type "(-> CStore LVar LVar (Maybe CStore))") (description "Constrain two variables to be equal") (notes ()) (section equality-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const)) (answer "(define (=fd-var-var cs x y) (let ((dom-x (cstore-get-domain cs x)) (dom-y (cstore-get-domain cs y))) (cond ((and dom-x dom-y) (let ((merged (domain-intersect dom-x dom-y))) (if (domain-empty? merged) #f (let* ((cs1 (cstore-set-domain cs x merged))) (and cs1 (cstore-set-domain cs1 y merged)))))) (dom-x (cstore-set-domain cs y dom-x)) (dom-y (cstore-set-domain cs x dom-y)) (else cs))))"))
(task-entry (id "clp/global-constraints/check-singleton-conflict") (skill clp) (module global-constraints) (tier 1) (difficulty 10804) (name check-singleton-conflict) (type "(-> CStore (List LVar) Bool)") (description "Check if any two singletons have the same value") (notes ()) (section all-different-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all)) (answer "(define (check-singleton-conflict cs vars) (let* ((singleton-vals (filter-map (lambda (var) (let ((dom (cstore-get-domain cs var))) (if (and dom (domain-singleton? dom)) (domain-min dom) #f))) vars)) (unique-vals (list-uniq singleton-vals))) (not (= (length singleton-vals) (length unique-vals)))))"))
(task-entry (id "clp/propagate/post-constraint") (skill clp) (module propagate) (tier 1) (difficulty 10804) (name post-constraint) (type "(-> CStore Symbol (List LVar) (-> CStore (Maybe CStore)) (Maybe CStore))") (description "Create a constraint, add it to the store, and run initial propagation") (notes ()) (section posting-constraints) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints)) (answer "(define (post-constraint cs type vars propagator) (let* ((constraint (make-constraint type vars propagator)) (cs1 (cstore-add-constraint cs constraint)) (cs2 (fold-left (lambda (s v) (cstore-add-pending s v)) cs1 vars)) (cs3 (propagator cs2))) (and cs3 (propagate cs3))))"))
(task-entry (id "clp/label/min-value") (skill clp) (module label) (tier 1) (difficulty 10804) (name min-value) (type "(-> Domain Int)") (description "Select minimum value from domain") (notes ()) (section value-selection-strategies) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret)) (answer "(define (min-value dom) (domain-min dom))"))
(task-entry (id "clp/clp/clp-disj") (skill clp) (module clp) (tier 1) (difficulty 10804) (name clp-disj) (type "(-> Goal Goal Goal)") (description "Disjunction: try both g1 and g2") (notes ()) (section goal-combinators) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj)) (answer "(define (clp-disj g1 g2) (lambda (cs) (stream-interleave (g1 cs) (lambda () (g2 cs)))))"))
(task-entry (id "fp/dsl/dsl-validate") (skill fp) (module dsl) (tier 1) (difficulty 10805) (name dsl-validate) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;free \x27;effects)) (available (make-instruction instruction-tag instruction-payload instruction-cont dsl-fmap dsl-pure dsl-pure? dsl-suspended? dsl-pure-value dsl-instruction dsl-bind dsl-map dsl-emit dsl-request make-interpreter interpreter? interpreter-handler run-dsl run-dsl-helper run-dsl-eff run-dsl-state dsl-trace layered-interpreter composed-interpreter expr-lit expr-var expr-binop expr-unop expr-app expr-if expr-let expr-lambda expr-lit? expr-var? expr-binop? expr-unop? expr-app? expr-if? expr-let? expr-lambda? expr-lit-value expr-var-name expr-binop-op expr-binop-left expr-binop-right expr-unop-op expr-unop-operand expr-app-fn expr-app-args expr-if-cond expr-if-then expr-if-else expr-let-name expr-let-value expr-let-body expr-lambda-params expr-lambda-body eval-expr apply-binop apply-unop apply-closure stmt-assign stmt-seq stmt-if stmt-while stmt-return stmt-expr stmt-assign? stmt-seq? stmt-if? stmt-while? stmt-return? stmt-expr? stmt-assign-var stmt-assign-expr stmt-seq-stmts stmt-if-cond stmt-if-then stmt-if-else stmt-while-cond stmt-while-body stmt-return-expr stmt-expr-expr run-stmt run-stmt-seq run-stmt-while dsl-sequence dsl-for-each dsl-fold dsl-when dsl-unless dsl-replicate dsl-ap dsl-ap2 dsl-ap3 dsl-join dsl-kleisli dsl-fish dsl-compose make-tagless-dsl tagless-dsl? tagless-ops instantiate-tagless tagless-op make-source-pos source-pos? source-pos-line source-pos-col source-pos-offset no-source-pos make-located located? located-value located-pos make-located-instruction instruction-pos dsl-emit-at dsl-request-at format-source-pos dsl-error-at middleware-identity middleware-compose middleware-stack middleware-logging middleware-timing current-time middleware-cache middleware-guard middleware-transform with-middleware dsl-fold-program dsl-instruction-list dsl-program-depth dsl-uses-tag? dsl-tag-histogram dsl-optimize-dead-code dsl-fuse dsl-fix dsl-lazy make-bounce make-done bounce? done? bounce-thunk done-value run-trampoline run-dsl-trampolined run-dsl-trampoline-helper make-mock-interpreter dsl-test-case dsl-test-error dsl-programs-equiv? dsl-interpreter-equiv? make-recording-interpreter verify-instruction-sequence calc-push! calc-add! calc-sub! calc-mul! calc-div! calc-dup! calc-swap! calc-pop! make-calc-interpreter run-calc forward! back! left! right! penup! pendown! getpos! make-turtle-interpreter run-turtle repeat dsl-ok dsl-err dsl-ok? dsl-err? dsl-ok-value dsl-err-tag dsl-err-message dsl-result-map dsl-result-bind run-dsl-safe dsl-fail dsl-assert make-fail-handler dsl-peek dsl-count-instructions dsl-trace-when dsl-trace-tags dsl-pretty-print dsl-collect-tags dsl-left-tag dsl-right-tag dsl-left-tag? dsl-right-tag? dsl-unwrap-tag dsl-inject-left dsl-inject-right union-interpreter make-dsl-schema dsl-schema? dsl-schema-instructions)) (answer "(define (dsl-validate schema program fuel) (cond ((<= fuel 0) (dsl-ok program)) ((dsl-pure? program) (dsl-ok program)) (else (let* ((instr (dsl-instruction program)) (tag (instruction-tag instr)) (payload (instruction-payload instr)) (cont (instruction-cont instr)) (valid-tags (dsl-schema-instructions schema))) (if (assoc tag valid-tags) (dsl-validate schema (cont '()) (- fuel 1)) (dsl-err 'invalid-instruction (format \"Unknown instruction: ~a\" tag)))))))"))
(task-entry (id "clp/domain/domain?") (skill clp) (module domain) (tier 1) (difficulty 10805) (name domain?) (type "(-> α Bool)") (description "Check if value is a valid domain") (notes ()) (section domain-predicates) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq)) (answer "(define (domain? x) (and (list? x) (or (null? x) (and (pair? (car x)) (integer? (caar x)) (integer? (cdar x)) (<= (caar x) (cdar x))))))"))
(task-entry (id "clp/store/cstore-pending") (skill clp) (module store) (tier 1) (difficulty 10805) (name cstore-pending) (type "(-> CStore (List LVarId))") (description "Get pending propagation queue from store") (notes ()) (section constraint-store-structure) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints)) (answer "(define (cstore-pending cs) (list-ref cs 4))"))
(task-entry (id "clp/fd-constraints/<fd") (skill clp) (module fd-constraints) (tier 1) (difficulty 10805) (name <fd) (type "(-> (Or LVar Int) (Or LVar Int) (-> CStore (Maybe CStore)))") (description "Constrain x < y") (notes ()) (section comparison-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var)) (answer "(define (<fd x y) (lambda (cs) (cond ((and (integer? x) (integer? y)) (if (< x y) cs #f)) ((integer? x) (let ((dom-y (cstore-get-domain cs y))) (if dom-y (cstore-narrow-domain cs y (domain-restrict-min dom-y (+ x 1))) cs))) ((integer? y) (let ((dom-x (cstore-get-domain cs x))) (if dom-x (cstore-narrow-domain cs x (domain-restrict-max dom-x (- y 1))) cs))) (else (<fd-var-var cs x y)))))"))
(task-entry (id "clp/global-constraints/list-uniq-global") (skill clp) (module global-constraints) (tier 1) (difficulty 10805) (name list-uniq-global) (type "(-> (List α) (List α))") (description "Remove duplicates from list") (notes ()) (section all-different-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict)) (answer "(define (list-uniq-global lst) (let loop ((lst lst) (seen '()) (acc '())) (cond ((null? lst) (reverse acc)) ((member (car lst) seen) (loop (cdr lst) seen acc)) (else (loop (cdr lst) (cons (car lst) seen) (cons (car lst) acc))))))"))
(task-entry (id "clp/propagate/post-in-range") (skill clp) (module propagate) (tier 1) (difficulty 10805) (name post-in-range) (type "(-> CStore LVar Int Int (Maybe CStore))") (description "Post domain constraint and propagate") (notes ()) (section high-level-constraint-posting) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint)) (answer "(define (post-in-range cs var lo hi) (let ((cs1 ((in-range var lo hi) cs))) (and cs1 (propagate cs1))))"))
(task-entry (id "clp/label/max-value") (skill clp) (module label) (tier 1) (difficulty 10805) (name max-value) (type "(-> Domain Int)") (description "Select maximum value from domain") (notes ()) (section value-selection-strategies) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value)) (answer "(define (max-value dom) (domain-max dom))"))
(task-entry (id "clp/clp/clp-conj*") (skill clp) (module clp) (tier 1) (difficulty 10805) (name clp-conj*) (type "(-> (List Goal) Goal)") (description "Conjunction of multiple goals") (notes ()) (section goal-combinators) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj)) (answer "(define (clp-conj* goals) (if (null? goals) clp-succeed (clp-conj (car goals) (clp-conj* (cdr goals)))))"))
