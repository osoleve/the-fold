(task-entry (id "data/centrality/standard-closeness-node") (skill data) (module centrality) (tier 0) (difficulty 1312) (name standard-closeness-node) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality)) (answer "(define (standard-closeness-node dist i n) (let loop ((j 0) (sum 0) (reachable 0)) (if (= j n) (if (= reachable 0) 0 (/ (- n 1.0) sum)) (if (= i j) (loop (+ j 1) sum reachable) (let ((d (matrix-ref dist i j))) (if (>= d *infinity*) (loop (+ j 1) sum reachable) (loop (+ j 1) (+ sum d) (+ reachable 1))))))))"))
(task-entry (id "data/graph-community/uf-find") (skill data) (module graph-community) (tier 0) (difficulty 1312) (name uf-find) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst)) (answer "(define (uf-find parent x) (if (= x (vector-ref parent x)) x (let ((root (uf-find parent (vector-ref parent x)))) (vector-set! parent x root) root)))"))
