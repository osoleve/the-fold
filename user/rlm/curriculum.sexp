(task-entry (id "egraph/union-find/uf-all-sets-table") (skill egraph) (module union-find) (tier 1) (difficulty 10015) (name uf-all-sets-table) (type "") (description "") (notes ()) (section introspection) (deps (\x27;prelude)) (available (uf-tag make-uf uf? uf-parent uf-rank uf-count-box uf-next-id-box uf-count uf-size ensure-capacity! uf-make-set! uf-find uf-union! uf-same-set? uf-roots)) (answer "(define (uf-all-sets-table uf) (let ((n (uf-size uf)) (table (make-eqv-hashtable))) (do ((i 0 (+ i 1))) ((>= i n) table) (let ((root (uf-find uf i))) (hashtable-set! table root (cons i (hashtable-ref table root '())))))))"))
