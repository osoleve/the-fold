(task-entry (id "physics/classical/raycasting/ray2-circle") (skill physics/classical) (module raycasting) (tier 2) (difficulty 23514) (name ray2-circle) (type "") (description "") (notes ()) (section ray-circle) (deps (\x27;prelude \x27;vec2 \x27;collision-detection)) (available (*ray-epsilon* make-ray2 ray2? ray2-origin ray2-direction ray2-max-dist ray2-point-at make-hit-info hit-info? hit-info-distance hit-info-point hit-info-normal hit-info-shape ray2-aabb)) (answer "(define (ray2-circle ray circle) (let* ((origin (ray2-origin ray)) (dir (ray2-direction ray)) (max-dist (ray2-max-dist ray)) (center (circle-center circle)) (radius (circle-radius circle))) (if (<= radius 0) #f (let* ((oc (vec2-sub origin center)) (b (* 2 (vec2-dot oc dir))) (c (- (vec2-magnitude-sq oc) (* radius radius))) (discriminant (- (* b b) (* 4 c)))) (cond ((< discriminant 0) #f) (else (let* ((sqrt-d (sqrt discriminant)) (t1 (/ (- (- b) sqrt-d) 2)) (t2 (/ (+ (- b) sqrt-d) 2)) (t (cond ((and (>= t1 0) (<= t1 max-dist)) t1) ((and (>= t2 0) (<= t2 max-dist)) t2) (else #f)))) (if (not t) #f (let* ((point (ray2-point-at ray t)) (normal (vec2-normalize (vec2-sub point center)))) (make-hit-info t point normal circle))))))))))"))
