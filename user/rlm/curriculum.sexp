(task-entry (id "data/collection-utils/for-each-collection") (skill data) (module collection-utils) (tier 0) (difficulty 1308) (name for-each-collection) (type "(-> FSCap (-> Block Void) Block Void)") (description "Execute function for each member (for side effects)") (notes ()) (section higher-order-collection-functions) (deps (\x27;block \x27;sha256)) (available (foldr collection-hashes collection-size collection-empty? map-collection filter-collection fold-collection foldr-collection)) (answer "(define (for-each-collection fs f collection) (let ((hashes (collection-hashes collection))) (for-each (lambda (h) (let ((block (fs-fetch fs h))) (when block (f block)))) hashes)))"))
