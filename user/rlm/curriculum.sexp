(task-entry (id "dataset/sexp/validate-sample-sexp") (skill dataset) (module sexp) (tier 1) (difficulty 13410) (name validate-sample-sexp) (type "") (description "") (notes ()) (section validation) (deps (core/base/prelude.ss lattice/dataset/sample.ss lattice/data/sort.ss)) (available (sample->canonical-sexp sort-alist canonical-sexp->sample dataset->sexp sexp->dataset sexp->string sexp->pretty-string pp-sexp sexp-length join-strings)) (answer "(define (validate-sample-sexp sexp) (guard (e (else (err (format \"Parse error: ~a\" e)))) (let ((sample (canonical-sexp->sample sexp))) (if (sample-valid? sample) (ok sample) (err \"Invalid sample structure\")))))"))
