(task-entry (id "autodiff/profiling/tally-ops") (skill autodiff) (module profiling) (tier 1) (difficulty 12708) (name tally-ops) (type "") (description "") (notes ()) (section tape-statistics) (deps (\x27;prelude \x27;comp-graph \x27;reverse-diff \x27;sort)) (available (tape-stats tape-size tape-op-count graph-stats graph-edge-count graph-depth extract-input-ids find-node-id)) (answer "(define (tally-ops ops) (let ((counts (make-hashtable symbol-hash eq?))) (for-each (lambda (op) (hashtable-set! counts op (+ 1 (hashtable-ref counts op 0)))) ops) (let-values (((keys vals) (hashtable-entries counts))) (map cons (vector->list keys) (vector->list vals)))))"))
(task-entry (id "autodiff/symbolic-diff/simplify-sum") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12708) (name simplify-sum) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once)) (answer "(define (simplify-sum terms) (let* ((flat-terms (flatten-sums terms)) (numeric-sum (apply + (filter-map get-numeric flat-terms))) (non-numeric (filter (lambda (e) (not (num? e))) flat-terms)) (collected (collect-like-terms non-numeric))) (cond ((and (null? collected) (= numeric-sum 0)) (num 0)) ((null? collected) (num numeric-sum)) ((= numeric-sum 0) (make-sum-from-list collected)) (else (make-sum-from-list (cons (num numeric-sum) collected))))))"))
