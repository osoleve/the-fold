(task-entry (id "physics-problems/simulation/make-problem-renderer") (skill physics-problems) (module simulation) (tier 2) (difficulty 23619) (name make-problem-renderer) (type "") (description "") (notes ()) (section rendering) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static make-box make-ground setup-problem-world setup-no-gravity-world setup-gravity-world simulate-step simulate-n-steps simulate-frames)) (answer "(define (make-problem-renderer config) (let ((render-config (make-render-config (problem-config-width config) (problem-config-height config) (problem-config-scale config) (quotient (problem-config-width config) 2) (- (problem-config-height config) 5)))) (make-world-renderer render-config (default-debug-options) (default-render-style))))"))
(task-entry (id "physics-problems/spatial/position-answer") (skill physics-problems) (module spatial) (tier 2) (difficulty 23619) (name position-answer) (type "") (description "") (notes ()) (section position) (deps (\x27;physics-problem)) (available (size-comparison-params size-comparison-setup size-comparison-question size-comparison-answer size-comparison-problem distance-params distance-setup distance-question distance-answer distance-problem count-params count-setup make-count-entities count-question count-answer count-problem position-params position-setup position-question)) (answer "(define (position-answer initial-world final-world params) (let* ((xl (cdr (assq 'x-left params))) (xr (cdr (assq 'x-right params))) (swap? (= 1 (cdr (assq 'swap params)))) (xa (if swap? xr xl)) (xb (if swap? xl xr))) (if (> xa xb) 'A 'B)))"))
(task-entry (id "physics-problems/physics-problem/format-frames-for-display") (skill physics-problems) (module physics-problem) (tier 2) (difficulty 23620) (name format-frames-for-display) (type "") (description "") (notes ()) (section presentation) (deps (\x27;prelude \x27;vec2 \x27;sample \x27;parameter \x27;presentation \x27;distractor \x27;difficulty \x27;simulation)) (available (make-physics-problem physics-problem? problem-name problem-category problem-params problem-world-setup problem-question-gen problem-answer-compute problem-difficulty generate-problem-instance generate-problem-id generate-problem-options find-correct-label string-contains-approx? format-answer category-distractor-strategies category-comparison-choices generate-problem-batch validate-problem-params check-visual-solvability)) (answer "(define (format-frames-for-display frames) (let* ((n (length frames)) (frame-strs (map (lambda (f i) (string-append \"Frame \" (number->string i) \":\n\" f)) frames (iota n)))) (apply string-append (map (lambda (s) (string-append s \"\n\n\")) frame-strs))))"))
