(task-entry (id "algebra/galois/make-gf-extension-large") (skill algebra) (module galois) (tier 0) (difficulty 310) (name make-gf-extension-large) (type "(-> Int Int Polynomial Field)") (description "Create GF(p^n) without enumeration, for large fields") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension)) (answer "(define (make-gf-extension-large p n modulus) (let* ((base-field (make-field-zp-large p)) (order (expt p n)) (zero-coeffs (list (field-zero base-field))) (one-coeffs (list (field-one base-field)))) (make-field* '() (lambda (a b) (gf-ext-add a b base-field n modulus)) (lambda (a b) (gf-ext-mul a b base-field n modulus)) (make-gf-ext-element zero-coeffs modulus base-field) (make-gf-ext-element one-coeffs modulus base-field) (lambda (a) (gf-ext-neg a base-field n modulus)) (lambda (a b) (gf-ext-div a b base-field n modulus)) (lambda (a b) (gf-ext-equal? a b base-field)) (quasiquote ((order unquote order) (characteristic unquote p) (degree unquote n))))))"))
