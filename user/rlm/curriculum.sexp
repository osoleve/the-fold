(task-entry (id "fp/poly-canonical/expr->polynomial") (skill fp) (module poly-canonical) (tier 1) (difficulty 10601) (name expr->polynomial) (type "(-> Expr Symbol Field (Maybe AlgebraPoly))") (description "Convert symbolic expression to polynomial over given field") (notes ("Returns #f if expression is not polynomial; variable becomes indeterminate, other symbols are constants")) (section conversion) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym)) (answer "(define (expr->polynomial expr var-sym field) (if (not (polynomial-expr? expr var-sym)) #f (let ((degree (expr-degree expr var-sym))) (if (< degree 0) #f (let ((coeffs (extract-poly-coeffs expr var-sym degree field))) (make-polynomial field coeffs))))))"))
