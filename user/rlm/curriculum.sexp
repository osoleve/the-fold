(task-entry (id "fp/expr/sum") (skill fp) (module expr) (tier 1) (difficulty 10609) (name sum) (type "(-> Expr Expr Expr)") (description "Create sum with basic simplifications") (notes ()) (section smart-constructors) (deps (\x27;prelude)) (available (num var make-sum make-product make-diff make-neg make-div make-pow make-app)) (answer "(define (sum e1 e2) (cond ((and (num? e1) (= (num-val e1) 0)) e2) ((and (num? e2) (= (num-val e2) 0)) e1) ((and (num? e1) (num? e2)) (num (+ (num-val e1) (num-val e2)))) (else (list '+ e1 e2))))"))
(task-entry (id "fp/diff/directional-derivative") (skill fp) (module diff) (tier 1) (difficulty 10609) (name directional-derivative) (type "(-> Expr (List Symbol) (List Expr) Expr)") (description "Compute directional derivative ∇f · v") (notes ("Returns ∇f · v = Σ(∂f/∂xᵢ * vᵢ)")) (section directional-derivative) (deps (\x27;expr)) (available (fold-sum fold-product deriv deriv-fn partial gradient jacobian hessian deriv-n)) (answer "(define (directional-derivative expr vars direction) (let ((grad (gradient expr vars))) (fold-sum (map product grad direction))))"))
