(task-entry (id "statistics/summary-stats/kurtosis") (skill statistics) (module summary-stats) (tier 1) (difficulty 11227) (name kurtosis) (type "(-> (List Num) Num)") (description "Excess kurtosis (fourth standardized moment minus 3)") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max vec-median vec-quantile vec-quantiles vec-covariance vec-correlation sem vec-sem skewness)) (answer "(define (kurtosis xs) (let* ((n (length xs)) (mu (mean xs)) (s (std-dev-population xs)) (m4 (/ (fold-left + 0 (map (lambda (x) (expt (- x mu) 4)) xs)) n))) (if (= s 0) 0 (- (/ m4 (expt s 4)) 3))))"))
(task-entry (id "statistics/result-types/glm-fitted") (skill statistics) (module result-types) (tier 1) (difficulty 11228) (name glm-fitted) (type "") (description "") (notes ()) (section glm-results) (deps (\x27;prelude)) (available (make-linear-model-result linear-model? linear-model-coefficients linear-model-se linear-model-t-values linear-model-p-values linear-model-r-squared linear-model-adj-r-squared linear-model-residuals linear-model-fitted linear-model-sse linear-model-mse linear-model-n linear-model-p linear-model-df-residual linear-model-sigma make-glm-result glm-result? glm-family glm-link glm-coefficients glm-se glm-z-values glm-p-values glm-deviance glm-null-deviance glm-aic glm-residuals)) (answer "(define (glm-fitted m) (list-ref m 11))"))
(task-entry (id "statistics/summary-stats/vec-skewness") (skill statistics) (module summary-stats) (tier 1) (difficulty 11228) (name vec-skewness) (type "(-> Vec Num)") (description "Population skewness (vector version)") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max vec-median vec-quantile vec-quantiles vec-covariance vec-correlation sem vec-sem skewness kurtosis)) (answer "(define (vec-skewness v) (let* ((n (vector-length v)) (mu (vec-mean v)) (m2 (let loop ((i 0) (s 0)) (if (= i n) (/ s n) (let ((d (- (vector-ref v i) mu))) (loop (+ i 1) (+ s (* d d))))))) (sigma (sqrt m2)) (m3 (let loop ((i 0) (s 0)) (if (= i n) (/ s n) (let ((d (- (vector-ref v i) mu))) (loop (+ i 1) (+ s (* d d d)))))))) (if (= sigma 0) 0 (/ m3 (* sigma sigma sigma)))))"))
