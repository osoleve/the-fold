(task-entry (id "dsl/tagless/validate-chronicle-dict") (skill dsl) (module tagless) (tier 1) (difficulty 11768) (name validate-chronicle-dict) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops dict-ref dict-has? dict-extend dict-merge make-expr-dict expr-lit expr-add expr-neg eval-expr-dict pretty-expr-dict count-expr-dict depth-expr-dict example-expr-1 example-expr-2 make-mul-dict expr-mul eval-mul-dict pretty-mul-dict example-mul make-bool-dict bool-lit bool-and bool-or bool-not eval-bool-dict pretty-bool-dict make-cmp-dict cmp-eq cmp-lt cmp-gt eval-full-dict make-cond-dict cond-if-lazy eval-cond-dict pretty-cond-dict make-lazy-cond-dict lazy-if eval-lazy-cond-dict make-let-dict tl-let tl-var make-env-expr-dict env-lit env-add env-neg env-let env-var run-env-expr example-let make-stateful-dict state-get state-put state-pure state-bind state-monad-dict run-state make-chronicle-dict ch-scene ch-choice ch-guard ch-effect ch-text ch-start ch-choose ch-render)) (answer "(define validate-chronicle-dict (make-chronicle-dict (lambda (id text . choices) (quasiquote (scene (unquote id) (unquote (length choices)) choices))) (lambda (label target . opts) (quasiquote (choice (unquote label) -> (unquote target)))) (lambda (pred) pred) (lambda (eff) eff) (lambda (template) template) (lambda (chronicle) '(run initial)) (lambda (run idx) (quasiquote (chose (unquote idx)))) (lambda (run) (quasiquote (render (unquote run))))))"))
