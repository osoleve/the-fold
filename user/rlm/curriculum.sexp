(task-entry (id "algebra/galois/poly-has-factor-up-to-degree?") (skill algebra) (module galois) (tier 0) (difficulty 337) (name poly-has-factor-up-to-degree?) (type "") (description "") (notes ()) (section irreducible-polynomials) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod unique-prime-divisors poly-frobenius-power rabin-irreducible? poly-irreducible?)) (answer "(define (poly-has-factor-up-to-degree? p max-deg F) (let ((elts (field-elements F))) (if (null? elts) (poly-has-root? p F) (let loop ((deg 1)) (and (<= deg max-deg) (or (poly-has-monic-factor-of-degree? p deg F elts) (loop (+ deg 1))))))))"))
