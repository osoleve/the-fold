(task-entry (id "pipeline/council/council-sequential") (skill pipeline) (module council) (tier 2) (difficulty 21520) (name council-sequential) (type "") (description "") (notes ()) (section sequential-council) (deps (\x27;sort \x27;pipeline/stage \x27;pipeline/effects \x27;pipeline/context)) (available (range-from make-council-config council-config? council-models council-mode council-rounds council-moderator council-topic-template council-round-prompts council-synthesis-prompt council-require-consensus council-timeout make-council-result council-result? result-responses result-synthesis result-consensus result-dissent result-votes result-history)) (answer "(define (council-sequential models rounds moderator) (let ((default-prompts (map (lambda (r) (cond ((= r 1) \"Share your initial position on: ${topic}\") ((= r 2) \"Respond to the other positions. Do you agree or disagree? Why?\") (else \"Seek synthesis or clarify remaining disagreements.\"))) (range-from 1 rounds)))) (council-sequential-with-prompts models rounds moderator default-prompts)))"))
