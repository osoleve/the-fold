(task-entry (id "algebra/groebner/s-polynomial") (skill algebra) (module groebner) (tier 0) (difficulty 300) (name s-polynomial) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available ()) (answer "(define (s-polynomial f g) (let* ((F (mpoly-field f)) (vars (mpoly-vars f)) (ordering (mpoly-ordering f)) (lt-f (mpoly-leading-term f)) (lt-g (mpoly-leading-term g)) (lc-f (car lt-f)) (lc-g (car lt-g)) (lm-f (cdr lt-f)) (lm-g (cdr lt-g)) (lcm-fg (mono-lcm lm-f lm-g)) (quot-f (mono-div lcm-fg lm-f)) (quot-g (mono-div lcm-fg lm-g)) (term-f (cons lc-g quot-f)) (term-g (cons lc-f quot-g))) (mpoly-sub (mpoly-mul-term f term-f) (mpoly-mul-term g term-g))))"))
