(task-entry (id "data/collection-protocol/coll-find") (skill data) (module collection-protocol) (tier 0) (difficulty 1305) (name coll-find) (type "(-> Collection (-> Element Boolean) (Maybe Element))") (description "Find first element satisfying predicate, or #f. Short-circuits on first match.") (notes ()) (section generic-operations) (deps (\x27;prelude \x27;protocol)) (available (coll-count coll-any? coll-all? coll-filter-list coll-map-list)) (answer "(define (coll-find coll pred) (call/cc (lambda (return) (coll-fold coll (lambda (acc elem) (if (pred elem) (return elem) acc)) #f) #f)))"))
