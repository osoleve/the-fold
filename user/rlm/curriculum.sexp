(task-entry (id "dataset/parameter/format-param-value") (skill dataset) (module parameter) (tier 1) (difficulty 13435) (name format-param-value) (type "") (description "") (notes ()) (section text-interpolation) (deps (\x27;prelude \x27;prng \x27;distributions)) (available (make-prng prng-next-float prng-next-int make-param-range param-range? param-range-name param-range-min param-range-max param-range-strategy param-range-constraint uniform-range range-int range-normal range-choice param-range-choice? param-range-choice-name param-range-choice-values param-range-choice-constraint range-with-constraint param-sample-raw sample-normal param-sample param-sample-default make-param-set param-set? param-set-ranges param-set-joint-constraint param-set-sample-raw param-set-sample param-get param-interpolate params-interpolate param-perturb params-perturb-one interpolate-text)) (answer "(define (format-param-value val) (cond ((number? val) (if (integer? val) (number->string (inexact->exact val)) (let ((s (number->string (exact->inexact val)))) (if (> (string-length s) 6) (substring s 0 6) s)))) ((symbol? val) (symbol->string val)) ((string? val) val) (else (format \"~a\" val))))"))
