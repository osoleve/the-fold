(task-entry (id "control-systems/poly-algebra/alg-normalize-coeffs") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22601) (name alg-normalize-coeffs) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial)) (answer "(define (alg-normalize-coeffs field coeffs) (let ((zero (field-zero field)) (eq-fn (field-equal-fn field))) (let loop ((cs (reverse coeffs))) (cond ((null? cs) (list zero)) ((eq-fn (car cs) zero) (loop (cdr cs))) (else (reverse cs))))))"))
