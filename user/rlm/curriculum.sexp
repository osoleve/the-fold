(task-entry (id "numeric/interpolate/bezier-derivative") (skill numeric) (module interpolate) (tier 0) (difficulty 2520) (name bezier-derivative) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;numeric/polynomial)) (available (binary-search-segment binary-search-segment-vec lerp lerp-inverse interp-linear lagrange-basis interp-lagrange divided-differences interp-newton interp-hermite hermite-tangent-estimate thomas-algorithm cubic-spline-natural matrix-set! spline-eval interp-cubic-spline bezier-linear bezier-quadratic bezier-cubic bezier-general)) (answer "(define (bezier-derivative control-points t) (let ((n (- (length control-points) 1))) (if (< n 1) '(0 . 0) (let ((deriv-points (let loop ((ps control-points) (result '())) (if (null? (cdr ps)) (reverse result) (loop (cdr ps) (cons (cons (* n (- (caadr ps) (caar ps))) (* n (- (cdadr ps) (cdar ps)))) result)))))) (bezier-general deriv-points t)))))"))
