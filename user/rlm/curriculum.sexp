(task-entry (id "data/avl-tree/avl-insert") (skill data) (module avl-tree) (tier 0) (difficulty 1318) (name avl-insert) (type "(-> κ α AVL AVL)") (description "Insert key-value pair. If key exists, updates value") (notes ()) (section basic-operations) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node rotate-left rotate-right rebalance avl-lookup avl-lookup-by avl-contains? avl-contains-by?)) (answer "(define (avl-insert key value tree) (avl-insert-by < key value tree))"))
(task-entry (id "data/sort/sorted?") (skill data) (module sort) (tier 0) (difficulty 1318) (name sorted?) (type "(-> (List α) Boolean)") (description "Check if list is sorted in ascending order") (notes ()) (section utilities) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort sort-by-key sort-by-key-desc sort-desc quicksort-desc)) (answer "(define (sorted? lst) (sorted-by? < lst))"))
(task-entry (id "data/heap/heap-delete-max") (skill data) (module heap) (tier 0) (difficulty 1318) (name heap-delete-max) (type "(-> Heap Heap)") (description "Remove maximum element from max-heap.") (notes ()) (section max-heap-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge heap-insert heap-min heap-peek heap-delete-min heap-pop heap-merge-max heap-insert-max heap-max)) (answer "(define (heap-delete-max heap) (if (heap-empty? heap) (error 'heap-delete-max \"Cannot delete from empty heap\") (heap-merge-max (heap-left heap) (heap-right heap))))"))
(task-entry (id "data/collection-utils/collection-merge") (skill data) (module collection-utils) (tier 0) (difficulty 1318) (name collection-merge) (type "(-> Block Block Block)") (description "Merge two collections into one. Combines refs from both (may have duplicates)") (notes ()) (section collection-construction) (deps (\x27;block \x27;sha256)) (available (foldr collection-hashes collection-size collection-empty? map-collection filter-collection fold-collection foldr-collection for-each-collection collection-find collection-any? collection-all? collection-count-matching collection-partition collection-group-by make-collection-from-blocks collection-add collection-remove)) (answer "(define (collection-merge coll1 coll2) (let* ((refs1 (block-refs coll1)) (refs2 (block-refs coll2)) (combined (append (vector->list refs1) (vector->list refs2))) (new-refs (list->vector combined))) (make-block (block-tag coll1) (string->utf8 (format \"merged (~a members)\" (length combined))) new-refs)))"))
(task-entry (id "data/graph-primitives/remove-hash") (skill data) (module graph-primitives) (tier 0) (difficulty 1318) (name remove-hash) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;collection-utils)) (available (bytevector-hash make-visited visited-add visited-contains? visited-remove make-queue queue-empty? queue-normalize queue-enqueue queue-enqueue-all queue-dequeue make-stack stack-empty? stack-push stack-push-all stack-pop hash-equal? hash-in-list?)) (answer "(define (remove-hash hash lst) (filter (lambda (h) (not (bytevector=? h hash))) lst))"))
(task-entry (id "data/graph-matrix/adjacency-out-degree") (skill data) (module graph-matrix) (tier 0) (difficulty 1318) (name adjacency-out-degree) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count)) (answer "(define (adjacency-out-degree m i) (if (sparse-csr? m) (let ((row-ptrs (sparse-csr-row-ptrs m))) (- (vector-ref row-ptrs (+ i 1)) (vector-ref row-ptrs i))) (let ((n (matrix-cols m)) (data (matrix-data m))) (let loop ((j 0) (count 0)) (if (= j n) count (loop (+ j 1) (if (= (vector-ref data (+ (* i n) j)) 0) count (+ count 1))))))))"))
(task-entry (id "data/centrality/betweenness-centrality-from-edges") (skill data) (module centrality) (tier 0) (difficulty 1318) (name betweenness-centrality-from-edges) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality standard-closeness-node harmonic-closeness-node closeness-centrality-from-adj closeness-centrality-from-edges betweenness-centrality betweenness-from-source)) (answer "(define (betweenness-centrality-from-edges edges . opts) (let* ((n (if (and (pair? opts) (integer? (car opts))) (car opts) (infer-node-count edges))) (adj (edges->adjacency-matrix edges n))) (betweenness-centrality adj)))"))
(task-entry (id "data/graph-community/compute-degrees") (skill data) (module graph-community) (tier 0) (difficulty 1318) (name compute-degrees) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find uf-union connected-components is-connected? mst-from-adjacency modularity-ilp)) (answer "(define (compute-degrees adj n) (let ((degrees (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) degrees) (do ((j 0 (+ j 1))) ((= j n)) (when (> (matrix-ref adj i j) 0) (vector-set! degrees i (+ (vector-ref degrees i) (matrix-ref adj i j))))))))"))
(task-entry (id "data/graph-layout/graph-nodes-each") (skill data) (module graph-layout) (tier 0) (difficulty 1318) (name graph-nodes-each) (type "") (description "") (notes ()) (section graph-representation) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens)) (answer "(define graph-nodes-each (make-traversal (lambda (f g) (graph-set-nodes g (map f (graph-nodes g)))) (lambda (g) (graph-nodes g))))"))
(task-entry (id "data/kdtree/knn-pair-greater?") (skill data) (module kdtree) (tier 0) (difficulty 1318) (name knn-pair-greater?) (type "") (description "") (notes ()) (section k-nearest-neighbors) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec)) (answer "(define (knn-pair-greater? p1 p2) (>= (car p1) (car p2)))"))
(task-entry (id "data/quadtree/quadtree-nw") (skill data) (module quadtree) (tier 0) (difficulty 1318) (name quadtree-nw) (type "") (description "") (notes ()) (section core-representation) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne)) (answer "(define (quadtree-nw node) (cadddr node))"))
(task-entry (id "data/avl-tree/avl-insert-by") (skill data) (module avl-tree) (tier 0) (difficulty 1319) (name avl-insert-by) (type "(-> (-> κ κ Boolean) κ α AVL AVL)") (description "Insert with custom comparator") (notes ()) (section basic-operations) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node rotate-left rotate-right rebalance avl-lookup avl-lookup-by avl-contains? avl-contains-by? avl-insert)) (answer "(define (avl-insert-by cmp key value tree) (if (avl-empty? tree) (make-avl-node key value avl-empty avl-empty) (let ((k (avl-key tree)) (v (avl-value tree)) (left (avl-left tree)) (right (avl-right tree))) (cond ((cmp key k) (rebalance (make-avl-node k v (avl-insert-by cmp key value left) right))) ((cmp k key) (rebalance (make-avl-node k v left (avl-insert-by cmp key value right)))) (else (make-avl-node key value left right))))))"))
(task-entry (id "data/sort/sorted-by?") (skill data) (module sort) (tier 0) (difficulty 1319) (name sorted-by?) (type "(-> (-> α α Boolean) (List α) Boolean)") (description "Check if list is sorted according to comparator") (notes ()) (section utilities) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort sort-by-key sort-by-key-desc sort-desc quicksort-desc sorted?)) (answer "(define (sorted-by? cmp lst) (or (null? lst) (null? (cdr lst)) (and (not (cmp (cadr lst) (car lst))) (sorted-by? cmp (cdr lst)))))"))
(task-entry (id "data/heap/heap-pop-max") (skill data) (module heap) (tier 0) (difficulty 1319) (name heap-pop-max) (type "(-> Heap (Values Heap α))") (description "Remove and return maximum element from max-heap.") (notes ()) (section max-heap-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge heap-insert heap-min heap-peek heap-delete-min heap-pop heap-merge-max heap-insert-max heap-max heap-delete-max)) (answer "(define (heap-pop-max heap) (if (heap-empty? heap) (error 'heap-pop-max \"Cannot pop from empty heap\") (values (heap-merge-max (heap-left heap) (heap-right heap)) (heap-value heap))))"))
(task-entry (id "data/graph-primitives/unique-hashes") (skill data) (module graph-primitives) (tier 0) (difficulty 1319) (name unique-hashes) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;collection-utils)) (available (bytevector-hash make-visited visited-add visited-contains? visited-remove make-queue queue-empty? queue-normalize queue-enqueue queue-enqueue-all queue-dequeue make-stack stack-empty? stack-push stack-push-all stack-pop hash-equal? hash-in-list? remove-hash)) (answer "(define (unique-hashes hashes) (let loop ((remaining hashes) (seen '()) (result '())) (if (null? remaining) (reverse result) (let ((h (car remaining))) (if (hash-in-list? h seen) (loop (cdr remaining) seen result) (loop (cdr remaining) (cons h seen) (cons h result)))))))"))
(task-entry (id "data/graph-matrix/adjacency-in-degree") (skill data) (module graph-matrix) (tier 0) (difficulty 1319) (name adjacency-in-degree) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree)) (answer "(define (adjacency-in-degree m i) (if (sparse-csr? m) (let ((n (sparse-csr-rows m)) (row-ptrs (sparse-csr-row-ptrs m)) (col-idx (sparse-csr-col-indices m)) (nnz (sparse-csr-nnz m))) (let loop ((k 0) (count 0)) (if (= k nnz) count (loop (+ k 1) (if (= (vector-ref col-idx k) i) (+ count 1) count))))) (let ((n (matrix-rows m)) (data (matrix-data m)) (cols (matrix-cols m))) (let loop ((j 0) (count 0)) (if (= j n) count (loop (+ j 1) (if (= (vector-ref data (+ (* j cols) i)) 0) count (+ count 1))))))))"))
(task-entry (id "data/centrality/rank-by-centrality") (skill data) (module centrality) (tier 0) (difficulty 1319) (name rank-by-centrality) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality standard-closeness-node harmonic-closeness-node closeness-centrality-from-adj closeness-centrality-from-edges betweenness-centrality betweenness-from-source betweenness-centrality-from-edges)) (answer "(define (rank-by-centrality scores) (let* ((n (vector-length scores)) (pairs (let loop ((i 0) (acc '())) (if (= i n) acc (loop (+ i 1) (cons (cons i (vector-ref scores i)) acc)))))) (sort-by (lambda (a b) (> (cdr a) (cdr b))) pairs)))"))
(task-entry (id "data/graph-community/compute-modularity-matrix") (skill data) (module graph-community) (tier 0) (difficulty 1319) (name compute-modularity-matrix) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find uf-union connected-components is-connected? mst-from-adjacency modularity-ilp compute-degrees)) (answer "(define (compute-modularity-matrix adj degrees two-m n) (let ((B (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i n) B) (do ((j 0 (+ j 1))) ((= j n)) (let* ((a-ij (matrix-ref adj i j)) (ki (vector-ref degrees i)) (kj (vector-ref degrees j)) (expected (/ (* ki kj) two-m))) (matrix-set! B i j (- a-ij expected)))))))"))
