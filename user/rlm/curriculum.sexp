(task-entry (id "statistics/glm/glm-likelihood-ratio-test") (skill statistics) (module glm) (tier 1) (difficulty 11217) (name glm-likelihood-ratio-test) (type "") (description "") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available (glm-fit irls-loop irls-step weighted-least-squares irls-converged? irls-finalize compute-glm-se compute-z-values compute-z-pvalues compute-deviance-residuals logistic-fit poisson-fit gamma-fit probit-fit glm-predict glm-predict-linear logistic-classify)) (answer "(define (glm-likelihood-ratio-test null-model alt-model) (let* ((dev-null (glm-deviance null-model)) (dev-alt (glm-deviance alt-model)) (df-null (- (glm-n null-model) (vector-length (glm-coefficients null-model)))) (df-alt (- (glm-n alt-model) (vector-length (glm-coefficients alt-model)))) (chi-sq (- dev-null dev-alt)) (df (- df-null df-alt)) (p-value (chi-squared-pvalue chi-sq df))) (make-test-result 'likelihood-ratio chi-sq df p-value #f #f)))"))
