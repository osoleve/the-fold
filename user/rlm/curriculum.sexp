(task-entry (id "numeric/affine/find-deriv-inverse-bisection") (skill numeric) (module affine) (tier 0) (difficulty 2528) (name find-deriv-inverse-bisection) (type "(-> (-> Number Number) Number Number Number Symbol Number)") (description "Find x in [a,b] where f'(x) = target-slope using bisection") (notes ("For convex functions, f' is increasing; for concave, f' is decreasing")) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval affine->interval affine-radius affine-neg merge-terms affine-add affine-sub affine-scale affine-add-constant affine-mul affine-sqr affine-recip affine-div affine-sqrt affine-sqrt-positive *deriv-h* *bisection-tol* *bisection-max-iter* numerical-derivative)) (answer "(define (find-deriv-inverse-bisection f a b target-slope convexity) (let* ((fa-deriv (numerical-derivative f a)) (fb-deriv (numerical-derivative f b)) (lo-deriv (min fa-deriv fb-deriv)) (hi-deriv (max fa-deriv fb-deriv))) (cond ((<= target-slope lo-deriv) (if (< fa-deriv fb-deriv) a b)) ((>= target-slope hi-deriv) (if (< fa-deriv fb-deriv) b a)) (else (let loop ((lo a) (hi b) (iter 0)) (if (or (>= iter *bisection-max-iter*) (< (- hi lo) *bisection-tol*)) (/ (+ lo hi) 2) (let* ((mid (/ (+ lo hi) 2)) (mid-deriv (numerical-derivative f mid))) (if (eq? convexity 'convex) (if (< mid-deriv target-slope) (loop mid hi (+ iter 1)) (loop lo mid (+ iter 1))) (if (> mid-deriv target-slope) (loop mid hi (+ iter 1)) (loop lo mid (+ iter 1)))))))))))"))
(task-entry (id "numeric/fem/vec-dot") (skill numeric) (module fem) (tier 0) (difficulty 2528) (name vec-dot) (type "") (description "") (notes ()) (section sparse-cg) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes apply-dirichlet-bc! apply-dirichlet-penalty! *fem-tolerance* *fem-max-iterations* sparse-cg sparse-cg-loop sparse-csr-diagonal vec-div-pointwise sparse-pcg sparse-pcg-loop)) (answer "(define (vec-dot v1 v2) (let ((n (vector-length v1))) (let loop ((i 0) (sum 0.0)) (if (= i n) sum (loop (+ i 1) (+ sum (* (vector-ref v1 i) (vector-ref v2 i))))))))"))
