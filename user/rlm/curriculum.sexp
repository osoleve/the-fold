(task-entry (id "control-systems/transfer-function/tf-from-coeffs") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22602) (name tf-from-coeffs) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf)) (answer "(define (tf-from-coeffs num-coeffs den-coeffs) (make-tf (make-poly num-coeffs) (make-poly den-coeffs)))"))
(task-entry (id "control-systems/z-transform/dtf-from-coeffs") (skill control-systems) (module z-transform) (tier 2) (difficulty 22602) (name dtf-from-coeffs) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf)) (answer "(define (dtf-from-coeffs num-coeffs den-coeffs Ts) (make-dtf (make-poly num-coeffs) (make-poly den-coeffs) Ts))"))
(task-entry (id "control-systems/tf-convert/faddeev-leverrier") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22602) (name faddeev-leverrier) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier)) (answer "(define (faddeev-leverrier A n) (let ((coeffs (make-vector (+ n 1) 0)) (matrices '())) (vector-set! coeffs 0 1) (let loop ((k 1) (M (matrix-identity n)) (mats (list (matrix-identity n)))) (if (> k n) (cons coeffs (reverse mats)) (let* ((AM (matrix-mul A M)) (p-k (/ (- (matrix-trace AM)) k)) (M-next (if (= k n) (make-matrix n n 0) (matrix-add AM (matrix-scale p-k (matrix-identity n)))))) (vector-set! coeffs k p-k) (if (= k n) (cons coeffs (reverse mats)) (loop (+ k 1) M-next (cons M-next mats))))))))"))
