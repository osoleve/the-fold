(task-entry (id "diffgeo/forms/count-inversions-to-sort") (skill diffgeo) (module forms) (tier 1) (difficulty 10712) (name count-inversions-to-sort) (type "") (description "") (notes ()) (section permutation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices)) (answer "(define (count-inversions-to-sort from to) (letrec ((find-pos (lambda (x lst i) (cond ((null? lst) #f) ((equal? x (car lst)) i) (else (find-pos x (cdr lst) (+ i 1))))))) (let* ((mapped (map (lambda (x) (find-pos x to 0)) from)) (inversions 0)) (let outer ((lst mapped)) (when (not (null? lst)) (let inner ((rest (cdr lst))) (when (not (null? rest)) (when (> (car lst) (car rest)) (set! inversions (+ inversions 1))) (inner (cdr rest)))) (outer (cdr lst)))) (if (even? inversions) 1 -1))))"))
(task-entry (id "diffgeo/symbolic-metrics/christoffel-symbols*") (skill diffgeo) (module symbolic-metrics) (tier 1) (difficulty 10712) (name christoffel-symbols*) (type "(-> Metric Vec ChristoffelTensor)") (description "Compute Christoffel symbols, using exact derivatives when available") (notes ()) (section metric-derivative-protocol) (deps (\x27;curvature)) (available (metric-symbolic? make-metric-symbolic metric-symbolic-deriv-fn metric-chart* metric-fn* metric-dim* metric-at* make-polar-metric-exact make-spherical-metric-exact make-cylindrical-metric-exact make-euclidean-metric-exact christoffel-symbols-exact)) (answer "(define (christoffel-symbols* m coords . epsilon-arg) (if (metric-symbolic? m) (christoffel-symbols-exact m coords) (apply christoffel-symbols (cons m (cons coords epsilon-arg)))))"))
