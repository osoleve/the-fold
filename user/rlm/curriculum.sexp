(task-entry (id "statistics/ma/ma-forecast") (skill statistics) (module ma) (tier 1) (difficulty 11215) (name ma-forecast) (type "") (description "") (notes ()) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (moving-average weighted-moving-average exponential-moving-average ma-fit center-series-ma autocovariance-ma innovations-algorithm ma-compute-residuals ma-residual-sigma make-ma-result ma-coefficients ma-intercept ma-residuals ma-sigma ma-order)) (answer "(define (ma-forecast model xs h) (let* ((theta (ma-coefficients model)) (mean (ma-intercept model)) (sigma (ma-sigma model)) (q (ma-order model)) (n (vector-length xs)) (centered (center-series-ma xs mean)) (residuals (ma-compute-residuals centered theta q)) (forecasts (make-vector h)) (extended-res (make-vector (+ n h) 0)) (_ (do ((i 0 (+ i 1))) ((= i n)) (vector-set! extended-res i (vector-ref residuals i))))) (do ((t 0 (+ t 1))) ((= t h)) (let* ((sum (let loop ((j 1) (s 0)) (if (or (> j q) (> j (+ n t))) s (let ((res-idx (- (+ n t) j))) (if (< res-idx 0) s (loop (+ j 1) (+ s (* (vector-ref theta (- j 1)) (vector-ref extended-res res-idx))))))))) (fc (+ mean sum))) (vector-set! forecasts t fc))) (let* ((forecast-se (ma-forecast-se theta sigma q h)) (z (standard-normal-quantile-ma 0.975)) (lower (make-vector h)) (upper (make-vector h))) (do ((t 0 (+ t 1))) ((= t h)) (let ((fc (vector-ref forecasts t)) (se (vector-ref forecast-se t))) (vector-set! lower t (- fc (* z se))) (vector-set! upper t (+ fc (* z se))))) (make-forecast-result forecasts lower upper 0.95))))"))
(task-entry (id "statistics/forecast/time-series-cv") (skill statistics) (module forecast) (tier 1) (difficulty 11215) (name time-series-cv) (type "") (description "") (notes ()) (section forecast-accuracy-metrics) (deps (\x27;prelude)) (available (mae mse rmse mape smape mase naive-forecast drift-forecast seasonal-naive-forecast mean-forecast forecast-intervals standard-normal-quantile-approx forecast-accuracy theil-u tracking-signal)) (answer "(define (time-series-cv xs initial horizon fit-fn forecast-fn) (let* ((n (vector-length xs)) (num-folds (max 1 (- n initial horizon))) (rmses (make-vector num-folds))) (do ((i 0 (+ i 1))) ((= i num-folds) rmses) (let* ((train-end (+ initial i)) (test-end (min (+ train-end horizon) n)) (test-len (- test-end train-end)) (train (let ((v (make-vector train-end))) (do ((j 0 (+ j 1))) ((= j train-end) v) (vector-set! v j (vector-ref xs j))))) (model (fit-fn train)) (forecast (forecast-fn model test-len)) (test (let ((v (make-vector test-len))) (do ((j 0 (+ j 1))) ((= j test-len) v) (vector-set! v j (vector-ref xs (+ train-end j)))))) (fold-rmse (rmse test forecast))) (vector-set! rmses i fold-rmse)))))"))
(task-entry (id "statistics/result-types/make-glm-result") (skill statistics) (module result-types) (tier 1) (difficulty 11216) (name make-glm-result) (type "(-> Symbol Symbol Vec Vec Vec Vec Num Num Num Vec Vec Nat Nat Bool GLMResult)") (description "Create a GLM result") (notes ()) (section glm-results) (deps (\x27;prelude)) (available (make-linear-model-result linear-model? linear-model-coefficients linear-model-se linear-model-t-values linear-model-p-values linear-model-r-squared linear-model-adj-r-squared linear-model-residuals linear-model-fitted linear-model-sse linear-model-mse linear-model-n linear-model-p linear-model-df-residual linear-model-sigma)) (answer "(define (make-glm-result family link coefficients se z-values p-values deviance null-deviance aic residuals fitted n iterations converged?) (list 'glm-model family link coefficients se z-values p-values deviance null-deviance aic residuals fitted n iterations converged?))"))
(task-entry (id "statistics/summary-stats/vec-std-dev") (skill statistics) (module summary-stats) (tier 1) (difficulty 11216) (name vec-std-dev) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance)) (answer "(define (vec-std-dev v) (sqrt (vec-variance v)))"))
(task-entry (id "statistics/design-matrix/laguerre-l") (skill statistics) (module design-matrix) (tier 1) (difficulty 11216) (name laguerre-l) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p chebyshev-t hermite-h)) (answer "(define (laguerre-l n x) (cond ((= n 0) 1) ((= n 1) (- 1 x)) (else (let loop ((k 2) (l-2 1) (l-1 (- 1 x))) (if (> k n) l-1 (let ((l-k (/ (- (* (- (- (* 2 k) 1) x) l-1) (* (- k 1) l-2)) k))) (loop (+ k 1) l-1 l-k)))))))"))
(task-entry (id "statistics/linear/compute-leverage-single") (skill statistics) (module linear) (tier 1) (difficulty 11216) (name compute-leverage-single) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit linear-model-compute-diagnostics compute-coefficient-se compute-t-values compute-p-values compute-r-squared compute-adj-r-squared weighted-linear-fit weight-matrix weight-vector weighted-diagnostics compute-weighted-se linear-model-predict linear-model-predict-interval compute-XtX-inverse extract-row)) (answer "(define (compute-leverage-single x XtX-inv p) (let loop-i ((i 0) (sum 0)) (if (= i p) sum (let ((inner (let loop-j ((j 0) (s 0)) (if (= j p) s (loop-j (+ j 1) (+ s (* (matrix-ref XtX-inv i j) (vector-ref x j)))))))) (loop-i (+ i 1) (+ sum (* (vector-ref x i) inner)))))))"))
(task-entry (id "statistics/regularized/find-min-index") (skill statistics) (module regularized) (tier 1) (difficulty 11216) (name find-min-index) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics compute-r-squared-ridge lasso-fit lasso-coordinate-descent lasso-partial-residual soft-threshold lasso-finalize count-nonzero elastic-net-fit elastic-net-coordinate-descent elastic-net-update cross-validate-lambda cv-error-for-lambda split-fold compute-mse-test)) (answer "(define (find-min-index xs) (let loop ((xs (cdr xs)) (idx 1) (min-val (car xs)) (min-idx 0)) (if (null? xs) min-idx (if (< (car xs) min-val) (loop (cdr xs) (+ idx 1) (car xs) idx) (loop (cdr xs) (+ idx 1) min-val min-idx)))))"))
(task-entry (id "statistics/glm/logistic-classify") (skill statistics) (module glm) (tier 1) (difficulty 11216) (name logistic-classify) (type "") (description "") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available (glm-fit irls-loop irls-step weighted-least-squares irls-converged? irls-finalize compute-glm-se compute-z-values compute-z-pvalues compute-deviance-residuals logistic-fit poisson-fit gamma-fit probit-fit glm-predict glm-predict-linear)) (answer "(define (logistic-classify model X-new threshold) (let* ((probs (glm-predict model X-new)) (n (vector-length probs)) (classes (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) classes) (vector-set! classes i (if (>= (vector-ref probs i) threshold) 1 0)))))"))
