(task-entry (id "geometry/convex-hull/graham-scan") (skill geometry) (module convex-hull) (tier 1) (difficulty 12208) (name graham-scan) (type "") (description "") (notes ()) (section graham-scan) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest)) (answer "(define (graham-scan points) (cond ((< (length points) 3) points) (else (let* ((p0 (find-lowest-point points)) (sorted (sort-by-polar-angle p0 points))) (if (< (length sorted) 2) (cons p0 sorted) (let loop ((remaining (cdr sorted)) (stack (list (car sorted) p0))) (if (null? remaining) (reverse stack) (let ((next (car remaining))) (let pop-loop ((s stack)) (if (and (>= (length s) 2) (not (ccw? (cadr s) (car s) next))) (pop-loop (cdr s)) (loop (cdr remaining) (cons next s))))))))))))"))
