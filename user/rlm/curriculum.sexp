(task-entry (id "fp/logic/unify") (skill fp) (module logic) (tier 1) (difficulty 10611) (name unify) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;stream)) (available (*lvar-counter* make-lvar lvar? lvar-name lvar-id lvar=? empty-subst extend-subst lookup-subst walk walk*)) (answer "(define (unify u v subst) (let ((u (walk u subst)) (v (walk v subst))) (cond ((and (lvar? u) (lvar? v) (lvar=? u v)) (just subst)) ((lvar? u) (just (extend-subst u v subst))) ((lvar? v) (just (extend-subst v u subst))) ((and (pair? u) (pair? v)) (let ((s1 (unify (car u) (car v) subst))) (if (nothing? s1) nothing (unify (cdr u) (cdr v) (from-just s1))))) ((equal? u v) (just subst)) (else nothing))))"))
