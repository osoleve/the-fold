(task-entry (id "algebra/group/verify-homomorphism") (skill algebra) (module group) (tier 0) (difficulty 347) (name verify-homomorphism) (type "(-> Homomorphism Boolean)") (description "Check that φ(a ∘ b) = φ(a) ∘ φ(b) for all a, b in source") (notes ()) (section group-homomorphisms) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity dihedral-op dihedral-inverse make-dihedral-group D is-subgroup? generate-subgroup make-homomorphism homomorphism? homomorphism-source homomorphism-target homomorphism-mapping homomorphism-apply)) (answer "(define (verify-homomorphism h) (let* ((source (homomorphism-source h)) (target (homomorphism-target h)) (phi (homomorphism-mapping h)) (elems (group-elements source)) (op-s (group-op source)) (op-t (group-op target)) (eq? (group-equal-fn target))) (let loop-a ((as elems)) (if (null? as) #t (let loop-b ((bs elems)) (if (null? bs) (loop-a (cdr as)) (let* ((a (car as)) (b (car bs)) (left (phi (op-s a b))) (right (op-t (phi a) (phi b)))) (if (eq? left right) (loop-b (cdr bs)) #f))))))))"))
(task-entry (id "algebra/polynomial/poly-term->string") (skill algebra) (module polynomial) (tier 0) (difficulty 347) (name poly-term->string) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm poly-eval poly-derivative poly-scalar-mul-int poly-square-free poly-square-free-factorization poly-sqf-loop poly-lagrange-interpolate poly-lagrange-sum poly-lagrange-basis poly-newton-interpolate poly-divided-differences poly-newton-form make-polynomial-ring poly->string)) (answer "(define (poly-term->string c power var first? F) (let ((zero (field-zero F)) (one (field-one F)) (eq-fn (field-equal-fn F))) (cond ((eq-fn c zero) \"\") ((= power 0) (let ((cs (coeff->string c))) (if first? cs (if (and (number? c) (< c 0)) (string-append \" - \" (coeff->string (- c))) (string-append \" + \" cs))))) ((= power 1) (let ((cs (if (eq-fn c one) \"\" (coeff->string c)))) (if first? (string-append cs (symbol->string var)) (string-append \" + \" cs (symbol->string var))))) (else (let ((cs (if (eq-fn c one) \"\" (coeff->string c)))) (if first? (string-append cs (symbol->string var) \"^\" (number->string power)) (string-append \" + \" cs (symbol->string var) \"^\" (number->string power))))))))"))
