(task-entry (id "statistics/model-protocol/erf") (skill statistics) (module model-protocol) (tier 1) (difficulty 11214) (name erf) (type "") (description "") (notes ()) (section cross-validation) (deps (\x27;prelude \x27;protocol \x27;result-types \x27;sort)) (available (model-mse model-rmse model-mae compare-models-aic compare-models-bic model-summary cv-score cv-split compute-mse matrix-vec-mul matrix-ref matrix-rows matrix-cols probit-cdf)) (answer "(define (erf x) (let* ((a1 0.254829592) (a2 -0.284496736) (a3 1.421413741) (a4 -1.453152027) (a5 1.061405429) (p 0.3275911) (sign (if (< x 0) -1 1)) (x (abs x)) (t (/ 1 (+ 1 (* p x)))) (y (- 1 (* (+ (* (+ (* (+ (* (+ (* a5 t) a4) t) a3) t) a2) t) a1) t (exp (- (* x x))))))) (* sign y)))"))
