(task-entry (id "physics/classical/ode-integrators/verlet-step") (skill physics/classical) (module ode-integrators) (tier 2) (difficulty 23510) (name verlet-step) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (state-add state-sub state-scale state-madd euler-step midpoint-step heun-step rk4-step symplectic-euler-step symplectic-euler-step-b)) (answer "(define (verlet-step a pos pos-prev dt) (let* ((t 0) (accel (a t pos)) (dt-sq (* dt dt)) (new-pos (state-add (state-sub (state-scale 2 pos) pos-prev) (state-scale dt-sq accel)))) (list new-pos pos)))"))
