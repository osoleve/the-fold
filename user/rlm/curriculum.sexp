(task-entry (id "diffgeo/geodesics/trace-geodesic-adaptive-at-times") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10722) (name trace-geodesic-adaptive-at-times) (type "(-> Metric Vec Vec (List Num) Num (List GeodesicState))") (description "Trace adaptively, returning states at specified times") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final)) (answer "(define (trace-geodesic-adaptive-at-times metric initial-coords initial-velocity times tol) (if (null? times) '() (let* ((sorted-times (merge-sort-by < times)) (T (car (reverse sorted-times))) (state0 (make-geodesic-state initial-coords initial-velocity)) (dt0 (/ T 10)) (min-dt (* T 1e-10))) (let loop ((state state0) (t 0) (dt dt0) (remaining-times sorted-times) (results '()) (k1-cache #f)) (cond ((null? remaining-times) (reverse results)) ((>= t T) (reverse (append (map (lambda (_) state) remaining-times) results))) (else (let* ((next-time (car remaining-times)) (h (min dt (- T t)))) (cond ((< h min-dt) (reverse (append (map (lambda (_) state) remaining-times) results))) ((<= next-time t) (loop state t dt (cdr remaining-times) (cons state results) k1-cache)) ((and (> next-time t) (<= next-time (+ t h))) (let* ((h-exact (- next-time t)) (result (adaptive-geodesic-step metric state h-exact tol k1-cache)) (new-state (car result)) (k7 (car (cddddr result)))) (loop new-state next-time dt (cdr remaining-times) (cons new-state results) k7))) (else (let* ((result (adaptive-geodesic-step metric state h tol k1-cache)) (new-state (car result)) (actual-h (cadr result)) (suggested-h (caddr result)) (k7 (car (cddddr result)))) (loop new-state (+ t actual-h) suggested-h remaining-times results k7)))))))))))"))
