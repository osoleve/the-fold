ruction-list dsl-program-depth dsl-uses-tag? dsl-tag-histogram dsl-optimize-dead-code dsl-fuse dsl-fix dsl-lazy make-bounce make-done bounce? done? bounce-thunk done-value run-trampoline run-dsl-trampolined run-dsl-trampoline-helper make-mock-interpreter dsl-test-case dsl-test-error dsl-programs-equiv? dsl-interpreter-equiv? make-recording-interpreter verify-instruction-sequence calc-push! calc-add! calc-sub! calc-mul! calc-div! calc-dup! calc-swap! calc-pop! make-calc-interpreter run-calc forward! back! left! right! penup! pendown! getpos!)) (answer "(define (make-turtle-interpreter) (let ((x 0) (y 0) (angle 0) (pen-down #t) (lines '())) (make-interpreter (lambda (tag payload) (case tag ((turtle-forward) (let* ((dist payload) (rad (* angle (/ 3.14159265 180))) (new-x (+ x (* dist (cos rad)))) (new-y (+ y (* dist (sin rad))))) (when pen-down (set! lines (cons (list x y new-x new-y) lines))) (set! x new-x) (set! y new-y) '())) ((turtle-back) (let* ((dist payload) (rad (* angle (/ 3.14159265 180))) (new-x (- x (* dist (cos rad)))) (new-y (- y (* dist (sin rad))))) (when pen-down (set! lines (cons (list x y new-x new-y) lines))) (set! x new-x) (set! y new-y) '())) ((turtle-left) (set! angle (+ angle payload)) '()) ((turtle-right) (set! angle (- angle payload)) '()) ((turtle-penup) (set! pen-down #f) '()) ((turtle-pendown) (set! pen-down #t) '()) ((turtle-getpos) (cons x y)) (else (error 'turtle-interpreter \"Unknown instruction\")))))))"))
(task-entry (id "diffgeo/lie-groups/se3-exp") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10772) (name se3-exp) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp so2-log so3? so3-matrix make-so3-from-matrix make-so3 so3-identity so3-compose so3-inverse so3-act so3-alg? so3-alg-vec make-so3-alg so3-hat so3-vee so3-alg-to-matrix so3-matrix-to-alg so3-exp so3-log so3-axis-angle se2? se2-rotation se2-translation make-se2 make-se2-from-angle se2-identity se2-to-matrix matrix-to-se2 se2-compose se2-inverse se2-act se2-alg? se2-alg-omega se2-alg-v make-se2-alg se2-alg-to-matrix se2-exp se2-log se3? se3-rotation se3-translation make-se3 se3-identity se3-to-matrix matrix-to-se3 se3-compose se3-inverse se3-act se3-alg? se3-alg-omega se3-alg-v make-se3-alg se3-alg-to-matrix)) (answer "(define (se3-exp xi) (let* ((omega (se3-alg-omega xi)) (v (se3-alg-v xi)) (theta (vec-norm omega))) (if (< theta *lie-epsilon*) (make-se3 (so3-identity) v) (let* ((axis (vec-scale (/ 1.0 theta) omega)) (R (so3-exp (make-so3-alg omega))) (omega-hat (so3-hat omega)) (omega-hat-sq (matrix-mul omega-hat omega-hat)) (I (identity-matrix 3)) (c1 (/ (- 1 (cos theta)) (* theta theta))) (c2 (/ (- theta (sin theta)) (* theta theta theta))) (V (matrix-add (matrix-add I (matrix-scale c1 omega-hat)) (matrix-scale c2 omega-hat-sq))) (t (matrix-vec-mul V v))) (make-se3 R t)))))"))
