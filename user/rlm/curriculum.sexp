(task-entry (id "geometry/mesh-sdf/vec3-edge-key") (skill geometry) (module mesh-sdf) (tier 1) (difficulty 12209) (name vec3-edge-key) (type "") (description "") (notes ()) (section mesh-construction-helpers) (deps (\x27;prelude \x27;geometry \x27;bvh)) (available (make-mesh mesh? mesh-triangles mesh-bvh mesh-sdf mesh-sdf-gradient make-mesh-cube subdivide-icosphere-triangles subdivide-icosphere-once)) (answer "(define (vec3-edge-key v0 v1) (let ((coords0 (list (vec3-x v0) (vec3-y v0) (vec3-z v0))) (coords1 (list (vec3-x v1) (vec3-y v1) (vec3-z v1)))) (if (vec3-coords<? coords0 coords1) (append coords0 coords1) (append coords1 coords0))))"))
(task-entry (id "geometry/marching-cubes/marching-cubes-torus") (skill geometry) (module marching-cubes) (tier 1) (difficulty 12209) (name marching-cubes-torus) (type "(-> Point3 Number Number Number (List Triangle3))") (description "Extract mesh for a torus SDF") (notes ()) (section high-level-api) (deps (\x27;prelude \x27;geometry)) (available (edge-table tri-table marching-cubes-grid marching-cubes-cube compute-cube-index compute-edge-intersections generate-cube-triangles marching-cubes marching-cubes-sphere)) (answer "(define (marching-cubes-torus center major-radius minor-radius resolution) (let ((sdf-fn (lambda (p) (let* ((offset (vec3-sub p center)) (x (vec3-x offset)) (y (vec3-y offset)) (z (vec3-z offset)) (q (- (sqrt (+ (* x x) (* z z))) major-radius))) (- (sqrt (+ (* q q) (* y y))) minor-radius))))) (marching-cubes sdf-fn center (+ major-radius minor-radius 1.0) resolution)))"))
