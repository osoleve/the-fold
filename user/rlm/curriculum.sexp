(task-entry (id "numeric/interval/interval-mul") (skill numeric) (module interval) (tier 0) (difficulty 2546) (name interval-mul) (type "") (description "") (notes ()) (section directed-rounding-arithmetic) (deps (\x27;prelude)) (available (fl-next-up fl-next-down add-down add-up sub-down sub-up mul-down mul-up div-down div-up sqrt-down sqrt-up make-interval interval interval? interval-lo interval-hi interval-singleton entire-interval interval-mid interval-width interval-radius interval-magnitude interval-mignitude interval-empty? interval-singleton? interval-contains? interval-contains-zero? interval-positive? interval-negative? interval-subset? intervals-overlap? intervals-disjoint? interval-definitely< interval-definitely<= interval-definitely> interval-definitely>= interval-possibly< interval-possibly<= interval-possibly> interval-possibly>= interval-definitely= interval-possibly= interval-neg interval-add interval-sub)) (answer "(define (interval-mul iv1 iv2) (let ((a (interval-lo iv1)) (b (interval-hi iv1)) (c (interval-lo iv2)) (d (interval-hi iv2))) (cond ((>= a 0) (cond ((>= c 0) (make-interval (* a c) (* b d))) ((<= d 0) (make-interval (* b c) (* a d))) (else (make-interval (* b c) (* b d))))) ((<= b 0) (cond ((>= c 0) (make-interval (* a d) (* b c))) ((<= d 0) (make-interval (* b d) (* a c))) (else (make-interval (* a d) (* a c))))) (else (cond ((>= c 0) (make-interval (* a d) (* b d))) ((<= d 0) (make-interval (* b c) (* a c))) (else (make-interval (min (* a d) (* b c)) (max (* a c) (* b d)))))))))"))
