(task-entry (id "meta/search/lattice-export-source") (skill meta) (module search) (tier 1) (difficulty 11911) (name lattice-export-source) (type "") (description "") (notes ()) (section search-api) (deps ()) (available (*skill-index* *module-index* *export-index* *module-cache* *export-module-map* *search-ready* lattice-index! ensure-indexed! lattice-find search-with-context lattice-find-exact)) (answer "(define (lattice-export-source sym) (let loop ((skills (kg-skills))) (if (null? skills) #f (let* ((skill-name (car skills)) (data (kg-skill-data skill-name)) (exports-raw (if data (let ((e (assq 'exports data))) (if e (cdr e) '())) '()))) (cond ((not (list? exports-raw)) (loop (cdr skills))) ((null? exports-raw) (loop (cdr skills))) ((symbol? (car exports-raw)) (if (memq sym exports-raw) skill-name (loop (cdr skills)))) (else (let group-loop ((groups exports-raw)) (if (null? groups) (loop (cdr skills)) (let ((group (car groups))) (if (and (pair? group) (memq sym group)) skill-name (group-loop (cdr groups))))))))))))"))
(task-entry (id "meta/type-search/string-find-substr") (skill meta) (module type-search) (tier 1) (difficulty 11911) (name string-find-substr) (type "") (description "") (notes ()) (section type-signature-utilities) (deps ()) (available (has-type-sig? string-contains? extract-type-sig truncate-at-description extract-first-type-token skip-whitespace string-trim-right-ws string-find string-trim-left-ws in-input-position? in-output-position?)) (answer "(define (string-find-substr haystack needle) (let ((h-len (string-length haystack)) (n-len (string-length needle))) (if (> n-len h-len) #f (let loop ((i 0)) (cond ((> (+ i n-len) h-len) #f) ((string=? (substring haystack i (+ i n-len)) needle) i) (else (loop (+ i 1))))))))"))
