(task-entry (id "random/distributions/random-poisson") (skill random) (module distributions) (tier 1) (difficulty 12941) (name random-poisson) (type "(-> Number (State RNG Nat))") (description "State monad sampler for Poisson distribution") (notes ()) (section poisson-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli bernoulli-pmf random-bernoulli geometric geometric-pmf geometric-cdf geometric-quantile random-geometric poisson poisson-pmf poisson-cdf)) (answer "(define (random-poisson rate) (if (<= rate 0) (error 'random-poisson \"rate must be positive\" rate) (if (< rate 30) (let ((L (exp-num (- rate)))) (make-state (lambda (gen) (let loop ((k -1) (p 1.0) (g gen)) (let* ((result (run-state random-float g)) (u (car result)) (new-g (cdr result)) (new-p (* p u)) (new-k (+ k 1))) (if (> new-p L) (loop new-k new-p new-g) (cons new-k new-g))))))) (let* ((sqrt-rate (sqrt rate)) (log-rate (log-num rate)) (mode (inexact->exact (floor rate))) (c (- (* mode log-rate) (log-gamma (+ mode 1))))) (rejection-sampler (state-bind random-normal-standard (lambda (z) (state-bind random-float (lambda (u) (let ((k (max 0 (inexact->exact (floor (+ rate (* sqrt-rate z) 0.5)))))) (state-pure (cons k u))))))) (lambda (ku) (let* ((k (car ku)) (u (cdr ku)) (log-pk (- (* k log-rate) (log-gamma (+ k 1)) c))) (and (< (safe-log u) log-pk) k))))))))"))
(task-entry (id "random/probability/importance-variance") (skill random) (module probability) (tier 1) (difficulty 12941) (name importance-variance) (type "") (description "") (notes ()) (section importance-sampling-inference) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist condition assume sample-once sample-many weighted-samples log-sum-exp normalize-log-weights importance-expectation importance-mean)) (answer "(define (importance-variance p seed n) (let ((mean (importance-mean p seed n))) (importance-expectation (lambda (x) (* (- x mean) (- x mean))) p seed n)))"))
