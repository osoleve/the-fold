(task-entry (id "game-theory/matching/bottleneck-matching-ilp") (skill game-theory) (module matching) (tier 1) (difficulty 13238) (name bottleneck-matching-ilp) (type "") (description "") (notes ()) (section weighted-matching-ilp) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank stable-match-receiver-optimal same-matched-agents? symbol<? weighted-matching-ilp extract-ilp-matches)) (answer "(define (bottleneck-matching-ilp n m weight) (let* ((all-weights (collect-edge-weights n m weight)) (sorted-weights (sort-numbers all-weights)) (required-size (min n m))) (if (null? sorted-weights) (cons '() 0) (let ((result (binary-search-bottleneck n m weight sorted-weights required-size))) (if result result (cons '() +inf.0))))))"))
(task-entry (id "game-theory/voting/schulze-strengths") (skill game-theory) (module voting) (tier 1) (difficulty 13238) (name schulze-strengths) (type "") (description "") (notes ()) (section schulze-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score minimax-winner minimax-ranking smith-set any? build-margin-matrix)) (answer "(define (schulze-strengths profile) (let* ((margin (build-margin-matrix profile)) (n (vector-length margin)) (strength (make-vector n))) (do ((i 0 (+ i 1))) ((>= i n)) (vector-set! strength i (make-vector n 0)) (do ((j 0 (+ j 1))) ((>= j n)) (when (and (not (= i j)) (> (vector-ref (vector-ref margin i) j) 0)) (vector-set! (vector-ref strength i) j (vector-ref (vector-ref margin i) j))))) (do ((k 0 (+ k 1))) ((>= k n) strength) (do ((i 0 (+ i 1))) ((>= i n)) (when (not (= i k)) (do ((j 0 (+ j 1))) ((>= j n)) (when (not (or (= j i) (= j k))) (let ((via-k (min (vector-ref (vector-ref strength i) k) (vector-ref (vector-ref strength k) j))) (direct (vector-ref (vector-ref strength i) j))) (when (> via-k direct) (vector-set! (vector-ref strength i) j via-k))))))))))"))
(task-entry (id "game-theory/multi-winner/all-pairs") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13238) (name all-pairs) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction cc-greedy cc-loop cc-marginal-score cc-total-satisfaction proportionality-score representation-coverage any? diversity-score)) (answer "(define (all-pairs lst) (if (null? lst) '() (append (map (lambda (x) (cons (car lst) x)) (cdr lst)) (all-pairs (cdr lst)))))"))
(task-entry (id "game-theory/fair-division/transfer-to-equalize") (skill game-theory) (module fair-division) (tier 1) (difficulty 13238) (name transfer-to-equalize) (type "") (description "") (notes ()) (section adjusted-winner) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax make-adjusted-winner-problem adjusted-winner equalize-allocations)) (answer "(define (transfer-to-equalize goods points-src points-dest alloc-src alloc-dest score-src score-dest src-id dest-id) (let* ((src-goods (filter (lambda (x) (> (cdr x) 0)) alloc-src)) (ratios (map (lambda (x) (let ((i (car x)) (src-val (vector-ref points-src (car x))) (dest-val (vector-ref points-dest (car x)))) (cons i (if (= src-val 0) +inf.0 (/ dest-val src-val))))) src-goods)) (sorted (sort-by (lambda (a b) (< (cdr a) (cdr b))) ratios))) (transfer-loop goods points-src points-dest alloc-src alloc-dest score-src score-dest sorted)))"))
(task-entry (id "game-theory/mechanism/double-auction-total-surplus") (skill game-theory) (module mechanism) (tier 1) (difficulty 13238) (name double-auction-total-surplus) (type "(-> DoubleAuctionOutcome Number)") (description "") (notes ()) (section double-auction) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations vcg-enumerate-helper pivot-mechanism myerson-virtual-value optimal-reserve-uniform k-double-auction double-auction-trades double-auction-volume double-auction-buyer-surplus double-auction-seller-surplus)) (answer "(define (double-auction-total-surplus outcome) (+ (double-auction-buyer-surplus outcome) (double-auction-seller-surplus outcome)))"))
(task-entry (id "game-theory/evolutionary/sg-transpose") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13238) (name sg-transpose) (type "") (description "") (notes ()) (section payoff-operations) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge is-ess? find-all-ess is-nash-equilibrium? find-pure-nash can-invade? invasion-fitness incumbent-fitness invasion-gradient is-interior-equilibrium? hawk-dove-mixed-ess sg-payoff-matrix->list)) (answer "(define (sg-transpose game) (let* ((n (sg-num-strategies game)) (new-payoffs (map (lambda (i) (map (lambda (j) (sg-payoff game j i)) (iota n))) (iota n)))) (make-symmetric-game (vector->list (sg-strategies game)) new-payoffs)))"))
(task-entry (id "game-theory/extensive-form/info-set-label") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13239) (name info-set-label) (type "") (description "") (notes ()) (section information-sets) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game make-centipede-game centipede-4 entry-deterrence stackelberg-simple signaling-simple make-info-set info-set? info-set-player)) (answer "(define (info-set-label iset) (caddr iset))"))
(task-entry (id "game-theory/coop-games/make-weighted-voting-game") (skill game-theory) (module coop-games) (tier 1) (difficulty 13239) (name make-weighted-voting-game) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky make-additive-game make-unanimity-game)) (answer "(define (make-weighted-voting-game weights quota) (let* ((n (length weights)) (w-vec (list->vector weights))) (make-coop-game n (lambda (S) (if (>= (allocation-coalition-total w-vec S) quota) 1 0)))))"))
(task-entry (id "game-theory/matching/collect-edge-weights") (skill game-theory) (module matching) (tier 1) (difficulty 13239) (name collect-edge-weights) (type "") (description "") (notes ()) (section weighted-matching-ilp) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank stable-match-receiver-optimal same-matched-agents? symbol<? weighted-matching-ilp extract-ilp-matches bottleneck-matching-ilp)) (answer "(define (collect-edge-weights n m weight) (let loop ((i 0) (j 0) (result '())) (cond ((= i n) result) ((= j m) (loop (+ i 1) 0 result)) (else (let ((w (weight i j))) (loop i (+ j 1) (cons w result)))))))"))
(task-entry (id "game-theory/voting/schulze-winner") (skill game-theory) (module voting) (tier 1) (difficulty 13239) (name schulze-winner) (type "") (description "") (notes ()) (section schulze-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score minimax-winner minimax-ranking smith-set any? build-margin-matrix schulze-strengths)) (answer "(define (schulze-winner profile) (if (profile-empty? profile) #f (let* ((candidates (profile-candidates profile)) (n (length candidates)) (strength (schulze-strengths profile))) (let loop ((i 0)) (if (>= i n) (car candidates) (let ((winner? (let check ((j 0)) (cond ((>= j n) #t) ((= i j) (check (+ j 1))) ((>= (vector-ref (vector-ref strength i) j) (vector-ref (vector-ref strength j) i)) (check (+ j 1))) (else #f))))) (if winner? (list-ref candidates i) (loop (+ i 1)))))))))"))
(task-entry (id "game-theory/multi-winner/profile->approval") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13239) (name profile->approval) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction cc-greedy cc-loop cc-marginal-score cc-total-satisfaction proportionality-score representation-coverage any? diversity-score all-pairs)) (answer "(define (profile->approval profile k) (map (lambda (ranking) (take k ranking)) profile))"))
(task-entry (id "game-theory/fair-division/transfer-loop") (skill game-theory) (module fair-division) (tier 1) (difficulty 13239) (name transfer-loop) (type "") (description "") (notes ()) (section adjusted-winner) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax make-adjusted-winner-problem adjusted-winner equalize-allocations transfer-to-equalize)) (answer "(define (transfer-loop goods points-src points-dest alloc-src alloc-dest score-src score-dest remaining) (if (or (null? remaining) (<= score-src score-dest)) (vector (format-allocation goods alloc-src) (format-allocation goods alloc-dest)) (let* ((item (car remaining)) (i (car item)) (src-val (vector-ref points-src i)) (dest-val (vector-ref points-dest i)) (new-score-src (- score-src src-val)) (new-score-dest (+ score-dest dest-val))) (if (>= new-score-dest new-score-src) (let* ((gap (- score-src score-dest)) (denom (+ src-val dest-val)) (f (if (= denom 0) 0 (/ gap denom))) (f (max 0 (min 1 f))) (new-alloc-src (update-fraction alloc-src i (- 1 f))) (new-alloc-dest (cons (cons i f) alloc-dest))) (vector (format-allocation goods new-alloc-src) (format-allocation goods new-alloc-dest))) (let ((new-alloc-src (remove-good alloc-src i)) (new-alloc-dest (cons (cons i 1) alloc-dest))) (transfer-loop goods points-src points-dest new-alloc-src new-alloc-dest new-score-src new-score-dest (cdr remaining)))))))"))
(task-entry (id "game-theory/mechanism/dutch-auction") (skill game-theory) (module mechanism) (tier 1) (difficulty 13239) (name dutch-auction) (type "(-> (Vector Number) Number Number AuctionOutcome)") (description "Simulate Dutch auction with known valuations (jump bidding at v - ε)") (notes ("With rational bidders, winner is highest valuation, payment slightly below. Equivalent to first-price in expectation. Ties broken by *tie-break-strategy*.")) (section descending-auction) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations vcg-enumerate-helper pivot-mechanism myerson-virtual-value optimal-reserve-uniform k-double-auction double-auction-trades double-auction-volume double-auction-buyer-surplus double-auction-seller-surplus double-auction-total-surplus)) (answer "(define (dutch-auction valuations start-price decrement) (let* ((n (vector-length valuations)) (max-val (let loop ((i 0) (best -inf.0)) (if (>= i n) best (loop (+ i 1) (max best (vector-ref valuations i)))))) (winners (filter (lambda (i) (= (vector-ref valuations i) max-val)) (iota n))) (winner (select-winner winners)) (payment (let loop ((price start-price)) (if (<= price max-val) price (loop (- price decrement)))))) (make-auction-outcome winner payment)))"))
(task-entry (id "game-theory/evolutionary/population->string") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13239) (name population->string) (type "") (description "") (notes ()) (section display) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge is-ess? find-all-ess is-nash-equilibrium? find-pure-nash can-invade? invasion-fitness incumbent-fitness invasion-gradient is-interior-equilibrium? hawk-dove-mixed-ess sg-payoff-matrix->list sg-transpose)) (answer "(define (population->string pop) (let ((freqs (pop->list pop))) (string-append \"(\" (apply string-append (map (lambda (f) (format \"~,3f \" f)) freqs)) \")\")))"))
(task-entry (id "game-theory/extensive-form/info-set-nodes") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13240) (name info-set-nodes) (type "") (description "") (notes ()) (section information-sets) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game make-centipede-game centipede-4 entry-deterrence stackelberg-simple signaling-simple make-info-set info-set? info-set-player info-set-label)) (answer "(define (info-set-nodes iset) (cadddr iset))"))
(task-entry (id "game-theory/coop-games/make-airport-game") (skill game-theory) (module coop-games) (tier 1) (difficulty 13240) (name make-airport-game) (type "(-> (List Real) CoopGame)") (description "Airport cost game: players share runway cost based on max need") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky make-additive-game make-unanimity-game make-weighted-voting-game)) (answer "(define (make-airport-game costs) (let* ((n (length costs)) (c-vec (list->vector costs))) (make-coop-game n (lambda (S) (if (= S 0) 0 (let ((members (coalition->list S))) (apply max (map (lambda (i) (vector-ref c-vec i)) members))))) ':cost)))"))
(task-entry (id "game-theory/matching/sort-numbers") (skill game-theory) (module matching) (tier 1) (difficulty 13240) (name sort-numbers) (type "") (description "") (notes ()) (section weighted-matching-ilp) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank stable-match-receiver-optimal same-matched-agents? symbol<? weighted-matching-ilp extract-ilp-matches bottleneck-matching-ilp collect-edge-weights)) (answer "(define (sort-numbers lst) (sort-by < lst))"))
(task-entry (id "game-theory/voting/schulze-ranking") (skill game-theory) (module voting) (tier 1) (difficulty 13240) (name schulze-ranking) (type "") (description "") (notes ()) (section schulze-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score minimax-winner minimax-ranking smith-set any? build-margin-matrix schulze-strengths schulze-winner)) (answer "(define (schulze-ranking profile) (if (profile-empty? profile) '() (let* ((candidates (profile-candidates profile)) (n (length candidates)) (strength (schulze-strengths profile))) (sort-by (lambda (a b) (let ((ia (position-of a candidates)) (ib (position-of b candidates))) (> (vector-ref (vector-ref strength ia) ib) (vector-ref (vector-ref strength ib) ia)))) candidates))))"))
(task-entry (id "game-theory/multi-winner/approval->profile") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13240) (name approval->profile) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction cc-greedy cc-loop cc-marginal-score cc-total-satisfaction proportionality-score representation-coverage any? diversity-score all-pairs profile->approval)) (answer "(define (approval->profile approval-profile) (let ((all-candidates (approval-profile-candidates approval-profile))) (map (lambda (approvals) (append approvals (filter (lambda (c) (not (member c approvals))) all-candidates))) approval-profile)))"))
(task-entry (id "game-theory/fair-division/update-fraction") (skill game-theory) (module fair-division) (tier 1) (difficulty 13240) (name update-fraction) (type "") (description "") (notes ()) (section adjusted-winner) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax make-adjusted-winner-problem adjusted-winner equalize-allocations transfer-to-equalize transfer-loop)) (answer "(define (update-fraction alloc i new-frac) (map (lambda (x) (if (= (car x) i) (cons i new-frac) x)) alloc))"))
(task-entry (id "game-theory/mechanism/make-direct-mechanism") (skill game-theory) (module mechanism) (tier 1) (difficulty 13240) (name make-direct-mechanism) (type "(-> (-> (Vector Any) Any) (-> Any Any) (-> (Vector Any) Any))") (description "Convert indirect mechanism to direct: agents report types, mechanism applies equilibrium strategy") (notes ("This constructs the 'revelation' version of any mechanism. If original mechanism has equilibrium where agents play σ(type), direct mechanism asks for type and plays σ internally.")) (section revelation-principle) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations vcg-enumerate-helper pivot-mechanism myerson-virtual-value optimal-reserve-uniform k-double-auction double-auction-trades double-auction-volume double-auction-buyer-surplus double-auction-seller-surplus double-auction-total-surplus dutch-auction)) (answer "(define (make-direct-mechanism indirect-game equilibrium-strategy) (lambda (reported-types) (let* ((n (vector-length reported-types)) (actions (make-vector n #f))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! actions i (equilibrium-strategy (vector-ref reported-types i)))) (indirect-game actions))))"))
(task-entry (id "game-theory/evolutionary/analyze-game") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13240) (name analyze-game) (type "") (description "") (notes ()) (section display) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge is-ess? find-all-ess is-nash-equilibrium? find-pure-nash can-invade? invasion-fitness incumbent-fitness invasion-gradient is-interior-equilibrium? hawk-dove-mixed-ess sg-payoff-matrix->list sg-transpose population->string)) (answer "(define (analyze-game game) (let ((n (sg-num-strategies game)) (nash (find-pure-nash game)) (ess (find-all-ess game))) (display \"=== Game Analysis ===\n\") (display (format \"Strategies: ~a\n\" (vector->list (sg-strategies game)))) (display \"Payoff matrix:\n\") (for-each (lambda (i) (display \"  \") (for-each (lambda (j) (display (format \"~5,1f \" (sg-payoff game i j)))) (iota n)) (newline)) (iota n)) (display (format \"Pure Nash equilibria: ~a\n\" (map (lambda (i) (sg-strategy-name game i)) nash))) (display (format \"ESS: ~a\n\" (map (lambda (i) (sg-strategy-name game i)) ess)))))"))
(task-entry (id "game-theory/extensive-form/add-info-set") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13241) (name add-info-set) (type "(-> ExtensiveGame InfoSet ExtensiveGame)") (description "Add an information set to the game") (notes ()) (section information-sets) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game make-centipede-game centipede-4 entry-deterrence stackelberg-simple signaling-simple make-info-set info-set? info-set-player info-set-label info-set-nodes)) (answer "(define (add-info-set game info-set) (list 'extensive-game (game-num-players game) (game-root game) (cons info-set (game-info-sets game))))"))
(task-entry (id "game-theory/coop-games/make-bankruptcy-game") (skill game-theory) (module coop-games) (tier 1) (difficulty 13241) (name make-bankruptcy-game) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky make-additive-game make-unanimity-game make-weighted-voting-game make-airport-game)) (answer "(define (make-bankruptcy-game estate claims) (let* ((n (length claims)) (c-vec (list->vector claims)) (total-claims (apply + claims))) (make-coop-game n (lambda (S) (let ((excluded-claims (- total-claims (allocation-coalition-total c-vec S)))) (max 0 (- estate excluded-claims)))))))"))
(task-entry (id "game-theory/matching/remove-duplicates-numbers") (skill game-theory) (module matching) (tier 1) (difficulty 13241) (name remove-duplicates-numbers) (type "") (description "") (notes ()) (section weighted-matching-ilp) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank stable-match-receiver-optimal same-matched-agents? symbol<? weighted-matching-ilp extract-ilp-matches bottleneck-matching-ilp collect-edge-weights sort-numbers)) (answer "(define (remove-duplicates-numbers sorted-lst) (if (or (null? sorted-lst) (null? (cdr sorted-lst))) sorted-lst (let loop ((lst (cdr sorted-lst)) (prev (car sorted-lst)) (result (list (car sorted-lst)))) (if (null? lst) (reverse result) (let ((curr (car lst))) (if (= curr prev) (loop (cdr lst) curr result) (loop (cdr lst) curr (cons curr result))))))))"))
(task-entry (id "game-theory/voting/manipulation-possible?") (skill game-theory) (module voting) (tier 1) (difficulty 13241) (name manipulation-possible?) (type "") (description "") (notes ()) (section manipulation-detection) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score minimax-winner minimax-ranking smith-set any? build-margin-matrix schulze-strengths schulze-winner schulze-ranking)) (answer "(define (manipulation-possible? profile voting-rule voter-idx) (let* ((true-ranking (list-ref profile voter-idx)) (candidates (profile-candidates profile)) (true-winner (voting-rule profile)) (true-pref (position-of true-winner true-ranking)) (all-perms (permutations candidates))) (let loop ((perms all-perms)) (if (null? perms) #f (let* ((fake-ranking (car perms)) (fake-profile (list-set profile voter-idx fake-ranking)) (fake-winner (voting-rule fake-profile)) (fake-pref (position-of fake-winner true-ranking))) (if (and fake-pref true-pref (< fake-pref true-pref)) #t (loop (cdr perms))))))))"))
