(task-entry (id "dsl/staging/stage-expand") (skill dsl) (module staging) (tier 1) (difficulty 11717) (name stage-expand) (type "") (description "") (notes ()) (section staging-detection) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code code? code-stage code-expr stage-quote? stage-splice? stage-run? make-stage-env stage-env? stage-env-level stage-env-bindings stage-env-fragments stage-env-incr stage-env-decr stage-env-bind stage-env-lookup stage-env-add-fragment)) (answer "(define (stage-expand expr level) (cond ((stage-quote? expr) (let ((inner (cadr expr))) (if (= level 0) (quasiquote (make-code 1 '(unquote (stage-expand inner 1)))) (quasiquote '(unquote (stage-expand inner (+ level 1))))))) ((stage-splice? expr) (let ((inner (cadr expr))) (if (= level 1) inner (quasiquote (stage-splice (unquote (stage-expand inner (- level 1)))))))) ((stage-run? expr) (let ((inner (cadr expr))) (quasiquote (stage-exec (unquote (stage-expand inner level)))))) ((and (pair? expr) (eq? (car expr) 'lambda)) (quasiquote (lambda (unquote (cadr expr)) (unquote-splicing (map (lambda (e) (stage-expand e level)) (cddr expr)))))) ((and (pair? expr) (eq? (car expr) 'let)) (let ((bindings (cadr expr)) (body (cddr expr))) (quasiquote (let (unquote (map (lambda (b) (list (car b) (stage-expand (cadr b) level))) bindings)) (unquote-splicing (map (lambda (e) (stage-expand e level)) body)))))) ((and (pair? expr) (eq? (car expr) 'if)) (quasiquote (if (unquote (stage-expand (cadr expr) level)) (unquote (stage-expand (caddr expr) level)) (unquote-splicing (if (null? (cdddr expr)) '() (list (stage-expand (cadddr expr) level))))))) ((pair? expr) (map (lambda (e) (stage-expand e level)) expr)) ((or (symbol? expr) (null? expr)) (if (> level 0) (quasiquote '(unquote expr)) expr)) (else expr)))"))
