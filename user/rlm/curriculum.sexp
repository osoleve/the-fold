(task-entry (id "optics/schema/fields-rename-iso") (skill optics) (module schema) (tier 1) (difficulty 11011) (name fields-rename-iso) (type "(-> Alist (PIso Alist Alist))") (description "Rename multiple fields. Mapping is (old-name . new-name)") (notes ()) (section bulk-operations) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso field-split-iso field-merge-iso field-move-to-front-iso nested-field-iso field-ensure-iso field-with-default-iso)) (answer "(define (fields-rename-iso mapping) (make-p-iso (lambda (alist) (map (lambda (pair) (let ((rename (assq (car pair) mapping))) (if rename (cons (cdr rename) (cdr pair)) pair))) alist)) (lambda (alist) (let ((reverse-mapping (map (lambda (p) (cons (cdr p) (car p))) mapping))) (map (lambda (pair) (let ((rename (assq (car pair) reverse-mapping))) (if rename (cons (cdr rename) (cdr pair)) pair))) alist)))))"))
(task-entry (id "optics/block-migration/make-versioned-tag") (skill optics) (module block-migration) (tier 1) (difficulty 11011) (name make-versioned-tag) (type "(-> Symbol Number Symbol)") (description "Create a versioned tag like 'bbs-issue-v2.") (notes ()) (section version-detection) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag block-migration-to-tag block-migration-payload-iso block-migration-applies? block-migrate-payload block-rollback-payload block-with-refs block-migrate-with-refs parse-versioned-tag)) (answer "(define (make-versioned-tag base version) (string->symbol (format \"~a-v~a\" base version)))"))
