(task-entry (id "statistics/regularized/cross-validate-lambda") (skill statistics) (module regularized) (tier 1) (difficulty 11212) (name cross-validate-lambda) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics compute-r-squared-ridge lasso-fit lasso-coordinate-descent lasso-partial-residual soft-threshold lasso-finalize count-nonzero elastic-net-fit elastic-net-coordinate-descent elastic-net-update)) (answer "(define (cross-validate-lambda X y lambdas k method . opts) (let* ((alpha (if (>= (length opts) 1) (car opts) 1)) (n (matrix-rows X)) (fold-size (quotient n k)) (cv-errors (map (lambda (lam) (cv-error-for-lambda X y lam k method alpha n)) lambdas)) (best-idx (find-min-index cv-errors)) (best-lambda (list-ref lambdas best-idx))) (cons best-lambda cv-errors)))"))
