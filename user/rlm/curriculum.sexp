(task-entry (id "game-theory/evolutionary/population?") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13212) (name population?) (type "") (description "") (notes ()) (section population-state) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population)) (answer "(define (population? x) (and (pair? x) (eq? (car x) 'population)))"))
(task-entry (id "game-theory/mcdm/mcdm-schulze") (skill game-theory) (module mcdm) (tier 1) (difficulty 13212) (name mcdm-schulze) (type "(-> DecisionProblem Alternative)") (description "Find best alternative using Schulze method. Handles Condorcet cycles gracefully. Clone-independent: adding similar alternatives doesn't change ranking of others") (notes ()) (section aggregation-methods) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda)) (answer "(define (mcdm-schulze dp) (schulze-winner (dp->profile dp)))"))
(task-entry (id "game-theory/normal-form/strictly-dominates-p2?") (skill game-theory) (module normal-form) (tier 1) (difficulty 13213) (name strictly-dominates-p2?) (type "") (description "") (notes ()) (section dominated-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1?)) (answer "(define (strictly-dominates-p2? game j j-prime) (let ((n1 (game-num-strategies game 0))) (andmap (lambda (i) (> (game-payoff-p2 game i j) (game-payoff-p2 game i j-prime))) (iota n1))))"))
(task-entry (id "game-theory/extensive-form/chance-probs") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13213) (name chance-probs) (type "(-> ChanceNode (List Number))") (description "") (notes ()) (section node-types) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes)) (answer "(define (chance-probs node) (caddr node))"))
(task-entry (id "game-theory/coop-games/coop-game?") (skill game-theory) (module coop-games) (tier 1) (difficulty 13213) (name coop-game?) (type "(-> Any Boolean)") (description "Is x a cooperative game?") (notes ()) (section cooperative-game-record-type) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game)) (answer "(define (coop-game? x) (coop-game%? x))"))
(task-entry (id "game-theory/matching/build-receiver-ranks") (skill game-theory) (module matching) (tier 1) (difficulty 13213) (name build-receiver-ranks) (type "") (description "") (notes ()) (section gale-shapley) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal)) (answer "(define (build-receiver-ranks market) (let* ((receivers (market-receivers market)) (n (vector-length receivers)) (ranks (make-vector n '()))) (do ((i 0 (+ i 1))) ((= i n) ranks) (let* ((r-id (vector-ref receivers i)) (prefs (market-receiver-prefs market r-id)) (rank-table (build-rank-table prefs))) (vector-set! ranks i rank-table)))))"))
(task-entry (id "game-theory/voting/plurality-scores") (skill game-theory) (module voting) (tier 1) (difficulty 13213) (name plurality-scores) (type "(-> Int (List Int))") (description "Plurality: only first place gets 1 point. Score vector: (s_1, s_2, ..., s_m) where s_i is score for position i. Returns empty list for m=0") (notes ()) (section positional-rules) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima)) (answer "(define (plurality-scores m) (if (<= m 0) '() (cons 1 (make-list (- m 1) 0))))"))
(task-entry (id "game-theory/strategic-voting/find-manipulation-example") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13213) (name find-manipulation-example) (type "(-> VotingRule Nat (Union (List ...) Symbol))") (description "Find a concrete manipulation example for a voting rule. Demonstrates Gibbard-Satterthwaite") (notes ()) (section gibbard-satterthwaite) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium all-strategic-equilibria cartesian-product-n price-of-anarchy price-of-stability count-manipulable-profiles strategy-proofness-ratio compare-strategy-proofness)) (answer "(define (find-manipulation-example voting-rule num-candidates) (let* ((candidates (map (lambda (i) (string->symbol (string (integer->char (+ i 97))))) (iota num-candidates))) (all-rankings (permutations candidates)) (num-voters 3) (all-profiles (cartesian-product-n all-rankings num-voters))) (let search-profile ((profiles all-profiles)) (if (null? profiles) 'not-found (let* ((profile (car profiles)) (result (find-manipulation-in-profile profile voting-rule))) (if (eq? result 'not-found) (search-profile (cdr profiles)) result))))))"))
(task-entry (id "game-theory/voting-games/is-minimal-winning?") (skill game-theory) (module voting-games) (tier 1) (difficulty 13213) (name is-minimal-winning?) (type "") (description "") (notes ()) (section power-analysis) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions)) (answer "(define (is-minimal-winning? game S) (and (is-winning? game S) (let ((members (coalition->list S))) (for-all? (lambda (i) (not (is-winning? game (coalition-difference S (coalition-singleton i))))) members))))"))
(task-entry (id "game-theory/multi-winner/stv-hare") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13213) (name stv-hare) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop)) (answer "(define (stv-hare profile num-seats) (stv profile num-seats hare-quota))"))
