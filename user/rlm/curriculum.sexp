(task-entry (id "data/graph-matrix/adjacency-reachability") (skill data) (module graph-matrix) (tier 0) (difficulty 1333) (name adjacency-reachability) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize adjacency-symmetrize-sparse degree-matrix degree-matrix-sparse complete-graph cycle-graph path-graph star-graph bipartite-graph adjacency-power)) (answer "(define (adjacency-reachability m k) (let ((n (matrix-rows m))) (let loop ((step 1) (result (matrix-identity n)) (power m)) (if (> step k) result (loop (+ step 1) (matrix-add result power) (matrix-mul power m))))))"))
(task-entry (id "data/graph-layout/normalize-layout") (skill data) (module graph-layout) (tier 0) (difficulty 1333) (name normalize-layout) (type "") (description "") (notes ()) (section normalization) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens graph-nodes-each graph-all-positions graph-all-velocities *repulsion-constant* *attraction-constant* *gravity-constant* *damping* *min-distance* *max-displacement* calculate-repulsion calculate-attraction layout-step node-index run-layout layout-bounds)) (answer "(define (normalize-layout graph width height margin) (let-values (((min-x min-y max-x max-y) (layout-bounds graph))) (let* ((range-x (max 1 (- max-x min-x))) (range-y (max 1 (- max-y min-y))) (usable-w (- width (* 2 margin))) (usable-h (- height (* 2 margin))) (scale (min (/ usable-w range-x) (/ usable-h range-y))) (normalize-pos (lambda (node) (let* ((pos (^. node node-pos-lens)) (x (vector-ref pos 0)) (y (vector-ref pos 1)) (norm-x (+ margin (* scale (- x min-x)))) (norm-y (+ margin (* scale (- y min-y))))) (& node (.~ node-pos-lens (vector norm-x norm-y))))))) (traversal-over graph-nodes-each normalize-pos graph))))"))
