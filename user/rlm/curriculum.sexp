(task-entry (id "topology/persistent/filter-finite") (skill topology) (module persistent) (tier 1) (difficulty 11839) (name filter-finite) (type "(-> (List (List Number Number)) (List (List Number Number)))") (description "") (notes ()) (section distance-metrics) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti diagram->barcode car< barcode? barcode-intervals barcode-print diagram-bottleneck)) (answer "(define (filter-finite pts) (filter (lambda (pt) (not (infinite? (cadr pt)))) pts))"))
(task-entry (id "topology/simplicial-complex/chain-add-term") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11840) (name chain-add-term) (type "(-> Chain Integer Simplex Chain)") (description "Add a term to a chain, combining coefficients if simplex already present") (notes ()) (section boundary-operator) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim sc-vertices sc-edges sc-faces sc-count sc-count-dim sc-skeleton sc-star sc-closed-star sc-link make-chain chain-empty)) (answer "(define (chain-add-term chain coeff s) (let loop ((remaining chain) (acc '()) (found #f)) (cond ((null? remaining) (if found (reverse acc) (reverse (cons (cons coeff s) acc)))) ((simplex-equal? s (cdar remaining)) (let ((new-coeff (+ coeff (caar remaining)))) (if (= new-coeff 0) (loop (cdr remaining) acc #t) (loop (cdr remaining) (cons (cons new-coeff (cdar remaining)) acc) #t)))) (else (loop (cdr remaining) (cons (car remaining) acc) found)))))"))
(task-entry (id "topology/persistent/point-distance") (skill topology) (module persistent) (tier 1) (difficulty 11840) (name point-distance) (type "(-> (List Number Number) (List Number Number) Number)") (description "L∞ distance between persistence points") (notes ()) (section distance-metrics) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti diagram->barcode car< barcode? barcode-intervals barcode-print diagram-bottleneck filter-finite)) (answer "(define (point-distance p1 p2) (max (abs (- (car p1) (car p2))) (abs (- (cadr p1) (cadr p2)))))"))
(task-entry (id "topology/simplicial-complex/simplex-boundary") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11841) (name simplex-boundary) (type "(-> Simplex Chain)") (description "Compute the boundary of a simplex as a chain") (notes ("∂[v0, v1, ..., vn] = Σ (-1)^i [v0, ..., v̂i, ..., vn] where v̂i means vi is omitted")) (section boundary-operator) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim sc-vertices sc-edges sc-faces sc-count sc-count-dim sc-skeleton sc-star sc-closed-star sc-link make-chain chain-empty chain-add-term)) (answer "(define (simplex-boundary s) (let* ((verts (simplex-vertices s)) (n (length verts))) (if (<= n 1) chain-empty (let loop ((i 0) (chain chain-empty)) (if (>= i n) chain (let* ((sign (if (even? i) 1 -1)) (face (make-simplex (remove-at verts i)))) (loop (+ i 1) (chain-add-term chain sign face))))))))"))
(task-entry (id "topology/persistent/diagonal-distance") (skill topology) (module persistent) (tier 1) (difficulty 11841) (name diagonal-distance) (type "(-> (List Number Number) Number)") (description "Distance from point to diagonal (persistence / 2)") (notes ()) (section distance-metrics) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti diagram->barcode car< barcode? barcode-intervals barcode-print diagram-bottleneck filter-finite point-distance)) (answer "(define (diagonal-distance pt) (/ (- (cadr pt) (car pt)) 2))"))
(task-entry (id "topology/simplicial-complex/chain-boundary") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11842) (name chain-boundary) (type "(-> Chain Chain)") (description "Extend boundary operator linearly to chains") (notes ("∂(Σ ai·σi) = Σ ai·∂σi")) (section boundary-operator) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim sc-vertices sc-edges sc-faces sc-count sc-count-dim sc-skeleton sc-star sc-closed-star sc-link make-chain chain-empty chain-add-term simplex-boundary)) (answer "(define (chain-boundary chain) (let loop ((remaining chain) (result chain-empty)) (if (null? remaining) result (let* ((term (car remaining)) (coeff (car term)) (s (cdr term)) (bd (simplex-boundary s))) (loop (cdr remaining) (chain-add-terms result (map (lambda (t) (cons (* coeff (car t)) (cdr t))) bd)))))))"))
(task-entry (id "topology/persistent/bottleneck-greedy") (skill topology) (module persistent) (tier 1) (difficulty 11842) (name bottleneck-greedy) (type "(-> (List Point) (List Point) Number)") (description "Greedy matching approximation to bottleneck distance") (notes ("Greedily matches each point to its closest available partner or diagonal.\nThis gives an O(n²) 2-approximation to the true bottleneck distance.")) (section distance-metrics) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti diagram->barcode car< barcode? barcode-intervals barcode-print diagram-bottleneck filter-finite point-distance diagonal-distance)) (answer "(define (bottleneck-greedy pts1 pts2) (let* ((n1 (length pts1)) (n2 (length pts2)) (vec1 (list->vector pts1)) (vec2 (list->vector pts2)) (matched1 (make-vector n1 #f)) (matched2 (make-vector n2 #f)) (max-cost 0.0)) (do ((i 0 (+ i 1))) ((= i n1)) (let* ((p1 (vector-ref vec1 i)) (diag-cost (diagonal-distance p1)) (best-j #f) (best-cost diag-cost)) (do ((j 0 (+ j 1))) ((= j n2)) (unless (vector-ref matched2 j) (let ((cost (point-distance p1 (vector-ref vec2 j)))) (when (< cost best-cost) (set! best-j j) (set! best-cost cost))))) (vector-set! matched1 i #t) (when best-j (vector-set! matched2 best-j #t)) (set! max-cost (max max-cost best-cost)))) (do ((j 0 (+ j 1))) ((= j n2)) (unless (vector-ref matched2 j) (set! max-cost (max max-cost (diagonal-distance (vector-ref vec2 j)))))) max-cost))"))
(task-entry (id "topology/simplicial-complex/chain-add-terms") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11843) (name chain-add-terms) (type "(-> Chain (List Term) Chain)") (description "") (notes ()) (section boundary-operator) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim sc-vertices sc-edges sc-faces sc-count sc-count-dim sc-skeleton sc-star sc-closed-star sc-link make-chain chain-empty chain-add-term simplex-boundary chain-boundary)) (answer "(define (chain-add-terms chain terms) (let loop ((remaining terms) (result chain)) (if (null? remaining) result (let ((term (car remaining))) (loop (cdr remaining) (chain-add-term result (car term) (cdr term)))))))"))
(task-entry (id "topology/persistent/compute-persistence") (skill topology) (module persistent) (tier 1) (difficulty 11843) (name compute-persistence) (type "(-> (List Point) Integer Number PersistenceDiagram)") (description "One-shot: compute persistence diagram from point cloud") (notes ()) (section convenience) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti diagram->barcode car< barcode? barcode-intervals barcode-print diagram-bottleneck filter-finite point-distance diagonal-distance bottleneck-greedy)) (answer "(define (compute-persistence points max-dim max-epsilon) (let* ((filtration (rips-filtration points max-dim max-epsilon euclidean-distance)) (result (persistence-reduce filtration)) (diagram (make-persistence-diagram result))) diagram))"))
(task-entry (id "topology/simplicial-complex/sc-euler") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11844) (name sc-euler) (type "(-> SC Integer)") (description "Compute Euler characteristic: χ = Σ (-1)^k f_k") (notes ("where f_k is the number of k-simplices")) (section topological-invariants) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim sc-vertices sc-edges sc-faces sc-count sc-count-dim sc-skeleton sc-star sc-closed-star sc-link make-chain chain-empty chain-add-term simplex-boundary chain-boundary chain-add-terms)) (answer "(define (sc-euler sc) (let ((max-d (sc-max-dim sc))) (let loop ((k 0) (sum 0)) (if (> k max-d) sum (let ((sign (if (even? k) 1 -1)) (count (sc-count-dim sc k))) (loop (+ k 1) (+ sum (* sign count))))))))"))
(task-entry (id "topology/persistent/persistence-summary") (skill topology) (module persistent) (tier 1) (difficulty 11844) (name persistence-summary) (type "(-> PersistenceDiagram Void)") (description "Print summary of persistence diagram") (notes ()) (section convenience) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti diagram->barcode car< barcode? barcode-intervals barcode-print diagram-bottleneck filter-finite point-distance diagonal-distance bottleneck-greedy compute-persistence)) (answer "(define (persistence-summary pd) (let* ((points (diagram-points pd)) (max-dim (if (null? points) -1 (apply max (map caddr points))))) (printf \"~n=== Persistence Summary ===~n\") (printf \"Total features: ~a~n\" (length points)) (do ((d 0 (+ d 1))) ((> d max-dim)) (let* ((dim-pts (filter (lambda (p) (= (caddr p) d)) points)) (finite (filter (lambda (p) (not (infinite? (cadr p)))) dim-pts)) (essential (filter (lambda (p) (infinite? (cadr p))) dim-pts))) (printf \"H_~a: ~a finite, ~a essential~n\" d (length finite) (length essential)))) (printf \"===========================~n\")))"))
(task-entry (id "topology/simplicial-complex/sc-f-vector") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11845) (name sc-f-vector) (type "(-> SC (List Integer))") (description "Get the f-vector: (f_0, f_1, ..., f_d)") (notes ("where f_k = number of k-simplices")) (section topological-invariants) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim sc-vertices sc-edges sc-faces sc-count sc-count-dim sc-skeleton sc-star sc-closed-star sc-link make-chain chain-empty chain-add-term simplex-boundary chain-boundary chain-add-terms sc-euler)) (answer "(define (sc-f-vector sc) (let ((max-d (sc-max-dim sc))) (if (< max-d 0) '() (map (lambda (k) (sc-count-dim sc k)) (iota (+ max-d 1))))))"))
