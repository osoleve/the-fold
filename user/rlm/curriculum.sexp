(task-entry (id "physics/diff/traced-integrators/traced-semi-implicit-step") (skill physics/diff) (module traced-integrators) (tier 2) (difficulty 23104) (name traced-semi-implicit-step) (type "") (description "") (notes ()) (section symplectic-euler-integration) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body)) (available (traced-euler-step traced-euler-step-with-force traced-euler-step-explicit traced-verlet-step)) (answer "(define (traced-semi-implicit-step body accel torque-over-I dt damping) (if (traced-body-static? body) body (let* ((new-vel-raw (traced-vec2-add (traced-body-vel body) (traced-vec2-scale accel dt))) (new-omega-raw (traced-add (traced-body-angular-vel body) (traced-mul torque-over-I dt))) (new-vel (traced-vec2-scale new-vel-raw damping)) (new-omega (traced-mul new-omega-raw damping)) (new-pos (traced-vec2-add (traced-body-pos body) (traced-vec2-scale new-vel dt))) (new-angle (traced-add (traced-body-angle body) (traced-mul new-omega dt)))) (traced-body-with-state body new-pos new-vel new-angle new-omega))))"))
