(task-entry (id "algebra/galois/gf-primitive?") (skill algebra) (module galois) (tier 0) (difficulty 351) (name gf-primitive?) (type "(-> Field Element Boolean)") (description "") (notes ()) (section primitive-elements) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod unique-prime-divisors poly-frobenius-power rabin-irreducible? poly-irreducible? poly-has-factor-up-to-degree? poly-has-root? poly-has-monic-factor-of-degree? gf2-8-aes-irred make-gf2-8-aes gf2-4-irred make-gf2-4 gf2-16-irred make-gf2-16 gf2-32-irred make-gf2-32 make-gf-p2 gf-ext-to-poly gf2n-to-poly)) (answer "(define (gf-primitive? F element) (let* ((q (gf-order F)) (q-1 (- q 1)) (one (field-one F)) (eq-fn (field-equal-fn F))) (let ((divisors (proper-divisors q-1))) (not (ormap (lambda (d) (eq-fn (field-power F element d) one)) divisors)))))"))
