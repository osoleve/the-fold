(task-entry (id "physics/classical/constraint-graph/cg-toposort-constraints") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23523) (name cg-toposort-constraints) (type "") (description "") (notes ()) (section toposort) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag)) (answer "(define (cg-toposort-constraints graph) (let* ((sccs (cg-find-sccs graph)) (scc-dag (cg-scc-dag graph sccs)) (sorted-scc-indices (toposort-dag (list-ref scc-dag 2)))) (if sorted-scc-indices (let ((sccs-vec (list->vector sccs))) (fold-right (lambda (idx acc) (append (scc-constraints (vector-ref sccs-vec idx)) acc)) '() sorted-scc-indices)) #f)))"))
