(task-entry (id "fp/integrate/integrate-power") (skill fp) (module integrate) (tier 1) (difficulty 10607) (name integrate-power) (type "") (description "") (notes ()) (section basic-integration-rules) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product)) (answer "(define (integrate-power expr var-sym depth) (let ((base (pow-base expr)) (exp (pow-exp expr))) (cond ((and (var? base) (eq? (var-name base) var-sym) (not (contains-var? exp var-sym))) (if (and (num? exp) (= (num-val exp) -1)) (sym-log (make-app 'abs base)) (let ((new-exp (sum exp (num 1)))) (division (power base new-exp) new-exp)))) ((and (not (contains-var? base var-sym)) (var? exp) (eq? (var-name exp) var-sym)) (division expr (sym-log base))) ((and (num? exp) (linear-in? base var-sym)) (let* ((coeffs (linear-coefficients base var-sym)) (a (car coeffs)) (new-exp (sum exp (num 1)))) (if (and (num? exp) (= (num-val exp) -1)) (division (sym-log (make-app 'abs base)) a) (division (power base new-exp) (product a new-exp))))) (else #f))))"))
