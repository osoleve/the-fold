(task-entry (id "physics/diff/rollout/projectile-hit-loss") (skill physics/diff) (module rollout) (tier 2) (difficulty 23114) (name projectile-hit-loss) (type "") (description "") (notes ()) (section basic-rollout) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body \x27;traced-integrators)) (available (traced-rollout traced-rollout-with-gravity traced-rollout-with-force traced-rollout-trajectory traced-trajectory-final checkpoint-interval rollout-checkpoints traced-segment-rollout compute-segment-gradient checkpointed-gradient target-position-loss target-state-loss trajectory-loss energy-minimization-loss)) (answer "(define (projectile-hit-loss start-pos target gravity dt num-steps) (lambda (initial-vel) (with-fresh-ad-scope (lambda () (let* ((tape (make-reverse-tape)) (traced-pos (lift-vec2 start-pos tape)) (traced-vel (lift-vec2 initial-vel tape)) (traced-gravity (lift-vec2-const gravity)) (final-state (let loop ((pos traced-pos) (vel traced-vel) (i 0)) (if (>= i num-steps) pos (call-with-values (lambda () (traced-point-step pos vel traced-gravity dt)) (lambda (new-pos new-vel) (loop new-pos new-vel (+ i 1))))))) (dist-sq (traced-vec2-distance-sq final-state (lift-vec2-const target)))) (traced-value dist-sq))))))"))
