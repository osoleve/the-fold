(task-entry (id "linalg/graph-laplacian/algebraic-connectivity") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 404) (name algebraic-connectivity) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk)) (answer "(define (algebraic-connectivity adj) (let* ((L (laplacian adj)) (eigs (eigenvalues L))) (if (and (pair? eigs) (eq? (car eigs) 'error)) eigs (let ((sorted (vector-sort-by < eigs))) (if (>= (vector-length sorted) 2) (vector-ref sorted 1) 0)))))"))
(task-entry (id "linalg/svd/svd-via-aat") (skill linalg) (module svd) (tier 0) (difficulty 404) (name svd-via-aat) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata)) (answer "(define (svd-via-aat a m n max-iter tol) (let* ((at (matrix-transpose a)) (aat (matrix-mul a at)) (eigen-result (symmetric-eigen aat max-iter tol))) (if (and (pair? eigen-result) (eq? (car eigen-result) 'error)) eigen-result (let* ((eigenvalues (car eigen-result)) (u (cdr eigen-result)) (sorted (sort-singular-data eigenvalues u m)) (sorted-eigenvalues (car sorted)) (sorted-u (cdr sorted)) (singular-values (eigenvalues->singular-values sorted-eigenvalues tol)) (sigma (build-sigma-matrix m n singular-values)) (v (compute-v-from-atu at sorted-u singular-values m n tol))) (list sorted-u sigma v)))))"))
