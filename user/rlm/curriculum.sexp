(task-entry (id "fp/regex/compile-repeat") (skill fp) (module regex) (tier 1) (difficulty 10662) (name compile-repeat) (type "(-> RegexAST Nat (Option Nat) (List Char) FSM)") (description "") (notes ()) (section thompson-construction) (deps (\x27;prelude \x27;parser \x27;fsm)) (available (*default-universe* regex-lit regex-lit? regex-lit-char regex-dot regex-dot? regex-class regex-class? regex-class-chars regex-class-negated? regex-seq regex-seq? regex-seq-exprs regex-alt regex-alt? regex-alt-exprs regex-star regex-star? regex-star-expr regex-plus regex-plus? regex-plus-expr regex-opt regex-opt? regex-opt-expr regex-group regex-group? regex-group-expr regex-empty regex-empty? regex-repeat regex-repeat? regex-repeat-expr regex-repeat-min regex-repeat-max regex-anchor regex-anchor? regex-anchor-type regex-lookahead regex-lookahead? regex-lookahead-expr regex-lookahead-positive? parse-escape parse-literal parse-dot parse-class parse-class-item parse-class-char parse-class-range parse-group parse-lookahead parse-anchor parse-interval parse-atom parse-postfix-op apply-postfix-op parse-postfix parse-seq parse-alt parse-regex regex-parse regex-compile)) (answer "(define (compile-repeat expr min max universe) (let ((base (regex-compile expr universe))) (cond ((and (= min 0) (eqv? max 0)) (fsm-epsilon-lang)) ((and (= min 0) (not max)) (fsm-star base)) ((= min 0) (fold-left (lambda (acc _) (fsm-optional (fsm-concat base acc))) (fsm-epsilon-lang) (iota max))) ((eqv? min max) (fold-left fsm-concat base (map (lambda (_) (regex-compile expr universe)) (iota (- min 1))))) ((not max) (let ((required (fold-left fsm-concat base (map (lambda (_) (regex-compile expr universe)) (iota (- min 1)))))) (fsm-concat required (fsm-star base)))) (else (let* ((required (fold-left fsm-concat base (map (lambda (_) (regex-compile expr universe)) (iota (- min 1))))) (optional (fold-left (lambda (acc _) (fsm-concat (fsm-optional base) acc)) (fsm-epsilon-lang) (iota (- max min))))) (fsm-concat required optional))))))"))
(task-entry (id "fp/combinators/dedup-consecutive") (skill fp) (module combinators) (tier 1) (difficulty 10662) (name dedup-consecutive) (type "(-> (List a) (List a))") (description "Remove consecutive duplicates (like Unix uniq)") (notes ("For general duplicate removal, use prelude's unique")) (section list-utilities) (deps (\x27;prelude \x27;sort)) (available (id identity const flip apply-fn compose2 compose pipe2 pipe >>> <<< curry2 uncurry2 curry3 uncurry3 partial partial2 rpartial on both pair-first pair-second bimap complement conjoin disjoin fst snd swap dup pair nothing just just? nothing? from-just maybe maybe-fmap maybe-bind filter-maybe cat-maybes sequence-maybe left right left? right? from-left from-right either either-fmap either-fmap-left either-bind from-either rights lefts partition-eithers head tail cons-if intersperse intercalate group-by)) (answer "(define (dedup-consecutive xs) (if (null? xs) '() (let loop ((xs (cdr xs)) (prev (car xs)) (result (list (car xs)))) (if (null? xs) (reverse result) (if (equal? (car xs) prev) (loop (cdr xs) prev result) (loop (cdr xs) (car xs) (cons (car xs) result)))))))"))
