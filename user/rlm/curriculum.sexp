(task-entry (id "control-systems/state-space/ss?") (skill control-systems) (module state-space) (tier 2) (difficulty 22600) (name ss?) (type "(-> Any Boolean)") (description "Check if value is a state space system") (notes ()) (section representation) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available ()) (answer "(define (ss? sys) (and (pair? sys) (eq? (car sys) 'ss) (= (length sys) 5) (matrix? (cadr sys)) (matrix? (caddr sys)) (matrix? (cadddr sys)) (matrix? (car (cddddr sys)))))"))
(task-entry (id "control-systems/transfer-function/tf?") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22600) (name tf?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available ()) (answer "(define (tf? x) (and (pair? x) (eq? (car x) 'tf) (= (length x) 3) (poly? (cadr x)) (poly? (caddr x))))"))
(task-entry (id "control-systems/z-transform/dtf?") (skill control-systems) (module z-transform) (tier 2) (difficulty 22600) (name dtf?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available ()) (answer "(define (dtf? x) (and (pair? x) (eq? (car x) 'dtf) (= (length x) 4) (poly? (cadr x)) (poly? (caddr x)) (number? (cadddr x))))"))
(task-entry (id "control-systems/tf-convert/ss->tf") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22600) (name ss->tf) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available ()) (answer "(define (ss->tf sys . opts) (let* ((input-idx (if (and (pair? opts) (car opts)) (car opts) 0)) (output-idx (if (and (pair? opts) (pair? (cdr opts)) (cadr opts)) (cadr opts) 0)) (A (ss-A sys)) (B (ss-B sys)) (C (ss-C sys)) (D (ss-D sys)) (n (ss-order sys))) (if (= n 0) (tf-from-lists (list (matrix-ref D output-idx input-idx)) (list 1)) (ss->tf-leverrier A B C D input-idx output-idx n))))"))
(task-entry (id "control-systems/kalman/kalman?") (skill control-systems) (module kalman) (tier 2) (difficulty 22600) (name kalman?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available ()) (answer "(define (kalman? kf) (and (pair? kf) (eq? (car kf) 'kalman) (= (length kf) 5)))"))
(task-entry (id "control-systems/stability/ss-poles") (skill control-systems) (module stability) (tier 2) (difficulty 22600) (name ss-poles) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available ()) (answer "(define (ss-poles sys) (let* ((A (ss-A sys)) (n (matrix-rows A))) (if (= n 1) (list (make-complex (matrix-ref A 0 0) 0)) (qr-algorithm-shifted A 100 1e-10))))"))
(task-entry (id "control-systems/controller-design/pid-tf") (skill control-systems) (module controller-design) (tier 2) (difficulty 22600) (name pid-tf) (type "Number × Number × Number → TF") (description "Create PID controller as transfer function. C(s) = Kp + Ki/s + Kd*s = (Kd*s^2 + Kp*s + Ki) / s") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available ()) (answer "(define (pid-tf Kp Ki Kd) (if (zero? Kd) (if (zero? Ki) (tf-from-lists (list Kp) '(1)) (tf-from-lists (list Kp Ki) '(1 0))) (tf-from-lists (list Kd Kp Ki) '(1 0))))"))
