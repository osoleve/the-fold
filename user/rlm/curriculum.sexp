(task-entry (id "fp/simplify/expr-complexity") (skill fp) (module simplify) (tier 1) (difficulty 10639) (name expr-complexity) (type "(-> Expr Number)") (description "Measure complexity of expression") (notes ()) (section canonical-form) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow simplify-app expand expand-once expand-product expand-power-of-sum factor factor-sum find-common-factor get-factors divides? divide-out simplify-trig simplify-trig-once simplify-pythagorean-identity find-sin-squared find-matching-cos-squared simplify-double-angle-product remove-first to-canonical sort-by-complexity)) (answer "(define (expr-complexity expr) (cond ((num? expr) 0) ((var? expr) 1) ((sum? expr) (+ 2 (apply + (map expr-complexity (sum-terms expr))))) ((product? expr) (+ 2 (apply + (map expr-complexity (product-factors expr))))) ((difference? expr) (+ 2 (expr-complexity (diff-left expr)) (if (diff-right expr) (expr-complexity (diff-right expr)) 0))) ((quotient? expr) (+ 3 (expr-complexity (quot-numer expr)) (expr-complexity (quot-denom expr)))) ((power? expr) (+ 4 (expr-complexity (pow-base expr)) (expr-complexity (pow-exp expr)))) ((app? expr) (+ 5 (expr-complexity (app-arg expr)))) (else 10)))"))
