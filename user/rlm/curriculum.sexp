(task-entry (id "tiles/hex/hex-neighbors") (skill tiles) (module hex) (tier 1) (difficulty 12309) (name hex-neighbors) (type "(-> AxialCoord (List AxialCoord))") (description "Get all 6 neighbors") (notes ()) (section neighbors) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial hex-axial-directions hex-neighbor)) (answer "(define (hex-neighbors coord) (map (lambda (dir) (hex-neighbor coord (car dir))) hex-axial-directions))"))
(task-entry (id "tiles/triangle/triangle-neighbors-vertex") (skill tiles) (module triangle) (tier 1) (difficulty 12309) (name triangle-neighbors-vertex) (type "(-> TriangleCoord (List TriangleCoord))") (description "Get vertex-adjacent neighbors (sharing a corner but not edge)") (notes ()) (section neighbors) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge)) (answer "(define (triangle-neighbors-vertex t) (let ((row (triangle-row t)) (col (triangle-col t)) (ori (triangle-orientation t))) (if (eq? ori 'up) (list (triangle-coord (- row 1) (- col 1) 'down) (triangle-coord (- row 1) col 'up) (triangle-coord (- row 1) (+ col 1) 'down)) (list (triangle-coord (+ row 1) (- col 1) 'up) (triangle-coord (+ row 1) col 'down) (triangle-coord (+ row 1) (+ col 1) 'up)))))"))
(task-entry (id "tiles/pathfinding/board-cost") (skill tiles) (module pathfinding) (tier 1) (difficulty 12309) (name board-cost) (type "(-> Board Coord Number)") (description "Get movement cost for a coordinate on the board") (notes ()) (section board-integration) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert pqueue-pop reconstruct-path bfs-path dijkstra-path astar-path board-walkable?)) (answer "(define (board-cost board coord) (let ((tile (board-get board coord))) (if tile (tile-cost tile) 999)))"))
(task-entry (id "tiles/units/game-all-units") (skill tiles) (module units) (tier 1) (difficulty 12309) (name game-all-units) (type "") (description "") (notes ()) (section game-state) (deps (\x27;tiles/core)) (available (make-unit unit-get-prop unit-set-prop make-game-state game-board game-place-unit game-remove-unit game-get-unit-at game-get-unit-coord)) (answer "(define (game-all-units gs) (let ((c->u (game-state%-coord->unit gs))) (map (lambda (coord) (cons coord (hashtable-ref c->u coord #f))) (vector->list (hashtable-keys c->u)))))"))
(task-entry (id "tiles/turns/turn-next-phase") (skill tiles) (module turns) (tier 1) (difficulty 12309) (name turn-next-phase) (type "(-> TurnState TurnState)") (description "Advance to next phase in turn (movement → action → end → movement)") (notes ()) (section advancement) (deps (\x27;sort)) (available (make-turn-state make-turn-state-from-game turn-current-unit turn-current-phase turn-number turn-actions-remaining turn-can-act? turn-spend-action turn-log-action)) (answer "(define (turn-next-phase ts) (let ((current-phase (turn-state%-phase ts))) (make-turn-state% (turn-state%-turn-number ts) (turn-state%-active-unit ts) (turn-state%-turn-order ts) (turn-state%-action-points ts) (case current-phase ((movement) 'action) ((action) 'end) ((end) 'movement)) (turn-state%-history ts))))"))
