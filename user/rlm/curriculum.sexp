(task-entry (id "egraph/cost/combine-costs") (skill egraph) (module cost) (tier 1) (difficulty 10018) (name combine-costs) (type "(-> EGraph (List (Pair CostModel Nat)) (Hashtable ClassId Nat))") (description "Compute weighted combination of cost models.") (notes ()) (section composite) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost ast-size-cost ast-depth-cost leaf-count-cost make-weighted-cost cuda-op-costs cuda-cost cpu-op-costs cpu-cost code-size-op-costs code-size-cost)) (answer "(define (combine-costs eg models-and-weights) (let ((model-costs (map (lambda (mw) (cons (cdr mw) (compute-costs eg (car mw)))) models-and-weights)) (uf (egraph-uf eg)) (combined (make-hashtable equal-hash equal?))) (for-each (lambda (root) (let ((total (fold-left (lambda (acc wc) (+ acc (* (car wc) (hashtable-ref (cdr wc) root +inf.0)))) 0 model-costs))) (hashtable-set! combined root total))) (uf-roots uf)) combined))"))
(task-entry (id "egraph/scheduler/scheduler-update") (skill egraph) (module scheduler) (tier 1) (difficulty 10018) (name scheduler-update) (type "") (description "") (notes ()) (section protocol) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select)) (answer "(define (scheduler-update s) (vector-ref s 4))"))
(task-entry (id "egraph/union-find/uf-debug") (skill egraph) (module union-find) (tier 1) (difficulty 10019) (name uf-debug) (type "(-> UnionFind Void)") (description "Print union-find internal state.") (notes ()) (section debug) (deps (\x27;prelude)) (available (uf-tag make-uf uf? uf-parent uf-rank uf-count-box uf-next-id-box uf-count uf-size ensure-capacity! uf-make-set! uf-find uf-union! uf-same-set? uf-roots uf-all-sets-table uf-all-sets uf-set-members uf-set-size)) (answer "(define (uf-debug uf) (let ((n (uf-size uf))) (printf \"UnionFind: ~a elements, ~a sets~n\" n (uf-count uf)) (printf \"  ID | Parent | Rank | Root~n\") (printf \"  ---|--------|------|-----~n\") (do ((i 0 (+ i 1))) ((>= i n)) (printf \"  ~a  |   ~a    |  ~a   |  ~a~n\" i (vector-ref (uf-parent uf) i) (vector-ref (uf-rank uf) i) (uf-find uf i)))))"))
(task-entry (id "egraph/eclass/ensure-eclass-capacity!") (skill egraph) (module eclass) (tier 1) (difficulty 10019) (name ensure-eclass-capacity!) (type "") (description "") (notes ()) (section store) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data)) (answer "(define (ensure-eclass-capacity! store id) (let ((data (eclass-store-data store))) (when (>= id (vector-length data)) (let* ((old-len (vector-length data)) (new-len (max (* 2 old-len) (+ id 1))) (new-data (make-vector new-len #f))) (do ((i 0 (+ i 1))) ((>= i old-len)) (vector-set! new-data i (vector-ref data i))) (vector-set! store 1 new-data)))))"))
(task-entry (id "egraph/egraph/egraph-add-enode!") (skill egraph) (module egraph) (tier 1) (difficulty 10019) (name egraph-add-enode!) (type "(-> EGraph ENode EClassId)") (description "Add e-node, return its canonical e-class ID (new or existing).") (notes ()) (section operations) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup)) (answer "(define (egraph-add-enode! eg enode) (let* ((uf (egraph-uf eg)) (canonical (enode-canonicalize enode uf)) (hashcons (egraph-hashcons eg)) (existing (hashtable-ref hashcons canonical #f))) (if existing (begin (egraph-inc-stat! eg 3) (uf-find uf existing)) (let* ((classes (egraph-classes eg)) (new-id (uf-make-set! uf))) (egraph-inc-stat! eg 0) (hashtable-set! hashcons canonical new-id) (eclass-add-node! classes new-id canonical) (let ((children (enode-children canonical))) (do ((i 0 (+ i 1))) ((>= i (vector-length children))) (let ((child-id (egraph-find eg (vector-ref children i)))) (eclass-add-parent! classes child-id new-id)))) new-id))))"))
(task-entry (id "egraph/match/rule-rhs") (skill egraph) (module match) (tier 1) (difficulty 10019) (name rule-rhs) (type "") (description "") (notes ()) (section rules) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref eclass-ref? eclass-ref-id pattern-apply make-rule rule-lhs)) (answer "(define (rule-rhs rule) (cdr rule))"))
(task-entry (id "egraph/saturation/saturate-with-fuel") (skill egraph) (module saturation) (tier 1) (difficulty 10019) (name saturate-with-fuel) (type "(-> EGraph (List Rule) Nat SaturationResult)") (description "Run saturation with custom fuel limit.") (notes ()) (section convenience) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate saturate-iteration saturate-simple)) (answer "(define (saturate-with-fuel eg rules fuel) (saturate eg rules (make-saturation-config fuel 10000 0)))"))
(task-entry (id "egraph/cost/analyze-costs") (skill egraph) (module cost) (tier 1) (difficulty 10019) (name analyze-costs) (type "(-> EGraph CostModel (List (Triple ClassId Nat ENode)))") (description "Analyze costs and find best node per class.") (notes ()) (section analysis) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost ast-size-cost ast-depth-cost leaf-count-cost make-weighted-cost cuda-op-costs cuda-cost cpu-op-costs cpu-cost code-size-op-costs code-size-cost combine-costs)) (answer "(define (analyze-costs eg cost-model) (let ((costs (compute-costs eg cost-model)) (store (egraph-classes eg)) (uf (egraph-uf eg)) (results '())) (for-each (lambda (root) (let ((best-node #f) (best-cost +inf.0) (nodes (eclass-get-nodes store root))) (for-each (lambda (node) (let ((c (compute-node-cost node costs (cost-model-fn cost-model)))) (when (< c best-cost) (set! best-cost c) (set! best-node node)))) nodes) (when best-node (set! results (cons (list root best-cost best-node) results))))) (uf-roots uf)) (sort-by (lambda (a b) (< (cadr a) (cadr b))) results)))"))
(task-entry (id "egraph/scheduler/simple-scheduler") (skill egraph) (module scheduler) (tier 1) (difficulty 10019) (name simple-scheduler) (type "") (description "") (notes ()) (section simple) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update)) (answer "(define simple-scheduler (make-scheduler 'simple (lambda (rules) rules) (lambda (state eg) (cons state (uf-roots (egraph-uf eg)))) (lambda (state rule matches) state)))"))
(task-entry (id "egraph/eclass/eclass-get") (skill egraph) (module eclass) (tier 1) (difficulty 10020) (name eclass-get) (type "(-> EClassStore EClassId (Or EClassData #f))") (description "Get e-class data for given ID, or #f if none.") (notes ()) (section store) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity!)) (answer "(define (eclass-get store id) (let ((data (eclass-store-data store))) (if (< id (vector-length data)) (vector-ref data id) #f)))"))
(task-entry (id "egraph/egraph/egraph-merge!") (skill egraph) (module egraph) (tier 1) (difficulty 10020) (name egraph-merge!) (type "(-> EGraph EClassId EClassId EClassId)") (description "Merge two e-classes. Returns merged class ID.") (notes ()) (section operations) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup egraph-add-enode!)) (answer "(define (egraph-merge! eg id1 id2) (let ((uf (egraph-uf eg)) (classes (egraph-classes eg))) (let ((root1 (uf-find uf id1)) (root2 (uf-find uf id2))) (if (= root1 root2) root1 (begin (egraph-inc-stat! eg 1) (let ((new-root (uf-union! uf id1 id2))) (let ((affected (eclass-merge! classes uf id1 id2))) (for-each (lambda (p) (egraph-mark-dirty! eg p)) affected)) new-root))))))"))
(task-entry (id "egraph/match/rule?") (skill egraph) (module match) (tier 1) (difficulty 10020) (name rule?) (type "(-> Any Boolean)") (description "Check if x is a rewrite rule.") (notes ()) (section rules) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref eclass-ref? eclass-ref-id pattern-apply make-rule rule-lhs rule-rhs)) (answer "(define (rule? x) (and (pair? x) (not (null? (car x))) (not (null? (cdr x)))))"))
(task-entry (id "egraph/saturation/arith-identity-rules") (skill egraph) (module saturation) (tier 1) (difficulty 10020) (name arith-identity-rules) (type "") (description "") (notes ()) (section rulesets) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate saturate-iteration saturate-simple saturate-with-fuel)) (answer "(define arith-identity-rules (list (make-rule '(+ ?x 0) '?x) (make-rule '(+ 0 ?x) '?x) (make-rule '(* ?x 1) '?x) (make-rule '(* 1 ?x) '?x) (make-rule '(* ?x 0) '0) (make-rule '(* 0 ?x) '0)))"))
(task-entry (id "egraph/cost/cost-model->string") (skill egraph) (module cost) (tier 1) (difficulty 10020) (name cost-model->string) (type "(-> CostModel String)") (description "Convert cost model to string.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost ast-size-cost ast-depth-cost leaf-count-cost make-weighted-cost cuda-op-costs cuda-cost cpu-op-costs cpu-cost code-size-op-costs code-size-cost combine-costs analyze-costs)) (answer "(define (cost-model->string cm) (format \"CostModel(~a)\" (cost-model-name cm)))"))
(task-entry (id "egraph/scheduler/*backoff-threshold*") (skill egraph) (module scheduler) (tier 1) (difficulty 10020) (name *backoff-threshold*) (type "") (description "") (notes ()) (section backoff) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler)) (answer "(define *backoff-threshold* 3)"))
(task-entry (id "egraph/eclass/eclass-get-or-create!") (skill egraph) (module eclass) (tier 1) (difficulty 10021) (name eclass-get-or-create!) (type "(-> EClassStore EClassId EClassData)") (description "Get e-class data, creating if needed.") (notes ()) (section store) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity! eclass-get)) (answer "(define (eclass-get-or-create! store id) (ensure-eclass-capacity! store id) (let ((data (eclass-store-data store))) (or (vector-ref data id) (let ((new-data (make-eclass-data))) (vector-set! data id new-data) new-data))))"))
(task-entry (id "egraph/egraph/egraph-rebuild!") (skill egraph) (module egraph) (tier 1) (difficulty 10021) (name egraph-rebuild!) (type "(-> EGraph Nat)") (description "Rebuild e-graph after merges. Returns classes processed.") (notes ()) (section rebuild) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup egraph-add-enode! egraph-merge!)) (answer "(define (egraph-rebuild! eg) (let ((uf (egraph-uf eg)) (classes (egraph-classes eg)) (hashcons (egraph-hashcons eg)) (visited (make-eqv-hashtable)) (count 0)) (let loop () (let ((dirty-id (egraph-pop-dirty! eg))) (if (not dirty-id) count (let ((root (uf-find uf dirty-id))) (unless (hashtable-ref visited root #f) (hashtable-set! visited root #t) (egraph-inc-stat! eg 2) (set! count (+ count 1)) (let ((nodes (eclass-get-nodes classes root))) (for-each (lambda (enode) (let ((canonical (enode-canonicalize enode uf))) (unless (enode-equal? enode canonical) (hashtable-delete! hashcons enode)) (let ((existing (hashtable-ref hashcons canonical #f))) (cond ((not existing) (hashtable-set! hashcons canonical root)) ((not (= (uf-find uf existing) root)) (let ((new-root (egraph-merge! eg root existing))) (hashtable-set! hashcons canonical new-root))))))) nodes))) (loop)))))))"))
(task-entry (id "egraph/match/apply-rule") (skill egraph) (module match) (tier 1) (difficulty 10021) (name apply-rule) (type "(-> EGraph Rule EClassId Boolean)") (description "Apply rule to e-class. Returns #t if matched.") (notes ()) (section rules) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref eclass-ref? eclass-ref-id pattern-apply make-rule rule-lhs rule-rhs rule?)) (answer "(define (apply-rule eg rule class-id) (let* ((lhs (rule-lhs rule)) (rhs (rule-rhs rule)) (matches (ematch eg lhs class-id))) (if (null? matches) #f (begin (for-each (lambda (subst) (let ((rhs-term (pattern-apply subst rhs))) (let ((rhs-id (add-instantiated-term eg rhs-term))) (egraph-merge! eg class-id rhs-id)))) matches) #t))))"))
(task-entry (id "egraph/saturation/arith-comm-rules") (skill egraph) (module saturation) (tier 1) (difficulty 10021) (name arith-comm-rules) (type "") (description "") (notes ()) (section rulesets) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate saturate-iteration saturate-simple saturate-with-fuel arith-identity-rules)) (answer "(define arith-comm-rules (list (make-rule '(+ ?x ?y) '(+ ?y ?x)) (make-rule '(* ?x ?y) '(* ?y ?x))))"))
(task-entry (id "egraph/cost/costs-debug") (skill egraph) (module cost) (tier 1) (difficulty 10021) (name costs-debug) (type "(-> EGraph CostModel Void)") (description "Print cost analysis for e-graph.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost ast-size-cost ast-depth-cost leaf-count-cost make-weighted-cost cuda-op-costs cuda-cost cpu-op-costs cpu-cost code-size-op-costs code-size-cost combine-costs analyze-costs cost-model->string)) (answer "(define (costs-debug eg cost-model) (printf \"Cost analysis using ~a:~n\" (cost-model-name cost-model)) (let ((analysis (analyze-costs eg cost-model))) (for-each (lambda (entry) (printf \"  Class ~a: cost=~a, node=~a~n\" (car entry) (cadr entry) (enode->string (caddr entry)))) analysis)))"))
(task-entry (id "egraph/scheduler/*backoff-factor*") (skill egraph) (module scheduler) (tier 1) (difficulty 10021) (name *backoff-factor*) (type "") (description "") (notes ()) (section backoff) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold*)) (answer "(define *backoff-factor* 0.5)"))
(task-entry (id "egraph/eclass/eclass-add-node!") (skill egraph) (module eclass) (tier 1) (difficulty 10022) (name eclass-add-node!) (type "(-> EClassStore EClassId ENode Void)") (description "Add an e-node to the specified e-class.") (notes ()) (section operations) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity! eclass-get eclass-get-or-create!)) (answer "(define (eclass-add-node! store class-id enode) (let ((data (eclass-get-or-create! store class-id))) (eclass-set-nodes! data (cons enode (eclass-nodes data)))))"))
(task-entry (id "egraph/egraph/egraph-saturate-rebuild!") (skill egraph) (module egraph) (tier 1) (difficulty 10022) (name egraph-saturate-rebuild!) (type "(-> EGraph Nat)") (description "Rebuild until fixpoint. Returns total classes processed.") (notes ()) (section rebuild) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup egraph-add-enode! egraph-merge! egraph-rebuild!)) (answer "(define (egraph-saturate-rebuild! eg) (let loop ((total 0)) (let ((processed (egraph-rebuild! eg))) (if (zero? processed) total (loop (+ total processed))))))"))
(task-entry (id "egraph/match/add-instantiated-term") (skill egraph) (module match) (tier 1) (difficulty 10022) (name add-instantiated-term) (type "(-> EGraph InstantiatedTerm EClassId)") (description "Add term with e-class ref leaves to e-graph.") (notes ()) (section rules) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref eclass-ref? eclass-ref-id pattern-apply make-rule rule-lhs rule-rhs rule? apply-rule)) (answer "(define (add-instantiated-term eg term) (cond ((eclass-ref? term) (eclass-ref-id term)) ((symbol? term) (egraph-add-enode! eg (make-enode term (vector)))) ((number? term) (egraph-add-enode! eg (make-enode term (vector)))) ((pair? term) (let* ((op (car term)) (args (cdr term)) (child-ids (map (lambda (t) (add-instantiated-term eg t)) args)) (enode (make-enode op (list->vector child-ids)))) (egraph-add-enode! eg enode))) (else (error 'add-instantiated-term \"Unknown term type\" term))))"))
(task-entry (id "egraph/saturation/arith-assoc-rules") (skill egraph) (module saturation) (tier 1) (difficulty 10022) (name arith-assoc-rules) (type "") (description "") (notes ()) (section rulesets) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate saturate-iteration saturate-simple saturate-with-fuel arith-identity-rules arith-comm-rules)) (answer "(define arith-assoc-rules (list (make-rule '(+ (+ ?x ?y) ?z) '(+ ?x (+ ?y ?z))) (make-rule '(+ ?x (+ ?y ?z)) '(+ (+ ?x ?y) ?z)) (make-rule '(* (* ?x ?y) ?z) '(* ?x (* ?y ?z))) (make-rule '(* ?x (* ?y ?z)) '(* (* ?x ?y) ?z))))"))
(task-entry (id "egraph/scheduler/*min-priority*") (skill egraph) (module scheduler) (tier 1) (difficulty 10022) (name *min-priority*) (type "") (description "") (notes ()) (section backoff) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor*)) (answer "(define *min-priority* 0.1)"))
(task-entry (id "egraph/eclass/eclass-add-parent!") (skill egraph) (module eclass) (tier 1) (difficulty 10023) (name eclass-add-parent!) (type "(-> EClassStore EClassId EClassId Void)") (description "Record that parent-class references child-class.") (notes ()) (section operations) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity! eclass-get eclass-get-or-create! eclass-add-node!)) (answer "(define (eclass-add-parent! store child-class-id parent-class-id) (let ((data (eclass-get-or-create! store child-class-id))) (hashtable-set! (eclass-parents data) parent-class-id #t)))"))
(task-entry (id "egraph/egraph/egraph-add-term!") (skill egraph) (module egraph) (tier 1) (difficulty 10023) (name egraph-add-term!) (type "(-> EGraph Term EClassId)") (description "Add S-expression term to e-graph, return its e-class ID.") (notes ()) (section terms) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup egraph-add-enode! egraph-merge! egraph-rebuild! egraph-saturate-rebuild!)) (answer "(define (egraph-add-term! eg term) (cond ((pair? term) (let* ((op (car term)) (args (cdr term)) (child-ids (map (lambda (arg) (egraph-add-term! eg arg)) args)) (enode (make-enode op (list->vector child-ids)))) (egraph-add-enode! eg enode))) (else (egraph-add-enode! eg (make-enode term (vector))))))"))
(task-entry (id "egraph/match/apply-rules") (skill egraph) (module match) (tier 1) (difficulty 10023) (name apply-rules) (type "(-> EGraph (List Rule) Nat)") (description "Apply all rules to all e-classes once. Returns match count.") (notes ()) (section rules) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref eclass-ref? eclass-ref-id pattern-apply make-rule rule-lhs rule-rhs rule? apply-rule add-instantiated-term)) (answer "(define (apply-rules eg rules) (let ((uf (egraph-uf eg)) (count 0)) (for-each (lambda (root) (for-each (lambda (rule) (when (apply-rule eg rule root) (set! count (+ count 1)))) rules)) (uf-roots uf)) count))"))
(task-entry (id "egraph/saturation/arith-distrib-rules") (skill egraph) (module saturation) (tier 1) (difficulty 10023) (name arith-distrib-rules) (type "") (description "") (notes ()) (section rulesets) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate saturate-iteration saturate-simple saturate-with-fuel arith-identity-rules arith-comm-rules arith-assoc-rules)) (answer "(define arith-distrib-rules (list (make-rule '(* ?x (+ ?y ?z)) '(+ (* ?x ?y) (* ?x ?z))) (make-rule '(+ (* ?x ?y) (* ?x ?z)) '(* ?x (+ ?y ?z)))))"))
