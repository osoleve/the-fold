(task-entry (id "random/distributions/binomial-coeff") (skill random) (module distributions) (tier 1) (difficulty 12905) (name binomial-coeff) (type "(-> Nat Nat Nat)") (description "Binomial coefficient C(n,k)") (notes ()) (section math-helpers) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial)) (answer "(define (binomial-coeff n k) (if (or (< k 0) (> k n)) 0 (/ (factorial n) (* (factorial k) (factorial (- n k))))))"))
