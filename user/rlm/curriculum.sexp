(task-entry (id "topology/persistent/barcode-intervals") (skill topology) (module persistent) (tier 1) (difficulty 11836) (name barcode-intervals) (type "(-> Barcode Integer (List (List Number Number)))") (description "Get intervals for dimension k as (birth death) pairs") (notes ()) (section barcode) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti diagram->barcode car< barcode?)) (answer "(define (barcode-intervals bc dim) (let ((entry (assv dim (cadr bc)))) (if entry (cdr entry) '())))"))
(task-entry (id "topology/simplicial-complex/sc-link") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11837) (name sc-link) (type "(-> SC Simplex SC)") (description "Get the link of a simplex: faces of the closed star that don't intersect s") (notes ("Link(s) = {t ∈ Cl(St(s)) | t ∩ s = ∅}")) (section skeleton-subcomplex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim sc-vertices sc-edges sc-faces sc-count sc-count-dim sc-skeleton sc-star sc-closed-star)) (answer "(define (sc-link sc s) (let* ((closed-star (sc-closed-star sc s)) (s-verts (simplex-vertices s))) (sc-from-simplices (filter (lambda (t) (null? (set-intersection (simplex-vertices t) s-verts))) (sc-simplices closed-star)))))"))
(task-entry (id "topology/persistent/barcode-print") (skill topology) (module persistent) (tier 1) (difficulty 11837) (name barcode-print) (type "(-> Barcode Void)") (description "Print barcode in ASCII format") (notes ()) (section barcode) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti diagram->barcode car< barcode? barcode-intervals)) (answer "(define (barcode-print bc) (printf \"~n=== Persistence Barcode ===~n\") (for-each (lambda (dim-entry) (let ((dim (car dim-entry)) (intervals (cdr dim-entry))) (printf \"~nH_~a (~a intervals):~n\" dim (length intervals)) (for-each (lambda (int) (let* ((birth (car int)) (death (cadr int)) (pers (if (infinite? death) \"+inf\" (- death birth)))) (printf \"  [~,3f, ~a) persistence=~a~n\" birth (if (infinite? death) \"+inf\" (format \"~,3f\" death)) pers))) intervals))) (cadr bc)) (printf \"~n===========================~n\"))"))
