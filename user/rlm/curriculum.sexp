(task-entry (id "autodiff/symbolic-diff/expr->infix") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12728) (name expr->infix) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list simplify-diff simplify-neg simplify-quot simplify-pow simplify-app expr-to-traced eval-traced symbolic-gradient-fn symbolic-jacobian-fn symbolic-hessian-fn verify-derivative)) (answer "(define (expr->infix expr) (cond ((num? expr) (let ((n (num-val expr))) (if (< n 0) (string-append \"(\" (number->string n) \")\") (number->string n)))) ((var? expr) (symbol->string (var-name expr))) ((sum? expr) (string-append \"(\" (string-join (map expr->infix (sum-terms expr)) \" + \") \")\")) ((product? expr) (string-append \"(\" (string-join (map expr->infix (product-factors expr)) \"*\") \")\")) ((difference? expr) (if (diff-right expr) (string-append \"(\" (expr->infix (diff-left expr)) \" - \" (expr->infix (diff-right expr)) \")\") (string-append \"-\" (expr->infix (diff-left expr))))) ((quotient? expr) (string-append \"(\" (expr->infix (quot-numer expr)) \"/\" (expr->infix (quot-denom expr)) \")\")) ((power? expr) (string-append \"(\" (expr->infix (pow-base expr)) \"^\" (expr->infix (pow-exp expr)) \")\")) ((app? expr) (string-append (symbol->string (app-fn expr)) \"(\" (expr->infix (app-arg expr)) \")\")) (else \"?\")))"))
(task-entry (id "autodiff/interval-autodiff/gradient-sign") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12728) (name gradient-sign) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp iv-traced-log iv-traced-sin iv-traced-cos iv-traced-pow interval-backward interval-gradient)) (answer "(define (gradient-sign iv) (let ((lo (interval-lo iv)) (hi (interval-hi iv))) (cond ((and (= lo 0) (= hi 0)) 'zero) ((> lo 0) 'positive) ((< hi 0) 'negative) (else 'mixed))))"))
