(task-entry (id "physics/diff/traced-integrators/traced-verlet-step") (skill physics/diff) (module traced-integrators) (tier 2) (difficulty 23103) (name traced-verlet-step) (type "") (description "") (notes ()) (section symplectic-euler-integration) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body)) (available (traced-euler-step traced-euler-step-with-force traced-euler-step-explicit)) (answer "(define (traced-verlet-step body compute-accel dt) (if (traced-body-static? body) body (call-with-values (lambda () (compute-accel body)) (lambda (accel-n torque-n) (let* ((half-vel (traced-vec2-add (traced-body-vel body) (traced-vec2-scale accel-n (* 0.5 dt)))) (half-omega (traced-add (traced-body-angular-vel body) (traced-mul torque-n (* 0.5 dt)))) (new-pos (traced-vec2-add (traced-body-pos body) (traced-vec2-add (traced-vec2-scale (traced-body-vel body) dt) (traced-vec2-scale accel-n (* 0.5 dt dt))))) (new-angle (traced-add (traced-body-angle body) (traced-add (traced-mul (traced-body-angular-vel body) dt) (traced-mul torque-n (* 0.5 dt dt))))) (temp-body (traced-body-with-state body new-pos half-vel new-angle half-omega))) (call-with-values (lambda () (compute-accel temp-body)) (lambda (accel-n1 torque-n1) (let* ((new-vel (traced-vec2-add (traced-body-vel body) (traced-vec2-scale (traced-vec2-add accel-n accel-n1) (* 0.5 dt)))) (new-omega (traced-add (traced-body-angular-vel body) (traced-mul (traced-add torque-n torque-n1) (* 0.5 dt))))) (traced-body-with-state body new-pos new-vel new-angle new-omega)))))))))"))
(task-entry (id "physics/diff/diff-collision/traced-ground-collision-step") (skill physics/diff) (module diff-collision) (tier 2) (difficulty 23103) (name traced-ground-collision-step) (type "") (description "") (notes ()) (section circle-circle-collision-response) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body \x27;smooth-collision)) (available (traced-circle-collision-force traced-circle-collision-impulses traced-ground-collision-force)) (answer "(define (traced-ground-collision-step body radius ground-y mat dt) (call-with-values (lambda () (traced-ground-collision-force body radius ground-y mat)) (lambda (force torque) (traced-apply-central-force (traced-apply-torque body torque dt) force dt))))"))
(task-entry (id "physics/diff/smooth-collision/traced-sdf-capsule") (skill physics/diff) (module smooth-collision) (tier 2) (difficulty 23103) (name traced-sdf-capsule) (type "") (description "") (notes ()) (section signed-distance-functions) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2)) (available (traced-sdf-circle traced-sdf-point traced-sdf-box)) (answer "(define (traced-sdf-capsule point a b radius) (let* ((pa (traced-vec2-sub point a)) (ba (traced-vec2-sub b a)) (ba-len-sq (traced-vec2-magnitude-sq ba)) (t-raw (traced-div (traced-vec2-dot pa ba) ba-len-sq)) (t (traced-smooth-clamp t-raw 0 1 20)) (closest (traced-vec2-add a (traced-vec2-scale ba t))) (dist (traced-vec2-smooth-distance point closest 1e-8))) (traced-sub dist radius)))"))
