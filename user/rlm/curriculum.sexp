(task-entry (id "autodiff/differentiable-signal/make-dft-re-local-grads") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12710) (name make-dft-re-local-grads) (type "(-> Int Int (List Number))") (description "") (notes ()) (section traced-dft) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real)) (answer "(define (make-dft-re-local-grads n k) (let ((result (make-vector n)) (two-pi (* 2 (pi-value)))) (do ((m 0 (+ m 1))) ((= m n) (vector->list result)) (vector-set! result m (cos (/ (* -1 two-pi k m) n))))))"))
