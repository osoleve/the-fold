(task-entry (id "dataset/sample/sample->sexp") (skill dataset) (module sample) (tier 1) (difficulty 13432) (name sample->sexp) (type "") (description "") (notes ()) (section rendering) (deps (\x27;prelude \x27;optics \x27;parameter)) (available (make-sample sample? sample-id sample-frames sample-question sample-options sample-answer sample-metadata sample-id-lens sample-frames-lens sample-question-lens sample-options-lens sample-answer-lens sample-metadata-lens sample-category sample-difficulty sample-params sample-with-meta make-qa-lens qa-lens? qa-lens-question qa-lens-answer qa-extract-question qa-extract-answer make-option option-label option-text make-options option-by-label fisher-yates-shuffle shuffle-options sample->prompt)) (answer "(define (sample->sexp s) (quasiquote (sample (id (unquote (sample-id s))) (frames (unquote-splicing (sample-frames s))) (question (unquote (sample-question s))) (options (unquote-splicing (map (lambda (o) (list (car o) (cdr o))) (sample-options s)))) (answer (unquote (sample-answer s))) (metadata (unquote-splicing (sample-metadata s))))))"))
(task-entry (id "dataset/parameter/param-perturb") (skill dataset) (module parameter) (tier 1) (difficulty 13432) (name param-perturb) (type "") (description "") (notes ()) (section perturbation) (deps (\x27;prelude \x27;prng \x27;distributions)) (available (make-prng prng-next-float prng-next-int make-param-range param-range? param-range-name param-range-min param-range-max param-range-strategy param-range-constraint uniform-range range-int range-normal range-choice param-range-choice? param-range-choice-name param-range-choice-values param-range-choice-constraint range-with-constraint param-sample-raw sample-normal param-sample param-sample-default make-param-set param-set? param-set-ranges param-set-joint-constraint param-set-sample-raw param-set-sample param-get param-interpolate params-interpolate)) (answer "(define (param-perturb r val epsilon rng) (cond ((param-range? r) (let* ((min-v (param-range-min r)) (max-v (param-range-max r)) (range (- max-v min-v)) (delta (* range epsilon (- (* 2 (prng-next-float rng)) 1))) (result (+ val delta))) (max min-v (min max-v result)))) ((param-range-choice? r) (let* ((choices (param-range-choice-values r)) (others (filter (lambda (c) (not (equal? c val))) choices))) (if (null? others) val (list-ref others (prng-next-int rng (length others)))))) (else val)))"))
