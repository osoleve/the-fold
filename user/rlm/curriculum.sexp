(task-entry (id "data/sort/sort-by-key") (skill data) (module sort) (tier 0) (difficulty 1314) (name sort-by-key) (type "(-> (-> α β) (List α) (List α))") (description "Sort list by a key function (Schwartzian transform)") (notes ("Uses merge sort internally for stability" "(sort-by-key string-length '(\"aaa\" \"b\" \"cc\")) => (\"b\" \"cc\" \"aaa\")")) (section sort-by-key) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort)) (answer "(define (sort-by-key key-fn lst) (let* ((decorated (map (lambda (x) (cons (key-fn x) x)) lst)) (sorted (merge-sort-by (lambda (a b) (< (car a) (car b))) decorated))) (map cdr sorted)))"))
(task-entry (id "data/heap/heap-pop") (skill data) (module heap) (tier 0) (difficulty 1314) (name heap-pop) (type "(-> Heap (Values Heap α))") (description "Remove and return minimum element. Returns (new-heap, min-element). Error if heap is empty.") (notes ()) (section min-heap-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge heap-insert heap-min heap-peek heap-delete-min)) (answer "(define (heap-pop heap) (if (heap-empty? heap) (error 'heap-pop \"Cannot pop from empty heap\") (values (heap-merge (heap-left heap) (heap-right heap)) (heap-value heap))))"))
