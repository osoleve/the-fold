(task-entry (id "algebra/tropical/trim-hull") (skill algebra) (module tropical) (tier 0) (difficulty 321) (name trim-hull) (type "") (description "") (notes ()) (section tropical-polynomials) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add tropical-matrix-power tropical-matrix-closure tropical-eigenvalue tropical-critical-edges tropical-poly-eval newton-polygon)) (answer "(define (trim-hull hull p) (if (< (length hull) 2) (cons p hull) (let* ((b (car hull)) (a (cadr hull)) (cross (- (* (- (car b) (car a)) (- (cdr p) (cdr a))) (* (- (cdr b) (cdr a)) (- (car p) (car a)))))) (if (<= cross 0) (trim-hull (cdr hull) p) (cons p hull)))))"))
(task-entry (id "algebra/group/permutation-compose") (skill algebra) (module group) (tier 0) (difficulty 322) (name permutation-compose) (type "(-> Permutation Permutation Permutation)") (description "Compose two permutations: (σ ∘ τ)(i) = σ(τ(i))") (notes ()) (section permutation-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply)) (answer "(define (permutation-compose sigma tau) (map (lambda (i) (permutation-apply sigma (permutation-apply tau i))) (iota (length sigma))))"))
(task-entry (id "algebra/ring/is-unit?") (skill algebra) (module ring) (tier 0) (difficulty 322) (name is-unit?) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product is-commutative-ring? is-zero-divisor? has-zero-divisors? is-integral-domain?)) (answer "(define (is-unit? r a) (let ((elems (ring-elements r)) (one (ring-one r))) (let loop ((bs elems)) (if (null? bs) #f (if (ring-equal? r (ring-mul r a (car bs)) one) #t (loop (cdr bs)))))))"))
