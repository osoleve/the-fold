(task-entry (id "fp/protocol-introspect/protocol-stats") (skill fp) (module protocol-introspect) (tier 1) (difficulty 10624) (name protocol-stats) (type "(-> (List (Symbol . Number)))") (description "Statistics about registered protocols and types") (notes ()) (section statistics) (deps (\x27;protocol)) (available (*protocol-docs* make-protocol-doc protocol-doc? protocol-doc-name protocol-doc-docstring protocol-doc-signature protocol-doc-module register-protocol-doc! get-protocol-doc protocol-docstring protocols-for-type all-type-tags protocol-describe type-describe truncate-string protocol-matrix build-matrix-string build-header build-row pad-right symbol-length truncate-symbol protocol-graph format-impl-tree)) (answer "(define (protocol-stats) (let* ((protos (list-protocols)) (types (all-type-tags)) (impl-counts (map (lambda (p) (length (protocol-implementations p))) protos)) (total-impls (if (null? impl-counts) 0 (apply + impl-counts))) (proto-per-type (map (lambda (t) (length (protocols-for-type t))) types))) (quasiquote ((protocols unquote (length protos)) (types unquote (length types)) (total-implementations unquote total-impls) (avg-impls-per-protocol unquote (if (null? protos) 0 (/ total-impls (length protos)))) (avg-protos-per-type unquote (if (null? types) 0 (/ total-impls (length types))))))))"))
