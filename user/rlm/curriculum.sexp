(task-entry (id "sim/stability/find-fixed-point-robust") (skill sim) (module stability) (tier 2) (difficulty 23301) (name find-fixed-point-robust) (type "(-> Any Any Number Number Nat Any)") (description "Find a fixed point using Newton's method with pseudoinverse for robustness near singularities") (notes ("Uses Moore-Penrose pseudoinverse via SVD, which handles singular/near-singular Jacobians that occur at bifurcation points")) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton)) (answer "(define (find-fixed-point-robust sys initial-guess tolerance step-size max-iter) (let loop ((x initial-guess) (iter 0)) (if (>= iter max-iter) #f (let* ((fx (eval-vector-field sys 0 x)) (norm-fx (vec-norm fx))) (if (< norm-fx tolerance) x (let* ((jac (compute-jacobian sys x step-size)) (jac-pinv (pseudoinverse jac))) (if (and (pair? jac-pinv) (eq? (car jac-pinv) 'error)) #f (let* ((delta (matrix-vec-mul jac-pinv fx)) (x-new (vec-sub x delta))) (loop x-new (+ iter 1))))))))))"))
(task-entry (id "sim/chaos/integrate-rk4") (skill sim) (module chaos) (tier 2) (difficulty 23301) (name integrate-rk4) (type "(-> ODE Number Vec Number Nat (List Vec))") (description "Integrate ODE system using RK4, returning trajectory as list of states") (notes ()) (section rk4-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step)) (answer "(define (integrate-rk4 sys t0 state0 dt n) (let loop ((t t0) (state state0) (i 0) (result (list state0))) (if (>= i n) (reverse result) (let ((new-state (rk4-step sys t state dt))) (loop (+ t dt) new-state (+ i 1) (cons new-state result))))))"))
(task-entry (id "sim/bifurcation/every") (skill sim) (module bifurcation) (tier 2) (difficulty 23301) (name every) (type "(-> (-> α Boolean) (List α) Boolean)") (description "Return #t if pred is true for every element") (notes ()) (section utilities) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any)) (answer "(define (every pred lst) (cond ((null? lst) #t) ((not (pred (car lst))) #f) (else (every pred (cdr lst)))))"))
(task-entry (id "sim/attractor-render/intensity->attractor-char") (skill sim) (module attractor-render) (tier 2) (difficulty 23301) (name intensity->attractor-char) (type "(-> Number Char)") (description "Map intensity [0,1] to ASCII character from extended ramp") (notes ()) (section point-cloud-rendering) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp)) (answer "(define (intensity->attractor-char intensity) (let* ((ramp-len (string-length attractor-ascii-ramp)) (idx (min (- ramp-len 1) (max 0 (inexact->exact (floor (* intensity ramp-len))))))) (string-ref attractor-ascii-ramp idx)))"))
(task-entry (id "sim/simulation-stream/sim-state-time") (skill sim) (module simulation-stream) (tier 2) (difficulty 23302) (name sim-state-time) (type "(-> SimState Number)") (description "") (notes ()) (section core-simulation-stream-types) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state?)) (answer "(define (sim-state-time s) (list-ref s 1))"))
(task-entry (id "sim/ode-system/ode-dimension") (skill sim) (module ode-system) (tier 2) (difficulty 23302) (name ode-dimension) (type "(-> Any Nat)") (description "") (notes ()) (section ode-system-representation) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field)) (answer "(define (ode-dimension sys) (caddr sys))"))
(task-entry (id "sim/stability/find-fixed-point-levenberg-marquardt") (skill sim) (module stability) (tier 2) (difficulty 23302) (name find-fixed-point-levenberg-marquardt) (type "(-> Any Any Number Number Nat Any)") (description "Find a fixed point using Levenberg-Marquardt algorithm for robust convergence") (notes ("Levenberg-Marquardt interpolates between Newton and gradient descent. The damping parameter λ makes (J^T J + λI) invertible even when J is singular.")) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust)) (answer "(define (find-fixed-point-levenberg-marquardt sys initial-guess tolerance step-size max-iter) (let ((lambda-init 0.001) (lambda-up 10.0) (lambda-down 0.1)) (let loop ((x initial-guess) (lambda lambda-init) (iter 0)) (if (>= iter max-iter) #f (let* ((fx (eval-vector-field sys 0 x)) (norm-fx (vec-norm fx))) (if (< norm-fx tolerance) x (let* ((jac (compute-jacobian sys x step-size)) (jt (matrix-transpose jac)) (jtj (matrix-mul jt jac)) (n (matrix-rows jtj)) (jtj-damped (matrix-add-diagonal jtj lambda)) (jtf (matrix-vec-mul jt fx)) (delta (solve-linear-system jtj-damped jtf))) (if (not delta) #f (let* ((x-new (vec-sub x delta)) (fx-new (eval-vector-field sys 0 x-new)) (norm-fx-new (vec-norm fx-new))) (if (< norm-fx-new norm-fx) (loop x-new (* lambda lambda-down) (+ iter 1)) (loop x (* lambda lambda-up) (+ iter 1))))))))))))"))
(task-entry (id "sim/chaos/integrate-rk4-transient") (skill sim) (module chaos) (tier 2) (difficulty 23302) (name integrate-rk4-transient) (type "(-> ODE Number Vec Number Nat Nat (List Vec))") (description "Integrate with transient removal: skip first n-transient steps, keep n-keep") (notes ()) (section rk4-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4)) (answer "(define (integrate-rk4-transient sys t0 state0 dt n-transient n-keep) (let loop-transient ((t t0) (state state0) (i 0)) (if (>= i n-transient) (let loop-collect ((t t) (state state) (j 0) (result '())) (if (>= j n-keep) (reverse result) (let ((new-state (rk4-step sys t state dt))) (loop-collect (+ t dt) new-state (+ j 1) (cons new-state result))))) (let ((new-state (rk4-step sys t state dt))) (loop-transient (+ t dt) new-state (+ i 1))))))"))
(task-entry (id "sim/bifurcation/analyze-stability-1d") (skill sim) (module bifurcation) (tier 2) (difficulty 23302) (name analyze-stability-1d) (type "(-> ODE Vec Number (Pair Symbol (List Complex)))") (description "Analyze stability of a 1D system") (notes ()) (section \x31;d-stability) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every)) (answer "(define (analyze-stability-1d sys equilibrium step-size) (let* ((jac (compute-jacobian sys equilibrium step-size)) (eigenvalue (vector-ref (matrix-data jac) 0)) (complex-eig (make-complex eigenvalue 0))) (cons (cond ((< eigenvalue -1e-10) 'stable-node) ((> eigenvalue 1e-10) 'unstable-node) (else 'degenerate)) (list complex-eig))))"))
(task-entry (id "sim/attractor-render/rotate-x") (skill sim) (module attractor-render) (tier 2) (difficulty 23302) (name rotate-x) (type "(-> Vec Number Vec)") (description "Rotate point around X axis") (notes ()) (section rotation) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char)) (answer "(define (rotate-x point angle) (let* ((y (vector-ref point 1)) (z (vector-ref point 2)) (cos-a (cos angle)) (sin-a (sin angle))) (vector (vector-ref point 0) (- (* y cos-a) (* z sin-a)) (+ (* y sin-a) (* z cos-a)))))"))
(task-entry (id "sim/simulation-stream/sim-state-data") (skill sim) (module simulation-stream) (tier 2) (difficulty 23303) (name sim-state-data) (type "(-> SimState Any)") (description "") (notes ()) (section core-simulation-stream-types) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time)) (answer "(define (sim-state-data s) (list-ref s 2))"))
(task-entry (id "sim/ode-system/ode-autonomous?") (skill sim) (module ode-system) (tier 2) (difficulty 23303) (name ode-autonomous?) (type "(-> Any Bool)") (description "") (notes ()) (section ode-system-representation) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension)) (answer "(define (ode-autonomous? sys) (cadddr sys))"))
(task-entry (id "sim/stability/matrix-add-diagonal") (skill sim) (module stability) (tier 2) (difficulty 23303) (name matrix-add-diagonal) (type "(-> Matrix Number Matrix)") (description "Add lambda to diagonal elements: M + λI") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt)) (answer "(define (matrix-add-diagonal m lambda) (let* ((n (matrix-rows m)) (data (vector-copy (matrix-data m)))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! data (+ (* i n) i) (+ (vector-ref data (+ (* i n) i)) lambda))) (list 'matrix n n data)))"))
(task-entry (id "sim/chaos/rossler-system") (skill sim) (module chaos) (tier 2) (difficulty 23303) (name rossler-system) (type "(-> Number Number Number ODE)") (description "Rössler system: a simple chaotic attractor. Classic params: a=0.2, b=0.2, c=5.7") (notes ()) (section strange-attractors) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient)) (answer "(define (rossler-system a b c) (make-autonomous-ode (lambda (state) (let ((x (vector-ref state 0)) (y (vector-ref state 1)) (z (vector-ref state 2))) (vector (- (- y) z) (+ x (* a y)) (+ b (* z (- x c)))))) 3))"))
(task-entry (id "sim/bifurcation/analyze-stability-general") (skill sim) (module bifurcation) (tier 2) (difficulty 23303) (name analyze-stability-general) (type "(-> ODE Vec Number (Pair Symbol (List Complex)))") (description "Analyze stability handling both 1D and 2D systems") (notes ()) (section \x31;d-stability) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d)) (answer "(define (analyze-stability-general sys equilibrium step-size) (let ((dim (ode-dimension sys))) (cond ((= dim 1) (analyze-stability-1d sys equilibrium step-size)) ((= dim 2) (analyze-stability sys equilibrium step-size)) (else (analyze-stability-nd sys equilibrium step-size)))))"))
(task-entry (id "sim/attractor-render/rotate-y") (skill sim) (module attractor-render) (tier 2) (difficulty 23303) (name rotate-y) (type "(-> Vec Number Vec)") (description "Rotate point around Y axis") (notes ()) (section rotation) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x)) (answer "(define (rotate-y point angle) (let* ((x (vector-ref point 0)) (z (vector-ref point 2)) (cos-a (cos angle)) (sin-a (sin angle))) (vector (+ (* x cos-a) (* z sin-a)) (vector-ref point 1) (+ (* (- x) sin-a) (* z cos-a)))))"))
(task-entry (id "sim/simulation-stream/sim-state-metadata") (skill sim) (module simulation-stream) (tier 2) (difficulty 23304) (name sim-state-metadata) (type "(-> SimState Any)") (description "") (notes ()) (section core-simulation-stream-types) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data)) (answer "(define (sim-state-metadata s) (list-ref s 3))"))
(task-entry (id "sim/ode-system/make-ode-system") (skill sim) (module ode-system) (tier 2) (difficulty 23304) (name make-ode-system) (type "(-> (-> Number Any Any) Nat Bool Any)") (description "Create an ODE system with explicit autonomy flag") (notes ()) (section ode-system-representation) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous?)) (answer "(define (make-ode-system vector-field dimension autonomous?) (list 'ode-system vector-field dimension autonomous?))"))
(task-entry (id "sim/stability/solve-linear-system") (skill sim) (module stability) (tier 2) (difficulty 23304) (name solve-linear-system) (type "(-> Matrix Vec (Option Vec))") (description "Solve Ax = b using LU decomposition with partial pivoting") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal)) (answer "(define (solve-linear-system a b) (let* ((n (matrix-rows a)) (aug (augment-matrix a b))) (gaussian-eliminate-with-pivot aug n)))"))
(task-entry (id "sim/chaos/chen-system") (skill sim) (module chaos) (tier 2) (difficulty 23304) (name chen-system) (type "(-> Number Number Number ODE)") (description "Chen system: another chaotic attractor. Classic params: a=40, b=3, c=28") (notes ()) (section strange-attractors) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system)) (answer "(define (chen-system a b c) (make-autonomous-ode (lambda (state) (let ((x (vector-ref state 0)) (y (vector-ref state 1)) (z (vector-ref state 2))) (vector (* a (- y x)) (+ (* (- c a) x) (* c y) (- (* x z))) (- (* x y) (* b z))))) 3))"))
(task-entry (id "sim/bifurcation/make-parameterized-ode") (skill sim) (module bifurcation) (tier 2) (difficulty 23304) (name make-parameterized-ode) (type "(-> (-> Number ODE) ParamODE)") (description "Create a parameterized ODE system from a constructor function") (notes ()) (section parameterized-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general)) (answer "(define (make-parameterized-ode make-sys) (list 'param-ode make-sys))"))
(task-entry (id "sim/attractor-render/rotate-z") (skill sim) (module attractor-render) (tier 2) (difficulty 23304) (name rotate-z) (type "(-> Vec Number Vec)") (description "Rotate point around Z axis") (notes ()) (section rotation) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y)) (answer "(define (rotate-z point angle) (let* ((x (vector-ref point 0)) (y (vector-ref point 1)) (cos-a (cos angle)) (sin-a (sin angle))) (vector (- (* x cos-a) (* y sin-a)) (+ (* x sin-a) (* y cos-a)) (vector-ref point 2))))"))
(task-entry (id "sim/simulation-stream/sim-state-with-time") (skill sim) (module simulation-stream) (tier 2) (difficulty 23305) (name sim-state-with-time) (type "(-> SimState Number SimState)") (description "") (notes ()) (section core-simulation-stream-types) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata)) (answer "(define (sim-state-with-time s new-time) (make-sim-state new-time (sim-state-data s) (sim-state-metadata s)))"))
(task-entry (id "sim/ode-system/make-autonomous-ode") (skill sim) (module ode-system) (tier 2) (difficulty 23305) (name make-autonomous-ode) (type "(-> (-> Any Any) Nat Any)") (description "Create an autonomous ODE system: dx/dt = f(x). Wraps the vector field to accept (but ignore) time parameter") (notes ()) (section ode-system-representation) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system)) (answer "(define (make-autonomous-ode vector-field dimension) (make-ode-system (lambda (t state) (vector-field state)) dimension #t))"))
(task-entry (id "sim/stability/augment-matrix") (skill sim) (module stability) (tier 2) (difficulty 23305) (name augment-matrix) (type "(-> Matrix Vec Matrix)") (description "Create augmented matrix [A|b]") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system)) (answer "(define (augment-matrix a b) (let* ((n (matrix-rows a)) (data (make-vector (* n (+ n 1)) 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! data (+ (* i (+ n 1)) j) (matrix-ref a i j))) (vector-set! data (+ (* i (+ n 1)) n) (vector-ref b i))) (list 'matrix n (+ n 1) data)))"))
(task-entry (id "sim/chaos/chua-circuit") (skill sim) (module chaos) (tier 2) (difficulty 23305) (name chua-circuit) (type "(-> Number Number Number Number ODE)") (description "Chua's circuit: electronic chaos. Classic: alpha=15.6, beta=28, m0=-1.143, m1=-0.714") (notes ()) (section strange-attractors) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system)) (answer "(define (chua-circuit alpha beta m0 m1) (make-autonomous-ode (lambda (state) (let* ((x (vector-ref state 0)) (y (vector-ref state 1)) (z (vector-ref state 2)) (h (+ (* m1 x) (* 0.5 (- m0 m1) (- (abs (+ x 1)) (abs (- x 1))))))) (vector (* alpha (- y x h)) (+ (- x y) z) (* (- beta) y)))) 3))"))
(task-entry (id "sim/bifurcation/param-ode?") (skill sim) (module bifurcation) (tier 2) (difficulty 23305) (name param-ode?) (type "(-> Any Boolean)") (description "") (notes ()) (section parameterized-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode)) (answer "(define (param-ode? x) (and (pair? x) (eq? (car x) 'param-ode)))"))
(task-entry (id "sim/attractor-render/rotate-point") (skill sim) (module attractor-render) (tier 2) (difficulty 23305) (name rotate-point) (type "(-> Vec Number Number Number Vec)") (description "Apply X, Y, Z rotations in sequence") (notes ()) (section rotation) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z)) (answer "(define (rotate-point point angle-x angle-y angle-z) (rotate-z (rotate-y (rotate-x point angle-x) angle-y) angle-z))"))
(task-entry (id "sim/simulation-stream/sim-state-with-data") (skill sim) (module simulation-stream) (tier 2) (difficulty 23306) (name sim-state-with-data) (type "(-> SimState Any SimState)") (description "") (notes ()) (section core-simulation-stream-types) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time)) (answer "(define (sim-state-with-data s new-data) (make-sim-state (sim-state-time s) new-data (sim-state-metadata s)))"))
(task-entry (id "sim/ode-system/make-nonautonomous-ode") (skill sim) (module ode-system) (tier 2) (difficulty 23306) (name make-nonautonomous-ode) (type "(-> (-> Number Any Any) Nat Any)") (description "Create a non-autonomous ODE system: dx/dt = f(t, x)") (notes ()) (section ode-system-representation) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode)) (answer "(define (make-nonautonomous-ode vector-field dimension) (make-ode-system vector-field dimension #f))"))
(task-entry (id "sim/stability/gaussian-eliminate-with-pivot") (skill sim) (module stability) (tier 2) (difficulty 23306) (name gaussian-eliminate-with-pivot) (type "(-> Matrix Nat (Option Vec))") (description "Gaussian elimination with partial pivoting") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix)) (answer "(define (gaussian-eliminate-with-pivot aug n) (let ((data (vector-copy (matrix-data aug))) (nc (+ n 1))) (let elim-loop ((k 0)) (if (= k n) (back-substitute data n nc) (let* ((pivot-row (find-pivot-row data k n nc)) (pivot-val (vector-ref data (+ (* pivot-row nc) k)))) (if (< (abs pivot-val) 1e-12) #f (begin (swap-rows! data k pivot-row nc) (do ((i (+ k 1) (+ i 1))) ((= i n)) (let ((factor (/ (vector-ref data (+ (* i nc) k)) pivot-val))) (do ((j k (+ j 1))) ((= j nc)) (vector-set! data (+ (* i nc) j) (- (vector-ref data (+ (* i nc) j)) (* factor (vector-ref data (+ (* k nc) j)))))))) (elim-loop (+ k 1)))))))))"))
(task-entry (id "sim/chaos/thomas-attractor") (skill sim) (module chaos) (tier 2) (difficulty 23306) (name thomas-attractor) (type "(-> Number ODE)") (description "Thomas' cyclically symmetric attractor. Classic: b=0.208186") (notes ()) (section strange-attractors) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit)) (answer "(define (thomas-attractor b) (make-autonomous-ode (lambda (state) (let ((x (vector-ref state 0)) (y (vector-ref state 1)) (z (vector-ref state 2))) (vector (- (sin y) (* b x)) (- (sin z) (* b y)) (- (sin x) (* b z))))) 3))"))
(task-entry (id "sim/bifurcation/param-ode-maker") (skill sim) (module bifurcation) (tier 2) (difficulty 23306) (name param-ode-maker) (type "(-> ParamODE (-> Number ODE))") (description "") (notes ()) (section parameterized-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode?)) (answer "(define (param-ode-maker psys) (cadr psys))"))
(task-entry (id "sim/attractor-render/project-orthographic") (skill sim) (module attractor-render) (tier 2) (difficulty 23306) (name project-orthographic) (type "(-> Vec Number (Values Number Number Number))") (description "Orthographic projection: returns (x, y, depth)") (notes ()) (section projection) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point)) (answer "(define (project-orthographic point scale) (values (* scale (vector-ref point 0)) (* scale (vector-ref point 1)) (vector-ref point 2)))"))
(task-entry (id "sim/simulation-stream/sim-unfold") (skill sim) (module simulation-stream) (tier 2) (difficulty 23307) (name sim-unfold) (type "(-> (-> seed (U (Pair value seed) #f)) seed (Stream value))") (description "Build a stream from a step function that may terminate. Step function returns (value . new-seed) to continue, or #f to stop") (notes ()) (section generalized-unfold) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data)) (answer "(define (sim-unfold step seed) (let ((result (step seed))) (if (not result) stream-nil (stream-cons (car result) (lambda () (sim-unfold step (cdr result)))))))"))
(task-entry (id "sim/ode-system/eval-vector-field") (skill sim) (module ode-system) (tier 2) (difficulty 23307) (name eval-vector-field) (type "(-> Any Number Any Any)") (description "Evaluate the vector field at a given time and state") (notes ()) (section vector-field-evaluation) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode)) (answer "(define (eval-vector-field sys t state) ((ode-vector-field sys) t state))"))
(task-entry (id "sim/stability/find-pivot-row") (skill sim) (module stability) (tier 2) (difficulty 23307) (name find-pivot-row) (type "(-> Vector Nat Nat Nat Nat)") (description "") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot)) (answer "(define (find-pivot-row data k n nc) (let loop ((i k) (best-row k) (best-val (abs (vector-ref data (+ (* k nc) k))))) (if (= i n) best-row (let ((val (abs (vector-ref data (+ (* i nc) k))))) (if (> val best-val) (loop (+ i 1) i val) (loop (+ i 1) best-row best-val))))))"))
(task-entry (id "sim/chaos/aizawa-system") (skill sim) (module chaos) (tier 2) (difficulty 23307) (name aizawa-system) (type "(-> Number Number Number Number Number Number ODE)") (description "Aizawa attractor. Classic: a=0.95, b=0.7, c=0.6, d=3.5, e=0.25, f=0.1") (notes ()) (section strange-attractors) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor)) (answer "(define (aizawa-system a b c d e f) (make-autonomous-ode (lambda (state) (let ((x (vector-ref state 0)) (y (vector-ref state 1)) (z (vector-ref state 2))) (vector (- (* (- z b) x) (* d y)) (+ (* d x) (* (- z b) y)) (+ c (* a z) (- (/ (* z z z) 3)) (- (* (+ (* x x) (* y y)) (+ 1 (* e z)))) (* f z (* x x x)))))) 3))"))
(task-entry (id "sim/bifurcation/instantiate-at") (skill sim) (module bifurcation) (tier 2) (difficulty 23307) (name instantiate-at) (type "(-> ParamODE Number ODE)") (description "Instantiate a parameterized ODE at a specific parameter value") (notes ()) (section parameterized-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker)) (answer "(define (instantiate-at psys param) ((param-ode-maker psys) param))"))
(task-entry (id "sim/attractor-render/project-perspective") (skill sim) (module attractor-render) (tier 2) (difficulty 23307) (name project-perspective) (type "(-> Vec Number Number (Values Number Number Number))") (description "Perspective projection with camera at (0, 0, -distance)") (notes ()) (section projection) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic)) (answer "(define (project-perspective point fov distance) (let* ((z (+ (vector-ref point 2) distance)) (factor (if (> z 0.1) (/ fov z) fov))) (values (* factor (vector-ref point 0)) (* factor (vector-ref point 1)) (vector-ref point 2))))"))
(task-entry (id "sim/simulation-stream/sim-unfold-infinite") (skill sim) (module simulation-stream) (tier 2) (difficulty 23308) (name sim-unfold-infinite) (type "(-> (-> seed (Pair value seed)) seed (Stream value))") (description "Build an infinite stream from a step function. Step function always returns (value . new-seed)") (notes ()) (section generalized-unfold) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold)) (answer "(define (sim-unfold-infinite step seed) (let ((result (step seed))) (stream-cons (car result) (lambda () (sim-unfold-infinite step (cdr result))))))"))
(task-entry (id "sim/ode-system/eval-vector-field-batch") (skill sim) (module ode-system) (tier 2) (difficulty 23308) (name eval-vector-field-batch) (type "(-> Any Number (List Any) (List Any))") (description "Evaluate the vector field at multiple states at the same time. Useful for phase portrait computation") (notes ()) (section vector-field-evaluation) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field)) (answer "(define (eval-vector-field-batch sys t states) (map (lambda (state) (eval-vector-field sys t state)) states))"))
(task-entry (id "sim/stability/swap-rows!") (skill sim) (module stability) (tier 2) (difficulty 23308) (name swap-rows!) (type "(-> Vector Nat Nat Nat Void)") (description "") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row)) (answer "(define (swap-rows! data row1 row2 nc) (unless (= row1 row2) (do ((j 0 (+ j 1))) ((= j nc)) (let ((temp (vector-ref data (+ (* row1 nc) j)))) (vector-set! data (+ (* row1 nc) j) (vector-ref data (+ (* row2 nc) j))) (vector-set! data (+ (* row2 nc) j) temp)))))"))
(task-entry (id "sim/chaos/*min-norm*") (skill sim) (module chaos) (tier 2) (difficulty 23308) (name *min-norm*) (type "") (description "Minimum norm threshold to prevent division by zero") (notes ()) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system)) (answer "(define *min-norm* 1e-10)"))
(task-entry (id "sim/bifurcation/*continuation-tolerance*") (skill sim) (module bifurcation) (tier 2) (difficulty 23308) (name *continuation-tolerance*) (type "") (description "") (notes ()) (section fixed-point-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at)) (answer "(define *continuation-tolerance* 1e-8)"))
(task-entry (id "sim/attractor-render/make-frame-buffer") (skill sim) (module attractor-render) (tier 2) (difficulty 23308) (name make-frame-buffer) (type "(-> Nat Nat FrameBuffer)") (description "Create empty frame buffer with char and depth channels") (notes ()) (section frame-buffer) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective)) (answer "(define (make-frame-buffer width height) (list 'frame-buffer width height (make-vector (* width height) #\\ ) (make-vector (* width height) -inf.0)))"))
(task-entry (id "sim/simulation-stream/sim-unfold-with-state") (skill sim) (module simulation-stream) (tier 2) (difficulty 23309) (name sim-unfold-with-state) (type "(-> (-> s s) s (Stream s))") (description "Unfold producing the state itself at each step. Equivalent to stream-iterate but named for simulation context") (notes ()) (section generalized-unfold) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite)) (answer "(define (sim-unfold-with-state step seed) (stream-cons seed (lambda () (sim-unfold-with-state step (step seed)))))"))
(task-entry (id "sim/ode-system/make-flow-function") (skill sim) (module ode-system) (tier 2) (difficulty 23309) (name make-flow-function) (type "(-> Any (-> Number Number Any Any))") (description "Create a flow function φ(t, t0, x0) that represents the solution at time t starting from state x0 at time t0") (notes ("This is a symbolic/lazy representation - actual computation requires a numerical integrator")) (section flow-and-trajectory) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch)) (answer "(define (make-flow-function sys) (lambda (t t0 x0) (quasiquote (flow (unquote sys) (unquote t) (unquote t0) (unquote x0)))))"))
(task-entry (id "sim/stability/back-substitute") (skill sim) (module stability) (tier 2) (difficulty 23309) (name back-substitute) (type "(-> Vector Nat Nat Vec)") (description "") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows!)) (answer "(define (back-substitute data n nc) (let ((x (make-vector n 0))) (let loop ((i (- n 1))) (if (< i 0) x (let ((sum 0)) (do ((j (+ i 1) (+ j 1))) ((= j n)) (set! sum (+ sum (* (vector-ref data (+ (* i nc) j)) (vector-ref x j))))) (let ((diag (vector-ref data (+ (* i nc) i)))) (if (< (abs diag) 1e-12) #f (begin (vector-set! x i (/ (- (vector-ref data (+ (* i nc) n)) sum) diag)) (loop (- i 1))))))))))"))
(task-entry (id "sim/chaos/*fd-relative-step*") (skill sim) (module chaos) (tier 2) (difficulty 23309) (name *fd-relative-step*) (type "") (description "Relative step size for finite difference Jacobian") (notes ()) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm*)) (answer "(define *fd-relative-step* 1e-6)"))
(task-entry (id "sim/bifurcation/*continuation-step-size*") (skill sim) (module bifurcation) (tier 2) (difficulty 23309) (name *continuation-step-size*) (type "") (description "") (notes ()) (section fixed-point-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance*)) (answer "(define *continuation-step-size* 1e-6)"))
(task-entry (id "sim/attractor-render/fb-width") (skill sim) (module attractor-render) (tier 2) (difficulty 23309) (name fb-width) (type "") (description "") (notes ()) (section frame-buffer) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer)) (answer "(define (fb-width fb) (list-ref fb 1))"))
(task-entry (id "sim/simulation-stream/simulate") (skill sim) (module simulation-stream) (tier 2) (difficulty 23310) (name simulate) (type "(-> SimState (-> SimState SimState) Number (Stream SimState))") (description "Create an infinite stream of simulation states") (notes ()) (section simulation-stream-constructor) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state)) (answer "(define (simulate initial step-fn dt) (let ((stepper (lambda (state) (let* ((new-state (step-fn state)) (new-time (+ (sim-state-time state) dt)) (result (sim-state-with-time new-state new-time))) (cons result result))))) (stream-cons initial (lambda () (sim-unfold-infinite stepper initial)))))"))
(task-entry (id "sim/ode-system/vector-field-norm") (skill sim) (module ode-system) (tier 2) (difficulty 23310) (name vector-field-norm) (type "(-> Any Number Any Number)") (description "Compute the magnitude of the vector field at a point. Useful for identifying equilibrium points (where ||f(x)|| ≈ 0)") (notes ()) (section flow-and-trajectory) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function)) (answer "(define (vector-field-norm sys t state) (let ((field (eval-vector-field sys t state))) (if (vector? field) (vec-norm field) (abs field))))"))
(task-entry (id "sim/stability/is-fixed-point?") (skill sim) (module stability) (tier 2) (difficulty 23310) (name is-fixed-point?) (type "(-> Any Any Number Bool)") (description "Check if a point is a fixed point (equilibrium) within tolerance") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute)) (answer "(define (is-fixed-point? sys point tolerance) (< (vector-field-norm sys 0 point) tolerance))"))
(task-entry (id "sim/chaos/*fd-absolute-step*") (skill sim) (module chaos) (tier 2) (difficulty 23310) (name *fd-absolute-step*) (type "") (description "Absolute minimum step size for finite difference") (notes ()) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step*)) (answer "(define *fd-absolute-step* 1e-8)"))
(task-entry (id "sim/bifurcation/*continuation-max-newton*") (skill sim) (module bifurcation) (tier 2) (difficulty 23310) (name *continuation-max-newton*) (type "") (description "") (notes ()) (section fixed-point-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size*)) (answer "(define *continuation-max-newton* 20)"))
(task-entry (id "sim/attractor-render/fb-height") (skill sim) (module attractor-render) (tier 2) (difficulty 23310) (name fb-height) (type "") (description "") (notes ()) (section frame-buffer) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width)) (answer "(define (fb-height fb) (list-ref fb 2))"))
(task-entry (id "sim/simulation-stream/simulate-with-dt") (skill sim) (module simulation-stream) (tier 2) (difficulty 23311) (name simulate-with-dt) (type "(-> SimState (-> SimState Number SimState) Number (Stream SimState))") (description "Like simulate, but step function also receives dt") (notes ()) (section simulation-stream-constructor) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate)) (answer "(define (simulate-with-dt initial step-fn dt) (let ((stepper (lambda (state) (let* ((new-state (step-fn state dt)) (new-time (+ (sim-state-time state) dt)) (result (sim-state-with-time new-state new-time))) (cons result result))))) (stream-cons initial (lambda () (sim-unfold-infinite stepper initial)))))"))
(task-entry (id "sim/ode-system/make-phase-space-grid") (skill sim) (module ode-system) (tier 2) (difficulty 23311) (name make-phase-space-grid) (type "(-> Number Number Nat Number Number Nat (List Any))") (description "Create a rectangular grid of points in 2D phase space. For higher dimensions, use make-phase-space-grid-nd") (notes ()) (section phase-space-utilities) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm)) (answer "(define (make-phase-space-grid x-min x-max x-steps y-min y-max y-steps) (let ((x-delta (/ (- x-max x-min) (max 1 (- x-steps 1)))) (y-delta (/ (- y-max y-min) (max 1 (- y-steps 1))))) (let loop-y ((j 0) (result '())) (if (>= j y-steps) (reverse result) (let ((y (+ y-min (* j y-delta)))) (loop-y (+ j 1) (let loop-x ((i 0) (row-result result)) (if (>= i x-steps) row-result (let ((x (+ x-min (* i x-delta)))) (loop-x (+ i 1) (cons (vector x y) row-result)))))))))))"))
(task-entry (id "sim/stability/refine-fixed-point") (skill sim) (module stability) (tier 2) (difficulty 23311) (name refine-fixed-point) (type "(-> Any Any Number Number Any)") (description "Refine a fixed point estimate using Newton iteration") (notes ()) (section fixed-point-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point?)) (answer "(define (refine-fixed-point sys point tolerance step-size) (find-fixed-point-newton sys point tolerance step-size 20))"))
(task-entry (id "sim/chaos/finite-diff-step") (skill sim) (module chaos) (tier 2) (difficulty 23311) (name finite-diff-step) (type "(-> Vec Number)") (description "Compute adaptive finite difference step based on state magnitude") (notes ("Scales with state norm to handle both large and small state values")) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step*)) (answer "(define (finite-diff-step state) (let ((state-scale (vec-norm state))) (max *fd-absolute-step* (* *fd-relative-step* (max 1.0 state-scale)))))"))
(task-entry (id "sim/bifurcation/*use-robust-newton*") (skill sim) (module bifurcation) (tier 2) (difficulty 23311) (name *use-robust-newton*) (type "") (description "") (notes ()) (section fixed-point-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton*)) (answer "(define *use-robust-newton* #t)"))
(task-entry (id "sim/attractor-render/fb-chars") (skill sim) (module attractor-render) (tier 2) (difficulty 23311) (name fb-chars) (type "") (description "") (notes ()) (section frame-buffer) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height)) (answer "(define (fb-chars fb) (list-ref fb 3))"))
(task-entry (id "sim/simulation-stream/simulate-varying-dt") (skill sim) (module simulation-stream) (tier 2) (difficulty 23312) (name simulate-varying-dt) (type "(-> SimState (-> SimState Number (Pair SimState Number)) (Stream SimState))") (description "Simulation with variable timestep. Step function returns new state AND next dt") (notes ()) (section simulation-stream-constructor) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt)) (answer "(define (simulate-varying-dt initial step-fn) (letrec ((make-stream (lambda (state dt) (stream-cons state (lambda () (let* ((result (step-fn state dt)) (new-state (car result)) (new-dt (cdr result)) (new-time (+ (sim-state-time state) dt)) (timed-state (sim-state-with-time new-state new-time))) (make-stream timed-state new-dt))))))) (make-stream initial (sim-state-time initial))))"))
(task-entry (id "sim/ode-system/compute-vector-field-grid") (skill sim) (module ode-system) (tier 2) (difficulty 23312) (name compute-vector-field-grid) (type "(-> Any Number (List Any) (List Any))") (description "Compute vector field values at a grid of points") (notes ()) (section phase-space-utilities) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid)) (answer "(define (compute-vector-field-grid sys t grid-points) (map (lambda (point) (eval-vector-field sys t point)) grid-points))"))
(task-entry (id "sim/stability/compute-jacobian") (skill sim) (module stability) (tier 2) (difficulty 23312) (name compute-jacobian) (type "(-> Any Any Number Any)") (description "Compute the Jacobian matrix of a vector field at a point using finite differences for numerical differentiation. For f : R^n → R^n, Jacobian J[i,j] = ∂f_i/∂x_j") (notes ()) (section jacobian-matrix-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point)) (answer "(define (compute-jacobian sys point h) (let* ((n (vector-length point)) (f0 (eval-vector-field sys 0 point)) (jac-data (make-vector (* n n) 0))) (do ((j 0 (+ j 1))) ((= j n)) (let* ((point-plus-h (vec-copy point)) (_ (vector-set! point-plus-h j (+ (vector-ref point j) h))) (f-plus-h (eval-vector-field sys 0 point-plus-h))) (do ((i 0 (+ i 1))) ((= i n)) (let ((df-dxj (/ (- (vector-ref f-plus-h i) (vector-ref f0 i)) h))) (vector-set! jac-data (+ (* i n) j) df-dxj))))) (list 'matrix n n jac-data)))"))
(task-entry (id "sim/chaos/make-tangent-vector") (skill sim) (module chaos) (tier 2) (difficulty 23312) (name make-tangent-vector) (type "(-> Nat Nat Vec)") (description "Create a unit vector along axis 'index' in n-dimensional space") (notes ()) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step)) (answer "(define (make-tangent-vector n index) (let ((v (make-vector n 0.0))) (vector-set! v index 1.0) v))"))
(task-entry (id "sim/bifurcation/find-fixed-point-solver") (skill sim) (module bifurcation) (tier 2) (difficulty 23312) (name find-fixed-point-solver) (type "(-> ODE Vec Number Number Nat (Option Vec))") (description "Find fixed point using configured solver (robust or classic Newton)") (notes ()) (section fixed-point-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton*)) (answer "(define (find-fixed-point-solver sys initial-guess tolerance step-size max-iter) (if *use-robust-newton* (find-fixed-point-robust sys initial-guess tolerance step-size max-iter) (find-fixed-point-newton sys initial-guess tolerance step-size max-iter)))"))
(task-entry (id "sim/attractor-render/fb-depths") (skill sim) (module attractor-render) (tier 2) (difficulty 23312) (name fb-depths) (type "") (description "") (notes ()) (section frame-buffer) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars)) (answer "(define (fb-depths fb) (list-ref fb 4))"))
(task-entry (id "sim/simulation-stream/sim-scan") (skill sim) (module simulation-stream) (tier 2) (difficulty 23313) (name sim-scan) (type "(-> (-> acc value acc) acc (Stream value) (Stream acc))") (description "Running fold over a stream, producing stream of intermediate results. Alias for stream-scan with simulation-specific naming") (notes ()) (section scan-running-fold) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt)) (answer "(define sim-scan stream-scan)"))
(task-entry (id "sim/ode-system/exponential-growth") (skill sim) (module ode-system) (tier 2) (difficulty 23313) (name exponential-growth) (type "(-> Number Any)") (description "Simple exponential growth: dx/dt = r*x. Solution: x(t) = x₀ * exp(r*t)") (notes ()) (section standard-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid)) (answer "(define (exponential-growth r) (make-autonomous-ode (lambda (state) (if (vector? state) (vec-scale r state) (* r state))) 1))"))
(task-entry (id "sim/stability/linearize-at-equilibrium") (skill sim) (module stability) (tier 2) (difficulty 23313) (name linearize-at-equilibrium) (type "(-> Any Any Number Any)") (description "Linearize an ODE system at an equilibrium point") (notes ()) (section jacobian-matrix-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian)) (answer "(define (linearize-at-equilibrium sys equilibrium step-size) (compute-jacobian sys equilibrium step-size))"))
(task-entry (id "sim/chaos/compute-jacobian-at") (skill sim) (module chaos) (tier 2) (difficulty 23313) (name compute-jacobian-at) (type "(-> ODE Number Vec Number Matrix)") (description "Compute Jacobian of vector field at (t, state) using finite differences") (notes ()) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector)) (answer "(define (compute-jacobian-at sys t state h) (let* ((n (vector-length state)) (f0 (eval-vector-field sys t state)) (jac-data (make-vector (* n n) 0.0))) (do ((j 0 (+ j 1))) ((= j n)) (let* ((state-plus-h (vec-copy state)) (_ (vector-set! state-plus-h j (+ (vector-ref state j) h))) (f-plus-h (eval-vector-field sys t state-plus-h))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! jac-data (+ (* i n) j) (/ (- (vector-ref f-plus-h i) (vector-ref f0 i)) h))))) (list 'matrix n n jac-data)))"))
(task-entry (id "sim/bifurcation/continue-fixed-point") (skill sim) (module bifurcation) (tier 2) (difficulty 23313) (name continue-fixed-point) (type "(-> ParamODE Number Vec Number Number (List (List Number Vec Symbol (List Complex))))") (description "Continue a fixed point branch as parameter varies") (notes ()) (section fixed-point-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver)) (answer "(define (continue-fixed-point psys param0 fp0 param-end param-step) (let ((direction (if (> param-end param0) 1 -1)) (step (abs param-step))) (let loop ((param param0) (fp fp0) (results '())) (if (if (> direction 0) (> param param-end) (< param param-end)) (reverse results) (let* ((sys (instantiate-at psys param)) (analysis (analyze-stability-general sys fp *continuation-step-size*)) (stability (car analysis)) (eigenvalues (cdr analysis)) (entry (list param fp stability eigenvalues)) (next-param (+ param (* direction step))) (next-sys (instantiate-at psys next-param)) (next-fp (find-fixed-point-solver next-sys fp *continuation-tolerance* *continuation-step-size* *continuation-max-newton*))) (if next-fp (loop next-param next-fp (cons entry results)) (reverse (cons entry results))))))))"))
(task-entry (id "sim/attractor-render/fb-index") (skill sim) (module attractor-render) (tier 2) (difficulty 23313) (name fb-index) (type "") (description "") (notes ()) (section frame-buffer) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths)) (answer "(define (fb-index fb x y) (+ x (* y (fb-width fb))))"))
(task-entry (id "sim/simulation-stream/sim-scan-map") (skill sim) (module simulation-stream) (tier 2) (difficulty 23314) (name sim-scan-map) (type "(-> (-> acc value acc) acc (-> value mapped) (Stream value) (Stream acc))") (description "Scan with an optional mapping function applied before accumulation") (notes ()) (section scan-running-fold) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan)) (answer "(define (sim-scan-map f init mapper s) (stream-scan f init (stream-map mapper s)))"))
(task-entry (id "sim/ode-system/harmonic-oscillator") (skill sim) (module ode-system) (tier 2) (difficulty 23314) (name harmonic-oscillator) (type "(-> Number Any)") (description "Simple harmonic oscillator: d²x/dt² = -ω²x. As first-order system: dx/dt = v, dv/dt = -ω²x. State: [position, velocity]") (notes ()) (section standard-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth)) (answer "(define (harmonic-oscillator omega) (make-autonomous-ode (lambda (state) (let ((x (vector-ref state 0)) (v (vector-ref state 1))) (vector v (- (* omega omega x))))) 2))"))
(task-entry (id "sim/stability/matrix-invert-simple") (skill sim) (module stability) (tier 2) (difficulty 23314) (name matrix-invert-simple) (type "(-> Any Any)") (description "Simple matrix inversion using Gauss-Jordan elimination. Only works for small matrices - uses simple pivoting") (notes ()) (section matrix-utilities) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium)) (answer "(define (matrix-invert-simple m) (let* ((n (matrix-rows m)) (data (matrix-data m)) (aug (make-vector (* n (* n 2)) 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! aug (+ (* i (* n 2)) j) (vector-ref data (+ (* i n) j)))) (vector-set! aug (+ (* i (* n 2)) (+ n i)) 1.0)) (do ((k 0 (+ k 1))) ((= k n)) (let ((pivot-row k) (pivot-val (abs (vector-ref aug (+ (* k (* n 2)) k))))) (do ((i (+ k 1) (+ i 1))) ((= i n)) (let ((val (abs (vector-ref aug (+ (* i (* n 2)) k))))) (when (> val pivot-val) (set! pivot-row i) (set! pivot-val val)))) (unless (= pivot-row k) (do ((j 0 (+ j 1))) ((= j (* n 2))) (let ((temp (vector-ref aug (+ (* k (* n 2)) j)))) (vector-set! aug (+ (* k (* n 2)) j) (vector-ref aug (+ (* pivot-row (* n 2)) j))) (vector-set! aug (+ (* pivot-row (* n 2)) j) temp)))) (let ((pivot (vector-ref aug (+ (* k (* n 2)) k)))) (when (> (abs pivot) 1e-10) (do ((j 0 (+ j 1))) ((= j (* n 2))) (vector-set! aug (+ (* k (* n 2)) j) (/ (vector-ref aug (+ (* k (* n 2)) j)) pivot))))) (do ((i 0 (+ i 1))) ((= i n)) (unless (= i k) (let ((factor (vector-ref aug (+ (* i (* n 2)) k)))) (do ((j 0 (+ j 1))) ((= j (* n 2))) (vector-set! aug (+ (* i (* n 2)) j) (- (vector-ref aug (+ (* i (* n 2)) j)) (* factor (vector-ref aug (+ (* k (* n 2)) j))))))))))) (let ((inv-data (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! inv-data (+ (* i n) j) (vector-ref aug (+ (* i (* n 2)) (+ n j)))))) (list 'matrix n n inv-data))))"))
(task-entry (id "sim/chaos/rk4-variational-step") (skill sim) (module chaos) (tier 2) (difficulty 23314) (name rk4-variational-step) (type "(-> ODE Number Vec Vec Number (Pair Vec Vec))") (description "Single RK4 step for state and one tangent vector as coupled system") (notes ("Integrates dx/dt = f(x) and dξ/dt = J(x)·ξ together using RK4")) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at)) (answer "(define (rk4-variational-step sys t state tangent dt) (let* ((h (finite-diff-step state)) (k1-state (eval-vector-field sys t state)) (j1 (compute-jacobian-at sys t state h)) (k1-tangent (matrix-vec-mul j1 tangent)) (t-mid (+ t (/ dt 2))) (state-mid1 (vec-add state (vec-scale (/ dt 2) k1-state))) (tangent-mid1 (vec-add tangent (vec-scale (/ dt 2) k1-tangent))) (k2-state (eval-vector-field sys t-mid state-mid1)) (j2 (compute-jacobian-at sys t-mid state-mid1 h)) (k2-tangent (matrix-vec-mul j2 tangent-mid1)) (state-mid2 (vec-add state (vec-scale (/ dt 2) k2-state))) (tangent-mid2 (vec-add tangent (vec-scale (/ dt 2) k2-tangent))) (k3-state (eval-vector-field sys t-mid state-mid2)) (j3 (compute-jacobian-at sys t-mid state-mid2 h)) (k3-tangent (matrix-vec-mul j3 tangent-mid2)) (t-end (+ t dt)) (state-end (vec-add state (vec-scale dt k3-state))) (tangent-end (vec-add tangent (vec-scale dt k3-tangent))) (k4-state (eval-vector-field sys t-end state-end)) (j4 (compute-jacobian-at sys t-end state-end h)) (k4-tangent (matrix-vec-mul j4 tangent-end)) (new-state (vec-add state (vec-scale (/ dt 6) (vec-add k1-state (vec-add (vec-scale 2 k2-state) (vec-add (vec-scale 2 k3-state) k4-state)))))) (new-tangent (vec-add tangent (vec-scale (/ dt 6) (vec-add k1-tangent (vec-add (vec-scale 2 k2-tangent) (vec-add (vec-scale 2 k3-tangent) k4-tangent))))))) (cons new-state new-tangent)))"))
(task-entry (id "sim/bifurcation/*arclength-step*") (skill sim) (module bifurcation) (tier 2) (difficulty 23314) (name *arclength-step*) (type "") (description "") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point)) (answer "(define *arclength-step* 0.1)"))
(task-entry (id "sim/attractor-render/fb-set!") (skill sim) (module attractor-render) (tier 2) (difficulty 23314) (name fb-set!) (type "(-> FrameBuffer Nat Nat Char Number Void)") (description "Set pixel if depth is closer (higher z = closer to camera)") (notes ()) (section frame-buffer) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index)) (answer "(define (fb-set! fb x y char depth) (let* ((w (fb-width fb)) (h (fb-height fb)) (xi (inexact->exact (round x))) (yi (inexact->exact (round y)))) (when (and (>= xi 0) (< xi w) (>= yi 0) (< yi h)) (let ((idx (fb-index fb xi yi)) (depths (fb-depths fb)) (chars (fb-chars fb))) (when (> depth (vector-ref depths idx)) (vector-set! depths idx depth) (vector-set! chars idx char))))))"))
(task-entry (id "sim/simulation-stream/sim-accumulate") (skill sim) (module simulation-stream) (tier 2) (difficulty 23315) (name sim-accumulate) (type "(-> (-> acc SimState acc) acc (Stream SimState) (Stream acc))") (description "Accumulate simulation states into running totals") (notes ()) (section scan-running-fold) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map)) (answer "(define sim-accumulate stream-scan)"))
(task-entry (id "sim/ode-system/damped-oscillator") (skill sim) (module ode-system) (tier 2) (difficulty 23315) (name damped-oscillator) (type "(-> Number Number Any)") (description "Damped harmonic oscillator: d²x/dt² = -2ζω dx/dt - ω²x. State: [position, velocity]") (notes ()) (section standard-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator)) (answer "(define (damped-oscillator omega zeta) (make-autonomous-ode (lambda (state) (let ((x (vector-ref state 0)) (v (vector-ref state 1))) (vector v (- (- (* 2 zeta omega v)) (* omega omega x))))) 2))"))
(task-entry (id "sim/stability/matrix-eigenvalues-2d") (skill sim) (module stability) (tier 2) (difficulty 23315) (name matrix-eigenvalues-2d) (type "(-> Any (List Complex))") (description "Compute eigenvalues of a 2x2 matrix analytically. For A = [[a, b], [c, d]], eigenvalues satisfy: λ² - (a+d)λ + (ad-bc) = 0, λ = (trace ± sqrt(trace² - 4*det)) / 2") (notes ()) (section \x32;x2-eigenvalue-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple)) (answer "(define (matrix-eigenvalues-2d m) (let* ((a (matrix-ref m 0 0)) (b (matrix-ref m 0 1)) (c (matrix-ref m 1 0)) (d (matrix-ref m 1 1)) (trace (+ a d)) (det (- (* a d) (* b c))) (discriminant (- (* trace trace) (* 4 det)))) (if (< discriminant 0) (let ((real-part (/ trace 2)) (imag-part (/ (sqrt (- discriminant)) 2))) (list (make-complex real-part imag-part) (make-complex real-part (- imag-part)))) (let ((sqrt-disc (sqrt discriminant)) (half-trace (/ trace 2))) (list (make-complex (+ half-trace (/ sqrt-disc 2)) 0) (make-complex (- half-trace (/ sqrt-disc 2)) 0))))))"))
(task-entry (id "sim/chaos/rk4-variational-step-multi") (skill sim) (module chaos) (tier 2) (difficulty 23315) (name rk4-variational-step-multi) (type "(-> ODE Number Vec (List Vec) Number (Pair Vec (List Vec)))") (description "Single RK4 step for state and multiple tangent vectors") (notes ("More efficient than calling rk4-variational-step multiple times - shares Jacobian computations")) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step)) (answer "(define (rk4-variational-step-multi sys t state tangents dt) (let* ((h (finite-diff-step state)) (k1-state (eval-vector-field sys t state)) (j1 (compute-jacobian-at sys t state h)) (k1-tangents (map (lambda (tv) (matrix-vec-mul j1 tv)) tangents)) (t-mid (+ t (/ dt 2))) (state-mid1 (vec-add state (vec-scale (/ dt 2) k1-state))) (tangents-mid1 (map (lambda (tv k1t) (vec-add tv (vec-scale (/ dt 2) k1t))) tangents k1-tangents)) (k2-state (eval-vector-field sys t-mid state-mid1)) (j2 (compute-jacobian-at sys t-mid state-mid1 h)) (k2-tangents (map (lambda (tv) (matrix-vec-mul j2 tv)) tangents-mid1)) (state-mid2 (vec-add state (vec-scale (/ dt 2) k2-state))) (tangents-mid2 (map (lambda (tv k2t) (vec-add tv (vec-scale (/ dt 2) k2t))) tangents k2-tangents)) (k3-state (eval-vector-field sys t-mid state-mid2)) (j3 (compute-jacobian-at sys t-mid state-mid2 h)) (k3-tangents (map (lambda (tv) (matrix-vec-mul j3 tv)) tangents-mid2)) (t-end (+ t dt)) (state-end (vec-add state (vec-scale dt k3-state))) (tangents-end (map (lambda (tv k3t) (vec-add tv (vec-scale dt k3t))) tangents k3-tangents)) (k4-state (eval-vector-field sys t-end state-end)) (j4 (compute-jacobian-at sys t-end state-end h)) (k4-tangents (map (lambda (tv) (matrix-vec-mul j4 tv)) tangents-end)) (new-state (vec-add state (vec-scale (/ dt 6) (vec-add k1-state (vec-add (vec-scale 2 k2-state) (vec-add (vec-scale 2 k3-state) k4-state)))))) (new-tangents (map (lambda (tv k1t k2t k3t k4t) (vec-add tv (vec-scale (/ dt 6) (vec-add k1t (vec-add (vec-scale 2 k2t) (vec-add (vec-scale 2 k3t) k4t)))))) tangents k1-tangents k2-tangents k3-tangents k4-tangents))) (cons new-state new-tangents)))"))
(task-entry (id "sim/bifurcation/*arclength-max-correct*") (skill sim) (module bifurcation) (tier 2) (difficulty 23315) (name *arclength-max-correct*) (type "") (description "") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step*)) (answer "(define *arclength-max-correct* 10)"))
(task-entry (id "sim/attractor-render/fb-set-with-intensity!") (skill sim) (module attractor-render) (tier 2) (difficulty 23315) (name fb-set-with-intensity!) (type "(-> FrameBuffer Number Number Number Number Void)") (description "Set pixel with intensity-based character") (notes ()) (section frame-buffer) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set!)) (answer "(define (fb-set-with-intensity! fb x y depth intensity) (fb-set! fb x y (intensity->attractor-char intensity) depth))"))
(task-entry (id "sim/simulation-stream/make-physics-state") (skill sim) (module simulation-stream) (tier 2) (difficulty 23316) (name make-physics-state) (type "(-> Vec2 Vec2 Number Number PhysicsState)") (description "Create a pure physics state for a single body") (notes ()) (section physics-specific-simulation-helpers) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate)) (answer "(define (make-physics-state pos vel mass time) (make-sim-state time (list 'physics pos vel mass) '()))"))
(task-entry (id "sim/ode-system/lotka-volterra") (skill sim) (module ode-system) (tier 2) (difficulty 23316) (name lotka-volterra) (type "(-> Number Number Number Number Any)") (description "Lotka-Volterra predator-prey model: dx/dt = αx - βxy (prey), dy/dt = δxy - γy (predator). State: [prey, predator]") (notes ()) (section standard-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator)) (answer "(define (lotka-volterra alpha beta gamma delta) (make-autonomous-ode (lambda (state) (let ((x (vector-ref state 0)) (y (vector-ref state 1))) (vector (- (* alpha x) (* beta x y)) (- (* delta x y) (* gamma y))))) 2))"))
(task-entry (id "sim/stability/matrix-dominant-eigenvalue") (skill sim) (module stability) (tier 2) (difficulty 23316) (name matrix-dominant-eigenvalue) (type "(-> Any Complex)") (description "Estimate dominant (largest magnitude) eigenvalue using power iteration") (notes ()) (section \x32;x2-eigenvalue-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d)) (answer "(define (matrix-dominant-eigenvalue m) (let* ((n (matrix-rows m)) (v0 (vec-ones n)) (result (power-iteration m v0 100 1e-8))) (if (and (pair? result) (eq? (car result) 'error)) (make-complex 0 0) (make-complex (car result) 0))))"))
(task-entry (id "sim/chaos/gram-schmidt-orthonormalize") (skill sim) (module chaos) (tier 2) (difficulty 23316) (name gram-schmidt-orthonormalize) (type "(-> (List Vec) (Pair (List Vec) (List Number)))") (description "Gram-Schmidt orthonormalization, returns (orthonormal-vecs . norms)") (notes ()) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi)) (answer "(define (gram-schmidt-orthonormalize vectors) (let loop ((vecs vectors) (ortho '()) (norms '())) (if (null? vecs) (cons (reverse ortho) (reverse norms)) (let* ((v (car vecs)) (v-ortho (fold-left (lambda (acc u) (vec-sub acc (vec-scale (vec-dot acc u) u))) v ortho)) (norm (vec-norm v-ortho)) (v-normed (if (> norm *min-norm*) (vec-scale (/ 1 norm) v-ortho) v-ortho))) (loop (cdr vecs) (cons v-normed ortho) (cons (max norm *min-norm*) norms))))))"))
(task-entry (id "sim/bifurcation/continue-fixed-point-arclength") (skill sim) (module bifurcation) (tier 2) (difficulty 23316) (name continue-fixed-point-arclength) (type "(-> ParamODE Number Vec Nat Number (List (List Number Vec Symbol (List Complex))))") (description "Continue a fixed point branch using pseudo-arclength continuation") (notes ("Unlike fixed-parameter continuation, this can follow branches through fold points where the parameter 'turns back'")) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct*)) (answer "(define (continue-fixed-point-arclength psys param0 fp0 num-steps step-size) (let* ((n (vector-length fp0)) (ds (abs step-size)) (sign (if (>= step-size 0) 1 -1))) (let ((tangent0 (compute-tangent psys param0 fp0))) (if (not tangent0) (list (list param0 fp0 'unknown '())) (let loop ((k 0) (param param0) (fp fp0) (tangent tangent0) (results '())) (if (>= k num-steps) (reverse results) (let* ((sys (instantiate-at psys param)) (analysis (analyze-stability-general sys fp *continuation-step-size*)) (stability (car analysis)) (eigenvalues (cdr analysis)) (entry (list param fp stability eigenvalues)) (predicted (arclength-predict fp param tangent (* sign ds))) (pred-fp (car predicted)) (pred-param (cdr predicted)) (corrected (arclength-correct psys pred-fp pred-param tangent (* sign ds)))) (if (not corrected) (reverse (cons entry results)) (let* ((new-fp (car corrected)) (new-param (cadr corrected)) (new-tangent (compute-tangent psys new-param new-fp))) (if (not new-tangent) (reverse (cons entry results)) (let ((oriented-tangent (orient-tangent new-tangent tangent))) (loop (+ k 1) new-param new-fp oriented-tangent (cons entry results)))))))))))))"))
(task-entry (id "sim/attractor-render/fb-to-string") (skill sim) (module attractor-render) (tier 2) (difficulty 23316) (name fb-to-string) (type "(-> FrameBuffer String)") (description "Convert frame buffer to string") (notes ()) (section frame-buffer) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity!)) (answer "(define (fb-to-string fb) (let ((w (fb-width fb)) (h (fb-height fb)) (chars (fb-chars fb)) (result '())) (do ((y 0 (+ y 1))) ((>= y h) (apply string-append (reverse result))) (do ((x 0 (+ x 1))) ((>= x w)) (set! result (cons (string (vector-ref chars (fb-index fb x y))) result))) (set! result (cons \"\n\" result)))))"))
(task-entry (id "sim/simulation-stream/physics-state?") (skill sim) (module simulation-stream) (tier 2) (difficulty 23317) (name physics-state?) (type "(-> SimState Boolean)") (description "") (notes ()) (section physics-specific-simulation-helpers) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state)) (answer "(define (physics-state? s) (and (sim-state? s) (let ((data (sim-state-data s))) (and (pair? data) (eq? (car data) 'physics)))))"))
(task-entry (id "sim/ode-system/lorenz-system") (skill sim) (module ode-system) (tier 2) (difficulty 23317) (name lorenz-system) (type "(-> Number Number Number Any)") (description "Lorenz system (chaotic attractor): dx/dt = σ(y - x), dy/dt = x(ρ - z) - y, dz/dt = xy - βz. Classic parameters: σ=10, ρ=28, β=8/3") (notes ()) (section standard-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra)) (answer "(define (lorenz-system sigma rho beta) (make-autonomous-ode (lambda (state) (let ((x (vector-ref state 0)) (y (vector-ref state 1)) (z (vector-ref state 2))) (vector (* sigma (- y x)) (- (* x (- rho z)) y) (- (* x y) (* beta z))))) 3))"))
(task-entry (id "sim/stability/power-iteration") (skill sim) (module stability) (tier 2) (difficulty 23317) (name power-iteration) (type "(-> Any Any Nat Number (Pair Number Any))") (description "Simple power iteration to find dominant eigenvalue") (notes ()) (section \x32;x2-eigenvalue-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue)) (answer "(define (power-iteration m v max-iter tol) (let loop ((v-curr v) (iter 0) (lambda-prev 0)) (if (>= iter max-iter) (cons lambda-prev v-curr) (let* ((v-next-unnorm (matrix-vec-mul m v-curr)) (norm (vec-norm v-next-unnorm)) (v-next (if (> norm 1e-10) (vec-scale (/ 1 norm) v-next-unnorm) v-curr)) (lambda-curr norm) (change (abs (- lambda-curr lambda-prev)))) (if (< change tol) (cons lambda-curr v-next) (loop v-next (+ iter 1) lambda-curr))))))"))
(task-entry (id "sim/chaos/lyapunov-exponents") (skill sim) (module chaos) (tier 2) (difficulty 23317) (name lyapunov-exponents) (type "(-> ODE Vec Number Nat Nat Nat (List Number))") (description "Compute all Lyapunov exponents using RK4-integrated tangent space evolution") (notes ("Uses RK4 for both state and tangent vectors (variational equations) for O(dt^4) accuracy")) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize)) (answer "(define (lyapunov-exponents sys state0 dt n-steps n-transient reorth-interval) (let* ((dim (ode-dimension sys)) (state-after-transient (let loop ((t 0) (state state0) (i 0)) (if (>= i n-transient) state (loop (+ t dt) (rk4-step sys t state dt) (+ i 1))))) (tangent-vecs (map (lambda (i) (make-tangent-vector dim i)) (iota dim)))) (let loop ((t 0) (state state-after-transient) (tangents tangent-vecs) (lyap-sums (make-list dim 0.0)) (step 0) (reorth-count 0)) (if (>= step n-steps) (map (lambda (sum) (/ sum (* n-steps dt))) lyap-sums) (let* ((result (rk4-variational-step-multi sys t state tangents dt)) (new-state (car result)) (new-tangents (cdr result))) (if (>= reorth-count reorth-interval) (let* ((gs-result (gram-schmidt-orthonormalize new-tangents)) (ortho-tangents (car gs-result)) (norms (cdr gs-result)) (new-sums (map (lambda (sum norm) (+ sum (log norm))) lyap-sums norms))) (loop (+ t dt) new-state ortho-tangents new-sums (+ step 1) 0)) (loop (+ t dt) new-state new-tangents lyap-sums (+ step 1) (+ reorth-count 1))))))))"))
(task-entry (id "sim/bifurcation/compute-tangent") (skill sim) (module bifurcation) (tier 2) (difficulty 23317) (name compute-tangent) (type "(-> ParamODE Number Vec (Option (Pair Vec Number)))") (description "Compute tangent vector (dx/ds, dp/ds) to the solution curve") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength)) (answer "(define (compute-tangent psys param fp) (let* ((sys (instantiate-at psys param)) (n (vector-length fp)) (jac-x (compute-jacobian sys fp *continuation-step-size*)) (jac-p (compute-parameter-jacobian psys param fp *continuation-step-size*))) (let ((v (solve-for-tangent-direction jac-x jac-p))) (if (not v) (compute-tangent-at-fold jac-x jac-p n) (let* ((v-norm-sq (+ (vec-dot v v) 1.0)) (norm (sqrt v-norm-sq)) (tangent-x (vec-scale (/ 1.0 norm) v)) (tangent-p (/ 1.0 norm))) (cons tangent-x tangent-p))))))"))
(task-entry (id "sim/attractor-render/render-attractor") (skill sim) (module attractor-render) (tier 2) (difficulty 23317) (name render-attractor) (type "(-> (List Vec) Nat Nat Number Number Number Number String)") (description "Render attractor trajectory to ASCII string") (notes ()) (section attractor-rendering) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity! fb-to-string)) (answer "(define (render-attractor trajectory width height scale angle-x angle-y angle-z) (let* ((fb (make-frame-buffer width height)) (half-w (/ width 2)) (half-h (/ height 2)) (bounds (attractor-bounds trajectory)) (norm-traj (normalize-trajectory trajectory bounds 1.0)) (z-min (fold-left (lambda (m pt) (min m (vector-ref pt 2))) +inf.0 norm-traj)) (z-max (fold-left (lambda (m pt) (max m (vector-ref pt 2))) -inf.0 norm-traj)) (z-range (max 0.001 (- z-max z-min)))) (for-each (lambda (pt) (let* ((rotated (rotate-point pt angle-x angle-y angle-z)) (proj-x (* scale (vector-ref rotated 0))) (proj-y (* scale (vector-ref rotated 1))) (depth (vector-ref rotated 2)) (sx (+ half-w proj-x)) (sy (- half-h proj-y)) (intensity (/ (- depth z-min) z-range))) (fb-set-with-intensity! fb sx sy depth intensity))) norm-traj) (fb-to-string fb)))"))
(task-entry (id "sim/simulation-stream/physics-pos") (skill sim) (module simulation-stream) (tier 2) (difficulty 23318) (name physics-pos) (type "(-> PhysicsState Vec2)") (description "") (notes ()) (section physics-specific-simulation-helpers) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state?)) (answer "(define (physics-pos s) (list-ref (sim-state-data s) 1))"))
(task-entry (id "sim/ode-system/van-der-pol") (skill sim) (module ode-system) (tier 2) (difficulty 23318) (name van-der-pol) (type "(-> Number Any)") (description "Van der Pol oscillator (limit cycle): d²x/dt² = μ(1 - x²)dx/dt - x. State: [position, velocity]") (notes ()) (section standard-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra lorenz-system)) (answer "(define (van-der-pol mu) (make-autonomous-ode (lambda (state) (let ((x (vector-ref state 0)) (v (vector-ref state 1))) (vector v (- (* mu (- 1 (* x x)) v) x)))) 2))"))
(task-entry (id "sim/stability/classify-stability-2d") (skill sim) (module stability) (tier 2) (difficulty 23318) (name classify-stability-2d) (type "(-> (List Complex) Symbol)") (description "Classify stability for 2D system based on eigenvalues") (notes ()) (section eigenvalue-based-stability-classification) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration)) (answer "(define (classify-stability-2d eigenvalues) (if (not (= (length eigenvalues) 2)) 'invalid-dimension (let* ((lambda1 (car eigenvalues)) (lambda2 (cadr eigenvalues)) (re1 (complex-real lambda1)) (re2 (complex-real lambda2)) (im1 (complex-imag lambda1)) (im2 (complex-imag lambda2))) (cond ((> (abs im1) 1e-10) (cond ((< re1 -1e-10) 'stable-spiral) ((> re1 1e-10) 'unstable-spiral) (else 'center))) ((and (< re1 -1e-10) (< re2 -1e-10)) 'stable-node) ((and (> re1 1e-10) (> re2 1e-10)) 'unstable-node) ((< (* re1 re2) 0) 'saddle) (else 'degenerate)))))"))
(task-entry (id "sim/chaos/largest-lyapunov-exponent") (skill sim) (module chaos) (tier 2) (difficulty 23318) (name largest-lyapunov-exponent) (type "(-> ODE Vec Number Nat Nat Number)") (description "Compute largest Lyapunov exponent using RK4 variational integration") (notes ("Uses RK4 for both state and tangent vector for O(dt^4) accuracy")) (section lyapunov-exponents) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents)) (answer "(define (largest-lyapunov-exponent sys state0 dt n-steps n-transient) (let* ((dim (ode-dimension sys)) (state-after-transient (let loop ((t 0) (state state0) (i 0)) (if (>= i n-transient) state (loop (+ t dt) (rk4-step sys t state dt) (+ i 1)))))) (let loop ((t 0) (state state-after-transient) (tangent (make-tangent-vector dim 0)) (lyap-sum 0.0) (step 0)) (if (>= step n-steps) (/ lyap-sum (* n-steps dt)) (let* ((result (rk4-variational-step sys t state tangent dt)) (new-state (car result)) (new-tangent-raw (cdr result)) (norm (vec-norm new-tangent-raw)) (new-tangent (vec-scale (/ 1 (max norm *min-norm*)) new-tangent-raw))) (loop (+ t dt) new-state new-tangent (+ lyap-sum (log (max norm *min-norm*))) (+ step 1)))))))"))
(task-entry (id "sim/bifurcation/compute-parameter-jacobian") (skill sim) (module bifurcation) (tier 2) (difficulty 23318) (name compute-parameter-jacobian) (type "(-> ParamODE Number Vec Number Vec)") (description "Compute df/dp - how the vector field changes with parameter") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent)) (answer "(define (compute-parameter-jacobian psys param fp h) (let* ((sys0 (instantiate-at psys param)) (sys1 (instantiate-at psys (+ param h))) (f0 (eval-vector-field sys0 0 fp)) (f1 (eval-vector-field sys1 0 fp))) (vec-scale (/ 1.0 h) (vec-sub f1 f0))))"))
(task-entry (id "sim/attractor-render/render-attractor-colored") (skill sim) (module attractor-render) (tier 2) (difficulty 23318) (name render-attractor-colored) (type "(-> (List Vec) Nat Nat Number Number Number Number String)") (description "Render attractor with ANSI 256-color based on trajectory position") (notes ()) (section attractor-rendering) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity! fb-to-string render-attractor)) (answer "(define (render-attractor-colored trajectory width height scale angle-x angle-y angle-z) (let* ((fb-chars (make-vector (* width height) #\\ )) (fb-colors (make-vector (* width height) 0)) (fb-depths (make-vector (* width height) -inf.0)) (half-w (/ width 2)) (half-h (/ height 2)) (bounds (attractor-bounds trajectory)) (norm-traj (normalize-trajectory trajectory bounds 1.0)) (n-points (length norm-traj)) (z-min (fold-left (lambda (m pt) (min m (vector-ref pt 2))) +inf.0 norm-traj)) (z-max (fold-left (lambda (m pt) (max m (vector-ref pt 2))) -inf.0 norm-traj)) (z-range (max 0.001 (- z-max z-min)))) (let render-loop ((pts norm-traj) (i 0)) (when (pair? pts) (let* ((pt (car pts)) (rotated (rotate-point pt angle-x angle-y angle-z)) (proj-x (* scale (vector-ref rotated 0))) (proj-y (* scale (vector-ref rotated 1))) (depth (vector-ref rotated 2)) (sx (inexact->exact (round (+ half-w proj-x)))) (sy (inexact->exact (round (- half-h proj-y)))) (intensity (/ (- depth z-min) z-range)) (hue (/ i n-points)) (r (* 0.5 (+ 1 (sin (* 2 3.14159 hue))))) (g (* 0.5 (+ 1 (sin (* 2 3.14159 (+ hue 0.333)))))) (b (* 0.5 (+ 1 (sin (* 2 3.14159 (+ hue 0.666)))))) (r-final (* r (+ 0.3 (* 0.7 intensity)))) (g-final (* g (+ 0.3 (* 0.7 intensity)))) (b-final (* b (+ 0.3 (* 0.7 intensity)))) (ri (min 5 (max 0 (inexact->exact (round (* r-final 5)))))) (gi (min 5 (max 0 (inexact->exact (round (* g-final 5)))))) (bi (min 5 (max 0 (inexact->exact (round (* b-final 5)))))) (color-code (+ 16 (* ri 36) (* gi 6) bi))) (when (and (>= sx 0) (< sx width) (>= sy 0) (< sy height)) (let ((idx (+ sx (* sy width)))) (when (> depth (vector-ref fb-depths idx)) (vector-set! fb-depths idx depth) (vector-set! fb-chars idx (intensity->attractor-char intensity)) (vector-set! fb-colors idx color-code))))) (render-loop (cdr pts) (+ i 1)))) (let ((result '())) (let row-loop ((y 0)) (if (>= y height) (string-append (apply string-append (reverse result)) \"\x1B;[0m\") (begin (let col-loop ((x 0)) (when (< x width) (let* ((idx (+ x (* y width))) (ch (vector-ref fb-chars idx)) (color (vector-ref fb-colors idx))) (if (char=? ch #\\ ) (set! result (cons \" \" result)) (set! result (cons (string-append \"\x1B;[38;5;\" (number->string color) \"m\" (string ch)) result)))) (col-loop (+ x 1)))) (set! result (cons \"\n\" result)) (row-loop (+ y 1))))))))"))
