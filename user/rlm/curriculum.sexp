(task-entry (id "info/entropy/entropy") (skill info) (module entropy) (tier 1) (difficulty 11103) (name entropy) (type "(-> (List Number) Number)") (description "Shannon entropy H(X) = -sum(p_i * log2(p_i))") (notes ()) (section shannon-entropy) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp)) (answer "(define (entropy probs) (- (fold-left + 0 (map plogp probs))))"))
(task-entry (id "info/statistical-measures/hellinger-distance-from-bc") (skill info) (module statistical-measures) (tier 1) (difficulty 11103) (name hellinger-distance-from-bc) (type "(-> Real Real)") (description "Compute Hellinger distance from Bhattacharyya coefficient: H = sqrt(1 - BC)") (notes ()) (section hellinger-distance) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance)) (answer "(define (hellinger-distance-from-bc bc) (sqrt (- 1 (max 0 (min 1 bc)))))"))
(task-entry (id "info/channel-capacity/bec-capacity") (skill info) (module channel-capacity) (tier 1) (difficulty 11103) (name bec-capacity) (type "(-> Real Real)") (description "Channel capacity of BEC with erasure probability epsilon") (notes ()) (section binary-erasure-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information)) (answer "(define (bec-capacity epsilon) (cond ((<= epsilon 0) 1.0) ((>= epsilon 1) 0.0) (else (- 1 epsilon))))"))
(task-entry (id "info/rate-distortion/mse") (skill info) (module rate-distortion) (tier 1) (difficulty 11103) (name mse) (type "(-> (List Real) (List Real) Real)") (description "Mean squared error: (1/n) * sum((xi - yi)^2)") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion)) (answer "(define (mse xs ys) (if (null? xs) 0 (/ (fold-left + 0 (map squared-error xs ys)) (length xs))))"))
(task-entry (id "info/coding/huffman-symbol") (skill info) (module coding) (tier 1) (difficulty 11103) (name huffman-symbol) (type "(-> Node Symbol)") (description "") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf?)) (answer "(define (huffman-symbol node) (cadr node))"))
(task-entry (id "info/model-selection-info/bic") (skill info) (module model-selection-info) (tier 1) (difficulty 11103) (name bic) (type "(-> Number Nat Nat Number)") (description "Bayesian Information Criterion: BIC = -2*logL + k*log(n)\n   where k is parameter count and n is sample size. Lower is better.\n   Penalizes complexity more heavily than AIC for n >= 8.") (notes ()) (section information-criteria) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (log-likelihood-gaussian log-likelihood-gaussian-vec aic)) (answer "(define (bic log-lik k n) (+ (* -2 log-lik) (* k (log-num n))))"))
(task-entry (id "info/empirical-info/mutual-information-empirical") (skill info) (module empirical-info) (tier 1) (difficulty 11103) (name mutual-information-empirical) (type "(-> (List Number) (List Number) (Nat) Number)") (description "Estimate mutual information I(X;Y) from two sample vectors.\n   Discretizes both into uniform bins, builds joint distribution, computes\n   I(X;Y) = H(X) + H(Y) - H(X,Y). Optional third argument is bin count.") (notes ()) (section empirical-mutual-information) (deps (\x27;prelude \x27;entropy)) (available (discretize-uniform default-num-bins entropy-empirical)) (answer "(define (mutual-information-empirical xs ys . opts) (if (or (null? xs) (null? ys)) 0 (let* ((n (length xs)) (num-bins (if (and (pair? opts) (integer? (car opts))) (car opts) (default-num-bins n))) (bx (discretize-uniform xs num-bins)) (by (discretize-uniform ys num-bins)) (joint-counts (build-joint-counts bx by num-bins)) (joint-probs (map (lambda (row) (map (lambda (c) (/ c n)) row)) joint-counts)) (marginal-x (map (lambda (row) (fold-left + 0 row)) joint-probs)) (marginal-y (compute-column-sums joint-probs num-bins))) (mutual-information joint-probs marginal-x marginal-y))))"))
(task-entry (id "info/partition-info/insert-sorted") (skill info) (module partition-info) (tier 1) (difficulty 11103) (name insert-sorted) (type "") (description "") (notes ()) (section partition-entropy) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy partition-sizes sort-labels)) (answer "(define (insert-sorted x sorted) (cond ((null? sorted) (list x)) ((< x (car sorted)) (cons x sorted)) (else (cons (car sorted) (insert-sorted x (cdr sorted))))))"))
