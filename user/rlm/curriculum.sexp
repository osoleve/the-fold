(task-entry (id "diffgeo/geodesics/compute-exp-jacobian") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10734) (name compute-exp-jacobian) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final trace-geodesic-adaptive-at-times exp-map-adaptive exp-map-adaptive-t log-map-adaptive vec-finite? compute-exp-jacobian-adaptive geodesic-distance-adaptive trace-geodesic trace-geodesic-final exp-map exp-map-t log-map)) (answer "(define (compute-exp-jacobian metric p v n-steps eps n) (let ((J (make-matrix n n 0)) (v-plus (vec-copy v)) (v-minus (vec-copy v)) (failed #f)) (do ((j 0 (+ j 1))) ((or failed (= j n)) (if failed #f J)) (let* ((vj (vector-ref v j)) (eps-j (* eps (max 1.0 (abs vj))))) (vector-set! v-plus j (+ vj eps-j)) (vector-set! v-minus j (- vj eps-j)) (let* ((q-plus (exp-map metric p v-plus n-steps)) (q-minus (exp-map metric p v-minus n-steps))) (if (or (not (vec-finite? q-plus)) (not (vec-finite? q-minus))) (set! failed #t) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! J i j (/ (- (vector-ref q-plus i) (vector-ref q-minus i)) (* 2 eps-j)))))) (vector-set! v-plus j vj) (vector-set! v-minus j vj)))))"))
