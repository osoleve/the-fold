(task-entry (id "algebra/polynomial/poly-sqf-loop") (skill algebra) (module polynomial) (tier 0) (difficulty 338) (name poly-sqf-loop) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm poly-eval poly-derivative poly-scalar-mul-int poly-square-free poly-square-free-factorization)) (answer "(define (poly-sqf-loop b c i result F) (if (poly-equal? b (poly-one-over F)) (reverse result) (let* ((a (poly-gcd b c)) (b-next (poly-div b a)) (c-next (poly-sub (poly-div c a) (poly-derivative b-next))) (new-result (if (poly-equal? a (poly-one-over F)) result (cons (cons a i) result)))) (poly-sqf-loop b-next c-next (+ i 1) new-result F))))"))
