(task-entry (id "random/bayesian/normal-posterior-credible-interval") (skill random) (module bayesian) (tier 1) (difficulty 12914) (name normal-posterior-credible-interval) (type "") (description "") (notes ()) (section conjugate-prior-normal-normal-known-variance) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior)) (answer "(define (normal-posterior-credible-interval prior level) (let* ((mean (normal-prior-mean prior)) (std (sqrt (normal-prior-variance prior))) (z (cond ((= level 0.99) 2.576) ((= level 0.95) 1.96) ((= level 0.9) 1.645) (else 1.96))) (half-width (* z std))) (cons (- mean half-width) (+ mean half-width))))"))
