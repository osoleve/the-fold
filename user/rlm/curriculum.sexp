(task-entry (id "geometry/mesh-sdf/mesh-sdf-gradient") (skill geometry) (module mesh-sdf) (tier 1) (difficulty 12205) (name mesh-sdf-gradient) (type "(-> Mesh Point3 Vec3)") (description "Compute gradient (normal) of the SDF at a point; uses finite differences for numerical gradient") (notes ()) (section mesh-sdf-computation) (deps (\x27;prelude \x27;geometry \x27;bvh)) (available (make-mesh mesh? mesh-triangles mesh-bvh mesh-sdf)) (answer "(define (mesh-sdf-gradient mesh point) (let* ((eps 0.001) (dx (- (mesh-sdf mesh (vec3-add point (vec3 eps 0 0))) (mesh-sdf mesh (vec3-sub point (vec3 eps 0 0))))) (dy (- (mesh-sdf mesh (vec3-add point (vec3 0 eps 0))) (mesh-sdf mesh (vec3-sub point (vec3 0 eps 0))))) (dz (- (mesh-sdf mesh (vec3-add point (vec3 0 0 eps))) (mesh-sdf mesh (vec3-sub point (vec3 0 0 eps)))))) (vec3-normalize (vec3 dx dy dz))))"))
(task-entry (id "geometry/marching-cubes/compute-edge-intersections") (skill geometry) (module marching-cubes) (tier 1) (difficulty 12205) (name compute-edge-intersections) (type "(-> (List Point3) (List Number) Number (List Point3))") (description "Compute intersection points on cube edges") (notes ()) (section grid-and-cube-utilities) (deps (\x27;prelude \x27;geometry)) (available (edge-table tri-table marching-cubes-grid marching-cubes-cube compute-cube-index)) (answer "(define (compute-edge-intersections corners values edge-mask) (let ((edge-defs '((0 1) (1 2) (2 3) (3 0) (4 5) (5 6) (6 7) (7 4) (0 4) (1 5) (2 6) (3 7)))) (let loop ((edges edge-defs) (edge-idx 0) (points '())) (if (null? edges) (reverse points) (let* ((edge (car edges)) (v0-idx (car edge)) (v1-idx (cadr edge))) (if (not (= 0 (bitwise-and edge-mask (bitwise-arithmetic-shift-left 1 edge-idx)))) (let* ((p0 (list-ref corners v0-idx)) (p1 (list-ref corners v1-idx)) (val0 (list-ref values v0-idx)) (val1 (list-ref values v1-idx)) (t (/ (- val0) (- val1 val0))) (point (vec3-add p0 (vec3-scale (vec3-sub p1 p0) t)))) (loop (cdr edges) (+ edge-idx 1) (cons point points))) (loop (cdr edges) (+ edge-idx 1) points)))))))"))
(task-entry (id "geometry/mesh-gen/triangulation-adjacency") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12205) (name triangulation-adjacency) (type "") (description "") (notes ()) (section triangulation) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles)) (answer "(define (triangulation-adjacency tri) (vector-ref tri 3))"))
(task-entry (id "geometry/mesh-topology/triangles->simplicial-complex") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12205) (name triangles->simplicial-complex) (type "(-> (List Triangle3) SC)") (description "Convert raw triangle list to simplicial complex") (notes ()) (section mesh-to-simplicial-complex-conversion) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex)) (answer "(define (triangles->simplicial-complex triangles) (let-values (((key->idx vertices) (build-vertex-map triangles))) (let ((simplices (map (lambda (tri) (let ((i1 (hashtable-ref key->idx (vec3-key (triangle3-p1 tri)) #f)) (i2 (hashtable-ref key->idx (vec3-key (triangle3-p2 tri)) #f)) (i3 (hashtable-ref key->idx (vec3-key (triangle3-p3 tri)) #f))) (if (and (not (= i1 i2)) (not (= i2 i3)) (not (= i1 i3))) (make-simplex (list i1 i2 i3)) #f))) triangles))) (sc-from-simplices (filter identity simplices)))))"))
(task-entry (id "geometry/convex-hull/polar-angle") (skill geometry) (module convex-hull) (tier 1) (difficulty 12205) (name polar-angle) (type "") (description "") (notes ()) (section graham-scan) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point)) (answer "(define (polar-angle origin p) (atan (- (point2-y p) (point2-y origin)) (- (point2-x p) (point2-x origin))))"))
