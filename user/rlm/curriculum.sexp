(task-entry (id "numeric/affine/affine-sqrt") (skill numeric) (module affine) (tier 0) (difficulty 2522) (name affine-sqrt) (type "") (description "") (notes ()) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval affine->interval affine-radius affine-neg merge-terms affine-add affine-sub affine-scale affine-add-constant affine-mul affine-sqr affine-recip affine-div)) (answer "(define (affine-sqrt af) (let* ((iv (affine->interval af)) (lo (interval-lo iv)) (hi (interval-hi iv))) (cond ((< hi 0) 'domain-error) ((< lo 0) (affine-sqrt-positive (make-affine (/ hi 2) (list (cons (affine-fresh-noise-id!) (/ hi 2)))))) (else (affine-sqrt-positive af)))))"))
(task-entry (id "numeric/fem/sparse-cg") (skill numeric) (module fem) (tier 0) (difficulty 2522) (name sparse-cg) (type "") (description "") (notes ()) (section sparse-cg) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes apply-dirichlet-bc! apply-dirichlet-penalty! *fem-tolerance* *fem-max-iterations*)) (answer "(define (sparse-cg A b x0) (let* ((n (sparse-csr-rows A)) (tol *fem-tolerance*) (max-iter (min *fem-max-iterations* (* 2 n))) (Ax0 (sparse-csr-vec-mul A x0)) (r (vec-sub b Ax0)) (p (vector-copy r)) (rr (vec-dot r r))) (if (< (sqrt rr) tol) (list x0 (sqrt rr) 0) (sparse-cg-loop A b (vector-copy x0) r p rr 0 max-iter tol n))))"))
(task-entry (id "numeric/pde-time/sparse-csr-identity") (skill numeric) (module pde-time) (tier 0) (difficulty 2522) (name sparse-csr-identity) (type "") (description "") (notes ()) (section sparse-utils) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step mol-rk4-step cfl-parabolic cfl-hyperbolic estimate-mesh-spacing adaptive-euler-step integrate-adaptive)) (answer "(define (sparse-csr-identity n) (let* ((row-ptrs (make-vector (+ n 1) 0)) (col-indices (make-vector n 0)) (values (make-vector n 1.0))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! row-ptrs i i) (vector-set! col-indices i i)) (vector-set! row-ptrs n n) (list 'sparse-csr n n row-ptrs col-indices values)))"))
