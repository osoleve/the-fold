(task-entry (id "optics/block-optics/block-refs-count") (skill optics) (module block-optics) (tier 1) (difficulty 11005) (name block-refs-count) (type "(-> Block Nat)") (description "Helper: count number of refs in a block.") (notes ()) (section ref-access) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens block-ref-at block-refs-each)) (answer "(define (block-refs-count blk) (vector-length (block-refs blk)))"))
(task-entry (id "optics/profunctor-optics/dimap") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11005) (name dimap) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap)) (answer "(define (dimap prof f g pa) ((profunctor-dimap prof) f g pa))"))
