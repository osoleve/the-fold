(task-entry (id "physics/classical/particles/attractor-field") (skill physics/classical) (module particles) (tier 2) (difficulty 23517) (name attractor-field) (type "") (description "") (notes ()) (section force) (deps (\x27;prelude \x27;sort \x27;vec2 \x27;prng)) (available (make-particle particle? particle-pos particle-vel particle-lifetime particle-max-life particle-size particle-color particle-user-data particle-alive? particle-age particle-with-pos particle-with-vel particle-with-state gravity-field wind-field drag-field)) (answer "(define (attractor-field center strength falloff) (lambda (p) (let* ((to-center (vec2-sub center (particle-pos p))) (dist (vec2-magnitude to-center))) (if (< dist 0.001) (vec2 0 0) (let ((magnitude (/ strength (expt dist falloff)))) (vec2-scale (vec2-normalize to-center) magnitude))))))"))
(task-entry (id "physics/classical/raycasting/ray2-polygon-exit") (skill physics/classical) (module raycasting) (tier 2) (difficulty 23517) (name ray2-polygon-exit) (type "") (description "") (notes ()) (section ray-polygon) (deps (\x27;prelude \x27;vec2 \x27;collision-detection)) (available (*ray-epsilon* make-ray2 ray2? ray2-origin ray2-direction ray2-max-dist ray2-point-at make-hit-info hit-info? hit-info-distance hit-info-point hit-info-normal hit-info-shape ray2-aabb ray2-circle ray2-segment-intersection ray2-polygon)) (answer "(define (ray2-polygon-exit ray polygon max-dist) (let* ((origin (ray2-origin ray)) (dir (ray2-direction ray)) (verts (polygon-vertices polygon)) (n (length verts))) (let loop ((i 0) (best-t +inf.0) (best-normal #f)) (if (>= i n) (if (and (< best-t +inf.0) (<= best-t max-dist)) (make-hit-info best-t (ray2-point-at ray best-t) best-normal polygon) #f) (let* ((p1 (list-ref verts i)) (p2 (list-ref verts (modulo (+ i 1) n))) (result (ray2-segment-intersection origin dir p1 p2))) (if (and result (> (car result) *ray-epsilon*) (< (car result) best-t)) (let* ((edge (vec2-sub p2 p1)) (normal (vec2-neg (vec2-normalize (vec2-rotate-neg-90 edge))))) (loop (+ i 1) (car result) normal)) (loop (+ i 1) best-t best-normal)))))))"))
