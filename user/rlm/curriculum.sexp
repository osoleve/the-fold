(task-entry (id "control-systems/z-transform/dtf-parallel") (skill control-systems) (module z-transform) (tier 2) (difficulty 22622) (name dtf-parallel) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series)) (answer "(define (dtf-parallel dtf1 dtf2) (let ((Ts1 (dtf-Ts dtf1)) (Ts2 (dtf-Ts dtf2))) (if (not (= Ts1 Ts2)) (quasiquote (error sample-time-mismatch (unquote Ts1) (unquote Ts2))) (let* ((n1 (dtf-num dtf1)) (d1 (dtf-den dtf1)) (n2 (dtf-num dtf2)) (d2 (dtf-den dtf2))) (make-dtf (poly-add (poly-mul n1 d2) (poly-mul n2 d1)) (poly-mul d1 d2) Ts1)))))"))
(task-entry (id "control-systems/kalman/log-kalman-summary") (skill control-systems) (module kalman) (tier 2) (difficulty 22622) (name log-kalman-summary) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis make-log-kalman-filter log-kalman-update log-kalman-estimate log-kalman-mean log-kalman-predict-cost log-kalman-confidence-interval kalman-with-Q kalman-boost-Q kalman-summary)) (answer "(define (log-kalman-summary kf) (let ((ci (log-kalman-confidence-interval kf 2.0))) (quasiquote ((mean unquote (log-kalman-mean kf)) (log-mean unquote (kalman-mean kf)) (log-variance unquote (kalman-variance kf)) (ci-95-lower unquote (car ci)) (ci-95-upper unquote (cdr ci)) (Q unquote (kalman-Q kf)) (R unquote (kalman-R kf)) (gain unquote (kalman-gain kf))))))"))
(task-entry (id "control-systems/stability/nyquist-count-encirclements") (skill control-systems) (module stability) (tier 2) (difficulty 22622) (name nyquist-count-encirclements) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points)) (answer "(define (nyquist-count-encirclements contour center) (let ((cx (complex-real center)) (cy (complex-imag center))) (let ((translated (map (lambda (p) (make-complex (- (complex-real p) cx) (- (complex-imag p) cy))) contour))) (winding-number translated))))"))
(task-entry (id "control-systems/controller-design/bass-gura-W") (skill control-systems) (module controller-design) (tier 2) (difficulty 22622) (name bass-gura-W) (type "Vector × Nat → Matrix") (description "Build the W transformation matrix for Bass-Gura") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix)) (answer "(define (bass-gura-W alpha n) (let ((W (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i n) W) (matrix-set! W i i 1) (do ((j (+ i 1) (+ j 1))) ((= j n)) (matrix-set! W i j (vector-ref alpha (- j i)))))))"))
(task-entry (id "control-systems/digital-pid/ziegler-nichols-tune") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22622) (name ziegler-nichols-tune) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to)) (answer "(define (ziegler-nichols-tune Ku Tu type Ts) (case type ((P) (let ((Kp (* 0.5 Ku))) (make-digital-pid Kp 0 0 Ts))) ((PI) (let* ((Kp (* 0.45 Ku)) (Ti (/ Tu 1.2)) (Ki (/ Kp Ti))) (make-digital-pid Kp Ki 0 Ts))) ((PID) (let* ((Kp (* 0.6 Ku)) (Ti (/ Tu 2)) (Td (/ Tu 8)) (Ki (/ Kp Ti)) (Kd (* Kp Td))) (make-digital-pid Kp Ki Kd Ts))) (else (quasiquote (error invalid-pid-type (unquote type))))))"))
(task-entry (id "control-systems/discrete-control/matrix-vec-mul-v") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22622) (name matrix-vec-mul-v) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output dss-simulate dss-impulse-response dss-step-response dss-stable? find-complex-at-index recommend-sample-rate vec-add)) (answer "(define (matrix-vec-mul-v M v) (let* ((rows (matrix-rows M)) (cols (matrix-cols M)) (result (make-vector rows 0))) (do ((i 0 (+ i 1))) ((= i rows) result) (let loop ((j 0) (sum 0)) (if (= j cols) (vector-set! result i sum) (loop (+ j 1) (+ sum (* (matrix-ref M i j) (vector-ref v j)))))))))"))
(task-entry (id "control-systems/hinf-synthesis/hinf-riccati-residual") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22622) (name hinf-riccati-residual) (type "Matrix × Matrix × Matrix × Matrix → Number") (description "Compute ||A'X + XA + Q + XRX||_F") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual)) (answer "(define (hinf-riccati-residual A R Q X) (let* ((At (matrix-transpose A)) (AtX (matrix-mul At X)) (XA (matrix-mul X A)) (XRX (matrix-mul X (matrix-mul R X))) (residual (matrix-add (matrix-add AtX XA) (matrix-add Q XRX)))) (matrix-frobenius-norm-hinf residual)))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-make-monic") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22622) (name alg-poly-make-monic) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd)) (answer "(define (alg-poly-make-monic p) (if (alg-poly-zero? p) p (let* ((F (alg-poly-field p)) (lc (alg-poly-leading-coeff p)) (inv-lc (field-inv F lc))) (alg-poly-scale p inv-lc))))"))
(task-entry (id "control-systems/state-space/ss-controllable?") (skill control-systems) (module state-space) (tier 2) (difficulty 22623) (name ss-controllable?) (type "(-> SS Num Boolean)") (description "Check if system is controllable (controllability matrix has full row rank). Uses tolerance for numerical rank check.") (notes ()) (section controllability) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix)) (answer "(define (ss-controllable? sys tolerance) (let* ((C-mat (ss-controllability-matrix sys)) (n (ss-order sys)) (rank (matrix-rank C-mat tolerance))) (= rank n)))"))
(task-entry (id "control-systems/transfer-function/tf-series") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22623) (name tf-series) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase tf-phase-deg tf-bode-data)) (answer "(define (tf-series tf1 tf2) (make-tf (poly-mul (tf-num tf1) (tf-num tf2)) (poly-mul (tf-den tf1) (tf-den tf2))))"))
(task-entry (id "control-systems/z-transform/dtf-feedback") (skill control-systems) (module z-transform) (tier 2) (difficulty 22623) (name dtf-feedback) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel)) (answer "(define (dtf-feedback G H . sign) (let ((Ts-G (dtf-Ts G)) (Ts-H (dtf-Ts H))) (if (not (= Ts-G Ts-H)) (quasiquote (error sample-time-mismatch (unquote Ts-G) (unquote Ts-H))) (let* ((neg? (or (null? sign) (eq? (car sign) 'negative))) (nG (dtf-num G)) (dG (dtf-den G)) (nH (dtf-num H)) (dH (dtf-den H)) (nGH (poly-mul nG nH)) (dGH (poly-mul dG dH)) (denom-num (if neg? (poly-add dGH nGH) (poly-sub dGH nGH)))) (make-dtf (poly-mul nG dH) denom-num Ts-G)))))"))
(task-entry (id "control-systems/stability/winding-number") (skill control-systems) (module stability) (tier 2) (difficulty 22623) (name winding-number) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements)) (answer "(define (winding-number contour) (if (< (length contour) 2) 0 (let loop ((pts contour) (total-angle 0)) (if (null? (cdr pts)) (let ((angle-diff (angle-difference (car pts) (car contour)))) (round (/ (+ total-angle angle-diff) (* 2 pi)))) (let ((angle-diff (angle-difference (car pts) (cadr pts)))) (loop (cdr pts) (+ total-angle angle-diff)))))))"))
(task-entry (id "control-systems/controller-design/observer-design-ackermann") (skill control-systems) (module controller-design) (tier 2) (difficulty 22623) (name observer-design-ackermann) (type "SS × (List Complex) → Matrix | Error") (description "Design observer gain L using Ackermann's formula on dual system. Observer (state estimator): x_hat' = A*x_hat + B*u + L*(y - C*x_hat) = (A - L*C)*x_hat + B*u + L*y. Goal: place eigenvalues of (A-LC) for fast estimation. By duality: observer gain L is computed like feedback gain K for the dual system (A', C', B')") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W)) (answer "(define (observer-design-ackermann sys desired-poles) (let* ((A (ss-A sys)) (C (ss-C sys)) (n (ss-order sys)) (p (matrix-rows C))) (if (not (= p 1)) '(error ackermann-siso-only) (let* ((At (matrix-transpose A)) (Ct (matrix-transpose C)) (C-dual (make-matrix 1 n 0)) (D-dual (make-matrix 1 1 0)) (dual-sys (make-ss At Ct C-dual D-dual)) (Kt-result (pole-placement-ackermann dual-sys desired-poles))) (if (and (pair? Kt-result) (eq? (car Kt-result) 'error)) Kt-result (matrix-transpose Kt-result))))))"))
(task-entry (id "control-systems/digital-pid/tyreus-luyben-tune") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22623) (name tyreus-luyben-tune) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune)) (answer "(define (tyreus-luyben-tune Ku Tu Ts) (let* ((Kp (/ Ku 3.2)) (Ti (* 2.2 Tu)) (Ki (/ Kp Ti))) (make-digital-pid Kp Ki 0 Ts)))"))
(task-entry (id "control-systems/discrete-control/matrix-inverse") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22623) (name matrix-inverse) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output dss-simulate dss-impulse-response dss-step-response dss-stable? find-complex-at-index recommend-sample-rate vec-add matrix-vec-mul-v)) (answer "(define (matrix-inverse M) (let* ((n (matrix-rows M)) (result (make-matrix n n 0))) (let loop ((j 0)) (if (= j n) result (let* ((e-j (make-vector n 0)) (_ (vector-set! e-j j 1)) (col (solve-linear-system M e-j))) (if (error-result? col) col (begin (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! result i j (vector-ref col i))) (loop (+ j 1)))))))))"))
(task-entry (id "control-systems/hinf-synthesis/matrix-frobenius-norm-hinf") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22623) (name matrix-frobenius-norm-hinf) (type "Matrix → Number") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual)) (answer "(define (matrix-frobenius-norm-hinf M) (let* ((rows (matrix-rows M)) (cols (matrix-cols M))) (sqrt (let loop ((i 0) (sum 0)) (if (>= i rows) sum (loop (+ i 1) (+ sum (let inner ((j 0) (row-sum 0)) (if (>= j cols) row-sum (inner (+ j 1) (+ row-sum (expt (matrix-ref M i j) 2))))))))))))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-extended-gcd") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22623) (name alg-poly-extended-gcd) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic)) (answer "(define (alg-poly-extended-gcd p1 p2) (let ((F (alg-poly-field p1))) (let loop ((old-r p1) (r p2) (old-s (alg-poly-one-over F)) (s (alg-poly-zero-over F)) (old-t (alg-poly-zero-over F)) (t (alg-poly-one-over F))) (if (alg-poly-zero? r) (list (alg-poly-make-monic old-r) old-s old-t) (let* ((qr (alg-poly-divmod old-r r)) (q (car qr))) (loop r (cdr qr) s (alg-poly-sub old-s (alg-poly-mul q s)) t (alg-poly-sub old-t (alg-poly-mul q t))))))))"))
(task-entry (id "control-systems/state-space/ss-observability-matrix") (skill control-systems) (module state-space) (tier 2) (difficulty 22624) (name ss-observability-matrix) (type "(-> SS Matrix)") (description "Compute the observability matrix O = [C; CA; CA²; ...; CA^(n-1)]") (notes ()) (section observability) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable?)) (answer "(define (ss-observability-matrix sys) (let* ((A (ss-A sys)) (C (ss-C sys)) (n (ss-order sys)) (p (ss-outputs sys))) (let build ((k 0) (A-power (matrix-identity n)) (rows '())) (if (>= k n) (let* ((total-rows (* n p)) (result (make-matrix total-rows n 0))) (let fill-rows ((row-list (reverse rows)) (row-idx 0)) (if (null? row-list) result (let ((curr-mat (car row-list))) (do ((i 0 (+ i 1))) ((= i p)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! result (+ row-idx i) j (matrix-ref curr-mat i j)))) (fill-rows (cdr row-list) (+ row-idx p)))))) (let ((CAk (matrix-mul C A-power))) (build (+ k 1) (matrix-mul A-power A) (cons CAk rows)))))))"))
(task-entry (id "control-systems/transfer-function/tf-parallel") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22624) (name tf-parallel) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase tf-phase-deg tf-bode-data tf-series)) (answer "(define (tf-parallel tf1 tf2) (let* ((n1 (tf-num tf1)) (d1 (tf-den tf1)) (n2 (tf-num tf2)) (d2 (tf-den tf2))) (make-tf (poly-add (poly-mul n1 d2) (poly-mul n2 d1)) (poly-mul d1 d2))))"))
(task-entry (id "control-systems/z-transform/dtf-unity-feedback") (skill control-systems) (module z-transform) (tier 2) (difficulty 22624) (name dtf-unity-feedback) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback)) (answer "(define (dtf-unity-feedback G) (let ((unity (dtf-from-lists '(1) '(1) (dtf-Ts G)))) (dtf-feedback G unity 'negative)))"))
(task-entry (id "control-systems/stability/angle-difference") (skill control-systems) (module stability) (tier 2) (difficulty 22624) (name angle-difference) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number)) (answer "(define (angle-difference p1 p2) (let* ((a1 (complex-angle p1)) (a2 (complex-angle p2)) (diff (- a2 a1))) (cond ((> diff pi) (- diff (* 2 pi))) ((< diff (- pi)) (+ diff (* 2 pi))) (else diff))))"))
