(task-entry (id "fp/units/convert") (skill fp) (module units) (tier 1) (difficulty 10717) (name convert) (type "(-> Quantity Quantity Number)") (description "Convert quantity to different unit (same dimension). Returns the numeric factor.") (notes ("Example: (convert (kilometer 1) (meter 1)) → 1000")) (section unit-conversions) (deps (\x27;prelude)) (available (make-dim dim-length dim-time dim-mass dim-current dim-temperature dim-amount dim-luminosity dim? dim=? dim-one dim-length-base dim-time-base dim-mass-base dim-current-base dim-temperature-base dim-amount-base dim-luminosity-base dim* dim/ dim-pow dim-sqrt dim-inv make-qty qty-value qty-dim qty? qty+ qty- qty* qty/ qty-scale qty-pow qty-sqrt qty-neg qty-abs qty=? qty<? qty>? qty<=? qty>=? meter second kilogram ampere kelvin mole candela dim-velocity dim-acceleration dim-force dim-energy dim-power dim-pressure dim-frequency dim-charge dim-voltage dim-resistance dim-area dim-volume newton joule watt pascal hertz coulomb volt ohm yotta zetta exa peta tera giga mega kilo hecto deca deci centi milli micro nano pico femto atto zepto yocto kilometer centimeter millimeter micrometer nanometer millisecond microsecond nanosecond gram milligram kilowatt megawatt gigawatt kilojoule megajoule milliampere microampere kilohertz megahertz gigahertz kilovolt millivolt kiloohm megaohm dim->string qty->string scalar qty-dimensionless? qty->number)) (answer "(define (convert q unit) (if (dim=? (qty-dim q) (qty-dim unit)) (/ (qty-value q) (qty-value unit)) (error 'convert \"dimension mismatch\")))"))
