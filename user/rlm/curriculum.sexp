(task-entry (id "diffgeo/geodesics/geodesic-acceleration") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10707) (name geodesic-acceleration) (type "") (description "") (notes ()) (section geodesic-state) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity)) (answer "(define (geodesic-acceleration metric coords velocity) (let* ((n (metric-dim metric)) (gamma (cached-christoffel-symbols metric coords *geodesic-epsilon*)) (accel (make-vector n 0))) (do ((k 0 (+ k 1))) ((= k n) accel) (let ((sum 0)) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (set! sum (+ sum (* (christoffel-ref gamma k i j) (vector-ref velocity i) (vector-ref velocity j)))))) (vector-set! accel k (- sum))))))"))
(task-entry (id "diffgeo/forms/binomial") (skill diffgeo) (module forms) (tier 1) (difficulty 10707) (name binomial) (type "") (description "") (notes ()) (section multi-index) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index)) (answer "(define (binomial n k) (cond ((or (< k 0) (> k n)) 0) ((or (= k 0) (= k n)) 1) (else (let loop ((i 1) (result 1)) (if (> i k) result (loop (+ i 1) (/ (* result (- n (- i 1))) i)))))))"))
(task-entry (id "diffgeo/symbolic-metrics/make-polar-metric-exact") (skill diffgeo) (module symbolic-metrics) (tier 1) (difficulty 10707) (name make-polar-metric-exact) (type "(-> Chart MetricSymbolic)") (description "Polar metric with exact derivatives") (notes ()) (section metric-derivative-protocol) (deps (\x27;curvature)) (available (metric-symbolic? make-metric-symbolic metric-symbolic-deriv-fn metric-chart* metric-fn* metric-dim* metric-at*)) (answer "(define (make-polar-metric-exact chart) (let ((zero-2x2 (diagonal (vector 0 0)))) (make-metric-symbolic chart (lambda (coords) (let ((r (vector-ref coords 0))) (diagonal (vector 1 (* r r))))) (lambda (coords) (let* ((r (vector-ref coords 0)) (dg (make-vector 2 #f))) (vector-set! dg 0 (diagonal (vector 0 (* 2 r)))) (vector-set! dg 1 zero-2x2) dg)))))"))
