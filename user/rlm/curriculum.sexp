(task-entry (id "tiles/topology-analysis/board-betti-numbers") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12309) (name board-betti-numbers) (type "") (description "") (notes ()) (section topological-analysis) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<? collect-square-faces coords-adjacent?)) (answer "(define (board-betti-numbers board neighbor-fn) (let ((sc (board->simplicial-complex board neighbor-fn))) (sc-betti-numbers sc)))"))
