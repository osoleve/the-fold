(task-entry (id "optics/schema/field-coerce-to-string-iso") (skill optics) (module schema) (tier 1) (difficulty 11015) (name field-coerce-to-string-iso) (type "(-> Symbol (PIso Alist Alist))") (description "Convert a field's value to string representation") (notes ()) (section type-coercion) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso field-split-iso field-merge-iso field-move-to-front-iso nested-field-iso field-ensure-iso field-with-default-iso fields-rename-iso fields-keep-only-iso fields-remove-iso schema-compose)) (answer "(define (field-coerce-to-string-iso field) (field-transform-iso field (make-p-iso (lambda (v) (cond ((string? v) v) ((number? v) (number->string v)) ((symbol? v) (symbol->string v)) ((boolean? v) (if v \"true\" \"false\")) (else (format \"~s\" v)))) identity)))"))
(task-entry (id "optics/block-migration/block-migration-flip") (skill optics) (module block-migration) (tier 1) (difficulty 11015) (name block-migration-flip) (type "(-> BlockMigration BlockMigration)") (description "Reverse a block migration (swap forward/backward and from/to tags).") (notes ()) (section composition) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag block-migration-to-tag block-migration-payload-iso block-migration-applies? block-migrate-payload block-rollback-payload block-with-refs block-migrate-with-refs parse-versioned-tag make-versioned-tag block-tag-version block-tag-base block-migration-compose)) (answer "(define (block-migration-flip bm) (let ((payload-iso (block-migration-payload-iso bm))) (make-block-migration (block-migration-to-tag bm) (block-migration-from-tag bm) (make-p-iso (p-iso-backward payload-iso) (p-iso-forward payload-iso)))))"))
