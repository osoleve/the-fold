(task-entry (id "sim/bifurcation/*adaptive-curvature-threshold*") (skill sim) (module bifurcation) (tier 2) (difficulty 23330) (name *adaptive-curvature-threshold*) (type "") (description "") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold*)) (answer "(define *adaptive-curvature-threshold* 0.26)"))
(task-entry (id "sim/simulation-stream/sim-at-time") (skill sim) (module simulation-stream) (tier 2) (difficulty 23331) (name sim-at-time) (type "(-> Number (Stream SimState) Number (U SimState #f))") (description "Find first state at or after given time") (notes ()) (section simulation-stream-utilities) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take)) (answer "(define (sim-at-time target-time stream fuel) (let loop ((s stream) (n fuel)) (cond ((<= n 0) #f) ((stream-nil? s) #f) ((>= (sim-state-time (stream-head s)) target-time) (stream-head s)) (else (loop (stream-tail s) (- n 1))))))"))
(task-entry (id "sim/chaos/chaos-summary") (skill sim) (module chaos) (tier 2) (difficulty 23331) (name chaos-summary) (type "(-> ODE Vec Number Nat Nat List)") (description "Compute summary of chaotic properties") (notes ()) (section diagnostics) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent is-chaotic? kaplan-yorke-dimension poincare-section poincare-section-2d generate-attractor attractor-bounds normalize-trajectory lorenz-classic rossler-classic chen-classic thomas-classic aizawa-classic)) (answer "(define (chaos-summary sys state0 dt n-steps n-transient) (let* ((lyaps (lyapunov-exponents sys state0 dt n-steps n-transient 10)) (ky-dim (kaplan-yorke-dimension lyaps)) (trajectory (generate-attractor sys state0 dt (min 1000 n-steps) n-transient)) (bounds (attractor-bounds trajectory))) (list (cons 'lyapunov-exponents lyaps) (cons 'kaplan-yorke-dimension ky-dim) (cons 'is-chaotic (> (car lyaps) 0.01)) (cons 'bounds bounds) (cons 'trajectory-length (length trajectory)))))"))
(task-entry (id "sim/bifurcation/*adaptive-residual-threshold*") (skill sim) (module bifurcation) (tier 2) (difficulty 23331) (name *adaptive-residual-threshold*) (type "") (description "") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold*)) (answer "(define *adaptive-residual-threshold* 4)"))
(task-entry (id "sim/simulation-stream/sim-sample") (skill sim) (module simulation-stream) (tier 2) (difficulty 23332) (name sim-sample) (type "(-> Number Number (Stream SimState) (Stream SimState))") (description "Sample simulation at given interval (skip intermediate states). Works correctly with variable-timestep simulations by tracking absolute time") (notes ()) (section simulation-stream-utilities) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time)) (answer "(define (sim-sample interval fuel stream) (if (stream-nil? stream) stream-nil (let* ((first-state (stream-head stream)) (start-time (sim-state-time first-state))) (stream-cons first-state (lambda () (sim-sample-loop interval fuel stream (+ start-time interval) 1))))))"))
(task-entry (id "sim/bifurcation/*adaptive-residual-critical*") (skill sim) (module bifurcation) (tier 2) (difficulty 23332) (name *adaptive-residual-critical*) (type "") (description "") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold*)) (answer "(define *adaptive-residual-critical* 8)"))
(task-entry (id "sim/simulation-stream/sim-sample-loop") (skill sim) (module simulation-stream) (tier 2) (difficulty 23333) (name sim-sample-loop) (type "(-> Number Number (Stream SimState) Number Number (Stream SimState))") (description "Helper: consume stream until we pass next-sample-time, then emit and continue") (notes ()) (section simulation-stream-utilities) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time sim-sample)) (answer "(define (sim-sample-loop interval fuel stream next-sample-time count) (if (>= count fuel) stream-nil (let loop ((s stream)) (cond ((stream-nil? s) stream-nil) (else (let* ((state (stream-head s)) (t (sim-state-time state))) (if (>= t next-sample-time) (stream-cons state (lambda () (sim-sample-loop interval fuel s (+ next-sample-time interval) (+ count 1)))) (loop (stream-tail s)))))))))"))
