(task-entry (id "random/distributions/geometric-quantile") (skill random) (module distributions) (tier 1) (difficulty 12936) (name geometric-quantile) (type "(-> Number Number Nat)") (description "Geometric quantile at probability p") (notes ()) (section geometric-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli bernoulli-pmf random-bernoulli geometric geometric-pmf geometric-cdf)) (answer "(define (geometric-quantile p prob) (if (or (< p 0) (> p 1)) (error 'geometric-quantile \"p must be in [0,1]\" p) (if (= p 0) 1 (ceiling (/ (log-num (- 1 p)) (log-num (- 1 prob)))))))"))
(task-entry (id "random/probability/weighted-samples") (skill random) (module probability) (tier 1) (difficulty 12936) (name weighted-samples) (type "") (description "") (notes ()) (section inference-primitives) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist condition assume sample-once sample-many)) (answer "(define (weighted-samples p seed n) (if (<= n 0) '() (let loop ((prng (make-pcg seed 1)) (count n) (acc '())) (if (= count 0) (reverse acc) (let* ((result (run-prob p prng)) (value (car (car result))) (log-w (cdr (car result))) (new-prng (cdr result))) (loop new-prng (- count 1) (cons (cons value log-w) acc)))))))"))
(task-entry (id "random/bayesian/kl-divergence-beta") (skill random) (module bayesian) (tier 1) (difficulty 12936) (name kl-divergence-beta) (type "") (description "") (notes ()) (section variational-inference-elbo-computation) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode log-beta-pdf log-beta log-normal-pdf log-gamma-pdf log-poisson-pmf log-factorial kl-divergence-normal)) (answer "(define (kl-divergence-beta q p) (let* ((a-q (beta-prior-alpha q)) (b-q (beta-prior-beta q)) (a-p (beta-prior-alpha p)) (b-p (beta-prior-beta p)) (psi-sum-q (digamma (+ a-q b-q)))) (+ (log-beta a-p b-p) (- (log-beta a-q b-q)) (* (- a-q a-p) (- (digamma a-q) psi-sum-q)) (* (- b-q b-p) (- (digamma b-q) psi-sum-q)))))"))
(task-entry (id "random/monte-carlo/mcmc-diagnostics") (skill random) (module monte-carlo) (tier 1) (difficulty 12936) (name mcmc-diagnostics) (type "") (description "") (notes ()) (section convergence-diagnostics) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate antithetic-integrate control-variate-estimate stratified-sample effective-sample-size split-into-batches gelman-rubin autocorrelation integrated-autocorrelation-time)) (answer "(define (mcmc-diagnostics samples) (let ((n (length samples))) (if (< n 10) '((n . 0) (ess . 0) (iat . +inf.0)) (let* ((ess (effective-sample-size samples)) (iat (integrated-autocorrelation-time samples)) (accept-rate 'unknown)) (quasiquote ((n unquote n) (ess unquote ess) (ess-ratio unquote (/ ess n)) (iat unquote iat) (unquote-splicing (sample-summary samples))))))))"))
(task-entry (id "random/variational-inference/make-traced-log-joint-normal-mean") (skill random) (module variational-inference) (tier 1) (difficulty 12936) (name make-traced-log-joint-normal-mean) (type "") (description "") (notes ()) (section traced-log-joint-construction) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum)) (answer "(define (make-traced-log-joint-normal-mean observations known-var prior-mean prior-var) (lambda (t-z) (let* ((t-mu (car t-z)) (prior-mean-const (make-traced-const prior-mean #f)) (t-prior (traced-log-normal-pdf (traced-value t-mu) prior-mean-const (make-traced-const (log (sqrt prior-var)) #f))) (t-likelihood (traced-log-normal-pdf-sum observations t-mu known-var))) (traced-add t-prior t-likelihood))))"))
