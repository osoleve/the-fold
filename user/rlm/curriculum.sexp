(task-entry (id "autodiff/traced-optics/zero-like") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12706) (name zero-like) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value untrace-value lift-at-optic traversal-over-indexed optic-gradient extract-gradient)) (answer "(define (zero-like traced-focus) (cond ((traced? traced-focus) 0) ((traced-vec2? traced-focus) (vec2 0 0)) ((just? traced-focus) (just (zero-like (from-just traced-focus)))) ((nothing? traced-focus) nothing) ((list? traced-focus) (map zero-like traced-focus)) ((and (pair? traced-focus) (not (list? traced-focus))) (cons (zero-like (car traced-focus)) (zero-like (cdr traced-focus)))) (else 0)))"))
(task-entry (id "autodiff/higher-order-diff/vjp") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12707) (name vjp) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical)) (answer "(define (vjp f args v) (with-fresh-ad-scope (lambda () (let* ((tape (make-reverse-tape)) (traced-args (map (lambda (x) (make-traced-var x tape)) args)) (outputs (apply f traced-args)) (outputs-list (if (list? outputs) outputs (list outputs))) (n (length args)) (m (length outputs-list))) (let ((grads (make-hashtable equal-hash equal?))) (do ((i 0 (+ i 1)) (outs outputs-list (cdr outs)) (vs v (cdr vs))) ((= i m)) (when (traced? (car outs)) (hashtable-set! grads (traced-id (car outs)) (car vs)))) (for-each (lambda (entry) (let* ((result-id (car entry)) (input-ids (caddr entry)) (local-grads (cadddr entry)) (result-grad (hashtable-ref grads result-id 0))) (for-each (lambda (input-id local-grad) (when input-id (let ((current (hashtable-ref grads input-id 0))) (hashtable-set! grads input-id (+ current (* result-grad local-grad)))))) input-ids local-grads))) (reverse-tape-entries tape)) (map (lambda (targ) (hashtable-ref grads (traced-id targ) 0)) traced-args))))))"))
(task-entry (id "autodiff/differentiable/differentiable-hyperdual-methods") (skill autodiff) (module differentiable) (tier 1) (difficulty 12707) (name differentiable-hyperdual-methods) (type "") (description "") (notes ()) (section differentiable-typeclass) (deps (\x27;prelude \x27;kinds \x27;infer \x27;resolve \x27;comp-graph \x27;reverse-diff)) (available (TC-Differentiable differentiable-real-methods inst-Differentiable-Real differentiable-dual-methods inst-Differentiable-Dual differentiable-traced-methods inst-Differentiable-Traced)) (answer "(define differentiable-hyperdual-methods (quasiquote ((lift unquote hd-lift) (primal unquote hd-value) (tangent unquote hd-deriv1) (d+ unquote hd-add) (d* unquote hd-mul) (d- unquote hd-sub) (d/ unquote hd-div) (d-neg unquote hd-neg) (d-sq unquote hd-sq) (d-sqrt unquote hd-sqrt) (d-exp unquote hd-exp) (d-log unquote hd-log) (d-sin unquote hd-sin) (d-cos unquote hd-cos))))"))
(task-entry (id "autodiff/differentiable-signal/convolve-vjp-signal") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12707) (name convolve-vjp-signal) (type "(-> (Vector Number) (Vector Number) Symbol (Vector Number))") (description "VJP for convolution with respect to signal") (notes ()) (section convolution-vjp) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real)) (answer "(define (convolve-vjp-signal output-grad kernel mode) (let* ((m (vector-length kernel)) (grad-len (vector-length output-grad)) (kernel-rev (vector-reverse kernel)) (full-grad (convolve output-grad kernel-rev 'full))) (case mode ((full) (let* ((full-len (vector-length full-grad)) (signal-len (+ grad-len 1 (- m))) (offset (- m 1)) (result (make-vector signal-len))) (do ((i 0 (+ i 1))) ((= i signal-len) result) (vector-set! result i (vector-ref full-grad (+ i offset)))))) ((same) (let* ((signal-len grad-len) (full-len (vector-length full-grad)) (offset (quotient m 2)) (result (make-vector signal-len))) (do ((i 0 (+ i 1))) ((= i signal-len) result) (let ((idx (+ i offset))) (if (and (>= idx 0) (< idx full-len)) (vector-set! result i (vector-ref full-grad idx)) (vector-set! result i 0)))))) ((valid) (let* ((signal-len (+ grad-len m -1)) (full-len (vector-length full-grad)) (result (make-vector signal-len 0))) (do ((i 0 (+ i 1))) ((= i (min signal-len full-len)) result) (vector-set! result i (vector-ref full-grad i))))) (else (error 'convolve-vjp-signal \"invalid mode\" mode)))))"))
(task-entry (id "autodiff/sparse-autodiff/dense->sparse-grad") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12707) (name dense->sparse-grad) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense)) (answer "(define (dense->sparse-grad v . tol-arg) (let* ((tol (if (null? tol-arg) 0 (car tol-arg))) (n (vector-length v)) (nnz (let loop ((i 0) (count 0)) (if (= i n) count (loop (+ i 1) (if (> (abs (vector-ref v i)) tol) (+ count 1) count))))) (indices (make-vector nnz 0)) (values (make-vector nnz 0))) (let loop ((i 0) (k 0)) (if (= i n) (make-sparse-grad indices values) (let ((val (vector-ref v i))) (if (> (abs val) tol) (begin (vector-set! indices k i) (vector-set! values k val) (loop (+ i 1) (+ k 1))) (loop (+ i 1) k)))))))"))
