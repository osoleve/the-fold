 world))) (filter (lambda (e) (let ((shape (entity-3d-shape e))) (cond ((sphere3d? shape) (point-in-sphere3d? point shape)) ((box3d? shape) (point-in-box3d? point shape)) ((aabb3d? shape) (point-in-aabb3d? point shape)) (else #f)))) entities)))"))
