(task-entry (id "linalg/vec/vec-zip-with") (skill linalg) (module vec) (tier 0) (difficulty 412) (name vec-zip-with) (type "(-> (-> a b c) (Vec a) (Vec b) (Or (Vec c) Error))") (description "Zip two vectors with a combining function") (notes ()) (section vector-transformations) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right)) (answer "(define (vec-zip-with f v1 v2) (let ((n1 (vector-length v1)) (n2 (vector-length v2))) (if (not (= n1 n2)) (quasiquote (error dimension-mismatch (unquote n1) (unquote n2))) (vec-zip-map-idx i v1 v2 (f (vector-ref v1 i) (vector-ref v2 i))))))"))
