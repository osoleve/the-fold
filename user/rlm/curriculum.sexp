(task-entry (id "optics/optics/verify-lens-laws") (skill optics) (module optics) (tier 1) (difficulty 11132) (name verify-lens-laws) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate? grate-cotraverse-fn grate-review grate-over grate-set grate-zipWith grate-zipWith3 grate-zip grate-compose grate-id grate-fn grate-pair-same grate-list-rep iso->grate grate->setter optic-type optic-compose >>> ->traversal ->fold ->setter iso->lens iso->prism getter->fold ^. ^? ^.. \x2E;~ %~ & verify-iso-laws)) (answer "(define (verify-lens-laws lens test-pairs) (andmap (lambda (pair) (let ((s (car pair)) (a (cdr pair))) (and (equal? (set-lens lens (view lens s) s) s) (eq