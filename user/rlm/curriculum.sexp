(task-entry (id "data/kdtree/kdtree-build-rec") (skill data) (module kdtree) (tier 0) (difficulty 1314) (name kdtree-build-rec) (type "") (description "") (notes ()) (section construction) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree)) (answer "(define (kdtree-build-rec points k depth) (cond ((null? points) kdtree-empty) ((null? (cdr points)) (kdtree-node (car points) kdtree-empty kdtree-empty depth)) (else (let* ((axis (modulo depth k)) (sorted (sort-by-axis points axis)) (mid (quotient (length sorted) 2)) (median-point (list-ref sorted mid)) (left-pts (take mid sorted)) (right-pts (drop (+ mid 1) sorted))) (kdtree-node median-point (kdtree-build-rec left-pts k (+ depth 1)) (kdtree-build-rec right-pts k (+ depth 1)) depth)))))"))
