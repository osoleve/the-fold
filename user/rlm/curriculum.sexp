(task-entry (id "diffgeo/curvature/make-spherical-metric") (skill diffgeo) (module curvature) (tier 1) (difficulty 10710) (name make-spherical-metric) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric)) (answer "(define (make-spherical-metric chart) (make-metric chart (lambda (coords) (let* ((r (vector-ref coords 0)) (theta (vector-ref coords 1)) (r2 (* r r)) (sin-theta (sin theta)) (r2-sin2 (* r2 sin-theta sin-theta))) (matrix-from-lists (list (list 1 0 0) (list 0 r2 0) (list 0 0 r2-sin2)))))))"))
