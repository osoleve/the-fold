(task-entry (id "autodiff/sparse-autodiff/sparse-jacobian-colored") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12741) (name sparse-jacobian-colored) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern sparse-jvp sparse-vjp sparse-hessian sparse-hessian-exact sparse-hessian-vector-product sparse-traced sparse-traced? sparse-traced-value sparse-traced-id sparse-traced-tape make-sparse-reverse-tape sparse-reverse-tape? sparse-tape-entries sparse-tape-push! sparse-backward color-columns rows-overlap? num-colors)) (answer "(define (sparse-jacobian-colored f args pattern) (let* ((m (pattern-rows pattern)) (n (pattern-cols pattern)) (nnz (pattern-nnz pattern)) (row-idx (pattern-row-indices pattern)) (col-idx (pattern-col-indices pattern)) (colors (color-columns pattern)) (nc (num-colors colors)) (values (make-vector nnz 0))) (do ((c 0 (+ c 1))) ((= c nc)) (let ((seed (make-vector n 0))) (do ((j 0 (+ j 1))) ((= j n)) (when (= (vector-ref colors j) c) (vector-set! seed j 1))) (let* ((dual-args (let loop ((xs args) (k 0)) (if (null? xs) '() (cons (dual (car xs) (vector-ref seed k)) (loop (cdr xs) (+ k 1)))))) (outputs (apply f dual-args)) (derivs (if (or (dual? outputs) (not (list? outputs))) (list (dual-deriv outputs)) (map dual-deriv outputs))) (deriv-vec (list->vector derivs))) (do ((k 0 (+ k 1))) ((= k nnz)) (let ((col (vector-ref col-idx k))) (when (= (vector-ref colors col) c) (let ((row (vector-ref row-