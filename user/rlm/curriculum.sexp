(task-entry (id "physics/classical/integrators/interpolate-body") (skill physics/classical) (module integrators) (tier 2) (difficulty 23529) (name interpolate-body) (type "") (description "") (notes ()) (section interpolation) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet integrate-body-rk4 make-time-acc time-acc? time-acc-remaining time-acc-fixed-dt time-acc-max-steps time-acc-add time-acc-consume time-acc-alpha substep-body integrate-with-substeps)) (answer "(define (interpolate-body body-prev body-curr alpha) (let* ((pos (vec2-lerp (body-pos body-prev) (body-pos body-curr) alpha)) (vel (vec2-lerp (body-vel body-prev) (body-vel body-curr) alpha))) (body-with-state body-curr pos vel)))"))
(task-entry (id "physics/classical/rigid-body/rigid-body-kinetic-energy") (skill physics/classical) (module rigid-body) (tier 2) (difficulty 23529) (name rigid-body-kinetic-energy) (type "") (description "") (notes ()) (section energy) (deps (\x27;prelude \x27;vec2)) (available (make-rigid-body rigid-body? rigid-body-pos rigid-body-vel rigid-body-angle rigid-body-angular-vel rigid-body-mass rigid-body-inv-mass rigid-body-inertia rigid-body-inv-inertia rigid-body-static? rigid-body-with-pos rigid-body-with-vel rigid-body-with-angle rigid-body-with-angular-vel rigid-body-with-mass rigid-body-with-inertia rigid-body-with-state make-static-rigid-body circle-inertia rectangle-inertia rod-inertia point-mass-inertia local-to-world world-to-local rigid-body-velocity-at apply-linear-impulse apply-angular-impulse apply-impulse-at-point)) (answer "(define (rigid-body-kinetic-energy body) (let ((mass (rigid-body-mass body)) (vel (rigid-body-vel body)) (inertia (rigid-body-inertia body)) (omega (rigid-body-angular-vel body))) (+ (* 0.5 mass (vec2-magnitude-sq vel)) (* 0.5 inertia omega omega))))"))
(task-entry (id "physics/classical/collision-detection/point-in-circle?") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23529) (name point-in-circle?) (type "") (description "") (notes ()) (section point-in-shape) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb?)) (answer "(define (point-in-circle? point circle) (let ((d-sq (vec2-distance-sq point (circle-center circle))) (r (circle-radius circle))) (<= d-sq (* r r))))"))
(task-entry (id "physics/classical/collision-response/calculate-friction-impulse") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23529) (name calculate-friction-impulse) (type "") (description "") (notes ()) (section impulse) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material combine-materials velocity-at-point relative-velocity-at relative-velocity normal-velocity-at normal-velocity tangent-velocity get-inv-mass get-inv-inertia get-body-pos calculate-impulse-with-rotation calculate-impulse)) (answer "(define (calculate-friction-impulse body-a body-b normal j-normal static-friction dynamic-friction) (let* ((rel-vel (relative-velocity body-a body-b)) (normal-component (vec2-scale normal (vec2-dot rel-vel normal))) (tangent-vel (vec2-sub rel-vel normal-component)) (tangent-speed (vec2-magnitude tangent-vel)) (inv-mass-a (body-inv-mass body-a)) (inv-mass-b (body-inv-mass body-b)) (total-inv-mass (+ inv-mass-a inv-mass-b))) (if (< tangent-speed 1e-4) 0 (let ((j-tangent (/ (- tangent-speed) total-inv-mass))) (if (< (abs j-tangent) (* j-normal static-friction)) j-tangent (* (- j-normal) dynamic-friction (if (< j-tangent 0) -1 1)))))))"))
(task-entry (id "physics/classical/constraints/constraint-anchor-world-b") (skill physics/classical) (module constraints) (tier 2) (difficulty 23529) (name constraint-anchor-world-b) (type "") (description "") (notes ()) (section helper:) (deps (\x27;prelude \x27;vec2 \x27;rigid-body)) (available (make-constraint constraint? constraint-type constraint-id constraint-entity-a constraint-entity-b constraint-data constraint-solver-velocity constraint-solver-position constraint-cached-lambda constraint-with-cached-lambda make-distance-constraint-data distance-data-anchor-a distance-data-anchor-b distance-data-target make-revolute-constraint-data revolute-data-anchor-a revolute-data-anchor-b make-spring-constraint-data spring-data-anchor-a spring-data-anchor-b spring-data-rest-length spring-data-stiffness spring-data-damping make-weld-constraint-data weld-data-anchor-a weld-data-anchor-b weld-data-reference-angle constraint-anchor-world-a)) (answer "(define (constraint-anchor-world-b world constraint) (let* ((entity-id (constraint-entity-b constraint)) (data (constraint-data constraint)) (local-anchor (cadr data))) (if entity-id (constraint-entity-anchor-world world entity-id local-anchor) local-anchor)))"))
(task-entry (id "physics/classical/constraint-graph/cg-print-stats") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23529) (name cg-print-stats) (type "") (description "") (notes ()) (section utilities) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints toposort-dag cg-color-constraints build-constraint-conflicts cg-chromatic-number cg-stats)) (answer "(define (cg-print-stats graph) (let ((stats (cg-stats graph))) (printf \"Constraint Graph Statistics:\n\") (printf \"  Entities:        ~a\n\" (cdr (assq 'entities stats))) (printf \"  Constraints:     ~a\n\" (cdr (assq 'constraints stats))) (printf \"  Islands:         ~a\n\" (cdr (assq 'islands stats))) (printf \"  Largest island:  ~a entities\n\" (cdr (assq 'largest-island stats))) (printf \"  SCCs:            ~a\n\" (cdr (assq 'sccs stats))) (printf \"  Largest SCC:     ~a entities\n\" (cdr (assq 'largest-scc stats))) (printf \"  Colors needed:   ~a\n\" (cdr (assq 'colors stats))) (printf \"  Max parallel:    ~a constraints\n\" (cdr (assq 'max-parallel stats)))))"))
