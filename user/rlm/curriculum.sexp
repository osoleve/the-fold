(task-entry (id "numeric/signal-poly/jury-table-iter") (skill numeric) (module signal-poly) (tier 0) (difficulty 2529) (name jury-table-iter) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;digital-filters)) (available (Q-field-sig sig-make-polynomial sig-normalize-coeffs sig-poly-field sig-poly-coeffs sig-poly-degree sig-poly-zero? sig-poly-leading sig-poly-add sig-poly-sub sig-poly-mul list-set sig-poly-scale sig-poly-divmod sig-poly-zero-over sig-poly-one-over sig-poly-divmod-iter sig-poly-div sig-poly-mod sig-poly-gcd sig-poly-make-monic num-poly-coeffs-sig numeric->signal-poly signal->numeric-poly filter-num-poly filter-den-poly filter-coprime? filter-simplify jury-table)) (answer "(define (jury-table-iter rows remaining) (if (<= remaining 1) (reverse rows) (let* ((row1 (car rows)) (row2 (cadr rows)) (a0 (car row1)) (an (car row2)) (n (length row1))) (if (= a0 0) (reverse rows) (let* ((new-row (jury-new-row row1 row2 a0 an)) (new-row-rev (reverse new-row))) (jury-table-iter (cons new-row-rev (cons new-row rows)) (- remaining 1)))))))"))
(task-entry (id "numeric/interpolate/bspline-basis") (skill numeric) (module interpolate) (tier 0) (difficulty 2529) (name bspline-basis) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;numeric/polynomial)) (available (binary-search-segment binary-search-segment-vec lerp lerp-inverse interp-linear lagrange-basis interp-lagrange divided-differences interp-newton interp-hermite hermite-tangent-estimate thomas-algorithm cubic-spline-natural matrix-set! spline-eval interp-cubic-spline bezier-linear bezier-quadratic bezier-cubic bezier-general bezier-derivative polyfit linreg linreg-r2 chebyshev-nodes chebyshev-nodes-interval chebyshev-t chebyshev-coeffs chebyshev-eval)) (answer "(define (bspline-basis knots i p x) (let ((n (vector-length knots))) (cond ((= p 0) (let ((ti (vector-ref knots i)) (ti+1 (if (< (+ i 1) n) (vector-ref knots (+ i 1)) (+ ti 1)))) (if (and (>= x ti) (< x ti+1)) 1.0 0.0))) (else (let* ((ti (vector-ref knots i)) (ti+1 (vector-ref knots (+ i 1))) (ti+p (if (< (+ i p) n) (vector-ref knots (+ i p)) (+ ti+1 1))) (ti+p+1 (if (< (+ i p 1) n) (vector-ref knots (+ i p 1)) (+ ti+p 1))) (denom1 (- ti+p ti)) (denom2 (- ti+p+1 ti+1)) (term1 (if (zero? denom1) 0.0 (* (/ (- x ti) denom1) (bspline-basis knots i (- p 1) x)))) (term2 (if (zero? denom2) 0.0 (* (/ (- ti+p+1 x) denom2) (bspline-basis knots (+ i 1) (- p 1) x))))) (+ term1 term2))))))"))
