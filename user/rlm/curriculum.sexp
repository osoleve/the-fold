(task-entry (id "optimization/ilp/make-ilp-optimal") (skill optimization) (module ilp) (tier 1) (difficulty 12813) (name make-ilp-optimal) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp)) (answer "(define (make-ilp-optimal x z) (list 'ilp-optimal x z))"))
(task-entry (id "optimization/interval-global/ior-best-point") (skill optimization) (module interval-global) (tier 1) (difficulty 12813) (name ior-best-point) (type "") (description "") (notes ()) (section convergence-criteria) (deps (\x27;prelude \x27;interval \x27;heap)) (available (make-interval-convergence interval-convergence? ic-width-tol ic-max-iter ic-gap-tol *default-interval-convergence* make-interval-opt-result interval-opt-result? ior-candidates ior-best-upper ior-iterations ior-reason ior-best-box)) (answer "(define (ior-best-point result) (let ((best (ior-best-box result))) (and best (box-midpoint best))))"))
(task-entry (id "optimization/interval-contract/make-sphere-contractor") (skill optimization) (module interval-contract) (tier 1) (difficulty 12813) (name make-sphere-contractor) (type "(-> (List Real) Real Contractor)") (description "Contractor for: sum((x_i - center_i)²) ≤ radius²") (notes ("Useful for trust region constraints")) (section quadratic-contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract contract-linear-var remove-dim sum-interval-bounds make-linear-ge-contractor make-linear-eq-contractor)) (answer "(define (make-sphere-contractor center radius-sq) (lambda (box) (let loop ((dim 0) (current-box box)) (if (>= dim (length box)) current-box (let ((new-iv (contract-sphere-dim current-box center radius-sq dim))) (if (eq? new-iv 'empty) 'empty (loop (+ dim 1) (list-update current-box dim new-iv))))))))"))
(task-entry (id "optimization/interval-newton/bisection-loop") (skill optimization) (module interval-newton) (tier 1) (difficulty 12813) (name bisection-loop) (type "") (description "") (notes ()) (section bisection) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step interval-newton-step-rigorous interval-newton-root interval-find-all-roots interval-might-contain-root? interval-bisection-root)) (answer "(define (bisection-loop f lo hi f-lo f-hi tol max-iter iter) (cond ((>= iter max-iter) (list 'found (interval lo hi) iter)) ((< (- hi lo) tol) (list 'found (interval lo hi) iter)) (else (let* ((mid (/ (+ lo hi) 2)) (f-mid (f mid))) (cond ((= f-mid 0) (list 'found (interval-singleton mid) iter)) ((< (* f-lo f-mid) 0) (bisection-loop f lo mid f-lo f-mid tol max-iter (+ iter 1))) (else (bisection-loop f mid hi f-mid f-hi tol max-iter (+ iter 1))))))))"))
(task-entry (id "optimization/line-search/wolfe-line-search-full") (skill optimization) (module line-search) (tier 1) (difficulty 12814) (name wolfe-line-search-full) (type "") (description "") (notes ()) (section overview) (deps (\x27;prelude \x27;reverse-diff)) (available (*armijo-c1* *wolfe-c2* *backtrack-rho* *max-ls-iters* *initial-step* *default-alpha-max* dot-product vec-add-scaled armijo-condition? armijo-backtrack armijo-backtrack-full curvature-condition? strong-curvature-condition? wolfe-line-search)) (answer "(define (wolfe-line-search-full f x grad direction alpha-init c1 c2 alpha-max max-iters) (let* ((f-old (apply f (map (lambda (v) v) x))) (grad-dot-d (dot-product grad direction))) (if (>= grad-dot-d 0) (list x 0) (wolfe-bracket f x grad direction f-old grad-dot-d alpha-init c1 c2 alpha-max max-iters))))"))
(task-entry (id "optimization/convergence/converged?") (skill optimization) (module convergence) (tier 1) (difficulty 12814) (name converged?) (type "(-> ConvergenceCriteria ConvergenceState (Either Bool Symbol))") (description "Check if optimization has converged.\nReturns #f if not converged, or a symbol indicating why:\n  'grad-converged - gradient norm below tolerance\n  'f-converged - function value change below tolerance\n  'x-converged - parameter change below tolerance\n  'max-iter - maximum iterations reached") (notes ()) (section convergence-checking) (deps (\x27;prelude \x27;vec)) (available (make-convergence-criteria *default-convergence* convergence-criteria? cc-grad-tol cc-f-tol cc-x-tol cc-max-iter make-convergence-state convergence-state? cs-iter cs-f-val cs-grad-norm cs-f-change cs-x-change)) (answer "(define (converged? criteria state) (cond ((< (cs-grad-norm state) (cc-grad-tol criteria)) 'grad-converged) ((and (> (cs-iter state) 0) (< (cs-f-change state) (cc-f-tol criteria))) 'f-converged) ((and (> (cs-iter state) 0) (< (cs-x-change state) (cc-x-tol criteria))) 'x-converged) ((>= (cs-iter state) (cc-max-iter criteria)) 'max-iter) (else #f)))"))
(task-entry (id "optimization/first-order/muon-full") (skill optimization) (module first-order) (tier 1) (difficulty 12814) (name muon-full) (type "(-> (-> (List TracedValue) TracedValue) (List Number) Number Number ConvergenceCriteria OptResult)") (description "Muon optimizer for vectors with all hyperparameters") (notes ()) (section muon) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum adam adam-full rmsprop rmsprop-full adagrad adagrad-full gradient-descent-ls nesterov newton-schulz-step newton-schulz muon)) (answer "(define (muon-full f x0 lr beta criteria) (let* ((n (length x0)) (init-m (make-list n 0)) (init-grad (gradient f x0)) (init-f (apply f x0)) (init-state (initial-convergence-state init-f init-grad))) (let loop ((x x0) (m init-m) (state init-state)) (let ((reason (converged? criteria state))) (if reason (make-opt-result x (cs-f-val state) (gradient f x) (cs-iter state) reason) (let* ((grad (gradient f x)) (m-new (map (lambda (mi gi) (+ (* beta mi) gi)) m grad)) (m-norm (vec-norm m-new)) (m-orth (if (< m-norm 1e-12) m-new (map (lambda (mi) (/ mi m-norm)) m-new))) (x-new (map (lambda (xi mi) (- xi (* lr mi))) x m-orth)) (f-new (apply f x-new)) (grad-new (gradient f x-new)) (new-state (update-convergence-state state f-new grad-new x x-new))) (loop x-new m-new new-state)))))))"))
(task-entry (id "optimization/newton/list-update") (skill optimization) (module newton) (tier 1) (difficulty 12814) (name list-update) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton make-positive-definite newton-cg newton-cg-full cg-newton-direction hessian-vector-product gauss-newton gradient-ls jacobian-numerical list-update-newton)) (answer "(define list-update list-update-newton)"))
(task-entry (id "optimization/lbfgs/minimize") (skill optimization) (module lbfgs) (tier 1) (difficulty 12814) (name minimize) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list lbfgs-history-push take-n lbfgs-direction lbfgs-two-loop initial-hessian-scale lbfgs lbfgs-full)) (answer "(define (minimize f x0) (lbfgs f x0 *default-convergence*))"))
(task-entry (id "optimization/lp/lp-result-x") (skill optimization) (module lp) (tier 1) (difficulty 12814) (name lp-result-x) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded?)) (answer "(define (lp-result-x r) (cadr r))"))
(task-entry (id "optimization/ilp/make-ilp-infeasible") (skill optimization) (module ilp) (tier 1) (difficulty 12814) (name make-ilp-infeasible) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp make-ilp-optimal)) (answer "(define (make-ilp-infeasible) '(ilp-infeasible))"))
(task-entry (id "optimization/interval-global/ior-solution-box") (skill optimization) (module interval-global) (tier 1) (difficulty 12814) (name ior-solution-box) (type "") (description "") (notes ()) (section convergence-criteria) (deps (\x27;prelude \x27;interval \x27;heap)) (available (make-interval-convergence interval-convergence? ic-width-tol ic-max-iter ic-gap-tol *default-interval-convergence* make-interval-opt-result interval-opt-result? ior-candidates ior-best-upper ior-iterations ior-reason ior-best-box ior-best-point)) (answer "(define (ior-solution-box result) (let ((candidates (ior-candidates result))) (if (null? candidates) #f (fold-left box-hull (car candidates) (cdr candidates)))))"))
(task-entry (id "optimization/interval-contract/contract-sphere-dim") (skill optimization) (module interval-contract) (tier 1) (difficulty 12814) (name contract-sphere-dim) (type "") (description "") (notes ()) (section quadratic-contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract contract-linear-var remove-dim sum-interval-bounds make-linear-ge-contractor make-linear-eq-contractor make-sphere-contractor)) (answer "(define (contract-sphere-dim box center radius-sq dim) (let* ((c-i (list-ref center dim)) (iv (list-ref box dim)) (other-sq (sphere-other-sq box center dim)) (remaining-sq (- radius-sq other-sq))) (if (< remaining-sq 0) 'empty (let* ((delta (sqrt remaining-sq)) (bound-lo (- c-i delta)) (bound-hi (+ c-i delta)) (new-lo (max (interval-lo iv) bound-lo)) (new-hi (min (interval-hi iv) bound-hi))) (if (> new-lo new-hi) 'empty (interval new-lo new-hi))))))"))
(task-entry (id "optimization/interval-newton/interval-contains-unique-root?") (skill optimization) (module interval-newton) (tier 1) (difficulty 12814) (name interval-contains-unique-root?) (type "(-> (-> Interval Interval) (-> Interval Interval) Interval Boolean)") (description "") (notes ()) (section existence-tests) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step interval-newton-step-rigorous interval-newton-root interval-find-all-roots interval-might-contain-root? interval-bisection-root bisection-loop)) (answer "(define (interval-contains-unique-root? f-iv f-deriv-iv X) (let ((step-result (interval-newton-step-rigorous f-iv f-deriv-iv X))) (eq? (car step-result) 'unique)))"))
(task-entry (id "optimization/line-search/wolfe-bracket") (skill optimization) (module line-search) (tier 1) (difficulty 12815) (name wolfe-bracket) (type "") (description "") (notes ()) (section overview) (deps (\x27;prelude \x27;reverse-diff)) (available (*armijo-c1* *wolfe-c2* *backtrack-rho* *max-ls-iters* *initial-step* *default-alpha-max* dot-product vec-add-scaled armijo-condition? armijo-backtrack armijo-backtrack-full curvature-condition? strong-curvature-condition? wolfe-line-search wolfe-line-search-full)) (answer "(define (wolfe-bracket f x grad direction f-old grad-dot-d alpha-init c1 c2 alpha-max max-iters) (let loop ((alpha-prev 0) (f-prev f-old) (alpha alpha-init) (iter 0)) (if (>= iter max-iters) (list (vec-add-scaled x direction alpha) alpha) (let* ((x-new (vec-add-scaled x direction alpha)) (f-new (apply f x-new))) (cond ((or (> f-new (+ f-old (* c1 alpha grad-dot-d))) (and (> iter 0) (>= f-new f-prev))) (wolfe-zoom f x grad direction f-old grad-dot-d alpha-prev alpha c1 c2 (- max-iters iter))) (else (let* ((grad-new (gradient f x-new)) (grad-new-dot-d (dot-product grad-new direction))) (cond ((strong-curvature-condition? grad-new-dot-d grad-dot-d c2) (list x-new alpha)) ((>= grad-new-dot-d 0) (wolfe-zoom f x grad direction f-old grad-dot-d alpha alpha-prev c1 c2 (- max-iters iter))) (else (loop alpha f-new (min (* 2 alpha) alpha-max) (+ iter 1)))))))))))"))
(task-entry (id "optimization/convergence/vec-norm") (skill optimization) (module convergence) (tier 1) (difficulty 12815) (name vec-norm) (type "(-> (List Number) Number)") (description "Compute L2 norm of a list-vector using scaling by max element to avoid overflow") (notes ()) (section vector-norms) (deps (\x27;prelude \x27;vec)) (available (make-convergence-criteria *default-convergence* convergence-criteria? cc-grad-tol cc-f-tol cc-x-tol cc-max-iter make-convergence-state convergence-state? cs-iter cs-f-val cs-grad-norm cs-f-change cs-x-change converged?)) (answer "(define (vec-norm v) (if (null? v) 0 (let ((max-abs (fold-left max 0 (map abs v)))) (if (< max-abs 1e-300) 0 (let ((scaled-sq-sum (fold-left + 0 (map (lambda (x) (let ((s (/ x max-abs))) (* s s))) v)))) (* max-abs (sqrt scaled-sq-sum)))))))"))
(task-entry (id "optimization/first-order/muon-matrix") (skill optimization) (module first-order) (tier 1) (difficulty 12815) (name muon-matrix) (type "(-> (-> (List TracedValue) TracedValue) Matrix Number ConvergenceCriteria MatrixOptResult)") (description "Muon optimizer for matrix-shaped parameters using Newton-Schulz orthogonalization") (notes ("Uses 5 Newton-Schulz iterations to orthogonalize momentum.\nThe objective f receives a flat list of traced values (row-major order).\nNewton-Schulz uses the matrix shape from m0 for orthogonalization.")) (section muon) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum adam adam-full rmsprop rmsprop-full adagrad adagrad-full gradient-descent-ls nesterov newton-schulz-step newton-schulz muon muon-full)) (answer "(define (muon-matrix f m0 lr criteria) (muon-matrix-full f m0 lr 0.95 5 criteria))"))
(task-entry (id "optimization/newton/matrix-vec-mul") (skill optimization) (module newton) (tier 1) (difficulty 12815) (name matrix-vec-mul) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton make-positive-definite newton-cg newton-cg-full cg-newton-direction hessian-vector-product gauss-newton gradient-ls jacobian-numerical list-update-newton list-update)) (answer "(define (matrix-vec-mul m v) (let* ((rows (matrix-rows m)) (cols (matrix-cols m)) (result (make-vector rows 0))) (do ((i 0 (+ i 1))) ((= i rows) result) (let ((sum (let inner ((j 0) (s 0)) (if (= j cols) s (inner (+ j 1) (+ s (* (matrix-ref m i j) (vector-ref v j)))))))) (vector-set! result i sum)))))"))
(task-entry (id "optimization/lbfgs/minimize-with") (skill optimization) (module lbfgs) (tier 1) (difficulty 12815) (name minimize-with) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list lbfgs-history-push take-n lbfgs-direction lbfgs-two-loop initial-hessian-scale lbfgs lbfgs-full minimize)) (answer "(define (minimize-with f x0 method) (case method ((sgd) (gradient-descent f x0 0.01 *default-convergence*)) ((adam) (adam f x0 0.001 *default-convergence*)) ((lbfgs) (lbfgs f x0 *default-convergence*)) ((newton) (newton-method f x0 *default-convergence*)) (else (lbfgs f x0 *default-convergence*))))"))
(task-entry (id "optimization/lp/lp-result-z") (skill optimization) (module lp) (tier 1) (difficulty 12815) (name lp-result-z) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x)) (answer "(define (lp-result-z r) (caddr r))"))
