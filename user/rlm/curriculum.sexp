(task-entry (id "linalg/graph-laplacian/spectral-radius-laplacian") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 416) (name spectral-radius-laplacian) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap)) (answer "(define (spectral-radius-laplacian adj) (let* ((L (laplacian adj)) (result (power-iteration L))) (if (and (pair? result) (eq? (car result) 'error)) result (abs (car result)))))"))
(task-entry (id "linalg/svd/pseudoinverse") (skill linalg) (module svd) (tier 0) (difficulty 416) (name pseudoinverse) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin matrix-slice-cols matrix-slice)) (answer "(define (pseudoinverse a . opts) (let* ((tol (if (pair? opts) (car opts) *svd-tolerance*)) (svd-result (svd a *svd-max-iterations* tol))) (if (and (pair? svd-result) (eq? (car svd-result) 'error)) svd-result (let* ((u (car svd-result)) (sigma (cadr svd-result)) (v (caddr svd-result)) (m (matrix-rows a)) (n (matrix-cols a)) (sigma-pinv (build-sigma-pseudoinverse sigma m n tol)) (vt (matrix-transpose v)) (ut (matrix-transpose u)) (v-sigma-pinv (matrix-mul v sigma-pinv))) (matrix-mul v-sigma-pinv ut)))))"))
