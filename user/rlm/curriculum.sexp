(task-entry (id "algebra/groebner/all-pairs") (skill algebra) (module groebner) (tier 0) (difficulty 306) (name all-pairs) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger buchberger-loop buchberger-criterion-1?)) (answer "(define (all-pairs n) (let outer ((i 0) (result '())) (if (>= i (- n 1)) (reverse result) (let inner ((j (+ i 1)) (acc result)) (if (>= j n) (outer (+ i 1) acc) (inner (+ j 1) (cons (cons i j) acc)))))))"))
