(task-entry (id "optimization/interval-contract/interval-minimize-constrained") (skill optimization) (module interval-contract) (tier 1) (difficulty 12816) (name interval-minimize-constrained) (type "(-> (-> Box Interval) Box IntervalConvergence (List Contractor) IntervalOptResult)") (description "Global minimization with constraint contractors") (notes ("Contractors are applied before each bisection to shrink boxes")) (section constrained-optimization) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract contract-linear-var remove-dim sum-interval-bounds make-linear-ge-contractor make-linear-eq-contractor make-sphere-contractor contract-sphere-dim sphere-other-sq)) (answer "(define (interval-minimize-constrained f-interval initial-box criteria contractors) (let* ((width-tol (ic-width-tol criteria)) (max-iter (ic-max-iter criteria)) (gap-tol (ic-gap-tol criteria)) (contracted-box (contract-all contractors initial-box))) (if (eq? contracted-box 'empty) (make-interval-opt-result '() +inf.0 0 'infeasible) (let* ((f0 (f-interval contracted-box)) (mid0 (box-midpoint contracted-box)) (f-mid0 (eval-at-point f-interval mid0)) (item0 (make-work-item contracted-box f0)) (work-list (heap-insert-by work-item-cmp item0 heap-empty)) (best-upper (min f-mid0 (interval-hi f0)))) (bb-loop-constrained f-interval contractors work-list best-upper '() 1 width-tol max-iter gap-tol)))))"))
(task-entry (id "optimization/interval-newton/krawczyk-step") (skill optimization) (module interval-newton) (tier 1) (difficulty 12816) (name krawczyk-step) (type "") (description "") (notes ()) (section krawczyk) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step interval-newton-step-rigorous interval-newton-root interval-find-all-roots interval-might-contain-root? interval-bisection-root bisection-loop interval-contains-unique-root? interval-contains-no-root?)) (answer "(define (krawczyk-step f f-deriv f-deriv-iv X) (let* ((m (interval-mid X)) (fm (f m)) (f-prime-m (f-deriv m)) (F-prime-X (f-deriv-iv X))) (cond ((< (abs f-prime-m) 1e-15) (cons 'degenerate X)) (else (let* ((Y (/ 1.0 f-prime-m)) (term1 (- m (* Y fm))) (ratio (interval-scale F-prime-X Y)) (one-minus-ratio (interval-sub (interval-singleton 1) ratio)) (X-minus-m (interval-sub X (interval-singleton m))) (term2 (interval-mul one-minus-ratio X-minus-m)) (K-X (interval-add (interval-singleton term1) term2)) (intersection (interval-intersection K-X X))) (cond ((error? intersection) (cons 'no-root #f)) ((interval-subset? K-X X) (cons 'unique intersection)) ((< (interval-width intersection) (interval-width X)) (cons 'contracted intersection)) (else (cons 'no-improvement X))))))))"))
(task-entry (id "optimization/line-search/exact-quadratic-step") (skill optimization) (module line-search) (tier 1) (difficulty 12817) (name exact-quadratic-step) (type "") (description "") (notes ()) (section overview) (deps (\x27;prelude \x27;reverse-diff)) (available (*armijo-c1* *wolfe-c2* *backtrack-rho* *max-ls-iters* *initial-step* *default-alpha-max* dot-product vec-add-scaled armijo-condition? armijo-backtrack armijo-backtrack-full curvature-condition? strong-curvature-condition? wolfe-line-search wolfe-line-search-full wolfe-bracket wolfe-zoom)) (answer "(define (exact-quadratic-step grad direction hessian) (let* ((grad-dot-d (dot-product grad direction)) (d-vec (list->vector direction)) (n (length direction)) (hd (let loop ((i 0) (result '())) (if (= i n) (reverse result) (let ((row-sum (let inner ((j 0) (sum 0)) (if (= j n) sum (inner (+ j 1) (+ sum (* (matrix-ref hessian i j) (vector-ref d-vec j)))))))) (loop (+ i 1) (cons row-sum result)))))) (d-hessian-d (dot-product direction hd))) (if (< (abs d-hessian-d) 1e-15) 1.0 (/ (- grad-dot-d) d-hessian-d))))"))
