(task-entry (id "linalg/vec/vec-distance") (skill linalg) (module vec) (tier 0) (difficulty 429) (name vec-distance) (type "(-> (Vec Num) (Vec Num) (Or Num Error))") (description "Euclidean distance between two vectors") (notes ()) (section vector-products-and-norms) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop vec-slice vec-add vec-sub vec-mul vec-div vec-scale vec-negate vec-dot vec-norm-squared vec-norm vec-norm-l1 vec-norm-linf vec-normalize)) (answer "(define (vec-distance v1 v2) (let ((diff (vec-sub v1 v2))) (if (and (pair? diff) (eq? (car diff) 'error)) diff (vec-norm diff))))"))
