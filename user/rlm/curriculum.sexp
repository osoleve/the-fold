(task-entry (id "random/monte-carlo/autocorrelation") (skill random) (module monte-carlo) (tier 1) (difficulty 12934) (name autocorrelation) (type "") (description "") (notes ()) (section convergence-diagnostics) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate antithetic-integrate control-variate-estimate stratified-sample effective-sample-size split-into-batches gelman-rubin)) (answer "(define (autocorrelation samples k) (let* ((n (length samples)) (mu (sample-mean samples)) (centered (map (lambda (x) (- x mu)) samples)) (c0 (fold-left + 0 (map (lambda (x) (* x x)) centered))) (ck (let loop ((i 0) (sum 0)) (if (>= (+ i k) n) sum (loop (+ i 1) (+ sum (* (list-ref centered i) (list-ref centered (+ i k))))))))) (if (> c0 0) (/ ck c0) 0)))"))
(task-entry (id "random/variational-inference/elbo-gradient-mf") (skill random) (module variational-inference) (tier 1) (difficulty 12934) (name elbo-gradient-mf) (type "") (description "") (notes ()) (section elbo-gradient-via-reparameterization) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy)) (answer "(define (elbo-gradient-mf traced-log-joint means log-stds epsilons) (let* ((d (length means)) (params (append means log-stds))) (gradient (lambda traced-params-spread (let* ((t-means (take-traced traced-params-spread d)) (t-log-stds (drop-traced traced-params-spread d)) (t-z (map (lambda (t-mu t-log-s eps) (traced-add t-mu (traced-mul (traced-exp t-log-s) (make-traced-const eps #f)))) t-means t-log-stds epsilons)) (t-log-p (traced-log-joint t-z)) (t-entropy (sum-traced t-log-stds))) (traced-add t-log-p t-entropy))) params)))"))
(task-entry (id "random/prng/random-list") (skill random) (module prng) (tier 1) (difficulty 12935) (name random-list) (type "") (description "Generate list of n random values. Tail-recursive to support large n.") (notes ()) (section generating-multiple-random-values) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float random-float-range random-int-range random-bool random-element shuffle sample weighted-choice)) (answer "(define (random-list n gen) (letrec ((loop (lambda (remaining acc) (if (<= remaining 0) (state-pure (reverse acc)) (state-bind gen (lambda (x) (loop (- remaining 1) (cons x acc)))))))) (loop n '())))"))
