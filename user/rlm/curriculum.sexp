(task-entry (id "topology/simplicial-complex/sc-contains?") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11826) (name sc-contains?) (type "(-> SC Simplex Boolean)") (description "Check if a simplex is in the complex") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices)) (answer "(define (sc-contains? sc s) (let* ((dim (simplex-dim s)) (vec (sc-simplices-by-dim sc))) (if (>= dim (vector-length vec)) #f (simplex-in-list? s (vector-ref vec dim)))))"))
(task-entry (id "topology/homology/make-torus") (skill topology) (module homology) (tier 1) (difficulty 11826) (name make-torus) (type "(-> SC)") (description "Create a triangulation of the torus T^2 = S^1 x S^1") (notes ("Uses a 3x3 grid with opposite edges identified. 9 vertices, 27 edges, 18 triangles" "Expected Betti numbers (over Z_2): (1 2 1)\n  B_0 = 1 (connected)\n  B_1 = 2 (two independent loops: meridian and longitude)\n  B_2 = 1 (the surface bounds a void)" "Euler characteristic: X = 9 - 27 + 18 = 0 = 1 - 2 + 1" "Vertex layout (3x3 grid with wrap-around):\n  0-1-2-0\n  |\\|\\|\\|\n  3-4-5-3\n  |\\|\\|\\|\n  6-7-8-6\n  |\\|\\|\\|\n  0-1-2-0")) (section standard-spaces) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti sc-betti-numbers sc-homology-summary make-sphere)) (answer "(define (make-torus) (sc-from-simplices (map (lambda (vs) (make-simplex vs)) '((0 1 4) (0 3 4) (1 2 5) (1 4 5) (2 0 3) (2 5 3) (3 4 7) (3 6 7) (4 5 8) (4 7 8) (5 3 6) (5 8 6) (6 7 1) (6 0 1) (7 8 2) (7 1 2) (8 6 0) (8 2 0)))))"))
(task-entry (id "topology/persistent/persistence-birth-times") (skill topology) (module persistent) (tier 1) (difficulty 11826) (name persistence-birth-times) (type "(-> PersistenceResult Vector)") (description "") (notes ()) (section persistence-result) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential)) (answer "(define (persistence-birth-times pr) (cadddr pr))"))
(task-entry (id "topology/simplicial-complex/sc-simplices") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11827) (name sc-simplices) (type "(-> SC (List Simplex))") (description "Get all simplices in the complex as a flat list") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains?)) (answer "(define (sc-simplices sc) (let* ((vec (sc-simplices-by-dim sc)) (n (vector-length vec))) (let loop ((i 0) (acc '())) (if (>= i n) (reverse acc) (loop (+ i 1) (append (reverse (vector-ref vec i)) acc))))))"))
(task-entry (id "topology/homology/make-klein-bottle") (skill topology) (module homology) (tier 1) (difficulty 11827) (name make-klein-bottle) (type "(-> SC)") (description "Triangulation of the Klein bottle") (notes ("Expected Betti numbers (over Z_2): (1 2 1)" "Over Z, B_2 = 0 because Klein bottle is non-orientable. Over Z_2, we get B_2 = 1 because Z_2 doesn't see orientation")) (section standard-spaces) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti sc-betti-numbers sc-homology-summary make-sphere make-torus)) (answer "(define (make-klein-bottle) (sc-from-simplices (map (lambda (vs) (make-simplex vs)) '((0 1 4) (0 3 4) (1 2 5) (1 4 5) (2 0 3) (2 5 3) (3 4 7) (3 6 7) (4 5 8) (4 7 8) (5 3 6) (5 8 6) (6 7 1) (6 2 1) (7 8 0) (7 1 0) (8 6 2) (8 0 2)))))"))
(task-entry (id "topology/persistent/persistence-simplices") (skill topology) (module persistent) (tier 1) (difficulty 11827) (name persistence-simplices) (type "(-> PersistenceResult Vector)") (description "") (notes ()) (section persistence-result) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times)) (answer "(define (persistence-simplices pr) (car (cddddr pr)))"))
(task-entry (id "topology/simplicial-complex/sc-simplices-dim") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11828) (name sc-simplices-dim) (type "(-> SC Integer (List Simplex))") (description "Get all simplices of a specific dimension") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices)) (answer "(define (sc-simplices-dim sc k) (let ((vec (sc-simplices-by-dim sc))) (if (or (< k 0) (>= k (vector-length vec))) '() (vector-ref vec k))))"))
(task-entry (id "topology/homology/make-projective-plane") (skill topology) (module homology) (tier 1) (difficulty 11828) (name make-projective-plane) (type "(-> SC)") (description "Triangulation of the real projective plane RP^2") (notes ("Expected Betti numbers (over Z_2): (1 1 1). Over Z: (1 0 0) because RP^2 is non-orientable")) (section standard-spaces) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti sc-betti-numbers sc-homology-summary make-sphere make-torus make-klein-bottle)) (answer "(define (make-projective-plane) (sc-from-simplices (map (lambda (vs) (make-simplex vs)) '((0 1 2) (0 2 3) (0 3 4) (0 4 5) (0 1 5) (1 2 5) (2 3 5) (3 4 5) (1 3 4) (1 2 4)))))"))
(task-entry (id "topology/persistent/make-persistence-diagram") (skill topology) (module persistent) (tier 1) (difficulty 11828) (name make-persistence-diagram) (type "(-> PersistenceResult PersistenceDiagram)") (description "Extract persistence diagram from reduction result") (notes ()) (section persistence-diagram) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices)) (answer "(define (make-persistence-diagram pr) (let* ((pairs (persistence-pairs pr)) (essential (persistence-essential pr)) (times (persistence-birth-times pr)) (simplices (persistence-simplices pr)) (finite-points (map (lambda (pair) (let* ((i (car pair)) (j (cdr pair)) (birth (vector-ref times i)) (death (vector-ref times j)) (dim (simplex-dim (vector-ref simplices i)))) (list birth death dim))) pairs)) (essential-points (append-map (lambda (dim-group) (let ((dim (car dim-group)) (indices (cdr dim-group))) (map (lambda (i) (list (vector-ref times i) +inf.0 dim)) indices))) essential))) (list 'persistence-diagram (append finite-points essential-points))))"))
(task-entry (id "topology/simplicial-complex/sc-vertices") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11829) (name sc-vertices) (type "(-> SC (List Vertex))") (description "Get all vertices (0-simplices) in the complex") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim)) (answer "(define (sc-vertices sc) (map (lambda (s) (car (simplex-vertices s))) (sc-simplices-dim sc 0)))"))
(task-entry (id "topology/homology/sc-connected-components") (skill topology) (module homology) (tier 1) (difficulty 11829) (name sc-connected-components) (type "(-> SC Integer)") (description "Count connected components using union-find") (notes ("This gives the same result as B_0 but via direct computation")) (section connected-components) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti sc-betti-numbers sc-homology-summary make-sphere make-torus make-klein-bottle make-projective-plane)) (answer "(define (sc-connected-components sc) (let* ((vertices (sc-vertices sc)) (n (length vertices)) (parent (make-vector n)) (rank-vec (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! parent i i)) (letrec ((find (lambda (x) (if (= (vector-ref parent x) x) x (let ((root (find (vector-ref parent x)))) (vector-set! parent x root) root)))) (union (lambda (x y) (let ((px (find x)) (py (find y))) (unless (= px py) (let ((rx (vector-ref rank-vec px)) (ry (vector-ref rank-vec py))) (cond ((< rx ry) (vector-set! parent px py)) ((> rx ry) (vector-set! parent py px)) (else (vector-set! parent py px) (vector-set! rank-vec px (+ rx 1)))))))))) (for-each (lambda (edge) (let* ((vs (simplex-vertices edge)) (v1-idx (list-index (car vs) vertices)) (v2-idx (list-index (cadr vs) vertices))) (when (and v1-idx v2-idx) (union v1-idx v2-idx)))) (sc-edges sc)) (let ((roots (make-vector n #f))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! roots (find i) #t)) (let loop ((i 0) (count 0)) (if (= i n) count (loop (+ i 1) (if (vector-ref roots i) (+ count 1) count))))))))"))
(task-entry (id "topology/persistent/persistence-diagram?") (skill topology) (module persistent) (tier 1) (difficulty 11829) (name persistence-diagram?) (type "(-> α Boolean)") (description "") (notes ()) (section persistence-diagram) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram)) (answer "(define (persistence-diagram? x) (and (pair? x) (eq? (car x) 'persistence-diagram)))"))
(task-entry (id "topology/simplicial-complex/sc-edges") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11830) (name sc-edges) (type "(-> SC (List Simplex))") (description "Get all edges (1-simplices) in the complex") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim sc-vertices)) (answer "(define (sc-edges sc) (sc-simplices-dim sc 1))"))
(task-entry (id "topology/homology/list-index") (skill topology) (module homology) (tier 1) (difficulty 11830) (name list-index) (type "(-> α (List α) (Or Integer #f))") (description "") (notes ()) (section connected-components) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti sc-betti-numbers sc-homology-summary make-sphere make-torus make-klein-bottle make-projective-plane sc-connected-components)) (answer "(define (list-index x lst) (let loop ((remaining lst) (idx 0)) (cond ((null? remaining) #f) ((equal? x (car remaining)) idx) (else (loop (cdr remaining) (+ idx 1))))))"))
