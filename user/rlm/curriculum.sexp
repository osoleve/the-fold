(task-entry (id "geometry/mesh-sdf/vec3-coords<?") (skill geometry) (module mesh-sdf) (tier 1) (difficulty 12210) (name vec3-coords<?) (type "") (description "") (notes ()) (section mesh-construction-helpers) (deps (\x27;prelude \x27;geometry \x27;bvh)) (available (make-mesh mesh? mesh-triangles mesh-bvh mesh-sdf mesh-sdf-gradient make-mesh-cube subdivide-icosphere-triangles subdivide-icosphere-once vec3-edge-key)) (answer "(define (vec3-coords<? a b) (cond ((< (car a) (car b)) #t) ((> (car a) (car b)) #f) ((< (cadr a) (cadr b)) #t) ((> (cadr a) (cadr b)) #f) (else (< (caddr a) (caddr b)))))"))
(task-entry (id "geometry/mesh-gen/location?") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12210) (name location?) (type "") (description "") (notes ()) (section triangulation) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location)) (answer "(define (location? x) (and (vector? x) (> (vector-length x) 0) (eq? (vector-ref x 0) 'location)))"))
(task-entry (id "geometry/mesh-topology/mesh-genus") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12210) (name mesh-genus) (type "(-> Mesh (Union Integer Symbol))") (description "Compute the genus of a closed orientable surface: χ = 2 - 2g → g = (2 - χ) / 2") (notes ()) (section genus-computation) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex mesh-betti-numbers mesh-euler-characteristic mesh-f-vector mesh-connected-components)) (answer "(define (mesh-genus mesh) (let* ((betti (mesh-betti-numbers mesh)) (b0 (if (pair? betti) (car betti) 0)) (b2 (if (>= (length betti) 3) (caddr betti) 0)) (euler (mesh-euler-characteristic mesh))) (cond ((not (= b0 1)) 'disconnected) ((not (= b2 1)) 'open) (else (let ((g (/ (- 2 euler) 2))) (if (integer? g) (inexact->exact g) 'non-orientable))))))"))
(task-entry (id "geometry/convex-hull/find-extreme-points") (skill geometry) (module convex-hull) (tier 1) (difficulty 12210) (name find-extreme-points) (type "") (description "") (notes ()) (section quickhull) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance)) (answer "(define (find-extreme-points points) (let loop ((remaining (cdr points)) (left (car points)) (right (car points))) (if (null? remaining) (values left right) (let ((p (car remaining))) (loop (cdr remaining) (if (< (point2-x p) (point2-x left)) p left) (if (> (point2-x p) (point2-x right)) p right))))))"))
