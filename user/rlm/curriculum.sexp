(task-entry (id "algebra/galois/poly-irreducible?") (skill algebra) (module galois) (tier 0) (difficulty 336) (name poly-irreducible?) (type "(-> Polynomial Boolean)") (description "Test if polynomial is irreducible over its coefficient field") (notes ("Uses Rabin's O(d² log q) test for finite fields, trial division otherwise")) (section irreducible-polynomials) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod unique-prime-divisors poly-frobenius-power rabin-irreducible?)) (answer "(define (poly-irreducible? p) (let* ((F (poly-field p)) (d (poly-degree p))) (cond ((< d 1) #f) ((= d 1) #t) (else (let ((order (gf-order F))) (if (and order (> order 0)) (rabin-irreducible? p order) (not (poly-has-factor-up-to-degree? p (quotient d 2) F))))))))"))
(task-entry (id "algebra/group/make-dihedral-group") (skill algebra) (module group) (tier 0) (difficulty 337) (name make-dihedral-group) (type "(-> Integer Group)") (description "Create the dihedral group D_n") (notes ()) (section dihedral-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity dihedral-op dihedral-inverse)) (answer "(define (make-dihedral-group n) (let* ((rotations (map (lambda (k) (cons 'r k)) (iota n))) (reflections (map (lambda (k) (cons 's k)) (iota n))) (elements (append rotations reflections)) (op (dihedral-op n)) (identity (cons 'r 0)) (inverse-fn (dihedral-inverse n)) (equal-fn equal?)) (make-group elements op identity inverse-fn equal-fn)))"))
