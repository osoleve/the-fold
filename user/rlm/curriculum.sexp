(task-entry (id "data/pagerank/top-k-nodes") (skill data) (module pagerank) (tier 0) (difficulty 1313) (name top-k-nodes) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations* adjacency->transition matrix-row-sum matrix-col-sum make-google-matrix pagerank-from-matrix pagerank-power-iteration vec-norm-1 vec-sum pagerank personalized-pagerank)) (answer "(define (top-k-nodes scores k) (let* ((n (vector-length scores)) (pairs (let loop ((i 0) (acc '())) (if (>= i n) acc (loop (+ i 1) (cons (cons i (vector-ref scores i)) acc)))))) (let ((sorted (sort-by (lambda (a b) (> (cdr a) (cdr b))) pairs))) (if (<= k (length sorted)) (take k sorted) sorted))))"))
