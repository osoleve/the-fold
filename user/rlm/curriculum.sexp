(task-entry (id "info/coding/hamming74-syndrome") (skill info) (module coding) (tier 1) (difficulty 11144) (name hamming74-syndrome) (type "(-> (List Nat) Nat)") (description "Calculate syndrome (0 means no error)") (notes ()) (section hamming-code) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob huffman-codes huffman-codes-helper huffman-encode huffman-decode huffman-decode-helper huffman-average-length huffman-efficiency arithmetic-encode arithmetic-encode-helper build-cumulative-probs arithmetic-decode arithmetic-decode-helper find-symbol-for-code arithmetic-code-length lz78-encode lz78-encode-helper lz78-find-longest-match prefix-match-length lz78-decode lz78-decode-helper take-n drop-n rle-encode rle-encode-helper rle-decode parity-encode parity-check parity-decode bitwise-xor repetition-encode repetition-decode majority-vote hamming74-encode hamming74-decode flip-bit-at)) (answer "(define (hamming74-syndrome codeword) (let* ((p1 (list-ref codeword 0)) (p2 (list-ref codeword 1)) (d1 (list-ref codeword 2)) (p4 (list-ref codeword 3)) (d2 (list-ref codeword 4)) (d3 (list-ref codeword 5)) (d4 (list-ref codeword 6)) (s1 (bitwise-xor (bitwise-xor (bitwise-xor p1 d1) d2) d4)) (s2 (bitwise-xor (bitwise-xor (bitwise-xor p2 d1) d3) d4)) (s4 (bitwise-xor (bitwise-xor (bitwise-xor p4 d2) d3) d4))) (+ s1 (* 2 s2) (* 4 s4))))"))
