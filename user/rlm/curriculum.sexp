(task-entry (id "random/probability/weight-prob") (skill random) (module probability) (tier 1) (difficulty 12909) (name weight-prob) (type "") (description "") (notes ()) (section running-probability-computations) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob)) (answer "(define (weight-prob p prng) (cdr (car (run-prob p prng))))"))
(task-entry (id "random/bayesian/make-normal-prior") (skill random) (module bayesian) (tier 1) (difficulty 12909) (name make-normal-prior) (type "") (description "") (notes ()) (section conjugate-prior-normal-normal-known-variance) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval)) (answer "(define (make-normal-prior mean variance) (quasiquote (normal-prior (unquote mean) (unquote variance))))"))
(task-entry (id "random/monte-carlo/mc-integrate") (skill random) (module monte-carlo) (tier 1) (difficulty 12909) (name mc-integrate) (type "") (description "") (notes ()) (section basic-monte-carlo-integration) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary)) (answer "(define (mc-integrate f a b n) (let ((width (- b a))) (state-bind (random-list n (random-float-range a b)) (lambda (samples) (let* ((fvals (map f samples)) (mu (sample-mean fvals)) (estimate (* width mu)) (variance (sample-variance fvals)) (se (* width (sqrt (/ variance n))))) (state-pure (cons estimate se)))))))"))
(task-entry (id "random/variational-inference/mf-gaussian-reparam-traced") (skill random) (module variational-inference) (tier 1) (difficulty 12909) (name mf-gaussian-reparam-traced) (type "") (description "") (notes ()) (section reparameterization-trick) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam)) (answer "(define (mf-gaussian-reparam-traced t-means t-log-stds epsilons) (map (lambda (t-mu t-log-s eps) (traced-add t-mu (traced-mul (traced-exp t-log-s) (make-traced-const eps #f)))) t-means t-log-stds epsilons))"))
