(task-entry (id "fp/expr/product") (skill fp) (module expr) (tier 1) (difficulty 10610) (name product) (type "(-> Expr Expr Expr)") (description "Create product with basic simplifications") (notes ()) (section smart-constructors) (deps (\x27;prelude)) (available (num var make-sum make-product make-diff make-neg make-div make-pow make-app sum)) (answer "(define (product e1 e2) (cond ((and (num? e1) (= (num-val e1) 0)) (num 0)) ((and (num? e2) (= (num-val e2) 0)) (num 0)) ((and (num? e1) (= (num-val e1) 1)) e2) ((and (num? e2) (= (num-val e2) 1)) e1) ((and (num? e1) (num? e2)) (num (* (num-val e1) (num-val e2)))) (else (list '* e1 e2))))"))
(task-entry (id "fp/diff/curl") (skill fp) (module diff) (tier 1) (difficulty 10610) (name curl) (type "(-> (List Expr) (List Symbol) (List Expr))") (description "Compute curl of 3D vector field F = [F₁, F₂, F₃]") (notes ("vars should be [x, y, z], returns [∂F₃/∂y - ∂F₂/∂z, ∂F₁/∂z - ∂F₃/∂x, ∂F₂/∂x - ∂F₁/∂y]")) (section curl) (deps (\x27;expr)) (available (fold-sum fold-product deriv deriv-fn partial gradient jacobian hessian deriv-n directional-derivative)) (answer "(define (curl field vars) (let ((F1 (car field)) (F2 (cadr field)) (F3 (caddr field)) (x (car vars)) (y (cadr vars)) (z (caddr vars))) (list (difference (deriv F3 y) (deriv F2 z)) (difference (deriv F1 z) (deriv F3 x)) (difference (deriv F2 x) (deriv F1 y)))))"))
(task-entry (id "fp/simplify/collect-like-bases") (skill fp) (module simplify) (tier 1) (difficulty 10610) (name collect-like-bases) (type "(-> (List Expr) (List Expr))") (description "Collect terms with same base: x * x → x^2") (notes ()) (section product-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products)) (answer "(define (collect-like-bases factors) (let ((table (make-hashtable equal-hash equal?))) (for-each (lambda (factor) (let-values (((base exp) (extract-base-exponent factor))) (let ((current (hashtable-ref table base (num 0)))) (hashtable-set! table base (sum current exp))))) factors) (let* ((keys (vector->list (hashtable-keys table))) (sorted-keys (sort-by (lambda (a b) (< (expr-complexity a) (expr-complexity b))) keys))) (filter-map (lambda (key) (let ((exp (simplify (hashtable-ref table key (num 0))))) (cond ((and (num? exp) (= (num-val exp) 0)) #f) ((and (num? exp) (= (num-val exp) 1)) key) (else (power key exp))))) sorted-keys))))"))
(task-entry (id "fp/integrate/try-substitution-pattern") (skill fp) (module integrate) (tier 1) (difficulty 10610) (name try-substitution-pattern) (type "") (description "") (notes ()) (section u-substitution) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power integrate-quotient integrate-by-substitution)) (answer "(define (try-substitution-pattern expr var-sym depth) (if (not (product? expr)) #f (let ((factors (product-factors expr))) (let loop ((i 0)) (if (>= i (length factors)) #f (let* ((potential-du (list-ref factors i)) (other-factors (remove-at-index factors i)) (potential-u (find-antiderivative-match other-factors potential-du var-sym depth))) (if potential-u potential-u (loop (+ i 1)))))))))"))
(task-entry (id "fp/solve/is-polynomial?") (skill fp) (module solve) (tier 1) (difficulty 10610) (name is-polynomial?) (type "") (description "") (notes ()) (section equation-representation) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients)) (answer "(define (is-polynomial? expr var-sym) (cond ((num? expr) #t) ((var? expr) #t) ((sum? expr) (for-all (lambda (t) (is-polynomial? t var-sym)) (sum-terms expr))) ((product? expr) (for-all (lambda (f) (is-polynomial? f var-sym)) (product-factors expr))) ((difference? expr) (and (is-polynomial? (diff-left expr) var-sym) (or (not (diff-right expr)) (is-polynomial? (diff-right expr) var-sym)))) ((power? expr) (and (num? (pow-exp expr)) (integer? (num-val (pow-exp expr))) (>= (num-val (pow-exp expr)) 0) (is-polynomial? (pow-base expr) var-sym))) ((quotient? expr) (and (not (contains-var? (quot-denom expr) var-sym)) (is-polynomial? (quot-numer expr) var-sym))) (else #f)))"))
(task-entry (id "fp/poly-canonical/make-term") (skill fp) (module poly-canonical) (tier 1) (difficulty 10610) (name make-term) (type "") (description "") (notes ()) (section conversion) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial polynomial-expr? expr-degree extract-poly-coeffs extract-coeff-at extract-coeff-expanded extract-coeff-product expr-eval-at-zero polynomial->expr)) (answer "(define (make-term c k x) (cond ((= k 0) (num c)) ((= k 1) (if (= c 1) x (product (num c) x))) ((= c 1) (power x (num k))) (else (product (num c) (power x (num k))))))"))
