(task-entry (id "random/monte-carlo/self-normalized-importance-sample") (skill random) (module monte-carlo) (tier 1) (difficulty 12912) (name self-normalized-importance-sample) (type "") (description "") (notes ()) (section importance-sampling) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample)) (answer "(define (self-normalized-importance-sample f weight-fn proposal-sampler n) (state-bind (random-list n proposal-sampler) (lambda (samples) (let* ((weights (map weight-fn samples)) (fvals (map f samples)) (weighted-vals (map * fvals weights)) (total-weight (fold-left + 0 weights)) (sum-sq-weights (fold-left + 0 (map (lambda (w) (* w w)) weights))) (estimate (if (> total-weight 0) (/ (fold-left + 0 weighted-vals) total-weight) 0)) (ess (if (> sum-sq-weights 0) (/ (* total-weight total-weight) sum-sq-weights) 0))) (state-pure (cons estimate ess))))))"))
(task-entry (id "random/variational-inference/mf-gaussian-entropy") (skill random) (module variational-inference) (tier 1) (difficulty 12912) (name mf-gaussian-entropy) (type "") (description "") (notes ()) (section log-probabilities-for-variational-families) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob)) (answer "(define (mf-gaussian-entropy vfamily) (let ((log-stds (mf-gaussian-log-stds vfamily))) (* (length log-stds) (+ 0.5 (* 0.5 (log (* 2 3.141592653589793))) (fold-left + 0 log-stds)))))"))
(task-entry (id "random/prng/make-pcg") (skill random) (module prng) (tier 1) (difficulty 12913) (name make-pcg) (type "(-> Int Int RNG)") (description "Create PCG state from seed and stream id. Different stream IDs give independent sequences") (notes ()) (section pcg) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random)) (answer "(define (make-pcg seed stream) (let* ((inc (u64 (bitwise-ior (ash stream 1) 1))) (state0 0) (state1 (u64 (+ (* state0 6364136223846793005) inc))) (state2 (u64 (+ state1 (u64 seed)))) (state3 (u64 (+ (* state2 6364136223846793005) inc)))) (list 'pcg state3 inc)))"))
