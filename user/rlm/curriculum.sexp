(task-entry (id "game-theory/mcdm/weighted-borda-scores") (skill game-theory) (module mcdm) (tier 1) (difficulty 13216) (name weighted-borda-scores) (type "(-> DecisionProblem (List Real) (List (Pair Alternative Real)))") (description "Compute weighted Borda scores. Returns (alternative . score) pairs, highest first. Allows continuous weights unlike vote repetition") (notes ()) (section weighted-borda) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking)) (answer "(define (weighted-borda-scores dp weights) (let* ((alts (dp-alternatives dp)) (criteria (dp-criteria dp)) (n (length alts)) (borda (borda-scores n))) (if (not (= (length criteria) (length weights))) (error 'weighted-borda-scores \"weights length must match criteria count\") (let ((alt-scores (map (lambda (alt) (cons alt (apply + (map (lambda (c w) (let* ((ranking (criterion-ranking dp c)) (pos (position-of alt ranking))) (if pos (* w (list-ref borda pos)) 0))) criteria weights)))) alts))) (sort-by (lambda (a b) (> (cdr a) (cdr b))) alt-scores)))))"))
(task-entry (id "game-theory/normal-form/eliminate-strategy-p1") (skill game-theory) (module normal-form) (tier 1) (difficulty 13217) (name eliminate-strategy-p1) (type "(-> Game Nat Game)") (description "Create new game with P1's strategy i removed") (notes ()) (section iesds) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies)) (answer "(define (eliminate-strategy-p1 game i) (let* ((s1 (game%-strategies1 game)) (s2 (game%-strategies2 game)) (payoffs (game%-payoffs game)) (n1 (vector-length s1)) (new-s1 (list->vector (filter (lambda (x) x) (map (lambda (k) (if (= k i) #f (vector-ref s1 k))) (iota n1))))) (new-payoffs (list->vector (filter (lambda (x) x) (map (lambda (k) (if (= k i) #f (vector-ref payoffs k))) (iota n1)))))) (make-game% new-s1 s2 new-payoffs)))"))
