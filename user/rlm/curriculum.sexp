(task-entry (id "fp/goals/make-eq-goal") (skill fp) (module goals) (tier 1) (difficulty 10603) (name make-eq-goal) (type "(-> Context Expr Expr (Optional Type) Goal)") (description "Create a goal to prove lhs = rhs.") (notes ()) (section equality-goals) (deps (\x27;prelude \x27;rule)) (available (goal? goal-type goal-context)) (answer "(define (make-eq-goal ctx lhs rhs . opts) (let ((carrier (if (null? opts) #f (car opts)))) (quasiquote ((type . eq) (context unquote ctx) (lhs unquote lhs) (rhs unquote rhs) (carrier unquote carrier)))))"))
