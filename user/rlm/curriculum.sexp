(task-entry (id "diffgeo/geodesics/adaptive-step-size") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10718) (name adaptive-step-size) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step)) (answer "(define (adaptive-step-size dt err tol order) (if (= err 0) (* dt *adaptive-max-scale*) (let* ((ratio (/ tol err)) (scale (* *adaptive-safety* (expt ratio (/ 1.0 order)))) (bounded-scale (max *adaptive-min-scale* (min *adaptive-max-scale* scale)))) (* dt bounded-scale))))"))
