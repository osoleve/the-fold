(task-entry (id "physics-problems/physics-problem/generate-problem-instance") (skill physics-problems) (module physics-problem) (tier 2) (difficulty 23609) (name generate-problem-instance) (type "") (description "") (notes ()) (section generation) (deps (\x27;prelude \x27;vec2 \x27;sample \x27;parameter \x27;presentation \x27;distractor \x27;difficulty \x27;simulation)) (available (make-physics-problem physics-problem? problem-name problem-category problem-params problem-world-setup problem-question-gen problem-answer-compute problem-difficulty)) (answer "(define (generate-problem-instance problem rng config) (let* ((params (param-set-sample (problem-params problem) rng 100)) (initial-world ((problem-world-setup problem) params)) (n-frames 8) (sim-result (capture-frames-with-final initial-world config n-frames)) (frames (car sim-result)) (final-world (cdr sim-result)) (question-text ((problem-question-gen problem) params)) (correct-answer ((problem-answer-compute problem) initial-world final-world params)) (options (generate-problem-options correct-answer (problem-category problem) rng)) (correct-label (find-correct-label options correct-answer)) (id (generate-problem-id (problem-name problem) rng)) (metadata (quasiquote ((category unquote (problem-category problem)) (difficulty unquote (difficulty-score-default (problem-difficulty problem))) (params unquote params))))) (make-sample id frames question-text options correct-label metadata)))"))
