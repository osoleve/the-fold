(task-entry (id "diffgeo/geodesics/log-map-adaptive") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10725) (name log-map-adaptive) (type "(-> Metric Vec Vec (Optional Num) (Optional Nat) (Or (Ok Vec) (Err String)))") (description "Logarithm map using adaptive shooting method") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final trace-geodesic-adaptive-at-times exp-map-adaptive exp-map-adaptive-t)) (answer "(define (log-map-adaptive metric p q . opts) (let* ((tol (if (null? opts) 1e-10 (car opts))) (max-iter (if (or (null? opts) (null? (cdr opts))) *geodesic-max-iterations* (cadr opts))) (n (vector-length p)) (v0 (vec-sub q p)) (eps 1e-6)) (let loop ((v v0) (iter 0)) (if (>= iter max-iter) (list 'err \"log-map-adaptive: failed to converge\") (let ((q-shot (exp-map-adaptive metric p v tol))) (if (not (vec-finite? q-shot)) (loop (vec-scale 0.5 v) (+ iter 1)) (let* ((error (vec-sub q-shot q)) (error-norm (vec-norm error))) (if (< error-norm (* tol 100)) (list 'ok v) (let ((J (compute-exp-jacobian-adaptive metric p v tol eps n))) (if (not J) (loop (vec-scale 0.5 v) (+ iter 1)) (let ((dv (solve-linear-system J (vec-scale -1 error)))) (if dv (loop (vec-add v dv) (+ iter 1)) (loop (vec-sub v (vec-scale 0.1 error)) (+ iter 1))))))))))))))"))
