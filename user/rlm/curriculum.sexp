(task-entry (id "physics/classical/ascii-renderer/draw-line!") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23536) (name draw-line!) (type "") (description "") (notes ()) (section line) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set!)) (answer "(define (draw-line! frame x0 y0 x1 y1 char config) (let* ((dx (abs (- x1 x0))) (dy (abs (- y1 y0))) (sx (if (< x0 x1) 1 -1)) (sy (if (< y0 y1) 1 -1)) (err (- dx dy))) (let loop ((x x0) (y y0) (err err)) (safe-frame-set! frame x y char config) (unless (and (= x x1) (= y y1)) (let ((e2 (* 2 err))) (let ((new-x (if (> e2 (- dy)) (+ x sx) x)) (new-y (if (< e2 dx) (+ y sy) y)) (new-err (+ err (if (> e2 (- dy)) (- dy) 0) (if (< e2 dx) dx 0)))) (loop new-x new-y new-err)))))))"))
(task-entry (id "physics/classical/integrators/body-spring-energy") (skill physics/classical) (module integrators) (tier 2) (difficulty 23537) (name body-spring-energy) (type "") (description "") (notes ()) (section energy) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet integrate-body-rk4 make-time-acc time-acc? time-acc-remaining time-acc-fixed-dt time-acc-max-steps time-acc-add time-acc-consume time-acc-alpha substep-body integrate-with-substeps interpolate-body gravity-force spring-force drag-force constant-force combine-forces body-kinetic-energy body-potential-energy)) (answer "(define (body-spring-energy body anchor k) (let ((dist (vec2-length (vec2-sub (body-pos body) anchor)))) (* 0.5 k dist dist)))"))
(task-entry (id "physics/classical/collision-detection/circle-polygon?") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23537) (name circle-polygon?) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold)) (answer "(define (circle-polygon? circle polygon) (if (point-in-polygon? (circle-center circle) polygon) #t (let ((center (circle-center circle)) (r (circle-radius circle)) (edges (polygon-edges polygon))) (let loop ((es edges)) (if (null? es) #f (let* ((edge (car es)) (v1 (car edge)) (v2 (cadr edge)) (closest (closest-point-on-segment center v1 v2)) (dist-sq (vec2-distance-sq center closest))) (if (<= dist-sq (* r r)) #t (loop (cdr es)))))))))"))
