(task-entry (id "dsl/partial-eval/bta-annotate") (skill dsl) (module partial-eval) (tier 1) (difficulty 11713) (name bta-annotate) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt? bt-join bt-meet bt<=? make-bt-env bt-env-extend bt-env-lookup bt-env-extend-many pe-primitive? bta)) (answer "(define (bta-annotate expr env) (let ((bt (bta expr env))) (cond ((or (number? expr) (boolean? expr) (string? expr) (null? expr) (symbol? expr)) (list 'ann bt expr)) ((and (pair? expr) (eq? (car expr) 'quote)) (list 'ann bt expr)) ((and (pair? expr) (eq? (car expr) 'lambda)) (let* ((params (cadr expr)) (body (caddr expr)) (body-env (bt-env-extend-many env params (map (lambda (_) bt-dynamic) params)))) (list 'ann bt (quasiquote (lambda (unquote params) (unquote (bta-annotate body body-env))))))) ((and (pair? expr) (eq? (car expr) 'if)) (let ((cond-ann (bta-annotate (cadr expr) env)) (then-ann (bta-annotate (caddr expr) env)) (else-ann (if (null? (cdddr expr)) #f (bta-annotate (cadddr expr) env)))) (list 'ann bt (quasiquote (if (unquote cond-ann) (unquote then-ann) (unquote-splicing (if else-ann (list else-ann) '()))))))) ((and (pair? expr) (eq? (car expr) 'let)) (let* ((bindings (cadr expr)) (body (caddr expr)) (binding-anns (map (lambda (b) (list (car b) (bta-annotate (cadr b) env))) bindings)) (binding-bts (map (lambda (b) (bta (cadr b) env)) bindings)) (body-env (bt-env-extend-many env (map car bindings) binding-bts))) (list 'ann bt (quasiquote (let (unquote binding-anns) (unquote (bta-annotate body body-env))))))) ((pair? expr) (list 'ann bt (map (lambda (e) (bta-annotate e env)) expr))) (else (list 'ann bt expr)))))"))
