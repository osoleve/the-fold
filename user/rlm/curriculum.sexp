(task-entry (id "info/channel-capacity/qary-symmetric-capacity") (skill info) (module channel-capacity) (tier 1) (difficulty 11121) (name qary-symmetric-capacity) (type "") (description "") (notes ()) (section blahut-arimoto-algorithm) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity awgn-capacity-db awgn-capacity-bandwidth snr-for-capacity dmc-mutual-information dmc-output-distribution dmc-joint-distribution dmc-capacity-symmetric make-uniform-dist blahut-arimoto ba-iterate ba-compute-phi ba-update-dist dmc-capacity-upper-bound dmc-capacity-lower-bound)) (answer "(define (qary-symmetric-capacity q p) (cond ((<= q 1) 0) ((<= p 0) (log2 q)) ((>= p 1) 0) (else (- (log2 q) (+ (binary-entropy p) (* p (log2 (- q 1))))))))"))
