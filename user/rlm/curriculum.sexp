(task-entry (id "fp/combinators/intersperse") (skill fp) (module combinators) (tier 1) (difficulty 10659) (name intersperse) (type "(-> a (List a) (List a))") (description "Place element between each pair of elements") (notes ()) (section list-utilities) (deps (\x27;prelude \x27;sort)) (available (id identity const flip apply-fn compose2 compose pipe2 pipe >>> <<< curry2 uncurry2 curry3 uncurry3 partial partial2 rpartial on both pair-first pair-second bimap complement conjoin disjoin fst snd swap dup pair nothing just just? nothing? from-just maybe maybe-fmap maybe-bind filter-maybe cat-maybes sequence-maybe left right left? right? from-left from-right either either-fmap either-fmap-left either-bind from-either rights lefts partition-eithers head tail cons-if)) (answer "(define (intersperse sep xs) (if (or (null? xs) (null? (cdr xs))) xs (cons (car xs) (fold-right (lambda (x acc) (cons sep (cons x acc))) '() (cdr xs)))))"))
