(task-entry (id "physics/classical/collision-detection/make-box") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23526) (name make-box) (type "") (description "") (notes ()) (section shape) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center)) (answer "(define (make-box center half-extents) (let ((hx (vec2-x half-extents)) (hy (vec2-y half-extents)) (cx (vec2-x center)) (cy (vec2-y center))) (make-polygon (list (vec2 (- cx hx) (- cy hy)) (vec2 (+ cx hx) (- cy hy)) (vec2 (+ cx hx) (+ cy hy)) (vec2 (- cx hx) (+ cy hy))))))"))
