(task-entry (id "statistics/design-matrix/laguerre-features") (skill statistics) (module design-matrix) (tier 1) (difficulty 11220) (name laguerre-features) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p chebyshev-t hermite-h laguerre-l legendre-features chebyshev-features hermite-features)) (answer "(define (laguerre-features xs degree) (let* ((n (vector-length xs)) (ncols (+ degree 1)) (x-min (vec-min xs)) (scale (lambda (x) (- x x-min))) (data (make-vector (* n ncols)))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n ncols data)) (let ((xi (scale (vector-ref xs i)))) (do ((d 0 (+ d 1))) ((> d degree)) (vector-set! data (+ (* i ncols) d) (laguerre-l d xi)))))))"))
(task-entry (id "statistics/ma/make-toeplitz-ar") (skill statistics) (module ma) (tier 1) (difficulty 11220) (name make-toeplitz-ar) (type "") (description "") (notes ()) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (moving-average weighted-moving-average exponential-moving-average ma-fit center-series-ma autocovariance-ma innovations-algorithm ma-compute-residuals ma-residual-sigma make-ma-result ma-coefficients ma-intercept ma-residuals ma-sigma ma-order ma-forecast ma-forecast-se make-forecast-result standard-normal-quantile-ma arma-fit-simple)) (answer "(define (make-toeplitz-ar acf-vals p) (let ((data (make-vector (* p p)))) (do ((i 0 (+ i 1))) ((= i p)) (do ((j 0 (+ j 1))) ((= j p)) (vector-set! data (+ (* i p) j) (vector-ref acf-vals (abs (- i j)))))) (list 'matrix p p data)))"))
(task-entry (id "statistics/result-types/glm-se") (skill statistics) (module result-types) (tier 1) (difficulty 11221) (name glm-se) (type "") (description "") (notes ()) (section glm-results) (deps (\x27;prelude)) (available (make-linear-model-result linear-model? linear-model-coefficients linear-model-se linear-model-t-values linear-model-p-values linear-model-r-squared linear-model-adj-r-squared linear-model-residuals linear-model-fitted linear-model-sse linear-model-mse linear-model-n linear-model-p linear-model-df-residual linear-model-sigma make-glm-result glm-result? glm-family glm-link glm-coefficients)) (answer "(define (glm-se m) (list-ref m 4))"))
(task-entry (id "statistics/summary-stats/vec-quantiles") (skill statistics) (module summary-stats) (tier 1) (difficulty 11221) (name vec-quantiles) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max vec-median vec-quantile)) (answer "(define (vec-quantiles v ps) (quantiles (vector->list v) ps))"))
(task-entry (id "statistics/design-matrix/orthogonal-features") (skill statistics) (module design-matrix) (tier 1) (difficulty 11221) (name orthogonal-features) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p chebyshev-t hermite-h laguerre-l legendre-features chebyshev-features hermite-features laguerre-features)) (answer "(define (orthogonal-features xs degree basis) (case basis ((legendre) (legendre-features xs degree)) ((chebyshev) (chebyshev-features xs degree)) ((hermite) (hermite-features xs degree)) ((laguerre) (laguerre-features xs degree)) (else (error 'orthogonal-features \"unknown basis (use legendre, chebyshev, hermite, or laguerre)\" basis))))"))
(task-entry (id "statistics/ma/make-r-vector") (skill statistics) (module ma) (tier 1) (difficulty 11221) (name make-r-vector) (type "") (description "") (notes ()) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (moving-average weighted-moving-average exponential-moving-average ma-fit center-series-ma autocovariance-ma innovations-algorithm ma-compute-residuals ma-residual-sigma make-ma-result ma-coefficients ma-intercept ma-residuals ma-sigma ma-order ma-forecast ma-forecast-se make-forecast-result standard-normal-quantile-ma arma-fit-simple make-toeplitz-ar)) (answer "(define (make-r-vector acf-vals p) (let ((r (make-vector p))) (do ((k 0 (+ k 1))) ((= k p) r) (vector-set! r k (vector-ref acf-vals (+ k 1))))))"))
(task-entry (id "statistics/result-types/glm-z-values") (skill statistics) (module result-types) (tier 1) (difficulty 11222) (name glm-z-values) (type "") (description "") (notes ()) (section glm-results) (deps (\x27;prelude)) (available (make-linear-model-result linear-model? linear-model-coefficients linear-model-se linear-model-t-values linear-model-p-values linear-model-r-squared linear-model-adj-r-squared linear-model-residuals linear-model-fitted linear-model-sse linear-model-mse linear-model-n linear-model-p linear-model-df-residual linear-model-sigma make-glm-result glm-result? glm-family glm-link glm-coefficients glm-se)) (answer "(define (glm-z-values m) (list-ref m 5))"))
(task-entry (id "statistics/summary-stats/vec-covariance") (skill statistics) (module summary-stats) (tier 1) (difficulty 11222) (name vec-covariance) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max vec-median vec-quantile vec-quantiles)) (answer "(define (vec-covariance v1 v2) (let* ((n (vector-length v1))) (if (not (= n (vector-length v2))) (error 'vec-covariance \"vectors must have same length\") (let* ((mu1 (vec-mean v1)) (mu2 (vec-mean v2))) (if (<= n 1) 0 (let loop ((i 0) (s 0)) (if (= i n) (/ s (- n 1)) (loop (+ i 1) (+ s (* (- (vector-ref v1 i) mu1) (- (vector-ref v2 i) mu2)))))))))))"))
(task-entry (id "statistics/design-matrix/vec-min") (skill statistics) (module design-matrix) (tier 1) (difficulty 11222) (name vec-min) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p chebyshev-t hermite-h laguerre-l legendre-features chebyshev-features hermite-features laguerre-features orthogonal-features)) (answer "(define (vec-min v) (let ((n (vector-length v))) (if (= n 0) +inf.0 (let loop ((i 1) (m (vector-ref v 0))) (if (= i n) m (loop (+ i 1) (min m (vector-ref v i))))))))"))
(task-entry (id "statistics/ma/solve-toeplitz") (skill statistics) (module ma) (tier 1) (difficulty 11222) (name solve-toeplitz) (type "") (description "") (notes ()) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (moving-average weighted-moving-average exponential-moving-average ma-fit center-series-ma autocovariance-ma innovations-algorithm ma-compute-residuals ma-residual-sigma make-ma-result ma-coefficients ma-intercept ma-residuals ma-sigma ma-order ma-forecast ma-forecast-se make-forecast-result standard-normal-quantile-ma arma-fit-simple make-toeplitz-ar make-r-vector)) (answer "(define (solve-toeplitz R r p) (let* ((A (cadddr R)) (b (let ((v (make-vector p))) (do ((i 0 (+ i 1))) ((= i p) v) (vector-set! v i (vector-ref r i))))) (x (make-vector p 0))) (do ((iter 0 (+ iter 1))) ((= iter 100) x) (do ((i 0 (+ i 1))) ((= i p)) (let* ((sum (let loop ((j 0) (s 0)) (if (= j p) s (if (= i j) (loop (+ j 1) s) (loop (+ j 1) (+ s (* (vector-ref A (+ (* i p) j)) (vector-ref x j)))))))) (aii (vector-ref A (+ (* i p) i))) (bi (vector-ref b i)) (xi-new (if (< (abs aii) 1e-10) 0 (/ (- bi sum) aii)))) (vector-set! x i xi-new))))))"))
(task-entry (id "statistics/result-types/glm-p-values") (skill statistics) (module result-types) (tier 1) (difficulty 11223) (name glm-p-values) (type "") (description "") (notes ()) (section glm-results) (deps (\x27;prelude)) (available (make-linear-model-result linear-model? linear-model-coefficients linear-model-se linear-model-t-values linear-model-p-values linear-model-r-squared linear-model-adj-r-squared linear-model-residuals linear-model-fitted linear-model-sse linear-model-mse linear-model-n linear-model-p linear-model-df-residual linear-model-sigma make-glm-result glm-result? glm-family glm-link glm-coefficients glm-se glm-z-values)) (answer "(define (glm-p-values m) (list-ref m 6))"))
(task-entry (id "statistics/summary-stats/vec-correlation") (skill statistics) (module summary-stats) (tier 1) (difficulty 11223) (name vec-correlation) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max vec-median vec-quantile vec-quantiles vec-covariance)) (answer "(define (vec-correlation v1 v2) (let ((cov (vec-covariance v1 v2)) (s1 (vec-std-dev v1)) (s2 (vec-std-dev v2))) (if (or (= s1 0) (= s2 0)) 0 (/ cov (* s1 s2)))))"))
(task-entry (id "statistics/design-matrix/vec-max") (skill statistics) (module design-matrix) (tier 1) (difficulty 11223) (name vec-max) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p chebyshev-t hermite-h laguerre-l legendre-features chebyshev-features hermite-features laguerre-features orthogonal-features vec-min)) (answer "(define (vec-max v) (let ((n (vector-length v))) (if (= n 0) -inf.0 (let loop ((i 1) (m (vector-ref v 0))) (if (= i n) m (loop (+ i 1) (max m (vector-ref v i))))))))"))
(task-entry (id "statistics/ma/compute-ar-residuals") (skill statistics) (module ma) (tier 1) (difficulty 11223) (name compute-ar-residuals) (type "") (description "") (notes ()) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (moving-average weighted-moving-average exponential-moving-average ma-fit center-series-ma autocovariance-ma innovations-algorithm ma-compute-residuals ma-residual-sigma make-ma-result ma-coefficients ma-intercept ma-residuals ma-sigma ma-order ma-forecast ma-forecast-se make-forecast-result standard-normal-quantile-ma arma-fit-simple make-toeplitz-ar make-r-vector solve-toeplitz)) (answer "(define (compute-ar-residuals centered phi p) (let* ((n (vector-length centered)) (residuals (make-vector n 0))) (do ((t 0 (+ t 1))) ((= t n) residuals) (if (< t p) (vector-set! residuals t (vector-ref centered t)) (let* ((sum (let loop ((k 0) (s 0)) (if (= k p) s (loop (+ k 1) (+ s (* (vector-ref phi k) (vector-ref centered (- t k 1)))))))) (et (- (vector-ref centered t) sum))) (vector-set! residuals t et))))))"))
(task-entry (id "statistics/result-types/glm-deviance") (skill statistics) (module result-types) (tier 1) (difficulty 11224) (name glm-deviance) (type "") (description "") (notes ()) (section glm-results) (deps (\x27;prelude)) (available (make-linear-model-result linear-model? linear-model-coefficients linear-model-se linear-model-t-values linear-model-p-values linear-model-r-squared linear-model-adj-r-squared linear-model-residuals linear-model-fitted linear-model-sse linear-model-mse linear-model-n linear-model-p linear-model-df-residual linear-model-sigma make-glm-result glm-result? glm-family glm-link glm-coefficients glm-se glm-z-values glm-p-values)) (answer "(define (glm-deviance m) (list-ref m 7))"))
(task-entry (id "statistics/summary-stats/sem") (skill statistics) (module summary-stats) (tier 1) (difficulty 11224) (name sem) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max vec-median vec-quantile vec-quantiles vec-covariance vec-correlation)) (answer "(define (sem xs) (/ (std-dev xs) (sqrt (length xs))))"))
(task-entry (id "statistics/design-matrix/vec-std") (skill statistics) (module design-matrix) (tier 1) (difficulty 11224) (name vec-std) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p chebyshev-t hermite-h laguerre-l legendre-features chebyshev-features hermite-features laguerre-features orthogonal-features vec-min vec-max)) (answer "(define (vec-std v) (let* ((n (vector-length v)) (mu (vec-mean v))) (if (<= n 1) 0 (let ((ss (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (expt (- (vector-ref v i) mu) 2))))))) (sqrt (/ ss (- n 1)))))))"))
