(task-entry (id "fp/expr/expr->string") (skill fp) (module expr) (tier 1) (difficulty 10643) (name expr->string) (type "(-> Expr String)") (description "Convert expression to readable string") (notes ()) (section display) (deps (\x27;prelude)) (available (num var make-sum make-product make-diff make-neg make-div make-pow make-app sum product difference division power num? var? sum? product? difference? quotient? power? app? num-val var-name sum-terms product-factors diff-left diff-right quot-numer quot-denom pow-base pow-exp app-fn app-arg list-all-equal? expr=? match-expr bindings-consistent? merge-bindings match-list free-vars subst normalize-expr)) (answer "(define (expr->string e) (cond ((num? e) (number->string (num-val e))) ((var? e) (symbol->string (var-name e))) ((sum? e) (string-append \"(\" (string-join (map expr->string (sum-terms e)) \" + \") \")\")) ((product? e) (string-append \"(\" (string-join (map expr->string (product-factors e)) \" * \") \")\")) ((difference? e) (if (diff-right e) (string-append \"(\" (expr->string (diff-left e)) \" - \" (expr->string (diff-right e)) \")\") (string-append \"-\" (expr->string (diff-left e))))) ((quotient? e) (string-append \"(\" (expr->string (quot-numer e)) \" / \" (expr->string (quot-denom e)) \")\")) ((power? e) (string-append \"(\" (expr->string (pow-base e)) \"^\" (expr->string (pow-exp e)) \")\")) ((app? e) (string-append (symbol->string (app-fn e)) \"(\" (expr->string (app-arg e)) \")\")) (else \"?\")))"))
