(task-entry (id "physics/classical/ascii-renderer/draw-contact!") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23546) (name draw-contact!) (type "") (description "") (notes ()) (section debug:) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line! draw-filled-circle! polygon-scanline-intersections fill-between-pairs! draw-filled-polygon! draw-filled-aabb! draw-aabb-outline! fmod angle->arrow-char draw-velocity-vector!)) (answer "(define (draw-contact! frame point normal config) (let* ((screen-pt (world->screen point config)) (end-pos (vec2-add point (vec2-scale normal 0.5))) (screen-end (world->screen end-pos config))) (safe-frame-set! frame (car screen-pt) (cdr screen-pt) #\\* config) (draw-line! frame (car screen-pt) (cdr screen-pt) (car screen-end) (cdr screen-end) #\\: config)))"))
(task-entry (id "physics/classical/collision-detection/shapes-collide?") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23547) (name shapes-collide?) (type "") (description "") (notes ()) (section generic) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon? closest-point-on-segment circle-polygon-manifold project-polygon project-circle intervals-overlap polygon-polygon? polygon-polygon-manifold shape-type shape-aabb)) (answer "(define (shapes-collide? a b) (let ((type-a (shape-type a)) (type-b (shape-type b))) (cond ((and (eq? type-a 'aabb) (eq? type-b 'aabb)) (aabb-aabb? a b)) ((and (eq? type-a 'circle) (eq? type-b 'circle)) (circle-circle? a b)) ((and (eq? type-a 'circle) (eq? type-b 'aabb)) (circle-aabb? a b)) ((and (eq? type-a 'aabb) (eq? type-b 'circle)) (circle-aabb? b a)) ((and (eq? type-a 'circle) (eq? type-b 'polygon)) (circle-polygon? a b)) ((and (eq? type-a 'polygon) (eq? type-b 'circle)) (circle-polygon? b a)) ((and (eq? type-a 'polygon) (eq? type-b 'polygon)) (polygon-polygon? a b)) ((and (eq? type-a 'aabb) (eq? type-b 'polygon)) (polygon-polygon? (aabb-to-polygon a) b)) ((and (eq? type-a 'polygon) (eq? type-b 'aabb)) (polygon-polygon? a (aabb-to-polygon b))) (else #f))))"))
(task-entry (id "physics/classical/world/world-integrate-velocities!") (skill physics/classical) (module world) (tier 2) (difficulty 23547) (name world-integrate-velocities!) (type "") (description "") (notes ()) (section world) (deps (\x27;prelude \x27;vec2 \x27;integrators \x27;collision-detection \x27;collision-response \x27;raycasting \x27;constraints \x27;constraint-solver \x27;sort)) (available (make-entity entity? entity-id entity-body entity-shape entity-material entity-user-data entity-with-body entity-pos entity-vel entity-static? transform-shape entity-world-shape make-world-config config-fixed-dt config-max-substeps config-solver-iterations config-cell-size make-world world? world-entities world-gravity world-spatial-hash world-config world-time-acc world-constraints world-with-time-acc world-add-entity! world-remove-entity! world-get-entity world-entity-list world-update-entity! world-add-constraint! world-remove-constraint! world-get-constraint world-constraint-list world-update-constraint! make-force-acc force-acc-add! force-acc-get force-acc-clear! world-step! world-fixed-step! world-resolve-collision-velocities! world-correct-collision-positions! world-solve-constraint-velocities! world-correct-constraint-positions!)) (answer "(define (world-integrate-velocities! world dt) (let ((gravity (world-gravity world)) (entities (world-entity-list world))) (for-each (lambda (e) (unless (entity-static? e) (let* ((body (entity-body e)) (mass (body-mass body)) (inv-mass (body-inv-mass body)) (gravity-force (vec2-scale gravity mass)) (accel (vec2-scale gravity-force inv-mass)) (new-vel (vec2-add (body-vel body) (vec2-scale accel dt))) (new-body (body-with-vel body new-vel))) (world-update-entity! world (entity-id e) (lambda (ent) (entity-with-body ent new-body)))))) entities)))"))
