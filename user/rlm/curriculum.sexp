(task-entry (id "optics/format-iso/string-split") (skill optics) (module format-iso) (tier 1) (difficulty 11016) (name string-split) (type "(-> String Char (List String))") (description "Split string by delimiter character.") (notes ()) (section time) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string sexpr->bytevector bytevector->sexpr iso-sexpr-bytevector iso-list-vector iso-alist-keys-sorted iso-number-string iso-exact-inexact iso-bool-int iso-bool-symbol iso-null-nothing iso-false-nothing)) (answer "(define (string-split str delim) (let loop ((chars (string->list str)) (current '()) (result '())) (cond ((null? chars) (reverse (cons (list->string (reverse current)) result))) ((char=? (car chars) delim) (loop (cdr chars) '() (cons (list->string (reverse current)) result))) (else (loop (cdr chars) (cons (car chars) current) result)))))"))
(task-entry (id "optics/schema/field-coerce-to-number-iso") (skill optics) (module schema) (tier 1) (difficulty 11016) (name field-coerce-to-number-iso) (type "(-> Symbol (PIso Alist Alist))") (description "Convert a field's value to number") (notes ()) (section type-coercion) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso field-split-iso field-merge-iso field-move-to-front-iso nested-field-iso field-ensure-iso field-with-default-iso fields-rename-iso fields-keep-only-iso fields-remove-iso schema-compose field-coerce-to-string-iso)) (answer "(define (field-coerce-to-number-iso field) (field-transform-iso field (make-p-iso (lambda (v) (cond ((number? v) v) ((string? v) (or (string->number v) 0)) (else 0))) number->string)))"))
