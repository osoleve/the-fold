(task-entry (id "meta/search/result-data->alist") (skill meta) (module search) (tier 1) (difficulty 11937) (name result-data->alist) (type "") (description "") (notes ()) (section structured-data-api) (deps ()) (available (*skill-index* *module-index* *export-index* *module-cache* *export-module-map* *search-ready* lattice-index! ensure-indexed! lattice-find search-with-context lattice-find-exact lattice-export-source lattice-find-prefix lattice-find-substring string-contains? find-module-by-name string-ends-with? find lattice-complete lattice-find-by-tier lattice-find-by-purity *show-scores* print-results print-results-pretty print-result-detail-pretty round-to truncate-string lf lfe lfp lfs lf-pretty lfe-pretty lfp-pretty lfs-pretty search-scores lattice-find-data)) (answer "(define (result-data->alist type data) (if (not data) '() (case type ((skill) (let ((desc (assq 'description data)) (tier (assq 'tier data)) (purity (assq 'purity data)) (modules-raw (assq 'modules data))) (quasiquote ((unquote-splicing (if (and desc (string? (cdr desc))) (quasiquote ((description unquote (cdr desc)))) '())) (unquote-splicing (if tier (quasiquote ((tier unquote (cdr tier)))) '())) (unquote-splicing (if purity (quasiquote ((purity unquote (cdr purity)))) '())) (unquote-splicing (if modules-raw (quasiquote ((module-count unquote (length (cdr modules-raw))))) '())))))) ((export) (let ((mod (assq 'module data)) (doc (assq 'docstring data))) (quasiquote ((unquote-splicing (if mod (quasiquote ((module unquote (cdr mod)) (require unquote (cdr mod)))) '())) (unquote-splicing (if (and doc (string? (cdr doc)) (> (string-length (cdr doc)) 0)) (quasiquote ((docstring unquote (cdr doc)))) '())))))) ((module) (let ((skill (assq 'skill data))) (quasiquote ((unquote-splicing (if skill (quasiquote ((skill unquote (cdr skill)))) '())))))) (else '()))))"))
