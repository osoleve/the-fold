(task-entry (id "game-theory/evolutionary/is-interior-equilibrium?") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13235) (name is-interior-equilibrium?) (type "") (description "") (notes ()) (section mixed-strategies) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge is-ess? find-all-ess is-nash-equilibrium? find-pure-nash can-invade? invasion-fitness incumbent-fitness invasion-gradient)) (answer "(define (is-interior-equilibrium? game pop tolerance) (let* ((fitnesses (all-fitnesses game pop)) (avg (average-fitness game pop))) (andmap (lambda (f) (< (abs (- f avg)) tolerance)) fitnesses)))"))
(task-entry (id "game-theory/extensive-form/make-info-set") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13236) (name make-info-set) (type "(-> Nat Symbol (List DecisionNode) InfoSet)") (description "Create an information set for a player") (notes ()) (section information-sets) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game make-centipede-game centipede-4 entry-deterrence stackelberg-simple signaling-simple)) (answer "(define (make-info-set player label nodes) (when (not (null? nodes)) (let ((expected-actions (decision-actions (car nodes)))) (for-each (lambda (n) (when (not (= (decision-player n) player)) (error 'make-info-set \"all nodes must have same player\")) (when (not (equal? (decision-actions n) expected-actions)) (error 'make-info-set \"all nodes must have same actions\"))) nodes))) (list 'info-set player label nodes))"))
(task-entry (id "game-theory/coop-games/kalai-smorodinsky") (skill game-theory) (module coop-games) (tier 1) (difficulty 13236) (name kalai-smorodinsky) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining)) (answer "(define (kalai-smorodinsky g) (if (not (= 2 (coop-game-players g))) (error 'kalai-smorodinsky \"requires 2-player game\") (let* ((bs (bargaining-set g)) (d0 (vector-ref bs 0)) (d1 (vector-ref bs 1)) (u0 (vector-ref bs 2)) (u1 (vector-ref bs 3)) (v01 (coop-game-value g 3)) (surplus (- v01 d0 d1)) (gain0 (- u0 d0)) (gain1 (- u1 d1)) (total-gain (+ gain0 gain1))) (if (= total-gain 0) (vector d0 d1) (let ((ratio (/ gain0 total-gain))) (vector (+ d0 (* ratio surplus)) (+ d1 (* (- 1 ratio) surplus))))))))"))
(task-entry (id "game-theory/matching/weighted-matching-ilp") (skill game-theory) (module matching) (tier 1) (difficulty 13236) (name weighted-matching-ilp) (type "") (description "") (notes ()) (section weighted-matching-ilp) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank stable-match-receiver-optimal same-matched-agents? symbol<?)) (answer "(define (weighted-matching-ilp n m weight) (let* ((num-vars (* n m)) (num-row-constraints n) (num-col-constraints m) (num-constraints (+ num-row-constraints num-col-constraints)) (num-slacks num-constraints) (total-vars (+ num-vars num-slacks)) (c (make-vector total-vars 0)) (A (make-matrix num-constraints total-vars 0)) (b (make-vector num-constraints 1))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j m)) (let ((var-idx (+ (* i m) j))) (vector-set! c var-idx (- (weight i j)))))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j m)) (let ((var-idx (+ (* i m) j))) (matrix-set! A i var-idx 1))) (matrix-set! A i (+ num-vars i) 1)) (do ((j 0 (+ j 1))) ((= j m)) (do ((i 0 (+ i 1))) ((= i n)) (let ((var-idx (+ (* i m) j))) (matrix-set! A (+ n j) var-idx 1))) (matrix-set! A (+ n j) (+ num-vars n j) 1)) (let* ((ilp (make-ilp c A b (iota num-vars))) (result (ilp-solve ilp))) (if (ilp-optimal? result) (let* ((x (ilp-result-x result)) (matches (extract-ilp-matches x n m)) (total-weight (- (ilp-result-z result)))) (cons matches total-weight)) (cons '() 0)))))"))
(task-entry (id "game-theory/voting/any?") (skill game-theory) (module voting) (tier 1) (difficulty 13236) (name any?) (type "") (description "") (notes ()) (section smith-set) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score minimax-winner minimax-ranking smith-set)) (answer "(define (any? pred lst) (and (not (null? lst)) (or (pred (car lst)) (any? pred (cdr lst)))))"))
