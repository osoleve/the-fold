(task-entry (id "physics/diff/optimize/adam-step") (skill physics/diff) (module optimize) (tier 2) (difficulty 23104) (name adam-step) (type "") (description "") (notes ()) (section gradient-descent) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body \x27;traced-integrators \x27;rollout)) (available (gradient-descent-step gradient-descent momentum-step gradient-descent-momentum)) (answer "(define (adam-step params grads m-prev v-prev t lr beta1 beta2 epsilon) (let* ((m (map (lambda (m-i g) (+ (* beta1 m-i) (* (- 1 beta1) g))) m-prev grads)) (v (map (lambda (v-i g) (+ (* beta2 v-i) (* (- 1 beta2) (* g g)))) v-prev grads)) (m-hat (map (lambda (m-i) (/ m-i (- 1 (expt beta1 t)))) m)) (v-hat (map (lambda (v-i) (/ v-i (- 1 (expt beta2 t)))) v)) (new-params (map (lambda (p mh vh) (- p (* lr (/ mh (+ (sqrt vh) epsilon))))) params m-hat v-hat))) (values new-params m v)))"))
