(task-entry (id "autodiff/traced-optics/optic-gradient") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12704) (name optic-gradient) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value untrace-value lift-at-optic traversal-over-indexed)) (answer "(define (optic-gradient loss-fn optic s) (with-fresh-ad-scope (lambda () (let ((tape (make-reverse-tape))) (let-values (((s-traced traced-focus) (lift-at-optic optic s tape))) (let ((loss (loss-fn s-traced))) (if (traced? loss) (let ((grads (backward tape (traced-id loss) 1))) (extract-gradient traced-focus grads)) (zero-like traced-focus))))))))"))
(task-entry (id "autodiff/higher-order-diff/gradient-i") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12705) (name gradient-i) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward)) (answer "(define (gradient-i f dual-args i) (let* ((epsilon 1e-6) (args-vals (map dual-value dual-args)) (args+ (list-update args-vals i (lambda (x) (+ x epsilon)))) (args- (list-update args-vals i (lambda (x) (- x epsilon)))) (grad+ (gradient f args+)) (grad- (gradient f args-)) (deriv-vals (map (lambda (g+ g-) (/ (- g+ g-) (* 2 epsilon))) grad+ grad-))) (let ((val (/ (- (car (gradient f args+)) (car (gradient f args-))) (* 2 epsilon)))) (dual val (fold-left + 0 (map (lambda (darg dval) (* (dual-deriv darg) dval)) dual-args deriv-vals))))))"))
(task-entry (id "autodiff/differentiable/differentiable-traced-methods") (skill autodiff) (module differentiable) (tier 1) (difficulty 12705) (name differentiable-traced-methods) (type "") (description "") (notes ()) (section differentiable-typeclass) (deps (\x27;prelude \x27;kinds \x27;infer \x27;resolve \x27;comp-graph \x27;reverse-diff)) (available (TC-Differentiable differentiable-real-methods inst-Differentiable-Real differentiable-dual-methods inst-Differentiable-Dual)) (answer "(define differentiable-traced-methods (quasiquote ((lift unquote (lambda (x) (make-traced-const x))) (primal unquote traced-value) (tangent unquote (lambda (t) 0)) (d+ unquote traced-add) (d* unquote traced-mul) (d- unquote traced-sub) (d/ unquote traced-div) (d-neg unquote traced-neg) (d-sq unquote traced-sq) (d-sqrt unquote traced-sqrt) (d-exp unquote traced-exp) (d-log unquote traced-log) (d-sin unquote traced-sin) (d-cos unquote traced-cos))))"))
(task-entry (id "autodiff/differentiable-signal/idft-vjp") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12705) (name idft-vjp) (type "(-> (Vector Complex) (Vector Complex))") (description "IDFT VJP - computes dL/dX = DFT(dL/dx) / N") (notes ()) (section idft-vjp) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real)) (answer "(define (idft-vjp output-grad) (let* ((n (vector-length output-grad)) (input-complex (if (and (> n 0) (complex? (vector-ref output-grad 0))) output-grad (real->complex-vec output-grad))) (grad-complex (dft input-complex)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (let ((g (vector-ref grad-complex i))) (vector-set! result i (complex-scale (/ 1.0 n) g))))))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-grad-ref") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12705) (name sparse-grad-ref) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values)) (answer "(define (sparse-grad-ref g i) (let ((indices (sparse-grad-indices g)) (values (sparse-grad-values g)) (nnz (sparse-grad-nnz g))) (let loop ((k 0)) (cond ((= k nnz) 0) ((= (vector-ref indices k) i) (vector-ref values k)) (else (loop (+ k 1)))))))"))
