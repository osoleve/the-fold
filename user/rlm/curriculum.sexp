(task-entry (id "random/variational-inference/vi-fit-normal-mean") (skill random) (module variational-inference) (tier 1) (difficulty 12957) (name vi-fit-normal-mean) (type "") (description "") (notes ()) (section convenience-common-model-fitting) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf vi-step-mf make-adam-state adam-state? adam-state-m adam-state-v adam-state-t adam-update vi-step-adam vi-step-adam-traced vi-fit vi-fit-traced vi-result? vi-result-vfamily vi-result-elbo-history vi-result-iterations)) (answer "(define vi-fit-normal-mean (case-lambda ((observations known-variance) (vi-fit-normal-mean observations known-variance 1000 0.01)) ((observations known-variance num-iters) (vi-fit-normal-mean observations known-variance num-iters 0.01)) ((observations known-variance num-iters lr) (let* ((log-joint (lambda (z) (let ((mu (car z))) (+ (log-normal-pdf mu 0 100) (fold-left + 0 (map (lambda (xi) (log-normal-pdf xi mu known-variance)) observations)))))) (traced-log-joint (make-traced-log-joint-normal-mean observations known-variance 0 100)) (sample-mean (/ (fold-left + 0 observations) (length observations))) (init-vfamily (make-mf-gaussian (list 0.0) (list 0.0)))) (vi-fit-traced log-joint traced-log-joint init-vfamily num-iters lr)))))"))
