(task-entry (id "fp/units/in-units") (skill fp) (module units) (tier 1) (difficulty 10718) (name in-units) (type "(-> Quantity (-> Number Quantity) Number)") (description "Express quantity in given units.") (notes ("Example: (in-units (kilometer 5) meter) → 5000")) (section unit-conversions) (deps (\x27;prelude)) (available (make-dim dim-length dim-time dim-mass dim-current dim-temperature dim-amount dim-luminosity dim? dim=? dim-one dim-length-base dim-time-base dim-mass-base dim-current-base dim-temperature-base dim-amount-base dim-luminosity-base dim* dim/ dim-pow dim-sqrt dim-inv make-qty qty-value qty-dim qty? qty+ qty- qty* qty/ qty-scale qty-pow qty-sqrt qty-neg qty-abs qty=? qty<? qty>? qty<=? qty>=? meter second kilogram ampere kelvin mole candela dim-velocity dim-acceleration dim-force dim-energy dim-power dim-pressure dim-frequency dim-charge dim-voltage dim-resistance dim-area dim-volume newton joule watt pascal hertz coulomb volt ohm yotta zetta exa peta tera giga mega kilo hecto deca deci centi milli micro nano pico femto atto zepto yocto kilometer centimeter millimeter micrometer nanometer millisecond microsecond nanosecond gram milligram kilowatt megawatt gigawatt kilojoule megajoule milliampere microampere kilohertz megahertz gigahertz kilovolt millivolt kiloohm megaohm dim->string qty->string scalar qty-dimensionless? qty->number convert)) (answer "(define (in-units q unit-fn) (let ((unit (unit-fn 1))) (if (dim=? (qty-dim q) (qty-dim unit)) (/ (qty-value q) (qty-value unit)) (error 'in-units \"dimension mismatch\"))))"))
(task-entry (id "diffgeo/charts/make-atlas") (skill diffgeo) (module charts) (tier 1) (difficulty 10718) (name make-atlas) (type "") (description "") (notes ()) (section atlas-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp)) (available (chart? chart-name chart-dim chart-domain-pred chart-coord-map chart-inverse-map make-chart chart-contains? chart-apply chart-apply-inverse make-transition transition-apply *jacobian-epsilon* jacobian-numerical transition-jacobian atlas? atlas-name atlas-charts)) (answer "(define (make-atlas name charts) (if (null? charts) (list 'atlas name '()) (let ((dim (chart-dim (car charts)))) (if (for-all (lambda (c) (= (chart-dim c) dim)) charts) (list 'atlas name charts) (quasiquote (error inconsistent-dimensions))))))"))
(task-entry (id "diffgeo/tangent/make-cotangent-vector") (skill diffgeo) (module tangent) (tier 1) (difficulty 10718) (name make-cotangent-vector) (type "") (description "") (notes ()) (section tangent-vector-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts)) (available (tangent-vector? tangent-vector-point tangent-vector-chart tangent-vector-components tangent-vector-dim make-tangent-vector tangent-zero tangent-basis-vector tangent-add tangent-sub tangent-scale tangent-negate tangent-change-chart cotangent-vector? cotangent-vector-point cotangent-vector-chart cotangent-vector-components cotangent-vector-dim)) (answer "(define (make-cotangent-vector point chart components) (cond ((not (chart-contains? chart point)) (quasiquote (error point-not-in-chart (unquote (chart-name chart))))) ((not (= (chart-dim chart) (vector-length components))) (quasiquote (error dimension-mismatch (unquote (chart-dim chart)) (unquote (vector-length components))))) (else (list 'cotangent-vector point chart components))))"))
(task-entry (id "diffgeo/lie-groups/so2-matrix-to-alg") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10718) (name so2-matrix-to-alg) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix)) (answer "(define (so2-matrix-to-alg m) (if (and (= (matrix-rows m) 2) (= (matrix-cols m) 2)) (make-so2-alg (matrix-ref m 1 0)) (quasiquote (error invalid-dimension))))"))
