(task-entry (id "random/bayesian/beta-posterior-mode") (skill random) (module bayesian) (tier 1) (difficulty 12906) (name beta-posterior-mode) (type "") (description "") (notes ()) (section conjugate-prior-beta-binomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean)) (answer "(define (beta-posterior-mode prior) (let ((alpha (beta-prior-alpha prior)) (beta (beta-prior-beta prior))) (if (and (> alpha 1) (> beta 1)) (/ (- alpha 1) (- (+ alpha beta) 2)) (beta-posterior-mean prior))))"))
(task-entry (id "random/monte-carlo/sample-min") (skill random) (module monte-carlo) (tier 1) (difficulty 12906) (name sample-min) (type "") (description "") (notes ()) (section statistical-summary-functions) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median)) (answer "(define (sample-min samples) (if (null? samples) +inf.0 (fold-left min (car samples) (cdr samples))))"))
