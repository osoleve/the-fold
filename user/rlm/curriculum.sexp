(task-entry (id "fp/natural-transform/nat-horizontal") (skill fp) (module natural-transform) (tier 1) (difficulty 10610) (name nat-horizontal) (type "") (description "") (notes ()) (section horizontal-composition) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-nat-transform nat-transform? nat-transform-name nat-transform-source nat-transform-target nat-transform-component nat-apply nat-id nat-compose nat-∘)) (answer "(define (nat-horizontal η ε) (let* ((F (nat-transform-source η)) (G (nat-transform-target η)) (H (nat-transform-source ε)) (K (nat-transform-target ε)) (η-comp (nat-transform-component η)) (ε-comp (nat-transform-component ε)) (H-fmap (functor-fmap H)) (K-fmap (functor-fmap K)) (F-fmap (functor-fmap F)) (G-fmap (functor-fmap G))) (let ((HF (make-named-functor (string->symbol (format \"~a∘~a\" (functor-name H) (functor-name F))) (lambda (f x) (H-fmap (lambda (y) (F-fmap f y)) x)))) (KG (make-named-functor (string->symbol (format \"~a∘~a\" (functor-name K) (functor-name G))) (lambda (f x) (K-fmap (lambda (y) (G-fmap f y)) x))))) (make-nat-transform (string->symbol (format \"~a*~a\" (nat-transform-name η) (nat-transform-name ε))) HF KG (lambda (x) (K-fmap η-comp (ε-comp x)))))))"))
