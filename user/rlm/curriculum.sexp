(task-entry (id "linalg/dep-linalg/dep-linalg-types") (skill linalg) (module dep-linalg) (tier 0) (difficulty 400) (name dep-linalg-types) (type "") (description "") (notes ()) (section type-signatures) (deps (\x27;prelude \x27;vec \x27;matrix)) (available ()) (answer "(define dep-linalg-types '((vec-append-typed Π ((n : Nat)) (Π ((m : Nat)) (Π ((A : Type)) (-> (Vec n A) (Vec m A) (Vec (+ n m) A))))) (vec-zip-typed Π ((n : Nat)) (Π ((A : Type)) (Π ((B : Type)) (-> (Vec n A) (Vec n B) (Vec n (× A B)))))) (matrix-mul-typed Π ((m : Nat)) (Π ((n : Nat)) (Π ((p : Nat)) (Π ((A : Type)) (-> (Matrix m n A) (Matrix n p A) (Matrix m p A)))))) (matrix-add-typed Π ((m : Nat)) (Π ((n : Nat)) (Π ((A : Type)) (-> (Matrix m n A) (Matrix m n A) (Matrix m n A))))) (vec-head-typed Π ((n : Nat)) (Π ((A : Type)) (-> (Vec (+ 1 n) A) A))) (vec-tail-typed Π ((n : Nat)) (Π ((A : Type)) (-> (Vec (+ 1 n) A) (Vec n A)))) (diff-grad Π ((n : Nat)) (Π ((α : Type)) (-> (Diff (Vec n α) α) (Vec n α) (Vec n α)))) (diff-jacobian Π ((n : Nat)) (Π ((m : Nat)) (Π ((α : Type)) (-> (Diff (Vec n α) (Vec m α)) (Vec n α) (Matrix m n α))))) (diff-hessian Π ((n : Nat)) (Π ((α : Type)) (-> (Diff (Vec n α) α) (Vec n α) (Matrix n n α)))) (diff-compose Π ((A : Type)) (Π ((B : Type)) (Π ((C : Type)) (-> (Diff B C) (Diff A B) (Diff A C))))) (diff-lift Π ((A : Type)) (Π ((B : Type)) (-> (-> A B) (Diff A B)))) (diff-primal Π ((A : Type)) (Π ((B : Type)) (-> (Diff A B) (-> A B)))) (diff-scalar -> (Diff Float Float) Float Float) (diff-jvp Π ((n : Nat)) (Π ((m : Nat)) (Π ((α : Type)) (-> (Diff (Vec n α) (Vec m α)) (Vec n α) (Vec n α) (Vec m α))))) (diff-vjp Π ((n : Nat)) (Π ((m : Nat)) (Π ((α : Type)) (-> (Diff (Vec n α) (Vec m α)) (Vec n α) (Vec m α) (Vec n α)))))))"))
