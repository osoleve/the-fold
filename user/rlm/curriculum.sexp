(task-entry (id "clp/domain/domain-singleton?") (skill clp) (module domain) (tier 1) (difficulty 10807) (name domain-singleton?) (type "(-> Domain Bool)") (description "Check if domain contains exactly one value") (notes ()) (section domain-predicates) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty?)) (answer "(define (domain-singleton? dom) (and (pair? dom) (null? (cdr dom)) (= (caar dom) (cdar dom))))"))
(task-entry (id "clp/store/cstore-set-domains") (skill clp) (module store) (tier 1) (difficulty 10807) (name cstore-set-domains) (type "(-> CStore (Alist LVarId Domain) CStore)") (description "Set domain bindings in store") (notes ()) (section constraint-store-structure) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst)) (answer "(define (cstore-set-domains cs domains) (list 'cstore (cstore-subst cs) domains (cstore-constraints cs) (cstore-pending cs)))"))
(task-entry (id "clp/fd-constraints/<=fd") (skill clp) (module fd-constraints) (tier 1) (difficulty 10807) (name <=fd) (type "(-> (Or LVar Int) (Or LVar Int) (-> CStore (Maybe CStore)))") (description "Constrain x <= y") (notes ()) (section comparison-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var)) (answer "(define (<=fd x y) (lambda (cs) (cond ((and (integer? x) (integer? y)) (if (<= x y) cs #f)) ((integer? x) (let ((dom-y (cstore-get-domain cs y))) (if dom-y (cstore-narrow-domain cs y (domain-restrict-min dom-y x)) cs))) ((integer? y) (let ((dom-x (cstore-get-domain cs x))) (if dom-x (cstore-narrow-domain cs x (domain-restrict-max dom-x y)) cs))) (else (<=fd-var-var cs x y)))))"))
(task-entry (id "clp/global-constraints/element") (skill clp) (module global-constraints) (tier 1) (difficulty 10807) (name element) (type "(-> LVar (List Int) LVar (-> CStore (Maybe CStore)))") (description "Constrain: array[index] = value") (notes ("index is 1-based (like SICStus/ECLiPSe convention)")) (section element-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different)) (answer "(define (element index array value) (lambda (cs) (element-propagate cs index array value)))"))
(task-entry (id "clp/propagate/post-<fd") (skill clp) (module propagate) (tier 1) (difficulty 10807) (name post-<fd) (type "(-> CStore (Or LVar Int) (Or LVar Int) (Maybe CStore))") (description "Post less-than constraint and propagate") (notes ()) (section high-level-constraint-posting) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd)) (answer "(define (post-<fd cs x y) (let ((vars (filter lvar? (list x y)))) (if (null? vars) ((<fd x y) cs) (post-constraint cs '<fd vars (<fd x y)))))"))
(task-entry (id "clp/label/label") (skill clp) (module label) (tier 1) (difficulty 10807) (name label) (type "(-> CStore (List LVar) (Stream CStore))") (description "Label variables using default strategy (first-fail, min-value)") (notes ()) (section labeling-functions) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value)) (answer "(define (label cs vars) (label-with first-fail min-value cs vars))"))
(task-entry (id "clp/clp/goal-in-range") (skill clp) (module clp) (tier 1) (difficulty 10807) (name goal-in-range) (type "(-> LVar Int Int Goal)") (description "Constrain var to range [lo, hi]") (notes ()) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj*)) (answer "(define (goal-in-range var lo hi) (clp-goal (in-range var lo hi)))"))
