(task-entry (id "dsl/quasi/pattern-match") (skill dsl) (module quasi) (tier 1) (difficulty 11724) (name pattern-match) (type "") (description "") (notes ()) (section syntax-objects) (deps (\x27;prelude \x27;combinators)) (available (quasiquote? unquote? unquote-splicing? qq-expand qq-expand-depth qq-expand-pair qq-expand-list qq-collect-segments expand-quasiquote make-syntax syntax? syntax-datum syntax-source make-source-loc source-loc? source-loc-file source-loc-line source-loc-column no-source datum->syntax syntax->datum qq-expand-syntax qq-expand-syntax-depth syntax-match)) (answer "(define (pattern-match datum pattern bindings) (cond ((eq? pattern '_) (just bindings)) ((and (symbol? pattern) (not (literal-pattern? pattern))) (just (cons (cons pattern datum) bindings))) ((literal-pattern? pattern) (if (equal? datum pattern) (just bindings) nothing)) ((and (pair? pattern) (pair? (cdr pattern)) (eq? (cadr pattern) '...)) (pattern-match-ellipsis datum (car pattern) (cddr pattern) bindings)) ((pair? pattern) (if (pair? datum) (maybe-bind (pattern-match (car datum) (car pattern) bindings) (lambda (bindings1) (pattern-match (cdr datum) (cdr pattern) bindings1))) nothing)) ((equal? datum pattern) (just bindings)) (else nothing)))"))
