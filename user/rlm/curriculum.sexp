(task-entry (id "random/probability/assume") (skill random) (module probability) (tier 1) (difficulty 12933) (name assume) (type "") (description "") (notes ()) (section conditioning) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist condition)) (answer "(define (assume test) (if test (prob-pure '()) (factor -inf.0)))"))
