(task-entry (id "geometry/shape-protocol/scene-aabb") (skill geometry) (module shape-protocol) (tier 1) (difficulty 12202) (name scene-aabb) (type "(-> (List Shape) AABB)") (description "Compute AABB enclosing all shapes in scene") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;vec3 \x27;geometry)) (available (distance-to-segment scene-intersect-ray)) (answer "(define (scene-aabb shapes) (if (null? shapes) (aabb (vec3-zero) (vec3-zero)) (let loop ((shapes (cdr shapes)) (result (shape-aabb (car shapes)))) (if (null? shapes) result (loop (cdr shapes) (aabb-merge result (shape-aabb (car shapes))))))))"))
