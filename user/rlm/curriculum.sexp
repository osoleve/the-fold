(task-entry (id "statistics/f-test/levene-test") (skill statistics) (module f-test) (tier 1) (difficulty 11202) (name levene-test) (type "") (description "") (notes ()) (section variance-ratio-test) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;stat/distributions)) (available (f-test-variance variance-ratio-ci)) (answer "(define (levene-test groups) (let* ((k (length groups)) (z-groups (map (lambda (g) (let* ((med (vec-median g)) (n (vector-length g)) (z (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) z) (vector-set! z i (abs (- (vector-ref g i) med)))))) groups)) (anova-result (anova-one-way z-groups))) (make-test-result 'levene-test (anova-f-statistic anova-result) (cons (anova-df-between anova-result) (anova-df-within anova-result)) (anova-p-value anova-result) #f #f)))"))
