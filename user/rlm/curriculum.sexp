(task-entry (id "algebra/group/group-power") (skill algebra) (module group) (tier 0) (difficulty 310) (name group-power) (type "(-> Group Element Integer Element)") (description "Works for negative powers via inverse") (notes ()) (section group-operations) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse)) (answer "(define (group-power g a n) (cond ((= n 0) (group-identity g)) ((< n 0) (group-power g (group-inverse g a) (- n))) ((= n 1) a) ((even? n) (let ((half (group-power g a (/ n 2)))) (group-compose g half half))) (else (group-compose g a (group-power g a (- n 1))))))"))
