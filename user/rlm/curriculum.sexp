(task-entry (id "info/entropy/kl-divergence") (skill info) (module entropy) (tier 1) (difficulty 11116) (name kl-divergence) (type "(-> (List Number) (List Number) Number)") (description "Kullback-Leibler divergence D_KL(P||Q) = sum(p_i * log2(p_i/q_i))") (notes ()) (section cross-entropy-and-kl) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy conditional-entropy-direct mutual-information mutual-information-from-joint compute-marginal-x compute-marginal-y cross-entropy)) (answer "(define (kl-divergence p q) (if (null? p) 0 (fold-left + 0 (map (lambda (pi qi) (cond ((<= pi 0) 0) ((<= qi 0) +inf.0) (else (* pi (log2 (/ pi qi)))))) p q))))"))
(task-entry (id "info/statistical-measures/matusita-distance") (skill info) (module statistical-measures) (tier 1) (difficulty 11116) (name matusita-distance) (type "(-> (List Real) (List Real) Real)") (description "Matusita distance: sqrt(sum((sqrt(p_i) - sqrt(q_i))^2))") (notes ()) (section matusita-distance) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared jeffreys-divergence alpha-divergence squared-hellinger-distance triangular-discrimination pearson-divergence neyman-divergence k-divergence squared-loss euclidean-distance)) (answer "(define (matusita-distance p q) (if (or (null? p) (null? q)) 0 (let ((sum-sq (fold-left + 0 (map (lambda (pi qi) (let ((diff (- (sqrt (max 0 pi)) (sqrt (max 0 qi))))) (* diff diff))) p q)))) (sqrt sum-sq))))"))
(task-entry (id "info/channel-capacity/ba-iterate") (skill info) (module channel-capacity) (tier 1) (difficulty 11116) (name ba-iterate) (type "") (description "") (notes ()) (section blahut-arimoto-algorithm) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity awgn-capacity-db awgn-capacity-bandwidth snr-for-capacity dmc-mutual-information dmc-output-distribution dmc-joint-distribution dmc-capacity-symmetric make-uniform-dist blahut-arimoto)) (answer "(define (ba-iterate transition dist max-iter tolerance iter prev-capacity) (let* ((output-dist (dmc-output-distribution transition dist)) (phi (ba-compute-phi transition dist output-dist)) (new-dist (ba-update-dist phi)) (capacity (dmc-mutual-information transition new-dist))) (if (or (>= iter max-iter) (< (abs (- capacity prev-capacity)) tolerance)) (cons new-dist capacity) (ba-iterate transition new-dist max-iter tolerance (+ iter 1) capacity))))"))
(task-entry (id "info/rate-distortion/binary-entropy-inverse") (skill info) (module rate-distortion) (tier 1) (difficulty 11116) (name binary-entropy-inverse) (type "(-> Real Real)") (description "Inverse of binary entropy function via binary search") (notes ()) (section rate-distortion-functions) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr snr-db psnr mean variance gaussian-rate-distortion gaussian-distortion-rate binary-rate-distortion binary-distortion-rate)) (answer "(define (binary-entropy-inverse h) (if (<= h 0) 0 (if (>= h 1) 0.5 (binary-search-entropy h 0 0.5 1e-4))))"))
