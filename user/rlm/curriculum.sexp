(task-entry (id "physics/classical/ode-integrators/integrate-symplectic") (skill physics/classical) (module ode-integrators) (tier 2) (difficulty 23514) (name integrate-symplectic) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (state-add state-sub state-scale state-madd euler-step midpoint-step heun-step rk4-step symplectic-euler-step symplectic-euler-step-b verlet-step velocity-verlet-step leapfrog-step integrate)) (answer "(define (integrate-symplectic step a t0 pos0 vel0 dt n) (let loop ((t t0) (pos pos0) (vel vel0) (i 0) (results (list (list pos0 vel0)))) (if (>= i n) (reverse results) (let* ((result (step a t pos vel dt)) (new-pos (car result)) (new-vel (cadr result))) (loop (+ t dt) new-pos new-vel (+ i 1) (cons result results))))))"))
