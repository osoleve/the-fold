(task-entry (id "autodiff/profiling/print-profile") (skill autodiff) (module profiling) (tier 1) (difficulty 12722) (name print-profile) (type "") (description "") (notes ()) (section tape-statistics) (deps (\x27;prelude \x27;comp-graph \x27;reverse-diff \x27;sort)) (available (tape-stats tape-size tape-op-count graph-stats graph-edge-count graph-depth extract-input-ids find-node-id tally-ops current-microseconds time-thunk time-gradient *ptr-size* *fixnum-size* *flonum-size* *pair-size* *vector-header* tape-memory-estimate graph-memory-estimate node-memory-estimate traced-memory-estimate profile-computation)) (answer "(define (print-profile report) (let ((val (cdr (assq 'value report))) (grad (cdr (assq 'gradient report))) (timing (cdr (assq 'timing report))) (tape-info (cdr (assq 'tape report))) (mem (cdr (assq 'memory-bytes report))) (n-inputs (cdr (assq 'num-inputs report)))) (printf \"~n=== Autodiff Profile ====~n\") (printf \"Inputs:     ~a variables~n\" n-inputs) (printf \"Value:      ~a~n\" val) (printf \"Gradient:   ~a~n\" grad) (printf \"~n--- Timing ----~n\") (printf \"Forward:    ~a us~n\" (cdr (assq 'forward-us timing))) (printf \"Backward:   ~a us~n\" (cdr (assq 'backward-us timing))) (printf \"Total:      ~a us~n\" (cdr (assq 'total-us timing))) (printf \"~n--- Tape ----~n\") (printf \"Size:       ~a entries~n\" (cdr (assq 'size tape-info))) (printf \"Operations: ~a~n\" (cdr (assq 'ops tape-info))) (printf \"~n--- Memory ----~n\") (printf \"Estimated:  ~a bytes (~a KB)~n\" mem (quotient mem 1024)) (printf \"====~n\")))"))
(task-entry (id "autodiff/symbolic-diff/expr-to-traced") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12722) (name expr-to-traced) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list simplify-diff simplify-neg simplify-quot simplify-pow simplify-app)) (answer "(define (expr-to-traced expr vars) (lambda traced-args (let ((env (map cons vars traced-args))) (eval-traced expr env))))"))
(task-entry (id "autodiff/interval-autodiff/iv-traced-log") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12722) (name iv-traced-log) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp)) (answer "(define (iv-traced-log a) (let* ((av (interval-traced-value a)) (result (interval-log av))) (if (error? result) result (let ((tape (and (interval-traced? a) (interval-traced-tape a)))) (if tape (let ((grad (interval-recip av))) (if (error? grad) '(error domain-error) (interval-traced-op 'log result (list a) (list grad) tape))) result)))))"))
(task-entry (id "autodiff/higher-order-diff/jet-lift") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12723) (name jet-lift) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value)) (answer "(define (jet-lift x) (if (jet? x) x (jet (list x))))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-jvp") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12723) (name sparse-jvp) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern)) (answer "(define (sparse-jvp J v) (sparse-coo-vec-mul J v))"))
(task-entry (id "autodiff/typed-gradients/safe-hessian") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12723) (name safe-hessian) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix)) (answer "(define (safe-hessian spec args) (if (not (gradient-spec? spec)) (list 'error 'invalid-gradient-spec spec) (let ((expected-input-dim (gradient-spec-input-dim spec)) (expected-output-dim (gradient-spec-output-dim spec)) (f (gradient-spec-fn spec)) (actual-input-dim (length args))) (cond ((not (= expected-input-dim actual-input-dim)) (list 'error 'input-dimension-mismatch (list 'expected expected-input-dim) (list 'got actual-input-dim))) ((not (= expected-output-dim 1)) (list 'error 'not-a-scalar-function (list 'output-dim expected-output-dim) (list 'hint \"Hessian is only defined for scalar functions\"))) (else (let ((raw-hessian (hessian f args))) (if (and (pair? raw-hessian) (eq? (car raw-hessian) 'matrix)) (let ((actual-rows (matrix-rows raw-hessian)) (actual-cols (matrix-cols raw-hessian))) (if (and (= actual-rows expected-input-dim) (= actual-cols expected-input-dim)) (dim-hessian expected-input-dim raw-hessian) (list 'error 'hessian-dimension-mismatch (list 'expected expected-input-dim) (list 'got (list actual-rows actual-cols))))) (list 'error 'hessian-computation-failed raw-hessian))))))))"))
(task-entry (id "autodiff/profiling/benchmark-gradient") (skill autodiff) (module profiling) (tier 1) (difficulty 12723) (name benchmark-gradient) (type "") (description "") (notes ()) (section tape-statistics) (deps (\x27;prelude \x27;comp-graph \x27;reverse-diff \x27;sort)) (available (tape-stats tape-size tape-op-count graph-stats graph-edge-count graph-depth extract-input-ids find-node-id tally-ops current-microseconds time-thunk time-gradient *ptr-size* *fixnum-size* *flonum-size* *pair-size* *vector-header* tape-memory-estimate graph-memory-estimate node-memory-estimate traced-memory-estimate profile-computation print-profile)) (answer "(define (benchmark-gradient f args iterations) (let* ((times (let loop ((i 0) (acc '())) (if (= i iterations) (reverse acc) (let-values (((_ us) (time-thunk (lambda () (gradient f args))))) (loop (+ i 1) (cons us acc)))))) (total (apply + times)) (avg (/ total iterations)) (sorted (sort-by < times)) (min-t (car sorted)) (max-t (car (reverse sorted))) (median (list-ref sorted (quotient iterations 2)))) (list (cons 'iterations iterations) (cons 'total-us total) (cons 'avg-us avg) (cons 'min-us min-t) (cons 'max-us max-t) (cons 'median-us median))))"))
(task-entry (id "autodiff/symbolic-diff/eval-traced") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12723) (name eval-traced) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list simplify-diff simplify-neg simplify-quot simplify-pow simplify-app expr-to-traced)) (answer "(define (eval-traced expr env) (cond ((num? expr) (num-val expr)) ((var? expr) (let ((binding (assq (var-name expr) env))) (cond (binding (cdr binding)) ((eq? (var-name expr) 'pi) 3.141592653589793) ((eq? (var-name expr) 'e) 2.718281828459045) (else (error 'eval-traced \"Unbound variable\" (var-name expr)))))) ((sum? expr) (fold-left traced-add (eval-traced (car (sum-terms expr)) env) (map (lambda (e) (eval-traced e env)) (cdr (sum-terms expr))))) ((product? expr) (fold-left traced-mul (eval-traced (car (product-factors expr)) env) (map (lambda (e) (eval-traced e env)) (cdr (product-factors expr))))) ((difference? expr) (if (diff-right expr) (traced-sub (eval-traced (diff-left expr) env) (eval-traced (diff-right expr) env)) (traced-neg (eval-traced (diff-left expr) env)))) ((quotient? expr) (traced-div (eval-traced (quot-numer expr) env) (eval-traced (quot-denom expr) env))) ((power? expr) (let ((base (eval-traced (pow-base expr) env)) (exp-val (eval-traced (pow-exp expr) env))) (if (number? exp-val) (traced-pow base exp-val) (traced-exp (traced-mul exp-val (traced-log base)))))) ((app? expr) (let ((fn (app-fn expr)) (arg (eval-traced (app-arg expr) env))) (case fn ((sin) (traced-sin arg)) ((cos) (traced-cos arg)) ((tan) (traced-tan arg)) ((exp) (traced-exp arg)) ((log) (traced-log arg)) ((sqrt) (traced-sqrt arg)) ((asin) (traced-asin arg)) ((acos) (traced-acos arg)) ((atan) (traced-atan arg)) ((sinh) (traced-sinh arg)) ((cosh) (traced-cosh arg)) ((tanh) (traced-tanh arg)) (else (error 'eval-traced \"Unknown function\" fn))))) (else (error 'eval-traced \"Unknown expression type\" expr))))"))
(task-entry (id "autodiff/interval-autodiff/iv-traced-sin") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12723) (name iv-traced-sin) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp iv-traced-log)) (answer "(define (iv-traced-sin a) (let* ((av (interval-traced-value a)) (result (interval-sin av)) (grad (interval-cos av)) (tape (and (interval-traced? a) (interval-traced-tape a)))) (if tape (interval-traced-op 'sin result (list a) (list grad) tape) result)))"))
(task-entry (id "autodiff/higher-order-diff/jet-variable") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12724) (name jet-variable) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift)) (answer "(define (jet-variable x order) (jet (cons x (cons 1 (make-list order 0)))))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-vjp") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12724) (name sparse-vjp) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern sparse-jvp)) (answer "(define (sparse-vjp J v) (let* ((m (sparse-coo-rows J)) (n (sparse-coo-cols J)) (row-idx (sparse-coo-row-indices J)) (col-idx (sparse-coo-col-indices J)) (vals (sparse-coo-values J)) (nnz (sparse-coo-nnz J)) (result (make-vector n 0))) (do ((k 0 (+ k 1))) ((= k nnz) result) (let ((i (vector-ref row-idx k)) (j (vector-ref col-idx k)) (Jij (vector-ref vals k))) (vector-set! result j (+ (vector-ref result j) (* (vector-ref v i) Jij)))))))"))
(task-entry (id "autodiff/typed-gradients/scalar-fn") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12724) (name scalar-fn) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix safe-hessian)) (answer "(define (scalar-fn n f) (make-gradient-spec n 1 f))"))
(task-entry (id "autodiff/profiling/print-benchmark") (skill autodiff) (module profiling) (tier 1) (difficulty 12724) (name print-benchmark) (type "") (description "") (notes ()) (section tape-statistics) (deps (\x27;prelude \x27;comp-graph \x27;reverse-diff \x27;sort)) (available (tape-stats tape-size tape-op-count graph-stats graph-edge-count graph-depth extract-input-ids find-node-id tally-ops current-microseconds time-thunk time-gradient *ptr-size* *fixnum-size* *flonum-size* *pair-size* *vector-header* tape-memory-estimate graph-memory-estimate node-memory-estimate traced-memory-estimate profile-computation print-profile benchmark-gradient)) (answer "(define (print-benchmark result) (printf \"~n=== Benchmark Results ====~n\") (printf \"Iterations: ~a~n\" (cdr (assq 'iterations result))) (printf \"Total:      ~a us~n\" (cdr (assq 'total-us result))) (printf \"Average:    ~a us~n\" (inexact (cdr (assq 'avg-us result)))) (printf \"Min:        ~a us~n\" (cdr (assq 'min-us result))) (printf \"Max:        ~a us~n\" (cdr (assq 'max-us result))) (printf \"Median:     ~a us~n\" (cdr (assq 'median-us result))) (printf \"====~n\"))"))
(task-entry (id "autodiff/symbolic-diff/symbolic-gradient-fn") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12724) (name symbolic-gradient-fn) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list simplify-diff simplify-neg simplify-quot simplify-pow simplify-app expr-to-traced eval-traced)) (answer "(define (symbolic-gradient-fn expr vars) (let* ((grad-exprs (map simplify (sym-gradient expr vars))) (traced-fns (map (lambda (g) (expr-to-traced g vars)) grad-exprs))) (lambda (point) (map (lambda (f) (let ((result (apply f point))) (if (traced? result) (traced-value result) result))) traced-fns))))"))
(task-entry (id "autodiff/interval-autodiff/iv-traced-cos") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12724) (name iv-traced-cos) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp iv-traced-log iv-traced-sin)) (answer "(define (iv-traced-cos a) (let* ((av (interval-traced-value a)) (result (interval-cos av)) (grad (interval-neg (interval-sin av))) (tape (and (interval-traced? a) (interval-traced-tape a)))) (if tape (interval-traced-op 'cos result (list a) (list grad) tape) result)))"))
(task-entry (id "autodiff/higher-order-diff/rec-add") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12725) (name rec-add) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable)) (answer "(define (rec-add a b) (if (and (number? a) (number? b)) (+ a b) (jet-add a b)))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-hessian") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12725) (name sparse-hessian) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern sparse-jvp sparse-vjp)) (answer "(define (sparse-hessian f args) (let* ((n (length args)) (epsilon 1e-6) (grad0 (gradient f args)) (triplets (let loop ((j 0) (acc '())) (if (= j n) acc (let* ((args+ (list-set args j (+ (list-ref args j) epsilon))) (grad+ (gradient f args+)) (new-entries (let loop-i ((i 0) (g0 grad0) (gp grad+) (acc2 '())) (if (null? g0) acc2 (let ((hij (/ (- (car gp) (car g0)) epsilon))) (loop-i (+ i 1) (cdr g0) (cdr gp) (if (< (abs hij) 1e-10) acc2 (cons (list i j hij) acc2)))))))) (loop (+ j 1) (append new-entries acc))))))) (sparse-coo-from-triplets n n triplets)))"))
(task-entry (id "autodiff/typed-gradients/vector-fn") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12725) (name vector-fn) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix safe-hessian scalar-fn)) (answer "(define (vector-fn n m f) (make-gradient-spec n m f))"))
(task-entry (id "autodiff/symbolic-diff/symbolic-jacobian-fn") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12725) (name symbolic-jacobian-fn) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list simplify-diff simplify-neg simplify-quot simplify-pow simplify-app expr-to-traced eval-traced symbolic-gradient-fn)) (answer "(define (symbolic-jacobian-fn exprs vars) (let* ((jac-exprs (sym-jacobian exprs vars)) (simplified (map (lambda (row) (map simplify row)) jac-exprs)) (traced-rows (map (lambda (row) (map (lambda (e) (expr-to-traced e vars)) row)) simplified))) (lambda (point) (map (lambda (row-fns) (map (lambda (f) (let ((result (apply f point))) (if (traced? result) (traced-value result) result))) row-fns)) traced-rows))))"))
(task-entry (id "autodiff/interval-autodiff/iv-traced-pow") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12725) (name iv-traced-pow) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp iv-traced-log iv-traced-sin iv-traced-cos)) (answer "(define (iv-traced-pow base n) (let* ((bv (interval-traced-value base)) (result (interval-pow bv n)) (tape (and (interval-traced? base) (interval-traced-tape base)))) (if (error? result) result (if tape (let* ((n-iv (interval-singleton n)) (n-1-iv (interval-pow bv (- n 1))) (grad (if (error? n-1-iv) (interval 0 1e308) (interval-mul n-iv n-1-iv)))) (interval-traced-op 'pow result (list base) (list grad) tape)) result))))"))
(task-entry (id "autodiff/higher-order-diff/rec-sub") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12726) (name rec-sub) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add)) (answer "(define (rec-sub a b) (if (and (number? a) (number? b)) (- a b) (jet-sub a b)))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-hessian-exact") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12726) (name sparse-hessian-exact) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern sparse-jvp sparse-vjp sparse-hessian)) (answer "(define (sparse-hessian-exact f args) (let* ((n (length args)) (triplets (let loop-i ((i 0) (acc '())) (if (= i n) acc (loop-i (+ i 1) (let loop-j ((j i) (acc2 acc)) (if (= j n) acc2 (let* ((hd-args (let loop ((xs args) (k 0)) (if (null? xs) '() (cons (cond ((and (= k i) (= k j)) (hd-var12 (car xs))) ((= k i) (hd-var1 (car xs))) ((= k j) (hd-var2 (car xs))) (else (hd-lift (car xs)))) (loop (cdr xs) (+ k 1)))))) (result-hd (apply f hd-args)) (h-ij (hd-deriv12 result-hd))) (loop-j (+ j 1) (if (= h-ij 0) acc2 (if (= i j) (cons (list i j h-ij) acc2) (cons (list j i h-ij) (cons (list i j h-ij) acc2))))))))))))) (sparse-coo-from-triplets n n triplets)))"))
(task-entry (id "autodiff/typed-gradients/t-gradient") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12726) (name t-gradient) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix safe-hessian scalar-fn vector-fn)) (answer "(define (t-gradient n) (quasiquote (Vec (unquote n) Number)))"))
(task-entry (id "autodiff/symbolic-diff/symbolic-hessian-fn") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12726) (name symbolic-hessian-fn) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list simplify-diff simplify-neg simplify-quot simplify-pow simplify-app expr-to-traced eval-traced symbolic-gradient-fn symbolic-jacobian-fn)) (answer "(define (symbolic-hessian-fn expr vars) (let* ((hess-exprs (sym-hessian expr vars)) (simplified (map (lambda (row) (map simplify row)) hess-exprs)) (traced-rows (map (lambda (row) (map (lambda (e) (expr-to-traced e vars)) row)) simplified))) (lambda (point) (map (lambda (row-fns) (map (lambda (f) (let ((result (apply f point))) (if (traced? result) (traced-value result) result))) row-fns)) traced-rows))))"))
(task-entry (id "autodiff/interval-autodiff/interval-backward") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12726) (name interval-backward) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp iv-traced-log iv-traced-sin iv-traced-cos iv-traced-pow)) (answer "(define (interval-backward tape output-id seed-grad) (let ((grads (make-hashtable equal-hash equal?)) (entries (interval-tape-entries tape))) (hashtable-set! grads output-id seed-grad) (for-each (lambda (entry) (let* ((result-id (car entry)) (op-name (cadr entry)) (input-ids (caddr entry)) (local-grads (cadddr entry)) (result-grad (hashtable-ref grads result-id (interval-singleton 0)))) (for-each (lambda (input-id local-grad) (when input-id (let* ((contrib (interval-mul result-grad local-grad)) (current (hashtable-ref grads input-id (interval-singleton 0))) (new-grad (interval-add current contrib))) (hashtable-set! grads input-id new-grad)))) input-ids local-grads))) entries) grads))"))
(task-entry (id "autodiff/higher-order-diff/rec-mul") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12727) (name rec-mul) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub)) (answer "(define (rec-mul a b) (if (and (number? a) (number? b)) (* a b) (jet-mul a b)))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-hessian-vector-product") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12727) (name sparse-hessian-vector-product) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern sparse-jvp sparse-vjp sparse-hessian sparse-hessian-exact)) (answer "(define (sparse-hessian-vector-product f args v) (let* ((epsilon 1e-6) (n (length args)) (v-list (vector->list v)) (args+ (map (lambda (x dx) (+ x (* epsilon dx))) args v-list)) (grad0 (gradient f args)) (grad+ (gradient f args+)) (result (make-vector n 0))) (do ((i 0 (+ i 1)) (g0 grad0 (cdr g0)) (gp grad+ (cdr gp))) ((= i n) result) (vector-set! result i (/ (- (car gp) (car g0)) epsilon)))))"))
(task-entry (id "autodiff/typed-gradients/t-gradient-fn") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12727) (name t-gradient-fn) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix safe-hessian scalar-fn vector-fn t-gradient)) (answer "(define (t-gradient-fn n) (quasiquote (-> (Vec (unquote n) Number) (Vec (unquote n) Number))))"))
(task-entry (id "autodiff/symbolic-diff/verify-derivative") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12727) (name verify-derivative) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list simplify-diff simplify-neg simplify-quot simplify-pow simplify-app expr-to-traced eval-traced symbolic-gradient-fn symbolic-jacobian-fn symbolic-hessian-fn)) (answer "(define (verify-derivative expr var-sym test-val tolerance) (let* ((sym-deriv (simplify (deriv expr var-sym))) (sym-val (eval-expr sym-deriv (quasiquote (((unquote var-sym) unquote test-val))))) (traced-fn (expr-to-traced expr (list var-sym))) (ad-val (car (gradient traced-fn (list test-val))))) (< (abs (- sym-val ad-val)) tolerance)))"))
(task-entry (id "autodiff/interval-autodiff/interval-gradient") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12727) (name interval-gradient) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp iv-traced-log iv-traced-sin iv-traced-cos iv-traced-pow interval-backward)) (answer "(define (interval-gradient f box) (reset-interval-traced-ids!) (let* ((tape (make-interval-tape)) (traced-inputs (map (lambda (iv) (make-interval-traced-var iv tape)) box)) (output (f traced-inputs)) (output-id (interval-traced-id output)) (n (length box)) (input-ids (map interval-traced-id traced-inputs))) (cond ((not output-id) (make-list n (interval-singleton 0))) ((memv output-id input-ids) (map (lambda (id) (if (= id output-id) (interval-singleton 1) (interval-singleton 0))) input-ids)) (else (let ((grads (interval-backward tape output-id (interval-singleton 1)))) (map (lambda (id) (hashtable-ref grads id (interval-singleton 0))) input-ids))))))"))
