(task-entry (id "dataset/parameter/param-sample-raw") (skill dataset) (module parameter) (tier 1) (difficulty 13419) (name param-sample-raw) (type "") (description "") (notes ()) (section sampling) (deps (\x27;prelude \x27;prng \x27;distributions)) (available (make-prng prng-next-float prng-next-int make-param-range param-range? param-range-name param-range-min param-range-max param-range-strategy param-range-constraint uniform-range range-int range-normal range-choice param-range-choice? param-range-choice-name param-range-choice-values param-range-choice-constraint range-with-constraint)) (answer "(define (param-sample-raw r rng) (cond ((param-range? r) (let ((min-v (param-range-min r)) (max-v (param-range-max r)) (strategy (param-range-strategy r))) (case strategy ((uniform) (+ min-v (* (prng-next-float rng) (- max-v min-v)))) ((uniform-int) (+ min-v (prng-next-int rng (+ 1 (- max-v min-v))))) ((log-uniform) (let ((log-min (log (max 0.001 min-v))) (log-max (log max-v))) (exp (+ log-min (* (prng-next-float rng) (- log-max log-min)))))) (else (+ min-v (* (prng-next-float rng) (- max-v min-v))))))) ((and (pair? r) (eq? (car r) 'param-range-normal)) (let* ((min-v (list-ref r 2)) (max-v (list-ref r 3)) (mean (list-ref r 4)) (stddev (list-ref r 5)) (raw (sample-normal rng mean stddev))) (max min-v (min max-v raw)))) ((param-range-choice? r) (let* ((choices (param-range-choice-values r)) (n (length choices)) (idx (prng-next-int rng n))) (list-ref choices idx))) (else (error 'param-sample-raw \"Unknown range type\"))))"))
