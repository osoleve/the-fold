(task-entry (id "linalg/vec2/vec2-angle-between") (skill linalg) (module vec2) (tier 0) (difficulty 403) (name vec2-angle-between) (type "(-> Vec2 Vec2 Number)") (description "Angle between two vectors (radians, unsigned)") (notes ()) (section \x32;d-angles) (deps (\x27;prelude \x27;vec-common)) (available (vec2-cross vec2-perp-dot vec2-angle)) (answer "(define (vec2-angle-between a b) (let ((cos-theta (/ (vec2-dot a b) (* (vec2-magnitude a) (vec2-magnitude b))))) (acos (max -1 (min 1 cos-theta)))))"))
(task-entry (id "linalg/quaternion/quat-from-axis-angle") (skill linalg) (module quaternion) (tier 0) (difficulty 403) (name quat-from-axis-angle) (type "") (description "") (notes ()) (section quaternion-construction) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero)) (answer "(define (quat-from-axis-angle axis angle) (let* ((half-angle (/ angle 2)) (s (sin half-angle)) (c (cos half-angle))) (quat c (* s (vec3-x axis)) (* s (vec3-y axis)) (* s (vec3-z axis)))))"))
