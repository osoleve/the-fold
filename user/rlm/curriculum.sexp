(task-entry (id "sim/bifurcation/compute-critical-eigenvector") (skill sim) (module bifurcation) (tier 2) (difficulty 23401) (name compute-critical-eigenvector) (type "(-> ParamODE Number Vec (Option Vec))") (description "Compute the eigenvector corresponding to the zero eigenvalue at a bifurcation") (notes ("Uses SVD to find the null space robustly. Near-zero singular values (< 1e-6) indicate the null space.")) (section branch-switching) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant matrix-determinant-lu find-pivot-row-det swap-rows-det! analyze-bifurcations count-stability-changes *branch-switch-perturbation* *branch-switch-tolerance* *branch-switch-max-iter*)) (answer "(define (compute-critical-eigenvector psys param fp) (let* ((sys (instantiate-at psys param)) (jac (compute-jacobian sys fp *continuation-step-size*)) (n (matrix-rows jac)) (svd-result (svd jac))) (if (and (pair? svd-result) (eq? (car svd-result) 'error)) #f (let* ((u (car svd-result)) (sigma (cadr svd-result)) (v (caddr svd-result)) (min-idx (find-min-singular-value-index sigma n)) (min-val (matrix-ref sigma min-idx min-idx))) (if (> min-val 1e-6) #f (let ((eigenvec (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) eigenvec) (vector-set! eigenvec i (matrix-ref v i min-idx)))))))))"))
(task-entry (id "sim/bifurcation/find-min-singular-value-index") (skill sim) (module bifurcation) (tier 2) (difficulty 23402) (name find-min-singular-value-index) (type "(-> Matrix Nat Nat)") (description "Find index of smallest diagonal element in Σ matrix") (notes ()) (section branch-switching) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant matrix-determinant-lu find-pivot-row-det swap-rows-det! analyze-bifurcations count-stability-changes *branch-switch-perturbation* *branch-switch-tolerance* *branch-switch-max-iter* compute-critical-eigenvector)) (answer "(define (find-min-singular-value-index sigma n) (if (= n 0) 0 (let loop ((i 0) (min-idx 0) (min-val (abs (matrix-ref sigma 0 0)))) (if (= i n) min-idx (let ((val (abs (matrix-ref sigma i i)))) (if (< val min-val) (loop (+ i 1) i val) (loop (+ i 1) min-idx min-val)))))))"))
(task-entry (id "sim/bifurcation/switch-branch") (skill sim) (module bifurcation) (tier 2) (difficulty 23403) (name switch-branch) (type "(-> ParamODE (List (List Number Vec Symbol (List Complex))) Nat Symbol (Option (Pair Vec Number)))") (description "Switch to a new branch after a pitchfork or transcritical bifurcation") (notes ("After switching, use continue-fixed-point-arclength to follow the new branch")) (section branch-switching) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant matrix-determinant-lu find-pivot-row-det swap-rows-det! analyze-bifurcations count-stability-changes *branch-switch-perturbation* *branch-switch-tolerance* *branch-switch-max-iter* compute-critical-eigenvector find-min-singular-value-index)) (answer "(define (switch-branch psys continuation-data bifurcation-index direction) (if (>= bifurcation-index (length continuation-data)) #f (let* ((bif-point (list-ref continuation-data bifurcation-index)) (param (car bif-point)) (fp (cadr bif-point)) (eigenvec (compute-critical-eigenvector psys param fp))) (if (not eigenvec) #f (let* ((sign (if (eq? direction 'upper) 1.0 -1.0)) (perturbation (vec-scale (* sign *branch-switch-perturbation*) eigenvec)) (perturbed-fp (vec-add fp perturbation)) (sys (instantiate-at psys param)) (new-fp (find-fixed-point-robust sys perturbed-fp *branch-switch-tolerance* *continuation-step-size* *branch-switch-max-iter*))) (if (not new-fp) #f (if (< (vec-norm (vec-sub new-fp fp)) (* 2 *branch-switch-perturbation*)) #f (cons new-fp param))))))))"))
(task-entry (id "sim/bifurcation/switch-branch-adaptive") (skill sim) (module bifurcation) (tier 2) (difficulty 23404) (name switch-branch-adaptive) (type "(-> ParamODE Number Vec Symbol (Option (Pair Vec Number)))") (description "Switch to a new branch with adaptive perturbation size") (notes ("Steps forward in parameter and perturbs state to find new branch.\nFor pitchfork: new branches only exist past the bifurcation, so we step forward in parameter.")) (section branch-switching) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant matrix-determinant-lu find-pivot-row-det swap-rows-det! analyze-bifurcations count-stability-changes *branch-switch-perturbation* *branch-switch-tolerance* *branch-switch-max-iter* compute-critical-eigenvector find-min-singular-value-index switch-branch)) (answer "(define (switch-branch-adaptive psys param fp direction) (let ((eigenvec (compute-critical-eigenvector psys param fp))) (let* ((effective-eigenvec (or eigenvec (let search-param ((offsets '(-0.01 0.01 -0.05 0.05))) (if (null? offsets) #f (let ((ev (compute-critical-eigenvector psys (+ param (car offsets)) fp))) (or ev (search-param (cdr offsets)))))) (let ((n (vector-length fp))) (if (= n 1) (vector 1.0) #f))))) (if (not effective-eigenvec) #f (let ((sign (if (eq? direction 'upper) 1.0 -1.0))) (let try-combo ((param-steps '(0.0 0.01 -0.01 0.05 -0.05 0.1 -0.1)) (state-scales '(0.01 0.05 0.1 0.5 1.0))) (if (null? state-scales) #f (let try-param ((psteps param-steps)) (if (null? psteps) (try-combo param-steps (cdr state-scales)) (let* ((dparam (car psteps)) (new-param (+ param dparam)) (scale (car state-scales)) (perturbation (vec-scale (* sign scale) effective-eigenvec)) (perturbed-fp (vec-add fp perturbation)) (sys (instantiate-at psys new-param)) (original-at-new-param (find-fixed-point-robust sys fp *branch-switch-tolerance* *continuation-step-size* *branch-switch-max-iter*)) (new-fp (find-fixed-point-robust sys perturbed-fp *branch-switch-tolerance* *continuation-step-size* *branch-switch-max-iter*))) (cond ((not new-fp) (try-param (cdr psteps))) ((not original-at-new-param) (try-param (cdr psteps))) ((< (vec-norm (vec-sub new-fp original-at-new-param)) (* 0.1 scale)) (try-param (cdr psteps))) (else (cons new-fp new-param)))))))))))))"))
