(task-entry (id "fp/expr/match-expr") (skill fp) (module expr) (tier 1) (difficulty 10636) (name match-expr) (type "(-> Expr Pattern (Maybe Bindings))") (description "Try to match expression against pattern, returns alist of bindings or #f") (notes ()) (section pattern-matching) (deps (\x27;prelude)) (available (num var make-sum make-product make-diff make-neg make-div make-pow make-app sum product difference division power num? var? sum? product? difference? quotient? power? app? num-val var-name sum-terms product-factors diff-left diff-right quot-numer quot-denom pow-base pow-exp app-fn app-arg list-all-equal? expr=?)) (answer "(define (match-expr expr pattern) (cond ((eq? pattern '_) '()) ((and (pair? pattern) (eq? (car pattern) 'num) (eq? (cadr pattern) '_) (num? expr)) (list (cons '_ (num-val expr)))) ((and (pair? pattern) (eq? (car pattern) 'num) (number? (cadr pattern))) (if (and (num? expr) (= (num-val expr) (cadr pattern))) '() #f)) ((and (pair? pattern) (eq? (car pattern) 'var) (eq? (cadr pattern) '_) (var? expr)) (list (cons '_ (var-name expr)))) ((and (pair? pattern) (eq? (car pattern) 'var) (symbol? (cadr pattern))) (if (and (var? expr) (eq? (var-name expr) (cadr pattern))) '() #f)) ((symbol? pattern) (list (cons pattern expr))) ((and (sum? pattern) (sum? expr)) (let ((pattern-terms (sum-terms pattern)) (expr-terms (sum-terms expr))) (if (= (length pattern-terms) (length expr-terms)) (match-list expr-terms pattern-terms) #f))) ((and (product? pattern) (product? expr)) (let ((pattern-factors (product-factors pattern)) (expr-factors (product-factors expr))) (if (= (length pattern-factors) (length expr-factors)) (match-list expr-factors pattern-factors) #f))) ((and (power? pattern) (power? expr)) (let ((b1 (match-expr (pow-base expr) (pow-base pattern))) (b2 (match-expr (pow-exp expr) (pow-exp pattern)))) (if (and b1 b2) (merge-bindings b1 b2) #f))) ((and (difference? pattern) (difference? expr)) (let ((b1 (match-expr (diff-left expr) (diff-left pattern))) (b2 (if (and (diff-right pattern) (diff-right expr)) (match-expr (diff-right expr) (diff-right pattern)) (if (and (not (diff-right pattern)) (not (diff-right expr))) '() #f)))) (if (and b1 b2) (merge-bindings b1 b2) #f))) ((and (quotient? pattern) (quotient? expr)) (let ((b1 (match-expr (quot-numer expr) (quot-numer pattern))) (b2 (match-expr (quot-denom expr) (quot-denom pattern)))) (if (and b1 b2) (merge-bindings b1 b2) #f))) ((and (app? pattern) (app? expr) (eq? (app-fn pattern) (app-fn expr))) (match-expr (app-arg expr) (app-arg pattern))) ((equal? expr pattern) '()) (else #f)))"))
(task-entry (id "fp/simplify/remove-first") (skill fp) (module simplify) (tier 1) (difficulty 10636) (name remove-first) (type "(-> α (List α) (List α))") (description "Remove first occurrence of element from list") (notes ()) (section trigonometric-identities) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow simplify-app expand expand-once expand-product expand-power-of-sum factor factor-sum find-common-factor get-factors divides? divide-out simplify-trig simplify-trig-once simplify-pythagorean-identity find-sin-squared find-matching-cos-squared simplify-double-angle-product)) (answer "(define (remove-first elem lst) (cond ((null? lst) '()) ((equal? (car lst) elem) (cdr lst)) (else (cons (car lst) (remove-first elem (cdr lst))))))"))
(task-entry (id "fp/units/qty=?") (skill fp) (module units) (tier 1) (difficulty 10636) (name qty=?) (type "(-> Quantity Quantity (Result Boolean Error))") (description "Equal quantities (dimensions must match).") (notes ()) (section quantity-comparison) (deps (\x27;prelude)) (available (make-dim dim-length dim-time dim-mass dim-current dim-temperature dim-amount dim-luminosity dim? dim=? dim-one dim-length-base dim-time-base dim-mass-base dim-current-base dim-temperature-base dim-amount-base dim-luminosity-base dim* dim/ dim-pow dim-sqrt dim-inv make-qty qty-value qty-dim qty? qty+ qty- qty* qty/ qty-scale qty-pow qty-sqrt qty-neg qty-abs)) (answer "(define (qty=? q1 q2) (if (dim=? (qty-dim q1) (qty-dim q2)) (= (qty-value q1) (qty-value q2)) (error 'qty=? \"dimension mismatch\")))"))
(task-entry (id "fp/cost-analysis/work-ratio") (skill fp) (module cost-analysis) (tier 1) (difficulty 10636) (name work-ratio) (type "(-> Expr Expr Real)") (description "Compute the work ratio between two expressions.\nReturns w1/w2, useful for load balancing.") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost *form-costs* form-cost *estimate-work-fuel* estimate-work estimate-work-with-fuel estimate-let-work estimate-branch-work estimate-cond-work estimate-hof-work estimate-list-size parallel-beneficial? parallel-beneficial-n? suggested-parallelism work-analysis work-analysis? analysis-total-cost analysis-complexity-class analysis-hotspots analysis-parallelizable? analysis-suggested-splits expr-complexity-class classify-complexity combine-complexity find-hotspots collect-costs sort-by-cost total-work)) (answer "(define (work-ratio e1 e2) (let ((w1 (estimate-work e1)) (w2 (estimate-work e2))) (if (= w2 0) +inf.0 (/ w1 w2))))"))
