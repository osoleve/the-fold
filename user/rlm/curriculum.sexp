(task-entry (id "sim/simulation-stream/sim-until") (skill sim) (module simulation-stream) (tier 2) (difficulty 23334) (name sim-until) (type "(-> (-> SimState Boolean) Number (Stream SimState) (List SimState))") (description "Collect states until predicate returns true (with fuel limit)") (notes ()) (section simulation-stream-utilities) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time sim-sample sim-sample-loop)) (answer "(define (sim-until pred fuel stream) (let loop ((s stream) (n fuel) (acc '())) (cond ((<= n 0) (reverse acc)) ((stream-nil? s) (reverse acc)) ((pred (stream-head s)) (reverse (cons (stream-head s) acc))) (else (loop (stream-tail s) (- n 1) (cons (stream-head s) acc))))))"))
