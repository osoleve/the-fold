(task-entry (id "geometry/mesh-gen/render-mesh-2d") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12285) (name render-mesh-2d) (type "") (description "") (notes ()) (section visualization) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location location? location-triangle location-bary point2-x point2-y vertex-key make-tri2 tri2? tri2-p1 tri2-p2 tri2-p3 tri2-points orient2d tri2-signed-area tri2-area tri2-circumcenter tri2-circumradius-sq point-in-circumcircle? make-edge edge-p1 edge-p2 points-equal? edges-equal? tri2-edges edge-in-list? count-edge edge-key find-boundary-edges-hash segments-properly-intersect? edge-properly-intersects-edge? triangle-crosses-edge? triangle-crosses-any-constraint? make-super-triangle triangle-uses-point? triangle-uses-super-vertex? delaunay-insert-point delaunay-insert-point-diff point2-key key<? canonical-edge-key build-adjacency find-boundary-edges triangle-neighbors delaunay-triangulate barycentric-coords locate-point interpolate-at point2-distance tri2-edge-lengths tri2-aspect-ratio tri2-angles tri2-min-angle tri2-max-angle radians->degrees mesh-quality-report tri2-is-bad? refine-mesh build-vertex-neighbors find-boundary-vertices laplacian-smooth-step smooth-mesh tri2-should-refine? area-entry-cmp heap-pop-by adaptive-refine-mesh refine-mesh-uniform point-in-polygon? polygon-centroid polygon-area generate-interior-points polygon-to-constraint-edges triangulate-polygon triangulate-polygon-adaptive triangles-to-3d random-points-in-rect)) (answer "(define (render-mesh-2d tris-or-tri width height) (let ((triangles (if (triangulation? tris-or-tri) (triangulation-triangles tris-or-tri) tris-or-tri))) (if (null? triangles) \"Empty mesh\n\" (let* ((all-points (append-map tri2-points triangles)) (xs (map point2-x all-points)) (ys (map point2-y all-points)) (x-min (apply min xs)) (x-max (apply max xs)) (y-min (apply min ys)) (y-max (apply max ys)) (x-range (max 0.001 (- x-max x-min))) (y-range (max 0.001 (- y-max y-min))) (buffer (make-vector (* width height) #\\ ))) (define (scale-point p) (let ((x (inexact->exact (round (* (- width 1) (/ (- (point2-x p) x-min) x-range))))) (y (inexact->exact (round (* (- height 1) (/ (- (point2-y p) y-min) y-range)))))) (cons (max 0 (min (- width 1) x)) (max 0 (min (- height 1) y))))) (define (draw-line p1 p2) (let* ((c1 (scale-point p1)) (c2 (scale-point p2)) (x1 (car c1)) (y1 (cdr c1)) (x2 (car c2)) (y2 (cdr c2)) (dx (- x2 x1)) (dy (- y2 y1)) (steps (max 1 (max (abs dx) (abs dy))))) (do ((i 0 (+ i 1))) ((> i steps)) (let* ((t (/ i steps)) (x (inexact->exact (round (+ x1 (* t dx))))) (y (inexact->exact (round (+ y1 (* t dy))))) (idx (+ x (* y width)))) (when (and (>= idx 0) (< idx (* width height))) (vector-set! buffer idx #\\.)))))) (for-each (lambda (tri) (draw-line (tri2-p1 tri) (tri2-p2 tri)) (draw-line (tri2-p2 tri) (tri2-p3 tri)) (draw-line (tri2-p3 tri) (tri2-p1 tri))) triangles) (for-each (lambda (p) (let* ((c (scale-point p)) (idx (+ (car c) (* (cdr c) width)))) (when (and (>= idx 0) (< idx (* width height))) (vector-set! buffer idx #\\*)))) all-points) (let loop ((y 0) (result '())) (if (>= y height) (apply string-append (reverse result)) (loop (+ y 1) (cons (string-append (list->string (let row-loop ((x 0) (row '())) (if (>= x width) (reverse row) (row-loop (+ x 1) (cons (vector-ref buffer (+ x (* y width))) row))))) \"\n\") result))))))))"))
