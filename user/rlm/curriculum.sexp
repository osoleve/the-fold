(task-entry (id "random/distributions/random-normal-pair") (skill random) (module distributions) (tier 1) (difficulty 12908) (name random-normal-pair) (type "") (description "") (notes ()) (section standard-normal) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard)) (answer "(define random-normal-pair (state-bind random-float (lambda (u1) (state-bind random-float (lambda (u2) (let* ((r (sqrt (* -2 (safe-log u1)))) (theta (* 2 (pi-value) u2))) (state-pure (cons (* r (cos-num theta)) (* r (sin-num theta))))))))))"))
(task-entry (id "random/probability/sample-prob") (skill random) (module probability) (tier 1) (difficulty 12908) (name sample-prob) (type "") (description "") (notes ()) (section running-probability-computations) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob)) (answer "(define (sample-prob p prng) (car (car (run-prob p prng))))"))
(task-entry (id "random/bayesian/beta-credible-interval") (skill random) (module bayesian) (tier 1) (difficulty 12908) (name beta-credible-interval) (type "") (description "") (notes ()) (section conjugate-prior-beta-binomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance)) (answer "(define (beta-credible-interval prior level) (let* ((mean (beta-posterior-mean prior)) (std (sqrt (beta-posterior-variance prior))) (z (cond ((= level 0.99) 2.576) ((= level 0.95) 1.96) ((= level 0.9) 1.645) (else 1.96))) (half-width (* z std))) (cons (max 0 (- mean half-width)) (min 1 (+ mean half-width)))))"))
(task-entry (id "random/monte-carlo/sample-summary") (skill random) (module monte-carlo) (tier 1) (difficulty 12908) (name sample-summary) (type "") (description "") (notes ()) (section statistical-summary-functions) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max)) (answer "(define (sample-summary samples) (let ((n (length samples))) (if (= n 0) '((n . 0)) (quasiquote ((n unquote n) (mean unquote (sample-mean samples)) (std unquote (sample-std samples)) (sem unquote (sample-sem samples)) (min unquote (sample-min samples)) (q25 unquote (sample-quantile samples 0.25)) (median unquote (sample-median samples)) (q75 unquote (sample-quantile samples 0.75)) (max unquote (sample-max samples)))))))"))
(task-entry (id "random/variational-inference/mf-gaussian-reparam") (skill random) (module variational-inference) (tier 1) (difficulty 12908) (name mf-gaussian-reparam) (type "") (description "") (notes ()) (section reparameterization-trick) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals)) (answer "(define (mf-gaussian-reparam vfamily epsilons) (let ((means (mf-gaussian-means vfamily)) (log-stds (mf-gaussian-log-stds vfamily))) (map (lambda (mu log-s eps) (+ mu (* (exp log-s) eps))) means log-stds epsilons)))"))
