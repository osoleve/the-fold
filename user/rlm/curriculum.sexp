(task-entry (id "algebra/groebner/reduce-basis") (skill algebra) (module groebner) (tier 0) (difficulty 307) (name reduce-basis) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger buchberger-loop buchberger-criterion-1? all-pairs)) (answer "(define (reduce-basis G) (if (null? G) '() (let* ((Fld (mpoly-field (car G))) (monic-G (map (lambda (p) (mpoly-make-monic p Fld)) G)) (minimal (minimize-basis monic-G)) (reduced (interreduce minimal Fld))) reduced)))"))
