(task-entry (id "linalg/matrix/matrix-col") (skill linalg) (module matrix) (tier 0) (difficulty 410) (name matrix-col) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row)) (answer "(define (matrix-col m j) (let ((rows (matrix-rows m)) (cols (matrix-cols m)) (data (matrix-data m))) (if (and (>= j 0) (< j cols)) (let ((result (make-vector rows 0))) (do ((i 0 (+ i 1))) ((= i rows) result) (vector-set! result i (vector-ref data (+ (* i cols) j))))) (quasiquote (error out-of-bounds (unquote j) (unquote cols))))))"))
(task-entry (id "linalg/matrix-decomp/permutation-sign") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 410) (name permutation-sign) (type "") (description "Compute the sign of a permutation: (-1)^(number of inversions). An inversion is a pair (i, j) where i < j but P[i] > P[j].") (notes ()) (section determinant) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance* matrix-copy matrix-set! matrix-column matrix-lu matrix-lu-solve qr-find-orthogonal-basis qr-orthogonalize-remaining! matrix-qr matrix-cholesky)) (answer "(define (permutation-sign p) (let ((n (vector-length p))) (let outer ((i 0) (swaps 0)) (if (= i n) (if (even? swaps) 1 -1) (let inner ((j (+ i 1)) (s swaps)) (if (= j n) (outer (+ i 1) s) (inner (+ j 1) (if (> (vector-ref p i) (vector-ref p j)) (+ s 1) s))))))))"))
(task-entry (id "linalg/matrix-solvers/levinson-durbin") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 410) (name levinson-durbin) (type "") (description "") (notes ()) (section toeplitz-solvers) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute matrix-back-substitute matrix-solve matrix-inverse permutation-parity matrix-determinant matrix-least-squares matrix-gauss-elim matrix-rank matrix-condition-number)) (answer "(define (levinson-durbin r) (let* ((n (- (vector-length r) 1)) (phi (make-vector n 0.0)) (phi-tmp (make-vector n 0.0)) (e (vector-ref r 0))) (if (= n 0) (make-vector 0) (let loop ((m 1)) (if (> m n) phi (let ((lambda-num (- (vector-ref r m) (let inner ((k 1) (sum 0.0)) (if (>= k m) sum (inner (+ k 1) (+ sum (* (vector-ref phi (- k 1)) (vector-ref r (- m k)))))))))) (if (< (abs e) 1e-15) (list 'error 'singular m) (let ((lambda-m (/ lambda-num e))) (do ((k 1 (+ k 1))) ((>= k m)) (vector-set! phi-tmp (- k 1) (- (vector-ref phi (- k 1)) (* lambda-m (vector-ref phi (- m k 1)))))) (vector-set! phi-tmp (- m 1) lambda-m) (do ((k 0 (+ k 1))) ((= k m)) (vector-set! phi k (vector-ref phi-tmp k))) (set! e (* e (- 1 (* lambda-m lambda-m)))) (loop (+ m 1))))))))))"))
(task-entry (id "linalg/matrix-eigen/detect-complex-2x2-block") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 410) (name detect-complex-2x2-block) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once)) (answer "(define (detect-complex-2x2-block a start tol) (let* ((i start) (j (+ start 1)) (n (matrix-rows a))) (if (>= j n) #f (let* ((a-ii (matrix-ref a i i)) (a-ij (matrix-ref a i j)) (a-ji (matrix-ref a j i)) (a-jj (matrix-ref a j j)) (sub-significant? (> (abs a-ji) tol)) (trace (+ a-ii a-jj)) (det (- (* a-ii a-jj) (* a-ij a-ji))) (discriminant (- (* trace trace) (* 4 det)))) (if (and sub-significant? (< discriminant (- tol))) (cons (/ trace 2) (/ (sqrt (- discriminant)) 2)) #f)))))"))
(task-entry (id "linalg/iterative-solvers/conjugate-gradient") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 410) (name conjugate-gradient) (type "") (description "") (notes ()) (section conjugate-gradient) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop)) (answer "(define (conjugate-gradient a b . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (cond ((not (= n m)) (quasiquote (error not-square (unquote n) (unquote m)))) ((not (= n (vector-length b))) (quasiquote (error dimension-mismatch (unquote n) (unquote (vector-length b))))) (else (let* ((x0 (if (and (pair? opts) (vector? (car opts))) (car opts) (make-vector n 0.0))) (rest1 (if (and (pair? opts) (vector? (car opts))) (cdr opts) opts)) (max-iter (if (and (pair? rest1) (integer? (car rest1))) (car rest1) n)) (rest2 (if (and (pair? rest1) (integer? (car rest1))) (cdr rest1) rest1)) (tol (if (and (pair? rest2) (number? (car rest2))) (car rest2) *iterative-tolerance*)) (ax0 (matrix-vec-mul a x0)) (r0 (vec-sub b ax0)) (r0-norm (vec-norm r0))) (if (< r0-norm tol) (list x0 0 r0-norm) (cg-loop a b (vector-copy x0) r0 (vector-copy r0) (vec-dot r0 r0) 0 max-iter tol n)))))))"))
(task-entry (id "linalg/sparse/sparse-coo-ref") (skill linalg) (module sparse) (tier 0) (difficulty 410) (name sparse-coo-ref) (type "") (description "") (notes ()) (section coo-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets)) (answer "(define (sparse-coo-ref m i j) (let ((row-idx (sparse-coo-row-indices m)) (col-idx (sparse-coo-col-indices m)) (vals (sparse-coo-values m)) (nnz (sparse-coo-nnz m))) (let loop ((k 0)) (cond ((= k nnz) 0) ((and (= (vector-ref row-idx k) i) (= (vector-ref col-idx k) j)) (vector-ref vals k)) (else (loop (+ k 1)))))))"))
(task-entry (id "linalg/graph-laplacian/remap-partition") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 410) (name remap-partition) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph)) (answer "(define (remap-partition local-nodes original-nodes) (let ((node-vec (list->vector original-nodes))) (map (lambda (local-idx) (vector-ref node-vec local-idx)) local-nodes)))"))
(task-entry (id "linalg/svd/find-orthogonal-vector") (skill linalg) (module svd) (tier 0) (difficulty 410) (name find-orthogonal-vector) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis!)) (answer "(define (find-orthogonal-vector mat col n) (let try-basis ((k 0)) (if (= k n) #f (let* ((e-k (vec-unit n k)) (v (let orth-loop ((c 0) (curr e-k)) (if (= c col) curr (let* ((col-c (matrix-col mat c)) (proj (vec-dot col-c curr))) (orth-loop (+ c 1) (vec-sub curr (vec-scale proj col-c))))))) (v-norm (vec-norm v))) (if (> v-norm *svd-tolerance*) (vec-scale (/ 1.0 v-norm) v) (try-basis (+ k 1)))))))"))
