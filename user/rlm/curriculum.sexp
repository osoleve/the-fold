(task-entry (id "physics/classical/collision-detection/closest-point-on-segment") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23538) (name closest-point-on-segment) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon?)) (answer "(define (closest-point-on-segment point v1 v2) (let* ((edge (vec2-sub v2 v1)) (edge-len-sq (vec2-magnitude-sq edge))) (if (< edge-len-sq 1e-4) v1 (let* ((t (/ (vec2-dot (vec2-sub point v1) edge) edge-len-sq)) (t-clamped (max 0 (min 1 t)))) (vec2-add v1 (vec2-scale edge t-clamped))))))"))
