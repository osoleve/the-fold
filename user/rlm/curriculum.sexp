(task-entry (id "dataset/parameter/sample-normal") (skill dataset) (module parameter) (tier 1) (difficulty 13420) (name sample-normal) (type "") (description "") (notes ()) (section sampling) (deps (\x27;prelude \x27;prng \x27;distributions)) (available (make-prng prng-next-float prng-next-int make-param-range param-range? param-range-name param-range-min param-range-max param-range-strategy param-range-constraint uniform-range range-int range-normal range-choice param-range-choice? param-range-choice-name param-range-choice-values param-range-choice-constraint range-with-constraint param-sample-raw)) (answer "(define (sample-normal rng mean stddev) (let* ((u1 (max 1e-4 (prng-next-float rng))) (u2 (prng-next-float rng)) (z (* (sqrt (* -2 (log u1))) (cos (* 2 3.141592653589793 u2))))) (+ mean (* stddev z))))"))
