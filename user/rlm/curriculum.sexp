(task-entry (id "geometry/mesh-sdf/subdivide-icosphere-once") (skill geometry) (module mesh-sdf) (tier 1) (difficulty 12208) (name subdivide-icosphere-once) (type "(-> (List Triangle3) Number (List Triangle3))") (description "Single subdivision pass using shared edge midpoints") (notes ("Key insight: each edge midpoint is computed ONCE and shared by adjacent triangles; uses vertex identity (not coordinates) for edge keying to avoid floating-point issues")) (section mesh-construction-helpers) (deps (\x27;prelude \x27;geometry \x27;bvh)) (available (make-mesh mesh? mesh-triangles mesh-bvh mesh-sdf mesh-sdf-gradient make-mesh-cube subdivide-icosphere-triangles)) (answer "(define (subdivide-icosphere-once triangles radius) (let* ((vertex-id-table (make-eq-hashtable)) (next-id 0) (get-vertex-id (lambda (v) (or (eq-hashtable-ref vertex-id-table v #f) (let ((id next-id)) (eq-hashtable-set! vertex-id-table v id) (set! next-id (+ next-id 1)) id)))) (edge-midpoints (make-hashtable equal-hash equal?))) (for-each (lambda (tri) (get-vertex-id (triangle3-p1 tri)) (get-vertex-id (triangle3-p2 tri)) (get-vertex-id (triangle3-p3 tri))) triangles) (for-each (lambda (tri) (let ((v0 (triangle3-p1 tri)) (v1 (triangle3-p2 tri)) (v2 (triangle3-p3 tri))) (ensure-edge-midpoint-by-id! edge-midpoints v0 v1 radius (get-vertex-id v0) (get-vertex-id v1)) (ensure-edge-midpoint-by-id! edge-midpoints v1 v2 radius (get-vertex-id v1) (get-vertex-id v2)) (ensure-edge-midpoint-by-id! edge-midpoints v2 v0 radius (get-vertex-id v2) (get-vertex-id v0)))) triangles) (append-map (lambda (tri) (subdivide-triangle-with-midpoints-by-id tri edge-midpoints get-vertex-id)) triangles)))"))
(task-entry (id "geometry/marching-cubes/marching-cubes-sphere") (skill geometry) (module marching-cubes) (tier 1) (difficulty 12208) (name marching-cubes-sphere) (type "(-> Point3 Number Number (List Triangle3))") (description "Extract mesh for a sphere SDF") (notes ()) (section high-level-api) (deps (\x27;prelude \x27;geometry)) (available (edge-table tri-table marching-cubes-grid marching-cubes-cube compute-cube-index compute-edge-intersections generate-cube-triangles marching-cubes)) (answer "(define (marching-cubes-sphere center radius resolution) (let ((sdf-fn (lambda (p) (- (vec3-length (vec3-sub p center)) radius)))) (marching-cubes sdf-fn center (* radius 1.5) resolution)))"))
