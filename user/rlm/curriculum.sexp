(task-entry (id "geometry/geometry-optics/ray3-direction-lens") (skill geometry) (module geometry-optics) (tier 1) (difficulty 12206) (name ray3-direction-lens) (type "") (description "") (notes ()) (section ray3-lenses) (deps (\x27;prelude \x27;optics \x27;geometry)) (available (vec3-x-lens vec3-y-lens vec3-z-lens line3-origin-lens line3-direction-lens ray3-origin-lens)) (answer "(define ray3-direction-lens (make-lens ray3-direction (lambda (new-dir r) (ray3 (ray3-origin r) new-dir))))"))
(task-entry (id "geometry/shape-protocol/scene-total-volume") (skill geometry) (module shape-protocol) (tier 1) (difficulty 12206) (name scene-total-volume) (type "(-> (List Shape) Number)") (description "Sum of volumes of all volumetric shapes") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;vec3 \x27;geometry)) (available (distance-to-segment scene-intersect-ray scene-aabb shapes-containing-point closest-shape scene-sdf)) (answer "(define (scene-total-volume shapes) (let loop ((shapes shapes) (total 0)) (if (null? shapes) total (let ((v (shape-volume (car shapes)))) (loop (cdr shapes) (if v (+ total v) total))))))"))
(task-entry (id "geometry/geometry/ray3-origin") (skill geometry) (module geometry) (tier 1) (difficulty 12207) (name ray3-origin) (type "(-> Ray3 Vec3)") (description "") (notes ()) (section primitives) (deps (\x27;prelude \x27;vec3 \x27;matrix \x27;quaternion)) (available (point3 line3 line3? line3-origin line3-direction ray3 ray3?)) (answer "(define (ray3-origin r) (cadr r))"))
(task-entry (id "geometry/raymarch/sdf-normal") (skill geometry) (module raymarch) (tier 1) (difficulty 12207) (name sdf-normal) (type "(-> (-> Vec3 Real) Vec3 Vec3)") (description "Compute surface normal using gradient of SDF") (notes ("Uses central differences for better accuracy")) (section normal-computation) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (raymarch-params raymarch-params-max-steps raymarch-params-max-distance raymarch-params-hit-threshold default-raymarch-params raymarch raymarch-mesh)) (answer "(define (sdf-normal sdf-fn point) (let* ((eps 0.001) (dx (- (sdf-fn (vec3-add point (vec3 eps 0 0))) (sdf-fn (vec3-sub point (vec3 eps 0 0))))) (dy (- (sdf-fn (vec3-add point (vec3 0 eps 0))) (sdf-fn (vec3-sub point (vec3 0 eps 0))))) (dz (- (sdf-fn (vec3-add point (vec3 0 0 eps))) (sdf-fn (vec3-sub point (vec3 0 0 eps)))))) (vec3-normalize (vec3 dx dy dz))))"))
(task-entry (id "geometry/octree/octree-children") (skill geometry) (module octree) (tier 1) (difficulty 12207) (name octree-children) (type "(-> Octree (Maybe (Vector Octree)))") (description "") (notes ()) (section octree-node-structure) (deps (\x27;prelude \x27;geometry)) (available (octree-leaf octree-node octree-leaf? octree-node? octree-center octree-size octree-primitives)) (answer "(define (octree-children node) (if (octree-node? node) (cadddr node) #f))"))
