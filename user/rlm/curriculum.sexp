(task-entry (id "clp/domain/domain-bounds") (skill clp) (module domain) (tier 1) (difficulty 10813) (name domain-bounds) (type "(-> Domain (Maybe (Pair Int Int)))") (description "Get (min, max) bounds of domain") (notes ()) (section domain-accessors) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last)) (answer "(define (domain-bounds dom) (if (null? dom) #f (cons (domain-min dom) (domain-max dom))))"))
(task-entry (id "clp/store/alist-remove") (skill clp) (module store) (tier 1) (difficulty 10813) (name alist-remove) (type "(-> Key Alist Alist)") (description "Remove all entries with given key") (notes ()) (section domain-operations-on-store) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update)) (answer "(define (alist-remove key alist) (filter (lambda (pair) (not (equal? (car pair) key))) alist))"))
(task-entry (id "clp/fd-constraints/=/=fd-var-var") (skill clp) (module fd-constraints) (tier 1) (difficulty 10813) (name =/=fd-var-var) (type "(-> CStore LVar LVar (Maybe CStore))") (description "Constrain two variables to be unequal") (notes ()) (section comparison-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const)) (answer "(define (=/=fd-var-var cs x y) (let ((dom-x (cstore-get-domain cs x)) (dom-y (cstore-get-domain cs y))) (cond ((and dom-x (domain-singleton? dom-x) dom-y) (cstore-remove-value cs y (domain-min dom-x))) ((and dom-y (domain-singleton? dom-y) dom-x) (cstore-remove-value cs x (domain-min dom-y))) (else cs))))"))
(task-entry (id "clp/global-constraints/post-sum-fd") (skill clp) (module global-constraints) (tier 1) (difficulty 10813) (name post-sum-fd) (type "(-> CStore (List LVar) (Or LVar Int) (Maybe CStore))") (description "Post sum constraint and register for re-propagation") (notes ()) (section sum-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate sum-fd-narrow-vars)) (answer "(define (post-sum-fd cs vars result) (let ((all-vars (if (lvar? result) (cons result vars) vars))) (post-constraint cs 'sum-fd all-vars (sum-fd vars result))))"))
