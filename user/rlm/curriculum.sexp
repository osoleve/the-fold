(task-entry (id "data/graph-matrix/sparse-adjacency->edges") (skill data) (module graph-matrix) (tier 0) (difficulty 1315) (name sparse-adjacency->edges) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency)) (answer "(define (sparse-adjacency->edges m . opts) (let* ((weighted (if (null? opts) #t (car opts))) (n (sparse-csr-rows m)) (row-ptrs (sparse-csr-row-ptrs m)) (col-idx (sparse-csr-col-indices m)) (vals (sparse-csr-values m))) (let loop ((i 0) (edges '())) (if (= i n) (reverse edges) (let ((start (vector-ref row-ptrs i)) (end (vector-ref row-ptrs (+ i 1)))) (let inner ((k start) (edges edges)) (if (= k end) (loop (+ i 1) edges) (let ((j (vector-ref col-idx k)) (w (vector-ref vals k))) (inner (+ k 1) (cons (if weighted (list i j w) (list i j)) edges))))))))))"))
(task-entry (id "data/centrality/closeness-centrality-from-edges") (skill data) (module centrality) (tier 0) (difficulty 1315) (name closeness-centrality-from-edges) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality standard-closeness-node harmonic-closeness-node closeness-centrality-from-adj)) (answer "(define (closeness-centrality-from-edges edges . opts) (let* ((n (if (and (pair? opts) (integer? (car opts))) (car opts) (infer-node-count edges))) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (adj (edges->adjacency-matrix edges n))) (apply closeness-centrality-from-adj (cons adj rest1))))"))
