(task-entry (id "number-theory/primality/miller-rabin-witness?") (skill number-theory) (module primality) (tier 0) (difficulty 102) (name miller-rabin-witness?) (type "(-> Int Int Boolean)") (description "Test if a is a Miller-Rabin witness for n being composite. Internal helper for miller-rabin?") (notes ()) (section miller-rabin) (deps (\x27;prelude \x27;sort \x27;modular)) (available (prime? composite?)) (answer "(define (miller-rabin-witness? a n) (let* ((n-1 (- n 1)) (factor-result (factor-out-2s n-1)) (d (car factor-result)) (r (cdr factor-result)) (x (mod-expt a d n))) (cond ((or (= x 1) (= x n-1)) #f) (else (let loop ((x x) (i 0)) (cond ((>= i (- r 1)) #t) (else (let ((x-new (mod-expt x 2 n))) (cond ((= x-new 1) #t) ((= x-new n-1) #f) (else (loop x-new (+ i 1))))))))))))"))
(task-entry (id "number-theory/fast-multiply/integer->limbs") (skill number-theory) (module fast-multiply) (tier 0) (difficulty 102) (name integer->limbs) (type "(-> Nat Nat (List Nat))") (description "Convert integer to limb list. Returns least-significant limb first.") (notes ()) (section limb-operations) (deps (\x27;prelude)) (available (*default-base* limbs->integer)) (answer "(define (integer->limbs n base) (if (= n 0) '(0) (let loop ((n n) (limbs '())) (if (= n 0) (reverse limbs) (loop (quotient n base) (cons (modulo n base) limbs))))))"))
(task-entry (id "number-theory/modular/mod-expt") (skill number-theory) (module modular) (tier 0) (difficulty 103) (name mod-expt) (type "(-> Int Nat Int Int)") (description "Modular exponentiation using square-and-multiply algorithm. Computes (base^exp) mod m efficiently") (notes ("O(log exp)" "Assumes m > 0, exp >= 0")) (section modular-exponentiation) (deps (\x27;prelude)) (available (mod+ mod- mod*)) (answer "(define (mod-expt base exp m) (let loop ((b (modulo base m)) (e exp) (result 1)) (cond ((= e 0) (modulo result m)) ((odd? e) (loop (modulo (* b b) m) (quotient e 2) (modulo (* result b) m))) (else (loop (modulo (* b b) m) (quotient e 2) result)))))"))
