(task-entry (id "numeric/digital-filters/butterworth-lowpass-poles") (skill numeric) (module digital-filters) (tier 0) (difficulty 2526) (name butterworth-lowpass-poles) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window bessel-i0 sinc fir-lowpass fir-highpass fir-bandpass fir-bandstop fir-filter make-iir-filter iir-filter? iir-filter-b iir-filter-a iir-filter-signal make-biquad biquad? biquad-b0 biquad-b1 biquad-b2 biquad-a1 biquad-a2 biquad-filter cascade-biquads)) (answer "(define (butterworth-lowpass-poles order) (let loop ((k 0) (poles '())) (if (= k order) (reverse poles) (let* ((angle (/ (* (pi-value) (+ (* 2 k) order 1)) (* 2 order))) (pole (make-polar 1 angle))) (loop (+ k 1) (cons pole poles))))))"))
