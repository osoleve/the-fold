(task-entry (id "statistics/model-protocol/model-summary") (skill statistics) (module model-protocol) (tier 1) (difficulty 11205) (name model-summary) (type "(-> Model Assoc)") (description "Generate unified summary for any statistical model") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;result-types \x27;sort)) (available (model-mse model-rmse model-mae compare-models-aic compare-models-bic)) (answer "(define (model-summary model) (let* ((type-tag (car model)) (base-summary (quasiquote ((type unquote type-tag) (n unquote (model-n model)) (p unquote (model-p model)) (df-residual unquote (model-df-residual model)) (sigma unquote (model-sigma model)) (mse unquote (model-mse model)) (rmse unquote (model-rmse model)) (aic unquote (model-aic model)) (bic unquote (model-bic model)))))) (let ((r2 (model-r-squared model)) (dev (model-deviance model))) (append base-summary (if r2 (quasiquote ((r-squared unquote r2))) '()) (if dev (quasiquote ((deviance unquote dev))) '())))))"))
