(task-entry (id "dataset/parameter/param-sample") (skill dataset) (module parameter) (tier 1) (difficulty 13421) (name param-sample) (type "(-> ParamRange RNG Nat Any)") (description "") (notes ()) (section sampling) (deps (\x27;prelude \x27;prng \x27;distributions)) (available (make-prng prng-next-float prng-next-int make-param-range param-range? param-range-name param-range-min param-range-max param-range-strategy param-range-constraint uniform-range range-int range-normal range-choice param-range-choice? param-range-choice-name param-range-choice-values param-range-choice-constraint range-with-constraint param-sample-raw sample-normal)) (answer "(define (param-sample r rng max-tries) (let ((constraint (cond ((param-range? r) (param-range-constraint r)) ((param-range-choice? r) (param-range-choice-constraint r)) (else (lambda (_) #t))))) (let loop ((tries 0)) (if (>= tries max-tries) (error 'param-sample \"Failed to sample valid value after max tries\") (let ((val (param-sample-raw r rng))) (if (constraint val) val (loop (+ tries 1))))))))"))
