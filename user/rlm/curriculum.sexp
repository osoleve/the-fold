(task-entry (id "dataset/distractor/distractor-double-half") (skill dataset) (module distractor) (tier 1) (difficulty 13407) (name distractor-double-half) (type "") (description "") (notes ()) (section builtin) (deps (\x27;prelude \x27;prng \x27;parameter \x27;sort)) (available (make-distractor-strategy distractor-strategy? distractor-strategy-name distractor-strategy-generator distractor-nearby distractor-sign-flip distractor-off-by-one)) (answer "(define distractor-double-half (make-distractor-strategy 'double-half (lambda (correct rng) (if (and (number? correct) (not (zero? correct))) (if (< (prng-next-float rng) 0.5) (* correct 2) (/ correct 2)) correct))))"))
(task-entry (id "dataset/difficulty/inference-direct") (skill dataset) (module difficulty) (tier 1) (difficulty 13407) (name inference-direct) (type "") (description "") (notes ()) (section inference-depth) (deps (\x27;prelude)) (available (make-difficulty-vector difficulty-vec? dv-inference-depth dv-object-count dv-temporal-steps dv-visual-precision dv-formula-complexity)) (answer "(define inference-direct 0)"))
(task-entry (id "dataset/sexp/pp-sexp") (skill dataset) (module sexp) (tier 1) (difficulty 13407) (name pp-sexp) (type "") (description "") (notes ()) (section pretty) (deps (core/base/prelude.ss lattice/dataset/sample.ss lattice/data/sort.ss)) (available (sample->canonical-sexp sort-alist canonical-sexp->sample dataset->sexp sexp->dataset sexp->string sexp->pretty-string)) (answer "(define (pp-sexp sexp indent depth) (let ((pad (make-string (* depth indent) #\\ ))) (cond ((null? sexp) \"()\") ((not (pair? sexp)) (cond ((string? sexp) (format \"~s\" sexp)) ((symbol? sexp) (symbol->string sexp)) ((number? sexp) (number->string sexp)) (else (format \"~s\" sexp)))) ((and (eq? (car sexp) 'sample) (> (length sexp) 3)) (string-append \"(sample\n\" (apply string-append (map (lambda (field) (string-append pad \"  \" (pp-sexp field indent (+ depth 1)) \"\n\")) (cdr sexp))) pad \")\")) ((and (pair? sexp) (< (sexp-length sexp) 60)) (string-append \"(\" (join-strings (map (lambda (x) (pp-sexp x indent depth)) sexp) \" \") \")\")) (else (string-append \"(\" (pp-sexp (car sexp) indent depth) \"\n\" (apply string-append (map (lambda (x) (string-append pad \"  \" (pp-sexp x indent (+ depth 1)) \"\n\")) (cdr sexp))) pad \")\")))))"))
(task-entry (id "dataset/jsonl/json->sample") (skill dataset) (module jsonl) (tier 1) (difficulty 13407) (name json->sample) (type "") (description "") (notes ()) (section conversion) (deps (core/base/prelude.ss lattice/optics/optics.ss lattice/dataset/sample.ss)) (available (make-json-object json-object? json-object-pairs make-json-array json-array? json-array-items sample->json)) (answer "(define (json->sample json) (if (json-object? json) (let* ((pairs (json-object-pairs json)) (get (lambda (key) (let ((pair (assoc key pairs))) (and pair (cdr pair))))) (id (get \"id\")) (frames-json (get \"frames\")) (frames (if (json-array? frames-json) (json-array-items frames-json) '())) (question (get \"question\")) (opts-json (get \"options\")) (options (if (json-object? opts-json) (map (lambda (p) (cons (string->symbol (car p)) (cdr p))) (json-object-pairs opts-json)) '())) (answer (string->symbol (get \"answer\"))) (meta-json (get \"metadata\")) (metadata (if (json-object? meta-json) (map (lambda (p) (cons (string->symbol (car p)) (json->value (cdr p)))) (json-object-pairs meta-json)) '()))) (make-sample id frames question options answer metadata)) (error 'json->sample \"Expected JSON object\")))"))
