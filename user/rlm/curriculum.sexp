(task-entry (id "data/graph-homology/graph-is-tree?") (skill data) (module graph-homology) (tier 0) (difficulty 1308) (name graph-is-tree?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;homology)) (available (graph->simplicial-complex graph-adjacency->simplicial-complex graph-betti-numbers graph-betti-numbers-from-adjacency cycle-basis-homology edges-from-z2-null-vector graph-euler-characteristic graph-cycle-rank)) (answer "(define (graph-is-tree? edges vertices) (let ((betti (graph-betti-numbers edges vertices))) (and (= (car betti) 1) (= (cdr betti) 0))))"))
(task-entry (id "data/pagerank/pagerank-power-iteration") (skill data) (module pagerank) (tier 0) (difficulty 1308) (name pagerank-power-iteration) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations* adjacency->transition matrix-row-sum matrix-col-sum make-google-matrix pagerank-from-matrix)) (answer "(define (pagerank-power-iteration google v0 max-iter tol) (let loop ((v v0) (iter 0)) (if (>= iter max-iter) v (let* ((v-new (matrix-vec-mul google v)) (v-sum (vec-sum v-new)) (v-normalized (if (> (abs v-sum) 1e-15) (vec-scale (/ 1.0 v-sum) v-new) v-new)) (diff (vec-sub v-normalized v)) (change (vec-norm-1 diff))) (if (< change tol) v-normalized (loop v-normalized (+ iter 1)))))))"))
(task-entry (id "data/graph-matrix/adjacency-matrix->edges") (skill data) (module graph-matrix) (tier 0) (difficulty 1308) (name adjacency-matrix->edges) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix)) (answer "(define (adjacency-matrix->edges m . opts) (let* ((weighted (if (null? opts) #t (car opts))) (n (matrix-rows m)) (data (matrix-data m))) (let loop ((i 0) (j 0) (edges '())) (cond ((= i n) (reverse edges)) ((= j n) (loop (+ i 1) 0 edges)) (else (let ((w (vector-ref data (+ (* i n) j)))) (if (= w 0) (loop i (+ j 1) edges) (loop i (+ j 1) (cons (if weighted (list i j w) (list i j)) edges)))))))))"))
(task-entry (id "data/centrality/katz-centrality") (skill data) (module centrality) (tier 0) (difficulty 1308) (name katz-centrality) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges)) (answer "(define (katz-centrality adj . opts) (let* ((n (matrix-rows adj)) (m (matrix-cols adj))) (if (not (= n m)) (quasiquote (error not-square (unquote n) (unquote m))) (let* ((alpha (if (and (pair? opts) (number? (car opts))) (car opts) 0.1)) (rest1 (if (and (pair? opts) (number? (car opts))) (cdr opts) opts)) (beta (if (and (pair? rest1) (number? (car rest1))) (car rest1) 1.0)) (rest2 (if (and (pair? rest1) (number? (car rest1))) (cdr rest1) rest1)) (max-iter (if (and (pair? rest2) (integer? (car rest2))) (car rest2) *centrality-max-iterations*)) (rest3 (if (and (pair? rest2) (integer? (car rest2))) (cdr rest2) rest2)) (tol (if (and (pair? rest3) (number? (car rest3))) (car rest3) *centrality-tolerance*)) (ones (make-vec n 1.0))) (katz-power-series adj alpha beta ones max-iter tol)))))"))
(task-entry (id "data/graph-community/prim-mst-naive") (skill data) (module graph-community) (tier 0) (difficulty 1308) (name prim-mst-naive) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst)) (answer "(define (prim-mst-naive adj . opts) (let* ((n (matrix-rows adj)) (start (if (pair? opts) (car opts) 0)) (in-mst (make-vector n #f)) (min-weight (make-vector n +inf.0)) (parent (make-vector n -1)) (mst-edges '())) (vector-set! min-weight start 0) (do ((count 0 (+ count 1))) ((= count n)) (let ((u (prim-find-min min-weight in-mst n))) (when u (vector-set! in-mst u #t) (when (>= (vector-ref parent u) 0) (set! mst-edges (cons (list (vector-ref parent u) u (matrix-ref adj (vector-ref parent u) u)) mst-edges))) (do ((v 0 (+ v 1))) ((= v n)) (let ((w (matrix-ref adj u v))) (when (and (> w 0) (not (vector-ref in-mst v)) (< w (vector-ref min-weight v))) (vector-set! min-weight v w) (vector-set! parent v u))))))) (reverse mst-edges)))"))
