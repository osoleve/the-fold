(task-entry (id "random/prng/pcg-next") (skill random) (module prng) (tier 1) (difficulty 12917) (name pcg-next) (type "") (description "") (notes ()) (section pcg) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc)) (answer "(define (pcg-next p) (let* ((state (pcg-state p)) (inc (pcg-inc p)) (xorshifted (u32 (ash (bitwise-xor (ash state -18) state) -27))) (rot (ash state -59)) (output (rotr32 xorshifted rot)) (new-state (u64 (+ (* state 6364136223846793005) inc)))) (cons output (list 'pcg new-state inc))))"))
(task-entry (id "random/distributions/normal-pdf") (skill random) (module distributions) (tier 1) (difficulty 12917) (name normal-pdf) (type "(-> Number Number Number Number)") (description "Normal probability density at x") (notes ()) (section normal-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal)) (answer "(define (normal-pdf x mean stddev) (let* ((z (/ (- x mean) stddev)) (coef (/ 1 (* stddev (sqrt (* 2 (pi-value))))))) (* coef (exp-num (* -0.5 z z)))))"))
