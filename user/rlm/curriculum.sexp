(task-entry (id "algebra/polynomial/poly-add-coeffs") (skill algebra) (module polynomial) (tier 0) (difficulty 315) (name poly-add-coeffs) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add)) (answer "(define (poly-add-coeffs add c1 c2 zero) (cond ((null? c1) c2) ((null? c2) c1) (else (cons (add (car c1) (car c2)) (poly-add-coeffs add (cdr c1) (cdr c2) zero)))))"))
(task-entry (id "algebra/multivariate/mono-lcm-helper") (skill algebra) (module multivariate) (tier 0) (difficulty 315) (name mono-lcm-helper) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm)) (answer "(define (mono-lcm-helper m1 m2) (cond ((null? m1) m2) ((null? m2) m1) (else (let ((v1 (caar m1)) (e1 (cdar m1)) (v2 (caar m2)) (e2 (cdar m2))) (cond ((symbol<? v1 v2) (cons (car m1) (mono-lcm-helper (cdr m1) m2))) ((symbol<? v2 v1) (cons (car m2) (mono-lcm-helper m1 (cdr m2)))) (else (cons (cons v1 (max e1 e2)) (mono-lcm-helper (cdr m1) (cdr m2)))))))))"))
