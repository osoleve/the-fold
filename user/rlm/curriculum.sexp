(task-entry (id "physics/classical/collision-detection/polygon-polygon?") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23543) (name polygon-polygon?) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon? closest-point-on-segment circle-polygon-manifold project-polygon project-circle intervals-overlap)) (answer "(define (polygon-polygon? a b) (let* ((normals-a (polygon-normals a)) (normals-b (polygon-normals b)) (all-normals (append normals-a normals-b))) (let loop ((ns all-normals)) (if (null? ns) #t (let* ((axis (car ns)) (proj-a (project-polygon a axis)) (proj-b (project-polygon b axis)) (overlap (intervals-overlap proj-a proj-b))) (if (not overlap) #f (loop (cdr ns))))))))"))
(task-entry (id "physics/classical/collision-response/resolve-all-collisions") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23543) (name resolve-all-collisions) (type "") (description "") (notes ()) (section batch) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material combine-materials velocity-at-point relative-velocity-at relative-velocity normal-velocity-at normal-velocity tangent-velocity get-inv-mass get-inv-inertia get-body-pos calculate-impulse-with-rotation calculate-impulse calculate-friction-impulse body-is-static? apply-impulse-at apply-impulse resolve-collision resolve-collision-with-rotation *position-slop* *position-percent* body-with-position correct-positions resolve-with-correction resolve-with-rotation-and-correction body-circle-circle-manifold body-circle-aabb-manifold)) (answer "(define (resolve-all-collisions manifolds mat-fn) (if (null? manifolds) '() (let* ((all-bodies (fold-left (lambda (bodies m) (let ((a (manifold-body-a m)) (b (manifold-body-b m))) (cons a (cons b bodies)))) '() manifolds)) (body-table (make-hashtable equal-hash equal?))) (for-each (lambda (b) (let ((key (body-pos b))) (unless (hashtable-ref body-table key #f) (hashtable-set! body-table key b)))) all-bodies) (for-each (lambda (m) (let* ((mats (mat-fn m)) (mat-a (car mats)) (mat-b (cadr mats)) (result (resolve-with-correction m mat-a mat-b)) (new-a (car result)) (new-b (cadr result))) (hashtable-set! body-table (body-pos (manifold-body-a m)) new-a) (hashtable-set! body-table (body-pos (manifold-body-b m)) new-b))) manifolds) (let-values (((keys vals) (hashtable-entries body-table))) (vector->list vals)))))"))
(task-entry (id "physics/classical/world/world-resolve-collision-velocities!") (skill physics/classical) (module world) (tier 2) (difficulty 23543) (name world-resolve-collision-velocities!) (type "") (description "") (notes ()) (section world) (deps (\x27;prelude \x27;vec2 \x27;integrators \x27;collision-detection \x27;collision-response \x27;raycasting \x27;constraints \x27;constraint-solver \x27;sort)) (available (make-entity entity? entity-id entity-body entity-shape entity-material entity-user-data entity-with-body entity-pos entity-vel entity-static? transform-shape entity-world-shape make-world-config config-fixed-dt config-max-substeps config-solver-iterations config-cell-size make-world world? world-entities world-gravity world-spatial-hash world-config world-time-acc world-constraints world-with-time-acc world-add-entity! world-remove-entity! world-get-entity world-entity-list world-update-entity! world-add-constraint! world-remove-constraint! world-get-constraint world-constraint-list world-update-constraint! make-force-acc force-acc-add! force-acc-get force-acc-clear! world-step! world-fixed-step!)) (answer "(define (world-resolve-collision-velocities! world collisions) (for-each (lambda (collision) (let* ((ent-a (car collision)) (ent-b (cadr collision)) (manifold-data (caddr collision)) (normal (car manifold-data)) (penetration (cadr manifold-data)) (contact (caddr manifold-data))) (let* ((current-a (world-get-entity world (entity-id ent-a))) (current-b (world-get-entity world (entity-id ent-b)))) (when (and current-a current-b) (let* ((body-a (entity-body current-a)) (body-b (entity-body current-b)) (mat-a (entity-material current-a)) (mat-b (entity-material current-b)) (manifold (make-manifold body-a body-b normal penetration contact)) (result (resolve-collision manifold mat-a mat-b)) (new-body-a (car result)) (new-body-b (cadr result))) (world-update-entity! world (entity-id ent-a) (lambda (e) (entity-with-body e new-body-a))) (world-update-entity! world (entity-id ent-b) (lambda (e) (entity-with-body e new-body-b)))))))) collisions))"))
(task-entry (id "physics/classical/particles/emitter-emit") (skill physics/classical) (module particles) (tier 2) (difficulty 23543) (name emitter-emit) (type "") (description "") (notes ()) (section emitter) (deps (\x27;prelude \x27;sort \x27;vec2 \x27;prng)) (available (make-particle particle? particle-pos particle-vel particle-lifetime particle-max-life particle-size particle-color particle-user-data particle-alive? particle-age particle-with-pos particle-with-vel particle-with-state gravity-field wind-field drag-field attractor-field vortex-field turbulence-field combine-fields integrate-particle update-particle update-particles make-emitter emitter? emitter-pos emitter-rate emitter-spread emitter-direction emitter-speed-min emitter-speed-max emitter-lifetime-min emitter-lifetime-max emitter-size-min emitter-size-max emitter-color emitter-user-data emitter-accumulator emitter-with-pos emitter-with-direction emitter-with-accumulator spawn-particle)) (answer "(define (emitter-emit e dt rng) (let* ((to-emit (+ (emitter-accumulator e) (* (emitter-rate e) dt))) (count (inexact->exact (floor to-emit))) (remainder (- to-emit count)) (new-emitter (emitter-with-accumulator e remainder))) (let loop ((n count) (particles '()) (r rng)) (if (<= n 0) (list particles new-emitter r) (let* ((result (spawn-particle e r)) (p (car result)) (r-next (cdr result))) (loop (- n 1) (cons p particles) r-next))))))"))
(task-entry (id "physics/classical/ascii-renderer/fmod") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23543) (name fmod) (type "") (description "") (notes ()) (section debug:) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line! draw-filled-circle! polygon-scanline-intersections fill-between-pairs! draw-filled-polygon! draw-filled-aabb! draw-aabb-outline!)) (answer "(define (fmod x y) (- x (* (floor (/ x y)) y)))"))
(task-entry (id "physics/classical/integrators/rigid-body-lerp") (skill physics/classical) (module integrators) (tier 2) (difficulty 23544) (name rigid-body-lerp) (type "") (description "") (notes ()) (section rigid) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet integrate-body-rk4 make-time-acc time-acc? time-acc-remaining time-acc-fixed-dt time-acc-max-steps time-acc-add time-acc-consume time-acc-alpha substep-body integrate-with-substeps interpolate-body gravity-force spring-force drag-force constant-force combine-forces body-kinetic-energy body-potential-energy body-spring-energy body-total-energy integrate-rigid-body-symplectic integrate-rigid-body-euler integrate-rigid-body-verlet rigid-body-gravity-force rigid-body-damping)) (answer "(define (rigid-body-lerp body-prev body-curr alpha) (let* ((pos (vec2-lerp (rigid-body-pos body-prev) (rigid-body-pos body-curr) alpha)) (vel (vec2-lerp (rigid-body-vel body-prev) (rigid-body-vel body-curr) alpha)) (angle (+ (* (- 1 alpha) (rigid-body-angle body-prev)) (* alpha (rigid-body-angle body-curr)))) (omega (+ (* (- 1 alpha) (rigid-body-angular-vel body-prev)) (* alpha (rigid-body-angular-vel body-curr))))) (rigid-body-with-state body-curr pos vel angle omega)))"))
(task-entry (id "physics/classical/collision-detection/polygon-polygon-manifold") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23544) (name polygon-polygon-manifold) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon? closest-point-on-segment circle-polygon-manifold project-polygon project-circle intervals-overlap polygon-polygon?)) (answer "(define (polygon-polygon-manifold a b) (let* ((normals-a (polygon-normals a)) (normals-b (polygon-normals b)) (all-normals (append normals-a normals-b))) (let loop ((ns all-normals) (min-overlap +inf.0) (best-normal #f)) (if (null? ns) (if (not best-normal) #f (let* ((center-a (polygon-center a)) (center-b (polygon-center b)) (diff (vec2-sub center-b center-a)) (normal (if (< (vec2-dot best-normal diff) 0) (vec2-neg best-normal) best-normal)) (verts-a (polygon-vertices a)) (contact (let loop ((vs verts-a) (best-v (car verts-a)) (best-dot (vec2-dot (car verts-a) normal))) (if (null? vs) best-v (let ((dot (vec2-dot (car vs) normal))) (if (> dot best-dot) (loop (cdr vs) (car vs) dot) (loop (cdr vs) best-v best-dot))))))) (list normal min-overlap contact))) (let* ((axis (car ns)) (proj-a (project-polygon a axis)) (proj-b (project-polygon b axis)) (overlap (intervals-overlap proj-a proj-b))) (if (not overlap) #f (if (< overlap min-overlap) (loop (cdr ns) overlap axis) (loop (cdr ns) min-overlap best-normal))))))))"))
(task-entry (id "physics/classical/collision-response/solve-iterations") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23544) (name solve-iterations) (type "") (description "") (notes ()) (section iterative) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material combine-materials velocity-at-point relative-velocity-at relative-velocity normal-velocity-at normal-velocity tangent-velocity get-inv-mass get-inv-inertia get-body-pos calculate-impulse-with-rotation calculate-impulse calculate-friction-impulse body-is-static? apply-impulse-at apply-impulse resolve-collision resolve-collision-with-rotation *position-slop* *position-percent* body-with-position correct-positions resolve-with-correction resolve-with-rotation-and-correction body-circle-circle-manifold body-circle-aabb-manifold resolve-all-collisions)) (answer "(define (solve-iterations manifolds mat-fn iterations) (if (or (null? manifolds) (= iterations 0)) (if (null? manifolds) '() (fold-left (lambda (bodies m) (cons (manifold-body-a m) (cons (manifold-body-b m) bodies))) '() manifolds)) (let loop ((ms manifolds) (i 0)) (if (>= i iterations) (fold-left (lambda (bodies m) (cons (manifold-body-a m) (cons (manifold-body-b m) bodies))) '() ms) (loop (map (lambda (m) (let* ((mats (mat-fn m)) (result (resolve-with-correction m (car mats) (cadr mats)))) (make-manifold (car result) (cadr result) (manifold-normal m) (manifold-penetration m) (manifold-contact m)))) ms) (+ i 1))))))"))
