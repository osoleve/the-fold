(task-entry (id "fp/combinators/cons-if") (skill fp) (module combinators) (tier 1) (difficulty 10658) (name cons-if) (type "(-> Boolean a (List a) (List a))") (description "Conditionally cons an element") (notes ()) (section list-utilities) (deps (\x27;prelude \x27;sort)) (available (id identity const flip apply-fn compose2 compose pipe2 pipe >>> <<< curry2 uncurry2 curry3 uncurry3 partial partial2 rpartial on both pair-first pair-second bimap complement conjoin disjoin fst snd swap dup pair nothing just just? nothing? from-just maybe maybe-fmap maybe-bind filter-maybe cat-maybes sequence-maybe left right left? right? from-left from-right either either-fmap either-fmap-left either-bind from-either rights lefts partition-eithers head tail)) (answer "(define (cons-if pred x xs) (if pred (cons x xs) xs))"))
(task-entry (id "fp/dsl/apply-binop") (skill fp) (module dsl) (tier 1) (difficulty 10658) (name apply-binop) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;free \x27;effects)) (available (make-instruction instruction-tag instruction-payload instruction-cont dsl-fmap dsl-pure dsl-pure? dsl-suspended? dsl-pure-value dsl-instruction dsl-bind dsl-map dsl-emit dsl-request make-interpreter interpreter? interpreter-handler run-dsl run-dsl-helper run-dsl-eff run-dsl-state dsl-trace layered-interpreter composed-interpreter expr-lit expr-var expr-binop expr-unop expr-app expr-if expr-let expr-lambda expr-lit? expr-var? expr-binop? expr-unop? expr-app? expr-if? expr-let? expr-lambda? expr-lit-value expr-var-name expr-binop-op expr-binop-left expr-binop-right expr-unop-op expr-unop-operand expr-app-fn expr-app-args expr-if-cond expr-if-then expr-if-else expr-let-name expr-let-value expr-let-body expr-lambda-params expr-lambda-body eval-expr)) (answer "(define (apply-binop op left right) (case op ((+) (+ left right)) ((-) (- left right)) ((*) (* left right)) ((/) (/ left right)) ((%) (modulo left right)) ((=) (= left right)) ((<) (< left right)) ((>) (> left right)) ((<=) (<= left right)) ((>=) (>= left right)) ((and) (and left right)) ((or) (or left right)) ((cons) (cons left right)) (else (error 'apply-binop \"Unknown operator\" op))))"))
