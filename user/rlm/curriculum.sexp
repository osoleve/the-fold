(task-entry (id "physics/classical/raycasting/ray2-segment-intersection") (skill physics/classical) (module raycasting) (tier 2) (difficulty 23515) (name ray2-segment-intersection) (type "") (description "") (notes ()) (section ray-segment) (deps (\x27;prelude \x27;vec2 \x27;collision-detection)) (available (*ray-epsilon* make-ray2 ray2? ray2-origin ray2-direction ray2-max-dist ray2-point-at make-hit-info hit-info? hit-info-distance hit-info-point hit-info-normal hit-info-shape ray2-aabb ray2-circle)) (answer "(define (ray2-segment-intersection ray-origin ray-dir p1 p2) (let* ((edge (vec2-sub p2 p1)) (origin-to-p1 (vec2-sub p1 ray-origin)) (denom (vec2-cross ray-dir edge))) (if (< (abs denom) *ray-epsilon*) #f (let* ((t (/ (vec2-cross origin-to-p1 edge) denom)) (u (/ (vec2-cross origin-to-p1 ray-dir) denom))) (if (and (>= t 0) (>= u 0) (<= u 1)) (cons t u) #f)))))"))
