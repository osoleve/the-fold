(task-entry (id "dsl/partial-eval/pe-state-fresh-var") (skill dsl) (module partial-eval) (tier 1) (difficulty 11728) (name pe-state-fresh-var) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt? bt-join bt-meet bt<=? make-bt-env bt-env-extend bt-env-lookup bt-env-extend-many pe-primitive? bta bta-annotate make-static-store static-store-extend static-store-lookup static-store-has? static-store-shadow make-pe-state pe-state-limit pe-state-depth pe-state-memo pe-state-residuals pe-state-counter pe-state-incr-depth pe-state-decr-depth pe-state-can-unfold?)) (answer "(define (pe-state-fresh-var st prefix) (let ((n (pe-state-counter st)) (new-st (list 'pe-state (pe-state-limit st) (pe-state-depth st) (pe-state-memo st) (pe-state-residuals st) (+ (pe-state-counter st) 1)))) (cons (string->symbol (format \"~a$~a\" prefix n)) new-st)))"))
(task-entry (id "dsl/compose/arith-fmap") (skill dsl) (module compose) (tier 1) (difficulty 11728) (name arith-fmap) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap row-fmap-helper register-fmap make-functor-row functor-row? functor-row-functors functor-row-contains? functor-row-index functor-row-extend functor-row-union build-injection-path inject-by-index make-tagged-functor tagged-functor? tagged-functor-tag tagged-functor-value inject lit-f add-f neg-f)) (answer "(define (arith-fmap f cmd) (let ((tag (car cmd))) (case tag ((lit) cmd) ((add) (list 'add (f (cadr cmd)) (f (caddr cmd)))) ((neg) (list 'neg (f (cadr cmd)))) (else (error 'arith-fmap \"Unknown arithmetic operation\" tag)))))"))
