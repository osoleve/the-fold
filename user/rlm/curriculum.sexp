(task-entry (id "diffgeo/charts/make-transition") (skill diffgeo) (module charts) (tier 1) (difficulty 10710) (name make-transition) (type "") (description "") (notes ()) (section transition-functions) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp)) (available (chart? chart-name chart-dim chart-domain-pred chart-coord-map chart-inverse-map make-chart chart-contains? chart-apply chart-apply-inverse)) (answer "(define (make-transition chart-from chart-to) (if (not (= (chart-dim chart-from) (chart-dim chart-to))) #f (lambda (coords) (let ((point ((chart-inverse-map chart-from) coords))) ((chart-coord-map chart-to) point)))))"))
