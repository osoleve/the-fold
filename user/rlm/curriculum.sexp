(task-entry (id "physics/classical/collision-detection/spatial-hash-query") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23558) (name spatial-hash-query) (type "") (description "") (notes ()) (section broad) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon? closest-point-on-segment circle-polygon-manifold project-polygon project-circle intervals-overlap polygon-polygon? polygon-polygon-manifold shape-type shape-aabb shapes-collide? aabb-to-polygon shapes-manifold make-spatial-hash spatial-hash? spatial-hash-cell-size spatial-hash-table point-to-cell aabb-to-cells spatial-hash-insert! spatial-hash-clear!)) (answer "(define (spatial-hash-query hash aabb) (let* ((cell-size (spatial-hash-cell-size hash)) (table (spatial-hash-table hash)) (cells (aabb-to-cells aabb cell-size)) (result (make-hashtable equal-hash equal?))) (for-each (lambda (cell) (for-each (lambda (obj) (hashtable-set! result obj #t)) (hashtable-ref table cell '()))) cells) (let-values (((keys vals) (hashtable-entries result))) (vector->list keys))))"))
(task-entry (id "physics/classical/world/world-raycast-closest") (skill physics/classical) (module world) (tier 2) (difficulty 23558) (name world-raycast-closest) (type "") (description "") (notes ()) (section world) (deps (\x27;prelude \x27;vec2 \x27;integrators \x27;collision-detection \x27;collision-response \x27;raycasting \x27;constraints \x27;constraint-solver \x27;sort)) (available (make-entity entity? entity-id entity-body entity-shape entity-material entity-user-data entity-with-body entity-pos entity-vel entity-static? transform-shape entity-world-shape make-world-config config-fixed-dt config-max-substeps config-solver-iterations config-cell-size make-world world? world-entities world-gravity world-spatial-hash world-config world-time-acc world-constraints world-with-time-acc world-add-entity! world-remove-entity! world-get-entity world-entity-list world-update-entity! world-add-constraint! world-remove-constraint! world-get-constraint world-constraint-list world-update-constraint! make-force-acc force-acc-add! force-acc-get force-acc-clear! world-step! world-fixed-step! world-resolve-collision-velocities! world-correct-collision-positions! world-solve-constraint-velocities! world-correct-constraint-positions! world-integrate-velocities! world-integrate-positions! world-detect-collisions make-pair-key make-circle-entity make-box-entity make-static-circle make-static-box make-ground world-query-aabb world-query-point)) (answer "(define (world-raycast-closest world ray) (let* ((entities (world-entity-list world)) (best-hit #f) (best-entity #f) (best-dist (ray2-max-dist ray))) (for-each (lambda (e) (let* ((shape (entity-world-shape e)) (hit (ray2-shape ray shape))) (when (and hit (< (hit-info-distance hit) best-dist)) (set! best-hit hit) (set! best-entity e) (set! best-dist (hit-info-distance hit))))) entities) (if best-hit (cons best-entity best-hit) #f)))"))
