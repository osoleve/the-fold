(task-entry (id "dsl/match/compile-clauses") (skill dsl) (module match) (tier 1) (difficulty 11743) (name compile-clauses) (type "") (description "") (notes ()) (section decision-tree-representation) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available (make-as-pattern make-view-pattern make-active-pattern as-pattern? view-pattern? active-pattern? as-pattern-name as-pattern-inner view-pattern-fn view-pattern-inner active-pattern-name active-pattern-args make-leaf make-fail make-switch make-dt-guard leaf? fail? switch? dt-guard? leaf-action leaf-bindings switch-scrutinee switch-branches switch-default dt-guard-condition dt-guard-success dt-guard-failure make-branch branch? branch-tag branch-arity branch-subtree make-clause clause? clause-pattern clause-guard clause-body parse-pattern-extended parse-clause collect-bindings collect-bindings-from-pattern compile-match)) (answer "(define (compile-clauses access-exprs rows) (cond ((null? rows) (make-fail)) ((null? access-exprs) (let* ((first-row (car rows)) (guard (cadr first-row)) (body (caddr first-row)) (bindings (if (>= (length first-row) 4) (cadddr first-row) '()))) (if guard (make-dt-guard guard (make-leaf body bindings) (compile-clauses access-exprs (cdr rows))) (make-leaf body bindings)))) (else (let* ((col-idx (select-column rows)) (access-expr (list-ref access-exprs col-idx)) (first-col (map (lambda (row) (list-ref (car row) col-idx)) rows))) (compile-column access-expr access-exprs col-idx rows first-col)))))"))
(task-entry (id "dsl/partial-eval/specialize-function") (skill dsl) (module partial-eval) (tier 1) (difficulty 11743) (name specialize-function) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt? bt-join bt-meet bt<=? make-bt-env bt-env-extend bt-env-lookup bt-env-extend-many pe-primitive? bta bta-annotate make-static-store static-store-extend static-store-lookup static-store-has? static-store-shadow make-pe-state pe-state-limit pe-state-depth pe-state-memo pe-state-residuals pe-state-counter pe-state-incr-depth pe-state-decr-depth pe-state-can-unfold? pe-state-fresh-var pe-state-add-memo pe-state-lookup-memo pe-state-add-residual pe-online pe-online-list pe-static-value? pe-apply-primitive pe-unquote pe-offline pe-offline-dynamic pe-offline-list partial-eval partial-eval-offline specialize)) (answer "(define (specialize-function func-def static-bindings) (cond ((and (pair? func-def) (eq? (car func-def) 'define)) (let* ((sig (cadr func-def)) (body (caddr func-def))) (if (pair? sig) (let* ((name (car sig)) (params (cdr sig)) (static-params (map car static-bindings)) (dynamic-params (filter (lambda (p) (not (memq p static-params))) params)) (spec-body (partial-eval body static-bindings))) (quasiquote (define ((unquote name) (unquote-splicing dynamic-params)) (unquote spec-body)))) (let ((spec-expr (partial-eval body static-bindings))) (quasiquote (define (unquote sig) (unquote spec-expr))))))) ((and (pair? func-def) (eq? (car func-def) 'lambda)) (let* ((params (cadr func-def)) (body (caddr func-def)) (static-params (map car static-bindings)) (dynamic-params (filter (lambda (p) (not (memq p static-params))) params)) (spec-body (partial-eval body static-bindings))) (quasiquote (lambda (unquote dynamic-params) (unquote spec-body))))) (else (partial-eval func-def static-bindings))))"))
