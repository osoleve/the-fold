(task-entry (id "geometry/shape-protocol/scene-intersect-ray") (skill geometry) (module shape-protocol) (tier 1) (difficulty 12201) (name scene-intersect-ray) (type "(-> (List Shape) Ray3 (Or (Pair Shape Number) #f))") (description "Find first shape hit by ray, returns (shape . t) or #f") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;vec3 \x27;geometry)) (available (distance-to-segment)) (answer "(define (scene-intersect-ray shapes ray) (let loop ((shapes shapes) (best-shape #f) (best-t +inf.0)) (if (null? shapes) (if best-shape (cons best-shape best-t) #f) (let* ((shape (car shapes)) (hit (shape-intersect-ray shape ray))) (if hit (let ((t (if (pair? hit) (let ((t1 (car hit)) (t2 (cadr hit))) (cond ((and (>= t1 0) (>= t2 0)) (min t1 t2)) ((>= t1 0) t1) ((>= t2 0) t2) (else +inf.0))) hit))) (if (and (> t 0) (< t best-t)) (loop (cdr shapes) shape t) (loop (cdr shapes) best-shape best-t))) (loop (cdr shapes) best-shape best-t))))))"))
