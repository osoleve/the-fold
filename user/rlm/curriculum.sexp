(task-entry (id "optics/optics/optic-compose") (skill optics) (module optics) (tier 1) (difficulty 11117) (name optic-compose) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate? grate-cotraverse-fn grate-review grate-over grate-set grate-zipWith grate-zipWith3 grate-zip grate-compose grate-id grate-fn grate-pair-same grate-list-rep iso->grate grate->setter optic-type)) (answer "(define (optic-compose outer inner) (let ((t1 (optic-type outer)) (t2 (optic-type inner))) (cond ((and (eq? t1 'iso) (eq? t2 'iso)) (iso-compose outer inner)) ((and (eq? t1 'iso) (eq? t2 'lens)) (lens-compose (iso->lens outer) inner)) ((and (eq? t1 'lens) (eq? t2 'iso)) (lens-compose outer (iso->lens inner))) ((and (eq? t1 'iso) (eq? t2 'prism)) (prism-compose (iso->prism outer) inner)) ((and (eq? t1 'prism) (eq? t2 'iso)) (prism-compose outer (iso->prism inner))) ((and (eq? t1 'iso) (eq? t2 'grate)) (grate-compose (iso->grate outer) inner)) ((and (eq? t1 'grate) (eq? t2 'iso)) (grate-compose outer (iso->grate inner))) ((and (eq? t1 'grate) (eq? t2 'grate)) (grate-compose outer inner)) ((and (eq? t1 'lens) (eq? t2 'lens)) (lens-compose outer inner)) ((and (eq? t1 'lens) (eq? t2 'prism)) (affine-compose (lens->affine outer) (prism->affine inner))) ((and (eq? t1 'prism) (eq? t2 'lens)) (affine-compose (prism->affine outer) (lens->affine inner))) ((and (eq? t1 'prism) (eq? t2 'prism)) (prism-compose outer inner)) ((and (eq? t1 'affine) (eq? t2 'affine)) (affine-compose outer inner)) ((and (eq? t1 'affine) (eq? t2 'lens)) (affine-compose outer (lens->affine inner))) ((and (eq? t1 'lens) (eq? t2 'affine)) (affine-compose (lens->affine outer) inner)) ((and (eq? t1 'affine) (eq? t2 'prism)) (affine-compose outer (prism->affine inner))) ((and (eq? t1 'prism) (eq? t2 'affine)) (affine-compose (prism->affine outer) inner)) ((and (eq? t1 'affine) (eq? t2 'iso)) (affine-compose outer (lens->affine (iso->lens inner)))) ((and (eq? t1 'iso) (eq? t2 'affine)) (affine-compose (lens->affine (iso->lens outer)) inner)) ((or (eq? t1 'fold) (eq? t2 'fold)) (fold-compose (->fold outer) (->fold inner))) ((and (eq? t1 'getter) (eq? t2 'getter)) (getter-compose outer inner)) ((eq? t1 'getter) (fold-compose (getter->fold outer) (->fold inner))) ((eq? t2 'getter) (fold-compose (->fold outer) (getter->fold inner))) ((and (eq? t1 'setter) (eq? t2 'setter)) (setter-compose outer inner)) ((eq? t1 'setter) (setter-compose outer (->setter inner))) ((eq? t2 'setter) (setter-compose (->setter outer) inner)) ((and (eq? t1 'grate) (eq? t2 'setter)) (setter-compose (grate->setter outer) inner)) ((and (eq? t1 'setter) (eq? t2 'grate)) (setter-compose outer (grate->setter inner))) ((or (eq? t1 'traversal) (eq? t2 'traversal)) (traversal-compose (->traversal outer) (->traversal inner))) (else (traversal-compose (->traversal outer) (->traversal inner))))))"))
