(task-entry (id "autodiff/profiling/graph-depth") (skill autodiff) (module profiling) (tier 1) (difficulty 12705) (name graph-depth) (type "") (description "") (notes ()) (section tape-statistics) (deps (\x27;prelude \x27;comp-graph \x27;reverse-diff \x27;sort)) (available (tape-stats tape-size tape-op-count graph-stats graph-edge-count)) (answer "(define (graph-depth g) (if (null? (comp-graph-nodes g)) 0 (let ((depths (make-hashtable equal-hash equal?))) (letrec ((compute-depth (lambda (id) (or (hashtable-ref depths id #f) (let* ((node (graph-get-node g id)) (input-ids (extract-input-ids node g)) (d (if (null? input-ids) 0 (+ 1 (apply max (map compute-depth input-ids)))))) (hashtable-set! depths id d) d))))) (graph-fold-nodes (lambda (acc id node) (max acc (compute-depth id))) 0 g)))))"))
