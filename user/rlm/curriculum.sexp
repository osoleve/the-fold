(task-entry (id "egraph/union-find/uf-make-set!") (skill egraph) (module union-find) (tier 1) (difficulty 10010) (name uf-make-set!) (type "(-> UnionFind Id)") (description "Add a new element as its own singleton set. Returns the element's ID.") (notes ()) (section operations) (deps (\x27;prelude)) (available (uf-tag make-uf uf? uf-parent uf-rank uf-count-box uf-next-id-box uf-count uf-size ensure-capacity!)) (answer "(define (uf-make-set! uf) (let* ((id-box (uf-next-id-box uf)) (id (unbox id-box))) (ensure-capacity! uf id) (vector-set! (uf-parent uf) id id) (vector-set! (uf-rank uf) id 0) (set-box! id-box (+ id 1)) (set-box! (uf-count-box uf) (+ (unbox (uf-count-box uf)) 1)) id))"))
(task-entry (id "egraph/eclass/make-eclass-data") (skill egraph) (module eclass) (tier 1) (difficulty 10010) (name make-eclass-data) (type "(-> EClassData)") (description "Create empty e-class data (nodes list, parents set).") (notes ()) (section eclass) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag)) (answer "(define (make-eclass-data) (vector eclass-tag '() (make-eqv-hashtable)))"))
