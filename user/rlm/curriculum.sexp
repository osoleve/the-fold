(task-entry (id "algebra/tropical/tropical-eigenvalue") (skill algebra) (module tropical) (tier 0) (difficulty 317) (name tropical-eigenvalue) (type "") (description "") (notes ()) (section eigenvalue) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add tropical-matrix-power tropical-matrix-closure)) (answer "(define (tropical-eigenvalue A) (let* ((n (matrix-rows A)) (F (make-vector (* (+ n 1) n) +inf.0))) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! F j 0)) (do ((k 0 (+ k 1))) ((= k n)) (let ((k-off (* k n)) (k1-off (* (+ k 1) n))) (do ((j 0 (+ j 1))) ((= j n)) (let loop ((i 0) (acc +inf.0)) (if (= i n) (vector-set! F (+ k1-off j) acc) (loop (+ i 1) (min acc (+ (vector-ref F (+ k-off i)) (matrix-ref A i j))))))))) (let ((n-off (* n n))) (let loop-j ((j 0) (best #f)) (if (= j n) best (let ((fn-j (vector-ref F (+ n-off j)))) (if (not (finite? fn-j)) (loop-j (+ j 1) best) (let loop-k ((k 0) (worst #f)) (if (= k n) (loop-j (+ j 1) (if worst (if best (min best worst) worst) best)) (let ((fk-j (vector-ref F (+ (* k n) j)))) (if (finite? fk-j) (let ((ratio (/ (- fn-j fk-j) (- n k)))) (loop-k (+ k 1) (if worst (max worst ratio) ratio))) (loop-k (+ k 1) worst))))))))))))"))
(task-entry (id "algebra/group/make-cyclic-group") (skill algebra) (module group) (tier 0) (difficulty 318) (name make-cyclic-group) (type "(-> Integer Group)") (description "Create the cyclic group Z_n (integers mod n under addition)") (notes ()) (section cyclic-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms)) (answer "(define (make-cyclic-group n) (let ((elements (iota n)) (op (lambda (a b) (modulo (+ a b) n))) (identity 0) (inverse-fn (lambda (a) (modulo (- n a) n))) (equal-fn =)) (make-group elements op identity inverse-fn equal-fn)))"))
(task-entry (id "algebra/ring/is-commutative-ring?") (skill algebra) (module ring) (tier 0) (difficulty 318) (name is-commutative-ring?) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product)) (answer "(define (is-commutative-ring? r) (let ((elems (ring-elements r))) (let outer-loop ((as elems)) (if (null? as) #t (let inner-loop ((bs elems)) (if (null? bs) (outer-loop (cdr as)) (let ((a (car as)) (b (car bs))) (if (ring-equal? r (ring-mul r a b) (ring-mul r b a)) (inner-loop (cdr bs)) #f))))))))"))
