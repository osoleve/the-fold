(task-entry (id "data/avl-tree/avl-lookup-by") (skill data) (module avl-tree) (tier 0) (difficulty 1315) (name avl-lookup-by) (type "(-> (-> κ κ Boolean) κ AVL (Maybe α))") (description "Look up with custom comparator") (notes ()) (section basic-operations) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node rotate-left rotate-right rebalance avl-lookup)) (answer "(define (avl-lookup-by cmp key tree) (if (avl-empty? tree) #f (let ((k (avl-key tree))) (cond ((cmp key k) (avl-lookup-by cmp key (avl-left tree))) ((cmp k key) (avl-lookup-by cmp key (avl-right tree))) (else (avl-value tree))))))"))
(task-entry (id "data/sort/sort-by-key-desc") (skill data) (module sort) (tier 0) (difficulty 1315) (name sort-by-key-desc) (type "(-> (-> α β) (List α) (List α))") (description "Sort list by key function in descending order") (notes ()) (section sort-by-key) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort sort-by-key)) (answer "(define (sort-by-key-desc key-fn lst) (let* ((decorated (map (lambda (x) (cons (key-fn x) x)) lst)) (sorted (merge-sort-by (lambda (a b) (> (car a) (car b))) decorated))) (map cdr sorted)))"))
(task-entry (id "data/heap/heap-merge-max") (skill data) (module heap) (tier 0) (difficulty 1315) (name heap-merge-max) (type "(-> Heap Heap Heap)") (description "Merge two max-heaps into one.") (notes ()) (section max-heap-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge heap-insert heap-min heap-peek heap-delete-min heap-pop)) (answer "(define (heap-merge-max h1 h2) (cond ((heap-empty? h1) h2) ((heap-empty? h2) h1) (else (let ((v1 (heap-value h1)) (v2 (heap-value h2))) (if (>= v1 v2) (make-heap-node v1 (heap-left h1) (heap-merge-max (heap-right h1) h2)) (make-heap-node v2 (heap-left h2) (heap-merge-max h1 (heap-right h2))))))))"))
(task-entry (id "data/collection-utils/make-collection-from-blocks") (skill data) (module collection-utils) (tier 0) (difficulty 1315) (name make-collection-from-blocks) (type "(-> Symbol String (List Block) Block)") (description "Create a collection from a list of blocks") (notes ()) (section collection-construction) (deps (\x27;block \x27;sha256)) (available (foldr collection-hashes collection-size collection-empty? map-collection filter-collection fold-collection foldr-collection for-each-collection collection-find collection-any? collection-all? collection-count-matching collection-partition collection-group-by)) (answer "(define (make-collection-from-blocks tag name blocks) (let ((hashes (map hash-block blocks))) (make-block tag (string->utf8 (format \"~a (~a members)\" name (length blocks))) (list->vector hashes))))"))
