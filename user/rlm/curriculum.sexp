(task-entry (id "physics/classical/collision-detection/aabb-to-cells") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23555) (name aabb-to-cells) (type "") (description "") (notes ()) (section broad) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon? closest-point-on-segment circle-polygon-manifold project-polygon project-circle intervals-overlap polygon-polygon? polygon-polygon-manifold shape-type shape-aabb shapes-collide? aabb-to-polygon shapes-manifold make-spatial-hash spatial-hash? spatial-hash-cell-size spatial-hash-table point-to-cell)) (answer "(define (aabb-to-cells aabb cell-size) (let* ((min-cell (point-to-cell (aabb-min aabb) cell-size)) (max-cell (point-to-cell (aabb-max aabb) cell-size)) (min-x (car min-cell)) (min-y (cadr min-cell)) (max-x (car max-cell)) (max-y (cadr max-cell))) (let loop-x ((x min-x) (cells '())) (if (> x max-x) cells (loop-x (+ x 1) (let loop-y ((y min-y) (cs cells)) (if (> y max-y) cs (loop-y (+ y 1) (cons (list x y) cs)))))))))"))
