(task-entry (id "geometry/voronoi/clip-polygon-to-rect") (skill geometry) (module voronoi) (tier 1) (difficulty 12232) (name clip-polygon-to-rect) (type "") (description "") (notes ()) (section bounded) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell voronoi-diagram find-unbounded-sites build-voronoi-edges edge-key->points find-site-index voronoi-cell-polygon voronoi-cell-centroid voronoi-neighbors voronoi-nearest-site point2-distance-sq)) (answer "(define (clip-polygon-to-rect poly x-min x-max y-min y-max) (if (null? poly) '() (let* ((clip1 (clip-to-halfplane poly (lambda (p) (>= (point2-x p) x-min)) (lambda (p1 p2) (intersect-vertical p1 p2 x-min)))) (clip2 (clip-to-halfplane clip1 (lambda (p) (<= (point2-x p) x-max)) (lambda (p1 p2) (intersect-vertical p1 p2 x-max)))) (clip3 (clip-to-halfplane clip2 (lambda (p) (>= (point2-y p) y-min)) (lambda (p1 p2) (intersect-horizontal p1 p2 y-min)))) (clip4 (clip-to-halfplane clip3 (lambda (p) (<= (point2-y p) y-max)) (lambda (p1 p2) (intersect-horizontal p1 p2 y-max))))) clip4)))"))
