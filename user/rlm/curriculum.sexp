(task-entry (id "algebra/galois/gf2n-from-int") (skill algebra) (module galois) (tier 0) (difficulty 330) (name gf2n-from-int) (type "") (description "") (notes ()) (section gf2n-binary-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length)) (answer "(define (gf2n-from-int field val) (let ((sample (field-one field))) (if (gf2n-element? sample) (make-gf2n-element val (gf2n-degree sample) (gf2n-irred sample)) (error 'gf2n-from-int \"field is not GF(2^n)\"))))"))
