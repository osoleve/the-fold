(task-entry (id "linalg/sparse/sparse-coo-add-impl") (skill linalg) (module sparse) (tier 0) (difficulty 448) (name sparse-coo-add-impl) (type "") (description "") (notes ()) (section sparse-matvec) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr? make-sparse-csr sparse-csr-rows sparse-csr-cols sparse-csr-row-ptrs sparse-csr-col-indices sparse-csr-values sparse-csr-nnz sparse-csr-ref sparse-csr-row sparse-csr-row-alist sparse-csc? make-sparse-csc sparse-csc-rows sparse-csc-cols sparse-csc-col-ptrs sparse-csc-row-indices sparse-csc-values sparse-csc-nnz sparse-csc-ref sparse-csc-col coo->csr coo->csc csr->coo csc->coo csr->csc csc->csr dense->sparse-coo dense->sparse-csr sparse-coo->dense sparse-csr->dense sparse-csc->dense sparse-csr-vec-mul sparse-csc-vec-mul sparse-coo-vec-mul sparse-csr-add sparse-coo-add)) (answer "(define (sparse-coo-add-impl a b . eps-arg) (let* ((eps (if (null? eps-arg) *sparse-epsilon* (car eps-arg))) (rows (sparse-coo-rows a)) (cols (sparse-coo-cols a)) (acc (make-hashtable equal-hash equal?))) (let ((row-idx (sparse-coo-row-indices a)) (col-idx (sparse-coo-col-indices a)) (vals (sparse-coo-values a)) (nnz-a (sparse-coo-nnz a))) (do ((k 0 (+ k 1))) ((= k nnz-a)) (let* ((i (vector-ref row-idx k)) (j (vector-ref col-idx k)) (key (cons i j)) (old (hashtable-ref acc key 0))) (hashtable-set! acc key (+ old (vector-ref vals k)))))) (let ((row-idx (sparse-coo-row-indices b)) (col-idx (sparse-coo-col-indices b)) (vals (sparse-coo-values b)) (nnz-b (sparse-coo-nnz b))) (do ((k 0 (+ k 1))) ((= k nnz-b)) (let* ((i (vector-ref row-idx k)) (j (vector-ref col-idx k)) (key (cons i j)) (old (hashtable-ref acc key 0))) (hashtable-set! acc key (+ old (vector-ref vals k)))))) (let-values (((keys values) (hashtable-entries acc))) (let* ((n 