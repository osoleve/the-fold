(task-entry (id "optimization/lp/lp-result->string") (skill optimization) (module lp) (tier 1) (difficulty 12847) (name lp-result->string) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize extract-basis-matrix extract-basis-costs compute-reduced-costs find-entering-variable vec-contains? compute-direction find-leaving-variable update-basis create-phase1-lp run-phase1 pivot-out-artificials find-nonbasic-pivot simplex-core construct-solution construct-unbounded-direction lp-solve ensure-nonnegative-rhs lp-dual lp-shadow-prices lp-reduced-costs lp-basis-ranges lp-rhs-ranges lp-weak-duality? lp-strong-duality? lp->string vec->string matrix->string)) (answer "(define (lp-result->string result) (cond ((lp-optimal? result) (string-append \"Optimal solution found:\n\" \"  x* = \" (vec->string (lp-result-x result)) \"\n\" \"  z* = \" (number->string (lp-result-z result)))) ((lp-infeasible? result) \"Problem is infeasible\") ((lp-unbounded? result) (string-append \"Problem is unbounded\n\" \"  Direction: \" (vec->string (lp-result-direction result)))) (else \"Unknown result\")))"))
(task-entry (id "optimization/ilp/matrix-vstack") (skill optimization) (module ilp) (tier 1) (difficulty 12847) (name matrix-vstack) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp make-ilp-optimal make-ilp-infeasible make-ilp-unbounded ilp-optimal? ilp-infeasible? ilp-unbounded? ilp-result-x ilp-result-z is-integer? solution-is-integer? find-fractional-var round-solution make-bb-node bb-node-lp bb-node-lb bb-node-ub add-bound-constraints ilp-solve branch-and-bound vector-take frac generate-gomory-cut matrix-row add-gomory-cut ilp-solve-cutting-plane find-and-generate-cut knapsack-solve set-cover-solve vec-ones vec-zeros vec-negate vec-append vec-copy vec-dot)) (answer "(define (matrix-vstack m1 m2) (let* ((r1 (matrix-rows m1)) (r2 (matrix-rows m2)) (c (matrix-cols m1)) (result (make-matrix (+ r1 r2) c 0))) (do ((i 0 (+ i 1))) ((= i r1)) (do ((j 0 (+ j 1))) ((= j c)) (matrix-set! result i j (matrix-ref m1 i j)))) (do ((i 0 (+ i 1))) ((= i r2) result) (do ((j 0 (+ j 1))) ((= j c)) (matrix-set! result (+ r1 i) j (matrix-ref m2 i j))))))"))
