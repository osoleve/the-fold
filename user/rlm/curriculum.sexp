(task-entry (id "optics/schema/field-remove-iso") (skill optics) (module schema) (tier 1) (difficulty 11002) (name field-remove-iso) (type "(-> Symbol Any (PIso Alist Alist))") (description "Create an iso that removes a field (inverse of add). Forward: remove the field. Backward: add field with default") (notes ()) (section field-add-remove) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso)) (answer "(define (field-remove-iso field default) (make-p-iso (lambda (alist) (filter (lambda (pair) (not (eq? (car pair) field))) alist)) (lambda (alist) (cons (cons field default) alist))))"))
