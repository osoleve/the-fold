(task-entry (id "numeric/digital-filters/iir-filter-signal") (skill numeric) (module digital-filters) (tier 0) (difficulty 2516) (name iir-filter-signal) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window bessel-i0 sinc fir-lowpass fir-highpass fir-bandpass fir-bandstop fir-filter make-iir-filter iir-filter? iir-filter-b iir-filter-a)) (answer "(define (iir-filter-signal signal b a) (let* ((n (vector-length signal)) (nb (vector-length b)) (na (vector-length a)) (a0 (vector-ref a 0)) (output (make-vector n 0.0)) (x-hist (make-vector nb 0.0)) (y-hist (make-vector na 0.0))) (do ((i 0 (+ i 1))) ((= i n) output) (do ((j (- nb 1) (- j 1))) ((= j 0)) (vector-set! x-hist j (vector-ref x-hist (- j 1)))) (vector-set! x-hist 0 (vector-ref signal i)) (let ((sum 0.0)) (do ((j 0 (+ j 1))) ((= j nb)) (set! sum (+ sum (* (vector-ref b j) (vector-ref x-hist j))))) (do ((j 1 (+ j 1))) ((= j na)) (set! sum (- sum (* (vector-ref a j) (vector-ref y-hist j))))) (set! sum (/ sum a0)) (do ((j (- na 1) (- j 1))) ((= j 0)) (vector-set! y-hist j (vector-ref y-hist (- j 1)))) (vector-set! y-hist 0 sum) (vector-set! output i sum)))))"))
