(task-entry (id "physics/classical3d/collision-detection3d/closest-point-on-segment-3d") (skill physics/classical3d) (module collision-detection3d) (tier 2) (difficulty 22403) (name closest-point-on-segment-3d) (type "") (description "") (notes ()) (section point-in-shape-tests) (deps (\x27;prelude \x27;vec3 \x27;shapes3d)) (available (point-in-aabb3d? point-in-sphere3d? point-in-box3d?)) (answer "(define (closest-point-on-segment-3d point v1 v2) (let* ((edge (vec3-sub v2 v1)) (edge-len-sq (vec3-magnitude-sq edge)) (to-point (vec3-sub point v1)) (t (if (< edge-len-sq 1e-10) 0 (/ (vec3-dot to-point edge) edge-len-sq))) (t-clamped (max 0 (min 1 t)))) (vec3-add v1 (vec3-scale edge t-clamped))))"))
