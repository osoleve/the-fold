(task-entry (id "tiles/visibility/has-line-of-sight?") (skill tiles) (module visibility) (tier 1) (difficulty 12300) (name has-line-of-sight?) (type "(-> Board Coord Coord (-> Coord Coord (List Coord)) (-> Coord Bool) Bool)") (description "Check if there's clear line of sight from origin to target") (notes ()) (section line-of-sight) (deps (\x27;tiles/core)) (available ()) (answer "(define (has-line-of-sight? board origin target line-fn blocks-vision-fn) (let ((line (line-fn origin target))) (let loop ((coords line)) (cond ((null? coords) #t) ((equal? (car coords) target) #t) ((blocks-vision-fn (car coords)) #f) (else (loop (cdr coords)))))))"))
(task-entry (id "tiles/units/make-unit") (skill tiles) (module units) (tier 1) (difficulty 12300) (name make-unit) (type "(-> Symbol Symbol Symbol Alist Unit)") (description "Create a new unit") (notes ()) (section unit-protocol) (deps (\x27;tiles/core)) (available ()) (answer "(define (make-unit id type team properties) (make-unit% id type team properties))"))
(task-entry (id "tiles/turns/make-turn-state") (skill tiles) (module turns) (tier 1) (difficulty 12300) (name make-turn-state) (type "(-> (List UnitId) Hashtable TurnState)") (description "Create initial turn state") (notes ()) (section turn-state) (deps (\x27;sort)) (available ()) (answer "(define (make-turn-state unit-order max-actions) (let ((ap-table (make-hashtable equal-hash equal?))) (for-each (lambda (uid) (hashtable-set! ap-table uid (hashtable-ref max-actions uid 2))) unit-order) (make-turn-state% 1 (if (null? unit-order) #f (car unit-order)) unit-order ap-table 'movement '())))"))
(task-entry (id "tiles/render/default-tile-char") (skill tiles) (module render) (tier 1) (difficulty 12300) (name default-tile-char) (type "(-> Tile String)") (description "Default character mapping for common tile types") (notes ()) (section tile-style) (deps (\x27;tiles/core)) (available ()) (answer "(define (default-tile-char tile) (case (tile-type tile) ((floor empty) \".\") ((wall) \"#\") ((grass) \",\") ((swamp water) \"~\") ((mountain) \"^\") ((forest) \"T\") (else \"?\")))"))
(task-entry (id "tiles/boardcraft/boardcraft-help") (skill tiles) (module boardcraft) (tier 1) (difficulty 12300) (name boardcraft-help) (type "") (description "Display BoardCraft SDK quick reference guide") (notes ()) (section quick-reference) (deps (\x27;prelude)) (available ()) (answer "(define (boardcraft-help) (display \"=============== BOARDCRAFT SDK -- Quick Reference ===============\n\") (newline) (display \"SQUARE TILES:\n\") (display \"  (make-square-board width height [tile])  Create board\n\") (display \"  (square-coord x y)                       Create coordinate\n\") (display \"  (square-neighbors coord 'all)            Get 8 neighbors\n\") (display \"  (square-neighbors coord 'ortho)          Get 4 neighbors\n\") (display \"  (square-distance c1 c2 'manhattan)       Distance\n\") (display \"  (square-range center radius 'chebyshev)  Area in range\n\") (newline) (display \"HEXAGONAL TILES:\n\") (display \"  (make-hex-board 'axial radius [tile])    Create board\n\") (display \"  (axial-coord q r)                        Create coordinate\n\") (display \"  (hex-neighbors coord)                    Get 6 neighbors\n\") (display \"  (hex-distance c1 c2)                     Hex steps\n\") (display \"  (hex-range center radius)                Hexes in range\n\") (display \"  (hex-line c1 c2)                         Line between hexes\n\") (newline) (display \"BOARD OPERATIONS:\n\") (display \"  (board-get board coord)                  Get tile\n\") (display \"  (board-set board coord tile)             Set tile (returns new board)\n\") (display \"  (board-tiles board)                      List all (coord . tile)\n\") (display \"  (board-size board)                       Count stored tiles\n\") (display \"  (board-empty? board)                     Check if no tiles stored\n\") (display \"  (hex-board-capacity board)               Total hexes for radius\n\") (display \"  (square-board-capacity board)            Total squares (w*h)\n\") (newline) (display \"For full documentation:\n\") (display \"  (load \"lattice/tiles/README.sexp\")\n\") (newline))"))
(task-entry (id "tiles/topology-analysis/board->simplicial-complex") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12300) (name board->simplicial-complex) (type "") (description "") (notes ()) (section board-to-complex) (deps (\x27;tiles/core)) (available ()) (answer "(define (board->simplicial-complex board neighbor-fn) (let* ((walkable-coords (filter (lambda (c) (let ((tile (board-get board c))) (and tile (tile-walkable? tile)))) (board-coords board))) (walkable-set (coords->set walkable-coords)) (vertices (map (lambda (c) (make-simplex (list (coord->vertex-id c)))) walkable-coords)) (edges (collect-edges walkable-coords walkable-set neighbor-fn)) (faces (collect-square-faces walkable-coords walkable-set neighbor-fn))) (sc-from-simplices (append vertices edges faces))))"))
(task-entry (id "tiles/core/coord-x") (skill tiles) (module core) (tier 1) (difficulty 12301) (name coord-x) (type "(-> Coordinate Number)") (description "") (notes ()) (section coordinate-protocol) (deps (\x27;prelude)) (available (coord)) (answer "(define (coord-x c) (car c))"))
(task-entry (id "tiles/square/square-offset-8") (skill tiles) (module square) (tier 1) (difficulty 12301) (name square-offset-8) (type "") (description "") (notes ()) (section neighbor-calculations) (deps (\x27;prelude)) (available (square-coord)) (answer "(define square-offset-8 '((n 0 . -1) (ne 1 . -1) (e 1 . 0) (se 1 . 1) (s 0 . 1) (sw -1 . 1) (w -1 . 0) (nw -1 . -1)))"))
(task-entry (id "tiles/hex/cubic-coord") (skill tiles) (module hex) (tier 1) (difficulty 12301) (name cubic-coord) (type "(-> Integer Integer Integer CubicCoord)") (description "CUBIC COORDINATES (x, y, z) where x + y + z = 0 - Best for symmetric operations") (notes ()) (section coordinate-systems) (deps (\x27;prelude)) (available (axial-coord)) (answer "(define (cubic-coord x y z) (if (not (= (+ x y z) 0)) (error 'cubic-coord \"Cubic coordinates must sum to 0\") (make-cubic-coord% x y z)))"))
(task-entry (id "tiles/triangle/triangle-row") (skill tiles) (module triangle) (tier 1) (difficulty 12301) (name triangle-row) (type "") (description "") (notes ()) (section coordinates) (deps (\x27;tiles/core)) (available (triangle-coord)) (answer "(define (triangle-row t) (triangle-coord%-row t))"))
(task-entry (id "tiles/pathfinding/pqueue-empty?") (skill tiles) (module pathfinding) (tier 1) (difficulty 12301) (name pqueue-empty?) (type "") (description "Check if priority queue is empty") (notes ()) (section priority-queue) (deps (\x27;tiles/core)) (available (make-pqueue)) (answer "(define (pqueue-empty? pq) (null? pq))"))
(task-entry (id "tiles/visibility/board-has-los?") (skill tiles) (module visibility) (tier 1) (difficulty 12301) (name board-has-los?) (type "(-> Board Coord Coord (-> Coord Coord (List Coord)) Bool)") (description "Check line of sight using board's vision-blocking tile property") (notes ()) (section line-of-sight) (deps (\x27;tiles/core)) (available (has-line-of-sight?)) (answer "(define (board-has-los? board origin target line-fn) (has-line-of-sight? board origin target line-fn (lambda (coord) (let ((tile (board-get board coord))) (and tile (tile-get-prop tile 'blocks-vision #f))))))"))
(task-entry (id "tiles/units/unit-get-prop") (skill tiles) (module units) (tier 1) (difficulty 12301) (name unit-get-prop) (type "(-> Unit Symbol Any Any)") (description "Get unit property with default") (notes ()) (section unit-protocol) (deps (\x27;tiles/core)) (available (make-unit)) (answer "(define (unit-get-prop unit prop default) (let ((props (unit%-properties unit))) (if (assq prop props) (cdr (assq prop props)) default)))"))
(task-entry (id "tiles/turns/make-turn-state-from-game") (skill tiles) (module turns) (tier 1) (difficulty 12301) (name make-turn-state-from-game) (type "(-> GameState TurnState)") (description "Create turn state from game state with default 2 action points per unit") (notes ()) (section turn-state) (deps (\x27;sort)) (available (make-turn-state)) (answer "(define (make-turn-state-from-game gs) (let* ((units (game-all-units gs)) (unit-ids (map (lambda (entry) (unit%-id (cdr entry))) units)) (max-actions (make-hashtable equal-hash equal?))) (for-each (lambda (uid) (hashtable-set! max-actions uid 2)) unit-ids) (make-turn-state unit-ids max-actions)))"))
(task-entry (id "tiles/render/render-square-board") (skill tiles) (module render) (tier 1) (difficulty 12301) (name render-square-board) (type "(-> Board MetaData (-> Tile String) String)") (description "Render a square board as ASCII art") (notes ()) (section square-rendering) (deps (\x27;tiles/core)) (available (default-tile-char)) (answer "(define (render-square-board board meta style-fn) (let ((width (cdr (assq 'width meta))) (height (cdr (assq 'height meta)))) (let loop-y ((y 0) (lines '())) (if (>= y height) (apply string-append (reverse lines)) (let loop-x ((x 0) (chars '())) (if (>= x width) (loop-y (+ y 1) (cons (apply string-append (reverse (cons \"\n\" chars))) lines)) (let* ((coord (cons x y)) (tile (board-get board coord)) (char (if tile (style-fn tile) \" \"))) (loop-x (+ x 1) (cons char chars)))))))))"))
(task-entry (id "tiles/topology-analysis/coords->set") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12301) (name coords->set) (type "") (description "Build hashtable set for O(1) membership") (notes ()) (section board-to-complex) (deps (\x27;tiles/core)) (available (board->simplicial-complex)) (answer "(define (coords->set coords) (let ((ht (make-hashtable coord-hash coord-equal?))) (for-each (lambda (c) (hashtable-set! ht c #t)) coords) ht))"))
(task-entry (id "tiles/core/coord-y") (skill tiles) (module core) (tier 1) (difficulty 12302) (name coord-y) (type "(-> Coordinate Number)") (description "") (notes ()) (section coordinate-protocol) (deps (\x27;prelude)) (available (coord coord-x)) (answer "(define (coord-y c) (cdr c))"))
(task-entry (id "tiles/square/square-offset-4") (skill tiles) (module square) (tier 1) (difficulty 12302) (name square-offset-4) (type "") (description "") (notes ()) (section neighbor-calculations) (deps (\x27;prelude)) (available (square-coord square-offset-8)) (answer "(define square-offset-4 '((n 0 . -1) (e 1 . 0) (s 0 . 1) (w -1 . 0)))"))
(task-entry (id "tiles/hex/offset-coord") (skill tiles) (module hex) (tier 1) (difficulty 12302) (name offset-coord) (type "(-> Integer Integer OffsetCoord)") (description "OFFSET COORDINATES (col, row) - Used for array storage and display. We use odd-r (odd rows are offset) for pointy-top") (notes ()) (section coordinate-systems) (deps (\x27;prelude)) (available (axial-coord cubic-coord)) (answer "(define offset-coord coord)"))
(task-entry (id "tiles/triangle/triangle-col") (skill tiles) (module triangle) (tier 1) (difficulty 12302) (name triangle-col) (type "") (description "") (notes ()) (section coordinates) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row)) (answer "(define (triangle-col t) (triangle-coord%-col t))"))
(task-entry (id "tiles/pathfinding/pqueue-insert") (skill tiles) (module pathfinding) (tier 1) (difficulty 12302) (name pqueue-insert) (type "") (description "Insert value into priority queue with given priority") (notes ()) (section priority-queue) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty?)) (answer "(define (pqueue-insert pq priority value) (let loop ((lst pq)) (cond ((null? lst) (list (cons priority value))) ((< priority (caar lst)) (cons (cons priority value) lst)) (else (cons (car lst) (loop (cdr lst)))))))"))
(task-entry (id "tiles/visibility/calculate-fov") (skill tiles) (module visibility) (tier 1) (difficulty 12302) (name calculate-fov) (type "(-> Board Coord Integer (-> Coord (List Coord)) (-> Coord Coord (List Coord)) (-> Coord Bool) (List Coord))") (description "Calculate field of view from origin within radius. Uses simple raycast FOV.") (notes ("More sophisticated algorithms (shadowcasting) could be added later")) (section field-of-view) (deps (\x27;tiles/core)) (available (has-line-of-sight? board-has-los?)) (answer "(define (calculate-fov board origin max-radius neighbor-fn line-fn blocks-vision-fn) (let ((visible (make-hashtable equal-hash equal?))) (hashtable-set! visible origin #t) (let loop ((queue (list origin)) (visited (make-hashtable equal-hash equal?)) (distance (make-hashtable equal-hash equal?))) (hashtable-set! visited origin #t) (hashtable-set! distance origin 0) (if (null? queue) (vector->list (hashtable-keys visible)) (let* ((current (car queue)) (rest-q (cdr queue)) (current-dist (hashtable-ref distance current 0))) (if (>= current-dist max-radius) (loop rest-q visited distance) (let* ((neighbors (neighbor-fn current)) (valid-neighbors (filter (lambda (n) (and (board-get board n) (not (hashtable-ref visited n #f)))) neighbors))) (for-each (lambda (n) (hashtable-set! visited n #t) (hashtable-set! distance n (+ current-dist 1)) (when (has-line-of-sight? board origin n line-fn blocks-vision-fn) (hashtable-set! visible n #t))) valid-neighbors) (loop (append rest-q valid-neighbors) visited distance))))))))"))
(task-entry (id "tiles/units/unit-set-prop") (skill tiles) (module units) (tier 1) (difficulty 12302) (name unit-set-prop) (type "(-> Unit Symbol Any Unit)") (description "Set unit property (returns new unit)") (notes ()) (section unit-protocol) (deps (\x27;tiles/core)) (available (make-unit unit-get-prop)) (answer "(define (unit-set-prop unit prop value) (let* ((props (unit%-properties unit)) (new-props (cons (cons prop value) (filter (lambda (p) (not (eq? (car p) prop))) props)))) (make-unit% (unit%-id unit) (unit%-type unit) (unit%-team unit) new-props)))"))
(task-entry (id "tiles/turns/turn-current-unit") (skill tiles) (module turns) (tier 1) (difficulty 12302) (name turn-current-unit) (type "(-> TurnState (Maybe UnitId))") (description "Get currently active unit ID") (notes ()) (section queries) (deps (\x27;sort)) (available (make-turn-state make-turn-state-from-game)) (answer "(define (turn-current-unit ts) (turn-state%-active-unit ts))"))
(task-entry (id "tiles/render/render-square-board-with-overlay") (skill tiles) (module render) (tier 1) (difficulty 12302) (name render-square-board-with-overlay) (type "") (description "Render square board with highlighted coordinates") (notes ()) (section square-rendering) (deps (\x27;tiles/core)) (available (default-tile-char render-square-board)) (answer "(define (render-square-board-with-overlay board meta style-fn overlay overlay-char) (let ((width (cdr (assq 'width meta))) (height (cdr (assq 'height meta))) (overlay-set (let ((ht (make-hashtable equal-hash equal?))) (for-each (lambda (c) (hashtable-set! ht c #t)) overlay) ht))) (let loop-y ((y 0) (lines '())) (if (>= y height) (apply string-append (reverse lines)) (let loop-x ((x 0) (chars '())) (if (>= x width) (loop-y (+ y 1) (cons (apply string-append (reverse (cons \"\n\" chars))) lines)) (let* ((coord (cons x y)) (in-overlay? (hashtable-ref overlay-set coord #f)) (tile (board-get board coord)) (char (cond (in-overlay? overlay-char) (tile (style-fn tile)) (else \" \")))) (loop-x (+ x 1) (cons char chars)))))))))"))
(task-entry (id "tiles/topology-analysis/coord-in-set?") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12302) (name coord-in-set?) (type "") (description "") (notes ()) (section board-to-complex) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set)) (answer "(define (coord-in-set? set c) (hashtable-ref set c #f))"))
(task-entry (id "tiles/core/coord-equal?") (skill tiles) (module core) (tier 1) (difficulty 12303) (name coord-equal?) (type "(-> Coordinate Coordinate Boolean)") (description "") (notes ()) (section coordinate-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y)) (answer "(define (coord-equal? c1 c2) (and (= (coord-x c1) (coord-x c2)) (= (coord-y c1) (coord-y c2))))"))
(task-entry (id "tiles/square/square-neighbor") (skill tiles) (module square) (tier 1) (difficulty 12303) (name square-neighbor) (type "(-> Coord Symbol Coord)") (description "Get neighbor in a specific direction") (notes ()) (section neighbor-calculations) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4)) (answer "(define (square-neighbor coord dir) (let ((offset (alist-ref square-offset-8 dir))) (if offset (square-coord (+ (coord-x coord) (car offset)) (+ (coord-y coord) (cdr offset))) (error 'square-neighbor \"Invalid direction\" dir))))"))
(task-entry (id "tiles/hex/axial->cubic") (skill tiles) (module hex) (tier 1) (difficulty 12303) (name axial->cubic) (type "(-> AxialCoord CubicCoord)") (description "") (notes ()) (section coordinate-conversions) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord)) (answer "(define (axial->cubic ac) (let ((q (coord-x ac)) (r (coord-y ac))) (cubic-coord q r (- (- q) r))))"))
