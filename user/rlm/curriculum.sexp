(task-entry (id "algebra/polynomial/poly-lagrange-basis") (skill algebra) (module polynomial) (tier 0) (difficulty 341) (name poly-lagrange-basis) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm poly-eval poly-derivative poly-scalar-mul-int poly-square-free poly-square-free-factorization poly-sqf-loop poly-lagrange-interpolate poly-lagrange-sum)) (answer "(define (poly-lagrange-basis F xs i) (let ((xi (list-ref xs i)) (n (length xs)) (sub (lambda (a b) (field-sub F a b)))) (let loop ((j 0) (num (poly-one-over F)) (denom (field-one F))) (if (= j n) (poly-scale num (field-inv F denom)) (if (= j i) (loop (+ j 1) num denom) (let* ((xj (list-ref xs j)) (factor (make-polynomial F (list (field-neg F xj) (field-one F)))) (d (sub xi xj))) (loop (+ j 1) (poly-mul num factor) (field-mul F denom d))))))))"))
