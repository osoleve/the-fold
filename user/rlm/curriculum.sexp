(task-entry (id "numeric/interpolate/cubic-spline-natural") (skill numeric) (module interpolate) (tier 0) (difficulty 2512) (name cubic-spline-natural) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;numeric/polynomial)) (available (binary-search-segment binary-search-segment-vec lerp lerp-inverse interp-linear lagrange-basis interp-lagrange divided-differences interp-newton interp-hermite hermite-tangent-estimate thomas-algorithm)) (answer "(define (cubic-spline-natural xs ys) (let* ((n (length xs)) (n-1 (- n 1))) (if (< n 2) (vector) (let* ((h (let loop ((xs xs) (result '())) (if (null? (cdr xs)) (list->vector (reverse result)) (loop (cdr xs) (cons (- (cadr xs) (car xs)) result)))))) (let* ((m (- n 2)) (M-interior (if (< n 3) (vector) (let* ((a-sub (make-vector (- m 1) 0.0)) (b-diag (make-vector m 0.0)) (c-sup (make-vector (- m 1) 0.0)) (d-rhs (make-vector m 0.0))) (do ((i 1 (+ i 1))) ((>= i n-1)) (let* ((idx (- i 1)) (hi-1 (vector-ref h (- i 1))) (hi (vector-ref h i)) (yi-1 (list-ref ys (- i 1))) (yi (list-ref ys i)) (yi+1 (list-ref ys (+ i 1)))) (vector-set! b-diag idx (* 2 (+ hi-1 hi))) (when (> idx 0) (vector-set! a-sub (- idx 1) hi-1)) (when (< idx (- m 1)) (vector-set! c-sup idx hi)) (vector-set! d-rhs idx (* 6 (- (/ (- yi+1 yi) hi) (/ (- yi yi-1) hi-1)))))) (thomas-algorithm a-sub b-diag c-sup d-rhs)))) (M (let ((v (make-vector n 0))) (do ((i 1 (+ i 1))) ((>= i n-1)) (vector-set! v i (vector-ref M-interior (- i 1)))) v)) (spline (make-vector n-1 #f))) (do ((i 0 (+ i 1))) ((>= i n-1)) (let* ((hi (vector-ref h i)) (yi (list-ref ys i)) (yi+1 (list-ref ys (+ i 1))) (Mi (vector-ref M i)) (Mi+1 (vector-ref M (+ i 1))) (a yi) (b (- (/ (- yi+1 yi) hi) (/ (* hi (+ (* 2 Mi) Mi+1)) 6))) (c (/ Mi 2)) (d (/ (- Mi+1 Mi) (* 6 hi)))) (vector-set! spline i (list a b c d)))) spline)))))"))
