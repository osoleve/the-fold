(task-entry (id "geometry/mesh-gen/tri2-circumradius-sq") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12226) (name tri2-circumradius-sq) (type "") (description "") (notes ()) (section predicates) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location location? location-triangle location-bary point2-x point2-y vertex-key make-tri2 tri2? tri2-p1 tri2-p2 tri2-p3 tri2-points orient2d tri2-signed-area tri2-area tri2-circumcenter)) (answer "(define (tri2-circumradius-sq tri) (let ((cc (tri2-circumcenter tri))) (if (not cc) #f (let* ((p1 (tri2-p1 tri)) (dx (- (point2-x cc) (point2-x p1))) (dy (- (point2-y cc) (point2-y p1)))) (+ (* dx dx) (* dy dy))))))"))
(task-entry (id "geometry/mesh-topology/mesh-is-sphere-topology?") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12226) (name mesh-is-sphere-topology?) (type "") (description "") (notes ()) (section genus-computation) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex mesh-betti-numbers mesh-euler-characteristic mesh-f-vector mesh-connected-components mesh-genus mesh-edge-counts edge-key mesh-is-manifold? mesh-edges-are-manifold? mesh-vertices-are-manifold? vertex-link-edges list-member? unique-list count-components-uf build-index-map mesh-is-closed? mesh-boundary-edges mesh-non-manifold-edges mesh-topology-summary mesh-is-watertight?)) (answer "(define (mesh-is-sphere-topology? mesh) (let ((betti (mesh-betti-numbers mesh))) (and (= (length betti) 3) (= (car betti) 1) (= (cadr betti) 0) (= (caddr betti) 1) (= (mesh-euler-characteristic mesh) 2))))"))
(task-entry (id "geometry/convex-hull/merge-edges-ccw") (skill geometry) (module convex-hull) (tier 1) (difficulty 12226) (name merge-edges-ccw) (type "") (description "") (notes ()) (section minkowski) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line find-furthest-from-line quickhull-recurse quickhull convex-hull convex-hull-area convex-hull-perimeter point-in-convex-hull? convex-hull-centroid convex-hull-diameter extreme-point support-function minkowski-sum normalize-angle polygon-edges)) (answer "(define (merge-edges-ccw edges-a edges-b) (let loop ((a edges-a) (b edges-b) (result '())) (cond ((and (null? a) (null? b)) (reverse result)) ((null? a) (loop a (cdr b) (cons (caar b) result))) ((null? b) (loop (cdr a) b (cons (caar a) result))) (else (if (<= (cdar a) (cdar b)) (loop (cdr a) b (cons (caar a) result)) (loop a (cdr b) (cons (caar b) result)))))))"))
(task-entry (id "geometry/voronoi/find-site-index") (skill geometry) (module voronoi) (tier 1) (difficulty 12226) (name find-site-index) (type "") (description "") (notes ()) (section construction) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell voronoi-diagram find-unbounded-sites build-voronoi-edges edge-key->points)) (answer "(define (find-site-index sites point) (let loop ((i 0)) (if (>= i (vector-length sites)) -1 (if (points-equal? point (vector-ref sites i)) i (loop (+ i 1))))))"))
