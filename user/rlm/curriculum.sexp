(task-entry (id "geometry/raymarch/raymarch-shadow") (skill geometry) (module raymarch) (tier 1) (difficulty 12209) (name raymarch-shadow) (type "(-> (-> Vec3 Real) Ray3 Real Real RaymarchParams Real)") (description "Compute soft shadow factor (0 = full shadow, 1 = no shadow)") (notes ()) (section soft-shadows) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (raymarch-params raymarch-params-max-steps raymarch-params-max-distance raymarch-params-hit-threshold default-raymarch-params raymarch raymarch-mesh sdf-normal mesh-sdf-normal)) (answer "(define (raymarch-shadow sdf-fn ray light-distance softness params) (let ((max-steps (raymarch-params-max-steps params)) (threshold (raymarch-params-hit-threshold params)) (direction (ray3-direction ray))) (define (march t steps shadow-factor) (cond ((or (>= steps max-steps) (>= t light-distance)) shadow-factor) (else (let* ((point (ray3-point-at ray t)) (dist (sdf-fn point))) (cond ((< dist threshold) 0.0) (else (let ((new-factor (min shadow-factor (* softness (/ dist t))))) (march (+ t dist) (+ steps 1) new-factor)))))))) (march (raymarch-params-hit-threshold params) 0 1.0)))"))
(task-entry (id "geometry/octree/all-children-leaves?") (skill geometry) (module octree) (tier 1) (difficulty 12209) (name all-children-leaves?) (type "(-> (List Octree) Bool)") (description "") (notes ()) (section octree-construction) (deps (\x27;prelude \x27;geometry)) (available (octree-leaf octree-node octree-leaf? octree-node? octree-center octree-size octree-primitives octree-children octree-build)) (answer "(define (all-children-leaves? children) (and (= (length children) 8) (andmap octree-leaf? children)))"))
(task-entry (id "geometry/bvh/compute-triangles-bbox") (skill geometry) (module bvh) (tier 1) (difficulty 12209) (name compute-triangles-bbox) (type "(-> (List Triangle3) AABB)") (description "Compute bounding box containing all triangle vertices") (notes ()) (section helpers) (deps (\x27;prelude \x27;geometry \x27;sort)) (available (bvh-leaf bvh-node bvh-leaf? bvh-node? bvh-bbox bvh-primitives bvh-left bvh-right triangle-centroid)) (answer "(define (compute-triangles-bbox triangles) (if (null? triangles) (aabb (vec3-zero) (vec3-zero)) (let ((points (append-map (lambda (tri) (list (triangle3-p1 tri) (triangle3-p2 tri) (triangle3-p3 tri))) triangles))) (aabb-from-points points))))"))
