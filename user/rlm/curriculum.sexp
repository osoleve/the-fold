(task-entry (id "fp/simplify/simplify-product") (skill fp) (module simplify) (tier 1) (difficulty 10608) (name simplify-product) (type "(-> (List Expr) Expr)") (description "Simplify product by collecting numeric factors and combining powers") (notes ()) (section product-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list)) (answer "(define (simplify-product factors) (let* ((flat-factors (flatten-products factors)) (numeric-prod (apply * (filter-map get-numeric flat-factors))) (non-numeric (filter (lambda (e) (not (num? e))) flat-factors)) (collected (collect-like-bases non-numeric))) (cond ((= numeric-prod 0) (num 0)) ((and (null? collected) (= numeric-prod 1)) (num 1)) ((null? collected) (num numeric-prod)) ((= numeric-prod 1) (make-product-from-list collected)) (else (make-product-from-list (cons (num numeric-prod) collected))))))"))
(task-entry (id "fp/integrate/integrate-quotient") (skill fp) (module integrate) (tier 1) (difficulty 10608) (name integrate-quotient) (type "") (description "") (notes ()) (section basic-integration-rules) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power)) (answer "(define (integrate-quotient expr var-sym depth) (let ((numer (quot-numer expr)) (denom (quot-denom expr))) (cond ((not (contains-var? denom var-sym)) (let ((int-numer (integrate-internal numer var-sym (+ depth 1)))) (if int-numer (division int-numer denom) #f))) ((and (not (contains-var? numer var-sym)) (linear-in? denom var-sym)) (let* ((coeffs (linear-coefficients denom var-sym)) (a (car coeffs))) (division (product numer (sym-log (make-app 'abs denom))) a))) ((let ((d-denom (deriv denom var-sym))) (expr=? (simplify d-denom) (simplify numer))) (sym-log (make-app 'abs denom))) ((and (not (contains-var? numer var-sym)) #f) #f) (else #f))))"))
(task-entry (id "fp/solve/contains-var?") (skill fp) (module solve) (tier 1) (difficulty 10608) (name contains-var?) (type "") (description "") (notes ()) (section equation-representation) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var?)) (answer "(define (contains-var? expr var-sym) (cond ((num? expr) #f) ((var? expr) (eq? (var-name expr) var-sym)) ((sum? expr) (any-contains-var? (sum-terms expr) var-sym)) ((product? expr) (any-contains-var? (product-factors expr) var-sym)) ((difference? expr) (or (contains-var? (diff-left expr) var-sym) (and (diff-right expr) (contains-var? (diff-right expr) var-sym)))) ((quotient? expr) (or (contains-var? (quot-numer expr) var-sym) (contains-var? (quot-denom expr) var-sym))) ((power? expr) (or (contains-var? (pow-base expr) var-sym) (contains-var? (pow-exp expr) var-sym))) ((app? expr) (contains-var? (app-arg expr) var-sym)) (else #f)))"))
