(task-entry (id "autodiff/typed-gradients/safe-gradient-at") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12712) (name safe-gradient-at) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient)) (answer "(define (safe-gradient-at spec . args) (safe-gradient spec args))"))
