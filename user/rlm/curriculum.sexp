(task-entry (id "physics/classical/rigid-body/rigid-body-linear-momentum") (skill physics/classical) (module rigid-body) (tier 2) (difficulty 23530) (name rigid-body-linear-momentum) (type "") (description "") (notes ()) (section energy) (deps (\x27;prelude \x27;vec2)) (available (make-rigid-body rigid-body? rigid-body-pos rigid-body-vel rigid-body-angle rigid-body-angular-vel rigid-body-mass rigid-body-inv-mass rigid-body-inertia rigid-body-inv-inertia rigid-body-static? rigid-body-with-pos rigid-body-with-vel rigid-body-with-angle rigid-body-with-angular-vel rigid-body-with-mass rigid-body-with-inertia rigid-body-with-state make-static-rigid-body circle-inertia rectangle-inertia rod-inertia point-mass-inertia local-to-world world-to-local rigid-body-velocity-at apply-linear-impulse apply-angular-impulse apply-impulse-at-point rigid-body-kinetic-energy)) (answer "(define (rigid-body-linear-momentum body) (vec2-scale (rigid-body-vel body) (rigid-body-mass body)))"))
(task-entry (id "physics/classical/collision-detection/point-in-polygon?") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23530) (name point-in-polygon?) (type "") (description "") (notes ()) (section point-in-shape) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle?)) (answer "(define (point-in-polygon? point polygon) (let* ((verts (polygon-vertices polygon)) (n (length verts)) (px (vec2-x point)) (py (vec2-y point))) (let loop ((i 0) (inside #f)) (if (>= i n) inside (let* ((j (modulo (- i 1 n) n)) (vi (list-ref verts i)) (vj (list-ref verts j)) (viy (vec2-y vi)) (vjy (vec2-y vj)) (vix (vec2-x vi)) (vjx (vec2-x vj))) (if (and (not (eq? (> viy py) (> vjy py))) (< px (+ vjx (* (/ (- py vjy) (- viy vjy)) (- vix vjx))))) (loop (+ i 1) (not inside)) (loop (+ i 1) inside)))))))"))
(task-entry (id "physics/classical/collision-response/body-is-static?") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23530) (name body-is-static?) (type "") (description "") (notes ()) (section impulse) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material combine-materials velocity-at-point relative-velocity-at relative-velocity normal-velocity-at normal-velocity tangent-velocity get-inv-mass get-inv-inertia get-body-pos calculate-impulse-with-rotation calculate-impulse calculate-friction-impulse)) (answer "(define (body-is-static? body) (if (rigid-body? body) (< (rigid-body-inv-mass body) 1e-4) (body-static? body)))"))
(task-entry (id "physics/classical/constraints/constraint-entity-anchor-world") (skill physics/classical) (module constraints) (tier 2) (difficulty 23530) (name constraint-entity-anchor-world) (type "") (description "") (notes ()) (section helper:) (deps (\x27;prelude \x27;vec2 \x27;rigid-body)) (available (make-constraint constraint? constraint-type constraint-id constraint-entity-a constraint-entity-b constraint-data constraint-solver-velocity constraint-solver-position constraint-cached-lambda constraint-with-cached-lambda make-distance-constraint-data distance-data-anchor-a distance-data-anchor-b distance-data-target make-revolute-constraint-data revolute-data-anchor-a revolute-data-anchor-b make-spring-constraint-data spring-data-anchor-a spring-data-anchor-b spring-data-rest-length spring-data-stiffness spring-data-damping make-weld-constraint-data weld-data-anchor-a weld-data-anchor-b weld-data-reference-angle constraint-anchor-world-a constraint-anchor-world-b)) (answer "(define (constraint-entity-anchor-world world entity-id local-anchor) (let ((entity (world-get-entity world entity-id))) (if entity (let ((body (entity-body entity))) (if (rigid-body? body) (local-to-world body local-anchor) (vec2-add (body-pos body) local-anchor))) (vec2 0 0))))"))
(task-entry (id "physics/classical/constraint-graph/cg->simplicial-complex") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23530) (name cg->simplicial-complex) (type "") (description "") (notes ()) (section topology) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints toposort-dag cg-color-constraints build-constraint-conflicts cg-chromatic-number cg-stats cg-print-stats)) (answer "(define (cg->simplicial-complex graph) (let* ((entities (cg-entities graph)) (entity->idx (make-hashtable equal-hash equal?)) (_ (let loop ((es entities) (i 0)) (unless (null? es) (hashtable-set! entity->idx (car es) i) (loop (cdr es) (+ i 1))))) (vertices (map (lambda (e) (vertex (hashtable-ref entity->idx e 0))) entities)) (edges (filter-map (lambda (c) (let ((a (constraint-entity-a c)) (b (constraint-entity-b c))) (if b (let ((ia (hashtable-ref entity->idx a #f)) (ib (hashtable-ref entity->idx b #f))) (if (and ia ib) (edge ia ib) #f)) #f))) (cg-constraints graph)))) (fold-left sc-add-simplex (fold-left sc-add-simplex sc-empty vertices) edges)))"))
