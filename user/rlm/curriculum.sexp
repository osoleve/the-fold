(task-entry (id "autodiff/interval-autodiff/iv-traced-mul") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12716) (name iv-traced-mul) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub)) (answer "(define (iv-traced-mul a b) (let* ((av (interval-traced-value a)) (bv (interval-traced-value b)) (result (interval-mul av bv)) (tape (or (and (interval-traced? a) (interval-traced-tape a)) (and (interval-traced? b) (interval-traced-tape b))))) (if tape (interval-traced-op 'mul result (list a b) (list bv av) tape) result)))"))
