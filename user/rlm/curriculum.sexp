(task-entry (id "autodiff/differentiable-signal/convolve-vjp-kernel") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12708) (name convolve-vjp-kernel) (type "") (description "") (notes ()) (section convolution-vjp) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal)) (answer "(define (convolve-vjp-kernel output-grad signal mode kernel-len) (let* ((n (vector-length signal)) (m kernel-len) (grad-len (vector-length output-grad))) (case mode ((full) (let ((result (make-vector m 0))) (do ((j 0 (+ j 1))) ((= j m) result) (let ((sum 0)) (do ((i 0 (+ i 1))) ((= i n)) (let ((out-idx (+ i j))) (when (and (>= out-idx 0) (< out-idx grad-len)) (set! sum (+ sum (* (vector-ref signal i) (vector-ref output-grad out-idx))))))) (vector-set! result j sum))))) ((same) (let ((result (make-vector m 0)) (offset (quotient m 2))) (do ((j 0 (+ j 1))) ((= j m) result) (let ((sum 0)) (do ((i 0 (+ i 1))) ((= i n)) (let ((out-idx (+ i (- offset) j))) (when (and (>= out-idx 0) (< out-idx grad-len)) (set! sum (+ sum (* (vector-ref signal i) (vector-ref output-grad out-idx))))))) (vector-set! result j sum))))) ((valid) (let ((result (make-vector m 0))) (do ((j 0 (+ j 1))) ((= j m) result) (let ((sum 0)) (do ((i 0 (+ i 1))) ((= i grad-len)) (let ((sig-idx (+ i j))) (when (< sig-idx n) (set! sum (+ sum (* (vector-ref signal sig-idx) (vector-ref output-grad i))))))) (vector-set! result j sum))))) (else (error 'convolve-vjp-kernel \"invalid mode\" mode)))))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-grad-add") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12708) (name sparse-grad-add) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad)) (answer "(define (sparse-grad-add g1 g2) (let* ((n1 (sparse-grad-nnz g1)) (n2 (sparse-grad-nnz g2)) (idx1 (sparse-grad-indices g1)) (val1 (sparse-grad-values g1)) (idx2 (sparse-grad-indices g2)) (val2 (sparse-grad-values g2)) (acc (make-hashtable equal-hash equal?))) (do ((k 0 (+ k 1))) ((= k n1)) (let ((i (vector-ref idx1 k)) (v (vector-ref val1 k))) (hashtable-set! acc i (+ (hashtable-ref acc i 0) v)))) (do ((k 0 (+ k 1))) ((= k n2)) (let ((i (vector-ref idx2 k)) (v (vector-ref val2 k))) (hashtable-set! acc i (+ (hashtable-ref acc i 0) v)))) (let-values (((keys vals) (hashtable-entries acc))) (let* ((ks (vector->list keys)) (vs (vector->list vals)) (nz-pairs (filter (lambda (p) (not (= (cdr p) 0))) (map cons ks vs))) (nnz (length nz-pairs)) (indices (make-vector nnz 0)) (values (make-vector nnz 0))) (do ((k 0 (+ k 1)) (ps nz-pairs (cdr ps))) ((= k nnz) (make-sparse-grad indices values)) (vector-set! indices k (caar ps)) (vector-set! values k (cdar ps)))))))"))
