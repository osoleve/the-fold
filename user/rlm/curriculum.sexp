(task-entry (id "numeric/dft/fft-radix2-inplace!") (skill numeric) (module dft) (tier 0) (difficulty 2506) (name fft-radix2-inplace!) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;vec)) (available (power-of-2? log2-int bit-reverse bit-reverse-copy dft-naive idft-naive)) (answer "(define (fft-radix2-inplace! a) (let* ((n (vector-length a)) (log2n (log2-int n)) (two-pi (* 2 (pi-value)))) (do ((s 1 (+ s 1))) ((> s log2n) a) (let* ((m (expt 2 s)) (m/2 (quotient m 2)) (theta (/ (* -1 two-pi) m)) (twiddles (let ((tw (make-vector m/2))) (do ((j 0 (+ j 1))) ((= j m/2) tw) (vector-set! tw j (make-polar 1 (* theta j))))))) (do ((k 0 (+ k m))) ((>= k n)) (do ((j 0 (+ j 1))) ((= j m/2)) (let* ((w (vector-ref twiddles j)) (t-idx (+ k j m/2)) (u-idx (+ k j)) (t (complex-mul w (vector-ref a t-idx))) (u (vector-ref a u-idx))) (vector-set! a u-idx (complex-add u t)) (vector-set! a t-idx (complex-sub u t)))))))))"))
(task-entry (id "numeric/window-functions/kaiser-window") (skill numeric) (module window-functions) (tier 0) (difficulty 2506) (name kaiser-window) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (rectangular-window hann-window hamming-window blackman-window bartlett-window bessel-i0)) (answer "(define (kaiser-window n beta) (let ((result (make-vector n)) (denom (bessel-i0 beta)) (n-1 (- n 1)) (mid (/ (- n 1) 2.0))) (do ((i 0 (+ i 1))) ((= i n) result) (let* ((x (/ (- i mid) mid)) (arg (* beta (sqrt (- 1 (* x x))))) (numer (bessel-i0 arg))) (vector-set! result i (/ numer denom))))))"))
(task-entry (id "numeric/digital-filters/sinc") (skill numeric) (module digital-filters) (tier 0) (difficulty 2506) (name sinc) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window bessel-i0)) (answer "(define (sinc x) (if (< (abs x) 1e-10) 1.0 (let ((px (* (pi-value) x))) (/ (sin px) px))))"))
