(task-entry (id "game-theory/mechanism/third-price-auction") (skill game-theory) (module mechanism) (tier 1) (difficulty 13216) (name third-price-auction) (type "(-> (Vector Number) AuctionOutcome)") (description "Third-price auction: highest bidder wins, pays third-highest bid") (notes ("Not DSIC. Incentivizes overbidding. Useful as a theoretical example of non-truthful mechanisms. Ties broken by *tie-break-strategy*.")) (section single-item-auctions) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction)) (answer "(define (third-price-auction bids) (let* ((n (bids-length bids)) (winners (bids-winners bids)) (winner (select-winner winners)) (sorted (sort-by > (vector->list bids))) (payment (if (>= n 3) (caddr sorted) 0))) (make-auction-outcome winner payment)))"))
