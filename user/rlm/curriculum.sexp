(task-entry (id "statistics/model-protocol/model-mse") (skill statistics) (module model-protocol) (tier 1) (difficulty 11200) (name model-mse) (type "(-> Model Num)") (description "Compute mean squared error from model residuals") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;result-types \x27;sort)) (available ()) (answer "(define (model-mse model) (let* ((resid (model-residuals model)) (n (vector-length resid))) (/ (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (expt (vector-ref resid i) 2))))) n)))"))
(task-entry (id "statistics/summary-stats/mean") (skill statistics) (module summary-stats) (tier 1) (difficulty 11200) (name mean) (type "(-> (List Num) Num)") (description "Compute arithmetic mean") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available ()) (answer "(define (mean xs) (if (null? xs) (error 'mean \"empty list\") (/ (fold-left + 0 xs) (length xs))))"))
(task-entry (id "statistics/design-matrix/add-intercept") (skill statistics) (module design-matrix) (tier 1) (difficulty 11200) (name add-intercept) (type "(-> Matrix Matrix)") (description "Prepend a column of 1s to the matrix") (notes ()) (section intercept-handling) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available ()) (answer "(define (add-intercept X) (let* ((m (matrix-rows X)) (n (matrix-cols X)) (new-data (make-vector (* m (+ n 1))))) (do ((i 0 (+ i 1))) ((= i m)) (vector-set! new-data (* i (+ n 1)) 1) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! new-data (+ (* i (+ n 1)) j 1) (matrix-ref X i j)))) (list 'matrix m (+ n 1) new-data)))"))
(task-entry (id "statistics/diagnostics/hat-matrix") (skill statistics) (module diagnostics) (tier 1) (difficulty 11200) (name hat-matrix) (type "(-> Matrix Matrix)") (description "Compute the full hat matrix H = X(X'X)^(-1)X'") (notes ("This is O(n²p) in memory, use hat-matrix-diagonal for large n")) (section hat-matrix-and-leverage) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers)) (available ()) (answer "(define (hat-matrix X) (let* ((XtX (matrix-mul (matrix-transpose X) X)) (XtX-inv (matrix-inverse XtX))) (if (and (pair? XtX-inv) (eq? (car XtX-inv) 'error)) XtX-inv (matrix-mul (matrix-mul X XtX-inv) (matrix-transpose X)))))"))
(task-entry (id "statistics/linear/linear-model-fit") (skill statistics) (module linear) (tier 1) (difficulty 11200) (name linear-model-fit) (type "(-> Matrix Vec (or LinearModelResult Error))") (description "Fit linear model y = X*beta + epsilon using OLS") (notes ("X should include intercept column if desired" "Returns full diagnostic information")) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available ()) (answer "(define (linear-model-fit X y) (let* ((n (matrix-rows X)) (p (matrix-cols X))) (if (not (= n (vector-length y))) (list 'error 'dimension-mismatch n (vector-length y)) (let ((beta (matrix-least-squares X y))) (if (and (pair? beta) (eq? (car beta) 'error)) beta (linear-model-compute-diagnostics X y beta n p))))))"))
(task-entry (id "statistics/regularized/ridge-fit") (skill statistics) (module regularized) (tier 1) (difficulty 11200) (name ridge-fit) (type "(-> Matrix Vec Num (or LinearModelResult Error))") (description "Fit ridge regression with given lambda") (notes ("X should be standardized (except intercept column if present)")) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available ()) (answer "(define (ridge-fit X y lambda) (let* ((n (matrix-rows X)) (p (matrix-cols X))) (if (not (= n (vector-length y))) (list 'error 'dimension-mismatch n (vector-length y)) (if (<= lambda 0) (list 'error 'invalid-lambda lambda) (let* ((XtX (matrix-mul (matrix-transpose X) X)) (I (identity-matrix p)) (regularized (matrix-add XtX (matrix-scale lambda I))) (Xty (matrix-vec-mul (matrix-transpose X) y)) (beta (matrix-solve regularized Xty))) (if (and (pair? beta) (eq? (car beta) 'error)) beta (ridge-diagnostics X y beta lambda n p)))))))"))
(task-entry (id "statistics/glm/glm-fit") (skill statistics) (module glm) (tier 1) (difficulty 11200) (name glm-fit) (type "(-> GLMFamily LinkFunction Matrix Vec (or GLMResult Error))") (description "Fit a GLM using IRLS") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available ()) (answer "(define (glm-fit family link X y . opts) (let* ((max-iter (if (>= (length opts) 1) (car opts) 25)) (tol (if (>= (length opts) 2) (cadr opts) 1e-8)) (n (matrix-rows X)) (p (matrix-cols X)) (init-fn (family-initialize family)) (var-fn (family-variance family)) (g-inv (link-inverse link)) (g-deriv (link-derivative link)) (g (link-g link))) (if (not (= n (vector-length y))) (list 'error 'dimension-mismatch n (vector-length y)) (let* ((mu-init (make-vector n)) (eta-init (make-vector n))) (do ((i 0 (+ i 1))) ((= i n)) (let ((mu-i (init-fn (vector-ref y i)))) (vector-set! mu-init i mu-i) (vector-set! eta-init i (g mu-i)))) (irls-loop family link X y mu-init eta-init 0 max-iter tol n p)))))"))
(task-entry (id "statistics/families/make-glm-family") (skill statistics) (module families) (tier 1) (difficulty 11200) (name make-glm-family) (type "(-> Symbol (-> Num Num) (-> Num Num Num) (-> Num Bool) (-> Num Num) GLMFamily)") (description "Create a GLM family") (notes ()) (section family-structure) (deps (\x27;prelude \x27;transcendental)) (available ()) (answer "(define (make-glm-family name variance deviance-contrib valid-mu? initialize) (list 'glm-family name variance deviance-contrib valid-mu? initialize))"))
(task-entry (id "statistics/link-functions/make-link-function") (skill statistics) (module link-functions) (tier 1) (difficulty 11200) (name make-link-function) (type "(-> Symbol (-> Num Num) (-> Num Num) (-> Num Num) LinkFunction)") (description "Create a link function") (notes ()) (section link-function-structure) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available ()) (answer "(define (make-link-function name g g-inverse g-derivative) (list 'link-function name g g-inverse g-derivative))"))
(task-entry (id "statistics/distributions/t-cdf") (skill statistics) (module distributions) (tier 1) (difficulty 11200) (name t-cdf) (type "(-> Num Num Num)") (description "CDF of Student's t-distribution with df degrees of freedom") (notes ()) (section student-t-distribution) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available ()) (answer "(define (t-cdf x df) (if (<= df 0) (error 't-cdf \"df must be positive\" df) (let* ((x2 (* x x)) (u (/ df (+ df x2)))) (if (>= x 0) (- 1 (* 0.5 (betainc (/ df 2) 0.5 u))) (* 0.5 (betainc (/ df 2) 0.5 u))))))"))
(task-entry (id "statistics/t-test/t-test-one-sample") (skill statistics) (module t-test) (tier 1) (difficulty 11200) (name t-test-one-sample) (type "(-> Vec TestResult)") (description "Test H0: mean = mu0 vs H1: mean != mu0 (two-tailed)") (notes ()) (section one-sample-t-test) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;stat/distributions)) (available ()) (answer "(define (t-test-one-sample xs . opts) (let* ((mu0 (if (>= (length opts) 1) (car opts) 0)) (confidence (if (>= (length opts) 2) (cadr opts) 0.95)) (n (vector-length xs)) (x-bar (vec-mean xs)) (s (vec-std-dev xs)) (se (/ s (sqrt n))) (t-stat (/ (- x-bar mu0) se)) (df (- n 1)) (p-value (t-pvalue-two-tailed t-stat df)) (t-crit (t-quantile (+ 0.5 (/ confidence 2)) df)) (ci-lower (- x-bar (* t-crit se))) (ci-upper (+ x-bar (* t-crit se))) (effect-size (/ (- x-bar mu0) s))) (make-test-result 't-test-one-sample t-stat df p-value (cons ci-lower ci-upper) effect-size)))"))
(task-entry (id "statistics/chi-squared/chi-squared-test-goodness") (skill statistics) (module chi-squared) (tier 1) (difficulty 11200) (name chi-squared-test-goodness) (type "(-> Vec Vec TestResult)") (description "Test H0: observed frequencies match expected frequencies") (notes ("chi-sq = sum((O - E)² / E)")) (section goodness-of-fit-test) (deps (\x27;prelude \x27;matrix \x27;result-types \x27;stat/distributions)) (available ()) (answer "(define (chi-squared-test-goodness observed expected) (let* ((n (vector-length observed))) (if (not (= n (vector-length expected))) (error 'chi-squared-test-goodness \"vectors must have equal length\") (let* ((chi-sq (let loop ((i 0) (sum 0)) (if (= i n) sum (let* ((o (vector-ref observed i)) (e (vector-ref expected i)) (e-safe (max e 1e-10)) (contrib (/ (expt (- o e) 2) e-safe))) (loop (+ i 1) (+ sum contrib)))))) (df (- n 1)) (p-value (chi-squared-pvalue chi-sq df))) (make-test-result 'chi-squared-goodness chi-sq df p-value #f #f)))))"))
(task-entry (id "statistics/anova/anova-one-way") (skill statistics) (module anova) (tier 1) (difficulty 11200) (name anova-one-way) (type "(-> (List Vec) ANOVAResult)") (description "Test H0: all group means are equal") (notes ("F = (SS_between / df_between) / (SS_within / df_within)")) (section one-way-anova) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;stat/distributions)) (available ()) (answer "(define (anova-one-way groups) (let* ((k (length groups)) (ns (map vector-length groups)) (n (apply + ns)) (means (map vec-mean groups)) (grand-mean (compute-grand-mean groups)) (ss-between (compute-ss-between groups means grand-mean ns)) (ss-within (compute-ss-within groups means)) (df-between (- k 1)) (df-within (- n k)) (ms-between (/ ss-between (max df-between 1))) (ms-within (/ ss-within (max df-within 1))) (f-stat (/ ms-between (max ms-within 1e-10))) (p-value (f-pvalue f-stat df-between df-within))) (make-anova-result f-stat df-between df-within p-value ss-between ss-within ms-between ms-within)))"))
(task-entry (id "statistics/f-test/f-test-variance") (skill statistics) (module f-test) (tier 1) (difficulty 11200) (name f-test-variance) (type "(-> Vec Vec TestResult)") (description "Test H0: var(x) = var(y) vs H1: var(x) != var(y)") (notes ("F = var(x) / var(y) follows F(n1-1, n2-1) under H0")) (section variance-ratio-test) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;stat/distributions)) (available ()) (answer "(define (f-test-variance xs ys) (let* ((n1 (vector-length xs)) (n2 (vector-length ys)) (var1 (vec-variance xs)) (var2 (vec-variance ys)) (ordered (if (>= var1 var2) (list var1 var2 (- n1 1) (- n2 1)) (list var2 var1 (- n2 1) (- n1 1)))) (var-num (car ordered)) (var-den (cadr ordered)) (df1 (caddr ordered)) (df2 (cadddr ordered)) (f-stat (/ var-num (max var-den 1e-10))) (p-upper (- 1 (f-cdf f-stat df1 df2))) (p-value (* 2 (min p-upper (- 1 p-upper)))) (ci (variance-ratio-ci var1 var2 (- n1 1) (- n2 1) 0.95))) (make-test-result 'f-test-variance f-stat (cons df1 df2) p-value ci #f)))"))
(task-entry (id "statistics/differencing/vec-diff") (skill statistics) (module differencing) (tier 1) (difficulty 11200) (name vec-diff) (type "") (description "") (notes ()) (section simple-differencing) (deps (\x27;prelude)) (available ()) (answer "(define (vec-diff xs) (let* ((n (vector-length xs)) (m (- n 1)) (result (make-vector m))) (do ((i 0 (+ i 1))) ((= i m) result) (vector-set! result i (- (vector-ref xs (+ i 1)) (vector-ref xs i))))))"))
(task-entry (id "statistics/acf-pacf/autocovariance") (skill statistics) (module acf-pacf) (tier 1) (difficulty 11200) (name autocovariance) (type "") (description "") (notes ()) (section autocovariance-and-autocorrelation) (deps (\x27;prelude \x27;summary-stats \x27;stat/distributions)) (available ()) (answer "(define (autocovariance xs k) (let* ((n (vector-length xs)) (mean (vec-mean xs)) (sum (let loop ((i 0) (s 0)) (if (>= i (- n k)) s (loop (+ i 1) (+ s (* (- (vector-ref xs i) mean) (- (vector-ref xs (+ i k)) mean)))))))) (/ sum n)))"))
(task-entry (id "statistics/ar/ar-fit") (skill statistics) (module ar) (tier 1) (difficulty 11200) (name ar-fit) (type "(-> Vec Nat (or ARResult Error))") (description "Fit AR(p) model using Yule-Walker equations") (notes ()) (section ar-model-fitting) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available ()) (answer "(define (ar-fit xs p) (let* ((n (vector-length xs)) (mean (vec-mean xs))) (if (< n (+ p 2)) (list 'error 'insufficient-data n p) (let* ((centered (center-series xs mean)) (acf-vals (acf centered p)) (phi (levinson-durbin acf-vals))) (if (and (pair? phi) (eq? (car phi) 'error)) phi (ar-compute-diagnostics xs centered phi mean p n))))))"))
(task-entry (id "statistics/ar-poly/Q-field-ts") (skill statistics) (module ar-poly) (tier 1) (difficulty 11200) (name Q-field-ts) (type "") (description "") (notes ()) (section rational-field-for-exact-coefficient-arithmetic) (deps (\x27;field \x27;algebra/polynomial)) (available ()) (answer "(define Q-field-ts (make-field '() + * 0 1 - (lambda (a b) (/ a b)) =))"))
(task-entry (id "statistics/ma/moving-average") (skill statistics) (module ma) (tier 1) (difficulty 11200) (name moving-average) (type "(-> Vec Nat Vec)") (description "Simple moving average smoother") (notes ("Returns smoothed series of length n - window + 1")) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available ()) (answer "(define (moving-average xs window) (let* ((n (vector-length xs)) (m (- n window -1)) (result (make-vector m))) (if (< n window) result (begin (let ((first-sum (let loop ((i 0) (s 0)) (if (= i window) s (loop (+ i 1) (+ s (vector-ref xs i))))))) (vector-set! result 0 (/ first-sum window)) (let loop ((i 1) (sum first-sum)) (when (< i m) (let ((new-sum (- (+ sum (vector-ref xs (+ i window -1))) (vector-ref xs (- i 1))))) (vector-set! result i (/ new-sum window)) (loop (+ i 1) new-sum)))) result)))))"))
(task-entry (id "statistics/exponential/simple-exponential-smooth") (skill statistics) (module exponential) (tier 1) (difficulty 11200) (name simple-exponential-smooth) (type "(-> Vec Num SESResult)") (description "Single exponential smoothing: s_t = alpha * x_t + (1-alpha) * s_{t-1}") (notes ("Alpha in (0, 1): higher alpha = more weight on recent observations")) (section simple-exponential-smoothing-ses) (deps (\x27;prelude)) (available ()) (answer "(define (simple-exponential-smooth xs alpha) (let* ((n (vector-length xs)) (smoothed (make-vector n)) (s0 (vector-ref xs 0))) (vector-set! smoothed 0 s0) (do ((t 1 (+ t 1))) ((= t n)) (let ((prev (vector-ref smoothed (- t 1))) (curr (vector-ref xs t))) (vector-set! smoothed t (+ (* alpha curr) (* (- 1 alpha) prev))))) (list 'ses-result alpha smoothed (vector-ref smoothed (- n 1)))))"))
(task-entry (id "statistics/forecast/mae") (skill statistics) (module forecast) (tier 1) (difficulty 11200) (name mae) (type "") (description "") (notes ()) (section forecast-accuracy-metrics) (deps (\x27;prelude)) (available ()) (answer "(define (mae actual forecast) (let* ((n (min (vector-length actual) (vector-length forecast))) (sum (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (abs (- (vector-ref actual i) (vector-ref forecast i))))))))) (/ sum (max n 1))))"))
