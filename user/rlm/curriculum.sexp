(task-entry (id "game-theory/mcdm/weighted-borda-winner") (skill game-theory) (module mcdm) (tier 1) (difficulty 13217) (name weighted-borda-winner) (type "(-> DecisionProblem (List Real) Alternative)") (description "Find best alternative using weighted Borda. Weights allow criteria to have different importance levels") (notes ()) (section weighted-borda) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores)) (answer "(define (weighted-borda-winner dp weights) (caar (weighted-borda-scores dp weights)))"))
(task-entry (id "game-theory/normal-form/eliminate-strategy-p2") (skill game-theory) (module normal-form) (tier 1) (difficulty 13218) (name eliminate-strategy-p2) (type "") (description "") (notes ()) (section iesds) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1)) (answer "(define (eliminate-strategy-p2 game j) (let* ((s1 (game%-strategies1 game)) (s2 (game%-strategies2 game)) (payoffs (game%-payoffs game)) (n2 (vector-length s2)) (new-s2 (list->vector (filter (lambda (x) x) (map (lambda (k) (if (= k j) #f (vector-ref s2 k))) (iota n2))))) (new-payoffs (vector-map (lambda (row) (list->vector (filter (lambda (x) x) (map (lambda (k) (if (= k j) #f (vector-ref row k))) (iota n2))))) payoffs))) (make-game% s1 new-s2 new-payoffs)))"))
