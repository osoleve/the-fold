(task-entry (id "clp/fd-constraints/*fd") (skill clp) (module fd-constraints) (tier 1) (difficulty 10820) (name *fd) (type "(-> (Or LVar Int) (Or LVar Int) (Or LVar Int) (-> CStore (Maybe CStore)))") (description "Constrain x * y = z using bounds consistency") (notes ()) (section arithmetic-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const =/=fd-var-var \x2B;fd fd-value \x2B;fd-bounds fd-bounds fd-narrow-bounds \x2D;fd)) (answer "(define (*fd x y z) (lambda (cs) (let ((x-val (fd-value cs x)) (y-val (fd-value cs y)) (z-val (fd-value cs z))) (cond ((and x-val y-val z-val) (if (= (* x-val y-val) z-val) cs #f)) ((and x-val y-val) ((=fd z (* x-val y-val)) cs)) ((and x-val z-val) (if (and (not (= x-val 0)) (= 0 (modulo z-val x-val))) ((=fd y (quotient z-val x-val)) cs) (if (= x-val 0) (if (= z-val 0) cs #f) #f))) ((and y-val z-val) (if (and (not (= y-val 0)) (= 0 (modulo z-val y-val))) ((=fd x (quotient z-val y-val)) cs) (if (= y-val 0) (if (= z-val 0) cs #f) #f))) (else (*fd-bounds cs x y z))))))"))
(task-entry (id "clp/global-constraints/remove-value-from-can-vars") (skill clp) (module global-constraints) (tier 1) (difficulty 10820) (name remove-value-from-can-vars) (type "(-> CStore Int (List LVar) (Maybe CStore))") (description "Remove value from all vars that aren't already singleton with that value") (notes ()) (section count-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate sum-fd-narrow-vars post-sum-fd count-fd count-fd-propagate count-must-equal count-can-equal count-fd-fix fix-all-can-vars)) (answer "(define (remove-value-from-can-vars cs value vars) (let loop ((vars vars) (cs cs)) (if (null? vars) cs (let* ((var (car vars)) (dom (cstore-get-domain cs var))) (if (and dom (domain-singleton? dom) (= (domain-min dom) value)) (loop (cdr vars) cs) (let ((cs1 (if dom (cstore-set-domain cs var (domain-subtract-value dom value)) cs))) (if cs1 (loop (cdr vars) cs1) #f)))))))"))
