(task-entry (id "data/avl-tree/rotate-right") (skill data) (module avl-tree) (tier 0) (difficulty 1312) (name rotate-right) (type "(-> AVL AVL)") (description "Right rotation for left-heavy trees") (notes ()) (section smart-constructor-and-rotations) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node rotate-left)) (answer "(define (rotate-right tree) (let ((y-key (avl-key tree)) (y-val (avl-value tree)) (x (avl-left tree)) (c (avl-right tree))) (let ((x-key (avl-key x)) (x-val (avl-value x)) (a (avl-left x)) (b (avl-right x))) (make-avl-node x-key x-val a (make-avl-node y-key y-val b c)))))"))
