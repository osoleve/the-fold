(task-entry (id "topology/persistent/diagram->barcode") (skill topology) (module persistent) (tier 1) (difficulty 11833) (name diagram->barcode) (type "(-> PersistenceDiagram Barcode)") (description "Convert persistence diagram to barcode format") (notes ("Barcode groups intervals by dimension")) (section barcode) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti)) (answer "(define (diagram->barcode pd) (let* ((points (diagram-points pd)) (max-dim (apply max 0 (map caddr points))) (by-dim (make-vector (+ max-dim 1) '()))) (for-each (lambda (pt) (let ((dim (caddr pt)) (interval (list (car pt) (cadr pt)))) (vector-set! by-dim dim (cons interval (vector-ref by-dim dim))))) points) (list 'barcode (let loop ((d 0) (acc '())) (if (> d max-dim) (reverse acc) (loop (+ d 1) (cons (cons d (sort-by car< (vector-ref by-dim d))) acc)))))))"))
(task-entry (id "topology/simplicial-complex/sc-skeleton") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11834) (name sc-skeleton) (type "(-> SC Integer SC)") (description "Get the k-skeleton: all simplices of dimension ≤ k") (notes ()) (section skeleton-subcomplex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only simplex-in-list? sc-add-simplex sc-from-simplices sc-contains? sc-simplices sc-simplices-dim sc-vertices sc-edges sc-faces sc-count sc-count-dim)) (answer "(define (sc-skeleton sc k) (let* ((vec (sc-simplices-by-dim sc)) (n (min (+ k 1) (vector-length vec))) (new-vec (make-vector n '()))) (let loop ((i 0)) (when (< i n) (vector-set! new-vec i (vector-ref vec i)) (loop (+ i 1)))) (list 'sc new-vec k)))"))
