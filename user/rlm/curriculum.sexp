(task-entry (id "crypto/sha512/pad-message-512") (skill crypto) (module sha512) (tier 1) (difficulty 10513) (name pad-message-512) (type "(-> Bytevector Bytevector)") (description "Pad to multiple of 128 bytes (1024 bits). Append 1 bit, zeros, then 128-bit big-endian length") (notes ()) (section message-padding) (deps ()) (available (u64-mask u64 u64+ rotr64 shr64 Ch Maj Sigma0-512 Sigma1-512 sigma0-512 sigma1-512 H-init-512 K-512)) (answer "(define (pad-message-512 msg) (let* ((len (bytevector-length msg)) (bit-len (* 8 len)) (padded-len (let ((rem (modulo (+ len 17) 128))) (if (= rem 0) (+ len 17) (+ len 17 (- 128 rem))))) (result (make-bytevector padded-len 0))) (bytevector-copy! msg 0 result 0 len) (bytevector-u8-set! result len 128) (bytevector-u64-set! result (- padded-len 8) bit-len 'big) result))"))
