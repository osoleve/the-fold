(task-entry (id "parallel/strategies/make-thunk") (skill parallel) (module strategies) (tier 1) (difficulty 11400) (name make-thunk) (type "(-> Any Nat Thunk)") (description "Create a thunk descriptor with ID and work estimate.") (notes ()) (section thunk-type) (deps (\x27;prelude \x27;cost-analysis)) (available ()) (answer "(define (make-thunk id estimated-work) (quasiquote (thunk (unquote id) (unquote estimated-work))))"))
(task-entry (id "parallel/patterns/par-divide-and-conquer") (skill parallel) (module patterns) (tier 1) (difficulty 11400) (name par-divide-and-conquer) (type "(-> (-> (List Thunk) Boolean) (-> (List Thunk) (Values (List Thunk) (List Thunk))) Symbol (-> Thunk Plan) (List Thunk) Nat Plan)") (description "Generic divide-and-conquer skeleton.\n\n  divisible?  : Can this thunk list be split further?\n  divide      : Split thunks into two halves (returns pair of lists)\n  combine     : Symbol naming the combiner function\n  base-case   : Strategy for leaf thunks (thunk -> plan)\n  thunks      : The work units\n  fuel        : Recursion fuel (prevents infinite splitting)\n\nReturns a plan:tree of nested plan:par and base-case plans.") (notes ()) (section divide-and-conquer) (deps (\x27;prelude \x27;strategies)) (available ()) (answer "(define (par-divide-and-conquer divisible? divide combine base-case thunks fuel) (let dc ((ts thunks) (f fuel)) (cond ((<= f 0) (plan:seq ts)) ((null? ts) (plan:seq '())) ((not (divisible? ts)) (if (= (length ts) 1) (base-case (car ts)) (plan:tree combine (map base-case ts)))) (else (let-values (((left right) (divide ts))) (plan:tree combine (list (dc left (- f 1)) (dc right (- f 1)))))))))"))
(task-entry (id "parallel/strategies/thunk?") (skill parallel) (module strategies) (tier 1) (difficulty 11401) (name thunk?) (type "(-> Any Boolean)") (description "") (notes ()) (section thunk-type) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk)) (answer "(define (thunk? x) (and (pair? x) (eq? (car x) 'thunk) (pair? (cdr x)) (pair? (cddr x))))"))
(task-entry (id "parallel/patterns/par-reduce") (skill parallel) (module patterns) (tier 1) (difficulty 11401) (name par-reduce) (type "(-> Symbol (List Thunk) Nat Plan)") (description "Parallel associative reduction.\n\nBuilds a balanced binary tree of parallel reductions.\ncombiner names the associative binary function.\nRequires >= 2 thunks for parallelism; single thunk returns plan:seq.\n\n  (par-reduce 'add [(thunk 'a 100) (thunk 'b 100) (thunk 'c 100) (thunk 'd 100)] 1000)\n  =>  (plan:tree add\n        [(plan:tree add [(plan:seq [(thunk 'a 100)]) (plan:seq [(thunk 'b 100)])])\n         (plan:tree add [(plan:seq [(thunk 'c 100)]) (plan:seq [(thunk 'd 100)])])])") (notes ()) (section parallel-reduction) (deps (\x27;prelude \x27;strategies)) (available (par-divide-and-conquer)) (answer "(define (par-reduce combiner thunks fuel) (let reduce ((ts thunks) (f fuel)) (cond ((<= f 0) (plan:seq ts)) ((null? ts) (plan:seq '())) ((= (length ts) 1) (plan:seq ts)) ((= (length ts) 2) (plan:tree combiner (list (plan:seq (list (car ts))) (plan:seq (list (cadr ts)))))) (else (let* ((mid (quotient (length ts) 2)) (left (list-head ts mid)) (right (list-tail ts mid))) (plan:tree combiner (list (reduce left (- f 1)) (reduce right (- f 1)))))))))"))
(task-entry (id "parallel/strategies/thunk-id") (skill parallel) (module strategies) (tier 1) (difficulty 11402) (name thunk-id) (type "(-> Thunk Any)") (description "") (notes ()) (section thunk-type) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk?)) (answer "(define (thunk-id t) (cadr t))"))
(task-entry (id "parallel/patterns/par-scan") (skill parallel) (module patterns) (tier 1) (difficulty 11402) (name par-scan) (type "(-> Symbol (List Thunk) Nat Plan)") (description "Blelloch-style parallel prefix scan skeleton.\n\nProduces a two-phase plan:\n  Phase 1 (up-sweep):  Parallel pairwise reduction from leaves to root\n  Phase 2 (down-sweep): Parallel distribution of partial sums back down\n\nThe plan is represented as a pipeline of two stages:\n  (plan:pipe ((up-sweep . <reduce-plan>) (down-sweep . <distribute-plan>)))\n\nEach stage is a balanced tree matching par-reduce's shape.") (notes ()) (section parallel-prefix-scan) (deps (\x27;prelude \x27;strategies)) (available (par-divide-and-conquer par-reduce)) (answer "(define (par-scan combiner thunks fuel) (if (< (length thunks) 2) (plan:seq thunks) (let* ((up-plan (par-reduce combiner thunks fuel)) (reversed-ts (reverse thunks)) (down-plan (par-reduce combiner reversed-ts fuel))) (plan:pipe (list (cons 'up-sweep (plan-thunks-deep up-plan)) (cons 'down-sweep (plan-thunks-deep down-plan)))))))"))
(task-entry (id "parallel/strategies/thunk-work") (skill parallel) (module strategies) (tier 1) (difficulty 11403) (name thunk-work) (type "(-> Thunk Nat)") (description "") (notes ()) (section thunk-type) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id)) (answer "(define (thunk-work t) (caddr t))"))
(task-entry (id "parallel/patterns/plan-thunks-deep") (skill parallel) (module patterns) (tier 1) (difficulty 11403) (name plan-thunks-deep) (type "(-> Plan (List Thunk))") (description "Collect all thunks from a plan, recursing into sub-plans.") (notes ()) (section parallel-prefix-scan) (deps (\x27;prelude \x27;strategies)) (available (par-divide-and-conquer par-reduce par-scan)) (answer "(define (plan-thunks-deep plan) (case (plan-type plan) ((plan:seq plan:par plan:race) (plan-thunks plan)) ((plan:chunk) (plan-thunks plan)) ((plan:tree) (apply append (map plan-thunks-deep (plan-sub-plans plan)))) ((plan:pipe) (apply append (map cdr (plan-stages plan)))) (else '())))"))
(task-entry (id "parallel/strategies/plan:seq") (skill parallel) (module strategies) (tier 1) (difficulty 11404) (name plan:seq) (type "(-> (List Thunk) Plan)") (description "Sequential execution plan.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work)) (answer "(define (plan:seq thunks) (quasiquote (plan:seq (unquote thunks))))"))
(task-entry (id "parallel/patterns/par-pipeline") (skill parallel) (module patterns) (tier 1) (difficulty 11404) (name par-pipeline) (type "(-> (List (Pair Symbol (List Thunk))) Nat Plan)") (description "Multi-stage streaming pipeline.\n\nstages is a list of (name . thunks) pairs. Each stage can process\nits thunks in parallel, with inter-stage synchronization.\n\n  (par-pipeline '((parse . [t1 t2]) (transform . [t3 t4]) (emit . [t5]))\n                1000)\n  => (plan:pipe ((parse t1 t2) (transform t3 t4) (emit t5)))") (notes ()) (section parallel-pipeline) (deps (\x27;prelude \x27;strategies)) (available (par-divide-and-conquer par-reduce par-scan plan-thunks-deep)) (answer "(define (par-pipeline stages fuel) (if (null? stages) (plan:seq '()) (plan:pipe stages)))"))
(task-entry (id "parallel/strategies/plan:par") (skill parallel) (module strategies) (tier 1) (difficulty 11405) (name plan:par) (type "(-> (List Thunk) Plan)") (description "Parallel execution plan.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq)) (answer "(define (plan:par thunks) (quasiquote (plan:par (unquote thunks))))"))
(task-entry (id "parallel/patterns/par-sort") (skill parallel) (module patterns) (tier 1) (difficulty 11405) (name par-sort) (type "(-> (List Thunk) Nat Plan)") (description "Parallel merge sort skeleton.\n\nBuilt on divide-and-conquer with:\n  - divisible? : more than one thunk\n  - divide     : split at midpoint\n  - combine    : merge\n  - base-case  : single-element plan:seq\n\nProduces a plan:tree of nested merges.") (notes ()) (section parallel-sort) (deps (\x27;prelude \x27;strategies)) (available (par-divide-and-conquer par-reduce par-scan plan-thunks-deep par-pipeline)) (answer "(define (par-sort thunks fuel) (par-divide-and-conquer (lambda (ts) (> (length ts) 1)) (lambda (ts) (let ((mid (quotient (length ts) 2))) (values (list-head ts mid) (list-tail ts mid)))) 'merge (lambda (t) (plan:seq (list t))) thunks fuel))"))
(task-entry (id "parallel/strategies/plan:chunk") (skill parallel) (module strategies) (tier 1) (difficulty 11406) (name plan:chunk) (type "(-> Nat (List Thunk) Plan)") (description "Chunked parallel plan: partition into size-element chunks, run chunks in parallel.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par)) (answer "(define (plan:chunk size thunks) (quasiquote (plan:chunk (unquote size) (unquote thunks))))"))
(task-entry (id "parallel/patterns/list-head") (skill parallel) (module patterns) (tier 1) (difficulty 11406) (name list-head) (type "(-> (List a) Nat (List a))") (description "") (notes ()) (section parallel-sort) (deps (\x27;prelude \x27;strategies)) (available (par-divide-and-conquer par-reduce par-scan plan-thunks-deep par-pipeline par-sort)) (answer "(define (list-head lst n) (if (or (zero? n) (null? lst)) '() (cons (car lst) (list-head (cdr lst) (- n 1)))))"))
(task-entry (id "parallel/strategies/plan:tree") (skill parallel) (module strategies) (tier 1) (difficulty 11407) (name plan:tree) (type "(-> Symbol (List Plan) Plan)") (description "Recursive parallel plan for divide-and-conquer.\ncombiner names the function that merges sub-results.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk)) (answer "(define (plan:tree combiner sub-plans) (quasiquote (plan:tree (unquote combiner) (unquote sub-plans))))"))
(task-entry (id "parallel/strategies/plan:race") (skill parallel) (module strategies) (tier 1) (difficulty 11408) (name plan:race) (type "(-> (List Thunk) Plan)") (description "Speculative execution: run all thunks, take first to succeed.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree)) (answer "(define (plan:race thunks) (quasiquote (plan:race (unquote thunks))))"))
(task-entry (id "parallel/strategies/plan:pipe") (skill parallel) (module strategies) (tier 1) (difficulty 11409) (name plan:pipe) (type "(-> (List (Pair Symbol (List Thunk))) Plan)") (description "Pipeline plan: each stage feeds the next.\nstages is a list of (stage-name . thunks) pairs.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race)) (answer "(define (plan:pipe stages) (quasiquote (plan:pipe (unquote stages))))"))
(task-entry (id "parallel/strategies/plan?") (skill parallel) (module strategies) (tier 1) (difficulty 11410) (name plan?) (type "(-> Any Boolean)") (description "") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe)) (answer "(define (plan? x) (and (pair? x) (memq (car x) '(plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe)) #t))"))
(task-entry (id "parallel/strategies/plan-type") (skill parallel) (module strategies) (tier 1) (difficulty 11411) (name plan-type) (type "(-> Plan Symbol)") (description "") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan?)) (answer "(define (plan-type p) (car p))"))
(task-entry (id "parallel/strategies/plan:seq?") (skill parallel) (module strategies) (tier 1) (difficulty 11412) (name plan:seq?) (type "") (description "") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type)) (answer "(define (plan:seq? p) (and (pair? p) (eq? (car p) 'plan:seq)))"))
(task-entry (id "parallel/strategies/plan:par?") (skill parallel) (module strategies) (tier 1) (difficulty 11413) (name plan:par?) (type "") (description "") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq?)) (answer "(define (plan:par? p) (and (pair? p) (eq? (car p) 'plan:par)))"))
(task-entry (id "parallel/strategies/plan:chunk?") (skill parallel) (module strategies) (tier 1) (difficulty 11414) (name plan:chunk?) (type "") (description "") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par?)) (answer "(define (plan:chunk? p) (and (pair? p) (eq? (car p) 'plan:chunk)))"))
(task-entry (id "parallel/strategies/plan:tree?") (skill parallel) (module strategies) (tier 1) (difficulty 11415) (name plan:tree?) (type "") (description "") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk?)) (answer "(define (plan:tree? p) (and (pair? p) (eq? (car p) 'plan:tree)))"))
(task-entry (id "parallel/strategies/plan:race?") (skill parallel) (module strategies) (tier 1) (difficulty 11416) (name plan:race?) (type "") (description "") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree?)) (answer "(define (plan:race? p) (and (pair? p) (eq? (car p) 'plan:race)))"))
(task-entry (id "parallel/strategies/plan:pipe?") (skill parallel) (module strategies) (tier 1) (difficulty 11417) (name plan:pipe?) (type "") (description "") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race?)) (answer "(define (plan:pipe? p) (and (pair? p) (eq? (car p) 'plan:pipe)))"))
(task-entry (id "parallel/strategies/plan-thunks") (skill parallel) (module strategies) (tier 1) (difficulty 11418) (name plan-thunks) (type "(-> Plan (List Thunk))") (description "Get thunks from a flat plan (seq/par/chunk/race).") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe?)) (answer "(define (plan-thunks p) (case (plan-type p) ((plan:seq plan:par plan:race) (cadr p)) ((plan:chunk) (caddr p)) (else (error 'plan-thunks \"not a flat plan\" p))))"))
(task-entry (id "parallel/strategies/plan-chunk-size") (skill parallel) (module strategies) (tier 1) (difficulty 11419) (name plan-chunk-size) (type "(-> Plan Nat)") (description "Get chunk size from a plan:chunk.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks)) (answer "(define (plan-chunk-size p) (if (plan:chunk? p) (cadr p) (error 'plan-chunk-size \"not a plan:chunk\" p)))"))
(task-entry (id "parallel/strategies/plan-combiner") (skill parallel) (module strategies) (tier 1) (difficulty 11420) (name plan-combiner) (type "(-> Plan Symbol)") (description "Get combiner name from a plan:tree.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size)) (answer "(define (plan-combiner p) (if (plan:tree? p) (cadr p) (error 'plan-combiner \"not a plan:tree\" p)))"))
(task-entry (id "parallel/strategies/plan-sub-plans") (skill parallel) (module strategies) (tier 1) (difficulty 11421) (name plan-sub-plans) (type "(-> Plan (List Plan))") (description "Get sub-plans from a plan:tree.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner)) (answer "(define (plan-sub-plans p) (if (plan:tree? p) (caddr p) (error 'plan-sub-plans \"not a plan:tree\" p)))"))
(task-entry (id "parallel/strategies/plan-stages") (skill parallel) (module strategies) (tier 1) (difficulty 11422) (name plan-stages) (type "(-> Plan (List (Pair Symbol (List Thunk))))") (description "Get stages from a plan:pipe.") (notes ()) (section plan-types) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans)) (answer "(define (plan-stages p) (if (plan:pipe? p) (cadr p) (error 'plan-stages \"not a plan:pipe\" p)))"))
(task-entry (id "parallel/strategies/make-strategy") (skill parallel) (module strategies) (tier 1) (difficulty 11423) (name make-strategy) (type "(-> Symbol (-> (List Thunk) Nat Plan) Strategy)") (description "Create a named strategy with a transform function.") (notes ()) (section strategy-type) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages)) (answer "(define (make-strategy name transform) (quasiquote (strategy (unquote name) (unquote transform))))"))
(task-entry (id "parallel/strategies/strategy?") (skill parallel) (module strategies) (tier 1) (difficulty 11424) (name strategy?) (type "(-> Any Boolean)") (description "") (notes ()) (section strategy-type) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy)) (answer "(define (strategy? x) (and (pair? x) (eq? (car x) 'strategy)))"))
(task-entry (id "parallel/strategies/strategy-name") (skill parallel) (module strategies) (tier 1) (difficulty 11425) (name strategy-name) (type "(-> Strategy Symbol)") (description "") (notes ()) (section strategy-type) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy?)) (answer "(define (strategy-name s) (cadr s))"))
(task-entry (id "parallel/strategies/strategy-transform") (skill parallel) (module strategies) (tier 1) (difficulty 11426) (name strategy-transform) (type "(-> Strategy (-> (List Thunk) Nat Plan))") (description "") (notes ()) (section strategy-type) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name)) (answer "(define (strategy-transform s) (caddr s))"))
(task-entry (id "parallel/strategies/fuel-budget-full") (skill parallel) (module strategies) (tier 1) (difficulty 11427) (name fuel-budget-full) (type "(-> Nat (List Thunk) (List Nat))") (description "Each branch gets the full fuel budget.\nMatches core eval-par semantics where both branches get full fuel.") (notes ()) (section fuel-budgeting) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform)) (answer "(define (fuel-budget-full fuel thunks) (map (lambda (_) fuel) thunks))"))
(task-entry (id "parallel/strategies/fuel-budget-proportional") (skill parallel) (module strategies) (tier 1) (difficulty 11428) (name fuel-budget-proportional) (type "(-> Nat (List Thunk) (List Nat))") (description "Divide fuel proportionally by estimated work.") (notes ()) (section fuel-budgeting) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full)) (answer "(define (fuel-budget-proportional fuel thunks) (let* ((total-work (fold-left + 0 (map thunk-work thunks)))) (if (zero? total-work) (map (lambda (_) fuel) thunks) (map (lambda (t) (max 1 (quotient (* fuel (thunk-work t)) total-work))) thunks))))"))
(task-entry (id "parallel/strategies/strategy/seq") (skill parallel) (module strategies) (tier 1) (difficulty 11429) (name strategy/seq) (type "") (description "") (notes ()) (section core-strategies) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional)) (answer "(define strategy/seq (make-strategy 'seq (lambda (thunks fuel) (plan:seq thunks))))"))
(task-entry (id "parallel/strategies/strategy/par") (skill parallel) (module strategies) (tier 1) (difficulty 11430) (name strategy/par) (type "") (description "") (notes ()) (section core-strategies) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq)) (answer "(define strategy/par (make-strategy 'par (lambda (thunks fuel) (let ((total-work (fold-left + 0 (map thunk-work thunks)))) (if (or (< (length thunks) 2) (< total-work *min-parallel-work*)) (plan:seq thunks) (plan:par thunks))))))"))
(task-entry (id "parallel/strategies/strategy/par-chunk") (skill parallel) (module strategies) (tier 1) (difficulty 11431) (name strategy/par-chunk) (type "(-> Nat Strategy)") (description "Split thunks into chunks of size n, run chunks in parallel.\nWithin each chunk, execution is sequential.") (notes ()) (section core-strategies) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq strategy/par)) (answer "(define (strategy/par-chunk n) (make-strategy 'par-chunk (lambda (thunks fuel) (let ((total-work (fold-left + 0 (map thunk-work thunks)))) (if (or (< (length thunks) 2) (< total-work *min-parallel-work*)) (plan:seq thunks) (plan:chunk n thunks))))))"))
(task-entry (id "parallel/strategies/strategy/par-buffer") (skill parallel) (module strategies) (tier 1) (difficulty 11432) (name strategy/par-buffer) (type "(-> Nat Strategy)") (description "Bounded parallelism: at most max-in-flight thunks executing concurrently.\nProduces chunked plan where chunk-size = max-in-flight.") (notes ()) (section core-strategies) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq strategy/par strategy/par-chunk)) (answer "(define (strategy/par-buffer max-in-flight) (make-strategy 'par-buffer (lambda (thunks fuel) (if (< (length thunks) 2) (plan:seq thunks) (plan:chunk max-in-flight thunks)))))"))
(task-entry (id "parallel/strategies/strategy/speculate") (skill parallel) (module strategies) (tier 1) (difficulty 11433) (name strategy/speculate) (type "(-> Nat Strategy)") (description "Speculative execution: race all thunks with a fuel deadline.\nFirst to complete wins. Fuel IS cancellation — branches that exhaust\ntheir fuel budget suspend naturally.") (notes ()) (section core-strategies) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq strategy/par strategy/par-chunk strategy/par-buffer)) (answer "(define (strategy/speculate deadline) (make-strategy 'speculate (lambda (thunks fuel) (let ((effective-fuel (min fuel deadline))) (plan:race (map (lambda (t) (make-thunk (thunk-id t) (min (thunk-work t) effective-fuel))) thunks))))))"))
(task-entry (id "parallel/strategies/strategy/par-list") (skill parallel) (module strategies) (tier 1) (difficulty 11434) (name strategy/par-list) (type "(-> Strategy Strategy)") (description "Apply strategy s to each element of a thunk list.\nThe resulting plan wraps the inner strategy's output for each thunk.") (notes ()) (section core-strategies) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq strategy/par strategy/par-chunk strategy/par-buffer strategy/speculate)) (answer "(define (strategy/par-list s) (make-strategy 'par-list (lambda (thunks fuel) (let ((inner-transform (strategy-transform s))) (let ((sub-plans (map (lambda (t) (inner-transform (list t) fuel)) thunks))) (if (< (length thunks) 2) (if (null? sub-plans) (plan:seq '()) (car sub-plans)) (plan:tree 'list sub-plans)))))))"))
(task-entry (id "parallel/strategies/strategy-compose") (skill parallel) (module strategies) (tier 1) (difficulty 11435) (name strategy-compose) (type "(-> Strategy Strategy Strategy)") (description "Compose two strategies: apply s1 first, then refine with s2.\nIf s1 produces a tree, s2 is applied to each leaf plan's thunks.") (notes ()) (section combinators) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq strategy/par strategy/par-chunk strategy/par-buffer strategy/speculate strategy/par-list)) (answer "(define (strategy-compose s1 s2) (make-strategy (string->symbol (format \"~a+~a\" (strategy-name s1) (strategy-name s2))) (lambda (thunks fuel) (let ((plan1 ((strategy-transform s1) thunks fuel))) (refine-plan plan1 s2 fuel)))))"))
(task-entry (id "parallel/strategies/collect-plan-thunks") (skill parallel) (module strategies) (tier 1) (difficulty 11436) (name collect-plan-thunks) (type "(-> Plan (List Thunk))") (description "Collect all leaf thunks from a plan, recursing into sub-plans.\nUsed by refine-plan to flatten refined plans back into thunk lists.") (notes ()) (section combinators) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq strategy/par strategy/par-chunk strategy/par-buffer strategy/speculate strategy/par-list strategy-compose)) (answer "(define (collect-plan-thunks plan) (case (plan-type plan) ((plan:seq plan:par plan:race) (plan-thunks plan)) ((plan:chunk) (plan-thunks plan)) ((plan:tree) (apply append (map collect-plan-thunks (plan-sub-plans plan)))) ((plan:pipe) (apply append (map cdr (plan-stages plan)))) (else '())))"))
(task-entry (id "parallel/strategies/refine-plan") (skill parallel) (module strategies) (tier 1) (difficulty 11437) (name refine-plan) (type "(-> Plan Strategy Nat Plan)") (description "Apply strategy s to refine leaf plans within a composite plan.") (notes ()) (section combinators) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq strategy/par strategy/par-chunk strategy/par-buffer strategy/speculate strategy/par-list strategy-compose collect-plan-thunks)) (answer "(define (refine-plan plan s fuel) (let ((transform (strategy-transform s))) (case (plan-type plan) ((plan:seq plan:par plan:race) (transform (plan-thunks plan) fuel)) ((plan:chunk) (transform (plan-thunks plan) fuel)) ((plan:tree) (plan:tree (plan-combiner plan) (map (lambda (sp) (refine-plan sp s fuel)) (plan-sub-plans plan)))) ((plan:pipe) (plan:pipe (map (lambda (stage) (let ((refined (transform (cdr stage) fuel))) (cons (car stage) (collect-plan-thunks refined)))) (plan-stages plan)))) (else plan))))"))
(task-entry (id "parallel/strategies/strategy-when-beneficial") (skill parallel) (module strategies) (tier 1) (difficulty 11438) (name strategy-when-beneficial) (type "(-> Strategy Strategy)") (description "Apply strategy s only when cost analysis indicates parallelization\nis worthwhile. Falls back to sequential otherwise.\nUses *min-parallel-work* and *parallel-overhead* thresholds.") (notes ()) (section combinators) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq strategy/par strategy/par-chunk strategy/par-buffer strategy/speculate strategy/par-list strategy-compose collect-plan-thunks refine-plan)) (answer "(define (strategy-when-beneficial s) (make-strategy (string->symbol (format \"when-beneficial:~a\" (strategy-name s))) (lambda (thunks fuel) (let* ((total-work (fold-left + 0 (map thunk-work thunks))) (n (length thunks)) (overhead (* n *parallel-overhead*)) (min-per-task (quotient *min-parallel-work* 2))) (if (and (>= n 2) (> total-work *min-parallel-work*) (andmap (lambda (t) (> (thunk-work t) min-per-task)) thunks)) ((strategy-transform s) thunks fuel) (plan:seq thunks))))))"))
(task-entry (id "parallel/strategies/using") (skill parallel) (module strategies) (tier 1) (difficulty 11439) (name using) (type "(-> Strategy (List Thunk) Nat Plan)") (description "Main entry point: apply a strategy to thunks with given fuel budget.\nReturns a plan suitable for execution by the boundary layer.") (notes ()) (section main-entry-point) (deps (\x27;prelude \x27;cost-analysis)) (available (make-thunk thunk? thunk-id thunk-work plan:seq plan:par plan:chunk plan:tree plan:race plan:pipe plan? plan-type plan:seq? plan:par? plan:chunk? plan:tree? plan:race? plan:pipe? plan-thunks plan-chunk-size plan-combiner plan-sub-plans plan-stages make-strategy strategy? strategy-name strategy-transform fuel-budget-full fuel-budget-proportional strategy/seq strategy/par strategy/par-chunk strategy/par-buffer strategy/speculate strategy/par-list strategy-compose collect-plan-thunks refine-plan strategy-when-beneficial)) (answer "(define (using strategy thunks fuel) ((strategy-transform strategy) thunks fuel))"))
(task-entry (id "dsl/tagless/make-dict") (skill dsl) (module tagless) (tier 1) (difficulty 11700) (name make-dict) (type "(-> Symbol (List (Pair Symbol Procedure)) Dict)") (description "Create a dictionary with named operations") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available ()) (answer "(define (make-dict tag ops) (cons tag ops))"))
(task-entry (id "dsl/match/make-as-pattern") (skill dsl) (module match) (tier 1) (difficulty 11700) (name make-as-pattern) (type "(-> Symbol Pattern Pattern)") (description "") (notes ()) (section pattern-ast-extended) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available ()) (answer "(define (make-as-pattern name inner) (make-pattern 'as (cons name inner)))"))
(task-entry (id "dsl/partial-eval/bt-static") (skill dsl) (module partial-eval) (tier 1) (difficulty 11700) (name bt-static) (type "BindingTime") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available ()) (answer "(define bt-static 'static)"))
(task-entry (id "dsl/compose/inl") (skill dsl) (module compose) (tier 1) (difficulty 11700) (name inl) (type "(-> (f a) (+ f g a))") (description "Inject into left of coproduct") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available ()) (answer "(define (inl fa) (list 'inl fa))"))
(task-entry (id "dsl/reader/make-readtable") (skill dsl) (module reader) (tier 1) (difficulty 11700) (name make-readtable) (type "(-> Readtable)") (description "Create an empty readtable") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available ()) (answer "(define (make-readtable) (list 'readtable '()))"))
(task-entry (id "dsl/quasi/quasiquote?") (skill dsl) (module quasi) (tier 1) (difficulty 11700) (name quasiquote?) (type "(-> Any Boolean)") (description "") (notes ()) (section quasiquote-detection) (deps (\x27;prelude \x27;combinators)) (available ()) (answer "(define (quasiquote? x) (and (pair? x) (eq? (car x) 'quasiquote) (pair? (cdr x)) (null? (cddr x))))"))
(task-entry (id "dsl/staging/make-code") (skill dsl) (module staging) (tier 1) (difficulty 11700) (name make-code) (type "") (description "") (notes ()) (section code-type-representation) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available ()) (answer "(define (make-code stage expr) (list 'Code stage expr))"))
(task-entry (id "dsl/template/sexpr->string") (skill dsl) (module template) (tier 1) (difficulty 11700) (name sexpr->string) (type "(-> Any String)") (description "Convert any s-expression to a string using write semantics") (notes ()) (section compat-utilities) (deps (\x27;prelude)) (available ()) (answer "(define (sexpr->string obj) (let ((port (open-output-string))) (write obj port) (get-output-string port)))"))
(task-entry (id "dsl/tagless/dict-tag") (skill dsl) (module tagless) (tier 1) (difficulty 11701) (name dict-tag) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict)) (answer "(define (dict-tag d) (car d))"))
(task-entry (id "dsl/match/make-view-pattern") (skill dsl) (module match) (tier 1) (difficulty 11701) (name make-view-pattern) (type "") (description "") (notes ()) (section pattern-ast-extended) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available (make-as-pattern)) (answer "(define (make-view-pattern view-fn inner) (make-pattern 'view (cons view-fn inner)))"))
(task-entry (id "dsl/partial-eval/bt-dynamic") (skill dsl) (module partial-eval) (tier 1) (difficulty 11701) (name bt-dynamic) (type "BindingTime") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static)) (answer "(define bt-dynamic 'dynamic)"))
(task-entry (id "dsl/compose/inr") (skill dsl) (module compose) (tier 1) (difficulty 11701) (name inr) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl)) (answer "(define (inr ga) (list 'inr ga))"))
(task-entry (id "dsl/reader/readtable?") (skill dsl) (module reader) (tier 1) (difficulty 11701) (name readtable?) (type "") (description "") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available (make-readtable)) (answer "(define (readtable? x) (and (pair? x) (eq? (car x) 'readtable)))"))
(task-entry (id "dsl/quasi/unquote?") (skill dsl) (module quasi) (tier 1) (difficulty 11701) (name unquote?) (type "(-> Any Boolean)") (description "") (notes ()) (section quasiquote-detection) (deps (\x27;prelude \x27;combinators)) (available (quasiquote?)) (answer "(define (unquote? x) (and (pair? x) (eq? (car x) 'unquote) (pair? (cdr x)) (null? (cddr x))))"))
(task-entry (id "dsl/staging/code?") (skill dsl) (module staging) (tier 1) (difficulty 11701) (name code?) (type "(-> Any Boolean)") (description "") (notes ()) (section code-type-representation) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code)) (answer "(define (code? x) (and (pair? x) (eq? (car x) 'Code)))"))
(task-entry (id "dsl/template/hole?") (skill dsl) (module template) (tier 1) (difficulty 11701) (name hole?) (type "(-> Any Bool)") (description "Returns #t if x is a hole (symbol starting with $)") (notes ()) (section hole-detection) (deps (\x27;prelude)) (available (sexpr->string)) (answer "(define (hole? x) (and (symbol? x) (let ((s (symbol->string x))) (and (> (string-length s) 1) (char=? (string-ref s 0) #\\$)))))"))
(task-entry (id "dsl/tagless/dict-ops") (skill dsl) (module tagless) (tier 1) (difficulty 11702) (name dict-ops) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag)) (answer "(define (dict-ops d) (cdr d))"))
(task-entry (id "dsl/match/make-active-pattern") (skill dsl) (module match) (tier 1) (difficulty 11702) (name make-active-pattern) (type "") (description "") (notes ()) (section pattern-ast-extended) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available (make-as-pattern make-view-pattern)) (answer "(define (make-active-pattern name args) (make-pattern 'active (cons name args)))"))
(task-entry (id "dsl/partial-eval/bt-bottom") (skill dsl) (module partial-eval) (tier 1) (difficulty 11702) (name bt-bottom) (type "BindingTime") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic)) (answer "(define bt-bottom 'bottom)"))
(task-entry (id "dsl/compose/inl?") (skill dsl) (module compose) (tier 1) (difficulty 11702) (name inl?) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr)) (answer "(define (inl? x) (and (pair? x) (eq? (car x) 'inl)))"))
(task-entry (id "dsl/reader/readtable-entries") (skill dsl) (module reader) (tier 1) (difficulty 11702) (name readtable-entries) (type "") (description "") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available (make-readtable readtable?)) (answer "(define (readtable-entries rt) (if (readtable? rt) (cadr rt) '()))"))
(task-entry (id "dsl/quasi/unquote-splicing?") (skill dsl) (module quasi) (tier 1) (difficulty 11702) (name unquote-splicing?) (type "(-> Any Boolean)") (description "") (notes ()) (section quasiquote-detection) (deps (\x27;prelude \x27;combinators)) (available (quasiquote? unquote?)) (answer "(define (unquote-splicing? x) (and (pair? x) (eq? (car x) 'unquote-splicing) (pair? (cdr x)) (null? (cddr x))))"))
(task-entry (id "dsl/staging/code-stage") (skill dsl) (module staging) (tier 1) (difficulty 11702) (name code-stage) (type "(-> Code Int)") (description "") (notes ()) (section code-type-representation) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code code?)) (answer "(define (code-stage c) (if (code? c) (cadr c) 0))"))
(task-entry (id "dsl/template/hole-name") (skill dsl) (module template) (tier 1) (difficulty 11702) (name hole-name) (type "") (description "") (notes ()) (section hole-detection) (deps (\x27;prelude)) (available (sexpr->string hole?)) (answer "(define (hole-name h) (let ((s (symbol->string h))) (string->symbol (substring s 1 (string-length s)))))"))
(task-entry (id "dsl/tagless/dict-ref") (skill dsl) (module tagless) (tier 1) (difficulty 11703) (name dict-ref) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops)) (answer "(define (dict-ref d name) (let ((pair (assq name (dict-ops d)))) (if pair (cdr pair) (error 'dict-ref \"Operation not found\" name (dict-tag d)))))"))
(task-entry (id "dsl/match/as-pattern?") (skill dsl) (module match) (tier 1) (difficulty 11703) (name as-pattern?) (type "") (description "") (notes ()) (section pattern-ast-extended) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available (make-as-pattern make-view-pattern make-active-pattern)) (answer "(define (as-pattern? p) (eq? (pattern-kind p) 'as))"))
(task-entry (id "dsl/partial-eval/bt?") (skill dsl) (module partial-eval) (tier 1) (difficulty 11703) (name bt?) (type "(-> Any Boolean)") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom)) (answer "(define (bt? x) (memq x '(static dynamic bottom)))"))
(task-entry (id "dsl/compose/inr?") (skill dsl) (module compose) (tier 1) (difficulty 11703) (name inr?) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl?)) (answer "(define (inr? x) (and (pair? x) (eq? (car x) 'inr)))"))
(task-entry (id "dsl/reader/readtable-lookup") (skill dsl) (module reader) (tier 1) (difficulty 11703) (name readtable-lookup) (type "") (description "") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available (make-readtable readtable? readtable-entries)) (answer "(define (readtable-lookup rt char) (let ((entry (assv char (readtable-entries rt)))) (if entry (just (cdr entry)) nothing)))"))
(task-entry (id "dsl/quasi/qq-expand") (skill dsl) (module quasi) (tier 1) (difficulty 11703) (name qq-expand) (type "(-> Sexp Sexp)") (description "Expand a (quasiquote expr) form") (notes ()) (section quasiquote-expansion) (deps (\x27;prelude \x27;combinators)) (available (quasiquote? unquote? unquote-splicing?)) (answer "(define (qq-expand expr) (if (quasiquote? expr) (qq-expand-depth (cadr expr) 1) (error 'qq-expand \"expected quasiquote form\" expr)))"))
(task-entry (id "dsl/staging/code-expr") (skill dsl) (module staging) (tier 1) (difficulty 11703) (name code-expr) (type "(-> Code Sexp)") (description "") (notes ()) (section code-type-representation) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code code? code-stage)) (answer "(define (code-expr c) (if (code? c) (caddr c) c))"))
(task-entry (id "dsl/template/find-holes") (skill dsl) (module template) (tier 1) (difficulty 11703) (name find-holes) (type "") (description "") (notes ()) (section hole-detection) (deps (\x27;prelude)) (available (sexpr->string hole? hole-name)) (answer "(define (find-holes expr) (letrec ((collect (lambda (expr) (cond ((hole? expr) (list expr)) ((pair? expr) (append (collect (car expr)) (collect (cdr expr)))) (else '()))))) (remove-duplicates (collect expr))))"))
(task-entry (id "dsl/tagless/dict-has?") (skill dsl) (module tagless) (tier 1) (difficulty 11704) (name dict-has?) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops dict-ref)) (answer "(define (dict-has? d name) (and (assq name (dict-ops d)) #t))"))
(task-entry (id "dsl/match/view-pattern?") (skill dsl) (module match) (tier 1) (difficulty 11704) (name view-pattern?) (type "") (description "") (notes ()) (section pattern-ast-extended) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available (make-as-pattern make-view-pattern make-active-pattern as-pattern?)) (answer "(define (view-pattern? p) (eq? (pattern-kind p) 'view))"))
(task-entry (id "dsl/partial-eval/bt-join") (skill dsl) (module partial-eval) (tier 1) (difficulty 11704) (name bt-join) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt?)) (answer "(define (bt-join bt1 bt2) (cond ((eq? bt1 bt-bottom) bt2) ((eq? bt2 bt-bottom) bt1) ((or (eq? bt1 bt-dynamic) (eq? bt2 bt-dynamic)) bt-dynamic) (else bt-static)))"))
(task-entry (id "dsl/compose/from-inl") (skill dsl) (module compose) (tier 1) (difficulty 11704) (name from-inl) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr?)) (answer "(define (from-inl x) (cadr x))"))
(task-entry (id "dsl/reader/readtable-extend") (skill dsl) (module reader) (tier 1) (difficulty 11704) (name readtable-extend) (type "") (description "") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available (make-readtable readtable? readtable-entries readtable-lookup)) (answer "(define (readtable-extend rt char macro) (let* ((entries (readtable-entries rt)) (filtered (filter (lambda (e) (not (char=? (car e) char))) entries)) (new-entries (cons (cons char macro) filtered))) (list 'readtable new-entries)))"))
(task-entry (id "dsl/quasi/qq-expand-depth") (skill dsl) (module quasi) (tier 1) (difficulty 11704) (name qq-expand-depth) (type "") (description "") (notes ()) (section quasiquote-expansion) (deps (\x27;prelude \x27;combinators)) (available (quasiquote? unquote? unquote-splicing? qq-expand)) (answer "(define (qq-expand-depth expr depth) (cond ((and (unquote? expr) (= depth 1)) (cadr expr)) ((and (unquote? expr) (> depth 1)) (quasiquote (list 'unquote (unquote (qq-expand-depth (cadr expr) (- depth 1)))))) ((and (unquote-splicing? expr) (= depth 1)) (error 'qq-expand \"unquote-splicing not in list context\" expr)) ((and (unquote-splicing? expr) (> depth 1)) (quasiquote (list 'unquote-splicing (unquote (qq-expand-depth (cadr expr) (- depth 1)))))) ((quasiquote? expr) (quasiquote (list 'quasiquote (unquote (qq-expand-depth (cadr expr) (+ depth 1)))))) ((pair? expr) (qq-expand-pair expr depth)) ((vector? expr) (quasiquote (list->vector (unquote (qq-expand-depth (vector->list expr) depth))))) (else (quasiquote '(unquote expr)))))"))
(task-entry (id "dsl/staging/stage-quote?") (skill dsl) (module staging) (tier 1) (difficulty 11704) (name stage-quote?) (type "(-> Any Boolean)") (description "Check if expression is a staging quote: (stage-quote expr) or <expr>") (notes ()) (section staging-detection) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code code? code-stage code-expr)) (answer "(define (stage-quote? x) (and (pair? x) (or (eq? (car x) 'stage-quote) (eq? (car x) 'bracket) (eq? (car x) '<))))"))
(task-entry (id "dsl/template/holes->string") (skill dsl) (module template) (tier 1) (difficulty 11704) (name holes->string) (type "") (description "") (notes ()) (section hole-detection) (deps (\x27;prelude)) (available (sexpr->string hole? hole-name find-holes)) (answer "(define (holes->string holes) (if (null? holes) \"\" (let loop ((h holes) (acc \"\")) (if (null? h) acc (loop (cdr h) (if (string=? acc \"\") (symbol->string (car h)) (string-append acc \", \" (symbol->string (car h)))))))))"))
(task-entry (id "dsl/tagless/dict-extend") (skill dsl) (module tagless) (tier 1) (difficulty 11705) (name dict-extend) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops dict-ref dict-has?)) (answer "(define (dict-extend d new-ops) (make-dict (dict-tag d) (append new-ops (dict-ops d))))"))
(task-entry (id "dsl/match/active-pattern?") (skill dsl) (module match) (tier 1) (difficulty 11705) (name active-pattern?) (type "") (description "") (notes ()) (section pattern-ast-extended) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available (make-as-pattern make-view-pattern make-active-pattern as-pattern? view-pattern?)) (answer "(define (active-pattern? p) (eq? (pattern-kind p) 'active))"))
(task-entry (id "dsl/partial-eval/bt-meet") (skill dsl) (module partial-eval) (tier 1) (difficulty 11705) (name bt-meet) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt? bt-join)) (answer "(define (bt-meet bt1 bt2) (cond ((eq? bt1 bt-bottom) bt-bottom) ((eq? bt2 bt-bottom) bt-bottom) ((and (eq? bt1 bt-static) (eq? bt2 bt-static)) bt-static) (else bt-dynamic)))"))
(task-entry (id "dsl/compose/from-inr") (skill dsl) (module compose) (tier 1) (difficulty 11705) (name from-inr) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl)) (answer "(define (from-inr x) (cadr x))"))
(task-entry (id "dsl/reader/readtable-remove") (skill dsl) (module reader) (tier 1) (difficulty 11705) (name readtable-remove) (type "") (description "") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available (make-readtable readtable? readtable-entries readtable-lookup readtable-extend)) (answer "(define (readtable-remove rt char) (let* ((entries (readtable-entries rt)) (filtered (filter (lambda (e) (not (char=? (car e) char))) entries))) (list 'readtable filtered)))"))
(task-entry (id "dsl/quasi/qq-expand-pair") (skill dsl) (module quasi) (tier 1) (difficulty 11705) (name qq-expand-pair) (type "") (description "") (notes ()) (section quasiquote-expansion) (deps (\x27;prelude \x27;combinators)) (available (quasiquote? unquote? unquote-splicing? qq-expand qq-expand-depth)) (answer "(define (qq-expand-pair expr depth) (let ((head (car expr)) (tail (cdr expr))) (cond ((and (unquote? head) (= depth 1)) (if (null? tail) (cadr head) (quasiquote (cons (unquote (cadr head)) (unquote (qq-expand-depth tail depth)))))) ((and (unquote-splicing? head) (= depth 1)) (if (null? tail) (cadr head) (quasiquote (append (unquote (cadr head)) (unquote (qq-expand-depth tail depth)))))) ((and (unquote? tail) (= depth 1)) (quasiquote (cons (unquote (qq-expand-depth head depth)) (unquote (cadr tail))))) ((null? tail) (quasiquote (list (unquote (qq-expand-depth head depth))))) ((pair? tail) (qq-expand-list expr depth)) (else (quasiquote (cons (unquote (qq-expand-depth head depth)) (unquote (qq-expand-depth tail depth))))))))"))
(task-entry (id "dsl/staging/stage-splice?") (skill dsl) (module staging) (tier 1) (difficulty 11705) (name stage-splice?) (type "") (description "") (notes ()) (section staging-detection) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code code? code-stage code-expr stage-quote?)) (answer "(define (stage-splice? x) (and (pair? x) (or (eq? (car x) 'stage-splice) (eq? (car x) 'escape) (eq? (car x) '~))))"))
(task-entry (id "dsl/template/new-template") (skill dsl) (module template) (tier 1) (difficulty 11705) (name new-template) (type "") (description "") (notes ()) (section hole-detection) (deps (\x27;prelude)) (available (sexpr->string hole? hole-name find-holes holes->string)) (answer "(define (new-template expr) (make-template expr (find-holes expr)))"))
(task-entry (id "dsl/tagless/dict-merge") (skill dsl) (module tagless) (tier 1) (difficulty 11706) (name dict-merge) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops dict-ref dict-has? dict-extend)) (answer "(define (dict-merge d1 d2) (make-dict (list (dict-tag d1) (dict-tag d2)) (append (dict-ops d2) (dict-ops d1))))"))
(task-entry (id "dsl/match/as-pattern-name") (skill dsl) (module match) (tier 1) (difficulty 11706) (name as-pattern-name) (type "") (description "") (notes ()) (section pattern-ast-extended) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available (make-as-pattern make-view-pattern make-active-pattern as-pattern? view-pattern? active-pattern?)) (answer "(define (as-pattern-name p) (car (pattern-data p)))"))
(task-entry (id "dsl/partial-eval/bt<=?") (skill dsl) (module partial-eval) (tier 1) (difficulty 11706) (name bt<=?) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt? bt-join bt-meet)) (answer "(define (bt<=? bt1 bt2) (cond ((eq? bt1 bt-bottom) #t) ((eq? bt2 bt-bottom) #f) ((eq? bt1 bt-static) #t) ((eq? bt2 bt-dynamic) #t) (else #f)))"))
(task-entry (id "dsl/compose/coproduct-fmap") (skill dsl) (module compose) (tier 1) (difficulty 11706) (name coproduct-fmap) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr)) (answer "(define (coproduct-fmap f fmap-f fmap-g fg) (if (inl? fg) (inl (fmap-f f (from-inl fg))) (inr (fmap-g f (from-inr fg)))))"))
(task-entry (id "dsl/reader/make-readtable-stack") (skill dsl) (module reader) (tier 1) (difficulty 11706) (name make-readtable-stack) (type "") (description "") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available (make-readtable readtable? readtable-entries readtable-lookup readtable-extend readtable-remove)) (answer "(define (make-readtable-stack) (list (make-readtable)))"))
(task-entry (id "dsl/quasi/qq-expand-list") (skill dsl) (module quasi) (tier 1) (difficulty 11706) (name qq-expand-list) (type "") (description "") (notes ()) (section quasiquote-expansion) (deps (\x27;prelude \x27;combinators)) (available (quasiquote? unquote? unquote-splicing? qq-expand qq-expand-depth qq-expand-pair)) (answer "(define (qq-expand-list lst depth) (let ((segments (qq-collect-segments lst depth))) (cond ((and (= (length segments) 1) (pair? (car segments)) (eq? (caar segments) 'list)) (car segments)) ((and (= (length segments) 1) (pair? (car segments)) (eq? (caar segments) 'splice)) (cadar segments)) ((and (pair? segments) (pair? (car (reverse segments))) (eq? (caar (reverse segments)) 'improper-tail)) (let* ((rev-segs (reverse segments)) (tail-expr (cadar rev-segs)) (head-segs (reverse (cdr rev-segs))) (head-args (map (lambda (seg) (if (and (pair? seg) (eq? (car seg) 'splice)) (cadr seg) seg)) head-segs))) (if (null? head-args) tail-expr (quasiquote (cons* (unquote-splicing head-args) (unquote tail-expr)))))) (else (let ((args (map (lambda (seg) (if (and (pair? seg) (eq? (car seg) 'splice)) (cadr seg) seg)) segments))) (quasiquote (append (unquote-splicing args))))))))"))
(task-entry (id "dsl/staging/stage-run?") (skill dsl) (module staging) (tier 1) (difficulty 11706) (name stage-run?) (type "") (description "") (notes ()) (section staging-detection) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code code? code-stage code-expr stage-quote? stage-splice?)) (answer "(define (stage-run? x) (and (pair? x) (or (eq? (car x) 'stage-run) (eq? (car x) 'run) (eq? (car x) '!))))"))
(task-entry (id "dsl/template/template-complete?") (skill dsl) (module template) (tier 1) (difficulty 11706) (name template-complete?) (type "") (description "") (notes ()) (section hole-detection) (deps (\x27;prelude)) (available (sexpr->string hole? hole-name find-holes holes->string new-template)) (answer "(define (template-complete? t) (null? (template-holes t)))"))
(task-entry (id "dsl/tagless/make-expr-dict") (skill dsl) (module tagless) (tier 1) (difficulty 11707) (name make-expr-dict) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops dict-ref dict-has? dict-extend dict-merge)) (answer "(define (make-expr-dict lit add neg) (make-dict 'expr (quasiquote ((lit unquote lit) (add unquote add) (neg unquote neg)))))"))
(task-entry (id "dsl/match/as-pattern-inner") (skill dsl) (module match) (tier 1) (difficulty 11707) (name as-pattern-inner) (type "") (description "") (notes ()) (section pattern-ast-extended) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available (make-as-pattern make-view-pattern make-active-pattern as-pattern? view-pattern? active-pattern? as-pattern-name)) (answer "(define (as-pattern-inner p) (cdr (pattern-data p)))"))
(task-entry (id "dsl/partial-eval/make-bt-env") (skill dsl) (module partial-eval) (tier 1) (difficulty 11707) (name make-bt-env) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt? bt-join bt-meet bt<=?)) (answer "(define (make-bt-env) '())"))
(task-entry (id "dsl/compose/make-coproduct-fmap") (skill dsl) (module compose) (tier 1) (difficulty 11707) (name make-coproduct-fmap) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap)) (answer "(define (make-coproduct-fmap fmap-f fmap-g) (lambda (f fg) (if (inl? fg) (inl (fmap-f f (from-inl fg))) (inr (fmap-g f (from-inr fg))))))"))
(task-entry (id "dsl/reader/readtable-stack?") (skill dsl) (module reader) (tier 1) (difficulty 11707) (name readtable-stack?) (type "") (description "") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available (make-readtable readtable? readtable-entries readtable-lookup readtable-extend readtable-remove make-readtable-stack)) (answer "(define (readtable-stack? x) (and (pair? x) (andmap readtable? x)))"))
(task-entry (id "dsl/quasi/qq-collect-segments") (skill dsl) (module quasi) (tier 1) (difficulty 11707) (name qq-collect-segments) (type "") (description "") (notes ()) (section quasiquote-expansion) (deps (\x27;prelude \x27;combinators)) (available (quasiquote? unquote? unquote-splicing? qq-expand qq-expand-depth qq-expand-pair qq-expand-list)) (answer "(define (qq-collect-segments lst depth) (let loop ((remaining lst) (current-list '()) (segments '())) (cond ((null? remaining) (if (null? current-list) (reverse segments) (reverse (cons (quasiquote (list (unquote-splicing (reverse current-list)))) segments)))) ((not (pair? remaining)) (let ((segs (if (null? current-list) segments (cons (quasiquote (list (unquote-splicing (reverse current-list)))) segments)))) (reverse (cons (quasiquote (improper-tail (unquote (qq-expand-depth remaining depth)))) segs)))) ((and (unquote-splicing? (car remaining)) (= depth 1)) (let ((segs (if (null? current-list) segments (cons (quasiquote (list (unquote-splicing (reverse current-list)))) segments)))) (loop (cdr remaining) '() (cons (quasiquote (splice (unquote (cadar remaining)))) segs)))) (else (loop (cdr remaining) (cons (qq-expand-depth (car remaining) depth) current-list) segments)))))"))
