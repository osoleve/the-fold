(task-entry (id "statistics/diagnostics/vif") (skill statistics) (module diagnostics) (tier 1) (difficulty 11210) (name vif) (type "(-> Matrix Vec)") (description "Variance Inflation Factor for each predictor") (notes ("VIF_j = 1 / (1 - R²_j) where R²_j is the R² from regressing x_j on other predictors" "VIF > 10 indicates serious multicollinearity" "Assumes intercept is NOT in X (or is first column to be skipped)")) (section collinearity-diagnostics) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers)) (available (hat-matrix hat-matrix-diagonal residuals-raw residuals-standardized residuals-studentized residuals-studentized-external cooks-distance cooks-distance-threshold dffits dffits-threshold)) (answer "(define (vif X) (let* ((n (matrix-cols X)) (vifs (make-vector n))) (do ((j 0 (+ j 1))) ((= j n) vifs) (let* ((r2j (r-squared-predictor X j))) (vector-set! vifs j (/ 1 (max (- 1 r2j) 1e-10))))) vifs))"))
(task-entry (id "statistics/linear/weighted-diagnostics") (skill statistics) (module linear) (tier 1) (difficulty 11210) (name weighted-diagnostics) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit linear-model-compute-diagnostics compute-coefficient-se compute-t-values compute-p-values compute-r-squared compute-adj-r-squared weighted-linear-fit weight-matrix weight-vector)) (answer "(define (weighted-diagnostics X y beta weights n p) (let* ((fitted (matrix-vec-mul X beta)) (residuals (residuals-raw y fitted)) (sse (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (* (vector-ref weights i) (expt (vector-ref residuals i) 2))))))) (df-residual (- n p)) (mse (if (> df-residual 0) (/ sse df-residual) 0)) (sigma (sqrt mse)) (se (compute-weighted-se X weights mse)) (t-values (if (or (not se) (and (pair? se) (eq? (car se) 'error))) (make-vector p 0) (compute-t-values beta se))) (p-values (compute-p-values t-values df-residual)) (y-bar-w (/ (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (* (vector-ref weights i) (vector-ref y i)))))) (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (vector-ref weights i))))))) (sst-w (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (* (vector-ref weights i) (expt (- (vector-ref y i) y-bar-w) 2))))))) (r-squared (if (< sst-w 1e-10) 0 (- 1 (/ sse sst-w)))) (adj-r-squared (compute-adj-r-squared r-squared n p))) (make-linear-model-result beta se t-values p-values r-squared adj-r-squared residuals fitted sse mse n p)))"))
(task-entry (id "statistics/regularized/elastic-net-coordinate-descent") (skill statistics) (module regularized) (tier 1) (difficulty 11210) (name elastic-net-coordinate-descent) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics compute-r-squared-ridge lasso-fit lasso-coordinate-descent lasso-partial-residual soft-threshold lasso-finalize count-nonzero elastic-net-fit)) (answer "(define (elastic-net-coordinate-descent X y beta lambda alpha n p max-iter tol) (let* ((col-norms (make-vector p))) (do ((j 0 (+ j 1))) ((= j p)) (let ((norm-sq (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (expt (matrix-ref X i j) 2))))))) (vector-set! col-norms j norm-sq))) (let loop ((iter 0)) (if (>= iter max-iter) (lasso-finalize X y beta n p) (let* ((max-change 0)) (do ((j 0 (+ j 1))) ((= j p)) (let* ((old-beta-j (vector-ref beta j)) (rho (lasso-partial-residual X y beta j n)) (norm-sq (vector-ref col-norms j)) (l1-penalty (* lambda alpha n)) (l2-penalty (* lambda (- 1 alpha) n)) (new-beta-j (elastic-net-update rho l1-penalty l2-penalty norm-sq))) (vector-set! beta j new-beta-j) (set! max-change (max max-change (abs (- new-beta-j old-beta-j)))))) (if (< max-change tol) (lasso-finalize X y beta n p) (loop (+ iter 1))))))))"))
(task-entry (id "statistics/glm/logistic-fit") (skill statistics) (module glm) (tier 1) (difficulty 11210) (name logistic-fit) (type "") (description "") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available (glm-fit irls-loop irls-step weighted-least-squares irls-converged? irls-finalize compute-glm-se compute-z-values compute-z-pvalues compute-deviance-residuals)) (answer "(define (logistic-fit X y . opts) (apply glm-fit binomial-family logit-link X y opts))"))
(task-entry (id "statistics/families/gamma-family") (skill statistics) (module families) (tier 1) (difficulty 11210) (name gamma-family) (type "") (description "") (notes ()) (section family-structure) (deps (\x27;prelude \x27;transcendental)) (available (make-glm-family glm-family? family-name family-variance family-deviance-contrib family-valid-mu? family-initialize gaussian-family binomial-family poisson-family)) (answer "(define gamma-family (make-glm-family 'gamma (lambda (mu) (* mu mu)) (lambda (y mu) (let* ((mu-safe (max mu 1e-10)) (y-safe (max y 1e-10))) (* 2 (- (/ (- y-safe mu-safe) mu-safe) (log (/ y-safe mu-safe)))))) (lambda (mu) (> mu 0)) (lambda (y) (max y 0.001))))"))
(task-entry (id "statistics/link-functions/probit-quantile") (skill statistics) (module link-functions) (tier 1) (difficulty 11210) (name probit-quantile) (type "") (description "") (notes ()) (section link-function-structure) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available (make-link-function link-function? link-name link-g link-inverse link-derivative identity-link logit-link log-link probit-link)) (answer "(define (probit-quantile p) (if (or (<= p 0) (>= p 1)) (error 'probit-quantile \"p must be in (0, 1)\" p) (let* ((a0 2.515517) (a1 0.802853) (a2 0.010328) (b1 1.432788) (b2 0.189269) (b3 0.001308) (sign (if (< p 0.5) -1 1)) (p* (if (< p 0.5) p (- 1 p))) (t (sqrt (* -2 (log p*)))) (num (+ a0 (* a1 t) (* a2 t t))) (den (+ 1 (* b1 t) (* b2 t t) (* b3 t t t)))) (* sign (- t (/ num den))))))"))
(task-entry (id "statistics/distributions/newton-raphson-quantile") (skill statistics) (module distributions) (tier 1) (difficulty 11210) (name newton-raphson-quantile) (type "") (description "") (notes ()) (section student-t-distribution) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available (t-cdf t-quantile t-pdf standard-normal-quantile chi-squared-cdf chi-squared-quantile chi-squared-pdf f-cdf f-quantile f-pdf)) (answer "(define (newton-raphson-quantile cdf pdf p x0 max-iter tol) (let loop ((x x0) (iter 0)) (if (>= iter max-iter) x (let* ((fx (- (cdf x) p)) (fpx (pdf x))) (if (< (abs fpx) 1e-15) x (let* ((dx (/ fx fpx)) (x-new (- x dx))) (let ((x-new (max x-new 1e-10))) (if (< (abs dx) tol) x-new (loop x-new (+ iter 1))))))))))"))
(task-entry (id "statistics/differencing/log-transform") (skill statistics) (module differencing) (tier 1) (difficulty 11210) (name log-transform) (type "") (description "") (notes ()) (section simple-differencing) (deps (\x27;prelude)) (available (vec-diff difference lag-diff seasonal-difference integrate integrate-from-last integrate-d is-stationary? vec-variance-simple subvec)) (answer "(define (log-transform xs) (let* ((n (vector-length xs)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (log (max (vector-ref xs i) 1e-10))))))"))
(task-entry (id "statistics/acf-pacf/standard-normal-quantile") (skill statistics) (module acf-pacf) (tier 1) (difficulty 11210) (name standard-normal-quantile) (type "") (description "") (notes ()) (section autocovariance-and-autocorrelation) (deps (\x27;prelude \x27;summary-stats \x27;stat/distributions)) (available (autocovariance acf acf-standard-error acf-confidence-bounds pacf durbin-levinson ljung-box-test box-pierce-test ccf cross-covariance)) (answer "(define (standard-normal-quantile p) (if (or (<= p 0) (>= p 1)) (error 'standard-normal-quantile \"p must be in (0, 1)\" p) (let* ((a0 2.515517) (a1 0.802853) (a2 0.010328) (b1 1.432788) (b2 0.189269) (b3 0.001308) (sign (if (< p 0.5) -1 1)) (p* (if (< p 0.5) p (- 1 p))) (t (sqrt (* -2 (log p*)))) (num (+ a0 (* a1 t) (* a2 t t))) (den (+ 1 (* b1 t) (* b2 t t) (* b3 t t t)))) (* sign (- t (/ num den))))))"))
(task-entry (id "statistics/ar/standard-normal-quantile") (skill statistics) (module ar) (tier 1) (difficulty 11210) (name standard-normal-quantile) (type "") (description "") (notes ()) (section ar-model-fitting) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (ar-fit center-series make-toeplitz-matrix ar-compute-diagnostics ar-predict-one ar-forecast ar-forecast-se ar-aic-value ar-select-order ar-bic)) (answer "(define (standard-normal-quantile p) (if (or (<= p 0) (>= p 1)) (error 'standard-normal-quantile \"p must be in (0, 1)\" p) (let* ((a0 2.515517) (a1 0.802853) (a2 0.010328) (b1 1.432788) (b2 0.189269) (b3 0.001308) (sign (if (< p 0.5) -1 1)) (p* (if (< p 0.5) p (- 1 p))) (t (sqrt (* -2 (log p*)))) (num (+ a0 (* a1 t) (* a2 t t))) (den (+ 1 (* b1 t) (* b2 t t) (* b3 t t t)))) (* sign (- t (/ num den))))))"))
(task-entry (id "statistics/ar-poly/ar-stable-simple?") (skill statistics) (module ar-poly) (tier 1) (difficulty 11210) (name ar-stable-simple?) (type "") (description "") (notes ()) (section rational-field-for-exact-coefficient-arithmetic) (deps (\x27;field \x27;algebra/polynomial)) (available (Q-field-ts ar-char-poly-vec ar-char-poly ar-companion-poly ma-char-poly arma-common-factors arma-reducible? arma-reduce algebra-poly->ar-coeffs algebra-poly->ma-coeffs)) (answer "(define (ar-stable-simple? phi) (let ((p (vector-length phi))) (cond ((= p 0) #t) ((= p 1) (< (abs (vector-ref phi 0)) 1)) ((= p 2) (let ((phi1 (vector-ref phi 0)) (phi2 (vector-ref phi 1))) (and (< (+ phi1 phi2) 1) (< (- phi2 phi1) 1) (< (abs phi2) 1)))) (else #f))))"))
