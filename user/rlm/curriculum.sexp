(task-entry (id "physics/classical/rigid-body/rigid-body-velocity-at") (skill physics/classical) (module rigid-body) (tier 2) (difficulty 23525) (name rigid-body-velocity-at) (type "") (description "") (notes ()) (section velocity) (deps (\x27;prelude \x27;vec2)) (available (make-rigid-body rigid-body? rigid-body-pos rigid-body-vel rigid-body-angle rigid-body-angular-vel rigid-body-mass rigid-body-inv-mass rigid-body-inertia rigid-body-inv-inertia rigid-body-static? rigid-body-with-pos rigid-body-with-vel rigid-body-with-angle rigid-body-with-angular-vel rigid-body-with-mass rigid-body-with-inertia rigid-body-with-state make-static-rigid-body circle-inertia rectangle-inertia rod-inertia point-mass-inertia local-to-world world-to-local)) (answer "(define (rigid-body-velocity-at body world-point) (let* ((pos (rigid-body-pos body)) (vel (rigid-body-vel body)) (omega (rigid-body-angular-vel body)) (r (vec2-sub world-point pos)) (tangent-vel (vec2-scale (vec2-perp r) omega))) (vec2-add vel tangent-vel)))"))
