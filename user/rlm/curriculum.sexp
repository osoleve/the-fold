(task-entry (id "control-systems/hinf-synthesis/hinf-synthesis-info") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22650) (name hinf-synthesis-info) (type "→ String") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm ss->tf ss-numerator-poly ss-eval-complex matrix-scale-complex matrix-sub-scalar-diag matrix-inverse-complex matrix-mul-complex matrix-ref-complex poly-eval-complex poly-from-complex-samples ipow-real ipow-imag complex-mul complex-add)) (answer "(define (hinf-synthesis-info) \"H-infinity Synthesis Module:\n   - hinf-synthesize: Main entry point for mixed-sensitivity design\n   - hinf-weight-first-order: Create shaping filters\n   - hinf-closed-loop-norm: Verify achieved performance\n\n   Example workflow:\n   1. Define plant G as state-space\n   2. Choose weighting functions W1 (sensitivity) and W3 (comp-sensitivity)\n   3. Call (hinf-synthesize G W1 W3)\n   4. Verify with (hinf-closed-loop-norm G K)\")"))
