(task-entry (id "dataset/jsonl/sample->json") (skill dataset) (module jsonl) (tier 1) (difficulty 13406) (name sample->json) (type "") (description "") (notes ()) (section conversion) (deps (core/base/prelude.ss lattice/optics/optics.ss lattice/dataset/sample.ss)) (available (make-json-object json-object? json-object-pairs make-json-array json-array? json-array-items)) (answer "(define (sample->json s) (make-json-object (quasiquote ((\"id\" unquote (sample-id s)) (\"frames\" unquote (make-json-array (sample-frames s))) (\"question\" unquote (sample-question s)) (\"options\" unquote (make-json-object (map (lambda (opt) (cons (symbol->string (car opt)) (cdr opt))) (sample-options s)))) (\"answer\" unquote (symbol->string (sample-answer s))) (\"metadata\" unquote (make-json-object (map (lambda (m) (cons (symbol->string (car m)) (value->json (cdr m)))) (sample-metadata s))))))))"))
