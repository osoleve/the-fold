(task-entry (id "autodiff/profiling/graph-stats") (skill autodiff) (module profiling) (tier 1) (difficulty 12703) (name graph-stats) (type "") (description "") (notes ()) (section tape-statistics) (deps (\x27;prelude \x27;comp-graph \x27;reverse-diff \x27;sort)) (available (tape-stats tape-size tape-op-count)) (answer "(define (graph-stats g) (let* ((nodes (comp-graph-nodes g)) (node-count (length nodes)) (edge-count (graph-edge-count g)) (depth (graph-depth g)) (var-names (graph-variables g)) (op-types (graph-operations g))) (list (cons 'nodes node-count) (cons 'edges edge-count) (cons 'depth depth) (cons 'variables var-names) (cons 'op-distribution (tally-ops op-types)))))"))
