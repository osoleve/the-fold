(task-entry (id "statistics/ar/ar-compute-diagnostics") (skill statistics) (module ar) (tier 1) (difficulty 11203) (name ar-compute-diagnostics) (type "") (description "") (notes ()) (section ar-model-fitting) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (ar-fit center-series make-toeplitz-matrix)) (answer "(define (ar-compute-diagnostics xs centered phi mean p n) (let* ((fitted (make-vector n 0)) (residuals (make-vector n 0)) (_ (do ((t 0 (+ t 1))) ((= t p)) (vector-set! fitted t (vector-ref xs t)) (vector-set! residuals t 0))) (_ (do ((t p (+ t 1))) ((= t n)) (let ((pred (+ mean (ar-predict-one centered phi t p)))) (vector-set! fitted t pred) (vector-set! residuals t (- (vector-ref xs t) pred))))) (sse (let loop ((t p) (s 0)) (if (= t n) s (loop (+ t 1) (+ s (expt (vector-ref residuals t) 2)))))) (sigma (sqrt (/ sse (max (- n p) 1)))) (aic (ar-aic-value xs phi sigma p n))) (make-ar-result phi mean residuals fitted sigma aic p)))"))
