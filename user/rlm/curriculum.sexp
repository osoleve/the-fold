(task-entry (id "geometry/octree/octree-build") (skill geometry) (module octree) (tier 1) (difficulty 12208) (name octree-build) (type "(-> (List Triangle3) Point3 Number Number Number Octree)") (description "Build an octree from triangles") (notes ()) (section octree-construction) (deps (\x27;prelude \x27;geometry)) (available (octree-leaf octree-node octree-leaf? octree-node? octree-center octree-size octree-primitives octree-children)) (answer "(define (octree-build triangles center size max-depth max-leaf-size) (let build-recursive ((tris triangles) (ctr center) (sz size) (depth 0)) (cond ((or (>= depth max-depth) (<= (length tris) max-leaf-size)) (octree-leaf ctr sz tris)) (else (let* ((half-size (* sz 0.5)) (octants (subdivide-octants ctr sz)) (tri-sets (partition-triangles-octants tris octants)) (children (map (lambda (octant tri-set) (let ((oct-center (car octant))) (build-recursive tri-set oct-center half-size (+ depth 1)))) octants tri-sets))) (let ((total (apply + (map (lambda (c) (length (octree-primitives c))) children)))) (if (>= total (* 8 (length tris))) (octree-leaf ctr sz tris) (octree-node ctr sz (list->vector children)))))))))"))
(task-entry (id "geometry/bvh/triangle-centroid") (skill geometry) (module bvh) (tier 1) (difficulty 12208) (name triangle-centroid) (type "(-> Triangle3 Point3)") (description "") (notes ()) (section helpers) (deps (\x27;prelude \x27;geometry \x27;sort)) (available (bvh-leaf bvh-node bvh-leaf? bvh-node? bvh-bbox bvh-primitives bvh-left bvh-right)) (answer "(define (triangle-centroid tri) (let ((p1 (triangle3-p1 tri)) (p2 (triangle3-p2 tri)) (p3 (triangle3-p3 tri))) (vec3-scale (vec3-add (vec3-add p1 p2) p3) (/ 1.0 3.0))))"))
