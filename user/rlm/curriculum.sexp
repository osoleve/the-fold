(task-entry (id "physics/classical/integrators/substep-body") (skill physics/classical) (module integrators) (tier 2) (difficulty 23527) (name substep-body) (type "") (description "") (notes ()) (section sub-stepping) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet integrate-body-rk4 make-time-acc time-acc? time-acc-remaining time-acc-fixed-dt time-acc-max-steps time-acc-add time-acc-consume time-acc-alpha)) (answer "(define (substep-body body force-fn dt n method) (let ((sub-dt (/ dt n))) (let loop ((b body) (i 0)) (if (>= i n) b (let ((new-b (case method ((euler) (integrate-body-euler b force-fn sub-dt)) ((symplectic) (integrate-body-symplectic b force-fn sub-dt)) ((verlet) (integrate-body-verlet b force-fn sub-dt)) (else (integrate-body-symplectic b force-fn sub-dt))))) (loop new-b (+ i 1)))))))"))
