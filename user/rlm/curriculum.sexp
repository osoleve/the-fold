(task-entry (id "physics/diff3d/traced-quaternion/traced-quat-to-rotation-matrix") (skill physics/diff3d) (module traced-quaternion) (tier 2) (difficulty 23034) (name traced-quat-to-rotation-matrix) (type "") (description "") (notes ()) (section construction) (deps (\x27;prelude \x27;quaternion \x27;traced-vec3)) (available (traced-quat traced-quat? traced-quat-w traced-quat-x traced-quat-y traced-quat-z traced-quat-identity lift-quat lift-quat-const unpack-traced-quat traced-quat->list traced-quat-vector traced-quat-add traced-quat-sub traced-quat-neg traced-quat-scale traced-quat-scale-inv traced-quat-mul traced-quat-dot traced-quat-magnitude-sq traced-quat-magnitude traced-quat-smooth-magnitude traced-quat-normalize traced-quat-smooth-normalize traced-quat-conjugate traced-quat-inverse traced-quat-smooth-inverse traced-quat-rotate-vec3 traced-quat-rotate-vec3-inverse traced-quat-derivative traced-quat-integrate traced-quat-integrate-body traced-quat-lerp traced-quat-nlerp)) (answer "(define (traced-quat-to-rotation-matrix q) (let* ((w (traced-quat-w q)) (x (traced-quat-x q)) (y (traced-quat-y q)) (z (traced-quat-z q)) (x2 (traced-mul x x)) (y2 (traced-mul y y)) (z2 (traced-mul z z)) (xy (traced-mul x y)) (xz (traced-mul x z)) (yz (traced-mul y z)) (wx (traced-mul w x)) (wy (traced-mul w y)) (wz (traced-mul w z)) (r00 (traced-sub 1 (traced-mul 2 (traced-add y2 z2)))) (r01 (traced-mul 2 (traced-sub xy wz))) (r02 (traced-mul 2 (traced-add xz wy))) (r10 (traced-mul 2 (traced-add xy wz))) (r11 (traced-sub 1 (traced-mul 2 (traced-add x2 z2)))) (r12 (traced-mul 2 (traced-sub yz wx))) (r20 (traced-mul 2 (traced-sub xz wy))) (r21 (traced-mul 2 (traced-add yz wx))) (r22 (traced-sub 1 (traced-mul 2 (traced-add x2 y2))))) (list (list r00 r01 r02) (list r10 r11 r12) (list r20 r21 r22))))"))
