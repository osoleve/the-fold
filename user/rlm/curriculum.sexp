(task-entry (id "fp/generic-zipper/type-simplify") (skill fp) (module generic-zipper) (tier 1) (difficulty 10626) (name type-simplify) (type "(-> Type Type)") (description "Simplify type expressions by eliminating 0s and 1s.") (notes ()) (section type-simplification) (deps (\x27;prelude \x27;combinators)) (available (type-zero type-one type-zero? type-one? type-var type-var? type-var-name type-sum type-sum? type-sum-components type-prod type-prod? type-prod-components type-rec type-rec? type-rec-var type-rec-body type-list type-maybe type-pair type-either type-rose-tree type-binary-tree type-deriv type-deriv-prod type-subst)) (answer "(define (type-simplify t) (cond ((or (type-zero? t) (type-one? t)) t) ((type-var? t) t) ((type-sum? t) (let* ((simplified (map type-simplify (type-sum-components t))) (non-zero (filter (lambda (c) (not (type-zero? c))) simplified))) (cond ((null? non-zero) type-zero) ((null? (cdr non-zero)) (car non-zero)) (else (apply type-sum non-zero))))) ((type-prod? t) (let* ((simplified (map type-simplify (type-prod-components t))) (has-zero (any type-zero? simplified)) (non-one (filter (lambda (c) (not (type-one? c))) simplified))) (cond (has-zero type-zero) ((null? non-one) type-one) ((null? (cdr non-one)) (car non-one)) (else (apply type-prod non-one))))) ((type-rec? t) (type-rec (type-rec-var t) (type-simplify (type-rec-body t)))) (else t)))"))
(task-entry (id "fp/zipper-lens/follow-path") (skill fp) (module zipper-lens) (tier 1) (difficulty 10626) (name follow-path) (type "(-> (List (Affine s s)) s (Maybe s))") (description "Follow a path of navigation affines to create a lens. Returns nothing if any step fails") (notes ()) (section zipper-to-lens-adapter) (deps (\x27;prelude \x27;combinators \x27;templates \x27;zipper \x27;tree-zipper)) (available (zipper-focus-lens zipper-focus-maybe-lens zipper-left-lens zipper-right-lens zipper-position-lens tree-zipper-focus-lens tree-zipper-value-lens tree-zipper-children-lens tree-zipper-crumbs-lens tree-zipper-depth-lens make-affine affine? affine-getter affine-setter preview-affine set-affine over-affine zipper-left-affine zipper-right-affine zipper-nth-affine tree-up-affine tree-down-affine tree-left-affine tree-right-affine tree-nth-child-affine tree-child-value-affine)) (answer "(define (follow-path affines z) (let loop ((remaining affines) (current z)) (if (null? remaining) (just current) (let ((result (preview-affine (car remaining) current))) (if (nothing? result) nothing (loop (cdr remaining) (from-just result)))))))"))
