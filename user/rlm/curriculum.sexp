(task-entry (id "random/variational-inference/adam-update") (skill random) (module variational-inference) (tier 1) (difficulty 12948) (name adam-update) (type "") (description "") (notes ()) (section adam-optimizer-for-vi) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf vi-step-mf make-adam-state adam-state? adam-state-m adam-state-v adam-state-t)) (answer "(define (adam-update state grads lr beta1 beta2 epsilon) (let* ((m (adam-state-m state)) (v (adam-state-v state)) (t (adam-state-t state)) (new-m (map (lambda (mi gi) (+ (* beta1 mi) (* (- 1 beta1) gi))) m grads)) (new-v (map (lambda (vi gi) (+ (* beta2 vi) (* (- 1 beta2) (* gi gi)))) v grads)) (m-hat (map (lambda (mi) (/ mi (- 1 (expt beta1 t)))) new-m)) (v-hat (map (lambda (vi) (/ vi (- 1 (expt beta2 t)))) new-v)) (deltas (map (lambda (mh vh) (* lr (/ mh (+ (sqrt vh) epsilon)))) m-hat v-hat)) (new-state (list 'adam-state new-m new-v (+ t 1)))) (values new-state deltas)))"))
(task-entry (id "random/prng/split-on-whitespace") (skill random) (module prng) (tier 1) (difficulty 12949) (name split-on-whitespace) (type "") (description "") (notes ()) (section generator-serialization-for-resumable-sessions) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float random-float-range random-int-range random-bool random-element shuffle sample weighted-choice random-list random-vector with-random with-random-stream gen-advance gen-split random-split random-bytes gen-serialize gen-deserialize gen->string string->gen safe-parse-gen-state safe-parse-integer)) (answer "(define (split-on-whitespace s) (let loop ((i 0) (start #f) (tokens '())) (if (>= i (string-length s)) (reverse (if start (cons (substring s start i) tokens) tokens)) (let ((c (string-ref s i))) (if (or (char=? c #\\ ) (char=? c #\\\t) (char=? c #\\\n)) (loop (+ i 1) #f (if start (cons (substring s start i) tokens) tokens)) (loop (+ i 1) (or start i) tokens))))))"))
