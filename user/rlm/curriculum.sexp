(task-entry (id "meta/type-search/truncate-at-description") (skill meta) (module type-search) (tier 1) (difficulty 11903) (name truncate-at-description) (type "") (description "") (notes ()) (section type-signature-utilities) (deps ()) (available (has-type-sig? string-contains? extract-type-sig)) (answer "(define (truncate-at-description str) (let* ((arrow-pos (or (string-find-substr str \"→\") (string-find-substr str \"->\"))) (len (string-length str))) (if (not arrow-pos) (extract-first-type-token str) (let* ((arrow-len (if (and (< arrow-pos len) (char=? (string-ref str arrow-pos) #\\→)) 1 2)) (after-arrow (substring str (+ arrow-pos arrow-len) len)) (output-type (extract-first-type-token (string-trim-left-ws after-arrow)))) (string-append (substring str 0 (+ arrow-pos arrow-len)) \" \" output-type)))))"))
(task-entry (id "meta/xref/extract-symbols-from-sexp") (skill meta) (module xref) (tier 1) (difficulty 11903) (name extract-symbols-from-sexp) (type "") (description "") (notes ()) (section symbol-extraction) (deps (lattice/data/sort.ss)) (available (*xref-callers* *xref-callees* *xref-known-defs*)) (answer "(define (extract-symbols-from-sexp sexp) (cond ((symbol? sexp) (list sexp)) ((pair? sexp) (case (car sexp) ('quasiquote '()) ((define) (if (and (pair? (cdr sexp)) (pair? (cddr sexp))) (let ((name-part (cadr sexp))) (append-map extract-symbols-from-sexp (cddr sexp))) '())) ((let let* letrec) (cond ((and (pair? (cdr sexp)) (symbol? (cadr sexp)) (pair? (cddr sexp)) (pair? (caddr sexp))) (let ((bindings (caddr sexp)) (body (cdddr sexp))) (append (append-map (lambda (b) (if (and (pair? b) (pair? (cdr b))) (extract-symbols-from-sexp (cadr b)) '())) (if (list? bindings) bindings '())) (append-map extract-symbols-from-sexp body)))) ((and (pair? (cdr sexp)) (pair? (cadr sexp))) (let ((bindings (cadr sexp)) (body (cddr sexp))) (append (append-map (lambda (b) (if (and (pair? b) (pair? (cdr b))) (extract-symbols-from-sexp (cadr b)) '())) (if (list? bindings) bindings '())) (append-map extract-symbols-from-sexp body)))) (else '()))) ((lambda) (if (pair? (cddr sexp)) (append-map extract-symbols-from-sexp (cddr sexp)) '())) (else (append-map extract-symbols-from-sexp sexp)))) (else '())))"))
(task-entry (id "meta/dag/lattice-uses-transitive") (skill meta) (module dag) (tier 1) (difficulty 11903) (name lattice-uses-transitive) (type "") (description "") (notes ()) (section transitive-closure) (deps ()) (available (lattice-deps lattice-uses lattice-deps-transitive)) (answer "(define (lattice-uses-transitive skill-name) (let loop ((to-visit (kg-uses skill-name)) (visited '())) (if (null? to-visit) (reverse visited) (let ((current (car to-visit)) (rest (cdr to-visit))) (if (memq current visited) (loop rest visited) (loop (append (kg-uses current) rest) (cons current visited)))))))"))
(task-entry (id "meta/analytics/lattice-health") (skill meta) (module analytics) (tier 1) (difficulty 11903) (name lattice-health) (type "") (description "") (notes ()) (section health-checks) (deps ()) (available (lattice-stats lattice-stats-pretty round-to)) (answer "(define (lattice-health) (let* ((issues '()) (warnings '()) (skills (kg-skills))) (let ((cycle-errors (lattice-validate-all))) (for-each (lambda (err) (set! issues (cons err issues))) cycle-errors)) (for-each (lambda (skill-name) (let ((deps (kg-deps skill-name))) (for-each (lambda (dep) (unless (memq dep skills) (set! issues (cons (quasiquote (missing-dep (unquote skill-name) (unquote dep))) issues)))) deps))) skills) (for-each (lambda (skill-name) (let* ((data (kg-skill-data skill-name)) (desc (if data (cdr (or (assq 'description data) '(description . \"\"))) \"\"))) (when (or (not desc) (string=? desc \"\")) (set! warnings (cons (quasiquote (no-description (unquote skill-name))) warnings))))) skills) (for-each (lambda (skill-name) (let* ((data (kg-skill-data skill-name)) (keywords (if data (cdr (or (assq 'keywords data) '(keywords))) '()))) (when (or (not keywords) (null? keywords)) (set! warnings (cons (quasiquote (no-keywords (unquote skill-name))) warnings))))) skills) (for-each (lambda (skill-name) (let ((deps (kg-deps skill-name))) (when (> (length deps) 5) (set! warnings (cons (quasiquote (many-deps (unquote skill-name) (unquote (length deps)))) warnings))))) skills) (let ((healthy (and (null? issues) (null? warnings)))) (quasiquote ((healthy unquote healthy) (issues unquote (reverse issues)) (warnings unquote (reverse warnings)))))))"))
(task-entry (id "meta/inspect/module-bare-name") (skill meta) (module inspect) (tier 1) (difficulty 11903) (name module-bare-name) (type "") (description "") (notes ()) (section none) (deps ()) (available (lattice-describe lattice-describe-pretty first-line)) (answer "(define (module-bare-name mod-name) (let* ((name-str (symbol->string mod-name)) (slash-pos (let loop ((i 0)) (cond ((>= i (string-length name-str)) #f) ((char=? (string-ref name-str i) #\\/) i) (else (loop (+ i 1))))))) (if slash-pos (substring name-str (+ slash-pos 1) (string-length name-str)) name-str)))"))
