(task-entry (id "data/set/set-subset?") (skill data) (module set) (tier 0) (difficulty 1308) (name set-subset?) (type "(-> Set Set Boolean)") (description "Check if set1 is a subset of set2") (notes ()) (section none) (deps (\x27;prelude)) (available (set-empty set-empty? set-member? set-add set-remove set-union set-intersection set-difference)) (answer "(define (set-subset? set1 set2) (let loop ((remaining set1)) (cond ((null? remaining) #t) ((set-member? (car remaining) set2) (loop (cdr remaining))) (else #f))))"))
