(task-entry (id "physics/classical3d/shapes3d/box3d-corner") (skill physics/classical3d) (module shapes3d) (tier 2) (difficulty 22424) (name box3d-corner) (type "") (description "") (notes ()) (section sphere3d) (deps (\x27;vec3)) (available (sphere3d sphere3d? sphere3d-center sphere3d-radius sphere3d-diameter sphere3d-volume sphere3d-surface-area sphere3d-aabb sphere3d-with-center sphere3d-with-radius sphere3d-contains-point? box3d box3d? box3d-center box3d-half-extents box3d-extents box3d-min box3d-max box3d-volume box3d-surface-area box3d-aabb box3d-with-center box3d-with-half-extents box3d-contains-point?)) (answer "(define (box3d-corner b i) (let ((c (box3d-center b)) (h (box3d-half-extents b))) (let ((sx (if (= (bitwise-and i 1) 0) -1 1)) (sy (if (= (bitwise-and i 2) 0) -1 1)) (sz (if (= (bitwise-and i 4) 0) -1 1))) (vec3 (+ (vec3-x c) (* sx (vec3-x h))) (+ (vec3-y c) (* sy (vec3-y h))) (+ (vec3-z c) (* sz (vec3-z h)))))))"))
