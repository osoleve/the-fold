(task-entry (id "egraph/match/ematch") (skill egraph) (module match) (tier 1) (difficulty 10010) (name ematch) (type "(-> EGraph Pattern EClassId (List Substitution))") (description "Match pattern against e-class, return all substitutions.") (notes ()) (section api) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children)) (answer "(define (ematch eg pattern class-id) (ematch-pattern eg pattern class-id (empty-subst)))"))
(task-entry (id "egraph/saturation/result-status") (skill egraph) (module saturation) (tier 1) (difficulty 10010) (name result-status) (type "") (description "") (notes ()) (section result) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result?)) (answer "(define (result-status r) (vector-ref r 1))"))
(task-entry (id "egraph/cost/leaf-count-cost") (skill egraph) (module cost) (tier 1) (difficulty 10010) (name leaf-count-cost) (type "") (description "") (notes ()) (section basic-models) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost ast-size-cost ast-depth-cost)) (answer "(define leaf-count-cost (make-cost-model 'leaf-count (lambda (node child-cost) (let ((children (enode-children node))) (if (zero? (vector-length children)) 1 (fold-left (lambda (acc i) (+ acc (child-cost (vector-ref children i)))) 0 (iota (vector-length children))))))))"))
(task-entry (id "egraph/extract/optimize-with-config") (skill egraph) (module extract) (tier 1) (difficulty 10010) (name optimize-with-config) (type "(-> Term (List Rule) CostModel SaturationConfig Term)") (description "Optimize with custom saturation config.") (notes ()) (section convenience) (deps (\x27;prelude \x27;egraph/cost \x27;egraph/saturation)) (available (extraction-state-tag make-extraction-state extraction-state? state-egraph state-costs state-best-nodes extract extract-term extract-all optimize)) (answer "(define (optimize-with-config term rules cost-model config) (let ((eg (make-egraph))) (let ((root (egraph-add-term! eg term))) (saturate eg rules config) (let ((state (make-extraction-state eg cost-model))) (extract state root)))))"))
(task-entry (id "egraph/scheduler/stats-set-zero-streaks!") (skill egraph) (module scheduler) (tier 1) (difficulty 10010) (name stats-set-zero-streaks!) (type "") (description "") (notes ()) (section stats) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches!)) (answer "(define (stats-set-zero-streaks! s v) (vector-set! s 4 v))"))
(task-entry (id "egraph/union-find/uf-find") (skill egraph) (module union-find) (tier 1) (difficulty 10011) (name uf-find) (type "(-> UnionFind Id Id)") (description "Find representative of set containing id. Path compression applied.") (notes ()) (section operations) (deps (\x27;prelude)) (available (uf-tag make-uf uf? uf-parent uf-rank uf-count-box uf-next-id-box uf-count uf-size ensure-capacity! uf-make-set!)) (answer "(define (uf-find uf id) (let ((parent (uf-parent uf))) (let loop ((i id)) (let ((p (vector-ref parent i))) (if (= p i) i (let ((root (loop p))) (vector-set! parent i root) root))))))"))
(task-entry (id "egraph/eclass/eclass-data?") (skill egraph) (module eclass) (tier 1) (difficulty 10011) (name eclass-data?) (type "") (description "") (notes ()) (section eclass) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data)) (answer "(define (eclass-data? x) (and (vector? x) (>= (vector-length x) 3) (eq? (vector-ref x 0) eclass-tag)))"))
(task-entry (id "egraph/egraph/egraph-stat-hits") (skill egraph) (module egraph) (tier 1) (difficulty 10011) (name egraph-stat-hits) (type "") (description "") (notes ()) (section structure) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds)) (answer "(define (egraph-stat-hits eg) (vector-ref (egraph-stats eg) 3))"))
(task-entry (id "egraph/match/ematch-all") (skill egraph) (module match) (tier 1) (difficulty 10011) (name ematch-all) (type "(-> EGraph Pattern (List (Pair EClassId Substitution)))") (description "Match pattern against all e-classes in e-graph.") (notes ()) (section api) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch)) (answer "(define (ematch-all eg pattern) (let ((uf (egraph-uf eg))) (append-map (lambda (root) (map (lambda (subst) (cons root subst)) (ematch eg pattern root))) (uf-roots uf))))"))
(task-entry (id "egraph/saturation/result-iterations") (skill egraph) (module saturation) (tier 1) (difficulty 10011) (name result-iterations) (type "") (description "") (notes ()) (section result) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status)) (answer "(define (result-iterations r) (vector-ref r 2))"))
(task-entry (id "egraph/cost/make-weighted-cost") (skill egraph) (module cost) (tier 1) (difficulty 10011) (name make-weighted-cost) (type "(-> (Hashtable Symbol Nat) Nat CostModel)") (description "Create weighted cost model with operator-specific costs.") (notes ()) (section weighted-models) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost ast-size-cost ast-depth-cost leaf-count-cost)) (answer "(define (make-weighted-cost op-costs default-cost) (make-cost-model 'weighted (lambda (node child-cost) (let* ((op (enode-op node)) (base (if (symbol? op) (hashtable-ref op-costs op default-cost) default-cost)) (children (enode-children node)) (child-sum (fold-left (lambda (acc i) (+ acc (child-cost (vector-ref children i)))) 0 (iota (vector-length children))))) (+ base child-sum)))))"))
(task-entry (id "egraph/extract/extraction-report") (skill egraph) (module extract) (tier 1) (difficulty 10011) (name extraction-report) (type "(-> ExtractionState ClassId String)") (description "Generate extraction report for a class.") (notes ()) (section analysis) (deps (\x27;prelude \x27;egraph/cost \x27;egraph/saturation)) (available (extraction-state-tag make-extraction-state extraction-state? state-egraph state-costs state-best-nodes extract extract-term extract-all optimize optimize-with-config)) (answer "(define (extraction-report state class-id) (let* ((eg (state-egraph state)) (root (egraph-find eg class-id)) (costs (state-costs state)) (best-nodes (state-best-nodes state)) (best (hashtable-ref best-nodes root #f)) (all-nodes (eclass-get-nodes (egraph-classes eg) root))) (with-output-to-string (lambda () (printf \"E-class ~a:~n\" root) (printf \"  Selected: ~a (cost=~a)~n\" (if best (enode->string best) \"none\") (class-cost costs root)) (printf \"  Alternatives (~a total):~n\" (length all-nodes)) (for-each (lambda (node) (unless (eq? node best) (printf \"    - ~a~n\" (enode->string node)))) all-nodes)))))"))
(task-entry (id "egraph/scheduler/stats-set-priority!") (skill egraph) (module scheduler) (tier 1) (difficulty 10011) (name stats-set-priority!) (type "") (description "") (notes ()) (section stats) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks!)) (answer "(define (stats-set-priority! s v) (vector-set! s 5 v))"))
(task-entry (id "egraph/union-find/uf-union!") (skill egraph) (module union-find) (tier 1) (difficulty 10012) (name uf-union!) (type "(-> UnionFind Id Id Id)") (description "Merge sets containing id1 and id2. Returns merged set's representative.") (notes ()) (section operations) (deps (\x27;prelude)) (available (uf-tag make-uf uf? uf-parent uf-rank uf-count-box uf-next-id-box uf-count uf-size ensure-capacity! uf-make-set! uf-find)) (answer "(define (uf-union! uf id1 id2) (let ((root1 (uf-find uf id1)) (root2 (uf-find uf id2))) (if (= root1 root2) root1 (let ((parent (uf-parent uf)) (rank (uf-rank uf)) (rank1 (vector-ref (uf-rank uf) root1)) (rank2 (vector-ref (uf-rank uf) root2))) (set-box! (uf-count-box uf) (- (unbox (uf-count-box uf)) 1)) (cond ((< rank1 rank2) (vector-set! parent root1 root2) root2) ((> rank1 rank2) (vector-set! parent root2 root1) root1) (else (vector-set! parent root2 root1) (vector-set! rank root1 (+ rank1 1)) root1))))))"))
(task-entry (id "egraph/eclass/eclass-nodes") (skill egraph) (module eclass) (tier 1) (difficulty 10012) (name eclass-nodes) (type "") (description "") (notes ()) (section eclass) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data?)) (answer "(define (eclass-nodes data) (vector-ref data 1))"))
(task-entry (id "egraph/egraph/egraph-inc-stat!") (skill egraph) (module egraph) (tier 1) (difficulty 10012) (name egraph-inc-stat!) (type "") (description "") (notes ()) (section structure) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits)) (answer "(define (egraph-inc-stat! eg idx) (let ((stats (egraph-stats eg))) (vector-set! stats idx (+ (vector-ref stats idx) 1))))"))
(task-entry (id "egraph/match/eclass-ref-tag") (skill egraph) (module match) (tier 1) (difficulty 10012) (name eclass-ref-tag) (type "") (description "") (notes ()) (section application) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all)) (answer "(define eclass-ref-tag 'eclass-ref)"))
(task-entry (id "egraph/saturation/result-rules-applied") (skill egraph) (module saturation) (tier 1) (difficulty 10012) (name result-rules-applied) (type "") (description "") (notes ()) (section result) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations)) (answer "(define (result-rules-applied r) (vector-ref r 3))"))
(task-entry (id "egraph/cost/cuda-op-costs") (skill egraph) (module cost) (tier 1) (difficulty 10012) (name cuda-op-costs) (type "") (description "") (notes ()) (section cuda) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost ast-size-cost ast-depth-cost leaf-count-cost make-weighted-cost)) (answer "(define cuda-op-costs (let ((ht (make-hashtable symbol-hash eq?))) (hashtable-set! ht 'load 100) (hashtable-set! ht 'store 100) (hashtable-set! ht 'index 50) (hashtable-set! ht '+ 1) (hashtable-set! ht '- 1) (hashtable-set! ht '* 2) (hashtable-set! ht 'neg 1) (hashtable-set! ht '/ 10) (hashtable-set! ht 'mod 10) (hashtable-set! ht 'div 10) (hashtable-set! ht 'sqrt 15) (hashtable-set! ht 'rsqrt 8) (hashtable-set! ht 'exp 20) (hashtable-set! ht 'log 20) (hashtable-set! ht 'sin 20) (hashtable-set! ht 'cos 20) (hashtable-set! ht 'tan 25) (hashtable-set! ht 'pow 30) (hashtable-set! ht 'fma 3) (hashtable-set! ht 'fms 3) (hashtable-set! ht 'mad 3) (hashtable-set! ht '< 1) (hashtable-set! ht '<= 1) (hashtable-set! ht '> 1) (hashtable-set! ht '>= 1) (hashtable-set! ht '= 1) (hashtable-set! ht 'and 1) (hashtable-set! ht 'or 1) (hashtable-set! ht 'not 1) (hashtable-set! ht 'if 5) (hashtable-set! ht 'select 2) (hashtable-set! ht 'vec4-add 1) (hashtable-set! ht 'vec4-mul 2) (hashtable-set! ht 'dot 4) ht))"))
(task-entry (id "egraph/extract/compare-extractions") (skill egraph) (module extract) (tier 1) (difficulty 10012) (name compare-extractions) (type "(-> EGraph ClassId (List CostModel) (List (Triple CostModel Term Nat)))") (description "Compare extractions across different cost models.") (notes ()) (section analysis) (deps (\x27;prelude \x27;egraph/cost \x27;egraph/saturation)) (available (extraction-state-tag make-extraction-state extraction-state? state-egraph state-costs state-best-nodes extract extract-term extract-all optimize optimize-with-config extraction-report)) (answer "(define (compare-extractions eg class-id cost-models) (map (lambda (cm) (let* ((state (make-extraction-state eg cm)) (term (extract state class-id)) (cost (class-cost (state-costs state) (egraph-find eg class-id)))) (list cm term cost))) cost-models))"))
(task-entry (id "egraph/scheduler/scheduler-tag") (skill egraph) (module scheduler) (tier 1) (difficulty 10012) (name scheduler-tag) (type "") (description "") (notes ()) (section protocol) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority!)) (answer "(define scheduler-tag 'scheduler)"))
(task-entry (id "egraph/union-find/uf-same-set?") (skill egraph) (module union-find) (tier 1) (difficulty 10013) (name uf-same-set?) (type "(-> UnionFind Id Id Boolean)") (description "Check if id1 and id2 are in the same equivalence class.") (notes ()) (section operations) (deps (\x27;prelude)) (available (uf-tag make-uf uf? uf-parent uf-rank uf-count-box uf-next-id-box uf-count uf-size ensure-capacity! uf-make-set! uf-find uf-union!)) (answer "(define (uf-same-set? uf id1 id2) (= (uf-find uf id1) (uf-find uf id2)))"))
