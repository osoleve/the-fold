(task-entry (id "physics/classical/ascii-renderer/draw-constraint!") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23547) (name draw-constraint!) (type "") (description "") (notes ()) (section debug:) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line! draw-filled-circle! polygon-scanline-intersections fill-between-pairs! draw-filled-polygon! draw-filled-aabb! draw-aabb-outline! fmod angle->arrow-char draw-velocity-vector! draw-contact!)) (answer "(define (draw-constraint! frame world constraint config) (let* ((pos-a (constraint-anchor-world-a world constraint)) (pos-b (constraint-anchor-world-b world constraint)) (screen-a (world->screen pos-a config)) (screen-b (world->screen pos-b config)) (type (constraint-type constraint)) (line-char (case type ((distance) #\\-) ((spring) #\\~) ((revolute) #\\*) ((weld) #\\=) (else #\\.)))) (safe-frame-set! frame (car screen-a) (cdr screen-a) #\\+ config) (safe-frame-set! frame (car screen-b) (cdr screen-b) #\\+ config) (draw-line! frame (car screen-a) (cdr screen-a) (car screen-b) (cdr screen-b) line-char config)))"))
(task-entry (id "physics/classical/collision-detection/aabb-to-polygon") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23548) (name aabb-to-polygon) (type "") (description "") (notes ()) (section generic) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon? closest-point-on-segment circle-polygon-manifold project-polygon project-circle intervals-overlap polygon-polygon? polygon-polygon-manifold shape-type shape-aabb shapes-collide?)) (answer "(define (aabb-to-polygon aabb) (let ((min-p (aabb-min aabb)) (max-p (aabb-max aabb))) (make-polygon (list min-p (vec2 (vec2-x max-p) (vec2-y min-p)) max-p (vec2 (vec2-x min-p) (vec2-y max-p))))))"))
