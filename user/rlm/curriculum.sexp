(task-entry (id "numeric/wavelet/soft-threshold") (skill numeric) (module wavelet) (tier 0) (difficulty 2523) (name soft-threshold) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (haar-scaling-filter haar-wavelet-filter daubechies-4-scaling-filter qmf-wavelet-from-scaling daubechies-4-wavelet-filter daubechies-6-scaling-filter daubechies-6-wavelet-filter reverse-filter convolve-downsample upsample-convolve dwt-step dwt idwt-step idwt get-wavelet-filters dwt-family idwt-family wavelet-decompose wavelet-reconstruct get-approximation get-details get-detail-level hard-threshold)) (answer "(define (soft-threshold x threshold) (cond ((> x threshold) (- x threshold)) ((< x (- threshold)) (+ x threshold)) (else 0)))"))
(task-entry (id "numeric/signal-poly/signal->numeric-poly") (skill numeric) (module signal-poly) (tier 0) (difficulty 2523) (name signal->numeric-poly) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;digital-filters)) (available (Q-field-sig sig-make-polynomial sig-normalize-coeffs sig-poly-field sig-poly-coeffs sig-poly-degree sig-poly-zero? sig-poly-leading sig-poly-add sig-poly-sub sig-poly-mul list-set sig-poly-scale sig-poly-divmod sig-poly-zero-over sig-poly-one-over sig-poly-divmod-iter sig-poly-div sig-poly-mod sig-poly-gcd sig-poly-make-monic num-poly-coeffs-sig numeric->signal-poly)) (answer "(define (signal->numeric-poly p) (let* ((coeffs (sig-poly-coeffs p)) (descending (reverse coeffs)) (vec (list->vector descending))) (cons 'polynomial vec)))"))
(task-entry (id "numeric/interpolate/linreg-r2") (skill numeric) (module interpolate) (tier 0) (difficulty 2523) (name linreg-r2) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;numeric/polynomial)) (available (binary-search-segment binary-search-segment-vec lerp lerp-inverse interp-linear lagrange-basis interp-lagrange divided-differences interp-newton interp-hermite hermite-tangent-estimate thomas-algorithm cubic-spline-natural matrix-set! spline-eval interp-cubic-spline bezier-linear bezier-quadratic bezier-cubic bezier-general bezier-derivative polyfit linreg)) (answer "(define (linreg-r2 xs ys) (let* ((reg (linreg xs ys)) (m (car reg)) (b (cdr reg)) (y-mean (/ (apply + ys) (length ys))) (ss-tot (apply + (map (lambda (y) (expt (- y y-mean) 2)) ys))) (ss-res (apply + (map (lambda (x y) (expt (- y (+ (* m x) b)) 2)) xs ys)))) (if (zero? ss-tot) 1.0 (- 1 (/ ss-res ss-tot)))))"))
(task-entry (id "numeric/interval/interval-mignitude") (skill numeric) (module interval) (tier 0) (difficulty 2523) (name interval-mignitude) (type "") (description "") (notes ()) (section directed-rounding-arithmetic) (deps (\x27;prelude)) (available (fl-next-up fl-next-down add-down add-up sub-down sub-up mul-down mul-up div-down div-up sqrt-down sqrt-up make-interval interval interval? interval-lo interval-hi interval-singleton entire-interval interval-mid interval-width interval-radius interval-magnitude)) (answer "(define (interval-mignitude iv) (let ((lo (interval-lo iv)) (hi (interval-hi iv))) (cond ((and (<= lo 0) (>= hi 0)) 0) ((> lo 0) lo) (else (- hi)))))"))
(task-entry (id "numeric/affine/affine-sqrt-positive") (skill numeric) (module affine) (tier 0) (difficulty 2523) (name affine-sqrt-positive) (type "") (description "") (notes ()) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval affine->interval affine-radius affine-neg merge-terms affine-add affine-sub affine-scale affine-add-constant affine-mul affine-sqr affine-recip affine-div affine-sqrt)) (answer "(define (affine-sqrt-positive af) (affine-chebyshev-approx af sqrt (lambda (β) (/ 1 (* 4 β β))) 'concave 1e-300))"))
(task-entry (id "numeric/fem/sparse-cg-loop") (skill numeric) (module fem) (tier 0) (difficulty 2523) (name sparse-cg-loop) (type "") (description "") (notes ()) (section sparse-cg) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes apply-dirichlet-bc! apply-dirichlet-penalty! *fem-tolerance* *fem-max-iterations* sparse-cg)) (answer "(define (sparse-cg-loop A b x r p rr iter max-iter tol n) (let ((r-norm (sqrt rr))) (cond ((< r-norm tol) (list x r-norm iter)) ((>= iter max-iter) (list x r-norm iter)) (else (let* ((Ap (sparse-csr-vec-mul A p)) (pAp (vec-dot p Ap))) (if (< (abs pAp) 1e-30) (list x r-norm iter) (let* ((alpha (/ rr pAp)) (x-new (vec-add x (vec-scale alpha p))) (r-new (vec-sub r (vec-scale alpha Ap))) (rr-new (vec-dot r-new r-new)) (beta (/ rr-new rr)) (p-new (vec-add r-new (vec-scale beta p)))) (sparse-cg-loop A b x-new r-new p-new rr-new (+ iter 1) max-iter tol n))))))))"))
(task-entry (id "numeric/pde-time/sparse-cg-solve") (skill numeric) (module pde-time) (tier 0) (difficulty 2523) (name sparse-cg-solve) (type "") (description "") (notes ()) (section sparse-utils) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step mol-rk4-step cfl-parabolic cfl-hyperbolic estimate-mesh-spacing adaptive-euler-step integrate-adaptive sparse-csr-identity)) (answer "(define (sparse-cg-solve A b x0 tol max-iter) (let* ((n (sparse-csr-rows A)) (Ax0 (sparse-csr-vec-mul A x0)) (r (pde-vec-sub b Ax0)) (p (vector-copy r)) (rr (pde-vec-dot r r))) (if (< (sqrt rr) tol) (list x0 (sqrt rr) 0) (cg-loop A b (vector-copy x0) r p rr 0 max-iter tol n))))"))
(task-entry (id "numeric/complex/complex-pow") (skill numeric) (module complex) (tier 0) (difficulty 2524) (name complex-pow) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;transcendental)) (available (make-complex complex? complex-real complex-imag real-num->complex i-value make-polar complex-magnitude complex-angle complex->polar polar->complex complex-add complex-sub complex-mul complex-div complex-negate complex-conjugate complex-reciprocal complex-equal? complex-zero? complex-real? complex-imaginary? complex-exp complex-log)) (answer "(define (complex-pow z w) (if (complex-zero? z) (cond ((complex-zero? w) (error 'complex-pow \"0^0 is undefined\" (list z w))) ((< (complex-real w) 0) (error 'complex-pow \"0^(-n) is undefined (division by zero)\" (list z w))) ((and (= (complex-real w) 0) (not (= (complex-imag w) 0))) (make-complex +nan.0 +nan.0)) (else (make-complex 0 0))) (complex-exp (complex-mul w (complex-log z)))))"))
(task-entry (id "numeric/digital-filters/biquad-filter") (skill numeric) (module digital-filters) (tier 0) (difficulty 2524) (name biquad-filter) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window bessel-i0 sinc fir-lowpass fir-highpass fir-bandpass fir-bandstop fir-filter make-iir-filter iir-filter? iir-filter-b iir-filter-a iir-filter-signal make-biquad biquad? biquad-b0 biquad-b1 biquad-b2 biquad-a1 biquad-a2)) (answer "(define (biquad-filter signal bq) (let* ((n (vector-length signal)) (b0 (biquad-b0 bq)) (b1 (biquad-b1 bq)) (b2 (biquad-b2 bq)) (a1 (biquad-a1 bq)) (a2 (biquad-a2 bq)) (output (make-vector n 0.0)) (z1 0.0) (z2 0.0)) (do ((i 0 (+ i 1))) ((= i n) output) (let* ((x (vector-ref signal i)) (y (+ (* b0 x) z1))) (set! z1 (+ (* b1 x) (- (* a1 y)) z2)) (set! z2 (+ (* b2 x) (- (* a2 y)))) (vector-set! output i y)))))"))
(task-entry (id "numeric/wavelet/threshold-coefficients") (skill numeric) (module wavelet) (tier 0) (difficulty 2524) (name threshold-coefficients) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (haar-scaling-filter haar-wavelet-filter daubechies-4-scaling-filter qmf-wavelet-from-scaling daubechies-4-wavelet-filter daubechies-6-scaling-filter daubechies-6-wavelet-filter reverse-filter convolve-downsample upsample-convolve dwt-step dwt idwt-step idwt get-wavelet-filters dwt-family idwt-family wavelet-decompose wavelet-reconstruct get-approximation get-details get-detail-level hard-threshold soft-threshold)) (answer "(define (threshold-coefficients coeffs threshold type) (let* ((n (vector-length coeffs)) (result (make-vector n)) (threshold-fn (case type ((hard) hard-threshold) ((soft) soft-threshold) (else (error 'threshold-coefficients \"unknown threshold type\" type))))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (threshold-fn (vector-ref coeffs i) threshold)))))"))
