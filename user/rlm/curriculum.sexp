(task-entry (id "physics-problems/simulation/time-to-collision") (skill physics-problems) (module simulation) (tier 2) (difficulty 23630) (name time-to-collision) (type "") (description "") (notes ()) (section collision-helpers) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static make-box make-ground setup-problem-world setup-no-gravity-world setup-gravity-world simulate-step simulate-n-steps simulate-frames make-problem-renderer render-world-frame render-frames capture-frames capture-frames-with-final get-entity-position get-entity-velocity get-entity-radius compute-distance compute-relative-velocity compute-speed)) (answer "(define (time-to-collision world id1 id2) (let* ((pos1 (get-entity-position world id1)) (pos2 (get-entity-position world id2)) (vel1 (get-entity-velocity world id1)) (vel2 (get-entity-velocity world id2)) (r1 (get-entity-radius world id1)) (r2 (get-entity-radius world id2)) (rel-pos (vec2-sub pos2 pos1)) (rel-vel (vec2-sub vel2 vel1)) (dist (vec2-magnitude rel-pos))) (if (< dist 1e-4) 0 (let ((closing-speed (- (vec2-dot rel-vel (vec2-normalize rel-pos))))) (if (<= closing-speed 0) #f (/ (- dist r1 r2) closing-speed))))))"))
(task-entry (id "physics-problems/simulation/will-collide?") (skill physics-problems) (module simulation) (tier 2) (difficulty 23631) (name will-collide?) (type "") (description "") (notes ()) (section collision-helpers) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static make-box make-ground setup-problem-world setup-no-gravity-world setup-gravity-world simulate-step simulate-n-steps simulate-frames make-problem-renderer render-world-frame render-frames capture-frames capture-frames-with-final get-entity-position get-entity-velocity get-entity-radius compute-distance compute-relative-velocity compute-speed time-to-collision)) (answer "(define (will-collide? world id1 id2 max-time) (let ((ttc (time-to-collision world id1 id2))) (and ttc (< ttc max-time) (> ttc 0))))"))
