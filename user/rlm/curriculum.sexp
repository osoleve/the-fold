(task-entry (id "fp/proof-tactics/auto-laws") (skill fp) (module proof-tactics) (tier 1) (difficulty 10636) (name auto-laws) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;engine \x27;rewrite/laws)) (available (make-proof-goal proof-goal? goal-lhs goal-rhs goal-context goal-trivial? tactic-success tactic-failure tactic-success? tactic-failure? tactic-subgoals tactic-builder tactic-error tactic-refl tactic-sym tactic-trans tactic-rewrite tactic-topdown tactic-bottomup tactic-try *tactic-repeat-fuel* tactic-repeat fold-proofs tactic-then build-combined-proof take-n drop-n tactic-orelse tactic-id tactic-fail *auto-laws-base* *auto-law-categories* *auto-laws-extra* register-auto-law! register-auto-category! unregister-auto-category!)) (answer "(define (auto-laws) (let* ((base *auto-laws-base*) (category-laws (append-map (lambda (cat) (map rule-name (laws-by-category cat))) *auto-law-categories*)) (extra *auto-laws-extra*) (all (append base category-laws extra))) (let loop ((lst all) (seen '()) (acc '())) (cond ((null? lst) (reverse acc)) ((memq (car lst) seen) (loop (cdr lst) seen acc)) (else (loop (cdr lst) (cons (car lst) seen) (cons (car lst) acc)))))))"))
