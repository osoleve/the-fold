(task-entry (id "optimization/interval-global/bisect-box") (skill optimization) (module interval-global) (tier 1) (difficulty 12819) (name bisect-box) (type "") (description "") (notes ()) (section convergence-criteria) (deps (\x27;prelude \x27;interval \x27;heap)) (available (make-interval-convergence interval-convergence? ic-width-tol ic-max-iter ic-gap-tol *default-interval-convergence* make-interval-opt-result interval-opt-result? ior-candidates ior-best-upper ior-iterations ior-reason ior-best-box ior-best-point ior-solution-box box-hull box-midpoint box-max-width box-widest-dimension)) (answer "(define (bisect-box box) (let* ((dim (box-widest-dimension box)) (iv (list-ref box dim)) (pair (interval-bisect iv)) (iv-lo (car pair)) (iv-hi (cdr pair))) (cons (list-update box dim iv-lo) (list-update box dim iv-hi))))"))
(task-entry (id "optimization/interval-contract/add-box-to-heap") (skill optimization) (module interval-contract) (tier 1) (difficulty 12819) (name add-box-to-heap) (type "") (description "") (notes ()) (section constrained-optimization) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract contract-linear-var remove-dim sum-interval-bounds make-linear-ge-contractor make-linear-eq-contractor make-sphere-contractor contract-sphere-dim sphere-other-sq interval-minimize-constrained bb-loop-constrained add-contracted-boxes)) (answer "(define (add-box-to-heap f-interval box heap best-upper) (let* ((f-iv (f-interval box)) (mid (box-midpoint box)) (f-mid (eval-at-point f-interval mid)) (new-best (min best-upper f-mid (interval-hi f-iv))) (item (make-work-item box f-iv)) (new-heap (heap-insert-by work-item-cmp item heap))) (list new-heap new-best)))"))
(task-entry (id "optimization/interval-newton/polynomial-root-example") (skill optimization) (module interval-newton) (tier 1) (difficulty 12819) (name polynomial-root-example) (type "") (description "") (notes ()) (section examples) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step interval-newton-step-rigorous interval-newton-root interval-find-all-roots interval-might-contain-root? interval-bisection-root bisection-loop interval-contains-unique-root? interval-contains-no-root? krawczyk-step find-root find-all-roots-simple)) (answer "(define (polynomial-root-example) (let ((f-iv (lambda (X) (interval-sub (interval-pow X 3) X))) (f-deriv-iv (lambda (X) (interval-sub (interval-scale (interval-sqr X) 3) (interval-singleton 1))))) (interval-find-all-roots f-iv f-deriv-iv (interval -2 2) 1e-10 1000)))"))
