(task-entry (id "egraph/scheduler/make-scheduler") (skill egraph) (module scheduler) (tier 1) (difficulty 10013) (name make-scheduler) (type "(-> Symbol Fn Fn Fn Scheduler)") (description "Create a custom scheduler.") (notes ()) (section protocol) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag)) (answer "(define (make-scheduler name init-fn select-fn update-fn) (vector scheduler-tag name init-fn select-fn update-fn))"))
(task-entry (id "egraph/union-find/uf-roots") (skill egraph) (module union-find) (tier 1) (difficulty 10014) (name uf-roots) (type "(-> UnionFind (List Id))") (description "List all set representatives (roots).") (notes ()) (section introspection) (deps (\x27;prelude)) (available (uf-tag make-uf uf? uf-parent uf-rank uf-count-box uf-next-id-box uf-count uf-size ensure-capacity! uf-make-set! uf-find uf-union! uf-same-set?)) (answer "(define (uf-roots uf) (let ((parent (uf-parent uf)) (n (uf-size uf))) (let loop ((i 0) (acc '())) (if (>= i n) (reverse acc) (loop (+ i 1) (if (= (vector-ref parent i) i) (cons i acc) acc))))))"))
(task-entry (id "egraph/eclass/eclass-set-nodes!") (skill egraph) (module eclass) (tier 1) (difficulty 10014) (name eclass-set-nodes!) (type "") (description "") (notes ()) (section eclass) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents)) (answer "(define (eclass-set-nodes! data nodes) (vector-set! data 1 nodes))"))
