(task-entry (id "linalg/quaternion/quat-from-rotation-matrix") (skill linalg) (module quaternion) (tier 0) (difficulty 405) (name quat-from-rotation-matrix) (type "") (description "") (notes ()) (section quaternion-construction) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler)) (answer "(define (quat-from-rotation-matrix m) (let* ((m00 (list-ref (list-ref m 0) 0)) (m11 (list-ref (list-ref m 1) 1)) (m22 (list-ref (list-ref m 2) 2)) (trace (+ m00 m11 m22))) (cond ((> trace 0) (let* ((s (sqrt (+ trace 1.0))) (w (/ s 2)) (s (/ 0.5 s)) (m12 (list-ref (list-ref m 1) 2)) (m21 (list-ref (list-ref m 2) 1)) (m20 (list-ref (list-ref m 2) 0)) (m02 (list-ref (list-ref m 0) 2)) (m01 (list-ref (list-ref m 0) 1)) (m10 (list-ref (list-ref m 1) 0))) (quat w (* s (- m21 m12)) (* s (- m02 m20)) (* s (- m10 m01))))) ((and (> m00 m11) (> m00 m22)) (let* ((m01 (list-ref (list-ref m 0) 1)) (m10 (list-ref (list-ref m 1) 0)) (m02 (list-ref (list-ref m 0) 2)) (m20 (list-ref (list-ref m 2) 0)) (m12 (list-ref (list-ref m 1) 2)) (m21 (list-ref (list-ref m 2) 1)) (s (sqrt (+ 1.0 m00 (- m11) (- m22)))) (x (/ s 2)) (s (/ 0.5 s))) (quat (* s (- m21 m12)) x (* s (+ m01 m10)) (* s (+ m02 m20))))) ((> m11 m22) (let* ((m01 (list-ref (list-ref m 0) 1)) (m10 (list-ref (list-ref m 1) 0)) (m12 (list-ref (list-ref m 1) 2)) (m21 (list-ref (list-ref m 2) 1)) (m02 (list-ref (list-ref m 0) 2)) (m20 (list-ref (list-ref m 2) 0)) (s (sqrt (+ 1.0 m11 (- m00) (- m22)))) (y (/ s 2)) (s (/ 0.5 s))) (quat (* s (- m02 m20)) (* s (+ m01 m10)) y (* s (+ m12 m21))))) (else (let* ((m02 (list-ref (list-ref m 0) 2)) (m20 (list-ref (list-ref m 2) 0)) (m12 (list-ref (list-ref m 1) 2)) (m21 (list-ref (list-ref m 2) 1)) (m01 (list-ref (list-ref m 0) 1)) (m10 (list-ref (list-ref m 1) 0)) (s (sqrt (+ 1.0 m22 (- m00) (- m11)))) (z (/ s 2)) (s (/ 0.5 s))) (quat (* s (- m10 m01)) (* s (+ m02 m20)) (* s (+ m12 m21)) z))))))"))
(task-entry (id "linalg/matrix/make-matrix") (skill linalg) (module matrix) (tier 0) (difficulty 405) (name make-matrix) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape)) (answer "(define (make-matrix rows cols init) (list 'matrix rows cols (make-vector (* rows cols) init)))"))
(task-entry (id "linalg/matrix-decomp/matrix-lu-solve") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 405) (name matrix-lu-solve) (type "") (description "Solve Ax = b given LU decomposition with permutation. Algorithm: 1) Apply P to b, 2) Forward substitute Ly = Pb, 3) Back substitute Ux = y") (notes ()) (section lu-decomposition) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance* matrix-copy matrix-set! matrix-column matrix-lu)) (answer "(define (matrix-lu-solve lu-result b) (let* ((l (car lu-result)) (u (cadr lu-result)) (p (caddr lu-result)) (n (vector-length b)) (pb (make-vector n 0)) (_ (do ((i 0 (+ i 1))) ((= i n)) (vector-set! pb i (vector-ref b (vector-ref p i))))) (y (make-vector n 0)) (_ (do ((i 0 (+ i 1))) ((= i n)) (let ((sum (let loop ((j 0) (s 0)) (if (= j i) s (loop (+ j 1) (+ s (* (matrix-ref l i j) (vector-ref y j)))))))) (vector-set! y i (- (vector-ref pb i) sum))))) (x (make-vector n 0))) (do ((i (- n 1) (- i 1))) ((< i 0) x) (let ((sum (let loop ((j (+ i 1)) (s 0)) (if (= j n) s (loop (+ j 1) (+ s (* (matrix-ref u i j) (vector-ref x j)))))))) (vector-set! x i (/ (- (vector-ref y i) sum) (matrix-ref u i i)))))))"))
(task-entry (id "linalg/matrix-solvers/matrix-determinant") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 405) (name matrix-determinant) (type "") (description "") (notes ()) (section lu-solvers) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute matrix-back-substitute matrix-solve matrix-inverse permutation-parity)) (answer "(define (matrix-determinant a) (if (not (matrix-square? a)) (quasiquote (error not-square (unquote (matrix-rows a)) (unquote (matrix-cols a)))) (let ((lu (matrix-lu a))) (if (and (pair? lu) (eq? (car lu) 'error)) (if (eq? (cadr lu) 'singular-matrix) 0 lu) (let* ((u (cadr lu)) (p (caddr lu)) (diag (matrix-diagonal u)) (det-u (vec-fold * 1 diag)) (parity (permutation-parity p))) (* parity det-u))))))"))
(task-entry (id "linalg/matrix-eigen/qr-algorithm-loop") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 405) (name qr-algorithm-loop) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm)) (answer "(define (qr-algorithm-loop a iter max-iter tol) (if (>= iter max-iter) (matrix-diagonal a) (let ((qr-result (matrix-qr a))) (if (and (pair? qr-result) (eq? (car qr-result) 'error)) qr-result (let* ((q (car qr-result)) (r (cadr qr-result)) (a-new (matrix-mul r q))) (if (qr-converged? a-new tol) (matrix-diagonal a-new) (qr-algorithm-loop a-new (+ iter 1) max-iter tol)))))))"))
(task-entry (id "linalg/iterative-solvers/jacobi-loop") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 405) (name jacobi-loop) (type "") (description "") (notes ()) (section jacobi-iteration) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi)) (answer "(define (jacobi-loop a b x iter max-iter tol n) (let ((res (residual a x b))) (cond ((converged? res tol) (list x iter res)) ((>= iter max-iter) (quasiquote (error no-convergence (unquote iter) (unquote res)))) (else (let ((x-new (make-vector n 0.0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((a-ii (matrix-ref a i i))) (if (< (abs a-ii) *iterative-tolerance*) (vector-set! x-new i 0.0) (let ((sum (let loop ((j 0) (s 0.0)) (if (= j n) s (if (= j i) (loop (+ j 1) s) (loop (+ j 1) (+ s (* (matrix-ref a i j) (vector-ref x j))))))))) (vector-set! x-new i (/ (- (vector-ref b i) sum) a-ii)))))) (jacobi-loop a b x-new (+ iter 1) max-iter tol n))))))"))
(task-entry (id "linalg/sparse/sparse-coo-row-indices") (skill linalg) (module sparse) (tier 0) (difficulty 405) (name sparse-coo-row-indices) (type "") (description "") (notes ()) (section coo-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols)) (answer "(define (sparse-coo-row-indices m) (list-ref m 3))"))
(task-entry (id "linalg/graph-laplacian/fiedler-vector") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 405) (name fiedler-vector) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity)) (answer "(define (fiedler-vector adj) (let* ((L (laplacian adj)) (n (matrix-rows L)) (result (symmetric-eigen L))) (if (and (pair? result) (eq? (car result) 'error)) result (let* ((eigenvalues (car result)) (eigenvectors (cdr result)) (idx (second-smallest-index eigenvalues))) (matrix-col eigenvectors idx)))))"))
(task-entry (id "linalg/svd/eigenvalues->singular-values") (skill linalg) (module svd) (tier 0) (difficulty 405) (name eigenvalues->singular-values) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat)) (answer "(define (eigenvalues->singular-values eigenvalues tol) (let* ((n (vector-length eigenvalues)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) result) (let ((ev (vector-ref eigenvalues i))) (vector-set! result i (if (> ev tol) (sqrt ev) 0))))))"))
