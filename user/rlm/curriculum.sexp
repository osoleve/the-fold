(task-entry (id "data/graph-homology/graph-euler-characteristic") (skill data) (module graph-homology) (tier 0) (difficulty 1306) (name graph-euler-characteristic) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;homology)) (available (graph->simplicial-complex graph-adjacency->simplicial-complex graph-betti-numbers graph-betti-numbers-from-adjacency cycle-basis-homology edges-from-z2-null-vector)) (answer "(define (graph-euler-characteristic edges vertices) (- (length vertices) (length edges)))"))
(task-entry (id "data/pagerank/make-google-matrix") (skill data) (module pagerank) (tier 0) (difficulty 1306) (name make-google-matrix) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations* adjacency->transition matrix-row-sum matrix-col-sum)) (answer "(define (make-google-matrix transition-matrix damping-factor) (let* ((n (matrix-rows transition-matrix)) (teleport (/ (- 1.0 damping-factor) n)) (google-data (make-vector (* n n) teleport))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let* ((idx (+ (* i n) j)) (m-ij (matrix-ref transition-matrix i j)) (g-ij (+ (* damping-factor m-ij) teleport))) (vector-set! google-data idx g-ij)))) (list 'matrix n n google-data)))"))
(task-entry (id "data/graph-matrix/*dense-adjacency-max-nodes*") (skill data) (module graph-matrix) (tier 0) (difficulty 1306) (name *dense-adjacency-max-nodes*) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count)) (answer "(define *dense-adjacency-max-nodes* 10000)"))
(task-entry (id "data/centrality/eigenvector-normalize") (skill data) (module centrality) (tier 0) (difficulty 1306) (name eigenvector-normalize) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation)) (answer "(define (eigenvector-normalize v) (let* ((n (vector-length v)) (sum (vec-fold + 0 v)) (v-pos (if (< sum 0) (vec-scale -1 v) v)) (v-abs (vec-map abs v-pos)) (total (vec-fold + 0 v-abs))) (if (< total 1e-15) v-abs (vec-scale (/ 1.0 total) v-abs))))"))
(task-entry (id "data/graph-community/matrix-sum") (skill data) (module graph-community) (tier 0) (difficulty 1306) (name matrix-sum) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity)) (answer "(define (matrix-sum m) (let* ((n (matrix-rows m)) (c (matrix-cols m)) (data (matrix-data m))) (let loop ((i 0) (sum 0)) (if (= i (vector-length data)) sum (loop (+ i 1) (+ sum (vector-ref data i)))))))"))
