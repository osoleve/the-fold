(task-entry (id "data/graph-homology/graph-betti-numbers-from-adjacency") (skill data) (module graph-homology) (tier 0) (difficulty 1303) (name graph-betti-numbers-from-adjacency) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;homology)) (available (graph->simplicial-complex graph-adjacency->simplicial-complex graph-betti-numbers)) (answer "(define (graph-betti-numbers-from-adjacency adj) (let* ((vertices (map car adj)) (edges '())) (for-each (lambda (entry) (let ((v (car entry)) (neighbors (cdr entry))) (for-each (lambda (n) (when (< v n) (set! edges (cons (cons v n) edges)))) neighbors))) adj) (graph-betti-numbers edges vertices)))"))
(task-entry (id "data/pagerank/adjacency->transition") (skill data) (module pagerank) (tier 0) (difficulty 1303) (name adjacency->transition) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations*)) (answer "(define (adjacency->transition adj) (let* ((n (matrix-rows adj)) (m (matrix-cols adj))) (if (not (= n m)) (quasiquote (error not-square (unquote n) (unquote m))) (let* ((out-degrees (make-vector n 0)) (_ (do ((i 0 (+ i 1))) ((= i n)) (let ((row-sum (matrix-row-sum adj i))) (vector-set! out-degrees i row-sum)))) (trans-data (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let ((a-ij (matrix-ref adj i j)) (out-deg-i (vector-ref out-degrees i))) (vector-set! trans-data (+ (* j n) i) (if (= out-deg-i 0) (/ 1.0 n) (/ a-ij out-deg-i)))))) (list 'matrix n n trans-data)))))"))
(task-entry (id "data/graph-matrix/edge-to") (skill data) (module graph-matrix) (tier 0) (difficulty 1303) (name edge-to) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from)) (answer "(define (edge-to edge) (cadr edge))"))
(task-entry (id "data/centrality/eigenvector-power-iteration") (skill data) (module centrality) (tier 0) (difficulty 1303) (name eigenvector-power-iteration) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality)) (answer "(define (eigenvector-power-iteration adj v0 max-iter tol) (let loop ((v v0) (v-prev #f) (iter 0)) (if (>= iter max-iter) v (let* ((av (matrix-vec-mul adj v)) (av-norm (vec-norm av))) (if (< av-norm tol) v (let* ((v-new (vec-scale (/ 1.0 av-norm) av)) (vec-change (vec-distance v v-new))) (cond ((< vec-change tol) v-new) ((and v-prev (> iter 2) (< (vec-distance v-new v-prev) tol)) (eigenvector-average-oscillation v v-new)) (else (loop v-new v (+ iter 1))))))))))"))
(task-entry (id "data/graph-community/communities->partition") (skill data) (module graph-community) (tier 0) (difficulty 1303) (name communities->partition) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label)) (answer "(define (communities->partition labels) (let* ((n (vector-length labels)) (groups (make-hashtable equal-hash equal?))) (do ((i 0 (+ i 1))) ((= i n)) (let* ((lbl (vector-ref labels i)) (existing (hashtable-ref groups lbl '()))) (hashtable-set! groups lbl (cons i existing)))) (let* ((keys (hashtable-keys groups)) (sorted-keys (sort-by < (vector->list keys)))) (map (lambda (k) (reverse (hashtable-ref groups k '()))) sorted-keys))))"))
