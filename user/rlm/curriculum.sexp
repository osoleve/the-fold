(task-entry (id "optics/format-iso/sexpr->bytevector") (skill optics) (module format-iso) (tier 1) (difficulty 11005) (name sexpr->bytevector) (type "(-> Any Bytevector)") (description "Convert S-expression to UTF-8 encoded bytevector.") (notes ()) (section sexpr-bytevector) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string)) (answer "(define (sexpr->bytevector obj) (string->utf8 (format \"~s\" obj)))"))
(task-entry (id "optics/schema/field-split-iso") (skill optics) (module schema) (tier 1) (difficulty 11005) (name field-split-iso) (type "(-> Symbol (List Symbol) (-> a Alist) (-> Alist a) (PIso Alist Alist))") (description "Split one field into multiple fields") (notes ()) (section field-split-merge) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso)) (answer "(define (field-split-iso source-field target-fields splitter merger) (make-p-iso (lambda (alist) (let* ((pair (assq source-field alist)) (value (if pair (cdr pair) #f))) (if value (let ((split-values (splitter value))) (append split-values (filter (lambda (p) (not (eq? (car p) source-field))) alist))) alist))) (lambda (alist) (let ((target-pairs (filter (lambda (p) (memq (car p) target-fields)) alist))) (if (= (length target-pairs) (length target-fields)) (cons (cons source-field (merger target-pairs)) (filter (lambda (p) (not (memq (car p) target-fields))) alist)) alist)))))"))
(task-entry (id "optics/block-migration/block-migration-applies?") (skill optics) (module block-migration) (tier 1) (difficulty 11005) (name block-migration-applies?) (type "(-> BlockMigration Block Boolean)") (description "Check if this migration applies to the given block.") (notes ()) (section transformation) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag block-migration-to-tag block-migration-payload-iso)) (answer "(define (block-migration-applies? bm blk) (eq? (block-tag blk) (block-migration-from-tag bm)))"))
(task-entry (id "optics/optics/iso-over") (skill optics) (module optics) (tier 1) (difficulty 11006) (name iso-over) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review)) (answer "(define (iso-over iso f s) ((iso-backward iso) (f ((iso-forward iso) s))))"))
(task-entry (id "optics/block-optics/follow-ref") (skill optics) (module block-optics) (tier 1) (difficulty 11006) (name follow-ref) (type "(-> (-> Bytevector (Maybe Block)) (Affine Bytevector Block))") (description "Create an affine that follows a ref (hash) to its block.\nThe fetch function should be like CAS's fetch: hash -> Block | #f.\n\nNote: Setting through this affine is meaningless since hashes\nare derived from content. We return the ref unchanged.") (notes ()) (section cas-aware) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens block-ref-at block-refs-each block-refs-count)) (answer "(define (follow-ref fetch) (make-affine (lambda (ref) (let ((blk (fetch ref))) (if blk (just blk) nothing))) (lambda (_new-block ref) ref)))"))
