(task-entry (id "diffgeo/curvature/surface-partial-uu") (skill diffgeo) (module curvature) (tier 1) (difficulty 10739) (name surface-partial-uu) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols compute-metric-derivatives christoffel-ref riemann-tensor compute-christoffel-derivatives make-4d-array array-4d-ref array-4d-set! dgamma-ref riemann-ref ricci-tensor scalar-curvature surface? surface-param make-surface surface-at first-fundamental-form second-fundamental-form gaussian-curvature mean-curvature principal-curvatures surface-partial-u surface-partial-v)) (answer "(define (surface-partial-uu surf u v eps) (let ((r-plus (surface-at surf (+ u eps) v)) (r-center (surface-at surf u v)) (r-minus (surface-at surf (- u eps) v))) (vec-scale (/ 1.0 (* eps eps)) (vec-add (vec-sub r-plus r-center) (vec-sub r-minus r-center)))))"))
