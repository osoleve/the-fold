(task-entry (id "control-systems/controller-design/pid-design-lambda") (skill control-systems) (module controller-design) (tier 2) (difficulty 22604) (name pid-design-lambda) (type "Number × Number × Number × Number → (Kp Ki Kd)") (description "Lambda tuning method (IMC variant)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc)) (answer "(define (pid-design-lambda K tau theta lambda) (let* ((Kp (/ tau (* K (+ lambda theta)))) (Ti tau) (Ki (/ Kp Ti))) (list Kp Ki 0)))"))
