(task-entry (id "linalg/matrix/matrix-equal?") (skill linalg) (module matrix) (tier 0) (difficulty 424) (name matrix-equal?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose matrix-map matrix-map2 matrix-fold matrix-add matrix-sub matrix-hadamard matrix-scale matrix-negate matrix-mul matrix-vec-mul vec-matrix-mul)) (answer "(define (matrix-equal? m1 m2) (and (= (matrix-rows m1) (matrix-rows m2)) (= (matrix-cols m1) (matrix-cols m2)) (vec-equal? (matrix-data m1) (matrix-data m2))))"))
(task-entry (id "linalg/matrix-eigen/verify-decomposition") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 424) (name verify-decomposition) (type "") (description "") (notes ()) (section symmetric-eigen) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop eigen-decomposition symmetric-eigen symmetric-eigen-loop symmetric-converged? spectral-radius eigenvalue-condition eigenvalues eigenvectors verify-eigenvalue)) (answer "(define (verify-decomposition a eigenvalues eigenvectors . opts) (let* ((tol (if (pair? opts) (car opts) (* 100 *eigen-tolerance*))) (n (matrix-rows a))) (let loop ((i 0)) (if (= i n) #t (let* ((lambda-i (vector-ref eigenvalues i)) (v-i (matrix-col eigenvectors i))) (if (verify-eigenvalue a lambda-i v-i tol) (loop (+ i 1)) #f))))))"))
(task-entry (id "linalg/iterative-solvers/spectral-radius-estimate") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 424) (name spectral-radius-estimate) (type "") (description "") (notes ()) (section utilities) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres gmres-outer gmres-arnoldi gmres-arnoldi-loop apply-givens-rotations compute-givens gmres-solve-update vector-copy make-jacobi-preconditioner is-diagonally-dominant?)) (answer "(define (spectral-radius-estimate a . opts) (let* ((max-iter (if (pair? opts) (car opts) 100)) (n (matrix-rows a)) (v (make-vector n 1.0)) (norm-v (vec-norm v)) (v (vec-scale (/ 1.0 norm-v) v))) (let loop ((iter 0) (v-curr v) (lambda-prev 0.0)) (if (>= iter max-iter) lambda-prev (let* ((av (matrix-vec-mul a v-curr)) (lambda-new (vec-dot v-curr av)) (av-norm (vec-norm av))) (if (< av-norm *iterative-tolerance*) 0.0 (let ((v-new (vec-scale (/ 1.0 av-norm) av))) (if (< (abs (- lambda-new lambda-prev)) *iterative-tolerance*) lambda-new (loop (+ iter 1) v-new lambda-new)))))))))"))
(task-entry (id "linalg/sparse/sparse-csc-rows") (skill linalg) (module sparse) (tier 0) (difficulty 424) (name sparse-csc-rows) (type "") (description "") (notes ()) (section csr-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr? make-sparse-csr sparse-csr-rows sparse-csr-cols sparse-csr-row-ptrs sparse-csr-col-indices sparse-csr-values sparse-csr-nnz sparse-csr-ref sparse-csr-row sparse-csr-row-alist sparse-csc? make-sparse-csc)) (answer "(define (sparse-csc-rows m) (list-ref m 1))"))
(task-entry (id "linalg/graph-laplacian/k-smallest-indices") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 424) (name k-smallest-indices) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue is-bipartite-spectral? effective-resistance total-effective-resistance laplacian-summary spectral-clustering spectral-clustering-unnorm)) (answer "(define (k-smallest-indices v k) (let* ((n (vector-length v)) (pairs (let loop ((i 0) (acc '())) (if (= i n) acc (loop (+ i 1) (cons (cons (abs (vector-ref v i)) i) acc))))) (sorted (sort-by (lambda (a b) (< (car a) (car b))) pairs)) (k-actual (min k n))) (let loop ((remaining sorted) (count 0) (result '())) (if (or (= count k-actual) (null? remaining)) (reverse result) (loop (cdr remaining) (+ count 1) (cons (cdar remaining) result))))))"))
(task-entry (id "linalg/svd/matrix-frobenius-norm") (skill linalg) (module svd) (tier 0) (difficulty 424) (name matrix-frobenius-norm) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin matrix-slice-cols matrix-slice pseudoinverse build-sigma-pseudoinverse low-rank-approx matrix-rank matrix-condition-number singular-values sort-vector-descending verify-svd)) (answer "(define (matrix-frobenius-norm m) (let* ((data (matrix-data m)) (n (vector-length data))) (sqrt (let loop ((i 0) (sum 0)) (if (= i n) sum (let ((x (vector-ref data i))) (loop (+ i 1) (+ sum (* x x)))))))))"))
