(task-entry (id "game-theory/fair-division/proportional?") (skill game-theory) (module fair-division) (tier 1) (difficulty 13217) (name proportional?) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list)) (answer "(define (proportional? c div) (let* ((n (cake-players c)) (threshold (/ 1 n))) (let loop ((i 0)) (if (>= i n) #t (let* ((total (cake-total-value c i)) (received (piece-value c i (division-piece div i))) (share (if (= total 0) 1 (/ received total)))) (and (>= share (- threshold 1e-6)) (loop (+ i 1))))))))"))
(task-entry (id "game-theory/mechanism/with-reserve") (skill game-theory) (module mechanism) (tier 1) (difficulty 13217) (name with-reserve) (type "(-> (-> (Vector Number) AuctionOutcome) Number (-> (Vector Number) AuctionOutcome))") (description "Wrap an auction with a reserve price") (notes ("For scalar-payment auctions, ensures winner pays at least reserve. For vector-payment auctions (all-pay), the reserve filters eligible bidders but payments are unchanged.")) (section reserve-prices) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction)) (answer "(define (with-reserve auction reserve-price) (lambda (bids) (let* ((n (bids-length bids)) (filtered-bids (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((b (bids-ref bids i))) (vector-set! filtered-bids i (if (>= b reserve-price) b 0)))) (if (> (bids-max filtered-bids) 0) (let ((result (auction filtered-bids))) (let ((winner (auction-outcome-winner result)) (payment (auction-outcome-payment result))) (if (vector? payment) result (make-auction-outcome winner (max payment reserve-price))))) (make-auction-outcome #f 0)))))"))
