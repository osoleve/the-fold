(task-entry (id "numeric/spectral-analysis/spectral-centroid") (skill numeric) (module spectral-analysis) (tier 0) (difficulty 2510) (name spectral-centroid) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;window-functions)) (available (stft-frame stft istft spectrogram power-spectrogram log-spectrogram periodogram welch-psd spectrogram-frequencies spectrogram-times)) (answer "(define (spectral-centroid freqs power-spectrum) (let ((n (vector-length power-spectrum))) (let loop ((k 0) (weighted-sum 0) (total-power 0)) (if (= k n) (if (< total-power 1e-10) 0 (/ weighted-sum total-power)) (let ((freq (vector-ref freqs k)) (power (vector-ref power-spectrum k))) (loop (+ k 1) (+ weighted-sum (* freq power)) (+ total-power power)))))))"))
(task-entry (id "numeric/signal-poly/sig-poly-mul") (skill numeric) (module signal-poly) (tier 0) (difficulty 2510) (name sig-poly-mul) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;digital-filters)) (available (Q-field-sig sig-make-polynomial sig-normalize-coeffs sig-poly-field sig-poly-coeffs sig-poly-degree sig-poly-zero? sig-poly-leading sig-poly-add sig-poly-sub)) (answer "(define (sig-poly-mul p1 p2) (let* ((F (sig-poly-field p1)) (c1 (sig-poly-coeffs p1)) (c2 (sig-poly-coeffs p2)) (n1 (length c1)) (n2 (length c2)) (n (+ n1 n2 -1)) (result (make-list n 0))) (let loop1 ((i 0) (res result)) (if (>= i n1) (sig-make-polynomial F res) (loop1 (+ i 1) (let loop2 ((j 0) (r res)) (if (>= j n2) r (loop2 (+ j 1) (list-set r (+ i j) (+ (list-ref r (+ i j)) (* (list-ref c1 i) (list-ref c2 j))))))))))))"))
