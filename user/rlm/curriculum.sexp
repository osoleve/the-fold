(task-entry (id "random/distributions/random-normal") (skill random) (module distributions) (tier 1) (difficulty 12920) (name random-normal) (type "(-> Number Number (State RNG Number))") (description "State monad sampler for normal distribution") (notes ()) (section normal-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile)) (answer "(define (random-normal mean stddev) (if (<= stddev 0) (error 'random-normal \"stddev must be positive\" stddev) (state-map (lambda (z) (+ mean (* stddev z))) random-normal-standard)))"))
