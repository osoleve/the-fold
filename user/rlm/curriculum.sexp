(task-entry (id "fp/solve/back-substitute-symbolic") (skill fp) (module solve) (tier 1) (difficulty 10632) (name back-substitute-symbolic) (type "") (description "") (notes ()) (section linear-systems) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms solve-linear solve-quadratic solve-cubic solve-polynomial diff-to-sum solve solve-for solve-linear-system build-coefficient-matrix augment-with-constants gaussian-eliminate-symbolic find-nonzero-pivot is-zero-expr? swap-rows eliminate-below)) (answer "(define (back-substitute-symbolic matrix vars) (let ((n (length vars))) (let loop ((row (- n 1)) (solutions '())) (if (< row 0) solutions (let* ((mat-row (list-ref matrix row)) (rhs (list-ref mat-row n)) (pivot (list-ref mat-row row))) (if (is-zero-expr? pivot) #f (let* ((sum-of-known (fold-left (lambda (acc pair) (let ((col (car pair)) (val (cdr pair))) (if (> col row) (let ((var-sol (assq (list-ref vars col) solutions))) (if var-sol (sum acc (product (list-ref mat-row col) (cdr var-sol))) acc)) acc))) (num 0) (map cons (iota n) (iota n)))) (solution (simplify (division (difference rhs sum-of-known) pivot)))) (loop (- row 1) (cons (cons (list-ref vars row) solution) solutions)))))))))"))
(task-entry (id "fp/units/qty-pow") (skill fp) (module units) (tier 1) (difficulty 10632) (name qty-pow) (type "(-> Quantity Int Quantity)") (description "Raise quantity to integer power.") (notes ()) (section quantity-arithmetic) (deps (\x27;prelude)) (available (make-dim dim-length dim-time dim-mass dim-current dim-temperature dim-amount dim-luminosity dim? dim=? dim-one dim-length-base dim-time-base dim-mass-base dim-current-base dim-temperature-base dim-amount-base dim-luminosity-base dim* dim/ dim-pow dim-sqrt dim-inv make-qty qty-value qty-dim qty? qty+ qty- qty* qty/ qty-scale)) (answer "(define (qty-pow q n) (let ((v (qty-value q))) (if (and (= v 0) (< n 0)) (error 'qty-pow \"division by zero: 0^(negative exponent)\") (make-qty (expt v n) (dim-pow (qty-dim q) n)))))"))
