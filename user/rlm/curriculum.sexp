(task-entry (id "linalg/sparse/coo->csc") (skill linalg) (module sparse) (tier 0) (difficulty 433) (name coo->csc) (type "") (description "") (notes ()) (section format-conversions) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr? make-sparse-csr sparse-csr-rows sparse-csr-cols sparse-csr-row-ptrs sparse-csr-col-indices sparse-csr-values sparse-csr-nnz sparse-csr-ref sparse-csr-row sparse-csr-row-alist sparse-csc? make-sparse-csc sparse-csc-rows sparse-csc-cols sparse-csc-col-ptrs sparse-csc-row-indices sparse-csc-values sparse-csc-nnz sparse-csc-ref sparse-csc-col coo->csr)) (answer "(define (coo->csc coo) (let* ((rows (sparse-coo-rows coo)) (cols (sparse-coo-cols coo)) (row-idx (sparse-coo-row-indices coo)) (col-idx (sparse-coo-col-indices coo)) (vals (sparse-coo-values coo)) (nnz (sparse-coo-nnz coo))) (if (= nnz 0) (let ((col-ptrs (make-vector (+ cols 1) 0))) (make-sparse-csc rows cols col-ptrs (make-vector 0 0) (make-vector 0 0))) (let* ((indices (make-vector nnz 0))) (do ((k 0 (+ k 1))) ((= k nnz)) (vector-set! indices k k)) (vector-sort-by! (lambda (a b) (let ((ca (vector-ref col-idx a)) (cb (vector-ref col-idx b))) (or (< ca cb) (and (= ca cb) (< (vector-ref row-idx a) (vector-ref row-idx b)))))) indices) (let ((col-ptrs (make-vector (+ cols 1) 0)) (out-rows (make-vector nnz 0)) (out-vals (make-vector nnz 0))) (do ((k 0 (+ k 1)) (current-col 0 (vector-ref col-idx (vector-ref indices k)))) ((= k nnz) (do ((c (+ current-col 1) (+ c 1))) ((> c cols)) (vector-set! col-ptrs c nnz))) (let* ((idx (vector-ref indices k)) (r (vector-ref row-idx idx)) (c (vector-ref col-idx idx)) (v (vector-ref vals idx))) (when (> c current-col) (do ((prev-col (+ current-col 1) (+ prev-col 1))) ((> prev-col c)) (vector-set! col-ptrs prev-col k))) (vector-set! out-rows k r) (vector-set! out-vals k v))) (make-sparse-csc rows cols col-ptrs out-rows out-vals))))))"))
