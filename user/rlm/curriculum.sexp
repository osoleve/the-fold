(task-entry (id "game-theory/mcdm/dp-score") (skill game-theory) (module mcdm) (tier 1) (difficulty 13205) (name dp-score) (type "") (description "") (notes ()) (section decision-problem) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores)) (answer "(define (dp-score dp alt crit) (let ((found (find-score (dp-scores dp) alt crit))) (if found (caddr found) 0)))"))
