(task-entry (id "sim/ode-system/forced-oscillator") (skill sim) (module ode-system) (tier 2) (difficulty 23320) (name forced-oscillator) (type "(-> Number Number Number Any)") (description "Forced oscillator: d²x/dt² = -ω₀²x + A·cos(ωt). Non-autonomous system (time-dependent forcing). State: [position, velocity]") (notes ()) (section standard-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra lorenz-system van-der-pol pendulum)) (answer "(define (forced-oscillator omega0 omega-drive amplitude) (make-nonautonomous-ode (lambda (t state) (let ((x (vector-ref state 0)) (v (vector-ref state 1))) (vector v (+ (- (* omega0 omega0 x)) (* amplitude (cos (* omega-drive t))))))) 2))"))
(task-entry (id "sim/stability/stable?") (skill sim) (module stability) (tier 2) (difficulty 23320) (name stable?) (type "(-> Symbol Bool)") (description "Check if a stability type is stable") (notes ()) (section stability-predicates) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability)) (answer "(define (stable? stability-type) (if (memq stability-type '(stable-node stable-spiral)) #t #f))"))
(task-entry (id "sim/chaos/kaplan-yorke-dimension") (skill sim) (module chaos) (tier 2) (difficulty 23320) (name kaplan-yorke-dimension) (type "(-> (List Number) Number)") (description "Compute Kaplan-Yorke (Lyapunov) dimension from exponents") (notes ("Sorted exponents λ₁ ≥ λ₂ ≥ ... → D_KY = j + Σᵢ₌₁ʲλᵢ/|λⱼ₊₁| where j is largest index with Σλᵢ ≥ 0")) (section chaos-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent is-chaotic?)) (answer "(define (kaplan-yorke-dimension lyap-exponents) (let* ((sorted (sort-by > lyap-exponents)) (n (length sorted))) (let loop ((j 0) (sum 0.0)) (if (>= j n) (inexact n) (let ((new-sum (+ sum (list-ref sorted j)))) (if (< new-sum 0) (let ((prev-sum (- new-sum (list-ref sorted j))) (lambda-j (abs (list-ref sorted j)))) (if (> lambda-j *min-norm*) (+ j (/ prev-sum lambda-j)) (inexact j))) (loop (+ j 1) new-sum)))))))"))
(task-entry (id "sim/bifurcation/compute-tangent-at-fold") (skill sim) (module bifurcation) (tier 2) (difficulty 23320) (name compute-tangent-at-fold) (type "(-> Matrix Vec Nat (Option (Pair Vec Number)))") (description "Compute tangent when J_x is singular (at fold point)") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction)) (answer "(define (compute-tangent-at-fold jac-x jac-p n) (let* ((augmented (augment-with-column jac-x jac-p)) (svd-result (svd augmented))) (if (and (pair? svd-result) (eq? (car svd-result) 'error)) #f (let* ((v-matrix (caddr svd-result)) (last-col (- (matrix-cols v-matrix) 1)) (null-vec (extract-column v-matrix last-col)) (tangent-x (subvector null-vec 0 n)) (tangent-p (vector-ref null-vec n)) (norm (sqrt (+ (vec-dot tangent-x tangent-x) (* tangent-p tangent-p))))) (if (< norm 1e-10) #f (cons (vec-scale (/ 1.0 norm) tangent-x) (/ tangent-p norm)))))))"))
(task-entry (id "sim/attractor-render/render-spinning-attractor-colored") (skill sim) (module attractor-render) (tier 2) (difficulty 23320) (name render-spinning-attractor-colored) (type "(-> (List Vec) Nat Nat Number Nat (List String))") (description "Render N frames of spinning attractor (colored)") (notes ()) (section animation) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity! fb-to-string render-attractor render-attractor-colored render-spinning-attractor)) (answer "(define (render-spinning-attractor-colored trajectory width height scale n-frames) (let ((pi 3.14159265358979)) (map (lambda (i) (let* ((angle (* 2 pi (/ i n-frames))) (tilt 0.3)) (render-attractor-colored trajectory width height scale tilt angle 0))) (iota n-frames))))"))
