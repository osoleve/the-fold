(task-entry (id "numeric/affine/affine->interval") (skill numeric) (module affine) (tier 0) (difficulty 2510) (name affine->interval) (type "") (description "") (notes ()) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval)) (answer "(define (affine->interval af) (let ((x0 (affine-center af)) (terms (affine-terms af))) (let ((total-deviation (fold-left + 0 (map (lambda (t) (abs (cdr t))) terms)))) (make-interval (- x0 total-deviation) (+ x0 total-deviation)))))"))
