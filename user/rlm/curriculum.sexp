(task-entry (id "egraph/match/subst-try-extend") (skill egraph) (module match) (tier 1) (difficulty 10006) (name subst-try-extend) (type "(-> Substitution PatternVar EClassId (Or Substitution #f))") (description "Try to extend substitution. Returns #f if incompatible.") (notes ()) (section substitutions) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible?)) (answer "(define (subst-try-extend subst var class-id) (let ((existing (subst-lookup subst var))) (cond ((not existing) (subst-extend subst var class-id)) ((= existing class-id) subst) (else #f))))"))
