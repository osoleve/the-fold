(task-entry (id "game-theory/coop-games/core-excess") (skill game-theory) (module coop-games) (tier 1) (difficulty 13226) (name core-excess) (type "(-> CoopGame (Vector Real) Coalition Real)") (description "Excess of coalition S at allocation x. Positive means S would deviate.") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value)) (answer "(define (core-excess g x S) (let ((coalition-total (allocation-coalition-total x S)) (v-S (coop-game-value g S))) (if (coop-game-cost? g) (- coalition-total v-S) (- v-S coalition-total))))"))
(task-entry (id "game-theory/matching/optimal-assignment-subset") (skill game-theory) (module matching) (tier 1) (difficulty 13226) (name optimal-assignment-subset) (type "") (description "") (notes ()) (section assignment-games) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value)) (answer "(define (optimal-assignment-subset props recvs n valuation) (let* ((num-props (length props)) (num-recvs (length recvs)) (prop-vec (list->vector props)) (recv-vec (list->vector recvs)) (num-vars (* num-props num-recvs)) (num-constraints (+ num-props num-recvs)) (num-slacks num-constraints) (total-vars (+ num-vars num-slacks)) (c (make-vector total-vars 0)) (A (make-matrix num-constraints total-vars 0)) (b (make-vector num-constraints 1))) (do ((i 0 (+ i 1))) ((= i num-props)) (do ((j 0 (+ j 1))) ((= j num-recvs)) (let ((var-idx (+ (* i num-recvs) j)) (p-idx (vector-ref prop-vec i)) (r-idx (- (vector-ref recv-vec j) n))) (vector-set! c var-idx (- (valuation p-idx r-idx)))))) (do ((i 0 (+ i 1))) ((= i num-props)) (do ((j 0 (+ j 1))) ((= j num-recvs)) (let ((var-idx (+ (* i num-recvs) j))) (matrix-set! A i var-idx 1))) (matrix-set! A i (+ num-vars i) 1)) (do ((j 0 (+ j 1))) ((= j num-recvs)) (do ((i 0 (+ i 1))) ((= i num-props)) (let ((var-idx (+ (* i num-recvs) j))) (matrix-set! A (+ num-props j) var-idx 1))) (matrix-set! A (+ num-props j) (+ num-vars num-props j) 1)) (let ((lp (make-lp c A b))) (let ((result (lp-solve lp))) (if (lp-optimal? result) (- (lp-result-z result)) 0)))))"))
(task-entry (id "game-theory/voting/condorcet-winner?") (skill game-theory) (module voting) (tier 1) (difficulty 13226) (name condorcet-winner?) (type "") (description "") (notes ()) (section condorcet-methods) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats?)) (answer "(define (condorcet-winner? candidate profile) (let ((others (remove candidate (profile-candidates profile)))) (for-all? (lambda (other) (pairwise-beats? candidate other profile)) others)))"))
(task-entry (id "game-theory/multi-winner/monroe-greedy") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13226) (name monroe-greedy) (type "") (description "") (notes ()) (section monroe) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction)) (answer "(define (monroe-greedy profile num-seats) (if (profile-empty? profile) '() (let* ((candidates (profile-candidates profile)) (num-voters (profile-voters profile)) (num-candidates (length candidates)) (voters-per-rep (floor (/ num-voters num-seats)))) (monroe-loop profile candidates '() num-seats num-candidates))))"))
(task-entry (id "game-theory/fair-division/find-cut-point-from") (skill game-theory) (module fair-division) (tier 1) (difficulty 13226) (name find-cut-point-from) (type "") (description "") (notes ()) (section dubins-spanier) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse)) (answer "(define (find-cut-point-from c i start target fuel) (if (<= target 0) start (let ((total (cake-valuation c i start 1))) (if (>= target total) 1 (binary-search-cut-from c i start target start 1 fuel)))))"))
(task-entry (id "game-theory/mechanism/vcg-total-welfare") (skill game-theory) (module mechanism) (tier 1) (difficulty 13226) (name vcg-total-welfare) (type "(-> (Vector (Vector Number)) (Vector Nat) Number)") (description "") (notes ()) (section vcg-mechanism) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without)) (answer "(define (vcg-total-welfare valuations allocation) (let ((n (vector-length allocation))) (let loop ((i 0) (total 0)) (if (>= i n) total (loop (+ i 1) (+ total (vector-ref (vector-ref valuations i) (vector-ref allocation i))))))))"))
(task-entry (id "game-theory/evolutionary/replicator-converge") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13226) (name replicator-converge) (type "(-> SymmetricGame Population Number Number Nat Result)") (description "") (notes ()) (section replicator-dynamics) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory)) (answer "(define (replicator-converge game pop dt tolerance max-iter) (let loop ((current pop) (iter 0)) (if (>= iter max-iter) (list 'error 'max-iter current iter) (let* ((derivs (replicator-derivative game current)) (max-deriv (apply max (map abs derivs)))) (if (< max-deriv tolerance) (list 'ok current iter) (loop (replicator-step game current dt) (+ iter 1)))))))"))
(task-entry (id "game-theory/mcdm/min-robustness") (skill game-theory) (module mcdm) (tier 1) (difficulty 13226) (name min-robustness) (type "(-> DecisionProblem (List Real) Real)") (description "Overall decision robustness: smallest margin across all criteria. Higher = more confident in choice") (notes ()) (section sensitivity-analysis) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index list-update robustness-profile)) (answer "(define (min-robustness dp base-weights) (let ((profile (robustness-profile dp base-weights))) (apply min (map (lambda (p) (abs (cdr p))) profile))))"))
(task-entry (id "game-theory/normal-form/strategy-payoff-vs-mixed") (skill game-theory) (module normal-form) (tier 1) (difficulty 13227) (name strategy-payoff-vs-mixed) (type "") (description "") (notes ()) (section mixed-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds is-pure-nash? find-pure-nash make-mixed-strategy pure-strategy uniform-strategy expected-payoff-p1 expected-payoff-p2)) (answer "(define (strategy-payoff-vs-mixed game player strategy opp-mixed) (if (= player 0) (let ((n2 (vector-length opp-mixed))) (apply + (map (lambda (j) (* (vector-ref opp-mixed j) (game-payoff-p1 game strategy j))) (iota n2)))) (let ((n1 (vector-length opp-mixed))) (apply + (map (lambda (i) (* (vector-ref opp-mixed i) (game-payoff-p2 game i strategy))) (iota n1))))))"))
(task-entry (id "game-theory/extensive-form/spe-payoffs") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13227) (name spe-payoffs) (type "(-> SPEResult (List Number))") (description "") (notes ()) (section subgame-perfect-equilibrium) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result?)) (answer "(define (spe-payoffs result) (cadr result))"))
(task-entry (id "game-theory/coop-games/allocation-in-core?") (skill game-theory) (module coop-games) (tier 1) (difficulty 13227) (name allocation-in-core?) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess)) (answer "(define (allocation-in-core? g x) (let ((n (coop-game-players g)) (grand (coop-game-grand-coalition g))) (and (= (allocation-total x) (coop-game-value g grand)) (let loop ((S 0)) (if (> S grand) #t (and (<= (core-excess g x S) 0) (loop (+ S 1))))))))"))
(task-entry (id "game-theory/matching/optimal-assignment") (skill game-theory) (module matching) (tier 1) (difficulty 13227) (name optimal-assignment) (type "(-> Nat Nat (Nat Nat -> Real) (List (Nat . Nat) . Real))") (description "Compute optimal assignment and its total value. Returns ((matches ...) . total-value) where matches are (prop . recv) pairs") (notes ()) (section optimal-assignment) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset)) (answer "(define (optimal-assignment n m valuation) (let* ((num-vars (* n m)) (num-constraints (+ n m)) (num-slacks num-constraints) (total-vars (+ num-vars num-slacks)) (c (make-vector total-vars 0)) (A (make-matrix num-constraints total-vars 0)) (b (make-vector num-constraints 1))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j m)) (let ((var-idx (+ (* i m) j))) (vector-set! c var-idx (- (valuation i j)))))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j m)) (matrix-set! A i (+ (* i m) j) 1)) (matrix-set! A i (+ num-vars i) 1)) (do ((j 0 (+ j 1))) ((= j m)) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! A (+ n j) (+ (* i m) j) 1)) (matrix-set! A (+ n j) (+ num-vars n j) 1)) (let* ((lp (make-lp c A b)) (result (lp-solve lp))) (if (lp-optimal? result) (let* ((x (lp-result-x result)) (total (- (lp-result-z result))) (matches (extract-assignment-matches x n m))) (cons matches total)) (cons '() 0)))))"))
(task-entry (id "game-theory/voting/condorcet-winner") (skill game-theory) (module voting) (tier 1) (difficulty 13227) (name condorcet-winner) (type "") (description "") (notes ()) (section condorcet-methods) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner?)) (answer "(define (condorcet-winner profile) (let ((candidates (profile-candidates profile))) (let loop ((cs candidates)) (cond ((null? cs) #f) ((condorcet-winner? (car cs) profile) (car cs)) (else (loop (cdr cs)))))))"))
(task-entry (id "game-theory/multi-winner/monroe-loop") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13227) (name monroe-loop) (type "") (description "") (notes ()) (section monroe) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy)) (answer "(define (monroe-loop profile remaining elected seats-left num-candidates) (if (or (= seats-left 0) (null? remaining)) (reverse elected) (let* ((scores (map (lambda (c) (cons c (monroe-candidate-score c profile elected num-candidates))) remaining)) (sorted (sort-by (lambda (a b) (> (cdr a) (cdr b))) scores)) (winner (caar sorted))) (monroe-loop profile (remove winner remaining) (cons winner elected) (- seats-left 1) num-candidates))))"))
(task-entry (id "game-theory/fair-division/binary-search-cut-from") (skill game-theory) (module fair-division) (tier 1) (difficulty 13227) (name binary-search-cut-from) (type "") (description "") (notes ()) (section dubins-spanier) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from)) (answer "(define (binary-search-cut-from c i start target lo hi fuel) (if (<= fuel 0) (/ (+ lo hi) 2) (let* ((mid (/ (+ lo hi) 2)) (val (cake-valuation c i start mid))) (cond ((< (abs (- val target)) 1e-10) mid) ((< val target) (binary-search-cut-from c i start target mid hi (- fuel 1))) (else (binary-search-cut-from c i start target lo mid (- fuel 1)))))))"))
(task-entry (id "game-theory/mechanism/vcg-total-welfare-without") (skill game-theory) (module mechanism) (tier 1) (difficulty 13227) (name vcg-total-welfare-without) (type "(-> (Vector (Vector Number)) (Vector Nat) Nat Number)") (description "") (notes ()) (section vcg-mechanism) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare)) (answer "(define (vcg-total-welfare-without valuations allocation excluded) (let ((n (vector-length allocation))) (let loop ((i 0) (total 0)) (if (>= i n) total (if (= i excluded) (loop (+ i 1) total) (loop (+ i 1) (+ total (vector-ref (vector-ref valuations i) (vector-ref allocation i)))))))))"))
(task-entry (id "game-theory/evolutionary/is-ess?") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13227) (name is-ess?) (type "(-> SymmetricGame Nat Boolean)") (description "") (notes ()) (section ess) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge)) (answer "(define (is-ess? game i) (let ((n (sg-num-strategies game)) (aii (sg-payoff game i i))) (let loop ((j 0)) (cond ((>= j n) #t) ((= j i) (loop (+ j 1))) (else (let ((aji (sg-payoff game j i)) (aij (sg-payoff game i j)) (ajj (sg-payoff game j j))) (and (or (> aii aji) (and (= aii aji) (> aij ajj))) (loop (+ j 1)))))))))"))
(task-entry (id "game-theory/mcdm/has-condorcet-cycle?") (skill game-theory) (module mcdm) (tier 1) (difficulty 13227) (name has-condorcet-cycle?) (type "(-> DecisionProblem Boolean)") (description "Check for Condorcet paradox (cyclic preferences). If true, there's no clear 'best' and method choice matters more") (notes ()) (section cycle-detection) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index list-update robustness-profile min-robustness)) (answer "(define (has-condorcet-cycle? dp) (not (mcdm-condorcet dp)))"))
(task-entry (id "game-theory/normal-form/solve-2x2-nash") (skill game-theory) (module normal-form) (tier 1) (difficulty 13228) (name solve-2x2-nash) (type "(-> Game (List (Pair (Vector Number) (Vector Number))))") (description "Find all Nash equilibria (pure and mixed) for a 2x2 game using the indifference principle. Returns list of (sigma1 . sigma2) pairs") (notes ()) (section \x32;x2-mixed-nash) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds is-pure-nash? find-pure-nash make-mixed-strategy pure-strategy uniform-strategy expected-payoff-p1 expected-payoff-p2 strategy-payoff-vs-mixed)) (answer "(define (solve-2x2-nash game) (if (or (not (= 2 (game-num-strategies game 0))) (not (= 2 (game-num-strategies game 1)))) '() (let* ((epsilon 1e-10) (a (game-payoff-p1 game 0 0)) (b (game-payoff-p1 game 0 1)) (c (game-payoff-p1 game 1 0)) (d (game-payoff-p1 game 1 1)) (e (game-payoff-p2 game 0 0)) (f (game-payoff-p2 game 0 1)) (g (game-payoff-p2 game 1 0)) (h (game-payoff-p2 game 1 1)) (pure-nash (find-pure-nash game)) (pure-results (map (lambda (profile) (cons (pure-strategy (car profile) 2) (pure-strategy (cdr profile) 2))) pure-nash)) (denom1 (- (+ a d) (+ b c))) (q (if (< (abs denom1) epsilon) #f (/ (- d b) denom1))) (denom2 (- (+ e h) (+ f g))) (p (if (< (abs denom2) epsilon) #f (/ (- h g) denom2))) (mixed-valid? (and q p (>= q 0) (<= q 1) (>= p 0) (<= p 1) (not (and (or (< (abs p) epsilon) (< (abs (- p 1)) epsilon)) (or (< (abs q) epsilon) (< (abs (- q 1)) epsilon)))))) (mixed-result (if mixed-valid? (list (cons (make-mixed-strategy (list p (- 1 p))) (make-mixed-strategy (list q (- 1 q))))) '()))) (append pure-results mixed-result))))"))
(task-entry (id "game-theory/extensive-form/spe-strategy") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13228) (name spe-strategy) (type "(-> SPEResult (List (Pair Nat Symbol)))") (description "List of (player . action) pairs representing equilibrium play") (notes ()) (section subgame-perfect-equilibrium) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs)) (answer "(define (spe-strategy result) (caddr result))"))
(task-entry (id "game-theory/coop-games/max-excess") (skill game-theory) (module coop-games) (tier 1) (difficulty 13228) (name max-excess) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core?)) (answer "(define (max-excess g x) (let ((n (coop-game-players g)) (grand (coop-game-grand-coalition g))) (let loop ((S 1) (max-e (core-excess g x 1))) (if (> S grand) max-e (loop (+ S 1) (max max-e (core-excess g x S)))))))"))
(task-entry (id "game-theory/matching/extract-assignment-matches") (skill game-theory) (module matching) (tier 1) (difficulty 13228) (name extract-assignment-matches) (type "") (description "") (notes ()) (section optimal-assignment) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment)) (answer "(define (extract-assignment-matches x n m) (let loop ((i 0) (j 0) (result '())) (cond ((= i n) (reverse result)) ((= j m) (loop (+ i 1) 0 result)) (else (let ((val (vector-ref x (+ (* i m) j)))) (loop i (+ j 1) (if (> val 0.5) (cons (cons i j) result) result)))))))"))
(task-entry (id "game-theory/voting/condorcet-loser?") (skill game-theory) (module voting) (tier 1) (difficulty 13228) (name condorcet-loser?) (type "") (description "") (notes ()) (section condorcet-methods) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner)) (answer "(define (condorcet-loser? candidate profile) (let ((others (remove candidate (profile-candidates profile)))) (for-all? (lambda (other) (pairwise-beats? other candidate profile)) others)))"))
(task-entry (id "game-theory/multi-winner/monroe-candidate-score") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13228) (name monroe-candidate-score) (type "") (description "") (notes ()) (section monroe) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop)) (answer "(define (monroe-candidate-score candidate profile elected num-candidates) (apply + (map (lambda (ranking) (let ((new-sat (voter-satisfaction ranking candidate num-candidates)) (best-existing (best-satisfaction ranking elected num-candidates))) (max 0 (- new-sat best-existing)))) profile)))"))
(task-entry (id "game-theory/fair-division/list-index") (skill game-theory) (module fair-division) (tier 1) (difficulty 13228) (name list-index) (type "") (description "") (notes ()) (section dubins-spanier) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from)) (answer "(define (list-index pred lst) (let loop ((lst lst) (i 0)) (cond ((null? lst) #f) ((pred (car lst)) i) (else (loop (cdr lst) (+ i 1))))))"))
(task-entry (id "game-theory/mechanism/vcg-enumerate-allocations") (skill game-theory) (module mechanism) (tier 1) (difficulty 13228) (name vcg-enumerate-allocations) (type "(-> Nat Nat (-> (Vector Nat) Void) Void)") (description "Enumerate all valid allocations (disjoint bundles) and call callback") (notes ()) (section vcg-mechanism) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without)) (answer "(define (vcg-enumerate-allocations n m callback) (let ((allocation (make-vector n 0))) (vcg-enumerate-helper allocation n m 0 0 callback)))"))
(task-entry (id "game-theory/evolutionary/find-all-ess") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13228) (name find-all-ess) (type "(-> SymmetricGame (List Nat))") (description "") (notes ()) (section ess) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge is-ess?)) (answer "(define (find-all-ess game) (filter (lambda (i) (is-ess? game i)) (iota (sg-num-strategies game))))"))
(task-entry (id "game-theory/mcdm/cycle-participants") (skill game-theory) (module mcdm) (tier 1) (difficulty 13228) (name cycle-participants) (type "(-> DecisionProblem (List Alternative))") (description "Find alternatives in Condorcet cycles. If non-empty and no Condorcet winner, these alternatives are in a cycle") (notes ()) (section cycle-detection) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index list-update robustness-profile min-robustness has-condorcet-cycle?)) (answer "(define (cycle-participants dp) (if (not (has-condorcet-cycle? dp)) '() (smith-set (dp->profile dp))))"))
(task-entry (id "game-theory/normal-form/game->string") (skill game-theory) (module normal-form) (tier 1) (difficulty 13229) (name game->string) (type "(-> Game String)") (description "Display a game as a payoff matrix") (notes ()) (section game-display) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds is-pure-nash? find-pure-nash make-mixed-strategy pure-strategy uniform-strategy expected-payoff-p1 expected-payoff-p2 strategy-payoff-vs-mixed solve-2x2-nash)) (answer "(define (game->string game) (let* ((s1 (game%-strategies1 game)) (s2 (game%-strategies2 game)) (n1 (vector-length s1)) (n2 (vector-length s2)) (header (string-append \"        \" (apply string-append (map (lambda (j) (string-append (symbol->string (vector-ref s2 j)) \"    \")) (iota n2))) \"\n\")) (rows (map (lambda (i) (string-append (symbol->string (vector-ref s1 i)) \": \" (apply string-append (map (lambda (j) (let ((p (game-payoff game i j))) (string-append \"(\" (number->string (car p)) \",\" (number->string (cdr p)) \") \"))) (iota n2))) \"\n\")) (iota n1)))) (apply string-append header rows)))"))
(task-entry (id "game-theory/extensive-form/expected-utility") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13229) (name expected-utility) (type "(-> Node Nat (-> Nat (List Symbol) Symbol) Number)") (description "Compute expected utility for a player given a behavioral strategy") (notes ()) (section expected-utility) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy)) (answer "(define (expected-utility node player strategy) (cond ((terminal? node) (terminal-payoff node player)) ((decision? node) (let* ((acting-player (decision-player node)) (actions (decision-actions node)) (chosen (strategy acting-player actions)) (child (decision-child node chosen))) (expected-utility child player strategy))) ((chance? node) (let* ((probs (chance-probs node)) (children (chance-children node)) (utils (map (lambda (c) (expected-utility c player strategy)) children))) (fold-right + 0 (map * probs utils)))) (else (error 'expected-utility \"unknown node type\" node))))"))
(task-entry (id "game-theory/coop-games/nucleolus") (skill game-theory) (module coop-games) (tier 1) (difficulty 13229) (name nucleolus) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess)) (answer "(define (nucleolus g fuel) (let* ((n (coop-game-players g)) (grand (coop-game-grand-coalition g)) (v-grand (coop-game-value g grand)) (coalitions (filter (lambda (S) (and (> S 0) (< S grand))) (all-coalitions n))) (num-coalitions (length coalitions)) (coalition-vec (list->vector coalitions))) (nucleolus-iterate g n v-grand coalition-vec '() fuel)))"))
(task-entry (id "game-theory/matching/make-medical-residency-market") (skill game-theory) (module matching) (tier 1) (difficulty 13229) (name make-medical-residency-market) (type "") (description "") (notes ()) (section optimal-assignment) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches)) (answer "(define (make-medical-residency-market students hospitals student-prefs hospital-prefs) (make-matching-market students hospitals student-prefs hospital-prefs))"))
(task-entry (id "game-theory/voting/copeland-score") (skill game-theory) (module voting) (tier 1) (difficulty 13229) (name copeland-score) (type "(-> Candidate PreferenceProfile Int)") (description "Compute Copeland score (wins - losses). Ties count as 0.5 for each (but we use integer: win=1, loss=-1, tie=0)") (notes ()) (section copeland-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser?)) (answer "(define (copeland-score candidate profile) (let ((others (remove candidate (profile-candidates profile)))) (apply + (map (lambda (other) (let ((margin (pairwise-margin candidate other profile))) (cond ((> margin 0) 1) ((< margin 0) -1) (else 0)))) others))))"))
(task-entry (id "game-theory/multi-winner/best-satisfaction") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13229) (name best-satisfaction) (type "") (description "") (notes ()) (section monroe) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score)) (answer "(define (best-satisfaction ranking elected num-candidates) (if (null? elected) 0 (apply max (map (lambda (e) (voter-satisfaction ranking e num-candidates)) elected))))"))
(task-entry (id "game-theory/fair-division/remove") (skill game-theory) (module fair-division) (tier 1) (difficulty 13229) (name remove) (type "") (description "") (notes ()) (section dubins-spanier) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index)) (answer "(define (remove x lst) (filter (lambda (y) (not (equal? x y))) lst))"))
(task-entry (id "game-theory/mechanism/vcg-enumerate-helper") (skill game-theory) (module mechanism) (tier 1) (difficulty 13229) (name vcg-enumerate-helper) (type "") (description "") (notes ()) (section vcg-mechanism) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations)) (answer "(define (vcg-enumerate-helper allocation n m agent used-items callback) (if (>= agent n) (callback allocation) (let ((num-bundles (expt 2 m))) (do ((bundle 0 (+ bundle 1))) ((= bundle num-bundles)) (when (= 0 (bitwise-and bundle used-items)) (vector-set! allocation agent bundle) (vcg-enumerate-helper allocation n m (+ agent 1) (bitwise-ior used-items bundle) callback))))))"))
(task-entry (id "game-theory/evolutionary/is-nash-equilibrium?") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13229) (name is-nash-equilibrium?) (type "(-> SymmetricGame Nat Boolean)") (description "") (notes ()) (section ess) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge is-ess? find-all-ess)) (answer "(define (is-nash-equilibrium? game i) (let ((n (sg-num-strategies game)) (aii (sg-payoff game i i))) (let loop ((j 0)) (cond ((>= j n) #t) ((= j i) (loop (+ j 1))) (else (and (>= aii (sg-payoff game j i)) (loop (+ j 1))))))))"))
(task-entry (id "game-theory/mcdm/method-agreement") (skill game-theory) (module mcdm) (tier 1) (difficulty 13229) (name method-agreement) (type "(-> DecisionProblem (List (Pair Symbol Alternative)))") (description "Compare winners across methods. Agreement suggests robust choice; disagreement suggests sensitivity to aggregation method") (notes ()) (section comparison) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index list-update robustness-profile min-robustness has-condorcet-cycle? cycle-participants)) (answer "(define (method-agreement dp) (let ((borda (mcdm-borda dp)) (schulze (mcdm-schulze dp)) (copeland (mcdm-copeland dp)) (condorcet (mcdm-condorcet dp))) (quasiquote ((borda unquote borda) (schulze unquote schulze) (copeland unquote copeland) (condorcet unquote (or condorcet 'none))))))"))
(task-entry (id "game-theory/extensive-form/ultimatum-game") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13230) (name ultimatum-game) (type "") (description "") (notes ()) (section classic-games) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility)) (answer "(define ultimatum-game (make-extensive-game 2 (make-decision 0 '(offer-90-10 offer-50-50 offer-10-90) (list (make-decision 1 '(accept reject) (list (make-terminal '(90 10)) (make-terminal '(0 0)))) (make-decision 1 '(accept reject) (list (make-terminal '(50 50)) (make-terminal '(0 0)))) (make-decision 1 '(accept reject) (list (make-terminal '(10 90)) (make-terminal '(0 0))))))))"))
(task-entry (id "game-theory/coop-games/nucleolus-iterate") (skill game-theory) (module coop-games) (tier 1) (difficulty 13230) (name nucleolus-iterate) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus)) (answer "(define (nucleolus-iterate g n v-grand coalition-vec fixed-constraints fuel) (if (<= fuel 0) '(out-of-fuel nucleolus) (let* ((num-coalitions (vector-length coalition-vec)) (lp-result (build-nucleolus-lp g n v-grand coalition-vec fixed-constraints))) (if (not lp-result) (extract-nucleolus-allocation g n v-grand fixed-constraints) (let ((lp (car lp-result)) (unfixed-coalitions (cdr lp-result))) (let ((result (lp-solve lp))) (cond ((lp-infeasible? result) '(error infeasible-nucleolus)) ((lp-unbounded? result) '(error unbounded-nucleolus)) (else (let* ((x-full (lp-result-x result)) (epsilon (vector-ref x-full n)) (alloc (let ((v (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) v) (vector-set! v i (vector-ref x-full i))))) (newly-fixed (find-tight-coalitions g alloc epsilon unfixed-coalitions))) (if (null? newly-fixed) alloc (let ((new-fixed (append (map (lambda (S) (cons S epsilon)) newly-fixed) fixed-constraints)) (remaining (list->vector (filter (lambda (S) (not (member S newly-fixed))) (vector->list unfixed-coalitions))))) (if (= 0 (vector-length remaining)) alloc (nucleolus-iterate g n v-grand remaining new-fixed (- fuel 1))))))))))))))"))
(task-entry (id "game-theory/matching/make-school-choice-market") (skill game-theory) (module matching) (tier 1) (difficulty 13230) (name make-school-choice-market) (type "") (description "") (notes ()) (section optimal-assignment) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market)) (answer "(define (make-school-choice-market students schools student-prefs school-prefs) (make-matching-market students schools student-prefs school-prefs))"))
(task-entry (id "game-theory/voting/copeland-winner") (skill game-theory) (module voting) (tier 1) (difficulty 13230) (name copeland-winner) (type "") (description "") (notes ()) (section copeland-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score)) (answer "(define (copeland-winner profile) (if (profile-empty? profile) #f (argmax (lambda (c) (copeland-score c profile)) (profile-candidates profile))))"))
(task-entry (id "game-theory/multi-winner/cc-greedy") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13230) (name cc-greedy) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction)) (answer "(define (cc-greedy profile num-seats) (if (profile-empty? profile) '() (let* ((candidates (profile-candidates profile)) (num-candidates (length candidates))) (cc-loop profile candidates '() num-seats num-candidates))))"))
(task-entry (id "game-theory/fair-division/selfridge-conway") (skill game-theory) (module fair-division) (tier 1) (difficulty 13230) (name selfridge-conway) (type "(-> Cake Nat Division)") (description "") (notes ()) (section selfridge-conway) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove)) (answer "(define (selfridge-conway c fuel) (if (not (= 3 (cake-players c))) (error 'selfridge-conway \"requires exactly 3 players\") (let* ((div (make-division 3)) (total-0 (cake-total-value c 0)) (third-value (/ total-0 3)) (cut1 (find-cut-point c 0 third-value fuel)) (cut2 (find-cut-point c 0 (* 2 third-value) fuel)) (pieces (vector (cons 0 cut1) (cons cut1 cut2) (cons cut2 1))) (vals-1 (vector (cake-valuation c 1 0 cut1) (cake-valuation c 1 cut1 cut2) (cake-valuation c 1 cut2 1))) (max-val-1 (apply max (vector->list vals-1))) (max-indices (filter (lambda (i) (= (vector-ref vals-1 i) max-val-1)) '(0 1 2)))) (if (= 1 (length max-indices)) (selfridge-conway-with-trim c div pieces vals-1 (car max-indices) fuel) (selfridge-conway-no-trim c div pieces vals-1 fuel)))))"))
(task-entry (id "game-theory/mechanism/pivot-mechanism") (skill game-theory) (module mechanism) (tier 1) (difficulty 13230) (name pivot-mechanism) (type "(-> (Vector Number) Number (Pair Boolean (Vector Number)))") (description "Pivot (Clarke) mechanism for binary public good provision") (notes ("Provide good if sum(valuations) >= cost. Each agent pays their 'pivot' amount if they change the outcome.")) (section public-goods) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations vcg-enumerate-helper)) (answer "(define (pivot-mechanism valuations cost) (let* ((n (vector-length valuations)) (total-value (let loop ((i 0) (sum 0)) (if (>= i n) sum (loop (+ i 1) (+ sum (vector-ref valuations i)))))) (provide? (>= total-value cost)) (payments (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (let* ((value-without-i (- total-value (vector-ref valuations i))) (provide-without-i? (>= value-without-i cost))) (when (not (eq? provide? provide-without-i?)) (if provide? (vector-set! payments i (- cost value-without-i)) (vector-set! payments i (- value-without-i cost)))))) (cons provide? payments)))"))
(task-entry (id "game-theory/evolutionary/find-pure-nash") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13230) (name find-pure-nash) (type "") (description "") (notes ()) (section ess) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge is-ess? find-all-ess is-nash-equilibrium?)) (answer "(define (find-pure-nash game) (filter (lambda (i) (is-nash-equilibrium? game i)) (iota (sg-num-strategies game))))"))
(task-entry (id "game-theory/mcdm/unanimous-winner?") (skill game-theory) (module mcdm) (tier 1) (difficulty 13230) (name unanimous-winner?) (type "(-> DecisionProblem (Maybe Alternative))") (description "Find winner if all methods (Borda, Schulze, Copeland, Condorcet) agree. Strong endorsement if not #f") (notes ()) (section comparison) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index list-update robustness-profile min-robustness has-condorcet-cycle? cycle-participants method-agreement)) (answer "(define (unanimous-winner? dp) (let ((agreement (method-agreement dp))) (let ((borda (cdr (assq 'borda agreement))) (schulze (cdr (assq 'schulze agreement))) (copeland (cdr (assq 'copeland agreement))) (condorcet (cdr (assq 'condorcet agreement)))) (if (and (eq? borda schulze) (eq? schulze copeland) (or (eq? condorcet 'none) (eq? condorcet borda))) borda #f))))"))
(task-entry (id "game-theory/extensive-form/make-centipede-game") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13231) (name make-centipede-game) (type "(-> Nat ExtensiveGame)") (description "Create an n-round centipede game") (notes ("SPE is immediate defection despite Pareto-improving continuation. This is a canonical example of backward induction paradox.")) (section classic-games) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game)) (answer "(define (make-centipede-game n) (letrec ((build-tree (lambda (round) (if (> round n) (make-terminal (list n n)) (let ((player (remainder (- round 1) 2))) (make-decision player '(take pass) (list (if (= player 0) (make-terminal (list (+ round 1) (- round 1))) (make-terminal (list (- round 1) (+ round 1)))) (build-tree (+ round 1))))))))) (make-extensive-game 2 (build-tree 1))))"))
(task-entry (id "game-theory/coop-games/build-nucleolus-lp") (skill game-theory) (module coop-games) (tier 1) (difficulty 13231) (name build-nucleolus-lp) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate)) (answer "(define (build-nucleolus-lp g n v-grand coalition-vec fixed-constraints) (let ((num-unfixed (vector-length coalition-vec)) (is-cost (coop-game-cost? g))) (if (= num-unfixed 0) #f (let* ((num-fixed (length fixed-constraints)) (num-vars (+ n 1)) (num-slacks (+ n num-unfixed)) (total-vars (+ num-vars num-slacks)) (num-constraints (+ 1 n num-unfixed num-fixed)) (c (make-vector total-vars 0))) (vector-set! c n 1) (let ((A (make-matrix num-constraints total-vars 0)) (b (make-vector num-constraints 0)) (row 0)) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! A row i 1)) (vector-set! b row v-grand) (set! row (+ row 1)) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! A row i 1) (matrix-set! A row (+ n 1 i) (if is-cost 1 -1)) (vector-set! b row (coop-game-value g (coalition-singleton i))) (set! row (+ row 1))) (do ((k 0 (+ k 1))) ((= k num-unfixed)) (let* ((S (vector-ref coalition-vec k)) (slack-idx (+ n 1 n k)) (v-S (coop-game-value g S))) (do ((i 0 (+ i 1))) ((= i n)) (when (coalition-member? i S) (matrix-set! A row i (if is-cost 1 -1)))) (matrix-set! A row n -1) (matrix-set! A row slack-idx 1) (vector-set! b row (if is-cost v-S (- v-S))) (set! row (+ row 1)))) (for-each (lambda (fc) (let* ((S (car fc)) (eps-k (cdr fc)) (v-S (coop-game-value g S))) (do ((i 0 (+ i 1))) ((= i n)) (when (coalition-member? i S) (matrix-set! A row i (if is-cost 1 -1)))) (vector-set! b row (if is-cost (+ eps-k v-S) (- eps-k v-S))) (set! row (+ row 1)))) fixed-constraints) (cons (make-lp c A b) coalition-vec))))))"))
(task-entry (id "game-theory/matching/make-random-preferences") (skill game-theory) (module matching) (tier 1) (difficulty 13231) (name make-random-preferences) (type "") (description "") (notes ()) (section optimal-assignment) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market)) (answer "(define (make-random-preferences agents targets shuffle) (map (lambda (agent) (cons agent (shuffle targets))) agents))"))
(task-entry (id "game-theory/voting/copeland-ranking") (skill game-theory) (module voting) (tier 1) (difficulty 13231) (name copeland-ranking) (type "") (description "") (notes ()) (section copeland-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner)) (answer "(define (copeland-ranking profile) (sort-by (lambda (a b) (> (copeland-score a profile) (copeland-score b profile))) (profile-candidates profile)))"))
(task-entry (id "game-theory/multi-winner/cc-loop") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13231) (name cc-loop) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction cc-greedy)) (answer "(define (cc-loop profile remaining elected seats-left num-candidates) (if (or (= seats-left 0) (null? remaining)) (reverse elected) (let* ((scores (map (lambda (c) (cons c (cc-marginal-score c profile elected num-candidates))) remaining)) (sorted (sort-by (lambda (a b) (> (cdr a) (cdr b))) scores)) (winner (caar sorted))) (cc-loop profile (remove winner remaining) (cons winner elected) (- seats-left 1) num-candidates))))"))
(task-entry (id "game-theory/fair-division/selfridge-conway-no-trim") (skill game-theory) (module fair-division) (tier 1) (difficulty 13231) (name selfridge-conway-no-trim) (type "") (description "") (notes ()) (section selfridge-conway) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway)) (answer "(define (selfridge-conway-no-trim c div pieces vals-1 fuel) (let* ((vals-2 (vector (cake-valuation c 2 (car (vector-ref pieces 0)) (cdr (vector-ref pieces 0))) (cake-valuation c 2 (car (vector-ref pieces 1)) (cdr (vector-ref pieces 1))) (cake-valuation c 2 (car (vector-ref pieces 2)) (cdr (vector-ref pieces 2))))) (c-choice (argmax (vector->list vals-2))) (remaining-1 (filter (lambda (i) (not (= i c-choice))) '(0 1 2))) (b-choice (car (sort-by (lambda (i j) (> (vector-ref vals-1 i) (vector-ref vals-1 j))) remaining-1))) (a-choice (car (filter (lambda (i) (and (not (= i c-choice)) (not (= i b-choice)))) '(0 1 2))))) (division-assign! div 2 (piece-singleton (car (vector-ref pieces c-choice)) (cdr (vector-ref pieces c-choice)))) (division-assign! div 1 (piece-singleton (car (vector-ref pieces b-choice)) (cdr (vector-ref pieces b-choice)))) (division-assign! div 0 (piece-singleton (car (vector-ref pieces a-choice)) (cdr (vector-ref pieces a-choice)))) div))"))
(task-entry (id "game-theory/mechanism/myerson-virtual-value") (skill game-theory) (module mechanism) (tier 1) (difficulty 13231) (name myerson-virtual-value) (type "(-> Number (-> Number Number) (-> Number Number) Number)") (description "Myerson virtual value: v - (1 - F(v))/f(v)") (notes ("f = PDF, F = CDF of value distribution. Allocate to highest non-negative virtual value.")) (section myerson-optimal) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations vcg-enumerate-helper pivot-mechanism)) (answer "(define (myerson-virtual-value v f F) (- v (/ (- 1 (F v)) (f v))))"))
(task-entry (id "game-theory/evolutionary/can-invade?") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13231) (name can-invade?) (type "(-> SymmetricGame Nat Nat Boolean)") (description "") (notes ()) (section invasion) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step replicator-trajectory replicator-converge is-ess? find-all-ess is-nash-equilibrium? find-pure-nash)) (answer "(define (can-invade? game incumbent mutant) (let ((aii (sg-payoff game incumbent incumbent)) (aji (sg-payoff game mutant incumbent)) (aij (sg-payoff game incumbent mutant)) (ajj (sg-payoff game mutant mutant))) (or (> aji aii) (and (= aji aii) (> ajj aij)))))"))
(task-entry (id "game-theory/mcdm/mcdm-summary") (skill game-theory) (module mcdm) (tier 1) (difficulty 13231) (name mcdm-summary) (type "(-> DecisionProblem Void)") (description "Print comprehensive analysis: Pareto frontier, method agreement, cycles, and rankings") (notes ()) (section convenience) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index list-update robustness-profile min-robustness has-condorcet-cycle? cycle-participants method-agreement unanimous-winner?)) (answer "(define (mcdm-summary dp) (let ((frontier (pareto-frontier dp)) (agreement (method-agreement dp)) (cycle? (has-condorcet-cycle? dp)) (rankings (mcdm-ranking dp 'borda))) (display \"=== Multi-Criteria Decision Analysis ===\n\") (display \"\nAlternatives: \") (display (dp-alternatives dp)) (newline) (display \"Criteria: \") (display (dp-criteria dp)) (newline) (display \"\nPareto frontier: \") (display frontier) (newline) (display \"Dominated: \") (display (pareto-dominated dp)) (newline) (display \"\nCondorcet cycle: \") (display (if cycle? \"YES\" \"no\")) (newline) (when cycle? (display \"Cycle participants: \") (display (cycle-participants dp)) (newline)) (display \"\nMethod agreement:\n\") (for-each (lambda (m) (display \"  \") (display (car m)) (display \": \") (display (cdr m)) (newline)) agreement) (display \"\nBorda ranking: \") (display rankings) (newline) (let ((unanimous (unanimous-winner? dp))) (if unanimous (begin (display \"\n★ UNANIMOUS WINNER: \") (display unanimous) (newline)) (display \"\n(No unanimous winner - methods disagree)\n\")))))"))
