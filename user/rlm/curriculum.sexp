(task-entry (id "game-theory/fair-division/dubins-spanier-recurse") (skill game-theory) (module fair-division) (tier 1) (difficulty 13225) (name dubins-spanier-recurse) (type "") (description "") (notes ()) (section dubins-spanier) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier)) (answer "(define (dubins-spanier-recurse c div remaining start end n fuel) (cond ((<= fuel 0) (void)) ((null? remaining) (void)) ((null? (cdr remaining)) (division-assign! div (car remaining) (piece-singleton start end))) (else (let* ((k (length remaining)) (target-share (/ 1 k)) (stop-points (map (lambda (i) (let* ((total-remaining (cake-valuation c i start end)) (target (* target-share total-remaining))) (find-cut-point-from c i start target fuel))) remaining)) (min-stop (apply min stop-points)) (winner-idx (list-index (lambda (x) (= x min-stop)) stop-points)) (winner (list-ref remaining winner-idx))) (division-assign! div winner (piece-singleton start min-stop)) (dubins-spanier-recurse c div (remove winner remaining) min-stop end n (- fuel 1))))))"))
(task-entry (id "game-theory/mechanism/vcg-find-efficient-allocation-without") (skill game-theory) (module mechanism) (tier 1) (difficulty 13225) (name vcg-find-efficient-allocation-without) (type "(-> (Vector (Vector Number)) Nat Nat Nat (Values (Vector Nat) Number))") (description "Find efficient allocation excluding agent 'excluded'") (notes ()) (section vcg-mechanism) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation)) (answer "(define (vcg-find-efficient-allocation-without valuations n m excluded) (let ((best-alloc (make-vector n 0)) (best-welfare -inf.0)) (vcg-enumerate-allocations n m (lambda (allocation) (when (= 0 (vector-ref allocation excluded)) (let ((welfare (vcg-total-welfare-without valuations allocation excluded))) (when (> welfare best-welfare) (set! best-welfare welfare) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! best-alloc i (vector-ref allocation i)))))))) (values best-alloc best-welfare)))"))
(task-entry (id "game-theory/evolutionary/replicator-trajectory") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13225) (name replicator-trajectory) (type "(-> SymmetricGame Population Number Nat (List Population))") (description "") (notes ()) (section replicator-dynamics) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative replicator-step)) (answer "(define (replicator-trajectory game pop dt steps) (let loop ((current pop) (remaining steps) (acc (list pop))) (if (<= remaining 0) (reverse acc) (let ((next (replicator-step game current dt))) (loop next (- remaining 1) (cons next acc))))))"))
(task-entry (id "game-theory/mcdm/robustness-profile") (skill game-theory) (module mcdm) (tier 1) (difficulty 13225) (name robustness-profile) (type "(-> DecisionProblem (List Real) (List (Pair Criterion Real)))") (description "Compute sensitivity to each criterion. Identifies which criteria most affect the outcome. Low values indicate decision hinges on that criterion") (notes ()) (section sensitivity-analysis) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index list-update)) (answer "(define (robustness-profile dp base-weights) (map (lambda (c) (cons c (sensitivity-to-criterion dp c base-weights))) (dp-criteria dp)))"))
(task-entry (id "game-theory/normal-form/expected-payoff-p2") (skill game-theory) (module normal-form) (tier 1) (difficulty 13226) (name expected-payoff-p2) (type "") (description "") (notes ()) (section mixed-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds is-pure-nash? find-pure-nash make-mixed-strategy pure-strategy uniform-strategy expected-payoff-p1)) (answer "(define (expected-payoff-p2 game sigma1 sigma2) (let ((n1 (vector-length sigma1)) (n2 (vector-length sigma2))) (apply + (map (lambda (i) (apply + (map (lambda (j) (* (vector-ref sigma1 i) (vector-ref sigma2 j) (game-payoff-p2 game i j))) (iota n2)))) (iota n1)))))"))
