(task-entry (id "dataset/jsonl/join-strings") (skill dataset) (module jsonl) (tier 1) (difficulty 13414) (name join-strings) (type "") (description "") (notes ()) (section serialization) (deps (core/base/prelude.ss lattice/optics/optics.ss lattice/dataset/sample.ss)) (available (make-json-object json-object? json-object-pairs make-json-array json-array? json-array-items sample->json json->sample value->json json->value sample-json-iso iso-roundtrip-check json->string json-string-escape)) (answer "(define (join-strings strs sep) (if (null? strs) \"\" (let loop ((rest (cdr strs)) (acc (car strs))) (if (null? rest) acc (loop (cdr rest) (string-append acc sep (car rest)))))))"))
