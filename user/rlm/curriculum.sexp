(task-entry (id "autodiff/higher-order-diff/jet-coeff") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12719) (name jet-coeff) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order)) (answer "(define (jet-coeff j k) (if (jet? j) (let ((coeffs (jet-coeffs j))) (if (< k (vector-length coeffs)) (vector-ref coeffs k) 0)) (if (= k 0) j 0)))"))
(task-entry (id "autodiff/differentiable-signal/spectral-mse-grad") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12719) (name spectral-mse-grad) (type "(-> (Vector Complex) (Vector Complex) (Values Number (Vector Complex)))") (description "Mean squared error gradient in spectral domain") (notes ()) (section spectral-loss) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real make-dft-re-local-grads make-dft-im-local-grads diff-dft diff-convolution traced-convolve-1d make-conv-local-grads power-spectrum-grad power-spectrum-grad-real magnitude-spectrum-grad)) (answer "(define (spectral-mse-grad X1 X2) (let* ((n (vector-length X1)) (total 0) (grad (make-vector n))) (do ((k 0 (+ k 1))) ((= k n) (values (/ total n) grad)) (let* ((d (complex-sub (vector-ref X1 k) (vector-ref X2 k))) (d-mag-sq (+ (* (complex-real d) (complex-real d)) (* (complex-imag d) (complex-imag d))))) (set! total (+ total d-mag-sq)) (vector-set! grad k (complex-scale (/ 2.0 n) d))))))"))
(task-entry (id "autodiff/sparse-autodiff/diagonal-pattern") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12719) (name diagonal-pattern) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit)) (answer "(define (diagonal-pattern n) (let ((indices (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) (make-sparsity-pattern n n indices (vec-copy indices))) (vector-set! indices i i))))"))
(task-entry (id "autodiff/typed-gradients/dim-hessian") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12719) (name dim-hessian) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian)) (answer "(define (dim-hessian n matrix) (list 'dim-hessian n matrix))"))
