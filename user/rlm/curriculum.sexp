(task-entry (id "autodiff/symbolic-diff/simplify-quot") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12719) (name simplify-quot) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list simplify-diff simplify-neg)) (answer "(define (simplify-quot numer denom) (cond ((and (num? numer) (= (num-val numer) 0)) (num 0)) ((and (num? denom) (= (num-val denom) 1)) numer) ((and (num? numer) (num? denom)) (let ((result (/ (num-val numer) (num-val denom)))) (if (integer? result) (num result) (division numer denom)))) ((expr=? numer denom) (num 1)) (else (division numer denom))))"))
