(task-entry (id "linalg/graph-laplacian/laplacian-energy") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 414) (name laplacian-energy) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace)) (answer "(define (laplacian-energy adj) (let* ((L (laplacian adj)) (eigs (eigenvalues L))) (if (and (pair? eigs) (eq? (car eigs) 'error)) eigs (let ((n (vector-length eigs))) (let loop ((i 0) (sum 0)) (if (= i n) sum (loop (+ i 1) (+ sum (abs (vector-ref eigs i))))))))))"))
(task-entry (id "linalg/svd/matrix-slice-cols") (skill linalg) (module svd) (tier 0) (difficulty 414) (name matrix-slice-cols) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin)) (answer "(define (matrix-slice-cols mat start end) (let* ((rows (matrix-rows mat)) (cols (- end start)) (result (make-matrix rows cols 0))) (do ((i 0 (+ i 1))) ((= i rows) result) (do ((j 0 (+ j 1))) ((= j cols)) (matrix-set! result i j (matrix-ref mat i (+ start j)))))))"))
