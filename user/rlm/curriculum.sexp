(task-entry (id "fp/cost-analysis/*primitive-costs*") (skill fp) (module cost-analysis) (tier 1) (difficulty 10606) (name *primitive-costs*) (type "Alist") (description "Base costs for primitive operations.") (notes ()) (section operation-cost-tables) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead!)) (answer "(define *primitive-costs* '((car . 1) (cdr . 1) (null? . 1) (pair? . 1) (eq? . 1) (symbol? . 1) (number? . 1) (boolean? . 1) (+ . 2) (- . 2) (* . 3) (= . 2) (< . 2) (> . 2) (<= . 2) (>= . 2) (not . 1) (cons . 3) (list . 5) (/ . 5) (quotient . 5) (remainder . 5) (modulo . 5) (abs . 2) (min . 3) (max . 3) (equal? . 10) (sqrt . 15) (expt . 20) (log . 20) (exp . 20) (sin . 20) (cos . 20) (tan . 20) (asin . 25) (acos . 25) (atan . 25) (length . 10) (append . 20) (reverse . 15) (member . 15) (memq . 10) (assoc . 15) (assq . 10) (string-length . 1) (string-ref . 2) (string-append . 20) (string=? . 10) (substring . 10) (vector-ref . 2) (vector-set! . 3) (vector-length . 1) (make-vector . 10)))"))
