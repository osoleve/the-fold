(task-entry (id "data/quadtree/bounds-contains?") (skill data) (module quadtree) (tier 0) (difficulty 1306) (name bounds-contains?) (type "(-> Bounds Num Num Boolean)") (description "Check if point (x,y) is within bounds") (notes ()) (section core-representation) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh)) (answer "(define (bounds-contains? bounds x y) (and (>= x (- (bounds-cx bounds) (bounds-hw bounds))) (<= x (+ (bounds-cx bounds) (bounds-hw bounds))) (>= y (- (bounds-cy bounds) (bounds-hh bounds))) (<= y (+ (bounds-cy bounds) (bounds-hh bounds)))))"))
(task-entry (id "data/collection-protocol/coll-partition") (skill data) (module collection-protocol) (tier 0) (difficulty 1306) (name coll-partition) (type "(-> Collection (-> Element Boolean) (Values (List Element) (List Element)))") (description "Partition into (satisfying, not-satisfying) lists") (notes ()) (section generic-operations) (deps (\x27;prelude \x27;protocol)) (available (coll-count coll-any? coll-all? coll-filter-list coll-map-list coll-find)) (answer "(define (coll-partition coll pred) (let ((result (coll-fold coll (lambda (acc elem) (if (pred elem) (cons (cons elem (car acc)) (cdr acc)) (cons (car acc) (cons elem (cdr acc))))) (cons '() '())))) (values (reverse (car result)) (reverse (cdr result)))))"))
