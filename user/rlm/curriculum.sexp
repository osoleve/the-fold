(task-entry (id "game-theory/strategic-voting/cartesian-product-n") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13207) (name cartesian-product-n) (type "") (description "") (notes ()) (section nash-equilibrium) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium all-strategic-equilibria)) (answer "(define (cartesian-product-n items n) (if (= n 0) '(()) (append-map (lambda (rest) (map (lambda (item) (cons item rest)) items)) (cartesian-product-n items (- n 1)))))"))
(task-entry (id "game-theory/voting-games/banzhaf-voting-power") (skill game-theory) (module voting-games) (tier 1) (difficulty 13207) (name banzhaf-voting-power) (type "") (description "") (notes ()) (section power-indices) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted)) (answer "(define (banzhaf-voting-power profile) (let* ((game (profile->majority-game profile)) (n (profile-voters profile)) (fuel (* n (expt 2 n)))) (banzhaf-index game fuel)))"))
(task-entry (id "game-theory/multi-winner/count-votes") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13207) (name count-votes) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice)) (answer "(define (count-votes ballots remaining) (map (lambda (c) (cons c (apply + (map (lambda (b) (if (eq? c (ballot-top-choice b remaining)) (ballot-weight b) 0)) ballots)))) remaining))"))
