(task-entry (id "statistics/model-protocol/compare-models-aic") (skill statistics) (module model-protocol) (tier 1) (difficulty 11203) (name compare-models-aic) (type "(-> (List Model) (List (Pair Model Num)))") (description "Compare models by AIC, return sorted by delta-AIC from best") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;result-types \x27;sort)) (available (model-mse model-rmse model-mae)) (answer "(define (compare-models-aic models) (let* ((aics (map (lambda (m) (cons m (model-aic m))) models)) (sorted (sort-by (lambda (a b) (< (cdr a) (cdr b))) aics)) (min-aic (cdr (car sorted)))) (map (lambda (pair) (cons (car pair) (- (cdr pair) min-aic))) sorted)))"))
