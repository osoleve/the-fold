(task-entry (id "fp/zipper/zipper-from-position") (skill fp) (module zipper) (tier 1) (difficulty 10611) (name zipper-from-position) (type "(-> (List α) Nat (ListZipper α))") (description "Create zipper focused at given position (0-indexed). If position exceeds list length, focuses past the end") (notes ()) (section constructors) (deps (\x27;prelude \x27;combinators)) (available (zipper-tag make-zipper zipper? zipper-left zipper-focus-maybe zipper-right zipper-empty zipper-empty? zipper-singleton list->zipper zipper->list)) (answer "(define (zipper-from-position lst pos) (let loop ((left '()) (rest lst) (n pos)) (cond ((null? rest) (make-zipper left nothing '())) ((<= n 0) (make-zipper left (just (car rest)) (cdr rest))) (else (loop (cons (car rest) left) (cdr rest) (- n 1))))))"))
