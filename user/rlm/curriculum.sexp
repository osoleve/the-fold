(task-entry (id "fp/units/megaohm") (skill fp) (module units) (tier 1) (difficulty 10711) (name megaohm) (type "(-> Number Quantity)") (description "Create a resistance quantity in megaohms.") (notes ()) (section si-prefixes) (deps (\x27;prelude)) (available (make-dim dim-length dim-time dim-mass dim-current dim-temperature dim-amount dim-luminosity dim? dim=? dim-one dim-length-base dim-time-base dim-mass-base dim-current-base dim-temperature-base dim-amount-base dim-luminosity-base dim* dim/ dim-pow dim-sqrt dim-inv make-qty qty-value qty-dim qty? qty+ qty- qty* qty/ qty-scale qty-pow qty-sqrt qty-neg qty-abs qty=? qty<? qty>? qty<=? qty>=? meter second kilogram ampere kelvin mole candela dim-velocity dim-acceleration dim-force dim-energy dim-power dim-pressure dim-frequency dim-charge dim-voltage dim-resistance dim-area dim-volume newton joule watt pascal hertz coulomb volt ohm yotta zetta exa peta tera giga mega kilo hecto deca deci centi milli micro nano pico femto atto zepto yocto kilometer centimeter millimeter micrometer nanometer millisecond microsecond nanosecond gram milligram kilowatt megawatt gigawatt kilojoule megajoule milliampere microampere kilohertz megahertz gigahertz kilovolt millivolt kiloohm)) (answer "(define (megaohm x) (ohm (* x mega)))"))
(task-entry (id "diffgeo/charts/transition-apply") (skill diffgeo) (module charts) (tier 1) (difficulty 10711) (name transition-apply) (type "") (description "") (notes ()) (section transition-functions) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp)) (available (chart? chart-name chart-dim chart-domain-pred chart-coord-map chart-inverse-map make-chart chart-contains? chart-apply chart-apply-inverse make-transition)) (answer "(define (transition-apply chart-from chart-to coords) (if (not (= (chart-dim chart-from) (chart-dim chart-to))) (quasiquote (error dimension-mismatch (unquote (chart-dim chart-from)) (unquote (chart-dim chart-to)))) (let ((point ((chart-inverse-map chart-from) coords))) (if (not ((chart-domain-pred chart-to) point)) (quasiquote (error point-not-in-target-domain (unquote (chart-name chart-to)) (unquote point))) ((chart-coord-map chart-to) point)))))"))
