(task-entry (id "clp/domain/domain-restrict-max") (skill clp) (module domain) (tier 1) (difficulty 10821) (name domain-restrict-max) (type "(-> Domain Int Domain)") (description "Keep only values <= n") (notes ()) (section domain-operations) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals interval<? domain-subtract-value domain-subtract domain-restrict-min)) (answer "(define (domain-restrict-max dom n) (let loop ((intervals dom) (acc '())) (cond ((null? intervals) (reverse acc)) (else (let* ((interval (car intervals)) (lo (car interval)) (hi (cdr interval))) (cond ((> lo n) (reverse acc)) ((<= hi n) (loop (cdr intervals) (cons interval acc))) (else (reverse (cons (cons lo n) acc)))))))))"))
(task-entry (id "clp/store/make-constraint") (skill clp) (module store) (tier 1) (difficulty 10821) (name make-constraint) (type "(-> Symbol (List LVar) (-> CStore (Maybe CStore)) Constraint)") (description "Create a new constraint with unique ID") (notes ()) (section constraint-management) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter*)) (answer "(define (make-constraint type vars propagator) (set! *constraint-counter* (+ *constraint-counter* 1)) (list 'constraint *constraint-counter* type vars propagator))"))
(task-entry (id "clp/fd-constraints/*fd-bounds") (skill clp) (module fd-constraints) (tier 1) (difficulty 10821) (name *fd-bounds) (type "(-> CStore (Or LVar Int) (Or LVar Int) (Or LVar Int) (Maybe CStore))") (description "Bounds propagation for x * y = z") (notes ("More complex due to sign considerations")) (section arithmetic-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const =/=fd-var-var \x2B;fd fd-value \x2B;fd-bounds fd-bounds fd-narrow-bounds \x2D;fd *fd)) (answer "(define (*fd-bounds cs x y z) (let* ((x-bounds (fd-bounds cs x)) (y-bounds (fd-bounds cs y)) (z-bounds (fd-bounds cs z))) (if (and x-bounds y-bounds z-bounds) (let* ((x-lo (car x-bounds)) (x-hi (cdr x-bounds)) (y-lo (car y-bounds)) (y-hi (cdr y-bounds)) (z-lo (car z-bounds)) (z-hi (cdr z-bounds)) (products (list (* x-lo y-lo) (* x-lo y-hi) (* x-hi y-lo) (* x-hi y-hi))) (new-z-lo (max z-lo (apply min products))) (new-z-hi (min z-hi (apply max products)))) (fd-narrow-bounds cs z new-z-lo new-z-hi)) cs)))"))
(task-entry (id "clp/global-constraints/post-count-fd") (skill clp) (module global-constraints) (tier 1) (difficulty 10821) (name post-count-fd) (type "(-> CStore Int (List LVar) (Union LVar Int) (Maybe CStore))") (description "Post count constraint and register for re-propagation") (notes ()) (section count-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate sum-fd-narrow-vars post-sum-fd count-fd count-fd-propagate count-must-equal count-can-equal count-fd-fix fix-all-can-vars remove-value-from-can-vars)) (answer "(define (post-count-fd cs value vars n) (let ((all-vars (if (lvar? n) (cons n vars) vars))) (post-constraint cs 'count-fd all-vars (count-fd value vars n))))"))
