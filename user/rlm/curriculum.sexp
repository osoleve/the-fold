(task-entry (id "physics-problems/simulation/make-ball-static") (skill physics-problems) (module simulation) (tier 2) (difficulty 23610) (name make-ball-static) (type "") (description "") (notes ()) (section entity-helpers) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball)) (answer "(define (make-ball-static id pos radius) (let ((body (make-static-body pos)) (shape (make-circle (vec2 0 0) radius)) (material (make-material 0.8 0.3 0.2))) (make-entity id body shape material '())))"))
