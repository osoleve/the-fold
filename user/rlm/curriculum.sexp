(task-entry (id "fp/solve/diff-to-sum") (skill fp) (module solve) (tier 1) (difficulty 10621) (name diff-to-sum) (type "(-> Expr Expr)") (description "Convert difference to sum recursively to enable expansion over differences") (notes ()) (section main-interface) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms solve-linear solve-quadratic solve-cubic solve-polynomial)) (answer "(define (diff-to-sum expr) (cond ((num? expr) expr) ((var? expr) expr) ((sum? expr) (make-sum-from-terms (map diff-to-sum (sum-terms expr)))) ((product? expr) (make-product-from-terms (map diff-to-sum (product-factors expr)))) ((difference? expr) (if (diff-right expr) (sum (diff-to-sum (diff-left expr)) (make-neg (diff-to-sum (diff-right expr)))) (make-neg (diff-to-sum (diff-left expr))))) ((quotient? expr) (division (diff-to-sum (quot-numer expr)) (diff-to-sum (quot-denom expr)))) ((power? expr) (power (diff-to-sum (pow-base expr)) (diff-to-sum (pow-exp expr)))) ((app? expr) (make-app (app-fn expr) (diff-to-sum (app-arg expr)))) (else expr)))"))
