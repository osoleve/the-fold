(task-entry (id "fp/zipper/zipper->list") (skill fp) (module zipper) (tier 1) (difficulty 10610) (name zipper->list) (type "(-> (ListZipper α) (List α))") (description "Convert zipper back to list") (notes ()) (section constructors) (deps (\x27;prelude \x27;combinators)) (available (zipper-tag make-zipper zipper? zipper-left zipper-focus-maybe zipper-right zipper-empty zipper-empty? zipper-singleton list->zipper)) (answer "(define (zipper->list z) (let ((left (zipper-left z)) (focus (zipper-focus-maybe z)) (right (zipper-right z))) (append (reverse left) (if (nothing? focus) '() (cons (from-just focus) right)))))"))
