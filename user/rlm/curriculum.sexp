(task-entry (id "diffgeo/geodesics/trace-geodesic") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10729) (name trace-geodesic) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final trace-geodesic-adaptive-at-times exp-map-adaptive exp-map-adaptive-t log-map-adaptive vec-finite? compute-exp-jacobian-adaptive geodesic-distance-adaptive)) (answer "(define (trace-geodesic metric initial-coords initial-velocity T n-steps) (let* ((dt (/ T n-steps)) (state0 (make-geodesic-state initial-coords initial-velocity))) (let loop ((state state0) (i 0) (states (list state0))) (if (>= i n-steps) (reverse states) (let ((next-state (rk4-geodesic-step metric state dt))) (loop next-state (+ i 1) (cons next-state states)))))))"))
(task-entry (id "diffgeo/forms/wedge") (skill diffgeo) (module forms) (tier 1) (difficulty 10729) (name wedge) (type "") (description "") (notes ()) (section wedge-product) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices count-inversions-to-sort k-form? k-form-point k-form-chart k-form-degree k-form-components k-form-dim make-k-form k-form-zero k-form-basis cotangent->1-form \x31;-form->cotangent k-form-add k-form-sub k-form-scale k-form-negate k-form-change-chart)) (answer "(define (wedge kf1 kf2) (cond ((not (equal? (k-form-point kf1) (k-form-point kf2))) (quasiquote (error different-base-points))) ((not (eq? (chart-name (k-form-chart kf1)) (chart-name (k-form-chart kf2)))) (quasiquote (error different-charts))) (else (let* ((point (k-form-point kf1)) (chart (k-form-chart kf1)) (n (chart-dim chart)) (p (k-form-degree kf1)) (q (k-form-degree kf2)) (r (+ p q))) (if (> r n) (k-form-zero point chart r) (let* ((comp1 (k-form-components kf1)) (comp2 (k-form-components kf2)) (indices-p (generate-multi-indices n p)) (indices-q (generate-multi-indices n q)) (indices-r (generate-multi-indices n r)) (num-r (binomial n r)) (result (make-vector num-r 0))) (for-each (lambda (idx-p) (let ((val-p (vector-ref comp1 (multi-index->offset n idx-p)))) (when (not (= val-p 0)) (for-each (lambda (idx-q) (let ((val-q (vector-ref comp2 (multi-index->offset n idx-q)))) (when (not (= val-q 0)) (let ((sign (shuffle-sign idx-p idx-q))) (when sign (let* ((idx-r (merge-indices idx-p idx-q)) (offset-r (multi-index->offset n idx-r)) (contribution (* sign val-p val-q))) (vector-set! result offset-r (+ (vector-ref result offset-r) contribution)))))))) indices-q)))) indices-p) (make-k-form point chart r result)))))))"))
