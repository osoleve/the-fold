(task-entry (id "physics/classical3d/world3d/world-3d-query-aabb") (skill physics/classical3d) (module world3d) (tier 2) (difficulty 22472) (name world-3d-query-aabb) (type "") (description "") (notes ()) (section physics-entity) (deps (\x27;prelude \x27;vec3 \x27;quaternion \x27;rigid-body3d \x27;shapes3d \x27;collision-detection3d \x27;constraint-solver3d)) (available (make-entity-3d entity-3d? entity-3d-id entity-3d-body entity-3d-shape entity-3d-material entity-3d-user-data entity-3d-with-body entity-3d-pos entity-3d-vel entity-3d-static? make-material material? material-restitution material-friction *default-material* *bouncy-material* *sticky-material* make-time-acc-3d time-acc-3d-fixed-dt time-acc-3d-max-substeps time-acc-3d-accumulated time-acc-3d-add time-acc-3d-consume make-spatial-hash-3d spatial-hash-3d-cell-size spatial-hash-3d-table spatial-hash-3d-key spatial-hash-3d-aabb-keys spatial-hash-3d-clear! spatial-hash-3d-insert! spatial-hash-3d-query make-world-config-3d config-3d-fixed-dt config-3d-max-substeps config-3d-solver-iterations config-3d-cell-size make-world-3d world-3d? world-3d-entities world-3d-gravity world-3d-spatial-hash world-3d-config world-3d-time-acc world-3d-constraints world-3d-with-time-acc world-3d-add-entity! world-3d-remove-entity! world-3d-get-entity world-3d-entity-list world-3d-update-entity! world-3d-add-constraint! world-3d-remove-constraint! world-3d-get-constraint world-3d-constraint-list world-3d-step! world-3d-fixed-step! world-3d-integrate-velocities! world-3d-integrate-positions! world-3d-detect-collisions make-pair-key-3d world-3d-resolve-collision-velocities! resolve-collision-3d apply-friction-3d world-3d-correct-collision-positions! world-3d-solve-constraint-velocities! world-3d-correct-constraint-positions! make-sphere-entity-3d make-box-entity-3d make-static-sphere-3d make-static-box-3d make-ground-3d)) (answer "(define (world-3d-query-aabb world aabb) (let* ((hash (world-3d-spatial-hash world)) (entities (world-3d-entity-list world))) (spatial-hash-3d-clear! hash) (for-each (lambda (e) (spatial-hash-3d-insert! hash (entity-3d-id e) (shape3d-aabb (entity-3d-shape e)))) entities) (let ((candidates (spatial-hash-3d-query hash aabb))) (filter (lambda (e) (and e (aabb3d-aabb3d? aabb (shape3d-aabb (entity-3d-shape e))))) (map (lambda (id) (world-3d-get-entity world id)) candidates)))))"))
