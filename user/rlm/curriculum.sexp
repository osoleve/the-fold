(task-entry (id "linalg/quaternion/quat-sub") (skill linalg) (module quaternion) (tier 0) (difficulty 420) (name quat-sub) (type "") (description "") (notes ()) (section quaternion-arithmetic) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at quat? quat-identity? quat-unit? quat-w quat-x quat-y quat-z quat-scalar quat-vector quat->list list->quat quat-add)) (answer "(define (quat-sub a b) (quat (- (quat-w a) (quat-w b)) (- (quat-x a) (quat-x b)) (- (quat-y a) (quat-y b)) (- (quat-z a) (quat-z b))))"))
