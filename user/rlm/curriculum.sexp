(task-entry (id "info/coding/hamming74-encode") (skill info) (module coding) (tier 1) (difficulty 11141) (name hamming74-encode) (type "(-> (List Nat) (List Nat))") (description "Encode 4 data bits into 7-bit Hamming(7,4) codeword") (notes ()) (section hamming-code) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob huffman-codes huffman-codes-helper huffman-encode huffman-decode huffman-decode-helper huffman-average-length huffman-efficiency arithmetic-encode arithmetic-encode-helper build-cumulative-probs arithmetic-decode arithmetic-decode-helper find-symbol-for-code arithmetic-code-length lz78-encode lz78-encode-helper lz78-find-longest-match prefix-match-length lz78-decode lz78-decode-helper take-n drop-n rle-encode rle-encode-helper rle-decode parity-encode parity-check parity-decode bitwise-xor repetition-encode repetition-decode majority-vote)) (answer "(define (hamming74-encode data) (if (not (= (length data) 4)) (error \"hamming74-encode\" \"expected 4 data bits\") (let* ((d1 (list-ref data 0)) (d2 (list-ref data 1)) (d3 (list-ref data 2)) (d4 (list-ref data 3)) (p1 (bitwise-xor (bitwise-xor d1 d2) d4)) (p2 (bitwise-xor (bitwise-xor d1 d3) d4)) (p4 (bitwise-xor (bitwise-xor d2 d3) d4))) (list p1 p2 d1 p4 d2 d3 d4))))"))
