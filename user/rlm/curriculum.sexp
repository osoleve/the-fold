(task-entry (id "physics/classical/ascii-renderer/polygon-scanline-intersections") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23538) (name polygon-scanline-intersections) (type "") (description "") (notes ()) (section filled) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line! draw-filled-circle!)) (answer "(define (polygon-scanline-intersections verts y) (let ((n (length verts))) (let loop ((i 0) (intersections '())) (if (>= i n) intersections (let* ((v1 (list-ref verts i)) (v2 (list-ref verts (modulo (+ i 1) n))) (y1 (cdr v1)) (y2 (cdr v2))) (if (or (and (<= y1 y) (> y2 y)) (and (> y1 y) (<= y2 y))) (let* ((x1 (car v1)) (x2 (car v2)) (t (if (= y2 y1) 0.5 (/ (- y y1) (- y2 y1)))) (x (inexact->exact (round (+ x1 (* t (- x2 x1))))))) (loop (+ i 1) (cons x intersections))) (loop (+ i 1) intersections)))))))"))
