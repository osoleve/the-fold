(task-entry (id "linalg/matrix-decomp/matrix-lu") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 404) (name matrix-lu) (type "") (description "LU decomposition with partial pivoting. Returns (L U P) where A = PLU, or error if matrix is singular.") (notes ()) (section lu-decomposition) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance* matrix-copy matrix-set! matrix-column)) (answer "(define (matrix-lu a) (let* ((m (matrix-rows a)) (n (matrix-cols a))) (if (not (= m n)) (quasiquote (error not-square (unquote m) (unquote n))) (let* ((lu (matrix-copy a)) (p (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! p i i)) (let main-loop ((k 0)) (if (= k n) (let ((l (make-matrix n n 0)) (u (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! l i i 1) (do ((j 0 (+ j 1))) ((>= j i)) (when (not (= i j)) (matrix-set! l i j (matrix-ref lu i j)))) (do ((j i (+ j 1))) ((= j n)) (matrix-set! u i j (matrix-ref lu i j)))) (list l u p)) (let find-pivot ((i (+ k 1)) (max-row k) (max-val (abs (matrix-ref lu k k)))) (if (= i n) (if (< max-val *matrix-tolerance*) (quasiquote (error singular-matrix (unquote k))) (begin (when (not (= max-row k)) (let ((cols (matrix-cols lu)) (data (matrix-data lu))) (do ((col 0 (+ col 1))) ((= col cols)) (let ((idx-k (+ (* k cols) col)) (idx-max (+ (* max-row cols) col))) (let ((temp (vector-ref data idx-k))) (vector-set! data idx-k (vector-ref data idx-max)) (vector-set! data idx-max temp))))) (let ((temp (vector-ref p k))) (vector-set! p k (vector-ref p max-row)) (vector-set! p max-row temp))) (do ((i (+ k 1) (+ i 1))) ((= i n)) (let ((factor (/ (matrix-ref lu i k) (matrix-ref lu k k)))) (matrix-set! lu i k factor) (do ((j (+ k 1) (+ j 1))) ((= j n)) (matrix-set! lu i j (- (matrix-ref lu i j) (* factor (matrix-ref lu k j))))))) (main-loop (+ k 1)))) (let ((val (abs (matrix-ref lu i k)))) (if (> val max-val) (find-pivot (+ i 1) i val) (find-pivot (+ i 1) max-row max-val)))))))))))"))
(task-entry (id "linalg/matrix-solvers/permutation-parity") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 404) (name permutation-parity) (type "") (description "") (notes ()) (section lu-solvers) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute matrix-back-substitute matrix-solve matrix-inverse)) (answer "(define (permutation-parity p) (let* ((n (vector-length p)) (visited (make-vector n #f))) (let loop ((i 0) (swaps 0)) (if (= i n) (if (even? swaps) 1 -1) (if (vector-ref visited i) (loop (+ i 1) swaps) (begin (let cycle-loop ((curr i) (len 0)) (if (vector-ref visited curr) (loop (+ i 1) (+ swaps (- len 1))) (begin (vector-set! visited curr #t) (cycle-loop (vector-ref p curr) (+ len 1)))))))))))"))
(task-entry (id "linalg/matrix-eigen/qr-algorithm") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 404) (name qr-algorithm) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop)) (answer "(define (qr-algorithm a . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (if (not (= n m)) (quasiquote (error not-square (unquote n) (unquote m))) (let* ((max-iter (if (and (pair? opts) (integer? (car opts))) (car opts) *eigen-max-iterations*)) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (tol (if (and (pair? rest1) (number? (car rest1))) (car rest1) *eigen-tolerance*))) (qr-algorithm-loop a 0 max-iter tol)))))"))
(task-entry (id "linalg/iterative-solvers/jacobi") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 404) (name jacobi) (type "") (description "") (notes ()) (section jacobi-iteration) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged?)) (answer "(define (jacobi a b . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (cond ((not (= n m)) (quasiquote (error not-square (unquote n) (unquote m)))) ((not (= n (vector-length b))) (quasiquote (error dimension-mismatch (unquote n) (unquote (vector-length b))))) (else (let* ((x0 (if (and (pair? opts) (vector? (car opts))) (car opts) (make-vector n 0.0))) (rest1 (if (and (pair? opts) (vector? (car opts))) (cdr opts) opts)) (max-iter (if (and (pair? rest1) (integer? (car rest1))) (car rest1) *iterative-max-iterations*)) (rest2 (if (and (pair? rest1) (integer? (car rest1))) (cdr rest1) rest1)) (tol (if (and (pair? rest2) (number? (car rest2))) (car rest2) *iterative-tolerance*))) (jacobi-loop a b x0 0 max-iter tol n))))))"))
