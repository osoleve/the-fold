(task-entry (id "physics/classical/constraint-graph/cg-print-topology") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23535) (name cg-print-topology) (type "") (description "") (notes ()) (section topology) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints toposort-dag cg-color-constraints build-constraint-conflicts cg-chromatic-number cg-stats cg-print-stats cg->simplicial-complex cg-cycle-count cg-topology-analysis cg-find-bridges cg-cycle-analysis)) (answer "(define (cg-print-topology graph) (let ((topo (cg-topology-analysis graph))) (printf \"Constraint Graph Topology:\n\") (printf \"  Vertices (entities): ~a\n\" (cdr (assq 'vertices topo))) (printf \"  Edges (constraints): ~a\n\" (cdr (assq 'edges topo))) (printf \"  Connected components (B₀): ~a\n\" (cdr (assq 'betti-0 topo))) (printf \"  Independent cycles (B₁): ~a\n\" (cdr (assq 'betti-1 topo))) (printf \"  Euler characteristic: ~a\n\" (cdr (assq 'euler topo))) (if (cdr (assq 'has-cycles topo)) (printf \"  ⚠ Cycles detected - system may be over-constrained\n\") (printf \"  ✓ No cycles - tree-like constraint structure\n\"))))"))
