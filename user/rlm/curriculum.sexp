(task-entry (id "game-theory/voting/list->set") (skill game-theory) (module voting) (tier 1) (difficulty 13206) (name list->set) (type "(-> (List a) (List a))") (description "Remove duplicates (preserving first occurrence order)") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty?)) (answer "(define (list->set lst) (let loop ((lst lst) (seen '()) (acc '())) (if (null? lst) (reverse acc) (if (member (car lst) seen) (loop (cdr lst) seen acc) (loop (cdr lst) (cons (car lst) seen) (cons (car lst) acc))))))"))
(task-entry (id "game-theory/strategic-voting/all-strategic-equilibria") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13206) (name all-strategic-equilibria) (type "(-> PreferenceProfile VotingRule (List PreferenceProfile))") (description "Find ALL Nash equilibria by exhaustive search. Exponentially expensive!") (notes ()) (section nash-equilibrium) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium)) (answer "(define (all-strategic-equilibria true-profile voting-rule) (if (null? true-profile) (list '()) (let* ((candidates (profile-candidates true-profile)) (n (length true-profile)) (all-ballots (permutations candidates)) (all-profiles (cartesian-product-n all-ballots n))) (filter (lambda (rp) (is-strategic-equilibrium? rp true-profile voting-rule)) all-profiles))))"))
(task-entry (id "game-theory/voting-games/shapley-shubik-weighted") (skill game-theory) (module voting-games) (tier 1) (difficulty 13206) (name shapley-shubik-weighted) (type "") (description "") (notes ()) (section power-indices) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index)) (answer "(define (shapley-shubik-weighted profile weights) (let* ((game (profile->weighted-voting-game profile weights)) (n (profile-voters profile)) (fuel (expt 2 n))) (shapley-value game fuel)))"))
(task-entry (id "game-theory/multi-winner/ballot-top-choice") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13206) (name ballot-top-choice) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight)) (answer "(define (ballot-top-choice ballot remaining) (let loop ((ranking (ballot-ranking ballot))) (cond ((null? ranking) #f) ((member (car ranking) remaining) (car ranking)) (else (loop (cdr ranking))))))"))
