(task-entry (id "sim/bifurcation/find-fixed-point-robust-with-iters") (skill sim) (module bifurcation) (tier 2) (difficulty 23347) (name find-fixed-point-robust-with-iters) (type "(-> ODE Vec Number Number Nat (Option (List Vec Nat)))") (description "Find fixed point using robust Newton, returning iteration count") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry)) (answer "(define (find-fixed-point-robust-with-iters sys initial-guess tolerance step-size max-iter) (let loop ((x initial-guess) (iter 0)) (if (>= iter max-iter) #f (let* ((fx (eval-vector-field sys 0 x)) (norm-fx (vec-norm fx))) (if (< norm-fx tolerance) (list x iter) (let* ((jac (compute-jacobian sys x step-size)) (jac-pinv (pseudoinverse jac))) (if (and (pair? jac-pinv) (eq? (car jac-pinv) 'error)) #f (let* ((delta (matrix-vec-mul jac-pinv fx)) (x-new (vec-sub x delta))) (loop x-new (+ iter 1))))))))))"))
