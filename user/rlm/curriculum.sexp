(task-entry (id "autodiff/traced-optics/trace-value") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12700) (name trace-value) (type "(-> alpha Tape alpha-traced)") (description "Recursively trace value based on structure - follows 'pair of traced' pattern") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available ()) (answer "(define (trace-value v tape) (cond ((traced? v) v) ((number? v) (make-traced-var v tape)) ((vec2? v) (lift-vec2 v tape)) ((and (pair? v) (not (list? v))) (cons (trace-value (car v) tape) (trace-value (cdr v) tape))) ((list? v) (map (lambda (x) (trace-value x tape)) v)) (else v)))"))
(task-entry (id "autodiff/higher-order-diff/jacobian-reverse") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12701) (name jacobian-reverse) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian)) (answer "(define (jacobian-reverse f args n m) (let ((result (make-vector (* m n) 0))) (do ((i 0 (+ i 1))) ((= i m) (list 'matrix m n result)) (with-fresh-ad-scope (lambda () (let* ((tape (make-reverse-tape)) (traced-args (map (lambda (x) (make-traced-var x tape)) args)) (outputs (apply f traced-args)) (output-i (if (or (traced? outputs) (not (list? outputs))) outputs (list-ref outputs i))) (grads (if (traced? output-i) (backward tape (traced-id output-i) 1) (make-hashtable equal-hash equal?))) (arg-ids (map traced-id traced-args))) (do ((j 0 (+ j 1))) ((= j n)) (let* ((arg-id (list-ref arg-ids j)) (grad (hashtable-ref grads arg-id 0))) (vector-set! result (+ (* i n) j) grad)))))))))"))
(task-entry (id "autodiff/differentiable/differentiable-real-methods") (skill autodiff) (module differentiable) (tier 1) (difficulty 12701) (name differentiable-real-methods) (type "") (description "") (notes ()) (section differentiable-typeclass) (deps (\x27;prelude \x27;kinds \x27;infer \x27;resolve \x27;comp-graph \x27;reverse-diff)) (available (TC-Differentiable)) (answer "(define differentiable-real-methods (quasiquote ((lift unquote (lambda (x) x)) (primal unquote (lambda (x) x)) (tangent unquote (lambda (x) 0)) (d+ unquote +) (d* unquote *) (d- unquote -) (d/ unquote /) (d-neg unquote (lambda (x) (- x))) (d-sq unquote (lambda (x) (* x x))) (d-sqrt unquote sqrt) (d-exp unquote exp) (d-log unquote log) (d-sin unquote sin) (d-cos unquote cos))))"))
(task-entry (id "autodiff/differentiable-signal/vec-extract-values") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12701) (name vec-extract-values) (type "(-> (Vector (Either Traced Number)) (Vector Number))") (description "") (notes ()) (section vector-utilities) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec?)) (answer "(define (vec-extract-values v) (let* ((n (vector-length v)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (traced-value (vector-ref v i))))))"))
