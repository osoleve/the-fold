(task-entry (id "meta/analytics/lattice-stats-pretty") (skill meta) (module analytics) (tier 1) (difficulty 11901) (name lattice-stats-pretty) (type "") (description "") (notes ()) (section overall-statistics) (deps ()) (available (lattice-stats)) (answer "(define (lattice-stats-pretty) (if (not (kg-initialized?)) (begin (printf \"Knowledge graph not initialized.\n\") (printf \"Run (lattice-init!) first.\n\")) (let ((stats (lattice-stats))) (printf \"Lattice Statistics\n\") (printf \"====\n\") (printf \"  Skills:       ~a\n\" (cdr (assq 'skills stats))) (printf \"  Modules:      ~a\n\" (cdr (assq 'modules stats))) (printf \"  Exports:      ~a\n\" (cdr (assq 'exports stats))) (printf \"  Dependencies: ~a\n\" (cdr (assq 'dependencies stats))) (printf \"  Roots (T0):   ~a\n\" (cdr (assq 'roots stats))) (printf \"  Leaves:       ~a\n\" (cdr (assq 'leaves stats))) (printf \"  Max Depth:    ~a\n\" (cdr (assq 'max-depth stats))) (printf \"  Avg Deps:     ~a\n\" (round-to (cdr (assq 'avg-deps stats)) 2)))))"))
(task-entry (id "meta/inspect/lattice-describe-pretty") (skill meta) (module inspect) (tier 1) (difficulty 11901) (name lattice-describe-pretty) (type "") (description "") (notes ()) (section none) (deps ()) (available (lattice-describe)) (answer "(define (lattice-describe-pretty skill-name) (if (not (kg-initialized?)) (begin (printf \"Knowledge graph not initialized.\n\") (printf \"Run (lattice-init!) first.\n\")) (let ((data (kg-skill-data skill-name))) (if (not data) (printf \"Skill not found: ~a\n\" skill-name) (let ((name (cdr (assq 'name data))) (version (cdr (or (assq 'version data) '(version . \"0.0.0\")))) (tier (cdr (or (assq 'tier data) '(tier . 0)))) (path (cdr (or (assq 'path data) '(path . \"\")))) (purity (cdr (or (assq 'purity data) '(purity . unknown)))) (stability (cdr (or (assq 'stability data) '(stability . experimental)))) (fuel-bound (cdr (or (assq 'fuel-bound data) '(fuel-bound . \"O(?)\")))) (description (cdr (or (assq 'description data) '(description . \"\")))) (keywords (cdr (or (assq 'keywords data) '(keywords)))) (aliases (cdr (or (assq 'aliases data) '(aliases)))) (deps (kg-deps skill-name)) (uses (kg-uses skill-name)) (modules (kg-modules skill-name))) (printf \"~a\n\" (make-string 60 #\\=)) (printf \"~a v~a\n\" name version) (printf \"~a\n\n\" (make-string 60 #\\=)) (when (and description (not (string=? description \"\"))) (printf \"~a\n\n\" (string-trim description))) (printf \"Tier:      ~a\n\" tier) (printf \"Purity:    ~a\n\" purity) (printf \"Stability: ~a\n\" stability) (printf \"Fuel:      ~a\n\" fuel-bound) (printf \"Path:      ~a\n\n\" path) (unless (null? keywords) (printf \"Keywords:  ~a\n\" keywords)) (unless (null? aliases) (printf \"Aliases:   ~a\n\" aliases)) (printf \"\nDependencies: \") (if (null? deps) (printf \"(none)\n\") (printf \"~a\n\" deps)) (printf \"Used by:      \") (if (null? uses) (printf \"(none)\n\") (printf \"~a\n\" uses)) (printf \"\nModules (~a):\n\" (length modules)) (for-each (lambda (mod) (let* ((mod-name (car mod)) (bare-name (module-bare-name mod-name))) (printf \"  - ~a  (require '~a)\n\" mod-name bare-name))) modules))))))"))
