(task-entry (id "random/monte-carlo/mh-symmetric-step") (skill random) (module monte-carlo) (tier 1) (difficulty 12917) (name mh-symmetric-step) (type "") (description "") (notes ()) (section metropolis-hastings-mcmc) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step)) (answer "(define (mh-symmetric-step log-target proposal current) (state-bind (proposal current) (lambda (proposed) (state-bind random-float (lambda (u) (let* ((log-alpha (- (log-target proposed) (log-target current))) (alpha (min 1 (exp-num log-alpha)))) (if (< u alpha) (state-pure proposed) (state-pure current))))))))"))
