(task-entry (id "egraph/scheduler/scheduler-stats-report") (skill egraph) (module scheduler) (tier 1) (difficulty 10035) (name scheduler-stats-report) (type "(-> (List RuleStats) Void)") (description "Print scheduler statistics report.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler should-run? find-stats update-stats! make-worklist-scheduler make-priority-scheduler saturate-scheduled scheduled-iteration optimize-scheduled scheduler->string rule-stats->string)) (answer "(define (scheduler-stats-report state) (printf \"Scheduler Statistics:~n\") (for-each (lambda (s) (printf \"  ~a: ~a~n\" (pattern->string (rule-lhs (stats-rule s))) (rule-stats->string s))) state))"))
