(task-entry (id "autodiff/higher-order-diff/is-critical-point?") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12776) (name is-critical-point?) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin rec-cos jet-pad-coeffs jet-add jet-sub jet-neg jet-mul jet-sq jet-div jet-recip jet-exp jet-log jet-sqrt jet-sin-cos jet-sin jet-cos jet-tan jet-pow jet-atan jet-asin jet-acos jet-sinh-cosh jet-sinh jet-cosh jet-tanh rec-atan rec-asin rec-acos nth-derivative all-derivatives taylor-coefficients taylor-series taylor-remainder-bound partial-derivative mixed-partial gradient-jet hessian-jet third-derivative-single diff-n diff-operator-naive second-derivative-jet third-derivative-jet fourth-derivative-jet laplacian)) (answer "(define (is-critical-point? f args tolerance) (let ((grad (gradient-jet f args))) (andmap (lambda (g) (< (abs g) tolerance)) grad)))"))
(task-entry (id "autodiff/higher-order-diff/classify-critical-point") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12777) (name classify-critical-point) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin rec-cos jet-pad-coeffs jet-add jet-sub jet-neg jet-mul jet-sq jet-div jet-recip jet-exp jet-log jet-sqrt jet-sin-cos jet-sin jet-cos jet-tan jet-pow jet-atan jet-asin jet-acos jet-sinh-cosh jet-sinh jet-cosh jet-tanh rec-atan rec-asin rec-acos nth-derivative all-derivatives taylor-coefficients taylor-series taylor-remainder-bound partial-derivative mixed-partial gradient-jet hessian-jet third-derivative-single diff-n diff-operator-naive second-derivative-jet third-derivative-jet fourth-derivative-jet laplacian is-critical-point?)) (answer "(define (classify-critical-point f args) (let* ((H (hessian-jet f args)) (n (matrix-rows H))) (if (= n 1) (let ((d2 (matrix-ref H 0 0))) (cond ((> d2 0) 'minimum) ((< d2 0) 'maximum) (else 'inconclusive))) (if (= n 2) (let* ((a (matrix-ref H 0 0)) (b (matrix-ref H 0 1)) (c (matrix-ref H 1 0)) (d (matrix-ref H 1 1)) (det (- (* a d) (* b c))) (trace (+ a d))) (cond ((and (> det 0) (> trace 0)) 'minimum) ((and (> det 0) (< trace 0)) 'maximum) ((< det 0) 'saddle) (else 'inconclusive))) 'inconclusive))))"))
