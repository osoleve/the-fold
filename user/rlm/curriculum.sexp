(task-entry (id "autodiff/differentiable-signal/power-spectrum-grad-real") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12717) (name power-spectrum-grad-real) (type "(-> (Vector Complex) (Vector Number) (Vector Complex))") (description "") (notes ()) (section power-spectrum) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real make-dft-re-local-grads make-dft-im-local-grads diff-dft diff-convolution traced-convolve-1d make-conv-local-grads power-spectrum-grad)) (answer "(define (power-spectrum-grad-real X output-grad) (let* ((n (vector-length X)) (result (make-vector n))) (do ((k 0 (+ k 1))) ((= k n) result) (let* ((x-k (vector-ref X k)) (g-k (if (< k (vector-length output-grad)) (vector-ref output-grad k) 0)) (grad (complex-scale (* 2 g-k) x-k))) (vector-set! result k grad)))))"))
(task-entry (id "autodiff/sparse-autodiff/detect-sparsity") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12717) (name detect-sparsity) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices)) (answer "(define (detect-sparsity f args tolerance) (let* ((n (length args)) (sample-result (apply f (map (lambda (x) (make-traced-var x (make-reverse-tape))) args))) (m (if (or (traced? sample-result) (not (list? sample-result))) 1 (length sample-result))) (entries (let loop-i ((i 0) (acc '())) (if (= i m) (reverse acc) (with-fresh-ad-scope (lambda () (let* ((tape (make-reverse-tape)) (traced-args (map (lambda (x) (make-traced-var x tape)) args)) (outputs (apply f traced-args)) (output-i (if (or (traced? outputs) (not (list? outputs))) outputs (list-ref outputs i))) (grads (if (traced? output-i) (backward tape (traced-id output-i) 1) (make-hashtable equal-hash equal?))) (arg-ids (map traced-id traced-args)) (new-acc (let loop-j ((j 0) (ids arg-ids) (current-acc acc)) (if (null? ids) current-acc (let ((grad (hashtable-ref grads (car ids) 0))) (loop-j (+ j 1) (cdr ids) (if (> (abs grad) tolerance) (cons (cons i j) current-acc) current-acc))))))) (loop-i (+ i 1) new-acc))))))) (nnz (length entries)) (row-idx (make-vector nnz 0)) (col-idx (make-vector nnz 0))) (do ((k 0 (+ k 1)) (es entries (cdr es))) ((= k nnz) (make-sparsity-pattern m n row-idx col-idx)) (let ((entry (car es))) (vector-set! row-idx k (car entry)) (vector-set! col-idx k (cdr entry))))))"))
(task-entry (id "autodiff/typed-gradients/dim-jacobian-matrix") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12717) (name dim-jacobian-matrix) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols)) (answer "(define (dim-jacobian-matrix j) (if (dim-jacobian? j) (cadddr j) #f))"))
(task-entry (id "autodiff/profiling/tape-memory-estimate") (skill autodiff) (module profiling) (tier 1) (difficulty 12717) (name tape-memory-estimate) (type "") (description "") (notes ()) (section tape-statistics) (deps (\x27;prelude \x27;comp-graph \x27;reverse-diff \x27;sort)) (available (tape-stats tape-size tape-op-count graph-stats graph-edge-count graph-depth extract-input-ids find-node-id tally-ops current-microseconds time-thunk time-gradient *ptr-size* *fixnum-size* *flonum-size* *pair-size* *vector-header*)) (answer "(define (tape-memory-estimate tape) (let* ((entries (reverse-tape-entries tape)) (n (length entries))) (if (zero? n) 0 (let ((entry-overhead (* 4 *pair-size*)) (id-size *fixnum-size*) (avg-inputs 2) (input-list-size (* 2 (+ *pair-size* *fixnum-size*))) (grad-list-size (* 2 (+ *pair-size* *flonum-size*))) (tape-overhead (* 2 *pair-size*))) (+ tape-overhead (* n (+ entry-overhead id-size input-list-size grad-list-size)))))))"))
(task-entry (id "autodiff/symbolic-diff/simplify-diff") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12717) (name simplify-diff) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list)) (answer "(define (simplify-diff left right) (cond ((and (num? right) (= (num-val right) 0)) left) ((and (num? left) (= (num-val left) 0)) (simplify-neg right)) ((and (num? left) (num? right)) (num (- (num-val left) (num-val right)))) ((expr=? left right) (num 0)) (else (difference left right))))"))
(task-entry (id "autodiff/interval-autodiff/iv-traced-div") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12717) (name iv-traced-div) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul)) (answer "(define (iv-traced-div a b) (let* ((av (interval-traced-value a)) (bv (interval-traced-value b)) (result (interval-div av bv))) (if (error? result) result (let ((tape (or (and (interval-traced? a) (interval-traced-tape a)) (and (interval-traced? b) (interval-traced-tape b))))) (if tape (let* ((one (interval-singleton 1)) (recip-b (interval-recip bv)) (b-sq (interval-sqr bv)) (neg-a-over-b2 (interval-div (interval-neg av) b-sq))) (if (or (error? recip-b) (error? neg-a-over-b2)) '(error division-by-zero) (interval-traced-op 'div result (list a b) (list recip-b neg-a-over-b2) tape))) result)))))"))
