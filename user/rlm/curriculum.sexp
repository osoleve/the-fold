(task-entry (id "fp/simplify/simplify-neg") (skill fp) (module simplify) (tier 1) (difficulty 10614) (name simplify-neg) (type "(-> Expr Expr)") (description "Simplify negation expression") (notes ()) (section difference-and-negation) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff)) (answer "(define (simplify-neg e) (cond ((num? e) (num (- (num-val e)))) ((and (difference? e) (not (diff-right e))) (diff-left e)) ((and (product? e) (>= (length (product-factors e)) 2) (num? (car (product-factors e)))) (let ((coef (num-val (car (product-factors e)))) (rest (cdr (product-factors e)))) (product (num (- coef)) (if (= (length rest) 1) (car rest) (cons '* rest))))) (else (make-neg e))))"))
(task-entry (id "fp/integrate/can-express-in-u?") (skill fp) (module integrate) (tier 1) (difficulty 10614) (name can-express-in-u?) (type "") (description "") (notes ()) (section u-substitution) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power integrate-quotient integrate-by-substitution try-substitution-pattern find-antiderivative-match find-u-candidates substitute-u)) (answer "(define (can-express-in-u? expr u var-sym) (cond ((expr=? expr u) #t) ((num? expr) #t) ((var? expr) (not (eq? (var-name expr) var-sym))) ((sum? expr) (for-all (lambda (t) (can-express-in-u? t u var-sym)) (sum-terms expr))) ((product? expr) (for-all (lambda (f) (can-express-in-u? f u var-sym)) (product-factors expr))) ((power? expr) (and (can-express-in-u? (pow-base expr) u var-sym) (can-express-in-u? (pow-exp expr) u var-sym))) ((app? expr) (can-express-in-u? (app-arg expr) u var-sym)) (else #f)))"))
(task-entry (id "fp/solve/extract-product-coeff") (skill fp) (module solve) (tier 1) (difficulty 10614) (name extract-product-coeff) (type "") (description "") (notes ()) (section equation-representation) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl)) (answer "(define (extract-product-coeff factors var-sym k) (let* ((var-factors (filter (lambda (f) (contains-var? f var-sym)) factors)) (const-factors (filter (lambda (f) (not (contains-var? f var-sym))) factors)) (const-prod (if (null? const-factors) (num 1) (make-product-from-terms const-factors)))) (cond ((null? var-factors) (if (= k 0) const-prod (num 0))) ((= (length var-factors) 1) (let ((vf (car var-factors))) (cond ((and (var? vf) (eq? (var-name vf) var-sym)) (if (= k 1) const-prod (num 0))) ((and (power? vf) (var? (pow-base vf)) (eq? (var-name (pow-base vf)) var-sym) (num? (pow-exp vf))) (if (= k (num-val (pow-exp vf))) const-prod (num 0))) (else (num 0))))) (else (num 0)))))"))
