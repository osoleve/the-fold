(task-entry (id "data/pagerank/personalized-pagerank") (skill data) (module pagerank) (tier 0) (difficulty 1312) (name personalized-pagerank) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations* adjacency->transition matrix-row-sum matrix-col-sum make-google-matrix pagerank-from-matrix pagerank-power-iteration vec-norm-1 vec-sum pagerank)) (answer "(define (personalized-pagerank adj teleport-vec . opts) (let* ((n (matrix-rows adj)) (damping (if (and (pair? opts) (number? (car opts))) (car opts) *default-damping-factor*)) (rest1 (if (and (pair? opts) (number? (car opts))) (cdr opts) opts)) (max-iter (if (and (pair? rest1) (integer? (car rest1))) (car rest1) *pagerank-max-iterations*)) (rest2 (if (and (pair? rest1) (integer? (car rest1))) (cdr rest1) rest1)) (tol (if (and (pair? rest2) (number? (car rest2))) (car rest2) *pagerank-tolerance*))) (if (not (= (vector-length teleport-vec) n)) (quasiquote (error dimension-mismatch (unquote n) (unquote (vector-length teleport-vec)))) (let ((trans (adjacency->transition adj))) (if (and (pair? trans) (eq? (car trans) 'error)) trans (let* ((google-data (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let* ((idx (+ (* i n) j)) (m-ij (matrix-ref trans i j)) (teleport (* (- 1.0 damping) (vector-ref teleport-vec i))) (g-ij (+ (* damping m-ij) teleport))) (vector-set! google-data idx g-ij)))) (let* ((google (list 'matrix n n google-data)) (v0 (make-vec n (/ 1.0 n)))) (pagerank-power-iteration google v0 max-iter tol))))))))"))
