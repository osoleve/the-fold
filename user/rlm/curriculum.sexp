(task-entry (id "physics/classical/integrators/body-kinetic-energy") (skill physics/classical) (module integrators) (tier 2) (difficulty 23535) (name body-kinetic-energy) (type "(body-kinetic-energy : Body2D → Number)") (description "") (notes ()) (section energy) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet integrate-body-rk4 make-time-acc time-acc? time-acc-remaining time-acc-fixed-dt time-acc-max-steps time-acc-add time-acc-consume time-acc-alpha substep-body integrate-with-substeps interpolate-body gravity-force spring-force drag-force constant-force combine-forces)) (answer "(define (body-kinetic-energy body) (* 0.5 (body-mass body) (vec2-magnitude-sq (body-vel body))))"))
(task-entry (id "physics/classical/collision-detection/circle-aabb?") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23535) (name circle-aabb?) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold)) (answer "(define (circle-aabb? circle aabb) (let* ((center (circle-center circle)) (r (circle-radius circle)) (min-p (aabb-min aabb)) (max-p (aabb-max aabb)) (closest-x (max (vec2-x min-p) (min (vec2-x center) (vec2-x max-p)))) (closest-y (max (vec2-y min-p) (min (vec2-y center) (vec2-y max-p)))) (closest (vec2 closest-x closest-y)) (dist-sq (vec2-distance-sq center closest))) (<= dist-sq (* r r))))"))
