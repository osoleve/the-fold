(task-entry (id "info/entropy/normalized-pmi") (skill info) (module entropy) (tier 1) (difficulty 11135) (name normalized-pmi) (type "(-> Number Number Number Number)") (description "NPMI(x,y) = PMI(x,y) / (-log2(P(x,y))), normalized to [-1, 1]") (notes ()) (section information-content) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy conditional-entropy-direct mutual-information mutual-information-from-joint compute-marginal-x compute-marginal-y cross-entropy kl-divergence symmetric-kl jensen-shannon-divergence gaussian-entropy uniform-entropy exponential-entropy laplace-entropy sample-entropy count-occurrences assoc-helper update-count variation-of-information normalized-mutual-information renyi-entropy collision-entropy min-entropy hartley-entropy surprisal pointwise-mutual-information)) (answer "(define (normalized-pmi p-xy p-x p-y) (let ((pmi (pointwise-mutual-information p-xy p-x p-y)) (denom (surprisal p-xy))) (if (or (= denom +inf.0) (= denom 0)) 0 (/ pmi denom))))"))
