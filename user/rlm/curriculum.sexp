(task-entry (id "linalg/dep-linalg/diff-jacobian") (skill linalg) (module dep-linalg) (tier 0) (difficulty 418) (name diff-jacobian) (type "Π n m α. Diff (Vec n α) (Vec m α) → Vec n α → Matrix m n α") (description "Compute Jacobian matrix.") (notes ()) (section differentiable-operations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (dep-linalg-types vec-append-typed vec-zip-typed vec-head-typed vec-tail-typed vec-map-typed vec-fold-typed matrix-mul-typed matrix-add-typed matrix-transpose-typed matrix-scale-typed vec-ref-safe matrix-ref-safe vec-nil-typed vec-cons-typed make-dep-linalg-ctx extend-ctx-with-dep-linalg diff-grad)) (answer "(define (diff-jacobian n m A diff-fn x) (let ((jacobian-fn (cdr (assq 'jacobian diff-fn)))) (if jacobian-fn (jacobian-fn x) (error 'diff-jacobian \"Cannot compute Jacobian\" diff-fn))))"))
