(task-entry (id "data/pagerank/pagerank") (skill data) (module pagerank) (tier 0) (difficulty 1311) (name pagerank) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations* adjacency->transition matrix-row-sum matrix-col-sum make-google-matrix pagerank-from-matrix pagerank-power-iteration vec-norm-1 vec-sum)) (answer "(define (pagerank edges . opts) (let* ((n (if (and (pair? opts) (integer? (car opts))) (car opts) (infer-node-count edges))) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts))) (let ((adj (edges->adjacency-matrix edges n))) (if (and (pair? adj) (eq? (car adj) 'error)) adj (apply pagerank-from-matrix (cons adj rest1))))))"))
(task-entry (id "data/graph-matrix/adjacency-matrix-remove-edge!") (skill data) (module graph-matrix) (tier 0) (difficulty 1311) (name adjacency-matrix-remove-edge!) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge!)) (answer "(define (adjacency-matrix-remove-edge! m i j) (let ((n (matrix-cols m)) (data (matrix-data m))) (vector-set! data (+ (* i n) j) 0)))"))
(task-entry (id "data/centrality/closeness-centrality") (skill data) (module centrality) (tier 0) (difficulty 1311) (name closeness-centrality) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges)) (answer "(define (closeness-centrality dist . opts) (let* ((n (matrix-rows dist)) (harmonic (if (pair? opts) (car opts) #f)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (if harmonic (harmonic-closeness-node dist i n) (standard-closeness-node dist i n))))))"))
(task-entry (id "data/graph-community/kruskal-mst") (skill data) (module graph-community) (tier 0) (difficulty 1311) (name kruskal-mst) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight)) (answer "(define (kruskal-mst edges n) (let* ((sorted-edges (sort-by (lambda (a b) (< (caddr a) (caddr b))) edges)) (parent (make-vector n 0)) (rank (make-vector n 0)) (mst-edges '()) (edge-count 0)) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! parent i i)) (for-each (lambda (edge) (when (< edge-count (- n 1)) (let* ((u (car edge)) (v (cadr edge)) (root-u (uf-find parent u)) (root-v (uf-find parent v))) (when (not (= root-u root-v)) (set! mst-edges (cons edge mst-edges)) (set! edge-count (+ edge-count 1)) (uf-union parent rank root-u root-v))))) sorted-edges) (reverse mst-edges)))"))
(task-entry (id "data/graph-layout/node-y-lens") (skill data) (module graph-layout) (tier 0) (difficulty 1311) (name node-y-lens) (type "") (description "") (notes ()) (section graph-representation) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens)) (answer "(define node-y-lens (>>> node-pos-lens (vec-element-lens 1)))"))
(task-entry (id "data/kdtree/point-distance") (skill data) (module kdtree) (tier 0) (difficulty 1311) (name point-distance) (type "(-> Point Point Num)") (description "Euclidean distance between points") (notes ()) (section point-utilities) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq)) (answer "(define (point-distance p1 p2) (sqrt (point-distance-sq p1 p2)))"))
