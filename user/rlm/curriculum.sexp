(task-entry (id "dataset/distractor/distractor-order-swap") (skill dataset) (module distractor) (tier 1) (difficulty 13409) (name distractor-order-swap) (type "") (description "") (notes ()) (section builtin) (deps (\x27;prelude \x27;prng \x27;parameter \x27;sort)) (available (make-distractor-strategy distractor-strategy? distractor-strategy-name distractor-strategy-generator distractor-nearby distractor-sign-flip distractor-off-by-one distractor-double-half distractor-wrong-sign-convention)) (answer "(define distractor-order-swap (make-distractor-strategy 'order-swap (lambda (correct rng) (cond ((eq? correct 'greater) 'less) ((eq? correct 'less) 'greater) ((eq? correct 'A) 'B) ((eq? correct 'B) 'A) (else correct)))))"))
