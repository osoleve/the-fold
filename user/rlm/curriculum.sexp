(task-entry (id "statistics/summary-stats/correlation") (skill statistics) (module summary-stats) (tier 1) (difficulty 11212) (name correlation) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance)) (answer "(define (correlation xs ys) (let ((cov (covariance xs ys)) (sx (std-dev xs)) (sy (std-dev ys))) (if (or (= sx 0) (= sy 0)) 0 (/ cov (* sx sy)))))"))
(task-entry (id "statistics/design-matrix/rbind") (skill statistics) (module design-matrix) (tier 1) (difficulty 11212) (name rbind) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind)) (answer "(define (rbind X1 X2) (let* ((m1 (matrix-rows X1)) (m2 (matrix-rows X2)) (m (+ m1 m2)) (n (matrix-cols X1)) (data (make-vector (* m n)))) (if (not (= n (matrix-cols X2))) (error 'rbind \"matrices must have same number of columns\") (begin (do ((i 0 (+ i 1))) ((= i m1)) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! data (+ (* i n) j) (matrix-ref X1 i j)))) (do ((i 0 (+ i 1))) ((= i m2)) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! data (+ (* (+ m1 i) n) j) (matrix-ref X2 i j)))) (list 'matrix m n data)))))"))
