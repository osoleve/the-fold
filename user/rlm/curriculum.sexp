(task-entry (id "physics/classical/rigid-body/integrate-rigid-body") (skill physics/classical) (module rigid-body) (tier 2) (difficulty 23532) (name integrate-rigid-body) (type "") (description "") (notes ()) (section integration) (deps (\x27;prelude \x27;vec2)) (available (make-rigid-body rigid-body? rigid-body-pos rigid-body-vel rigid-body-angle rigid-body-angular-vel rigid-body-mass rigid-body-inv-mass rigid-body-inertia rigid-body-inv-inertia rigid-body-static? rigid-body-with-pos rigid-body-with-vel rigid-body-with-angle rigid-body-with-angular-vel rigid-body-with-mass rigid-body-with-inertia rigid-body-with-state make-static-rigid-body circle-inertia rectangle-inertia rod-inertia point-mass-inertia local-to-world world-to-local rigid-body-velocity-at apply-linear-impulse apply-angular-impulse apply-impulse-at-point rigid-body-kinetic-energy rigid-body-linear-momentum rigid-body-angular-momentum)) (answer "(define (integrate-rigid-body body linear-accel angular-accel dt) (if (rigid-body-static? body) body (let* ((new-vel (vec2-add (rigid-body-vel body) (vec2-scale linear-accel dt))) (new-omega (+ (rigid-body-angular-vel body) (* angular-accel dt))) (new-pos (vec2-add (rigid-body-pos body) (vec2-scale new-vel dt))) (new-angle (+ (rigid-body-angle body) (* new-omega dt)))) (rigid-body-with-state body new-pos new-vel new-angle new-omega))))"))
(task-entry (id "physics/classical/collision-detection/aabb-aabb-manifold") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23532) (name aabb-aabb-manifold) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb?)) (answer "(define (aabb-aabb-manifold a b) (if (not (aabb-aabb? a b)) #f (let* ((a-center (aabb-center a)) (b-center (aabb-center b)) (a-half (aabb-half-extents a)) (b-half (aabb-half-extents b)) (diff (vec2-sub b-center a-center)) (overlap-x (- (+ (vec2-x a-half) (vec2-x b-half)) (abs (vec2-x diff)))) (overlap-y (- (+ (vec2-y a-half) (vec2-y b-half)) (abs (vec2-y diff))))) (if (< overlap-x overlap-y) (let* ((sign-x (if (< (vec2-x diff) 0) -1 1)) (normal (vec2 sign-x 0)) (contact (vec2 (+ (vec2-x a-center) (* (vec2-x a-half) sign-x)) (vec2-y b-center)))) (list normal overlap-x contact)) (let* ((sign-y (if (< (vec2-y diff) 0) -1 1)) (normal (vec2 0 sign-y)) (contact (vec2 (vec2-x b-center) (+ (vec2-y a-center) (* (vec2-y a-half) sign-y))))) (list normal overlap-y contact))))))"))
