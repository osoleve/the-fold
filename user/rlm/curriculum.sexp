(task-entry (id "optics/format-iso/iso-bool-symbol") (skill optics) (module format-iso) (tier 1) (difficulty 11013) (name iso-bool-symbol) (type "") (description "") (notes ()) (section booleans) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string sexpr->bytevector bytevector->sexpr iso-sexpr-bytevector iso-list-vector iso-alist-keys-sorted iso-number-string iso-exact-inexact iso-bool-int)) (answer "(define iso-bool-symbol (make-p-iso (lambda (b) (if b 'true 'false)) (lambda (s) (eq? s 'true))))"))
