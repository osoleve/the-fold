(task-entry (id "linalg/graph-laplacian/spectral-partition") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 408) (name spectral-partition) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components)) (answer "(define (spectral-partition adj) (let ((fiedler (fiedler-vector adj))) (if (and (pair? fiedler) (eq? (car fiedler) 'error)) fiedler (let ((n (vector-length fiedler))) (let loop ((i 0) (part-a '()) (part-b '())) (if (= i n) (cons (reverse part-a) (reverse part-b)) (if (>= (vector-ref fiedler i) 0) (loop (+ i 1) (cons i part-a) part-b) (loop (+ i 1) part-a (cons i part-b)))))))))"))
(task-entry (id "linalg/svd/compute-v-from-atu") (skill linalg) (module svd) (tier 0) (difficulty 408) (name compute-v-from-atu) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av)) (answer "(define (compute-v-from-atu at u singular-values m n tol) (let ((v (make-matrix n n 0)) (rank (count-nonzero-singular-values singular-values tol))) (do ((i 0 (+ i 1))) ((= i (min rank m))) (let* ((sigma-i (vector-ref singular-values i)) (u-i (matrix-col u i)) (atu-i (matrix-vec-mul at u-i)) (v-i (vec-scale (/ 1.0 sigma-i) atu-i))) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! v j i (vector-ref v-i j))))) (if (< rank n) (complete-orthogonal-basis! v rank n) v) v))"))
