ion (min (* friction (abs j-normal)) tangent-speed)) (friction-impulse (vec3-scale tangent j-friction)) (new-a (rigid-body-3d-apply-impulse body-a friction-impulse contact)) (new-b (rigid-body-3d-apply-impulse body-b (vec3-negate friction-impulse) contact))) (values new-a new-b)))))"))
