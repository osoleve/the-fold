(task-entry (id "algebra/galois/gf2n-inv-raw") (skill algebra) (module galois) (tier 0) (difficulty 328) (name gf2n-inv-raw) (type "") (description "") (notes ()) (section gf2n-binary-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw)) (answer "(define (gf2n-inv-raw a n irred) (if (= a 0) (error 'gf2n-inv \"cannot invert zero\") (let loop ((r0 irred) (r1 a) (s0 0) (s1 1)) (if (= r1 0) s0 (if (= r1 1) s1 (let* ((deg-r0 (gf2n-bit-length r0)) (deg-r1 (gf2n-bit-length r1)) (shift (- deg-r0 deg-r1))) (if (< shift 0) (loop r1 r0 s1 s0) (let* ((r1-shifted (bitwise-arithmetic-shift-left r1 shift)) (s1-shifted (bitwise-arithmetic-shift-left s1 shift)) (new-r0 (bitwise-xor r0 r1-shifted)) (new-s0 (bitwise-xor s0 s1-shifted))) (loop new-r0 r1 new-s0 s1)))))))))"))
