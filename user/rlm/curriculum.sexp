(task-entry (id "physics/classical/collision-detection/find-collision-pairs") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23559) (name find-collision-pairs) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon? closest-point-on-segment circle-polygon-manifold project-polygon project-circle intervals-overlap polygon-polygon? polygon-polygon-manifold shape-type shape-aabb shapes-collide? aabb-to-polygon shapes-manifold make-spatial-hash spatial-hash? spatial-hash-cell-size spatial-hash-table point-to-cell aabb-to-cells spatial-hash-insert! spatial-hash-clear! spatial-hash-query)) (answer "(define (find-collision-pairs items hash) (spatial-hash-clear! hash) (for-each (lambda (item) (let ((obj (car item)) (shape (cdr item))) (spatial-hash-insert! hash obj (shape-aabb shape)))) items) (let ((pairs (make-hashtable equal-hash equal?)) (n (length items))) (let loop ((remaining items)) (if (null? remaining) (let-values (((keys vals) (hashtable-entries pairs))) (vector->list keys)) (let* ((item (car remaining)) (obj (car item)) (shape (cdr item)) (candidates (spatial-hash-query hash (shape-aabb shape)))) (for-each (lambda (other) (when (not (eq? obj other)) (let ((pair-key (if (< (equal-hash obj) (equal-hash other)) (cons obj other) (cons other obj)))) (hashtable-set! pairs pair-key #t)))) candidates) (loop (cdr remaining)))))))"))
(task-entry (id "physics/classical/world/world-raycast-all") (skill physics/classical) (module world) (tier 2) (difficulty 23559) (name world-raycast-all) (type "") (description "") (notes ()) (section world) (deps (\x27;prelude \x27;vec2 \x27;integrators \x27;collision-detection \x27;collision-response \x27;raycasting \x27;constraints \x27;constraint-solver \x27;sort)) (available (make-entity entity? entity-id entity-body entity-shape entity-material entity-user-data entity-with-body entity-pos entity-vel entity-static? transform-shape entity-world-shape make-world-config config-fixed-dt config-max-substeps config-solver-iterations config-cell-size make-world world? world-entities world-gravity world-spatial-hash world-config world-time-acc world-constraints world-with-time-acc world-add-entity! world-remove-entity! world-get-entity world-entity-list world-update-entity! world-add-constraint! world-remove-constraint! world-get-constraint world-constraint-list world-update-constraint! make-force-acc force-acc-add! force-acc-get force-acc-clear! world-step! world-fixed-step! world-resolve-collision-velocities! world-correct-collision-positions! world-solve-constraint-velocities! world-correct-constraint-positions! world-integrate-velocities! world-integrate-positions! world-detect-collisions make-pair-key make-circle-entity make-box-entity make-static-circle make-static-box make-ground world-query-aabb world-query-point world-raycast-closest)) (answer "(define (world-raycast-all world ray) (let* ((entities (world-entity-list world)) (hits '())) (for-each (lambda (e) (let* ((shape (entity-world-shape e)) (hit (ray2-shape ray shape))) (when hit (set! hits (cons (cons e hit) hits))))) entities) (sort-by (lambda (a b) (< (hit-info-distance (cdr a)) (hit-info-distance (cdr b)))) hits)))"))
(task-entry (id "physics/classical/particles/burst") (skill physics/classical) (module particles) (tier 2) (difficulty 23559) (name burst) (type "") (description "") (notes ()) (section burst) (deps (\x27;prelude \x27;sort \x27;vec2 \x27;prng)) (available (make-particle particle? particle-pos particle-vel particle-lifetime particle-max-life particle-size particle-color particle-user-data particle-alive? particle-age particle-with-pos particle-with-vel particle-with-state gravity-field wind-field drag-field attractor-field vortex-field turbulence-field combine-fields integrate-particle update-particle update-particles make-emitter emitter? emitter-pos emitter-rate emitter-spread emitter-direction emitter-speed-min emitter-speed-max emitter-lifetime-min emitter-lifetime-max emitter-size-min emitter-size-max emitter-color emitter-user-data emitter-accumulator emitter-with-pos emitter-with-direction emitter-with-accumulator spawn-particle emitter-emit make-particle-system particle-system? particle-system-emitters particle-system-particles particle-system-forces particle-system-count particle-system-add-emitter particle-system-add-force particle-system-add-particles particle-system-step make-empty-system make-simple-emitter make-explosion-emitter make-fountain-emitter make-fire-emitter)) (answer "(define (burst pos spread speed lifetime count color rng) (let loop ((n count) (particles '()) (r rng)) (if (<= n 0) (cons particles r) (let* ((r1 (run-state (random-float-range (- spread) spread) r)) (angle (+ (car r1) (* -0.5 3.14159))) (rng1 (cdr r1)) (r2 (run-state (random-float-range 0.8 1.2) rng1)) (speed-var (* speed (car r2))) (rng2 (cdr r2)) (vel (vec2-scale (vec2-from-angle angle) speed-var)) (p (make-particle pos vel lifetime lifetime 3 color #f))) (loop (- n 1) (cons p particles) rng2)))))"))
