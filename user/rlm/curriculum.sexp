(task-entry (id "optimization/interval-contract/box-equal?") (skill optimization) (module interval-contract) (tier 1) (difficulty 12803) (name box-equal?) (type "") (description "") (notes ()) (section contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once)) (answer "(define (box-equal? box1 box2) (and (= (length box1) (length box2)) (let loop ((b1 box1) (b2 box2)) (or (null? b1) (and (= (interval-lo (car b1)) (interval-lo (car b2))) (= (interval-hi (car b1)) (interval-hi (car b2))) (loop (cdr b1) (cdr b2)))))))"))
