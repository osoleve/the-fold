(task-entry (id "control-systems/transfer-function/make-tf") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22601) (name make-tf) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf?)) (answer "(define (make-tf num den) (let ((lead (poly-leading den))) (if (zero? lead) '(error zero-denominator) (let ((scale (/ 1 lead))) (list 'tf (poly-scale num scale) (poly-normalize den))))))"))
(task-entry (id "control-systems/z-transform/make-dtf") (skill control-systems) (module z-transform) (tier 2) (difficulty 22601) (name make-dtf) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf?)) (answer "(define (make-dtf num den Ts) (let ((lead (poly-leading den))) (if (zero? lead) '(error zero-denominator) (let ((scale (/ 1 lead))) (list 'dtf (poly-scale num scale) (poly-normalize den) Ts)))))"))
(task-entry (id "control-systems/tf-convert/ss->tf-leverrier") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22601) (name ss->tf-leverrier) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf)) (answer "(define (ss->tf-leverrier A B C D input-idx output-idx n) (let* ((b-col (matrix-column B input-idx)) (c-row (matrix-row C output-idx)) (d-val (matrix-ref D output-idx input-idx)) (fl-result (faddeev-leverrier A n)) (char-coeffs (car fl-result)) (adj-matrices (cdr fl-result)) (num-coeffs (compute-tf-numerator c-row adj-matrices b-col d-val char-coeffs n))) (tf-from-coeffs num-coeffs char-coeffs)))"))
