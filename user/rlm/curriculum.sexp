(task-entry (id "statistics/ma/weighted-moving-average") (skill statistics) (module ma) (tier 1) (difficulty 11201) (name weighted-moving-average) (type "") (description "") (notes ()) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (moving-average)) (answer "(define (weighted-moving-average xs weights) (let* ((n (vector-length xs)) (k (vector-length weights)) (m (- n k -1)) (result (make-vector m)) (weight-sum (let loop ((i 0) (s 0)) (if (= i k) s (loop (+ i 1) (+ s (vector-ref weights i)))))) (norm-weights (let ((v (make-vector k))) (do ((i 0 (+ i 1))) ((= i k) v) (vector-set! v i (/ (vector-ref weights i) (max weight-sum 1e-10))))))) (do ((t 0 (+ t 1))) ((= t m) result) (let ((val (let loop ((j 0) (s 0)) (if (= j k) s (loop (+ j 1) (+ s (* (vector-ref norm-weights j) (vector-ref xs (+ t j))))))))) (vector-set! result t val)))))"))
