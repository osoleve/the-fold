ssian? vfamily) (elbo-gradient-mf traced-log-joint (mf-gaussian-means vfamily) (mf-gaussian-log-stds vfamily) epsilons)) (else (error 'vi-step-adam-traced \"Only mean-field Gaussian supported\"))))) (let-values (((new-adam deltas) (adam-update adam-state grad lr beta1 beta2 eps))) (let* ((new-params (map + params deltas)) (new-vfamily (vfamily-from-params type d new-params))) (values new-vfamily new-prng new-adam)))))))))"))
