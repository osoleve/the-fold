(task-entry (id "tiles/units/game-move-unit") (skill tiles) (module units) (tier 1) (difficulty 12311) (name game-move-unit) (type "(-> GameState Symbol Coord (-> Coord (List Coord)) (Maybe GameState))") (description "Move unit to destination if reachable. Checks movement range.") (notes ()) (section movement) (deps (\x27;tiles/core)) (available (make-unit unit-get-prop unit-set-prop make-game-state game-board game-place-unit game-remove-unit game-get-unit-at game-get-unit-coord game-all-units game-units-by-team)) (answer "(define (game-move-unit gs unit-id dest neighbor-fn) (let* ((board (game-board gs)) (start (game-get-unit-coord gs unit-id)) (unit (game-get-unit-at gs start))) (if (and start unit) (let* ((movement (unit-get-prop unit 'movement 999)) (path (find-path-dijkstra board start dest neighbor-fn))) (if (and path (<= (length path) (+ movement 1))) (game-place-unit gs unit dest) #f)) #f)))"))
