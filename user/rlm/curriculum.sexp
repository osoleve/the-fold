(task-entry (id "linalg/matrix/matrix-map2") (skill linalg) (module matrix) (tier 0) (difficulty 414) (name matrix-map2) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose matrix-map)) (answer "(define (matrix-map2 f m1 m2) (let ((r1 (matrix-rows m1)) (c1 (matrix-cols m1)) (r2 (matrix-rows m2)) (c2 (matrix-cols m2))) (if (not (and (= r1 r2) (= c1 c2))) (quasiquote (error dimension-mismatch ((unquote r1) (unquote c1)) ((unquote r2) (unquote c2)))) (let* ((data1 (matrix-data m1)) (data2 (matrix-data m2)) (n (* r1 c1)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix r1 c1 result)) (vector-set! result i (f (vector-ref data1 i) (vector-ref data2 i))))))))"))
(task-entry (id "linalg/matrix-eigen/inverse-iteration-loop") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 414) (name inverse-iteration-loop) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration)) (answer "(define (inverse-iteration-loop a-shifted v iter max-iter tol) (if (>= iter max-iter) (quasiquote (error no-convergence (unquote iter))) (let ((lu-result (matrix-lu a-shifted))) (if (and (pair? lu-result) (eq? (car lu-result) 'error)) (if (eq? (cadr lu-result) 'singular-matrix) v lu-result) (let* ((x (matrix-lu-solve lu-result v)) (x-norm (vec-norm x))) (if (< x-norm tol) v (let* ((x-new (vec-scale (/ 1.0 x-norm) x)) (dot (abs (vec-dot v x-new)))) (if (> dot (- 1.0 tol)) x-new (inverse-iteration-loop a-shifted x-new (+ iter 1) max-iter tol)))))))))"))
(task-entry (id "linalg/iterative-solvers/gmres") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 414) (name gmres) (type "") (description "") (notes ()) (section gmres) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop)) (answer "(define (gmres a b . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (cond ((not (= n m)) (quasiquote (error not-square (unquote n) (unquote m)))) ((not (= n (vector-length b))) (quasiquote (error dimension-mismatch (unquote n) (unquote (vector-length b))))) (else (let* ((restart (if (and (pair? opts) (integer? (car opts))) (car opts) (min 30 n))) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (x0 (if (and (pair? rest1) (vector? (car rest1))) (car rest1) (make-vector n 0.0))) (rest2 (if (and (pair? rest1) (vector? (car rest1))) (cdr rest1) rest1)) (max-iter (if (and (pair? rest2) (integer? (car rest2))) (car rest2) *iterative-max-iterations*)) (rest3 (if (and (pair? rest2) (integer? (car rest2))) (cdr rest2) rest2)) (tol (if (and (pair? rest3) (number? (car rest3))) (car rest3) *iterative-tolerance*))) (gmres-outer a b restart (vector-copy x0) 0 max-iter tol n))))))"))
