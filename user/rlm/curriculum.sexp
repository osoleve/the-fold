(task-entry (id "data/sort/vector-sort-by") (skill data) (module sort) (tier 0) (difficulty 1334) (name vector-sort-by) (type "(-> (-> α α Boolean) (Vector α) (Vector α))") (description "Return new sorted vector using custom comparator") (notes ("Non-destructive: original vector is unchanged")) (section vector-sorting) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort sort-by-key sort-by-key-desc sort-desc quicksort-desc sorted? sorted-by? sorted-desc? unique-sorted sort-unique nth-smallest median min-element max-element min-by max-by take-sorted top-k bottom-k vector-swap! vector-sort-by!)) (answer "(define (vector-sort-by cmp vec) (let* ((n (vector-length vec)) (copy (make-vector n))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! copy i (vector-ref vec i))) (vector-sort-by! cmp copy) copy))"))
