(task-entry (id "fp/cost-analysis/operation-cost") (skill fp) (module cost-analysis) (tier 1) (difficulty 10608) (name operation-cost) (type "(-> Symbol Nat)") (description "Look up the cost of a primitive or HOF.\nReturns 10 for unknown operations (conservative estimate).") (notes ()) (section operation-cost-tables) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs*)) (answer "(define (operation-cost op) (let ((prim-entry (assq op *primitive-costs*)) (hof-entry (assq op *hof-costs*))) (cond (prim-entry (cdr prim-entry)) (hof-entry (cdr hof-entry)) (else 10))))"))
