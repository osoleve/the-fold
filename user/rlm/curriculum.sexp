(task-entry (id "autodiff/traced-optics/lift-at-optic") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12702) (name lift-at-optic) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value untrace-value)) (answer "(define (lift-at-optic optic s tape) (when (traced? s) (error 'lift-at-optic \"Expected structure with traced leaves, got traced container.\n            Use pair-of-traced pattern like TracedVec2.\")) (let ((otype (optic-type optic))) (cond ((eq? otype 'lens) (let* ((focus (view optic s)) (traced-focus (trace-value focus tape)) (s-traced (set-lens optic traced-focus s))) (values s-traced traced-focus))) ((eq? otype 'prism) (let ((result (preview optic s))) (if (nothing? result) (values s nothing) (let* ((focus (from-just result)) (traced-focus (trace-value focus tape)) (s-traced (review optic traced-focus))) (values s-traced (just traced-focus)))))) ((eq? otype 'affine) (let ((result (preview optic s))) (if (nothing? result) (values s nothing) (let* ((focus (from-just result)) (traced-focus (trace-value focus tape)) (s-traced (affine-set optic traced-focus s))) (values s-traced (just traced-focus)))))) ((eq? otype 'traversal) (let* ((focuses (traversal-to-list optic s)) (traced-focuses (map (lambda (f) (trace-value f tape)) focuses))) (if (and (list? s) (eq? optic traversal-each)) (values traced-focuses traced-focuses) (let ((queue traced-focuses)) (values (traversal-over optic (lambda (_) (let ((v (car queue))) (set! queue (cdr queue)) v)) s) traced-focuses))))) ((eq? otype 'iso) (let* ((focus (iso-forward optic s)) (traced-focus (trace-value focus tape)) (s-traced (iso-backward optic traced-focus))) (values s-traced traced-focus))) ((eq? otype 'getter) (error 'lift-at-optic \"Cannot compute gradient through Getter (read-only optic).\n               Use Lens or Traversal for modifiable access.\")) ((eq? otype 'fold) (error 'lift-at-optic \"Cannot compute gradient through Fold (read-only optic).\n               Use Traversal for modifiable multi-target access.\")) (else (error 'lift-at-optic \"Unknown optic type\" otype)))))"))
(task-entry (id "autodiff/higher-order-diff/hessian") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12703) (name hessian) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward)) (answer "(define (hessian f args) (let ((n (length args))) (hessian-reverse-forward f args n)))"))
(task-entry (id "autodiff/differentiable/differentiable-dual-methods") (skill autodiff) (module differentiable) (tier 1) (difficulty 12703) (name differentiable-dual-methods) (type "") (description "") (notes ()) (section differentiable-typeclass) (deps (\x27;prelude \x27;kinds \x27;infer \x27;resolve \x27;comp-graph \x27;reverse-diff)) (available (TC-Differentiable differentiable-real-methods inst-Differentiable-Real)) (answer "(define differentiable-dual-methods (quasiquote ((lift unquote dual-lift) (primal unquote dual-value) (tangent unquote dual-deriv) (d+ unquote dual-add) (d* unquote dual-mul) (d- unquote dual-sub) (d/ unquote dual-div) (d-neg unquote dual-neg) (d-sq unquote dual-sq) (d-sqrt unquote dual-sqrt) (d-exp unquote dual-exp) (d-log unquote dual-log) (d-sin unquote dual-sin) (d-cos unquote dual-cos))))"))
(task-entry (id "autodiff/differentiable-signal/dft-vjp") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12703) (name dft-vjp) (type "(-> (Vector Complex) (Vector Complex))") (description "DFT VJP (Vector-Jacobian Product)") (notes ()) (section dft-vjp) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape)) (answer "(define (dft-vjp output-grad) (let* ((n (vector-length output-grad)) (idft-result (idft output-grad)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (complex-scale n (vector-ref idft-result i))))))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-grad-indices") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12703) (name sparse-grad-indices) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz)) (answer "(define (sparse-grad-indices g) (list-ref g 2))"))
