(task-entry (id "clp/label/stream->list-limit") (skill clp) (module label) (tier 1) (difficulty 10813) (name stream->list-limit) (type "(-> Stream Nat List)") (description "Convert stream to list with limit") (notes ()) (section convenience-labeling) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with label-values try-value label-all label-all-with-limit)) (answer "(define (stream->list-limit stream limit) (if (or (<= limit 0) (stream-nil? stream)) '() (cons (stream-head stream) (stream->list-limit (stream-tail stream) (- limit 1)))))"))
(task-entry (id "clp/clp/goal->=fd") (skill clp) (module clp) (tier 1) (difficulty 10813) (name goal->=fd) (type "(-> (Or LVar Int) (Or LVar Int) Goal)") (description "Constraint x >= y") (notes ()) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd)) (answer "(define (goal->=fd x y) (lambda (cs) (let ((result (post->=fd cs x y))) (if result (clp-succeed result) (clp-fail cs)))))"))
(task-entry (id "clp/domain/domain-intersect") (skill clp) (module domain) (tier 1) (difficulty 10814) (name domain-intersect) (type "(-> Domain Domain Domain)") (description "Compute intersection of two domains") (notes ()) (section domain-operations) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds)) (answer "(define (domain-intersect dom1 dom2) (let loop ((d1 dom1) (d2 dom2) (acc '())) (cond ((or (null? d1) (null? d2)) (reverse acc)) (else (let* ((i1 (car d1)) (i2 (car d2)) (lo1 (car i1)) (hi1 (cdr i1)) (lo2 (car i2)) (hi2 (cdr i2)) (lo (max lo1 lo2)) (hi (min hi1 hi2))) (cond ((> lo hi) (if (< hi1 hi2) (loop (cdr d1) d2 acc) (loop d1 (cdr d2) acc))) (else (let ((new-acc (cons (cons lo hi) acc))) (cond ((< hi1 hi2) (loop (cdr d1) d2 new-acc)) ((> hi1 hi2) (loop d1 (cdr d2) new-acc)) (else (loop (cdr d1) (cdr d2) new-acc)))))))))))"))
(task-entry (id "clp/store/cstore-narrow-domain") (skill clp) (module store) (tier 1) (difficulty 10814) (name cstore-narrow-domain) (type "(-> CStore LVar Domain (Maybe CStore))") (description "Intersect variable's domain with given domain") (notes ()) (section domain-operations-on-store) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove)) (answer "(define (cstore-narrow-domain cs var new-dom) (let ((current (cstore-get-domain cs var))) (if current (cstore-set-domain cs var (domain-intersect current new-dom)) (cstore-set-domain cs var new-dom))))"))
(task-entry (id "clp/fd-constraints/+fd") (skill clp) (module fd-constraints) (tier 1) (difficulty 10814) (name \x2B;fd) (type "(-> (Or LVar Int) (Or LVar Int) (Or LVar Int) (-> CStore (Maybe CStore)))") (description "Constrain x + y = z using bounds consistency") (notes ()) (section arithmetic-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const =/=fd-var-var)) (answer "(define (+fd x y z) (lambda (cs) (let ((x-val (fd-value cs x)) (y-val (fd-value cs y)) (z-val (fd-value cs z))) (cond ((and x-val y-val z-val) (if (= (+ x-val y-val) z-val) cs #f)) ((and x-val y-val) ((=fd z (+ x-val y-val)) cs)) ((and x-val z-val) ((=fd y (- z-val x-val)) cs)) ((and y-val z-val) ((=fd x (- z-val y-val)) cs)) (else (+fd-bounds cs x y z))))))"))
(task-entry (id "clp/global-constraints/count-fd") (skill clp) (module global-constraints) (tier 1) (difficulty 10814) (name count-fd) (type "(-> Int (List LVar) (Or LVar Int) (-> CStore (Maybe CStore)))") (description "Constrain: count of value in vars = n") (notes ()) (section count-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate sum-fd-narrow-vars post-sum-fd)) (answer "(define (count-fd value vars n) (lambda (cs) (count-fd-propagate cs value vars n)))"))
(task-entry (id "clp/propagate/post-*fd") (skill clp) (module propagate) (tier 1) (difficulty 10814) (name post-*fd) (type "(-> CStore (Or LVar Int) (Or LVar Int) (Or LVar Int) (Maybe CStore))") (description "Post multiplication constraint and propagate") (notes ()) (section high-level-constraint-posting) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd post-<fd post-<=fd post->fd post->=fd post-=/=fd post-+fd post--fd)) (answer "(define (post-*fd cs x y z) (let ((vars (filter lvar? (list x y z)))) (if (null? vars) ((*fd x y z) cs) (post-constraint cs '*fd vars (*fd x y z)))))"))
(task-entry (id "clp/label/label-first") (skill clp) (module label) (tier 1) (difficulty 10814) (name label-first) (type "(-> CStore (List LVar) (Maybe CStore))") (description "Get first solution or #f if none") (notes ()) (section convenience-labeling) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with label-values try-value label-all label-all-with-limit stream->list-limit)) (answer "(define (label-first cs vars) (let ((solutions (label cs vars))) (if (stream-nil? solutions) #f (stream-head solutions))))"))
(task-entry (id "clp/clp/goal-=/=fd") (skill clp) (module clp) (tier 1) (difficulty 10814) (name goal-=/=fd) (type "(-> (Or LVar Int) (Or LVar Int) Goal)") (description "Constraint x ≠ y (disequality)") (notes ()) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd)) (answer "(define (goal-=/=fd x y) (lambda (cs) (let ((result (post-=/=fd cs x y))) (if result (clp-succeed result) (clp-fail cs)))))"))
(task-entry (id "clp/domain/domain-union") (skill clp) (module domain) (tier 1) (difficulty 10815) (name domain-union) (type "(-> Domain Domain Domain)") (description "Compute union of two domains") (notes ()) (section domain-operations) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect)) (answer "(define (domain-union dom1 dom2) (merge-intervals (append dom1 dom2)))"))
(task-entry (id "clp/store/cstore-remove-value") (skill clp) (module store) (tier 1) (difficulty 10815) (name cstore-remove-value) (type "(-> CStore LVar Int (Maybe CStore))") (description "Remove a single value from variable's domain") (notes ()) (section domain-operations-on-store) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain)) (answer "(define (cstore-remove-value cs var val) (let ((current (cstore-get-domain cs var))) (if current (cstore-set-domain cs var (domain-subtract-value current val)) cs)))"))
(task-entry (id "clp/fd-constraints/fd-value") (skill clp) (module fd-constraints) (tier 1) (difficulty 10815) (name fd-value) (type "(-> CStore (Or LVar Int) (Maybe Int))") (description "Get the value of a term if it's ground or singleton") (notes ()) (section arithmetic-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const =/=fd-var-var \x2B;fd)) (answer "(define (fd-value cs term) (cond ((integer? term) term) ((lvar? term) (let ((dom (cstore-get-domain cs term))) (if (and dom (domain-singleton? dom)) (domain-min dom) #f))) (else #f)))"))
(task-entry (id "clp/global-constraints/count-fd-propagate") (skill clp) (module global-constraints) (tier 1) (difficulty 10815) (name count-fd-propagate) (type "(-> CStore Int (List LVar) (Or LVar Int) (Maybe CStore))") (description "Propagate count constraint by narrowing based on must/can counts") (notes ()) (section count-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate sum-fd-narrow-vars post-sum-fd count-fd)) (answer "(define (count-fd-propagate cs value vars n) (let* ((must-count (count-must-equal cs value vars)) (can-count (count-can-equal cs value vars)) (n-bounds (fd-bounds cs n))) (if (not n-bounds) cs (let ((n-lo (car n-bounds)) (n-hi (cdr n-bounds))) (let ((new-lo (max n-lo must-count)) (new-hi (min n-hi can-count))) (if (> new-lo new-hi) #f (let ((cs1 (fd-narrow-bounds cs n new-lo new-hi))) (and cs1 (count-fd-fix cs1 value vars must-count can-count new-lo new-hi)))))))))"))
(task-entry (id "clp/propagate/satisfied?") (skill clp) (module propagate) (tier 1) (difficulty 10815) (name satisfied?) (type "(-> CStore Boolean)") (description "Check if all variables are ground (complete solution)") (notes ()) (section constraint-satisfaction-check) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd post-<fd post-<=fd post->fd post->=fd post-=/=fd post-+fd post--fd post-*fd)) (answer "(define (satisfied? cs) (let ((domains (cstore-domains cs))) (and (null? (cstore-pending cs)) (all domain-singleton? (map cdr domains)))))"))
(task-entry (id "clp/label/label-count") (skill clp) (module label) (tier 1) (difficulty 10815) (name label-count) (type "(-> CStore (List LVar) Nat)") (description "Count solutions (with limit of 10000 to prevent infinite counting)") (notes ()) (section convenience-labeling) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with label-values try-value label-all label-all-with-limit stream->list-limit label-first)) (answer "(define (label-count cs vars) (label-count-with-limit cs vars 10000))"))
(task-entry (id "clp/clp/goal-+fd") (skill clp) (module clp) (tier 1) (difficulty 10815) (name goal-+fd) (type "(-> (Or LVar Int) (Or LVar Int) (Or LVar Int) Goal)") (description "Constraint x + y = z") (notes ()) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd)) (answer "(define (goal-+fd x y z) (lambda (cs) (let ((result (post-+fd cs x y z))) (if result (clp-succeed result) (clp-fail cs)))))"))
(task-entry (id "clp/domain/merge-intervals") (skill clp) (module domain) (tier 1) (difficulty 10816) (name merge-intervals) (type "(-> (List Interval) Domain)") (description "Merge and normalize a list of intervals") (notes ()) (section domain-operations) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union)) (answer "(define (merge-intervals intervals) (if (null? intervals) '() (let ((sorted (sort-by interval<? intervals))) (let loop ((rest (cdr sorted)) (current (car sorted)) (acc '())) (cond ((null? rest) (reverse (cons current acc))) (else (let* ((next (car rest)) (cur-hi (cdr current)) (next-lo (car next)) (next-hi (cdr next))) (if (>= (+ cur-hi 1) next-lo) (loop (cdr rest) (cons (car current) (max cur-hi next-hi)) acc) (loop (cdr rest) next (cons current acc))))))))))"))
(task-entry (id "clp/store/cstore-bind-var") (skill clp) (module store) (tier 1) (difficulty 10816) (name cstore-bind-var) (type "(-> CStore LVar Int (Maybe CStore))") (description "Bind a variable to a specific integer value") (notes ("Checks domain constraint and updates substitution")) (section binding-operations) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value)) (answer "(define (cstore-bind-var cs var val) (let ((dom (cstore-get-domain cs var))) (if (and dom (not (domain-contains? dom val))) #f (let* ((subst (extend-subst var val (cstore-subst cs))) (cs1 (cstore-set-subst cs subst))) (if dom (cstore-set-domain cs1 var (domain-singleton val)) cs1)))))"))
(task-entry (id "clp/fd-constraints/+fd-bounds") (skill clp) (module fd-constraints) (tier 1) (difficulty 10816) (name \x2B;fd-bounds) (type "(-> CStore (Or LVar Int) (Or LVar Int) (Or LVar Int) (Maybe CStore))") (description "Bounds propagation for x + y = z") (notes ()) (section arithmetic-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const =/=fd-var-var \x2B;fd fd-value)) (answer "(define (+fd-bounds cs x y z) (let* ((x-bounds (fd-bounds cs x)) (y-bounds (fd-bounds cs y)) (z-bounds (fd-bounds cs z))) (if (and x-bounds y-bounds z-bounds) (let* ((x-lo (car x-bounds)) (x-hi (cdr x-bounds)) (y-lo (car y-bounds)) (y-hi (cdr y-bounds)) (z-lo (car z-bounds)) (z-hi (cdr z-bounds)) (new-z-lo (max z-lo (+ x-lo y-lo))) (new-z-hi (min z-hi (+ x-hi y-hi))) (new-x-lo (max x-lo (- z-lo y-hi))) (new-x-hi (min x-hi (- z-hi y-lo))) (new-y-lo (max y-lo (- z-lo x-hi))) (new-y-hi (min y-hi (- z-hi x-lo)))) (let* ((cs1 (fd-narrow-bounds cs z new-z-lo new-z-hi)) (cs2 (and cs1 (fd-narrow-bounds cs1 x new-x-lo new-x-hi))) (cs3 (and cs2 (fd-narrow-bounds cs2 y new-y-lo new-y-hi)))) cs3)) cs)))"))
(task-entry (id "clp/global-constraints/count-must-equal") (skill clp) (module global-constraints) (tier 1) (difficulty 10816) (name count-must-equal) (type "(-> CStore Int (List LVar) Nat)") (description "Count variables that must equal value (singleton with that value)") (notes ()) (section count-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate sum-fd-narrow-vars post-sum-fd count-fd count-fd-propagate)) (answer "(define (count-must-equal cs value vars) (length (filter (lambda (var) (let ((dom (cstore-get-domain cs var))) (and dom (domain-singleton? dom) (= (domain-min dom) value)))) vars)))"))
(task-entry (id "clp/propagate/all") (skill clp) (module propagate) (tier 1) (difficulty 10816) (name all) (type "(-> (-> α Boolean) (List α) Boolean)") (description "") (notes ()) (section constraint-satisfaction-check) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd post-<fd post-<=fd post->fd post->=fd post-=/=fd post-+fd post--fd post-*fd satisfied?)) (answer "(define (all pred lst) (cond ((null? lst) #t) ((not (pred (car lst))) #f) (else (all pred (cdr lst)))))"))
(task-entry (id "clp/label/label-count-with-limit") (skill clp) (module label) (tier 1) (difficulty 10816) (name label-count-with-limit) (type "(-> CStore (List LVar) Nat Nat)") (description "Count solutions up to specified limit") (notes ()) (section convenience-labeling) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with label-values try-value label-all label-all-with-limit stream->list-limit label-first label-count)) (answer "(define (label-count-with-limit cs vars limit) (let loop ((stream (label cs vars)) (count 0)) (if (or (>= count limit) (stream-nil? stream)) count (loop (stream-tail stream) (+ count 1)))))"))
(task-entry (id "clp/clp/goal--fd") (skill clp) (module clp) (tier 1) (difficulty 10816) (name goal--fd) (type "(-> (Or LVar Int) (Or LVar Int) (Or LVar Int) Goal)") (description "Constraint x - y = z") (notes ()) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd)) (answer "(define (goal--fd x y z) (lambda (cs) (let ((result (post--fd cs x y z))) (if result (clp-succeed result) (clp-fail cs)))))"))
(task-entry (id "clp/domain/interval<?") (skill clp) (module domain) (tier 1) (difficulty 10817) (name interval<?) (type "(-> Interval Interval Bool)") (description "Compare intervals by their lower bound") (notes ()) (section domain-operations) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals)) (answer "(define (interval<? i1 i2) (< (car i1) (car i2)))"))
(task-entry (id "clp/store/cstore-unify") (skill clp) (module store) (tier 1) (difficulty 10817) (name cstore-unify) (type "(-> CStore α α (Maybe CStore))") (description "Unify two terms, respecting domain constraints") (notes ()) (section binding-operations) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var)) (answer "(define (cstore-unify cs u v) (let* ((subst (cstore-subst cs)) (u (walk u subst)) (v (walk v subst))) (cond ((and (lvar? u) (lvar? v) (lvar=? u v)) cs) ((lvar? u) (cstore-bind-term cs u v)) ((lvar? v) (cstore-bind-term cs v u)) ((and (pair? u) (pair? v)) (let ((cs1 (cstore-unify cs (car u) (car v)))) (and cs1 (cstore-unify cs1 (cdr u) (cdr v))))) ((equal? u v) cs) (else #f))))"))
(task-entry (id "clp/fd-constraints/fd-bounds") (skill clp) (module fd-constraints) (tier 1) (difficulty 10817) (name fd-bounds) (type "(-> CStore (Or LVar Int) (Maybe (Pair Int Int)))") (description "Get bounds of a term") (notes ()) (section arithmetic-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const =/=fd-var-var \x2B;fd fd-value \x2B;fd-bounds)) (answer "(define (fd-bounds cs term) (cond ((integer? term) (cons term term)) ((lvar? term) (let ((dom (cstore-get-domain cs term))) (if dom (domain-bounds dom) #f))) (else #f)))"))
(task-entry (id "clp/global-constraints/count-can-equal") (skill clp) (module global-constraints) (tier 1) (difficulty 10817) (name count-can-equal) (type "(-> CStore Int (List LVar) Nat)") (description "Count variables that can equal value (value in domain)") (notes ()) (section count-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate sum-fd-narrow-vars post-sum-fd count-fd count-fd-propagate count-must-equal)) (answer "(define (count-can-equal cs value vars) (length (filter (lambda (var) (let ((dom (cstore-get-domain cs var))) (or (not dom) (domain-contains? dom value)))) vars)))"))
(task-entry (id "clp/propagate/propagate-trace") (skill clp) (module propagate) (tier 1) (difficulty 10817) (name propagate-trace) (type "(-> CStore (Maybe CStore))") (description "Propagation with tracing output for debugging") (notes ()) (section debugging-support) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd post-<fd post-<=fd post->fd post->=fd post-=/=fd post-+fd post--fd post-*fd satisfied? all)) (answer "(define (propagate-trace cs) (propagate-trace-with-fuel cs 100))"))
(task-entry (id "clp/label/make-labeling-strategy") (skill clp) (module label) (tier 1) (difficulty 10817) (name make-labeling-strategy) (type "(-> VarOrder ValSelect (-> CStore (List LVar) (Stream CStore)))") (description "Create a labeling function from component strategies") (notes ()) (section strategy-constructors) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with label-values try-value label-all label-all-with-limit stream->list-limit label-first label-count label-count-with-limit)) (answer "(define (make-labeling-strategy var-order val-select) (lambda (cs vars) (label-with var-order val-select cs vars)))"))
(task-entry (id "clp/clp/goal-*fd") (skill clp) (module clp) (tier 1) (difficulty 10817) (name goal-*fd) (type "(-> (Or LVar Int) (Or LVar Int) (Or LVar Int) Goal)") (description "Constraint x * y = z") (notes ()) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd)) (answer "(define (goal-*fd x y z) (lambda (cs) (let ((result (post-*fd cs x y z))) (if result (clp-succeed result) (clp-fail cs)))))"))
(task-entry (id "clp/domain/domain-subtract-value") (skill clp) (module domain) (tier 1) (difficulty 10818) (name domain-subtract-value) (type "(-> Domain Int Domain)") (description "Remove a single value from the domain") (notes ()) (section domain-operations) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals interval<?)) (answer "(define (domain-subtract-value dom n) (let loop ((intervals dom) (acc '())) (cond ((null? intervals) (reverse acc)) (else (let* ((interval (car intervals)) (lo (car interval)) (hi (cdr interval))) (cond ((< n lo) (append (reverse acc) intervals)) ((> n hi) (loop (cdr intervals) (cons interval acc))) ((and (= n lo) (= n hi)) (loop (cdr intervals) acc)) ((= n lo) (loop (cdr intervals) (cons (cons (+ lo 1) hi) acc))) ((= n hi) (loop (cdr intervals) (cons (cons lo (- hi 1)) acc))) (else (loop (cdr intervals) (cons (cons (+ n 1) hi) (cons (cons lo (- n 1)) acc))))))))))"))
(task-entry (id "clp/store/cstore-bind-term") (skill clp) (module store) (tier 1) (difficulty 10818) (name cstore-bind-term) (type "(-> CStore LVar Term (Maybe CStore))") (description "Bind a variable to a term (integer, variable, or structure)") (notes ()) (section binding-operations) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify)) (answer "(define (cstore-bind-term cs var term) (cond ((integer? term) (cstore-bind-var cs var term)) ((lvar? term) (let* ((dom1 (cstore-get-domain cs var)) (dom2 (cstore-get-domain cs term))) (cond ((and dom1 dom2) (let ((merged (domain-intersect dom1 dom2))) (if (domain-empty? merged) #f (let* ((subst (extend-subst var term (cstore-subst cs))) (cs1 (cstore-set-subst cs subst)) (cs2 (cstore-set-domain cs1 var merged))) (and cs2 (cstore-set-domain cs2 term merged)))))) (dom1 (let* ((subst (extend-subst var term (cstore-subst cs))) (cs1 (cstore-set-subst cs subst))) (cstore-set-domain cs1 term dom1))) (dom2 (let* ((subst (extend-subst var term (cstore-subst cs))) (cs1 (cstore-set-subst cs subst))) (cstore-set-domain cs1 var dom2))) (else (let ((subst (extend-subst var term (cstore-subst cs)))) (cstore-set-subst cs subst)))))) (else (if (occurs? var term (cstore-subst cs)) #f (let ((subst (extend-subst var term (cstore-subst cs)))) (cstore-set-subst cs subst))))))"))
(task-entry (id "clp/fd-constraints/fd-narrow-bounds") (skill clp) (module fd-constraints) (tier 1) (difficulty 10818) (name fd-narrow-bounds) (type "(-> CStore (Or LVar Int) Int Int (Maybe CStore))") (description "Narrow a term's bounds") (notes ()) (section arithmetic-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const =/=fd-var-var \x2B;fd fd-value \x2B;fd-bounds fd-bounds)) (answer "(define (fd-narrow-bounds cs term lo hi) (cond ((integer? term) (if (and (>= term lo) (<= term hi)) cs #f)) ((lvar? term) (let ((dom (cstore-get-domain cs term))) (if dom (cstore-set-domain cs term (domain-intersect dom (make-domain lo hi))) cs))) (else cs)))"))
(task-entry (id "clp/global-constraints/count-fd-fix") (skill clp) (module global-constraints) (tier 1) (difficulty 10818) (name count-fd-fix) (type "(-> CStore Int (List LVar) Nat Nat Nat Nat (Maybe CStore))") (description "Apply deductions when count bounds are tight") (notes ()) (section count-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate sum-fd-narrow-vars post-sum-fd count-fd count-fd-propagate count-must-equal count-can-equal)) (answer "(define (count-fd-fix cs value vars must can lo hi) (cond ((= lo can) (fix-all-can-vars cs value vars)) ((= hi must) (remove-value-from-can-vars cs value vars)) (else cs)))"))
(task-entry (id "clp/propagate/propagate-trace-with-fuel") (skill clp) (module propagate) (tier 1) (difficulty 10818) (name propagate-trace-with-fuel) (type "") (description "") (notes ()) (section debugging-support) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd post-<fd post-<=fd post->fd post->=fd post-=/=fd post-+fd post--fd post-*fd satisfied? all propagate-trace)) (answer "(define (propagate-trace-with-fuel cs fuel) (display \"  Fuel: \") (display fuel) (display \" Pending: \") (display (cstore-pending cs)) (newline) (if (<= fuel 0) (begin (display \"  OUT OF FUEL\n\") cs) (let ((popped (cstore-pop-pending cs))) (if (not popped) (begin (display \"  FIXPOINT\n\") cs) (let* ((var-id (car popped)) (cs1 (cdr popped)) (constraints (cstore-constraints cs1)) (relevant (filter-constraints-by-var-id constraints var-id))) (display \"  Propagating var _\") (display var-id) (display \" (\") (display (length relevant)) (display \" constraints)\n\") (propagate-constraints-trace cs1 relevant (- fuel 1)))))))"))
(task-entry (id "clp/label/label-ff-min") (skill clp) (module label) (tier 1) (difficulty 10818) (name label-ff-min) (type "") (description "") (notes ()) (section strategy-constructors) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with label-values try-value label-all label-all-with-limit stream->list-limit label-first label-count label-count-with-limit make-labeling-strategy)) (answer "(define label-ff-min (make-labeling-strategy first-fail min-value))"))
(task-entry (id "clp/clp/goal-all-different") (skill clp) (module clp) (tier 1) (difficulty 10818) (name goal-all-different) (type "(-> (List LVar) Goal)") (description "Constraint that all variables have distinct values") (notes ("Uses post-constraint to register for re-propagation during labeling")) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd)) (answer "(define (goal-all-different vars) (lambda (cs) (let ((cs1 (post-constraint cs 'all-different vars (all-different vars)))) (if cs1 (clp-succeed cs1) (clp-fail cs)))))"))
(task-entry (id "clp/domain/domain-subtract") (skill clp) (module domain) (tier 1) (difficulty 10819) (name domain-subtract) (type "(-> Domain Domain Domain)") (description "Remove all values in dom2 from dom1") (notes ()) (section domain-operations) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals interval<? domain-subtract-value)) (answer "(define (domain-subtract dom1 dom2) (let loop ((d1 dom1) (d2 dom2) (acc '())) (cond ((null? d1) (reverse acc)) ((null? d2) (append (reverse acc) d1)) (else (let* ((i1 (car d1)) (i2 (car d2)) (lo1 (car i1)) (hi1 (cdr i1)) (lo2 (car i2)) (hi2 (cdr i2))) (cond ((< hi2 lo1) (loop d1 (cdr d2) acc)) ((< hi1 lo2) (loop (cdr d1) d2 (cons i1 acc))) ((and (<= lo2 lo1) (>= hi2 hi1)) (loop (cdr d1) d2 acc)) ((and (<= lo2 lo1) (< hi2 hi1)) (loop (cons (cons (+ hi2 1) hi1) (cdr d1)) (cdr d2) acc)) ((and (> lo2 lo1) (>= hi2 hi1)) (loop (cdr d1) d2 (cons (cons lo1 (- lo2 1)) acc))) (else (loop (cons (cons (+ hi2 1) hi1) (cdr d1)) (cdr d2) (cons (cons lo1 (- lo2 1)) acc)))))))))"))
(task-entry (id "clp/store/occurs?") (skill clp) (module store) (tier 1) (difficulty 10819) (name occurs?) (type "(-> LVar Term Substitution Bool)") (description "Check if variable occurs in term (for occurs check)") (notes ()) (section binding-operations) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term)) (answer "(define (occurs? var term subst) (let ((term (walk term subst))) (cond ((lvar? term) (lvar=? var term)) ((pair? term) (or (occurs? var (car term) subst) (occurs? var (cdr term) subst))) (else #f))))"))
(task-entry (id "clp/fd-constraints/-fd") (skill clp) (module fd-constraints) (tier 1) (difficulty 10819) (name \x2D;fd) (type "(-> (Or LVar Int) (Or LVar Int) (Or LVar Int) (-> CStore (Maybe CStore)))") (description "Constrain x - y = z, which is x = z + y") (notes ()) (section arithmetic-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const =/=fd-var-var \x2B;fd fd-value \x2B;fd-bounds fd-bounds fd-narrow-bounds)) (answer "(define (-fd x y z) (+fd z y x))"))
(task-entry (id "clp/global-constraints/fix-all-can-vars") (skill clp) (module global-constraints) (tier 1) (difficulty 10819) (name fix-all-can-vars) (type "(-> CStore Int (List LVar) (Maybe CStore))") (description "Set all vars that can equal value to that value") (notes ()) (section count-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate sum-fd-narrow-vars post-sum-fd count-fd count-fd-propagate count-must-equal count-can-equal count-fd-fix)) (answer "(define (fix-all-can-vars cs value vars) (let loop ((vars vars) (cs cs)) (if (null? vars) cs (let* ((var (car vars)) (dom (cstore-get-domain cs var))) (if (or (not dom) (domain-contains? dom value)) (if (and dom (domain-singleton? dom)) (loop (cdr vars) cs) (let ((cs1 (cstore-set-domain cs var (domain-singleton value)))) (if cs1 (loop (cdr vars) cs1) #f))) (loop (cdr vars) cs))))))"))
(task-entry (id "clp/propagate/propagate-constraints-trace") (skill clp) (module propagate) (tier 1) (difficulty 10819) (name propagate-constraints-trace) (type "") (description "") (notes ()) (section debugging-support) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd post-<fd post-<=fd post->fd post->=fd post-=/=fd post-+fd post--fd post-*fd satisfied? all propagate-trace propagate-trace-with-fuel)) (answer "(define (propagate-constraints-trace cs constraints fuel) (if (null? constraints) (propagate-trace-with-fuel cs fuel) (let* ((constraint (car constraints)) (propagator (constraint-propagator constraint)) (cs1 (propagator cs))) (display \"    \") (display (constraint-type constraint)) (if cs1 (display \" OK\n\") (display \" FAIL\n\")) (if (not cs1) #f (propagate-constraints-trace cs1 (cdr constraints) fuel)))))"))
(task-entry (id "clp/label/label-ff-max") (skill clp) (module label) (tier 1) (difficulty 10819) (name label-ff-max) (type "") (description "") (notes ()) (section strategy-constructors) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with label-values try-value label-all label-all-with-limit stream->list-limit label-first label-count label-count-with-limit make-labeling-strategy label-ff-min)) (answer "(define label-ff-max (make-labeling-strategy first-fail max-value))"))
(task-entry (id "clp/clp/goal-sum-fd") (skill clp) (module clp) (tier 1) (difficulty 10819) (name goal-sum-fd) (type "(-> (List LVar) (Or LVar Int) Goal)") (description "Constraint that sum of vars equals result") (notes ("Uses post-constraint to register for re-propagation during labeling")) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different)) (answer "(define (goal-sum-fd vars result) (lambda (cs) (let ((cs1 (post-sum-fd cs vars result))) (if cs1 (clp-succeed cs1) (clp-fail cs)))))"))
(task-entry (id "clp/domain/domain-restrict-min") (skill clp) (module domain) (tier 1) (difficulty 10820) (name domain-restrict-min) (type "(-> Domain Int Domain)") (description "Keep only values >= n") (notes ()) (section domain-operations) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals interval<? domain-subtract-value domain-subtract)) (answer "(define (domain-restrict-min dom n) (let loop ((intervals dom) (acc '())) (cond ((null? intervals) (reverse acc)) (else (let* ((interval (car intervals)) (lo (car interval)) (hi (cdr interval))) (cond ((< hi n) (loop (cdr intervals) acc)) ((>= lo n) (append (reverse acc) intervals)) (else (loop (cdr intervals) (cons (cons n hi) acc)))))))))"))
