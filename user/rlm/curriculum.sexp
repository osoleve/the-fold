(task-entry (id "algebra/polynomial/poly-add") (skill algebra) (module polynomial) (tier 0) (difficulty 314) (name poly-add) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x)) (answer "(define (poly-add p1 p2) (let* ((F (poly-field p1)) (c1 (poly-coeffs p1)) (c2 (poly-coeffs p2)) (add (field-add-op F))) (make-polynomial F (poly-add-coeffs add c1 c2 (field-zero F)))))"))
