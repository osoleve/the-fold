(task-entry (id "statistics/summary-stats/vec-sem") (skill statistics) (module summary-stats) (tier 1) (difficulty 11225) (name vec-sem) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max vec-median vec-quantile vec-quantiles vec-covariance vec-correlation sem)) (answer "(define (vec-sem v) (/ (vec-std-dev v) (sqrt (vector-length v))))"))
(task-entry (id "statistics/result-types/glm-aic") (skill statistics) (module result-types) (tier 1) (difficulty 11226) (name glm-aic) (type "") (description "") (notes ()) (section glm-results) (deps (\x27;prelude)) (available (make-linear-model-result linear-model? linear-model-coefficients linear-model-se linear-model-t-values linear-model-p-values linear-model-r-squared linear-model-adj-r-squared linear-model-residuals linear-model-fitted linear-model-sse linear-model-mse linear-model-n linear-model-p linear-model-df-residual linear-model-sigma make-glm-result glm-result? glm-family glm-link glm-coefficients glm-se glm-z-values glm-p-values glm-deviance glm-null-deviance)) (answer "(define (glm-aic m) (list-ref m 9))"))
(task-entry (id "statistics/summary-stats/skewness") (skill statistics) (module summary-stats) (tier 1) (difficulty 11226) (name skewness) (type "(-> (List Num) Num)") (description "Population skewness (third standardized moment)") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max vec-median vec-quantile vec-quantiles vec-covariance vec-correlation sem vec-sem)) (answer "(define (skewness xs) (let* ((n (length xs)) (mu (mean xs)) (s (std-dev-population xs)) (m3 (/ (fold-left + 0 (map (lambda (x) (expt (- x mu) 3)) xs)) n))) (if (= s 0) 0 (/ m3 (expt s 3)))))"))
