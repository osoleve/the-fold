(task-entry (id "physics/classical3d/constraint-solver3d/solve-distance-velocity-3d") (skill physics/classical3d) (module constraint-solver3d) (tier 2) (difficulty 22407) (name solve-distance-velocity-3d) (type "") (description "") (notes ()) (section solver-constants) (deps (\x27;prelude \x27;vec3 \x27;quaternion \x27;rigid-body3d \x27;constraints3d)) (available (*baumgarte-factor-3d* *position-slop-3d* *angular-slop-3d* apply-impulse-at-point-3d apply-angular-impulse-3d velocity-at-point-3d compute-effective-mass-inv-3d)) (answer "(define (solve-distance-velocity-3d body-a body-b pos-a pos-b target-dist dt) (let* ((delta (vec3-sub pos-b pos-a)) (current-dist (vec3-magnitude delta)) (n (if (< current-dist 1e-4) (vec3 1 0 0) (vec3-normalize delta))) (vel-a (velocity-at-point-3d body-a pos-a)) (vel-b (if body-b (velocity-at-point-3d body-b pos-b) (vec3-zero))) (rel-vel (vec3-sub vel-b vel-a)) (v-n (vec3-dot rel-vel n)) (r-a (vec3-sub pos-a (rigid-body-3d-pos body-a))) (r-b (if body-b (vec3-sub pos-b (rigid-body-3d-pos body-b)) (vec3-zero))) (inv-mass-a (rigid-body-3d-inv-mass body-a)) (inv-mass-b (if body-b (rigid-body-3d-inv-mass body-b) 0)) (rn-a (vec3-cross r-a n)) (rn-b (vec3-cross r-b n)) (I-inv-a (rigid-body-3d-world-inv-inertia body-a)) (I-inv-b (if body-b (rigid-body-3d-world-inv-inertia body-b) (mat3-zero))) (ang-term-a (vec3-dot rn-a (mat3-mul-vec3 I-inv-a rn-a))) (ang-term-b (vec3-dot rn-b (mat3-mul-vec3 I-inv-b rn-b))) (effective-mass (+ inv-mass-a inv-mass-b ang-term-a ang-term-b)) (lambda (if (< effective-mass 1e-4) 0 (/ (- v-n) effective-mass))) (impulse (vec3-scale n lambda)) (new-a (apply-impulse-at-point-3d body-a (vec3-neg impulse) pos-a)) (new-b (if body-b (apply-impulse-at-point-3d body-b impulse pos-b) #f))) (values new-a new-b)))"))
