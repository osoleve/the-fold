(task-entry (id "data/graph-matrix/edges->sparse-adjacency") (skill data) (module graph-matrix) (tier 0) (difficulty 1314) (name edges->sparse-adjacency) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight)) (answer "(define (edges->sparse-adjacency edges . opts) (let* ((n (if (and (not (null? opts)) (car opts)) (car opts) (infer-node-count edges))) (undirected (if (and (not (null? opts)) (not (null? (cdr opts)))) (cadr opts) #f)) (all-edges (if undirected (fold-left (lambda (acc edge) (let ((i (edge-from edge)) (j (edge-to edge)) (w (edge-weight edge))) (cons (list j i w) (cons (list i j w) acc)))) '() edges) edges)) (triplets (map (lambda (e) (list (edge-from e) (edge-to e) (edge-weight e))) all-edges)) (coo (sparse-coo-from-triplets n n triplets))) (coo->csr coo)))"))
(task-entry (id "data/centrality/closeness-centrality-from-adj") (skill data) (module centrality) (tier 0) (difficulty 1314) (name closeness-centrality-from-adj) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality standard-closeness-node harmonic-closeness-node)) (answer "(define (closeness-centrality-from-adj adj . opts) (let ((dist (floyd-warshall adj))) (apply closeness-centrality (cons dist opts))))"))
(task-entry (id "data/graph-community/connected-components") (skill data) (module graph-community) (tier 0) (difficulty 1314) (name connected-components) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find uf-union)) (answer "(define (connected-components adj) (let* ((n (matrix-rows adj)) (labels (make-vector n -1)) (component 0)) (do ((start 0 (+ start 1))) ((= start n) labels) (when (= (vector-ref labels start) -1) (vector-set! labels start component) (let bfs ((current-level (list start))) (when (not (null? current-level)) (let ((next-level '())) (for-each (lambda (node) (do ((j 0 (+ j 1))) ((= j n)) (when (and (> (matrix-ref adj node j) 0) (= (vector-ref labels j) -1)) (vector-set! labels j component) (set! next-level (cons j next-level))))) current-level) (bfs next-level)))) (set! component (+ component 1))))))"))
