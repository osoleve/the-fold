(task-entry (id "sim/ode-system/linear-ode") (skill sim) (module ode-system) (tier 2) (difficulty 23321) (name linear-ode) (type "(-> Any Any)") (description "Linear ODE system: dx/dt = Ax where A is an n×n matrix") (notes ()) (section standard-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra lorenz-system van-der-pol pendulum forced-oscillator)) (answer "(define (linear-ode A) (let ((n (matrix-rows A))) (make-autonomous-ode (lambda (state) (matrix-vec-mul A state)) n)))"))
(task-entry (id "sim/stability/asymptotically-stable?") (skill sim) (module stability) (tier 2) (difficulty 23321) (name asymptotically-stable?) (type "(-> Symbol Bool)") (description "Check if equilibrium is asymptotically stable") (notes ()) (section stability-predicates) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability stable?)) (answer "(define (asymptotically-stable? stability-type) (if (memq stability-type '(stable-node stable-spiral)) #t #f))"))
(task-entry (id "sim/chaos/poincare-section") (skill sim) (module chaos) (tier 2) (difficulty 23321) (name poincare-section) (type "(-> ODE Vec Number Nat Nat Nat Number Symbol (List Vec))") (description "Compute Poincaré section by recording crossings of a coordinate plane") (notes ()) (section poincare-sections) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent is-chaotic? kaplan-yorke-dimension)) (answer "(define (poincare-section sys state0 dt n-steps n-transient plane-axis plane-value direction) (let* ((state-after-transient (let loop ((t 0) (state state0) (i 0)) (if (>= i n-transient) state (loop (+ t dt) (rk4-step sys t state dt) (+ i 1))))) (check-crossing (lambda (prev-val curr-val) (case direction ((positive) (and (< prev-val plane-value) (>= curr-val plane-value))) ((negative) (and (> prev-val plane-value) (<= curr-val plane-value))) (else (or (and (< prev-val plane-value) (>= curr-val plane-value)) (and (> prev-val plane-value) (<= curr-val plane-value))))))) (interpolate-crossing (lambda (state1 state2) (let* ((v1 (vector-ref state1 plane-axis)) (v2 (vector-ref state2 plane-axis)) (t-frac (/ (- plane-value v1) (- v2 v1)))) (vec-add state1 (vec-scale t-frac (vec-sub state2 state1))))))) (let loop ((t 0) (state state-after-transient) (step 0) (crossings '())) (if (>= step n-steps) (reverse crossings) (let* ((new-state (rk4-step sys t state dt)) (prev-val (vector-ref state plane-axis)) (curr-val (vector-ref new-state plane-axis))) (if (check-crossing prev-val curr-val) (let ((crossing-point (interpolate-crossing state new-state))) (loop (+ t dt) new-state (+ step 1) (cons crossing-point crossings))) (loop (+ t dt) new-state (+ step 1) crossings)))))))"))
(task-entry (id "sim/bifurcation/augment-with-column") (skill sim) (module bifurcation) (tier 2) (difficulty 23321) (name augment-with-column) (type "(-> Matrix Vec Matrix)") (description "Create [M | v] by appending column v to matrix M") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold)) (answer "(define (augment-with-column m v) (let* ((rows (matrix-rows m)) (cols (matrix-cols m)) (new-cols (+ cols 1)) (data (make-vector (* rows new-cols) 0))) (do ((i 0 (+ i 1))) ((= i rows)) (do ((j 0 (+ j 1))) ((= j cols)) (vector-set! data (+ (* i new-cols) j) (matrix-ref m i j))) (vector-set! data (+ (* i new-cols) cols) (vector-ref v i))) (list 'matrix rows new-cols data)))"))
(task-entry (id "sim/attractor-render/demo-lorenz") (skill sim) (module attractor-render) (tier 2) (difficulty 23321) (name demo-lorenz) (type "(-> Nat Nat Nat String)") (description "Generate single frame of Lorenz attractor") (notes ()) (section demos) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity! fb-to-string render-attractor render-attractor-colored render-spinning-attractor render-spinning-attractor-colored)) (answer "(define (demo-lorenz width height n-points) (let* ((traj (generate-attractor lorenz-classic (vector 1.0 1.0 1.0) 0.005 n-points 1000)) (scale (* (min width height) 0.35))) (render-attractor traj width height scale 0.3 0.5 0)))"))
(task-entry (id "sim/simulation-stream/make-updated-physics") (skill sim) (module simulation-stream) (tier 2) (difficulty 23322) (name make-updated-physics) (type "(-> PhysicsState Vec2 Vec2 PhysicsState)") (description "Create new physics state with updated position and velocity") (notes ()) (section physics-specific-simulation-helpers) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass)) (answer "(define (make-updated-physics s new-pos new-vel) (make-sim-state (sim-state-time s) (list 'physics new-pos new-vel (physics-mass s)) (sim-state-metadata s)))"))
(task-entry (id "sim/ode-system/is-equilibrium?") (skill sim) (module ode-system) (tier 2) (difficulty 23322) (name is-equilibrium?) (type "(-> Any Any Number Bool)") (description "Check if a point is an equilibrium (fixed point) within tolerance. An equilibrium satisfies f(x) = 0") (notes ()) (section equilibrium-points) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra lorenz-system van-der-pol pendulum forced-oscillator linear-ode)) (answer "(define (is-equilibrium? sys state tolerance) (let ((field-norm (vector-field-norm sys 0 state))) (< field-norm tolerance)))"))
(task-entry (id "sim/stability/unstable?") (skill sim) (module stability) (tier 2) (difficulty 23322) (name unstable?) (type "(-> Symbol Bool)") (description "Check if a stability type is unstable") (notes ()) (section stability-predicates) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability stable? asymptotically-stable?)) (answer "(define (unstable? stability-type) (if (memq stability-type '(unstable-node unstable-spiral saddle)) #t #f))"))
(task-entry (id "sim/chaos/poincare-section-2d") (skill sim) (module chaos) (tier 2) (difficulty 23322) (name poincare-section-2d) (type "(-> (List Vec) (List Nat) (List (Pair Number Number)))") (description "Project Poincaré section points onto 2D for plotting") (notes ()) (section poincare-sections) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent is-chaotic? kaplan-yorke-dimension poincare-section)) (answer "(define (poincare-section-2d section-points keep-axes) (map (lambda (pt) (cons (vector-ref pt (car keep-axes)) (vector-ref pt (cadr keep-axes)))) section-points))"))
(task-entry (id "sim/bifurcation/extract-column") (skill sim) (module bifurcation) (tier 2) (difficulty 23322) (name extract-column) (type "(-> Matrix Nat Vec)") (description "Extract column col from matrix as vector") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column)) (answer "(define (extract-column m col) (let* ((rows (matrix-rows m)) (v (make-vector rows 0))) (do ((i 0 (+ i 1))) ((= i rows) v) (vector-set! v i (matrix-ref m i col)))))"))
(task-entry (id "sim/attractor-render/demo-lorenz-colored") (skill sim) (module attractor-render) (tier 2) (difficulty 23322) (name demo-lorenz-colored) (type "(-> Nat Nat Nat String)") (description "Generate colored single frame of Lorenz attractor") (notes ()) (section demos) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity! fb-to-string render-attractor render-attractor-colored render-spinning-attractor render-spinning-attractor-colored demo-lorenz)) (answer "(define (demo-lorenz-colored width height n-points) (let* ((traj (generate-attractor lorenz-classic (vector 1.0 1.0 1.0) 0.005 n-points 1000)) (scale (* (min width height) 0.35))) (render-attractor-colored traj width height scale 0.3 0.5 0)))"))
(task-entry (id "sim/simulation-stream/euler-step") (skill sim) (module simulation-stream) (tier 2) (difficulty 23323) (name euler-step) (type "(-> (-> PhysicsState Vec2) Number (-> PhysicsState PhysicsState))") (description "Create an Euler integration step function") (notes ()) (section physics-integration-as-pure-step-functions) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics)) (answer "(define (euler-step force-fn dt) (lambda (state) (let* ((pos (physics-pos state)) (vel (physics-vel state)) (inv-m (physics-inv-mass state)) (force (force-fn state)) (accel (vec2-scale force inv-m)) (new-vel (vec2-add vel (vec2-scale accel dt))) (new-pos (vec2-add pos (vec2-scale new-vel dt)))) (make-updated-physics state new-pos new-vel))))"))
(task-entry (id "sim/ode-system/find-equilibria-grid") (skill sim) (module ode-system) (tier 2) (difficulty 23323) (name find-equilibria-grid) (type "(-> Any (List Any) Number (List Any))") (description "Find approximate equilibrium points from a grid search") (notes ()) (section equilibrium-points) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra lorenz-system van-der-pol pendulum forced-oscillator linear-ode is-equilibrium?)) (answer "(define (find-equilibria-grid sys grid-points tolerance) (filter (lambda (point) (is-equilibrium? sys point tolerance)) grid-points))"))
(task-entry (id "sim/stability/classify-stability-nd") (skill sim) (module stability) (tier 2) (difficulty 23323) (name classify-stability-nd) (type "(-> (List Complex) Symbol)") (description "Classify stability for n-dimensional system based on eigenvalues") (notes ()) (section higher-dimensional-stability) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability stable? asymptotically-stable? unstable?)) (answer "(define (classify-stability-nd eigenvalues) (let ((max-real (apply max (map complex-real eigenvalues))) (min-real (apply min (map complex-real eigenvalues)))) (cond ((< max-real -1e-10) 'stable) ((> min-real 1e-10) 'unstable) ((and (< max-real 1e-10) (> min-real -1e-10)) 'neutrally-stable) (else 'saddle-type))))"))
(task-entry (id "sim/chaos/generate-attractor") (skill sim) (module chaos) (tier 2) (difficulty 23323) (name generate-attractor) (type "(-> ODE Vec Number Nat Nat (List Vec))") (description "Generate attractor trajectory after removing transient") (notes ()) (section attractor-generation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent is-chaotic? kaplan-yorke-dimension poincare-section poincare-section-2d)) (answer "(define (generate-attractor sys state0 dt n-steps n-transient) (integrate-rk4-transient sys 0 state0 dt n-transient n-steps))"))
(task-entry (id "sim/bifurcation/subvector") (skill sim) (module bifurcation) (tier 2) (difficulty 23323) (name subvector) (type "(-> Vec Nat Nat Vec)") (description "Extract subvector v[start:start+len]") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column)) (answer "(define (subvector v start len) (let ((result (make-vector len 0))) (do ((i 0 (+ i 1))) ((= i len) result) (vector-set! result i (vector-ref v (+ start i))))))"))
(task-entry (id "sim/attractor-render/demo-rossler") (skill sim) (module attractor-render) (tier 2) (difficulty 23323) (name demo-rossler) (type "(-> Nat Nat Nat String)") (description "Generate single frame of Rössler attractor") (notes ()) (section demos) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity! fb-to-string render-attractor render-attractor-colored render-spinning-attractor render-spinning-attractor-colored demo-lorenz demo-lorenz-colored)) (answer "(define (demo-rossler width height n-points) (let* ((traj (generate-attractor rossler-classic (vector 1.0 1.0 1.0) 0.02 n-points 500)) (scale (* (min width height) 0.4))) (render-attractor-colored traj width height scale 0.3 0.7 0)))"))
(task-entry (id "sim/simulation-stream/symplectic-euler-step") (skill sim) (module simulation-stream) (tier 2) (difficulty 23324) (name symplectic-euler-step) (type "(-> (-> PhysicsState Vec2) Number (-> PhysicsState PhysicsState))") (description "Create a symplectic Euler step function (more stable)") (notes ()) (section physics-integration-as-pure-step-functions) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step)) (answer "(define (symplectic-euler-step force-fn dt) (lambda (state) (let* ((pos (physics-pos state)) (vel (physics-vel state)) (inv-m (physics-inv-mass state)) (force (force-fn state)) (accel (vec2-scale force inv-m)) (new-vel (vec2-add vel (vec2-scale accel dt))) (new-pos (vec2-add pos (vec2-scale new-vel dt)))) (make-updated-physics state new-pos new-vel))))"))
(task-entry (id "sim/ode-system/couple-ode-systems") (skill sim) (module ode-system) (tier 2) (difficulty 23324) (name couple-ode-systems) (type "(-> Any Any Any)") (description "Couple two ODE systems into a single higher-dimensional system. The state vector is the concatenation [x1, x2]") (notes ()) (section system-composition) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra lorenz-system van-der-pol pendulum forced-oscillator linear-ode is-equilibrium? find-equilibria-grid)) (answer "(define (couple-ode-systems sys1 sys2) (let ((dim1 (ode-dimension sys1)) (dim2 (ode-dimension sys2)) (f1 (ode-vector-field sys1)) (f2 (ode-vector-field sys2)) (auto? (and (ode-autonomous? sys1) (ode-autonomous? sys2)))) (make-ode-system (lambda (t state) (let* ((state1 (vec-take state dim1)) (state2 (vec-drop state dim1)) (deriv1 (f1 t state1)) (deriv2 (f2 t state2))) (vec-append deriv1 deriv2))) (+ dim1 dim2) auto?)))"))
(task-entry (id "sim/stability/analyze-stability-nd") (skill sim) (module stability) (tier 2) (difficulty 23324) (name analyze-stability-nd) (type "(-> Any Any Number (Pair Symbol (List Complex)))") (description "Analyze stability for n-dimensional system using QR eigenvalues") (notes ()) (section higher-dimensional-stability) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability stable? asymptotically-stable? unstable? classify-stability-nd)) (answer "(define (analyze-stability-nd sys equilibrium step-size) (let* ((jac (linearize-at-equilibrium sys equilibrium step-size)) (n (matrix-rows jac))) (if (<= n 2) (analyze-stability sys equilibrium step-size) (let ((eigs (eigenvalues jac))) (eigenvalue-result->stability eigs)))))"))
(task-entry (id "sim/chaos/attractor-bounds") (skill sim) (module chaos) (tier 2) (difficulty 23324) (name attractor-bounds) (type "(-> (List Vec) (List (Pair Number Number)))") (description "Compute bounding box of attractor trajectory") (notes ()) (section attractor-generation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent is-chaotic? kaplan-yorke-dimension poincare-section poincare-section-2d generate-attractor)) (answer "(define (attractor-bounds trajectory) (if (null? trajectory) '() (let* ((dim (vector-length (car trajectory))) (initial-bounds (map (lambda (i) (let ((v (vector-ref (car trajectory) i))) (cons v v))) (iota dim)))) (fold-left (lambda (bounds pt) (map (lambda (bound i) (let ((v (vector-ref pt i))) (cons (min (car bound) v) (max (cdr bound) v)))) bounds (iota dim))) initial-bounds (cdr trajectory)))))"))
(task-entry (id "sim/bifurcation/arclength-predict") (skill sim) (module bifurcation) (tier 2) (difficulty 23324) (name arclength-predict) (type "(-> Vec Number (Pair Vec Number) Number (Pair Vec Number))") (description "Predictor step: move along tangent by arc-length ds") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector)) (answer "(define (arclength-predict fp param tangent ds) (let* ((tangent-x (car tangent)) (tangent-p (cdr tangent)) (new-fp (vec-add fp (vec-scale ds tangent-x))) (new-param (+ param (* ds tangent-p)))) (cons new-fp new-param)))"))
(task-entry (id "sim/attractor-render/demo-thomas") (skill sim) (module attractor-render) (tier 2) (difficulty 23324) (name demo-thomas) (type "(-> Nat Nat Nat String)") (description "Generate single frame of Thomas attractor") (notes ()) (section demos) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity! fb-to-string render-attractor render-attractor-colored render-spinning-attractor render-spinning-attractor-colored demo-lorenz demo-lorenz-colored demo-rossler)) (answer "(define (demo-thomas width height n-points) (let* ((traj (generate-attractor thomas-classic (vector 1.0 0.0 0.0) 0.05 n-points 200)) (scale (* (min width height) 0.25))) (render-attractor-colored traj width height scale 0.3 0.5 0)))"))
(task-entry (id "sim/simulation-stream/verlet-step") (skill sim) (module simulation-stream) (tier 2) (difficulty 23325) (name verlet-step) (type "(-> (-> PhysicsState Vec2) Number (-> PhysicsState PhysicsState))") (description "Create a velocity Verlet step function") (notes ()) (section physics-integration-as-pure-step-functions) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step)) (answer "(define (verlet-step force-fn dt) (lambda (state) (let* ((pos (physics-pos state)) (vel (physics-vel state)) (inv-m (physics-inv-mass state)) (force (force-fn state)) (accel (vec2-scale force inv-m)) (half-dt (/ dt 2)) (new-pos (vec2-add (vec2-add pos (vec2-scale vel dt)) (vec2-scale accel (* 0.5 dt dt)))) (new-state-temp (make-updated-physics state new-pos vel)) (accel-new (vec2-scale (force-fn new-state-temp) inv-m)) (new-vel (vec2-add vel (vec2-scale (vec2-add accel accel-new) half-dt)))) (make-updated-physics state new-pos new-vel))))"))
(task-entry (id "sim/ode-system/reverse-time-ode") (skill sim) (module ode-system) (tier 2) (difficulty 23325) (name reverse-time-ode) (type "(-> Any Any)") (description "Create the time-reversed ODE system: dx/dt = -f(t, x). Useful for backward integration and analyzing reversibility") (notes ()) (section time-reversal) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra lorenz-system van-der-pol pendulum forced-oscillator linear-ode is-equilibrium? find-equilibria-grid couple-ode-systems)) (answer "(define (reverse-time-ode sys) (let ((f (ode-vector-field sys)) (dim (ode-dimension sys)) (auto? (ode-autonomous? sys))) (make-ode-system (lambda (t state) (let ((field (f t state))) (if (vector? field) (vec-negate field) (- field)))) dim auto?)))"))
(task-entry (id "sim/stability/eigenvalue-result->stability") (skill sim) (module stability) (tier 2) (difficulty 23325) (name eigenvalue-result->stability) (type "(-> Any (Pair Symbol (List Complex)))") (description "Convert eigenvalue result to stability classification") (notes ()) (section higher-dimensional-stability) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability stable? asymptotically-stable? unstable? classify-stability-nd analyze-stability-nd)) (answer "(define (eigenvalue-result->stability eig-result) (cond ((and (pair? eig-result) (eq? (car eig-result) 'error)) (cons 'unknown (list (make-complex 0 0)))) ((and (pair? eig-result) (eq? (car eig-result) 'complex-eigenvalues)) (let* ((real-vec (cadr eig-result)) (complex-info (caddr eig-result)) (eigenvalue-list (eigenvalues-from-qr-result real-vec complex-info))) (cons (classify-stability-nd eigenvalue-list) eigenvalue-list))) ((vector? eig-result) (let ((eigenvalue-list (map (lambda (r) (make-complex r 0)) (vector->list eig-result)))) (cons (classify-stability-nd eigenvalue-list) eigenvalue-list))) (else (cons 'unknown (list (make-complex 0 0))))))"))
(task-entry (id "sim/chaos/normalize-trajectory") (skill sim) (module chaos) (tier 2) (difficulty 23325) (name normalize-trajectory) (type "(-> (List Vec) (List (Pair Number Number)) Number (List Vec))") (description "Normalize trajectory to fit within target range [-r, r]") (notes ()) (section attractor-generation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent is-chaotic? kaplan-yorke-dimension poincare-section poincare-section-2d generate-attractor attractor-bounds)) (answer "(define (normalize-trajectory trajectory bounds target-range) (if (null? trajectory) '() (let* ((dim (length bounds)) (scales (map (lambda (bound) (let ((range (- (cdr bound) (car bound)))) (if (> range *min-norm*) (/ (* 2 target-range) range) 1.0))) bounds)) (offsets (map (lambda (bound) (/ (+ (car bound) (cdr bound)) 2)) bounds))) (map (lambda (pt) (list->vector (map (lambda (i) (* (list-ref scales i) (- (vector-ref pt i) (list-ref offsets i)))) (iota dim)))) trajectory))))"))
(task-entry (id "sim/bifurcation/arclength-correct") (skill sim) (module bifurcation) (tier 2) (difficulty 23325) (name arclength-correct) (type "(-> ParamODE Vec Number (Pair Vec Number) Number (Option (List Vec Number Nat)))") (description "Corrector: solve bordered system F(x,p)=0 with arclength constraint") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict)) (answer "(define (arclength-correct psys pred-fp pred-param tangent ds) (let* ((tangent-x (car tangent)) (tangent-p (cdr tangent)) (n (vector-length pred-fp))) (let loop ((fp pred-fp) (param pred-param) (iter 0)) (if (>= iter *arclength-max-correct*) #f (let* ((sys (instantiate-at psys param)) (f-val (eval-vector-field sys 0 fp)) (f-norm (vec-norm f-val))) (if (< f-norm *continuation-tolerance*) (list fp param iter) (let* ((jac-x (compute-jacobian sys fp *continuation-step-size*)) (jac-p (compute-parameter-jacobian psys param fp *continuation-step-size*)) (correction (solve-bordered-system jac-x jac-p tangent-x tangent-p f-val))) (if (not correction) #f (let* ((dx (car correction)) (dp (cdr correction)) (new-fp (vec-sub fp dx)) (new-param (- param dp))) (loop new-fp new-param (+ iter 1)))))))))))"))
(task-entry (id "sim/attractor-render/spinning-lorenz-demo") (skill sim) (module attractor-render) (tier 2) (difficulty 23325) (name spinning-lorenz-demo) (type "(-> Nat Nat Nat Nat (List String))") (description "Generate spinning Lorenz attractor animation frames") (notes ()) (section demos) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity! fb-to-string render-attractor render-attractor-colored render-spinning-attractor render-spinning-attractor-colored demo-lorenz demo-lorenz-colored demo-rossler demo-thomas)) (answer "(define (spinning-lorenz-demo width height n-points n-frames) (let* ((traj (generate-attractor lorenz-classic (vector 1.0 1.0 1.0) 0.005 n-points 1000)) (scale (* (min width height) 0.35))) (render-spinning-attractor-colored traj width height scale n-frames)))"))
(task-entry (id "sim/simulation-stream/const-gravity") (skill sim) (module simulation-stream) (tier 2) (difficulty 23326) (name const-gravity) (type "(-> Number (-> PhysicsState Vec2))") (description "Constant gravity force (positive y is down)") (notes ()) (section common-force-functions-pure) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step)) (answer "(define (const-gravity g) (lambda (state) (vec2 0 (* g (physics-mass state)))))"))
(task-entry (id "sim/ode-system/transform-ode-system") (skill sim) (module ode-system) (tier 2) (difficulty 23326) (name transform-ode-system) (type "(-> Any (-> Any Any) (-> Any Any) Any)") (description "Transform an ODE system via a coordinate change. If y = T(x), then dy/dt = (DT)(x) · f(x). This is a simplified version - full implementation needs Jacobian") (notes ()) (section coordinate-transformations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra lorenz-system van-der-pol pendulum forced-oscillator linear-ode is-equilibrium? find-equilibria-grid couple-ode-systems reverse-time-ode)) (answer "(define (transform-ode-system sys transform inverse) (let ((f (ode-vector-field sys)) (dim (ode-dimension sys)) (auto? (ode-autonomous? sys))) (make-ode-system (lambda (t y) (let* ((x (inverse y)) (fx (f t x))) (transform fx))) dim auto?)))"))
(task-entry (id "sim/stability/eigenvalues-from-qr-result") (skill sim) (module stability) (tier 2) (difficulty 23326) (name eigenvalues-from-qr-result) (type "(-> Vec (List Any) (List Complex))") (description "Reconstruct complex eigenvalues from QR result") (notes ()) (section higher-dimensional-stability) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability stable? asymptotically-stable? unstable? classify-stability-nd analyze-stability-nd eigenvalue-result->stability)) (answer "(define (eigenvalues-from-qr-result real-vec complex-info) (let* ((n (vector-length real-vec)) (result (make-vector n #f)) (info-table (make-eq-hashtable))) (for-each (lambda (entry) (let ((idx (car entry)) (real-part (cadr entry)) (imag-part (caddr entry))) (hashtable-set! info-table idx (cons real-part imag-part)) (hashtable-set! info-table (+ idx 1) (cons real-part (- imag-part))))) complex-info) (let loop ((i 0) (acc '())) (if (>= i n) (reverse acc) (let ((complex-entry (hashtable-ref info-table i #f))) (if complex-entry (loop (+ i 1) (cons (make-complex (car complex-entry) (cdr complex-entry)) acc)) (loop (+ i 1) (cons (make-complex (vector-ref real-vec i) 0) acc))))))))"))
(task-entry (id "sim/chaos/lorenz-classic") (skill sim) (module chaos) (tier 2) (difficulty 23326) (name lorenz-classic) (type "") (description "") (notes ()) (section standard-parameters) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent is-chaotic? kaplan-yorke-dimension poincare-section poincare-section-2d generate-attractor attractor-bounds normalize-trajectory)) (answer "(define lorenz-classic (lorenz-system 10 28 (/ 8 3)))"))
(task-entry (id "sim/bifurcation/solve-bordered-system") (skill sim) (module bifurcation) (tier 2) (difficulty 23326) (name solve-bordered-system) (type "(-> Matrix Vec Vec Number Vec (Option (Pair Vec Number)))") (description "Solve the bordered system for Newton correction") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct)) (answer "(define (solve-bordered-system jac-x jac-p tangent-x tangent-p rhs-f) (let* ((n (vector-length rhs-f)) (bordered (make-bordered-matrix jac-x jac-p tangent-x tangent-p)) (rhs (make-vector (+ n 1) 0))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! rhs i (vector-ref rhs-f i))) (vector-set! rhs n 0.0) (let ((solution (solve-linear-system bordered rhs))) (if (not solution) #f (cons (subvector solution 0 n) (vector-ref solution n))))))"))
(task-entry (id "sim/simulation-stream/spring-force-fn") (skill sim) (module simulation-stream) (tier 2) (difficulty 23327) (name spring-force-fn) (type "(-> Vec2 Number Number (-> PhysicsState Vec2))") (description "Spring force toward anchor point") (notes ()) (section common-force-functions-pure) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity)) (answer "(define (spring-force-fn anchor k damping) (lambda (state) (let* ((pos (physics-pos state)) (vel (physics-vel state)) (displacement (vec2-sub anchor pos)) (spring-f (vec2-scale displacement k)) (damp-f (vec2-scale vel (- damping)))) (vec2-add spring-f damp-f))))"))
(task-entry (id "sim/stability/analyze-linear-system") (skill sim) (module stability) (tier 2) (difficulty 23327) (name analyze-linear-system) (type "(-> Any (Pair Symbol (List Complex)))") (description "Analyze stability of a linear ODE system dx/dt = Ax") (notes ()) (section standard-system-analysis) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability stable? asymptotically-stable? unstable? classify-stability-nd analyze-stability-nd eigenvalue-result->stability eigenvalues-from-qr-result)) (answer "(define (analyze-linear-system A) (let ((eigenvalues (matrix-eigenvalues-2d A))) (cons (classify-stability-2d eigenvalues) eigenvalues)))"))
(task-entry (id "sim/chaos/rossler-classic") (skill sim) (module chaos) (tier 2) (difficulty 23327) (name rossler-classic) (type "") (description "") (notes ()) (section standard-parameters) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent is-chaotic? kaplan-yorke-dimension poincare-section poincare-section-2d generate-attractor attractor-bounds normalize-trajectory lorenz-classic)) (answer "(define rossler-classic (rossler-system 0.2 0.2 5.7))"))
(task-entry (id "sim/bifurcation/make-bordered-matrix") (skill sim) (module bifurcation) (tier 2) (difficulty 23327) (name make-bordered-matrix) (type "(-> Matrix Vec Vec Number Matrix)") (description "Build the (n+1)x(n+1) bordered matrix for arclength continuation") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system)) (answer "(define (make-bordered-matrix jac-x jac-p tangent-x tangent-p) (let* ((n (matrix-rows jac-x)) (size (+ n 1)) (data (make-vector (* size size) 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! data (+ (* i size) j) (matrix-ref jac-x i j))) (vector-set! data (+ (* i size) n) (vector-ref jac-p i))) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! data (+ (* n size) j) (vector-ref tangent-x j))) (vector-set! data (+ (* n size) n) tangent-p) (list 'matrix size size data)))"))
(task-entry (id "sim/simulation-stream/drag-force-fn") (skill sim) (module simulation-stream) (tier 2) (difficulty 23328) (name drag-force-fn) (type "(-> Number (-> PhysicsState Vec2))") (description "Drag force proportional to velocity") (notes ()) (section common-force-functions-pure) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn)) (answer "(define (drag-force-fn coefficient) (lambda (state) (vec2-scale (physics-vel state) (- coefficient))))"))
