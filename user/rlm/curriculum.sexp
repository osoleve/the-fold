(task-entry (id "numeric/affine/merge-terms") (skill numeric) (module affine) (tier 0) (difficulty 2513) (name merge-terms) (type "") (description "") (notes ()) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval affine->interval affine-radius affine-neg)) (answer "(define (merge-terms terms1 terms2 op) (let loop ((t1 terms1) (t2 terms2) (acc '())) (cond ((null? t1) (reverse (append (map (lambda (t) (cons (car t) (op 0 (cdr t)))) t2) acc))) ((null? t2) (reverse (append (map (lambda (t) (cons (car t) (op (cdr t) 0))) t1) acc))) ((< (caar t1) (caar t2)) (loop (cdr t1) t2 (cons (cons (caar t1) (op (cdar t1) 0)) acc))) ((> (caar t1) (caar t2)) (loop t1 (cdr t2) (cons (cons (caar t2) (op 0 (cdar t2))) acc))) (else (loop (cdr t1) (cdr t2) (cons (cons (caar t1) (op (cdar t1) (cdar t2))) acc))))))"))
