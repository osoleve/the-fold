(task-entry (id "tiles/square/square-range") (skill tiles) (module square) (tier 1) (difficulty 12313) (name square-range) (type "(-> Coord Integer Symbol (List Coord))") (description "Get all coordinates within range of center using specified metric: 'manhattan, 'chebyshev, or 'euclidean") (notes ()) (section range-and-area) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho square-neighbors-diag square-neighbors-all square-neighbors square-distance-manhattan square-distance-chebyshev square-distance-euclidean square-distance square-line)) (answer "(define (square-range center radius metric) (let ((cx (coord-x center)) (cy (coord-y center))) (let loop ((x (- cx radius)) (y (- cy radius)) (coords '())) (cond ((> y (+ cy radius)) (reverse coords)) ((> x (+ cx radius)) (loop (- cx radius) (+ y 1) coords)) (else (let ((coord (square-coord x y))) (if (<= (square-distance center coord metric) radius) (loop (+ x 1) y (cons coord coords)) (loop (+ x 1) y coords))))))))"))
(task-entry (id "tiles/hex/hex-range") (skill tiles) (module hex) (tier 1) (difficulty 12313) (name hex-range) (type "(-> AxialCoord Integer (List AxialCoord))") (description "Get all hexes within N steps of center") (notes ()) (section line-and-range) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial hex-axial-directions hex-neighbor hex-neighbors hex-neighbors-at-distance hex-distance hex-line)) (answer "(define (hex-range center radius) (let* ((cc (axial->cubic center)) (cx (cubic-coord%-x cc)) (cy (cubic-coord%-y cc)) (cz (cubic-coord%-z cc))) (let loop ((x (- cx radius)) (results '())) (if (> x (+ cx radius)) (map cubic->axial results) (let ((y-min (max (- cy radius) (- (- x) cz radius))) (y-max (min (+ cy radius) (- (- x) cz (- radius))))) (let inner ((y y-min) (res results)) (if (> y y-max) (loop (+ x 1) res) (let ((z (- (- x) y))) (inner (+ y 1) (cons (cubic-coord x y z) res))))))))))"))
(task-entry (id "tiles/triangle/triangle-line") (skill tiles) (module triangle) (tier 1) (difficulty 12313) (name triangle-line) (type "(-> TriangleCoord TriangleCoord (List TriangleCoord))") (description "Get triangles on approximate line from t1 to t2. Uses row-major stepping.") (notes ()) (section line-drawing) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge triangle-neighbors-vertex triangle-neighbors-all triangle-neighbors triangle-distance-manhattan)) (answer "(define (triangle-line t1 t2) (let* ((r1 (triangle-row t1)) (c1 (triangle-col t1)) (r2 (triangle-row t2)) (c2 (triangle-col t2)) (dr (- r2 r1)) (dc (- c2 c1)) (steps (max (abs dr) (abs dc)))) (if (= steps 0) (list t1) (let loop ((i 0) (coords '())) (if (> i steps) (reverse coords) (let* ((t (/ i steps)) (r (round (+ r1 (* dr t)))) (c (round (+ c1 (* dc t)))) (ori (triangle-default-orientation r c)) (coord (triangle-coord r c ori))) (loop (+ i 1) (cons coord coords))))))))"))
(task-entry (id "tiles/pathfinding/find-reachable") (skill tiles) (module pathfinding) (tier 1) (difficulty 12313) (name find-reachable) (type "(-> Coord Integer (-> Coord (List Coord)) (-> Coord Bool) (-> Coord Number) (List (Pair Coord Number)))") (description "Find all coordinates reachable within N movement points") (notes ()) (section reachability) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert pqueue-pop reconstruct-path bfs-path dijkstra-path astar-path board-walkable? board-cost find-path-bfs find-path-dijkstra find-path-astar)) (answer "(define (find-reachable start max-cost neighbor-fn walkable-fn cost-fn) (let ((visited (make-hashtable equal-hash equal?)) (results '())) (hashtable-set! visited start 0) (let loop ((queue (list (cons start 0)))) (if (null? queue) results (let* ((current-entry (car queue)) (current (car current-entry)) (current-cost (cdr current-entry)) (rest-q (cdr queue))) (set! results (cons current-entry results)) (let* ((neighbors (neighbor-fn current)) (valid-neighbors (filter walkable-fn neighbors)) (new-entries (filter-map (lambda (n) (let ((new-cost (+ current-cost (cost-fn n)))) (if (and (<= new-cost max-cost) (or (not (hashtable-ref visited n #f)) (< new-cost (hashtable-ref visited n 0)))) (begin (hashtable-set! visited n new-cost) (cons n new-cost)) #f))) valid-neighbors))) (loop (append rest-q new-entries))))))))"))
(task-entry (id "tiles/units/game-visible-units") (skill tiles) (module units) (tier 1) (difficulty 12313) (name game-visible-units) (type "(-> GameState Symbol (-> Coord (List Coord)) (-> Coord Coord (List Coord)) (List Unit))") (description "Get all units visible to a specific unit (uses unit's vision property)") (notes ()) (section visibility) (deps (\x27;tiles/core)) (available (make-unit unit-get-prop unit-set-prop make-game-state game-board game-place-unit game-remove-unit game-get-unit-at game-get-unit-coord game-all-units game-units-by-team game-move-unit game-unit-can-reach)) (answer "(define (game-visible-units gs unit-id neighbor-fn line-fn) (let* ((board (game-board gs)) (viewer-coord (game-get-unit-coord gs unit-id)) (viewer (game-get-unit-at gs viewer-coord))) (if (and viewer-coord viewer) (let* ((vision-range (unit-get-prop viewer 'vision 999)) (visible-coords (board-fov board viewer-coord vision-range neighbor-fn line-fn)) (all-units (game-all-units gs))) (filter-map (lambda (entry) (let ((coord (car entry)) (unit (cdr entry))) (if (and (member coord visible-coords) (not (eq? (unit%-id unit) unit-id))) unit #f))) all-units)) '())))"))
(task-entry (id "tiles/turns/turn-recent-actions") (skill tiles) (module turns) (tier 1) (difficulty 12313) (name turn-recent-actions) (type "") (description "") (notes ()) (section history) (deps (\x27;sort)) (available (make-turn-state make-turn-state-from-game turn-current-unit turn-current-phase turn-number turn-actions-remaining turn-can-act? turn-spend-action turn-log-action turn-next-phase turn-next-unit turn-end-turn turn-history)) (answer "(define (turn-recent-actions ts n) (let loop ((actions (turn-state%-history ts)) (count 0) (result '())) (if (or (null? actions) (>= count n)) (reverse result) (loop (cdr actions) (+ count 1) (cons (car actions) result)))))"))
(task-entry (id "tiles/topology-analysis/board-critical-edges") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12313) (name board-critical-edges) (type "") (description "") (notes ()) (section bottleneck-detection) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<? collect-square-faces coords-adjacent? board-betti-numbers board-connected-regions board-terrain-holes board-topology-analysis)) (answer "(define (board-critical-edges board neighbor-fn) (map weighted-bridge-edge (find-bridges-with-weights board neighbor-fn)))"))
(task-entry (id "tiles/core/board-meta") (skill tiles) (module core) (tier 1) (difficulty 12314) (name board-meta) (type "(-> Board Alist)") (description "") (notes ()) (section board-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape)) (answer "(define (board-meta b) (board%-meta b))"))
(task-entry (id "tiles/square/square-ring") (skill tiles) (module square) (tier 1) (difficulty 12314) (name square-ring) (type "(-> Coord Integer (List Coord))") (description "Get all coordinates at exactly distance N from center (Chebyshev)") (notes ()) (section range-and-area) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho square-neighbors-diag square-neighbors-all square-neighbors square-distance-manhattan square-distance-chebyshev square-distance-euclidean square-distance square-line square-range)) (answer "(define (square-ring center radius) (if (= radius 0) (list center) (let ((cx (coord-x center)) (cy (coord-y center))) (append (let loop ((x (- cx radius)) (acc '())) (if (> x (+ cx radius)) acc (loop (+ x 1) (cons (square-coord x (- cy radius)) acc)))) (let loop ((y (- cy radius -1)) (acc '())) (if (> y (+ cy radius)) acc (loop (+ y 1) (cons (square-coord (+ cx radius) y) acc)))) (let loop ((x (+ cx radius -1)) (acc '())) (if (< x (- cx radius)) acc (loop (- x 1) (cons (square-coord x (+ cy radius)) acc)))) (let loop ((y (+ cy radius -1)) (acc '())) (if (<= y (- cy radius)) acc (loop (- y 1) (cons (square-coord (- cx radius) y) acc))))))))"))
(task-entry (id "tiles/hex/hex-ring") (skill tiles) (module hex) (tier 1) (difficulty 12314) (name hex-ring) (type "(-> AxialCoord Integer (List AxialCoord))") (description "Get all hexes at exactly N steps from center") (notes ()) (section line-and-range) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial hex-axial-directions hex-neighbor hex-neighbors hex-neighbors-at-distance hex-distance hex-line hex-range)) (answer "(define (hex-ring center radius) (hex-neighbors-at-distance center radius))"))
(task-entry (id "tiles/triangle/triangle-range") (skill tiles) (module triangle) (tier 1) (difficulty 12314) (name triangle-range) (type "(-> TriangleCoord Integer (List TriangleCoord))") (description "Get all triangles within approximate distance N. Uses Manhattan approximation.") (notes ()) (section range) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge triangle-neighbors-vertex triangle-neighbors-all triangle-neighbors triangle-distance-manhattan triangle-line)) (answer "(define (triangle-range center radius) (let ((cr (triangle-row center)) (cc (triangle-col center))) (let loop ((r (- cr radius)) (c (- cc radius)) (coords '())) (cond ((> r (+ cr radius)) coords) ((> c (+ cc radius)) (loop (+ r 1) (- cc radius) coords)) (else (let* ((ori-up (triangle-coord r c 'up)) (ori-down (triangle-coord r c 'down)) (new-coords (append (if (<= (triangle-distance-manhattan center ori-up) radius) (list ori-up) '()) (if (<= (triangle-distance-manhattan center ori-down) radius) (list ori-down) '())))) (loop r (+ c 1) (append new-coords coords))))))))"))
