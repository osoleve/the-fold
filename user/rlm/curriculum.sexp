(task-entry (id "physics/classical/integrators/body-potential-energy") (skill physics/classical) (module integrators) (tier 2) (difficulty 23536) (name body-potential-energy) (type "") (description "") (notes ()) (section energy) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet integrate-body-rk4 make-time-acc time-acc? time-acc-remaining time-acc-fixed-dt time-acc-max-steps time-acc-add time-acc-consume time-acc-alpha substep-body integrate-with-substeps interpolate-body gravity-force spring-force drag-force constant-force combine-forces body-kinetic-energy)) (answer "(define (body-potential-energy body g y-ref) (* (body-mass body) g (- y-ref (vec2-y (body-pos body)))))"))
(task-entry (id "physics/classical/collision-detection/circle-aabb-manifold") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23536) (name circle-aabb-manifold) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb?)) (answer "(define (circle-aabb-manifold circle aabb) (let* ((center (circle-center circle)) (r (circle-radius circle)) (min-p (aabb-min aabb)) (max-p (aabb-max aabb)) (cx (vec2-x center)) (cy (vec2-y center)) (closest-x (max (vec2-x min-p) (min cx (vec2-x max-p)))) (closest-y (max (vec2-y min-p) (min cy (vec2-y max-p)))) (closest (vec2 closest-x closest-y)) (diff (vec2-sub center closest)) (dist-sq (vec2-magnitude-sq diff))) (if (> dist-sq (* r r)) #f (let* ((dist (sqrt dist-sq)) (normal (if (< dist 1e-4) (let ((dx (min (- cx (vec2-x min-p)) (- (vec2-x max-p) cx))) (dy (min (- cy (vec2-y min-p)) (- (vec2-y max-p) cy)))) (if (< dx dy) (vec2 (if (< cx (* 0.5 (+ (vec2-x min-p) (vec2-x max-p)))) -1 1) 0) (vec2 0 (if (< cy (* 0.5 (+ (vec2-y min-p) (vec2-y max-p)))) -1 1)))) (vec2-scale diff (/ 1 dist)))) (penetration (- r dist))) (list normal penetration closest)))))"))
