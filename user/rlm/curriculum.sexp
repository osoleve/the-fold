(task-entry (id "algebra/galois/rabin-irreducible?") (skill algebra) (module galois) (tier 0) (difficulty 335) (name rabin-irreducible?) (type "(-> Polynomial Int Boolean)") (description "Rabin's fast irreducibility test for polynomials over F_q") (notes ("O(d² * d * log q) field operations where d = deg(f)" "q must be field ORDER, not characteristic")) (section irreducible-polynomials) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod unique-prime-divisors poly-frobenius-power)) (answer "(define (rabin-irreducible? f q) (let* ((F (poly-field f)) (d (poly-degree f)) (x (make-polynomial F (list (field-zero F) (field-one F)))) (neg-x (poly-neg x)) (prime-divs (unique-prime-divisors d))) (and (let loop ((ps prime-divs)) (or (null? ps) (let* ((p (car ps)) (exp (quotient d p)) (x-qk (poly-frobenius-power x q exp f)) (diff (poly-add x-qk neg-x)) (g (poly-gcd diff f))) (and (= (poly-degree g) 0) (loop (cdr ps)))))) (let ((x-qd (poly-frobenius-power x q d f))) (poly-equal? x-qd x)))))"))
(task-entry (id "algebra/group/dihedral-inverse") (skill algebra) (module group) (tier 0) (difficulty 336) (name dihedral-inverse) (type "(-> Integer (-> Element Element))") (description "Inverse in D_n") (notes ("(r^k)⁻¹ = r^(-k mod n)" "(sr^k)⁻¹ = sr^k (reflections are self-inverse)")) (section dihedral-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity dihedral-op)) (answer "(define (dihedral-inverse n) (lambda (a) (let ((a-type (car a)) (a-k (cdr a))) (if (eq? a-type 'r) (cons 'r (modulo (- n a-k) n)) a))))"))
