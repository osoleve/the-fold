(task-entry (id "numeric/digital-filters/poles-zeros->tf") (skill numeric) (module digital-filters) (tier 0) (difficulty 2530) (name poles-zeros->tf) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window bessel-i0 sinc fir-lowpass fir-highpass fir-bandpass fir-bandstop fir-filter make-iir-filter iir-filter? iir-filter-b iir-filter-a iir-filter-signal make-biquad biquad? biquad-b0 biquad-b1 biquad-b2 biquad-a1 biquad-a2 biquad-filter cascade-biquads butterworth-lowpass-poles bilinear-transform butterworth-lowpass complex-sum)) (answer "(define (poles-zeros->tf poles zeros) (let* ((b (poly-from-roots zeros)) (a (poly-from-roots poles)) (b-sum (complex-sum (vector->list b))) (a-sum (complex-sum (vector->list a))) (b-mag (complex-magnitude b-sum)) (gain (if (< b-mag 1e-10) 1.0 (/ (complex-magnitude a-sum) b-mag))) (b-normalized (vector-scale-real b gain)) (a-real (vector-scale-real a 1.0))) (make-iir-filter b-normalized a-real)))"))
(task-entry (id "numeric/signal-poly/jury-new-row") (skill numeric) (module signal-poly) (tier 0) (difficulty 2530) (name jury-new-row) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;digital-filters)) (available (Q-field-sig sig-make-polynomial sig-normalize-coeffs sig-poly-field sig-poly-coeffs sig-poly-degree sig-poly-zero? sig-poly-leading sig-poly-add sig-poly-sub sig-poly-mul list-set sig-poly-scale sig-poly-divmod sig-poly-zero-over sig-poly-one-over sig-poly-divmod-iter sig-poly-div sig-poly-mod sig-poly-gcd sig-poly-make-monic num-poly-coeffs-sig numeric->signal-poly signal->numeric-poly filter-num-poly filter-den-poly filter-coprime? filter-simplify jury-table jury-table-iter)) (answer "(define (jury-new-row row1 row2 a0 an) (let ((n (length row1))) (let loop ((i 0) (acc '())) (if (>= i (- n 1)) (reverse acc) (let* ((bi (list-ref row1 i)) (bn-i (list-ref row2 (+ i 1))) (val (- (* a0 bi) (* an bn-i)))) (loop (+ i 1) (cons val acc)))))))"))
(task-entry (id "numeric/interpolate/bspline-curve") (skill numeric) (module interpolate) (tier 0) (difficulty 2530) (name bspline-curve) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;numeric/polynomial)) (available (binary-search-segment binary-search-segment-vec lerp lerp-inverse interp-linear lagrange-basis interp-lagrange divided-differences interp-newton interp-hermite hermite-tangent-estimate thomas-algorithm cubic-spline-natural matrix-set! spline-eval interp-cubic-spline bezier-linear bezier-quadratic bezier-cubic bezier-general bezier-derivative polyfit linreg linreg-r2 chebyshev-nodes chebyshev-nodes-interval chebyshev-t chebyshev-coeffs chebyshev-eval bspline-basis)) (answer "(define (bspline-curve knots control-points p t) (let ((n (length control-points))) (let loop ((i 0) (x 0.0) (y 0.0)) (if (= i n) (cons x y) (let ((basis (bspline-basis knots i p t)) (pi (list-ref control-points i))) (loop (+ i 1) (+ x (* basis (car pi))) (+ y (* basis (cdr pi)))))))))"))
