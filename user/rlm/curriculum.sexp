(task-entry (id "data/graph-matrix/cycle-graph") (skill data) (module graph-matrix) (tier 0) (difficulty 1328) (name cycle-graph) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize adjacency-symmetrize-sparse degree-matrix degree-matrix-sparse complete-graph)) (answer "(define (cycle-graph n . opts) (let ((directed (if (null? opts) #f (car opts))) (data (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n n data)) (let ((next (remainder (+ i 1) n))) (vector-set! data (+ (* i n) next) 1) (unless directed (vector-set! data (+ (* next n) i) 1))))))"))
(task-entry (id "data/graph-community/community-homology-report") (skill data) (module graph-community) (tier 0) (difficulty 1328) (name community-homology-report) (type "") (description "") (notes ()) (section community-homology) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find uf-union connected-components is-connected? mst-from-adjacency modularity-ilp compute-degrees compute-modularity-matrix build-modularity-ilp community-induced-edges community-betti-numbers all-communities-betti community-homology-quality aggregate-community-quality round-2 round-3)) (answer "(define (community-homology-report adj labels) (let* ((betti-list (all-communities-betti adj labels)) (n (vector-length labels)) (num-communities (length betti-list)) (total-quality (aggregate-community-quality adj labels)) (mod-score (modularity adj labels))) (printf \"\n=== Community Homology Report ===\n\n\") (printf \"Graph: ~a nodes, ~a communities\n\" n num-communities) (printf \"Modularity Q: ~a\n\" (round-3 mod-score)) (printf \"Topological Quality: ~a\n\n\" (round-3 total-quality)) (printf \"Per-Community Analysis:\n\") (printf \"  ID   Size   B_0   B_1   Quality   Notes\n\") (printf \"  --   ----   ---   ---   -------   -----\n\") (for-each (lambda (entry) (let* ((id (car entry)) (size (cadr entry)) (b0 (caddr entry)) (b1 (cadddr entry)) (quality (community-homology-quality size b0 b1)) (max-b1 (/ (* (- size 1) (- size 2)) 2)) (notes (cond ((> b0 1) \"FRAGMENTED\") ((= size 1) \"singleton\") ((and (>= size 2) (= b1 0)) \"tree-like\") ((and (> max-b1 0) (>= b1 max-b1)) \"clique\") ((and (> max-b1 0) (>= (/ b1 max-b1) 0.7)) \"very dense\") (else \"\")))) (printf \"  ~a    ~a     ~a     ~a    ~a      ~a\n\" id size b0 b1 (round-2 quality) notes))) betti-list) (printf \"\n---------------------------------\n\") (printf \"Legend:\n\") (printf \"  B_0: Connected components (ideal = 1)\n\") (printf \"  B_1: Independent cycles (higher = denser)\n\") (printf \"  FRAGMENTED: Community has disconnected parts\n\") (printf \"  singleton:  Single-node community\n\") (printf \"  tree-like:  Connected but no cycles (B_1 = 0)\n\") (printf \"  clique:     Complete subgraph (B_1 = max)\n\") (printf \"  very dense: B_1 >= 70%% of maximum\n\") (printf \"=================================\n\n\")))"))
(task-entry (id "data/graph-layout/calculate-attraction") (skill data) (module graph-layout) (tier 0) (difficulty 1328) (name calculate-attraction) (type "") (description "") (notes ()) (section forces) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens graph-nodes-each graph-all-positions graph-all-velocities *repulsion-constant* *attraction-constant* *gravity-constant* *damping* *min-distance* *max-displacement* calculate-repulsion)) (answer "(define (calculate-attraction node1 node2) (let* ((pos1 (node-pos node1)) (pos2 (node-pos node2)) (delta (vec-sub pos2 pos1)) (dist (vec-norm delta)) (force-mag (* *attraction-constant* dist))) (if (< dist *min-distance*) (vector 0.0 0.0) (let ((unit-vec (vec-scale (/ 1.0 dist) delta))) (vec-scale force-mag unit-vec)))))"))
(task-entry (id "data/kdtree/kdtree-balanced?") (skill data) (module kdtree) (tier 0) (difficulty 1328) (name kdtree-balanced?) (type "(-> KDTree Boolean)") (description "Check if tree is approximately balanced (height ~ log n)") (notes ()) (section statistics) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater? kdtree-knn knn-heap->list kdtree-knn-rec kdtree-range kdtree-range-rec point-in-box? kdtree-radius kdtree-size kdtree-height)) (answer "(define (kdtree-balanced? tree) (if (kdtree-empty? tree) #t (let ((h (kdtree-height tree)) (n (kdtree-size tree))) (and (> n 0) (<= h (* 2 (+ 1 (floor (log n 2)))))))))"))
(task-entry (id "data/quadtree/quadtree-insert-at-depth") (skill data) (module quadtree) (tier 0) (difficulty 1328) (name quadtree-insert-at-depth) (type "") (description "") (notes ()) (section insertion) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build quadtree-build-auto list->quadtree quadtree-insert)) (answer "(define (quadtree-insert-at-depth tree x y data depth) (cond ((quadtree-empty? tree) tree) ((quadtree-leaf? tree) (let ((bounds (quadtree-leaf-bounds tree)) (points (quadtree-leaf-points tree))) (if (not (bounds-contains? bounds x y)) tree (if (or (< (length points) *quadtree-capacity*) (>= depth *quadtree-max-depth*)) (quadtree-leaf bounds (cons (list x y data) points)) (let ((split-tree (quadtree-split tree depth))) (quadtree-insert-at-depth split-tree x y data (+ depth 1))))))) ((quadtree-node? tree) (let ((bounds (quadtree-bounds tree))) (if (not (bounds-contains? bounds x y)) tree (let* ((cx (bounds-cx bounds)) (cy (bounds-cy bounds)) (ne (quadtree-ne tree)) (nw (quadtree-nw tree)) (se (quadtree-se tree)) (sw (quadtree-sw tree)) (next-depth (+ depth 1))) (cond ((and (>= x cx) (>= y cy)) (quadtree-node bounds (quadtree-insert-at-depth ne x y data next-depth) nw se sw)) ((and (< x cx) (>= y cy)) (quadtree-node bounds ne (quadtree-insert-at-depth nw x y data next-depth) se sw)) ((and (>= x cx) (< y cy)) (quadtree-node bounds ne nw (quadtree-insert-at-depth se x y data next-depth) sw)) (else (quadtree-node bounds ne nw se (quadtree-insert-at-depth sw x y data next-depth))))))))))"))
