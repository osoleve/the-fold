(task-entry (id "statistics/exponential/hw-fitted") (skill statistics) (module exponential) (tier 1) (difficulty 11210) (name hw-fitted) (type "") (description "") (notes ()) (section simple-exponential-smoothing-ses) (deps (\x27;prelude)) (available (simple-exponential-smooth ses-forecast optimize-ses-alpha holt-smooth holt-forecast holt-fitted holt-winters holt-winters-additive holt-winters-multiplicative hw-forecast)) (answer "(define (hw-fitted result) (let* ((type (cadr result)) (period (list-ref result 4)) (level (list-ref result 5)) (trend (list-ref result 6)) (seasonal (list-ref result 7)) (n (vector-length level)) (fitted (make-vector n))) (do ((t 0 (+ t 1))) ((= t n) fitted) (if (= t 0) (if (eq? type 'additive) (vector-set! fitted t (+ (vector-ref level 0) (vector-ref seasonal 0))) (vector-set! fitted t (* (vector-ref level 0) (vector-ref seasonal 0)))) (let* ((lt-1 (vector-ref level (- t 1))) (bt-1 (vector-ref trend (- t 1))) (st-p (if (>= (- t period) 0) (vector-ref seasonal (- t period)) (vector-ref seasonal t)))) (if (eq? type 'additive) (vector-set! fitted t (+ lt-1 bt-1 st-p)) (vector-set! fitted t (* (+ lt-1 bt-1) st-p))))))))"))
(task-entry (id "statistics/forecast/forecast-intervals") (skill statistics) (module forecast) (tier 1) (difficulty 11210) (name forecast-intervals) (type "") (description "") (notes ()) (section forecast-accuracy-metrics) (deps (\x27;prelude)) (available (mae mse rmse mape smape mase naive-forecast drift-forecast seasonal-naive-forecast mean-forecast)) (answer "(define (forecast-intervals forecasts residuals confidence) (let* ((h (vector-length forecasts)) (n (vector-length residuals)) (sigma (sqrt (/ (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (expt (vector-ref residuals i) 2))))) (max (- n 1) 1)))) (z (standard-normal-quantile-approx (+ 0.5 (/ confidence 2)))) (lower (make-vector h)) (upper (make-vector h))) (do ((i 0 (+ i 1))) ((= i h)) (let* ((fc (vector-ref forecasts i)) (se (* sigma (sqrt (+ i 1)))) (margin (* z se))) (vector-set! lower i (- fc margin)) (vector-set! upper i (+ fc margin)))) (list 'forecast-interval-result forecasts lower upper confidence)))"))
