(task-entry (id "optics/profunctor-optics/p-grate?") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11112) (name p-grate?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong? strong-profunctor strong-first strong-second pfirst psecond make-choice swap-either choice? choice-profunctor choice-left choice-right pleft pright make-closed closed-profunctor? closed-profunctor closed-fn pclosed make-wander wander? wander-strong wander-choice wander-wander pwander profunctor-fn strong-fn choice-fn closed-fn-instance wander-fn make-forget forget? run-forget profunctor-forget strong-forget make-tagged tagged? run-tagged profunctor-tagged choice-tagged make-star star? star-functor run-star profunctor-star make-p-iso p-iso? p-iso-forward p-iso-backward run-p-iso p-iso-compose make-p-lens p-lens? p-lens-getter p-lens-setter run-p-lens p-lens-compose make-p-prism p-prism? p-prism-match p-prism-build run-p-prism p-prism-compose make-p-affine p-affine? p-affine-preview p-affine-set run-p-affine p-affine-compose make-p-traversal p-traversal? p-traversal-traverse p-traversal-fold-fn run-p-traversal p-traversal-to-list p-traversal-over p-traversal-set p-traversal-compose p-traversal-each p-traversal-both p-traversal-filtered make-p-fold p-fold? p-fold-fn p-fold-to-list p-fold-preview p-fold-has p-fold-length p-fold-all p-fold-any p-fold-compose p-fold-each p-fold-filtered p-fold-taking traversal->p-traversal p-traversal->traversal p-lens->p-traversal p-prism->p-traversal p-affine->p-traversal p-traversal->p-fold p-lens->p-fold p-prism->p-fold make-p-grate)) (answer "(define (p-grate? x) (and (pair? x) (eq? (car x) 'p-grate)))"))
(task-entry (id "info/entropy/mutual-information-from-joint") (skill info) (module entropy) (tier 1) (difficulty 11112) (name mutual-information-from-joint) (type "(-> (List (List Number)) Number)") (description "Compute I(X;Y) from joint distribution only (computes marginals automatically)") (notes ()) (section mutual-information) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy conditional-entropy-direct mutual-information)) (answer "(define (mutual-information-from-joint joint-probs) (let* ((marginal-x (compute-marginal-x joint-probs)) (marginal-y (compute-marginal-y joint-probs))) (mutual-information joint-probs marginal-x marginal-y)))"))
(task-entry (id "info/statistical-measures/neyman-divergence") (skill info) (module statistical-measures) (tier 1) (difficulty 11112) (name neyman-divergence) (type "(-> (List Real) (List Real) Real)") (description "Neyman chi-squared divergence (reverse Pearson)") (notes ()) (section pearson-and-neyman) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared jeffreys-divergence alpha-divergence squared-hellinger-distance triangular-discrimination pearson-divergence)) (answer "(define (neyman-divergence p q) (chi-squared-divergence q p))"))
(task-entry (id "info/channel-capacity/dmc-joint-distribution") (skill info) (module channel-capacity) (tier 1) (difficulty 11112) (name dmc-joint-distribution) (type "(-> (List (List Real)) (List Real) (List (List Real)))") (description "Compute joint distribution P(X,Y) = P(Y|X) * P(X)") (notes ()) (section discrete-memoryless-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity awgn-capacity-db awgn-capacity-bandwidth snr-for-capacity dmc-mutual-information dmc-output-distribution)) (answer "(define (dmc-joint-distribution transition input-dist) (map (lambda (i) (let ((p-x (list-ref input-dist i)) (row (list-ref transition i))) (map (lambda (p-y-given-x) (* p-x p-y-given-x)) row))) (iota (length transition))))"))
(task-entry (id "info/rate-distortion/gaussian-rate-distortion") (skill info) (module rate-distortion) (tier 1) (difficulty 11112) (name gaussian-rate-distortion) (type "(-> Real Real Real)") (description "Rate-distortion function for Gaussian source") (notes ()) (section rate-distortion-functions) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr snr-db psnr mean variance)) (answer "(define (gaussian-rate-distortion variance distortion) (cond ((<= variance 0) 0) ((<= distortion 0) +inf.0) ((>= distortion variance) 0) (else (* 0.5 (log2 (/ variance distortion))))))"))
