(task-entry (id "fp/proof-tactics/tactic-rewrite") (skill fp) (module proof-tactics) (tier 1) (difficulty 10616) (name tactic-rewrite) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;engine \x27;rewrite/laws)) (available (make-proof-goal proof-goal? goal-lhs goal-rhs goal-context goal-trivial? tactic-success tactic-failure tactic-success? tactic-failure? tactic-subgoals tactic-builder tactic-error tactic-refl tactic-sym tactic-trans)) (answer "(define (tactic-rewrite law-name) (lambda (goal) (if (not (proof-goal? goal)) (tactic-failure '(not-a-goal)) (let ((law (get-law law-name))) (if (not law) (tactic-failure (quasiquote (unknown-law (unquote law-name)))) (let* ((lhs (goal-lhs goal)) (rhs (goal-rhs goal)) (ctx (goal-context goal)) (result (apply-rule law lhs))) (if (not result) (tactic-failure (quasiquote (law-did-not-apply (unquote law-name) (unquote lhs)))) (let ((rewritten (car result)) (bindings (cdr result))) (if (equal? rewritten rhs) (tactic-success '() (lambda () (quasiquote (rewrite (unquote law-name) (unquote bindings))))) (let ((new-goal (make-proof-goal rewritten rhs ctx))) (tactic-success (list new-goal) (lambda (proofs) (quasiquote (trans (rewrite (unquote law-name) (unquote bindings)) (unquote (if (null? proofs) '(refl) (car proofs)))))))))))))))))"))
