(task-entry (id "autodiff/differentiable-signal/magnitude-spectrum-grad") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12718) (name magnitude-spectrum-grad) (type "(-> (Vector Complex) (Vector Number) (Vector Complex))") (description "Gradient of magnitude spectrum") (notes ()) (section magnitude-spectrum) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real make-dft-re-local-grads make-dft-im-local-grads diff-dft diff-convolution traced-convolve-1d make-conv-local-grads power-spectrum-grad power-spectrum-grad-real)) (answer "(define (magnitude-spectrum-grad X output-grad) (let* ((n (vector-length X)) (result (make-vector n))) (do ((k 0 (+ k 1))) ((= k n) result) (let* ((x-k (vector-ref X k)) (mag (complex-magnitude x-k)) (g-k (if (< k (vector-length output-grad)) (vector-ref output-grad k) 0))) (if (< mag 1e-12) (vector-set! result k (complex-zero)) (vector-set! result k (complex-scale (/ g-k mag) (complex-conjugate x-k))))))))"))
(task-entry (id "autodiff/sparse-autodiff/pattern-from-explicit") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12718) (name pattern-from-explicit) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity)) (answer "(define (pattern-from-explicit m n pairs) (let* ((nnz (length pairs)) (row-idx (make-vector nnz 0)) (col-idx (make-vector nnz 0))) (do ((k 0 (+ k 1)) (ps pairs (cdr ps))) ((= k nnz) (make-sparsity-pattern m n row-idx col-idx)) (let ((p (car ps))) (vector-set! row-idx k (car p)) (vector-set! col-idx k (cdr p))))))"))
(task-entry (id "autodiff/typed-gradients/safe-jacobian") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12718) (name safe-jacobian) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix)) (answer "(define (safe-jacobian spec args) (if (not (gradient-spec? spec)) (list 'error 'invalid-gradient-spec spec) (let ((expected-input-dim (gradient-spec-input-dim spec)) (expected-output-dim (gradient-spec-output-dim spec)) (f (gradient-spec-fn spec)) (actual-input-dim (length args))) (if (not (= expected-input-dim actual-input-dim)) (list 'error 'input-dimension-mismatch (list 'expected expected-input-dim) (list 'got actual-input-dim)) (let ((raw-jacobian (jacobian f args))) (if (and (pair? raw-jacobian) (eq? (car raw-jacobian) 'matrix)) (let ((actual-rows (matrix-rows raw-jacobian)) (actual-cols (matrix-cols raw-jacobian))) (if (and (= actual-rows expected-output-dim) (= actual-cols expected-input-dim)) (dim-jacobian expected-output-dim expected-input-dim raw-jacobian) (list 'error 'jacobian-dimension-mismatch (list 'expected (list expected-output-dim expected-input-dim)) (list 'got (list actual-rows actual-cols))))) (list 'error 'jacobian-computation-failed raw-jacobian)))))))"))
(task-entry (id "autodiff/profiling/graph-memory-estimate") (skill autodiff) (module profiling) (tier 1) (difficulty 12718) (name graph-memory-estimate) (type "") (description "") (notes ()) (section tape-statistics) (deps (\x27;prelude \x27;comp-graph \x27;reverse-diff \x27;sort)) (available (tape-stats tape-size tape-op-count graph-stats graph-edge-count graph-depth extract-input-ids find-node-id tally-ops current-microseconds time-thunk time-gradient *ptr-size* *fixnum-size* *flonum-size* *pair-size* *vector-header* tape-memory-estimate)) (answer "(define (graph-memory-estimate g) (let* ((nodes (comp-graph-nodes g)) (n (length nodes))) (if (zero? n) 0 (graph-fold-nodes (lambda (acc id node) (+ acc (node-memory-estimate node))) (* 4 *pair-size*) g))))"))
(task-entry (id "autodiff/symbolic-diff/simplify-neg") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12718) (name simplify-neg) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products make-product-from-list simplify-diff)) (answer "(define (simplify-neg e) (cond ((num? e) (num (- (num-val e)))) ((and (difference? e) (not (diff-right e))) (diff-left e)) ((and (product? e) (= (length (product-factors e)) 2) (num? (car (product-factors e)))) (product (num (- (num-val (car (product-factors e))))) (cadr (product-factors e)))) (else (make-neg e))))"))
(task-entry (id "autodiff/interval-autodiff/iv-traced-neg") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12718) (name iv-traced-neg) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div)) (answer "(define (iv-traced-neg a) (let* ((av (interval-traced-value a)) (result (interval-neg av)) (tape (and (interval-traced? a) (interval-traced-tape a)))) (if tape (interval-traced-op 'neg result (list a) (list (interval-singleton -1)) tape) result)))"))
