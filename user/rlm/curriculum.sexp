(task-entry (id "fp/stream/force") (skill fp) (module stream) (tier 1) (difficulty 10653) (name force) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators)) (available (stream-nil stream-nil? stream-cons stream-cons? stream-head stream-tail list->stream stream->list stream-iterate stream-repeat stream-cycle stream-cycle-helper stream-from stream-range naturals stream-unfold stream-map stream-filter stream-take stream-drop stream-take-while stream-drop-while stream-nth stream-scan stream-concat stream-flatten stream-flatmap stream-zip stream-zip-with stream-interleave stream-merge stream-fold stream-any stream-all stream-find memo-stream-cons memo-stream? stream-force stream-force-helper fibonacci primes powers-of factorials triangular make-generator counter-generator random-stream stream-partition stream-group stream-distinct stream-distinct-helper stream-enumerate delay)) (answer "(define (force delayed) (if (and (pair? delayed) (eq? (car delayed) 'delayed)) (if (caddr delayed) (cadddr delayed) (let ((val ((cadr delayed)))) (set-car! (cddr delayed) #t) (set-car! (cdddr delayed) val) val)) (error 'force \"not a delayed value\")))"))
(task-entry (id "fp/zipper/zipper->string") (skill fp) (module zipper) (tier 1) (difficulty 10653) (name zipper->string) (type "(-> (ListZipper α) String)") (description "Convert zipper to string representation. Shows: [left...] >focus< [right...]") (notes ()) (section equality-and-display) (deps (\x27;prelude \x27;combinators)) (available (zipper-tag make-zipper zipper? zipper-left zipper-focus-maybe zipper-right zipper-empty zipper-empty? zipper-singleton list->zipper zipper->list zipper-from-position zipper-has-focus? zipper-can-go-left? zipper-can-go-right? zipper-left! zipper-right! zipper-start zipper-end zipper-goto zipper-position zipper-length zipper-focus zipper-focus-or zipper-set zipper-modify zipper-insert-left zipper-insert-right zipper-insert-focus zipper-delete zipper-delete-left zipper-delete-right zipper-map zipper-filter zipper-fold-left zipper-fold-right zipper-find zipper-find-index zipper-context zipper-take-left zipper-take-right zipper-window zipper-split zipper-append zipper-prepend zipper-functor zipper-fmap zipper-extract zipper-extend zipper-extend-collect zipper-duplicate zipper-comonad zipper-equal?)) (answer "(define (zipper->string z) (let ((left (reverse (zipper-left z))) (focus (zipper-focus-maybe z)) (right (zipper-right z))) (string-append \"[\" (if (null? left) \"\" (string-append (apply string-append (map (lambda (x) (string-append (format \"~a\" x) \" \")) left)))) (if (nothing? focus) \"|\" (string-append \">\" (format \"~a\" (from-just focus)) \"<\")) (if (null? right) \"\" (string-append \" \" (apply string-append (map (lambda (x) (string-append (format \"~a\" x) \" \")) (drop-right right 1))) (if (null? right) \"\" (format \"~a\" (last right))))) \"]\")))"))
