(task-entry (id "statistics/summary-stats/vec-min") (skill statistics) (module summary-stats) (tier 1) (difficulty 11217) (name vec-min) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev)) (answer "(define (vec-min v) (let ((n (vector-length v))) (if (= n 0) (error 'vec-min \"empty vector\") (let loop ((i 1) (m (vector-ref v 0))) (if (= i n) m (loop (+ i 1) (min m (vector-ref v i))))))))"))
(task-entry (id "statistics/design-matrix/legendre-features") (skill statistics) (module design-matrix) (tier 1) (difficulty 11217) (name legendre-features) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p chebyshev-t hermite-h laguerre-l)) (answer "(define (legendre-features xs degree) (let* ((n (vector-length xs)) (ncols (+ degree 1)) (x-min (vec-min xs)) (x-max (vec-max xs)) (x-range (- x-max x-min)) (scale (lambda (x) (if (= x-range 0) 0 (- (* 2 (/ (- x x-min) x-range)) 1)))) (data (make-vector (* n ncols)))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n ncols data)) (let ((xi (scale (vector-ref xs i)))) (do ((d 0 (+ d 1))) ((> d degree)) (vector-set! data (+ (* i ncols) d) (legendre-p d xi)))))))"))
