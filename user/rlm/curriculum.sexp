(task-entry (id "linalg/matrix/matrix-diagonal") (skill linalg) (module matrix) (tier 0) (difficulty 411) (name matrix-diagonal) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col)) (answer "(define (matrix-diagonal m) (let* ((rows (matrix-rows m)) (cols (matrix-cols m)) (n (min rows cols)) (data (matrix-data m)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (vector-ref data (+ (* i cols) i))))))"))
(task-entry (id "linalg/matrix-decomp/matrix-det") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 411) (name matrix-det) (type "") (description "Compute the determinant of a square matrix using LU decomposition. det(A) = det(L) × det(U) × sign(P) = 1 × (product of U diagonal) × sign(P). Complexity: O(n³) via LU decomposition.") (notes ()) (section determinant) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance* matrix-copy matrix-set! matrix-column matrix-lu matrix-lu-solve qr-find-orthogonal-basis qr-orthogonalize-remaining! matrix-qr matrix-cholesky permutation-sign)) (answer "(define (matrix-det a) (let ((result (matrix-lu a))) (if (and (pair? result) (eq? (car result) 'error)) (if (eq? (cadr result) 'singular-matrix) 0 result) (let ((l (car result)) (u (cadr result)) (p (caddr result))) (let ((n (matrix-rows u))) (let loop ((i 0) (prod 1)) (if (= i n) (* prod (permutation-sign p)) (loop (+ i 1) (* prod (matrix-ref u i i))))))))))"))
(task-entry (id "linalg/matrix-solvers/levinson-durbin-general") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 411) (name levinson-durbin-general) (type "") (description "") (notes ()) (section toeplitz-solvers) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute matrix-back-substitute matrix-solve matrix-inverse permutation-parity matrix-determinant matrix-least-squares matrix-gauss-elim matrix-rank matrix-condition-number levinson-durbin)) (answer "(define (levinson-durbin-general r b) (let* ((n (vector-length r)) (x (make-vector n 0.0)) (x-tmp (make-vector n 0.0)) (a (make-vector n 0.0)) (a-tmp (make-vector n 0.0)) (r0 (vector-ref r 0))) (if (= n 0) x (if (< (abs r0) 1e-15) (list 'error 'singular 0) (begin (vector-set! x 0 (/ (vector-ref b 0) r0)) (if (= n 1) x (let ((e r0)) (vector-set! a 0 (- (/ (vector-ref r 1) r0))) (set! e (* e (- 1 (expt (vector-ref a 0) 2)))) (let loop ((m 1)) (if (= m n) x (if (< (abs e) 1e-15) (list 'error 'singular m) (let* ((delta (- (vector-ref b m) (let inner ((k 0) (sum 0.0)) (if (= k m) sum (inner (+ k 1) (+ sum (* (vector-ref x k) (vector-ref r (- m k))))))))) (delta-e (/ delta e))) (do ((k 0 (+ k 1))) ((= k m)) (vector-set! x-tmp k (+ (vector-ref x k) (* delta-e (vector-ref a (- m 1 k)))))) (vector-set! x-tmp m delta-e) (do ((k 0 (+ k 1))) ((= k (+ m 1))) (vector-set! x k (vector-ref x-tmp k))) (if (< m (- n 1)) (let* ((lambda-num (let inner ((k 0) (sum (vector-ref r (+ m 1)))) (if (= k m) sum (inner (+ k 1) (+ sum (* (vector-ref a k) (vector-ref r (- m k)))))))) (lambda-m (- (/ lambda-num e)))) (do ((k 0 (+ k 1))) ((= k m)) (vector-set! a-tmp k (+ (vector-ref a k) (* lambda-m (vector-ref a (- m 1 k)))))) (vector-set! a-tmp m lambda-m) (do ((k 0 (+ k 1))) ((= k (+ m 1))) (vector-set! a k (vector-ref a-tmp k))) (set! e (* e (- 1 (* lambda-m lambda-m)))) (loop (+ m 1))) (loop (+ m 1))))))))))))))"))
(task-entry (id "linalg/matrix-eigen/extract-eigenvalues-with-complex-check") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 411) (name extract-eigenvalues-with-complex-check) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block)) (answer "(define (extract-eigenvalues-with-complex-check a n tol) (let ((eigenvalues (make-vector n 0)) (complex-info '())) (let loop ((i 0)) (cond ((>= i n) (if (null? complex-info) eigenvalues (quasiquote (complex-eigenvalues (unquote eigenvalues) (unquote complex-info))))) ((>= (+ i 1) n) (vector-set! eigenvalues i (matrix-ref a i i)) (loop (+ i 1))) (else (let ((complex-pair (detect-complex-2x2-block a i tol))) (if complex-pair (begin (vector-set! eigenvalues i (car complex-pair)) (vector-set! eigenvalues (+ i 1) (car complex-pair)) (set! complex-info (cons (list i (car complex-pair) (cdr complex-pair)) complex-info)) (loop (+ i 2))) (begin (vector-set! eigenvalues i (matrix-ref a i i)) (loop (+ i 1))))))))))"))
(task-entry (id "linalg/iterative-solvers/cg-loop") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 411) (name cg-loop) (type "") (description "") (notes ()) (section conjugate-gradient) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient)) (answer "(define (cg-loop a b x r p rr iter max-iter tol n) (let ((r-norm (sqrt rr))) (cond ((< r-norm tol) (list x iter r-norm)) ((>= iter max-iter) (quasiquote (error no-convergence (unquote iter) (unquote r-norm)))) (else (let* ((ap (matrix-vec-mul a p)) (pap (vec-dot p ap))) (if (< (abs pap) *iterative-tolerance*) (quasiquote (error breakdown-pap-zero (unquote iter) (unquote pap))) (let* ((alpha (/ rr pap)) (x-new (vec-add x (vec-scale alpha p))) (r-new (vec-sub r (vec-scale alpha ap))) (rr-new (vec-dot r-new r-new)) (beta (/ rr-new rr)) (p-new (vec-add r-new (vec-scale beta p)))) (cg-loop a b x-new r-new p-new rr-new (+ iter 1) max-iter tol n))))))))"))
(task-entry (id "linalg/sparse/sparse-csr?") (skill linalg) (module sparse) (tier 0) (difficulty 411) (name sparse-csr?) (type "") (description "") (notes ()) (section csr-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref)) (answer "(define (sparse-csr? m) (and (pair? m) (eq? (car m) 'sparse-csr) (= (length m) 6)))"))
(task-entry (id "linalg/graph-laplacian/spectral-partition-k") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 411) (name spectral-partition-k) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition)) (answer "(define (spectral-partition-k adj k) (let ((n (adjacency-matrix-node-count adj))) (if (<= k 1) (list (let loop ((i 0) (nodes '())) (if (= i n) (reverse nodes) (loop (+ i 1) (cons i nodes))))) (let ((result (spectral-partition adj))) (if (and (pair? result) (eq? (car result) 'error)) result (let ((part-a (car result)) (part-b (cdr result))) (if (<= k 2) (list part-a part-b) (let* ((k-a (quotient k 2)) (k-b (- k k-a)) (partitions-a (subgraph-partition adj part-a k-a)) (partitions-b (subgraph-partition adj part-b k-b))) (if (and (pair? partitions-a) (eq? (car partitions-a) 'error)) partitions-a (if (and (pair? partitions-b) (eq? (car partitions-b) 'error)) partitions-b (append partitions-a partitions-b)))))))))))"))
(task-entry (id "linalg/svd/count-nonzero-singular-values") (skill linalg) (module svd) (tier 0) (difficulty 411) (name count-nonzero-singular-values) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector)) (answer "(define (count-nonzero-singular-values singular-values tol) (let ((n (vector-length singular-values))) (let loop ((i 0) (count 0)) (if (= i n) count (if (> (vector-ref singular-values i) tol) (loop (+ i 1) (+ count 1)) (loop (+ i 1) count))))))"))
