(task-entry (id "physics/classical/collision-detection/circle-circle?") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23533) (name circle-circle?) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold)) (answer "(define (circle-circle? a b) (let ((dist-sq (vec2-distance-sq (circle-center a) (circle-center b))) (r-sum (+ (circle-radius a) (circle-radius b)))) (<= dist-sq (* r-sum r-sum))))"))
(task-entry (id "physics/classical/collision-response/resolve-collision") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23533) (name resolve-collision) (type "") (description "") (notes ()) (section impulse) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material combine-materials velocity-at-point relative-velocity-at relative-velocity normal-velocity-at normal-velocity tangent-velocity get-inv-mass get-inv-inertia get-body-pos calculate-impulse-with-rotation calculate-impulse calculate-friction-impulse body-is-static? apply-impulse-at apply-impulse)) (answer "(define (resolve-collision manifold mat-a mat-b) (let* ((body-a (manifold-body-a manifold)) (body-b (manifold-body-b manifold)) (normal (manifold-normal manifold)) (combined (combine-materials mat-a mat-b)) (restitution (car combined)) (static-friction (cadr combined)) (dynamic-friction (caddr combined)) (j-normal (calculate-impulse body-a body-b normal restitution))) (if (= j-normal 0) (list body-a body-b) (let* ((normal-impulse (vec2-scale normal j-normal)) (body-a-1 (apply-impulse body-a (vec2-neg normal-impulse))) (body-b-1 (apply-impulse body-b normal-impulse)) (j-friction (calculate-friction-impulse body-a-1 body-b-1 normal j-normal static-friction dynamic-friction)) (rel-vel (relative-velocity body-a-1 body-b-1)) (normal-comp (vec2-scale normal (vec2-dot rel-vel normal))) (tangent-vel (vec2-sub rel-vel normal-comp)) (tangent (if (< (vec2-magnitude tangent-vel) 1e-4) (vec2 0 0) (vec2-normalize tangent-vel))) (friction-impulse (vec2-scale tangent j-friction)) (body-a-2 (apply-impulse body-a-1 friction-impulse)) (body-b-2 (apply-impulse body-b-1 (vec2-neg friction-impulse)))) (list body-a-2 body-b-2)))))"))
(task-entry (id "physics/classical/constraint-graph/cg-find-bridges") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23533) (name cg-find-bridges) (type "") (description "") (notes ()) (section topology) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints toposort-dag cg-color-constraints build-constraint-conflicts cg-chromatic-number cg-stats cg-print-stats cg->simplicial-complex cg-cycle-count cg-topology-analysis)) (answer "(define (cg-find-bridges graph) (let* ((entities (cg-entities graph)) (n (length entities)) (entity->idx (make-hashtable equal-hash equal?)) (_ (let loop ((es entities) (i 0)) (unless (null? es) (hashtable-set! entity->idx (car es) i) (loop (cdr es) (+ i 1))))) (disc (make-vector n -1)) (low (make-vector n -1)) (parent (make-vector n -1)) (time-counter (list 0)) (bridges '()) (constraint-edges (filter-map (lambda (c) (let ((a (constraint-entity-a c)) (b (constraint-entity-b c))) (if b (let ((ia (hashtable-ref entity->idx a #f)) (ib (hashtable-ref entity->idx b #f))) (if (and ia ib) (list ia ib c) #f)) #f))) (cg-constraints graph))) (adj (make-vector n '()))) (for-each (lambda (edge) (let ((u (car edge)) (v (cadr edge)) (c (caddr edge))) (vector-set! adj u (cons (list v c) (vector-ref adj u))) (vector-set! adj v (cons (list u c) (vector-ref adj v))))) constraint-edges) (letrec ((dfs (lambda (u) (let ((time (car time-counter))) (set-car! time-counter (+ time 1)) (vector-set! disc u time) (vector-set! low u time) (for-each (lambda (neighbor-info) (let ((v (car neighbor-info)) (c (cadr neighbor-info))) (cond ((= (vector-ref disc v) -1) (vector-set! parent v u) (dfs v) (vector-set! low u (min (vector-ref low u) (vector-ref low v))) (when (> (vector-ref low v) (vector-ref disc u)) (set! bridges (cons c bridges)))) ((not (= v (vector-ref parent u))) (vector-set! low u (min (vector-ref low u) (vector-ref disc v))))))) (vector-ref adj u)))))) (let loop ((i 0)) (when (< i n) (when (= (vector-ref disc i) -1) (dfs i)) (loop (+ i 1))))) bridges))"))
