(task-entry (id "fp/simplify/expand-product") (skill fp) (module simplify) (tier 1) (difficulty 10622) (name expand-product) (type "(-> (List Expr) Expr)") (description "Expand product by distributing over sums") (notes ()) (section product-expansion) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow simplify-app expand expand-once)) (answer "(define (expand-product factors) (cond ((null? factors) (num 1)) ((= (length factors) 1) (car factors)) (else (let ((first (car factors)) (rest-expanded (expand-product (cdr factors)))) (cond ((sum? first) (make-sum-from-list (map (lambda (term) (simplify (product term rest-expanded))) (sum-terms first)))) ((sum? rest-expanded) (make-sum-from-list (map (lambda (term) (simplify (product first term))) (sum-terms rest-expanded)))) (else (product first rest-expanded)))))))"))
(task-entry (id "fp/integrate/integrate-partial-fractions") (skill fp) (module integrate) (tier 1) (difficulty 10622) (name integrate-partial-fractions) (type "(-> Expr Symbol Nat (Maybe Expr))") (description "Integrate rational functions using partial fractions") (notes ()) (section partial-fractions) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power integrate-quotient integrate-by-substitution try-substitution-pattern find-antiderivative-match find-u-candidates substitute-u can-express-in-u? replace-with-u try-trig-substitution integrate-by-parts sort-by-liate liate-priority polynomial? try-parts)) (answer "(define (integrate-partial-fractions expr var-sym depth) (if (not (quotient? expr)) #f (let ((numer (quot-numer expr)) (denom (quot-denom expr))) (cond ((and (num? numer) (= (num-val numer) 1) (product? denom) (= (length (product-factors denom)) 2) (for-all (lambda (f) (linear-in? f var-sym)) (product-factors denom))) (integrate-linear-factors numer denom var-sym depth)) (else #f)))))"))
(task-entry (id "fp/solve/solve") (skill fp) (module solve) (tier 1) (difficulty 10622) (name solve) (type "(-> Equation Symbol (Maybe (U (List Expr) Expr Symbol)))") (description "Solve equation for given variable") (notes ("Returns list of solutions, single solution, 'infinite, or #f; auto-expands factored forms")) (section main-interface) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms solve-linear solve-quadratic solve-cubic solve-polynomial diff-to-sum)) (answer "(define (solve eq var-sym) (let* ((normalized (if (equation? eq) (make-equation (normalize-expr (equation-lhs eq)) (normalize-expr (equation-rhs eq))) (normalize-expr eq))) (expr (if (equation? normalized) (equation->expr normalized) normalized)) (as-sums (diff-to-sum expr)) (expanded (simplify (expand as-sums)))) (solve-polynomial expanded var-sym)))"))
