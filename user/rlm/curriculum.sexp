(task-entry (id "statistics/forecast/combine-forecasts-weighted") (skill statistics) (module forecast) (tier 1) (difficulty 11217) (name combine-forecasts-weighted) (type "") (description "") (notes ()) (section forecast-accuracy-metrics) (deps (\x27;prelude)) (available (mae mse rmse mape smape mase naive-forecast drift-forecast seasonal-naive-forecast mean-forecast forecast-intervals standard-normal-quantile-approx forecast-accuracy theil-u tracking-signal time-series-cv combine-forecasts-mean)) (answer "(define (combine-forecasts-weighted forecasts weights) (if (null? forecasts) (vector) (let* ((h (vector-length (car forecasts))) (combined (make-vector h 0))) (let loop ((fcs forecasts) (wts 0)) (if (null? fcs) combined (let ((fc (car fcs)) (w (vector-ref weights wts))) (do ((i 0 (+ i 1))) ((= i h)) (vector-set! combined i (+ (vector-ref combined i) (* w (vector-ref fc i))))) (loop (cdr fcs) (+ wts 1))))))))"))
