(task-entry (id "control-systems/digital-pid/cohen-coon-tune") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22624) (name cohen-coon-tune) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune)) (answer "(define (cohen-coon-tune K tau theta Ts) (let* ((ratio (/ theta tau)) (Kp (* (/ 1 K) (/ tau theta) (+ 0.9 (/ theta (* 12 tau))))) (Ti (* theta (/ (+ 30 (* 3 ratio)) (+ 9 (* 20 ratio))))) (Ki (/ Kp Ti))) (make-digital-pid Kp Ki 0 Ts)))"))
(task-entry (id "control-systems/discrete-control/solve-linear-system") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22624) (name solve-linear-system) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output dss-simulate dss-impulse-response dss-step-response dss-stable? find-complex-at-index recommend-sample-rate vec-add matrix-vec-mul-v matrix-inverse)) (answer "(define (solve-linear-system A b) (let* ((n (matrix-rows A)) (aug (make-matrix n (+ n 1) 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! aug i j (matrix-ref A i j))) (matrix-set! aug i n (vector-ref b i))) (let forward ((k 0)) (if (= k n) (let ((x (make-vector n 0))) (let back ((i (- n 1))) (if (< i 0) x (let* ((sum (let sum-loop ((j (+ i 1)) (s 0)) (if (= j n) s (sum-loop (+ j 1) (+ s (* (matrix-ref aug i j) (vector-ref x j))))))) (xi (/ (- (matrix-ref aug i n) sum) (matrix-ref aug i i)))) (vector-set! x i xi) (back (- i 1)))))) (let* ((max-row k) (max-val (abs (matrix-ref aug k k)))) (do ((i (+ k 1) (+ i 1))) ((= i n)) (let ((val (abs (matrix-ref aug i k)))) (when (> val max-val) (set! max-row i) (set! max-val val)))) (if (< max-val 1e-14) '(error singular-matrix) (begin (when (not (= max-row k)) (do ((j 0 (+ j 1))) ((= j (+ n 1))) (let ((tmp (matrix-ref aug k j))) (matrix-set! aug k j (matrix-ref aug max-row j)) (matrix-set! aug max-row j tmp)))) (do ((i (+ k 1) (+ i 1))) ((= i n)) (let ((factor (/ (matrix-ref aug i k) (matrix-ref aug k k)))) (do ((j k (+ j 1))) ((= j (+ n 1))) (matrix-set! aug i j (- (matrix-ref aug i j) (* factor (matrix-ref aug k j))))))) (forward (+ k 1)))))))))"))
(task-entry (id "control-systems/hinf-synthesis/matrix-near-zero?") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22624) (name matrix-near-zero?) (type "Matrix × Number → Boolean") (description "Check if all elements of matrix are within tolerance of zero") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf)) (answer "(define (matrix-near-zero? M tol) (let* ((rows (matrix-rows M)) (cols (matrix-cols M))) (let loop ((i 0)) (if (>= i rows) #t (let inner ((j 0)) (if (>= j cols) (loop (+ i 1)) (if (> (abs (matrix-ref M i j)) tol) #f (inner (+ j 1)))))))))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-square-free") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22624) (name alg-poly-square-free) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd)) (answer "(define (alg-poly-square-free p) (let* ((F (alg-poly-field p)) (p-deriv (alg-poly-derivative p)) (g (alg-poly-gcd p p-deriv))) (if (alg-poly-zero? g) p (alg-poly-div p g))))"))
(task-entry (id "control-systems/state-space/ss-observable?") (skill control-systems) (module state-space) (tier 2) (difficulty 22625) (name ss-observable?) (type "(-> SS Num Boolean)") (description "Check if system is observable (observability matrix has full column rank)") (notes ()) (section observability) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix)) (answer "(define (ss-observable? sys tolerance) (let* ((O-mat (ss-observability-matrix sys)) (n (ss-order sys)) (rank (matrix-rank O-mat tolerance))) (= rank n)))"))
(task-entry (id "control-systems/transfer-function/tf-feedback") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22625) (name tf-feedback) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase tf-phase-deg tf-bode-data tf-series tf-parallel)) (answer "(define (tf-feedback G H . sign) (let* ((neg? (or (null? sign) (eq? (car sign) 'negative))) (nG (tf-num G)) (dG (tf-den G)) (nH (tf-num H)) (dH (tf-den H)) (nGH (poly-mul nG nH)) (dGH (poly-mul dG dH)) (denom-num (if neg? (poly-add dGH nGH) (poly-sub dGH nGH)))) (make-tf (poly-mul nG dH) denom-num)))"))
(task-entry (id "control-systems/z-transform/dtf-stable?") (skill control-systems) (module z-transform) (tier 2) (difficulty 22625) (name dtf-stable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback)) (answer "(define (dtf-stable? dtf) (let ((poles (dtf-poles dtf))) (if (pair? poles) (and (list? poles) (andmap (lambda (p) (< (complex-magnitude p) 1)) poles)) #t)))"))
(task-entry (id "control-systems/stability/nyquist-stable?") (skill control-systems) (module stability) (tier 2) (difficulty 22625) (name nyquist-stable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference)) (answer "(define (nyquist-stable? tf) (let* ((open-loop-poles (tf-poles tf)) (rhp-poles (length (filter (lambda (p) (> (complex-real p) 0)) open-loop-poles))) (contour (nyquist-plot-points tf 500)) (encirclements (nyquist-count-encirclements contour (make-complex -1 0)))) (= encirclements (- rhp-poles))))"))
(task-entry (id "control-systems/controller-design/lqr") (skill control-systems) (module controller-design) (tier 2) (difficulty 22625) (name lqr) (type "SS × Matrix × Matrix → (K P eigenvalues) | Error") (description "Compute LQR controller gain. LQR minimizes: J = integral(x'Qx + u'Ru) dt. Solution: u = -K*x where K = R^{-1}*B'*P. P satisfies the continuous algebraic Riccati equation (CARE): A'P + PA - PBR^{-1}B'P + Q = 0") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place)) (answer "(define (lqr sys Q R) (let* ((A (ss-A sys)) (B (ss-B sys)) (n (ss-order sys)) (m (matrix-cols B)) (P (solve-care A B Q R 1000))) (if (and (pair? P) (eq? (car P) 'error)) P (let* ((R-inv (matrix-inverse R)) (Bt (matrix-transpose B)) (K (matrix-mul R-inv (matrix-mul Bt P))) (Acl (matrix-sub A (matrix-mul B K))) (cl-eigs (if (= n 1) (list (make-complex (matrix-ref Acl 0 0) 0)) (qr-algorithm-shifted Acl 100 1e-10)))) (list K P cl-eigs)))))"))
(task-entry (id "control-systems/digital-pid/pid-simulate") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22625) (name pid-simulate) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune cohen-coon-tune)) (answer "(define (pid-simulate pid state setpoint measurements) (let loop ((state state) (ms measurements) (outputs '()) (errors '())) (if (null? ms) (cons (reverse outputs) (reverse errors)) (let* ((pv (car ms)) (error (- setpoint pv)) (result (pid-step pid state error)) (output (car result)) (new-state (cdr result))) (loop new-state (cdr ms) (cons output outputs) (cons error errors))))))"))
(task-entry (id "control-systems/hinf-synthesis/lyapunov-solve-hinf") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22625) (name lyapunov-solve-hinf) (type "Matrix × Matrix × Nat → Matrix") (description "Solve A'X + XA = -Q via iteration (for Newton step)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero?)) (answer "(define (lyapunov-solve-hinf A Q max-iter) (let* ((n (matrix-rows A)) (At (matrix-transpose A)) (X Q) (dt 0.05)) (let loop ((X X) (iter 0)) (if (>= iter max-iter) X (let* ((AtX (matrix-mul At X)) (XA (matrix-mul X A)) (residual (matrix-add (matrix-add AtX XA) Q)) (X-new (matrix-sub X (matrix-scale dt residual))) (diff (matrix-frobenius-norm-hinf (matrix-sub X-new X)))) (if (< diff 1e-12) X-new (loop X-new (+ iter 1))))))))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-derivative") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22625) (name alg-poly-derivative) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free)) (answer "(define (alg-poly-derivative p) (let* ((F (alg-poly-field p)) (coeffs (alg-poly-coeffs p)) (n (length coeffs))) (if (<= n 1) (alg-poly-zero-over F) (let ((new-coeffs (let loop ((i 1) (acc '())) (if (>= i n) (reverse acc) (loop (+ i 1) (cons (* i (list-ref coeffs i)) acc)))))) (alg-make-polynomial F new-coeffs)))))"))
(task-entry (id "control-systems/state-space/ss-controllability-gramian-finite") (skill control-systems) (module state-space) (tier 2) (difficulty 22626) (name ss-controllability-gramian-finite) (type "(-> SS Nat Matrix)") (description "Compute finite-horizon controllability Gramian by direct sum. Wc = sum_{k=0}^{N-1} A^k * B * B' * (A')^k") (notes ()) (section gramians) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable?)) (answer "(define (ss-controllability-gramian-finite sys N) (let* ((A (ss-A sys)) (B (ss-B sys)) (n (ss-order sys)) (Wc (make-matrix n n 0))) (let loop ((k 0) (Ak (matrix-identity n))) (if (>= k N) Wc (let* ((AkB (matrix-mul Ak B)) (term (matrix-mul AkB (matrix-transpose AkB)))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! Wc i j (+ (matrix-ref Wc i j) (matrix-ref term i j))))) (loop (+ k 1) (matrix-mul Ak A)))))))"))
(task-entry (id "control-systems/transfer-function/tf-unity-feedback") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22626) (name tf-unity-feedback) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase tf-phase-deg tf-bode-data tf-series tf-parallel tf-feedback)) (answer "(define (tf-unity-feedback G) (tf-feedback G (tf-from-lists '(1) '(1)) 'negative))"))
(task-entry (id "control-systems/z-transform/dtf-pole-magnitudes") (skill control-systems) (module z-transform) (tier 2) (difficulty 22626) (name dtf-pole-magnitudes) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable?)) (answer "(define (dtf-pole-magnitudes dtf) (map complex-magnitude (dtf-poles dtf)))"))
(task-entry (id "control-systems/stability/gain-margin") (skill control-systems) (module stability) (tier 2) (difficulty 22626) (name gain-margin) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable?)) (answer "(define (gain-margin tf) (let* ((w-test (logspace -2 4 1000)) (phases (tf-phase tf w-test)) (mags (tf-magnitude tf w-test)) (pc-result (find-crossover phases (- pi) w-test))) (if pc-result (let* ((w-pc (car pc-result)) (idx (cdr pc-result)) (mag-at-pc (vector-ref mags idx)) (gm (/ 1 mag-at-pc)) (gm-db (* 20 (log10 gm)))) (list gm-db w-pc)) (list 'infinite 0))))"))
(task-entry (id "control-systems/controller-design/solve-care") (skill control-systems) (module controller-design) (tier 2) (difficulty 22626) (name solve-care) (type "Matrix × Matrix × Matrix × Matrix × Nat → Matrix | Error") (description "Solve continuous algebraic Riccati equation using Newton iteration. A'P + PA - PBR^{-1}B'P + Q = 0. Uses direct Lyapunov solver for small systems (n < 15), iterative for larger") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr)) (answer "(define (solve-care A B Q R max-iter) (let* ((n (matrix-rows A)) (At (matrix-transpose A)) (Bt (matrix-transpose B)) (R-inv (matrix-inverse R)) (BRinvBt (matrix-mul B (matrix-mul R-inv Bt))) (P Q) (use-direct? (< n 15))) (let loop ((P P) (iter 0)) (if (>= iter max-iter) P (let* ((AtP (matrix-mul At P)) (PA (matrix-mul P A)) (PBRP (matrix-mul P (matrix-mul BRinvBt P))) (residual (matrix-add (matrix-add AtP PA) (matrix-sub Q PBRP))) (norm (matrix-frobenius-norm-local residual))) (if (< norm 1e-10) P (let* ((A-mod (matrix-sub A (matrix-mul BRinvBt P))) (dP (if use-direct? (lyapunov-solve A-mod residual) (lyapunov-solve-iterative A-mod residual 100))) (P-new (matrix-add P dP))) (loop P-new (+ iter 1)))))))))"))
(task-entry (id "control-systems/digital-pid/pid-simulate-antiwindup") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22626) (name pid-simulate-antiwindup) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune cohen-coon-tune pid-simulate)) (answer "(define (pid-simulate-antiwindup pid state setpoint measurements out-min out-max) (let loop ((state state) (ms measurements) (outputs '()) (errors '())) (if (null? ms) (cons (reverse outputs) (reverse errors)) (let* ((pv (car ms)) (error (- setpoint pv)) (result (pid-step-antiwindup pid state error out-min out-max)) (output (car result)) (new-state (cdr result))) (loop new-state (cdr ms) (cons output outputs) (cons error errors))))))"))
(task-entry (id "control-systems/hinf-synthesis/matrix-psd-project") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22626) (name matrix-psd-project) (type "Matrix → Matrix") (description "Project matrix onto positive semi-definite cone.\n  Uses eigendecomposition: M = V D V', clamp D to D' = max(D,0), return V D' V'.\n  This is the nearest PSD matrix in Frobenius norm.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf)) (answer "(define (matrix-psd-project M) (let* ((n (matrix-rows M))) (if (= n 0) M (let* ((M-sym (matrix-scale 0.5 (matrix-add M (matrix-transpose M)))) (eigen-result (symmetric-eigen M-sym 200 1e-12))) (if (and (pair? eigen-result) (eq? (car eigen-result) 'error)) (matrix-psd-project-simple M-sym) (let* ((eigenvalues (car eigen-result)) (eigenvectors (cdr eigen-result)) (D-clamped (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((ev (vector-ref eigenvalues i))) (matrix-set! D-clamped i i (max 0 ev)))) (let* ((Vt (matrix-transpose eigenvectors)) (V-D (matrix-mul eigenvectors D-clamped))) (matrix-mul V-D Vt))))))))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-square-free-factorization") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22626) (name alg-poly-square-free-factorization) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative)) (answer "(define (alg-poly-square-free-factorization p) (if (alg-poly-zero? p) '() (let* ((F (alg-poly-field p)) (p-deriv (alg-poly-derivative p)) (g (alg-poly-gcd p p-deriv))) (if (<= (alg-poly-degree g) 0) (list (cons p 1)) (let ((q (alg-poly-div p g))) (alg-sqf-iter q g 1 '()))))))"))
(task-entry (id "control-systems/state-space/ss-observability-gramian-finite") (skill control-systems) (module state-space) (tier 2) (difficulty 22627) (name ss-observability-gramian-finite) (type "(-> SS Nat Matrix)") (description "Compute finite-horizon observability Gramian by direct sum. Wo = sum_{k=0}^{N-1} (A')^k * C' * C * A^k") (notes ()) (section gramians) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable? ss-controllability-gramian-finite)) (answer "(define (ss-observability-gramian-finite sys N) (let* ((A (ss-A sys)) (C (ss-C sys)) (n (ss-order sys)) (Wo (make-matrix n n 0)) (At (matrix-transpose A)) (Ct (matrix-transpose C))) (let loop ((k 0) (Ak (matrix-identity n)) (Atk (matrix-identity n))) (if (>= k N) Wo (let* ((CtC (matrix-mul Ct C)) (term (matrix-mul Atk (matrix-mul CtC Ak)))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! Wo i j (+ (matrix-ref Wo i j) (matrix-ref term i j))))) (loop (+ k 1) (matrix-mul Ak A) (matrix-mul Atk At)))))))"))
(task-entry (id "control-systems/transfer-function/tf-stable?") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22627) (name tf-stable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase tf-phase-deg tf-bode-data tf-series tf-parallel tf-feedback tf-unity-feedback)) (answer "(define (tf-stable? tf) (let ((poles (tf-poles tf))) (if (pair? poles) (and (list? poles) (andmap (lambda (p) (< (complex-real p) 0)) poles)) #t)))"))
(task-entry (id "control-systems/z-transform/dss->dtf") (skill control-systems) (module z-transform) (tier 2) (difficulty 22627) (name dss->dtf) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes)) (answer "(define (dss->dtf dsys) (let* ((A (dss-A dsys)) (B (dss-B dsys)) (C (dss-C dsys)) (D (dss-D dsys)) (Ts (dss-Ts dsys)) (n (dss-order dsys))) (if (= n 0) (dtf-from-lists (list (matrix-ref D 0 0)) (list 1) Ts) (let* ((char-poly (compute-char-poly A n)) (num-poly (compute-dtf-numerator A B C D n char-poly))) (make-dtf num-poly char-poly Ts)))))"))
(task-entry (id "control-systems/stability/phase-margin") (skill control-systems) (module stability) (tier 2) (difficulty 22627) (name phase-margin) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin)) (answer "(define (phase-margin tf) (let* ((w-test (logspace -2 4 1000)) (mags (tf-magnitude tf w-test)) (phases (tf-phase tf w-test)) (gc-result (find-crossover-value mags 1 w-test))) (if gc-result (let* ((w-gc (car gc-result)) (idx (cdr gc-result)) (phase-at-gc (vector-ref phases idx)) (pm-rad (+ pi phase-at-gc)) (pm-deg (* pm-rad (/ 180 pi)))) (list pm-deg w-gc)) (list 'infinite 0))))"))
(task-entry (id "control-systems/controller-design/kronecker-product") (skill control-systems) (module controller-design) (tier 2) (difficulty 22627) (name kronecker-product) (type "Matrix × Matrix → Matrix") (description "Compute Kronecker product A ⊗ B. Direct Lyapunov equation solver: Solves A'X + XA = -Q using vectorization (I ⊗ A' + A' ⊗ I) vec(X) = -vec(Q). This is O(n^6) but numerically stable, suitable for n < 20") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care)) (answer "(define (kronecker-product A B) (let* ((pa (matrix-rows A)) (qa (matrix-cols A)) (pb (matrix-rows B)) (qb (matrix-cols B)) (result (make-matrix (* pa pb) (* qa qb) 0))) (do ((i 0 (+ i 1))) ((= i pa) result) (do ((j 0 (+ j 1))) ((= j qa)) (let ((a-ij (matrix-ref A i j))) (do ((k 0 (+ k 1))) ((= k pb)) (do ((l 0 (+ l 1))) ((= l qb)) (matrix-set! result (+ (* i pb) k) (+ (* j qb) l) (* a-ij (matrix-ref B k l))))))))))"))
(task-entry (id "control-systems/digital-pid/make-velocity-pid-state") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22627) (name make-velocity-pid-state) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune cohen-coon-tune pid-simulate pid-simulate-antiwindup)) (answer "(define (make-velocity-pid-state) (list 'velocity-pid-state 0 0 0))"))
(task-entry (id "control-systems/hinf-synthesis/matrix-psd-project-simple") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22627) (name matrix-psd-project-simple) (type "Matrix → Matrix") (description "Simple fallback PSD projection: clamp diagonal to non-negative.\n  This is a crude approximation used when eigendecomposition fails.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project)) (answer "(define (matrix-psd-project-simple M) (let* ((n (matrix-rows M)) (result (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i n) result) (do ((j 0 (+ j 1))) ((= j n)) (let ((val (matrix-ref M i j))) (matrix-set! result i j (if (and (= i j) (< val 0)) 0 val)))))))"))
(task-entry (id "control-systems/poly-algebra/alg-sqf-iter") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22627) (name alg-sqf-iter) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization)) (answer "(define (alg-sqf-iter a c k factors) (let ((F (alg-poly-field a))) (if (<= (alg-poly-degree a) 0) (reverse factors) (let* ((g (alg-poly-gcd a c)) (new-a (alg-poly-div a g)) (new-c (alg-poly-div c g)) (new-factors (if (> (alg-poly-degree new-a) 0) (cons (cons new-a k) factors) factors))) (alg-sqf-iter g new-c (+ k 1) new-factors)))))"))
(task-entry (id "control-systems/state-space/matrix-rank-svd") (skill control-systems) (module state-space) (tier 2) (difficulty 22628) (name matrix-rank-svd) (type "(-> Matrix Num Nat)") (description "Compute numerical rank using SVD (gold standard). Counts singular values that exceed tolerance.") (notes ()) (section matrix-rank) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable? ss-controllability-gramian-finite ss-observability-gramian-finite)) (answer "(define (matrix-rank-svd m tolerance) (guard (e (else (matrix-rank-qr m tolerance))) (let ((svd-result (svd m))) (if (and (pair? svd-result) (eq? (car svd-result) 'error)) (matrix-rank-qr m tolerance) (let* ((sigma (cadr svd-result)) (min-dim (min (matrix-rows sigma) (matrix-cols sigma)))) (let count ((i 0) (rank 0)) (if (>= i min-dim) rank (if (> (abs (matrix-ref sigma i i)) tolerance) (count (+ i 1) (+ rank 1)) (count (+ i 1) rank)))))))))"))
(task-entry (id "control-systems/transfer-function/tf-pole-real-parts") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22628) (name tf-pole-real-parts) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase tf-phase-deg tf-bode-data tf-series tf-parallel tf-feedback tf-unity-feedback tf-stable?)) (answer "(define (tf-pole-real-parts tf) (map complex-real (tf-poles tf)))"))
(task-entry (id "control-systems/z-transform/compute-char-poly") (skill control-systems) (module z-transform) (tier 2) (difficulty 22628) (name compute-char-poly) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf)) (answer "(define (compute-char-poly A n) (let ((coeffs (make-vector (+ n 1) 0))) (vector-set! coeffs 0 1) (let loop ((k 1) (M (matrix-identity n))) (if (> k n) (make-poly coeffs) (let* ((AM (matrix-mul A M)) (p-k (/ (- (matrix-trace-local AM)) k)) (M-next (if (= k n) (make-matrix n n 0) (matrix-add AM (matrix-scale p-k (matrix-identity n)))))) (vector-set! coeffs k p-k) (if (= k n) (make-poly coeffs) (loop (+ k 1) M-next)))))))"))
(task-entry (id "control-systems/stability/stability-margins") (skill control-systems) (module stability) (tier 2) (difficulty 22628) (name stability-margins) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin)) (answer "(define (stability-margins tf) (let ((gm-result (gain-margin tf)) (pm-result (phase-margin tf))) (list (car gm-result) (car pm-result) (cadr gm-result) (cadr pm-result))))"))
(task-entry (id "control-systems/controller-design/matrix-vec") (skill control-systems) (module controller-design) (tier 2) (difficulty 22628) (name matrix-vec) (type "Matrix → Vector") (description "Vectorize matrix column-major: vec([a1 a2 ... an]) = [a1; a2; ...; an]") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product)) (answer "(define (matrix-vec M) (let* ((rows (matrix-rows M)) (cols (matrix-cols M)) (result (make-vector (* rows cols) 0))) (do ((j 0 (+ j 1))) ((= j cols) result) (do ((i 0 (+ i 1))) ((= i rows)) (vector-set! result (+ (* j rows) i) (matrix-ref M i j))))))"))
(task-entry (id "control-systems/digital-pid/velocity-pid-state?") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22628) (name velocity-pid-state?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune cohen-coon-tune pid-simulate pid-simulate-antiwindup make-velocity-pid-state)) (answer "(define (velocity-pid-state? x) (and (pair? x) (eq? (car x) 'velocity-pid-state) (= (length x) 4)))"))
(task-entry (id "control-systems/hinf-synthesis/spectral-radius") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22628) (name spectral-radius) (type "Matrix → Number") (description "Compute spectral radius (maximum |eigenvalue|)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple)) (answer "(define (spectral-radius M) (let* ((n (matrix-rows M))) (cond ((= n 0) 0) ((= n 1) (abs (matrix-ref M 0 0))) (else (let ((eigs (qr-algorithm-shifted M 100 1e-10))) (cond ((and (pair? eigs) (eq? (car eigs) 'error)) (matrix-frobenius-norm-hinf M)) ((vector? eigs) (let loop ((i 0) (max-mag 0)) (if (>= i (vector-length eigs)) max-mag (let* ((ev (vector-ref eigs i)) (mag (if (number? ev) (abs ev) (complex-magnitude ev)))) (loop (+ i 1) (if (> mag max-mag) mag max-mag)))))) ((pair? eigs) (let loop ((es eigs) (max-mag 0)) (if (null? es) max-mag (let ((mag (complex-magnitude (car es)))) (loop (cdr es) (if (> mag max-mag) mag max-mag)))))) (else (matrix-frobenius-norm-hinf M))))))))"))
(task-entry (id "control-systems/poly-algebra/alg-poly->string") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22628) (name alg-poly->string) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter)) (answer "(define (alg-poly->string p var) (let* ((coeffs (alg-poly-coeffs p)) (n (length coeffs)) (var-str (symbol->string var))) (if (= n 0) \"0\" (let loop ((i 0) (first? #t) (acc \"\")) (if (>= i n) (if (string=? acc \"\") \"0\" acc) (let ((c (list-ref coeffs i))) (if (= c 0) (loop (+ i 1) first? acc) (let* ((sign (if (< c 0) \" - \" (if first? \"\" \" + \"))) (abs-c (abs c)) (coeff-str (if (and (= abs-c 1) (> i 0)) \"\" (number->string abs-c))) (power-str (cond ((= i 0) \"\") ((= i 1) var-str) (else (string-append var-str \"^\" (number->string i))))) (term (string-append sign coeff-str (if (and (not (string=? coeff-str \"\")) (not (string=? power-str \"\"))) \"*\" \"\") power-str))) (loop (+ i 1) #f (string-append acc term))))))))))"))
(task-entry (id "control-systems/state-space/matrix-rank-qr") (skill control-systems) (module state-space) (tier 2) (difficulty 22629) (name matrix-rank-qr) (type "(-> Matrix Num Nat)") (description "Compute numerical rank using QR decomposition (faster but less robust). Counts diagonal elements of R that exceed tolerance.") (notes ()) (section matrix-rank) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable? ss-controllability-gramian-finite ss-observability-gramian-finite matrix-rank-svd)) (answer "(define (matrix-rank-qr m tolerance) (let ((qr-result (matrix-qr m))) (if (and (pair? qr-result) (eq? (car qr-result) 'error)) 0 (let* ((R (cadr qr-result)) (min-dim (min (matrix-rows R) (matrix-cols R)))) (let count ((i 0) (rank 0)) (if (>= i min-dim) rank (if (> (abs (matrix-ref R i i)) tolerance) (count (+ i 1) (+ rank 1)) (count (+ i 1) rank))))))))"))
(task-entry (id "control-systems/transfer-function/tf->string") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22629) (name tf->string) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase tf-phase-deg tf-bode-data tf-series tf-parallel tf-feedback tf-unity-feedback tf-stable? tf-pole-real-parts)) (answer "(define (tf->string tf) (let ((num-str (poly->string (tf-num tf))) (den-str (poly->string (tf-den tf)))) (string-append \"(\" num-str \") / (\" den-str \")\")))"))
(task-entry (id "control-systems/z-transform/compute-dtf-numerator") (skill control-systems) (module z-transform) (tier 2) (difficulty 22629) (name compute-dtf-numerator) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly)) (answer "(define (compute-dtf-numerator A B C D n char-poly) (let* ((b-col (matrix-column-v B 0)) (c-row (matrix-row-v C 0)) (d-val (matrix-ref D 0 0)) (char-coeffs (poly-coeffs char-poly)) (num-len (+ n 1)) (result (make-vector num-len 0))) (do ((i 0 (+ i 1))) ((= i num-len)) (vector-set! result i (* d-val (vector-ref char-coeffs i)))) (let loop ((k 0) (M (matrix-identity n))) (if (> k (- n 1)) (make-poly result) (let* ((CB (dot-product-local c-row (matrix-vec-mul-local M b-col))) (coeff-idx (+ 1 k))) (when (< coeff-idx num-len) (vector-set! result coeff-idx (+ (vector-ref result coeff-idx) CB))) (if (= k (- n 1)) (make-poly result) (let* ((AM (matrix-mul A M)) (p-k (vector-ref char-coeffs (+ k 1))) (M-next (matrix-add AM (matrix-scale p-k (matrix-identity n))))) (loop (+ k 1) M-next))))))))"))
(task-entry (id "control-systems/stability/find-crossover") (skill control-systems) (module stability) (tier 2) (difficulty 22629) (name find-crossover) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins)) (answer "(define (find-crossover signal threshold freqs) (let ((n (vector-length signal))) (let loop ((i 0)) (if (>= i (- n 1)) #f (let ((v1 (vector-ref signal i)) (v2 (vector-ref signal (+ i 1)))) (if (and (<= (min v1 v2) threshold) (>= (max v1 v2) threshold)) (let* ((t (/ (- threshold v1) (- v2 v1))) (w1 (vector-ref freqs i)) (w2 (vector-ref freqs (+ i 1))) (w (+ w1 (* t (- w2 w1))))) (cons w i)) (loop (+ i 1))))))))"))
(task-entry (id "control-systems/controller-design/matrix-unvec") (skill control-systems) (module controller-design) (tier 2) (difficulty 22629) (name matrix-unvec) (type "Vector × Nat × Nat → Matrix") (description "Inverse of vec: reshape vector to m×n matrix (column-major)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec)) (answer "(define (matrix-unvec v m n) (let ((result (make-matrix m n 0))) (do ((j 0 (+ j 1))) ((= j n) result) (do ((i 0 (+ i 1))) ((= i m)) (matrix-set! result i j (vector-ref v (+ (* j m) i)))))))"))
(task-entry (id "control-systems/digital-pid/vpid-prev-error") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22629) (name vpid-prev-error) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune cohen-coon-tune pid-simulate pid-simulate-antiwindup make-velocity-pid-state velocity-pid-state?)) (answer "(define (vpid-prev-error state) (cadr state))"))
(task-entry (id "control-systems/hinf-synthesis/hinf-construct-controller") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22629) (name hinf-construct-controller) (type "Matrix^5 × Matrix × Matrix × Number → SS") (description "Construct H-infinity controller from Riccati solutions.\n  K: state-space controller (Ak, Bk, Ck, Dk)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius)) (answer "(define (hinf-construct-controller A B1 B2 C1 C2 X Y gamma) (let* ((n (matrix-rows A)) (nu (matrix-cols B2)) (ny (matrix-rows C2)) (gamma2 (* gamma gamma)) (gamma2-inv (/ 1 gamma2)) (B2t (matrix-transpose B2)) (F (matrix-mul B2t X)) (C2t (matrix-transpose C2)) (L (matrix-mul Y C2t)) (I (matrix-identity n)) (YX (matrix-mul Y X)) (I-g2YX (matrix-sub I (matrix-scale gamma2-inv YX))) (Z (matrix-inverse I-g2YX))) (if (and (pair? Z) (eq? (car Z) 'error)) '(error coupling-matrix-singular) (let* ((B1B1tX (matrix-mul (matrix-mul B1 (matrix-transpose B1)) X)) (B2F (matrix-mul B2 F)) (ZL (matrix-mul Z L)) (ZLC2 (matrix-mul ZL C2)) (Ak (matrix-sub (matrix-add A (matrix-scale gamma2-inv B1B1tX)) (matrix-add B2F ZLC2))) (Bk ZL) (Ck (matrix-scale -1 F)) (Dk (make-matrix nu ny 0))) (list 'ok (make-ss Ak Bk Ck Dk))))))"))
(task-entry (id "control-systems/poly-algebra/num-poly-coeffs") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22629) (name num-poly-coeffs) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string)) (answer "(define (num-poly-coeffs p) (cadr p))"))
(task-entry (id "control-systems/state-space/matrix-rank") (skill control-systems) (module state-space) (tier 2) (difficulty 22630) (name matrix-rank) (type "(-> Matrix Num Nat)") (description "Compute numerical rank. Uses SVD for robustness.") (notes ()) (section matrix-rank) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable? ss-controllability-gramian-finite ss-observability-gramian-finite matrix-rank-svd matrix-rank-qr)) (answer "(define (matrix-rank m tolerance) (matrix-rank-svd m tolerance))"))
(task-entry (id "control-systems/transfer-function/log10") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22630) (name log10) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase tf-phase-deg tf-bode-data tf-series tf-parallel tf-feedback tf-unity-feedback tf-stable? tf-pole-real-parts tf->string)) (answer "(define (log10 x) (/ (log x) (log 10)))"))
(task-entry (id "control-systems/z-transform/dtf->dss") (skill control-systems) (module z-transform) (tier 2) (difficulty 22630) (name dtf->dss) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator)) (answer "(define (dtf->dss dtf) (let* ((num (dtf-num dtf)) (den (dtf-den dtf)) (Ts (dtf-Ts dtf)) (n (poly-degree den)) (m (poly-degree num))) (cond ((= n 0) (let ((gain (/ (poly-leading num) (poly-leading den)))) (make-dss (make-matrix 0 0 0) (make-matrix 0 1 0) (make-matrix 1 0 0) (make-matrix 1 1 gain) Ts))) (else (dtf->dss-controllable num den Ts n m)))))"))
(task-entry (id "control-systems/stability/find-crossover-value") (skill control-systems) (module stability) (tier 2) (difficulty 22630) (name find-crossover-value) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover)) (answer "(define (find-crossover-value signal target freqs) (let ((n (vector-length signal))) (let loop ((i 0)) (if (>= i (- n 1)) #f (let ((v1 (vector-ref signal i)) (v2 (vector-ref signal (+ i 1)))) (if (or (and (<= v1 target) (>= v2 target)) (and (>= v1 target) (<= v2 target))) (let* ((t (/ (- target v1) (- v2 v1))) (w1 (vector-ref freqs i)) (w2 (vector-ref freqs (+ i 1))) (w (+ w1 (* t (- w2 w1))))) (cons w i)) (loop (+ i 1))))))))"))
(task-entry (id "control-systems/controller-design/lyapunov-solve") (skill control-systems) (module controller-design) (tier 2) (difficulty 22630) (name lyapunov-solve) (type "Matrix × Matrix → Matrix") (description "Solve continuous Lyapunov equation: A'X + XA = -Q. Uses direct vectorization method for stability") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec)) (answer "(define (lyapunov-solve A Q) (let* ((n (matrix-rows A)) (At (matrix-transpose A)) (I (matrix-identity n)) (kron1 (kronecker-product I At)) (kron2 (kronecker-product At I)) (coeff (matrix-add kron1 kron2)) (rhs-vec (matrix-vec Q)) (rhs (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i (* n n))) (vector-set! rhs i (- (vector-ref rhs-vec i)))) (let* ((rhs-mat (make-matrix (* n n) 1 0))) (do ((i 0 (+ i 1))) ((= i (* n n))) (matrix-set! rhs-mat i 0 (vector-ref rhs i))) (let ((x-mat (matrix-solve-lu coeff rhs-mat))) (if (and (pair? x-mat) (eq? (car x-mat) 'error)) (lyapunov-solve-iterative A Q 1000) (let ((x-vec (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i (* n n))) (vector-set! x-vec i (matrix-ref x-mat i 0))) (matrix-unvec x-vec n n)))))))"))
(task-entry (id "control-systems/digital-pid/vpid-prev-prev-error") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22630) (name vpid-prev-prev-error) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune cohen-coon-tune pid-simulate pid-simulate-antiwindup make-velocity-pid-state velocity-pid-state? vpid-prev-error)) (answer "(define (vpid-prev-prev-error state) (caddr state))"))
(task-entry (id "control-systems/hinf-synthesis/hinf-synthesize") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22630) (name hinf-synthesize) (type "SS × SS × SS × ... → (γ K) | Error") (description "Synthesize H-infinity controller for mixed-sensitivity problem.\n\n  Arguments:\n    plant - the system to control (state-space)\n    W1 - sensitivity weight (low frequency performance)\n    W3 - complementary sensitivity weight (high frequency robustness)\n\n  Optional:\n    'gamma-min num - minimum γ to search (default 0.1)\n    'gamma-max num - maximum γ to search (default 100)\n    'tolerance num - convergence tolerance (default 0.01)\n\n  Returns:\n    (optimal-gamma controller) on success\n    (error ...) on failure\n\n  Example:\n    ;; First-order plant G = 1/(s+1)\n    (define G (tf->ss (tf-from-lists '(1) '(1 1))))\n    ;; Weight: W1 = (s+0.1)/(s+10) boosts low freq\n    (define W1 (tf->ss (tf-from-lists '(1 0.1) '(1 10))))\n    ;; Weight: W3 = 0.5 (constant)\n    (define W3 (ss-scalar 0 0 0 0.5))\n    (hinf-synthesize G W1 W3)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller)) (answer "(define (hinf-synthesize plant W1 W3 . opts) (let* ((gamma-min (get-opt opts 'gamma-min 0.1)) (gamma-max (get-opt opts 'gamma-max 100)) (tolerance (get-opt opts 'tolerance 0.01)) (max-iter (get-opt opts 'max-iter 50)) (gp (hinf-mixed-sensitivity-plant plant W1 W3))) (if (and (pair? gp) (eq? (car gp) 'error)) gp (hinf-gamma-iteration gp gamma-min gamma-max tolerance max-iter))))"))
(task-entry (id "control-systems/poly-algebra/Q-field") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22630) (name Q-field) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs)) (answer "(define Q-field (make-field '() + * 0 1 - (lambda (a b) (/ a b)) =))"))
(task-entry (id "control-systems/state-space/ss-transform") (skill control-systems) (module state-space) (tier 2) (difficulty 22631) (name ss-transform) (type "(-> SS Matrix Matrix SS)") (description "Apply similarity transformation: new states z = T⁻¹x. Returns transformed system (T⁻¹AT, T⁻¹B, CT, D)") (notes ()) (section modal-decomposition) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable? ss-controllability-gramian-finite ss-observability-gramian-finite matrix-rank-svd matrix-rank-qr matrix-rank)) (answer "(define (ss-transform sys T T-inv) (let ((A (ss-A sys)) (B (ss-B sys)) (C (ss-C sys)) (D (ss-D sys))) (make-ss (matrix-mul T-inv (matrix-mul A T)) (matrix-mul T-inv B) (matrix-mul C T) D)))"))
(task-entry (id "control-systems/transfer-function/pi") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22631) (name pi) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase tf-phase-deg tf-bode-data tf-series tf-parallel tf-feedback tf-unity-feedback tf-stable? tf-pole-real-parts tf->string log10)) (answer "(define pi 3.141592653589793)"))
(task-entry (id "control-systems/z-transform/dtf->dss-controllable") (skill control-systems) (module z-transform) (tier 2) (difficulty 22631) (name dtf->dss-controllable) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss)) (answer "(define (dtf->dss-controllable num den Ts n m) (let* ((den-coeffs (poly-coeffs den)) (num-coeffs (poly-coeffs num)) (num-padded (pad-poly-coeffs-local num-coeffs (+ n 1))) (b-n (vector-ref num-padded 0)) (A (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i (- n 1))) (matrix-set! A i (+ i 1) 1)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! A (- n 1) j (- (vector-ref den-coeffs (- n j))))) (let ((B (make-matrix n 1 0))) (matrix-set! B (- n 1) 0 1) (let ((C (make-matrix 1 n 0))) (do ((j 0 (+ j 1))) ((= j n)) (let* ((b-j (vector-ref num-padded (- n j))) (a-j (vector-ref den-coeffs (- n j))) (c-j (- b-j (* a-j b-n)))) (matrix-set! C 0 j c-j))) (let ((D (make-matrix 1 1 b-n))) (make-dss A B C D Ts))))))"))
(task-entry (id "control-systems/stability/bibo-stable?") (skill control-systems) (module stability) (tier 2) (difficulty 22631) (name bibo-stable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value)) (answer "(define (bibo-stable? tf) (tf-stable? tf))"))
(task-entry (id "control-systems/controller-design/matrix-solve-lu") (skill control-systems) (module controller-design) (tier 2) (difficulty 22631) (name matrix-solve-lu) (type "Matrix × Matrix → Matrix | Error") (description "Solve A*X = B using LU decomposition") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve)) (answer "(define (matrix-solve-lu A B) (guard (e (else (quasiquote (error lu-solve-failed)))) (let ((lu-result (matrix-lu A))) (if (and (pair? lu-result) (eq? (car lu-result) 'error)) lu-result (let* ((L (car lu-result)) (U (cadr lu-result)) (P (caddr lu-result)) (Pb (matrix-mul P B)) (Y (forward-sub L Pb)) (X (back-sub U Y))) X)))))"))
(task-entry (id "control-systems/digital-pid/vpid-prev-output") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22631) (name vpid-prev-output) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune cohen-coon-tune pid-simulate pid-simulate-antiwindup make-velocity-pid-state velocity-pid-state? vpid-prev-error vpid-prev-prev-error)) (answer "(define (vpid-prev-output state) (cadddr state))"))
(task-entry (id "control-systems/hinf-synthesis/get-opt") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22631) (name get-opt) (type "(List Any) × Symbol × Any → Any") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize)) (answer "(define (get-opt opts key default) (let loop ((lst opts)) (cond ((null? lst) default) ((null? (cdr lst)) default) ((eq? (car lst) key) (cadr lst)) (else (loop (cddr lst))))))"))
(task-entry (id "control-systems/poly-algebra/numeric->algebra-poly") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22631) (name numeric->algebra-poly) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field)) (answer "(define (numeric->algebra-poly p field) (let* ((coeffs (num-poly-coeffs p)) (n (vector-length coeffs)) (ascending-coeffs (let loop ((i 0) (acc '())) (if (>= i n) acc (loop (+ i 1) (cons (vector-ref coeffs i) acc)))))) (alg-make-polynomial field ascending-coeffs)))"))
(task-entry (id "control-systems/state-space/ss-identity-output") (skill control-systems) (module state-space) (tier 2) (difficulty 22632) (name ss-identity-output) (type "(-> Matrix Matrix SS)") (description "Create a system with identity C (full state output) and no feedthrough") (notes ()) (section common-forms) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable? ss-controllability-gramian-finite ss-observability-gramian-finite matrix-rank-svd matrix-rank-qr matrix-rank ss-transform)) (answer "(define (ss-identity-output A B) (let* ((n (matrix-rows A)) (m (matrix-cols B)) (C (matrix-identity n)) (D (make-matrix n m 0))) (make-ss A B C D)))"))
(task-entry (id "control-systems/z-transform/dtf->string") (skill control-systems) (module z-transform) (tier 2) (difficulty 22632) (name dtf->string) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable)) (answer "(define (dtf->string dtf) (let ((num-str (poly->string-z (dtf-num dtf))) (den-str (poly->string-z (dtf-den dtf))) (Ts (dtf-Ts dtf))) (string-append \"(\" num-str \") / (\" den-str \"), Ts=\" (number->string Ts))))"))
(task-entry (id "control-systems/stability/bibo-stable-discrete?") (skill control-systems) (module stability) (tier 2) (difficulty 22632) (name bibo-stable-discrete?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable?)) (answer "(define (bibo-stable-discrete? tf) (let ((poles (tf-poles tf))) (discrete-stable? poles)))"))
(task-entry (id "control-systems/controller-design/forward-sub") (skill control-systems) (module controller-design) (tier 2) (difficulty 22632) (name forward-sub) (type "Matrix × Matrix → Matrix") (description "Solve L*Y = B for lower triangular L") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu)) (answer "(define (forward-sub L B) (let* ((n (matrix-rows L)) (m (matrix-cols B)) (Y (make-matrix n m 0))) (do ((j 0 (+ j 1))) ((= j m) Y) (do ((i 0 (+ i 1))) ((= i n)) (let* ((sum (let loop ((k 0) (acc 0)) (if (>= k i) acc (loop (+ k 1) (+ acc (* (matrix-ref L i k) (matrix-ref Y k j))))))) (diag (matrix-ref L i i)) (val (/ (- (matrix-ref B i j) sum) (if (zero? diag) 1e-10 diag)))) (matrix-set! Y i j val))))))"))
(task-entry (id "control-systems/digital-pid/pid-step-velocity") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22632) (name pid-step-velocity) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune cohen-coon-tune pid-simulate pid-simulate-antiwindup make-velocity-pid-state velocity-pid-state? vpid-prev-error vpid-prev-prev-error vpid-prev-output)) (answer "(define (pid-step-velocity pid state error) (let* ((Kp (pid-Kp pid)) (Ki (pid-Ki pid)) (Kd (pid-Kd pid)) (Ts (pid-Ts pid)) (e0 error) (e1 (vpid-prev-error state)) (e2 (vpid-prev-prev-error state)) (u-prev (vpid-prev-output state)) (delta-P (* Kp (- e0 e1))) (delta-I (* Ki Ts e0)) (delta-D (* (/ Kd Ts) (+ e0 (* -2 e1) e2))) (delta-u (+ delta-P delta-I delta-D)) (output (+ u-prev delta-u)) (new-state (list 'velocity-pid-state e0 e1 output))) (cons output new-state)))"))
(task-entry (id "control-systems/hinf-synthesis/hinf-weight-first-order") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22632) (name hinf-weight-first-order) (type "Number × Number × Number → SS") (description "Create first-order weighting function.\n  W(s) = (s/M + wc) / (s + wc*A)\n  where dc = 1/A is DC gain, hf = M is high-freq gain, wc is crossover.\n\n  Simplified form: W(s) = (hf*s + dc*wc) / (s + wc*dc/hf)\n\n  For sensitivity weight W1: dc large (good tracking), hf small\n  For comp-sensitivity weight W3: dc small, hf large (roll-off)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt)) (answer "(define (hinf-weight-first-order dc hf wc) (let* ((A (/ 1 dc)) (M hf) (num-coeffs (list (/ 1 M) wc)) (den-coeffs (list 1 (* wc A))) (tf-w (tf-from-lists num-coeffs den-coeffs))) (tf->ss tf-w)))"))
(task-entry (id "control-systems/poly-algebra/algebra->numeric-poly") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22632) (name algebra->numeric-poly) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly)) (answer "(define (algebra->numeric-poly ap) (let* ((coeffs (alg-poly-coeffs ap)) (n (length coeffs)) (desc-vec (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) (make-poly desc-vec)) (vector-set! desc-vec i (list-ref coeffs (- n 1 i))))))"))
(task-entry (id "control-systems/state-space/ss-scalar") (skill control-systems) (module state-space) (tier 2) (difficulty 22633) (name ss-scalar) (type "(-> Num Num Num Num SS)") (description "Create a first-order scalar system. x' = a*x + b*u, y = c*x + d*u") (notes ()) (section common-forms) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable? ss-controllability-gramian-finite ss-observability-gramian-finite matrix-rank-svd matrix-rank-qr matrix-rank ss-transform ss-identity-output)) (answer "(define (ss-scalar a b c d) (make-ss (matrix-from-lists (list (list a))) (matrix-from-lists (list (list b))) (matrix-from-lists (list (list c))) (matrix-from-lists (list (list d)))))"))
(task-entry (id "control-systems/z-transform/poly->string-z") (skill control-systems) (module z-transform) (tier 2) (difficulty 22633) (name poly->string-z) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable dtf->string)) (answer "(define (poly->string-z p) (let* ((coeffs (poly-coeffs p)) (n (- (vector-length coeffs) 1)) (terms '())) (do ((i 0 (+ i 1))) ((> i n)) (let* ((coeff (vector-ref coeffs i)) (power (- n i))) (when (not (zero? coeff)) (let ((term (cond ((= power 0) (number->string coeff)) ((= power 1) (if (= coeff 1) \"z\" (string-append (number->string coeff) \"*z\"))) (else (if (= coeff 1) (string-append \"z^\" (number->string power)) (string-append (number->string coeff) \"*z^\" (number->string power))))))) (set! terms (cons term terms)))))) (if (null? terms) \"0\" (string-join (reverse terms) \" + \"))))"))
(task-entry (id "control-systems/stability/controllability-matrix") (skill control-systems) (module stability) (tier 2) (difficulty 22633) (name controllability-matrix) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete?)) (answer "(define (controllability-matrix sys) (let* ((A (ss-A sys)) (B (ss-B sys)) (n (matrix-rows A)) (m (matrix-cols B)) (cols (build-controllability-cols A B n))) (matrix-hcat-list cols)))"))
(task-entry (id "control-systems/controller-design/back-sub") (skill control-systems) (module controller-design) (tier 2) (difficulty 22633) (name back-sub) (type "Matrix × Matrix → Matrix") (description "Solve U*X = Y for upper triangular U") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub)) (answer "(define (back-sub U Y) (let* ((n (matrix-rows U)) (m (matrix-cols Y)) (X (make-matrix n m 0))) (do ((j 0 (+ j 1))) ((= j m) X) (do ((i (- n 1) (- i 1))) ((< i 0)) (let* ((sum (let loop ((k (+ i 1)) (acc 0)) (if (>= k n) acc (loop (+ k 1) (+ acc (* (matrix-ref U i k) (matrix-ref X k j))))))) (diag (matrix-ref U i i)) (val (/ (- (matrix-ref Y i j) sum) (if (zero? diag) 1e-10 diag)))) (matrix-set! X i j val))))))"))
(task-entry (id "control-systems/digital-pid/pid->string") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22633) (name pid->string) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered pid-reset pid-reset-to ziegler-nichols-tune tyreus-luyben-tune cohen-coon-tune pid-simulate pid-simulate-antiwindup make-velocity-pid-state velocity-pid-state? vpid-prev-error vpid-prev-prev-error vpid-prev-output pid-step-velocity)) (answer "(define (pid->string pid) (let ((Kp (pid-Kp pid)) (Ki (pid-Ki pid)) (Kd (pid-Kd pid)) (Ts (pid-Ts pid))) (string-append \"PID(Kp=\" (number->string Kp) \", Ki=\" (number->string Ki) \", Kd=\" (number->string Kd) \", Ts=\" (number->string Ts) \")\")))"))
(task-entry (id "control-systems/hinf-synthesis/hinf-weight-constant") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22633) (name hinf-weight-constant) (type "Number → SS") (description "Create constant (static) weighting function W(s) = k.\n  Returns a zero-order (static) state-space system with only D matrix.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order)) (answer "(define (hinf-weight-constant k) (make-ss (make-matrix 0 0 0) (make-matrix 0 1 0) (make-matrix 1 0 0) (make-matrix 1 1 k)))"))
(task-entry (id "control-systems/poly-algebra/tf-simplify") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22633) (name tf-simplify) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly)) (answer "(define (tf-simplify tf . opts) (let* ((field (if (null? opts) Q-field (car opts))) (num (tf-num tf)) (den (tf-den tf)) (num-alg (numeric->algebra-poly num field)) (den-alg (numeric->algebra-poly den field)) (gcd-alg (alg-poly-gcd num-alg den-alg))) (if (> (alg-poly-degree gcd-alg) 0) (let* ((num-simplified (algebra->numeric-poly (alg-poly-div num-alg gcd-alg))) (den-simplified (algebra->numeric-poly (alg-poly-div den-alg gcd-alg)))) (make-tf num-simplified den-simplified)) tf)))"))
(task-entry (id "control-systems/state-space/ss-integrator") (skill control-systems) (module state-space) (tier 2) (difficulty 22634) (name ss-integrator) (type "(-> Nat SS)") (description "Create an n-th order integrator chain. x₁' = x₂, x₂' = x₃, ..., xₙ' = u, y = x₁") (notes ()) (section common-forms) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable? ss-controllability-gramian-finite ss-observability-gramian-finite matrix-rank-svd matrix-rank-qr matrix-rank ss-transform ss-identity-output ss-scalar)) (answer "(define (ss-integrator n) (let ((A (make-matrix n n 0)) (B (make-matrix n 1 0)) (C (make-matrix 1 n 0)) (D (make-matrix 1 1 0))) (do ((i 0 (+ i 1))) ((>= i (- n 1))) (matrix-set! A i (+ i 1) 1)) (matrix-set! B (- n 1) 0 1) (matrix-set! C 0 0 1) (make-ss A B C D)))"))
(task-entry (id "control-systems/z-transform/log10") (skill control-systems) (module z-transform) (tier 2) (difficulty 22634) (name log10) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable dtf->string poly->string-z)) (answer "(define (log10 x) (/ (log x) (log 10)))"))
(task-entry (id "control-systems/stability/build-controllability-cols") (skill control-systems) (module stability) (tier 2) (difficulty 22634) (name build-controllability-cols) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix)) (answer "(define (build-controllability-cols A B n) (let loop ((i 0) (Ai-B B) (cols '())) (if (>= i n) (reverse cols) (loop (+ i 1) (matrix-mul A Ai-B) (cons Ai-B cols)))))"))
(task-entry (id "control-systems/controller-design/lyapunov-solve-iterative") (skill control-systems) (module controller-design) (tier 2) (difficulty 22634) (name lyapunov-solve-iterative) (type "Matrix × Matrix × Nat → Matrix") (description "Fallback iterative Lyapunov solver: A'X + XA = -Q. Uses Smith iteration for improved convergence") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub)) (answer "(define (lyapunov-solve-iterative A Q max-iter) (let* ((n (matrix-rows A)) (At (matrix-transpose A)) (X Q)) (let loop ((X X) (iter 0)) (if (>= iter max-iter) X (let* ((AtX (matrix-mul At X)) (XA (matrix-mul X A)) (residual (matrix-add (matrix-add AtX XA) Q)) (norm (matrix-frobenius-norm-local residual))) (if (< norm 1e-10) X (let* ((alpha 0.1) (X-new (matrix-sub X (matrix-scale alpha residual)))) (loop X-new (+ iter 1)))))))))"))
(task-entry (id "control-systems/hinf-synthesis/tf->ss") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22634) (name tf->ss) (type "TF → SS") (description "Convert transfer function to controllable canonical state space.\n  G(s) = (b_m s^m + ... + b_0) / (s^n + a_{n-1} s^{n-1} + ... + a_0)\n\n  Uses controller canonical form:\n  A = | 0  1  0 ... 0 |    B = | 0 |\n      | 0  0  1 ... 0 |        | 0 |\n      | :        :   |        | : |\n      |-a0 -a1 ... -a_{n-1}|  | 1 |\n\n  C = [b0-a0*bm  b1-a1*bm  ...  b_{n-1}-a_{n-1}*bm]\n  D = bm (if m = n) or 0 (if m < n)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant)) (answer "(define (tf->ss tf) (let* ((num (tf-num tf)) (den (tf-den tf)) (num-coeffs (poly-coeffs num)) (den-coeffs (poly-coeffs den)) (n (- (vector-length den-coeffs) 1)) (m (- (vector-length num-coeffs) 1))) (if (< n 1) (let ((gain (/ (vector-ref num-coeffs 0) (vector-ref den-coeffs 0)))) (make-ss (make-matrix 0 0 0) (make-matrix 0 1 0) (make-matrix 1 0 0) (make-matrix 1 1 gain))) (let* ((A (make-matrix n n 0)) (B (make-matrix n 1 0)) (C (make-matrix 1 n 0)) (lead (vector-ref den-coeffs 0)) (a (make-vector n 0)) (b (make-vector (+ n 1) 0))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! a i (/ (vector-ref den-coeffs (- n i)) lead))) (do ((j 0 (+ j 1))) ((> j m)) (let* ((num-idx (- m j)) (coeff (/ (vector-ref num-coeffs num-idx) lead))) (when (< j (+ n 1)) (vector-set! b j coeff)))) (do ((i 0 (+ i 1))) ((= i (- n 1))) (matrix-set! A i (+ i 1) 1)) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! A (- n 1) i (- (vector-ref a i)))) (matrix-set! B (- n 1) 0 1) (let ((d (if (= m n) (vector-ref b n) 0))) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! C 0 i (- (vector-ref b i) (* d (vector-ref a i))))) (let ((D (make-matrix 1 1 d))) (make-ss A B C D)))))))"))
(task-entry (id "control-systems/poly-algebra/tf-simplify-exact") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22634) (name tf-simplify-exact) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify)) (answer "(define (tf-simplify-exact tf) (tf-simplify tf Q-field))"))
(task-entry (id "control-systems/state-space/ss->string") (skill control-systems) (module state-space) (tier 2) (difficulty 22635) (name ss->string) (type "(-> SS String)") (description "Convert state space system to string representation") (notes ()) (section display) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix matrix-column-as-matrix ss-controllable? ss-observability-matrix ss-observable? ss-controllability-gramian-finite ss-observability-gramian-finite matrix-rank-svd matrix-rank-qr matrix-rank ss-transform ss-identity-output ss-scalar ss-integrator)) (answer "(define (ss->string sys) (let ((n (ss-order sys)) (m (ss-inputs sys)) (p (ss-outputs sys))) (string-append \"State-Space System:\n\" \"  Order: \" (number->string n) \"\n\" \"  Inputs: \" (number->string m) \"\n\" \"  Outputs: \" (number->string p))))"))
(task-entry (id "control-systems/z-transform/pi") (skill control-systems) (module z-transform) (tier 2) (difficulty 22635) (name pi) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable dtf->string poly->string-z log10)) (answer "(define pi 3.141592653589793)"))
(task-entry (id "control-systems/stability/matrix-hcat-list") (skill control-systems) (module stability) (tier 2) (difficulty 22635) (name matrix-hcat-list) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols)) (answer "(define (matrix-hcat-list matrices) (if (null? matrices) '(error empty-list) (let* ((rows (matrix-rows (car matrices))) (total-cols (apply + (map matrix-cols matrices))) (result (make-matrix rows total-cols 0))) (let loop ((ms matrices) (col-offset 0)) (if (null? ms) result (let* ((m (car ms)) (m-cols (matrix-cols m))) (do ((i 0 (+ i 1))) ((= i rows)) (do ((j 0 (+ j 1))) ((= j m-cols)) (matrix-set! result i (+ col-offset j) (matrix-ref m i j)))) (loop (cdr ms) (+ col-offset m-cols))))))))"))
(task-entry (id "control-systems/controller-design/matrix-frobenius-norm-local") (skill control-systems) (module controller-design) (tier 2) (difficulty 22635) (name matrix-frobenius-norm-local) (type "Matrix → Number") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative)) (answer "(define (matrix-frobenius-norm-local M) (let* ((rows (matrix-rows M)) (cols (matrix-cols M))) (sqrt (let loop ((i 0) (sum 0)) (if (>= i rows) sum (loop (+ i 1) (+ sum (let inner ((j 0) (row-sum 0)) (if (>= j cols) row-sum (inner (+ j 1) (+ row-sum (expt (matrix-ref M i j) 2))))))))))))"))
(task-entry (id "control-systems/hinf-synthesis/hinf-closed-loop-norm") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22635) (name hinf-closed-loop-norm) (type "SS × SS → Number") (description "Compute H-infinity norm of closed-loop system.\n  Uses frequency gridding for verification.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss)) (answer "(define (hinf-closed-loop-norm plant controller) (let* ((G-tf (ss->tf plant)) (K-tf (ss->tf controller)) (T-tf (closed-loop-tf G-tf K-tf))) (hinf-norm T-tf)))"))
(task-entry (id "control-systems/poly-algebra/routh-array-exact") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22635) (name routh-array-exact) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify tf-simplify-exact)) (answer "(define (routh-array-exact apoly) (let* ((coeffs (alg-poly-coeffs apoly)) (n (length coeffs)) (degree (- n 1))) (if (< n 2) (list (list (if (null? coeffs) 0 (car coeffs)))) (let* ((desc-coeffs (reverse coeffs)) (row1-len (ceiling (/ n 2))) (row1 (make-routh-row desc-coeffs 0 row1-len n)) (row2 (make-routh-row desc-coeffs 1 row1-len n))) (routh-array-exact-iter (list row2 row1) degree)))))"))
(task-entry (id "control-systems/z-transform/matrix-trace-local") (skill control-systems) (module z-transform) (tier 2) (difficulty 22636) (name matrix-trace-local) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable dtf->string poly->string-z log10 pi)) (answer "(define (matrix-trace-local M) (let ((n (min (matrix-rows M) (matrix-cols M)))) (let loop ((i 0) (sum 0)) (if (= i n) sum (loop (+ i 1) (+ sum (matrix-ref M i i)))))))"))
(task-entry (id "control-systems/stability/controllable?") (skill control-systems) (module stability) (tier 2) (difficulty 22636) (name controllable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols matrix-hcat-list)) (answer "(define (controllable? sys) (let* ((C (controllability-matrix sys)) (n (ss-order sys)) (rank (stability-matrix-rank C))) (= rank n)))"))
(task-entry (id "control-systems/controller-design/dlqr") (skill control-systems) (module controller-design) (tier 2) (difficulty 22636) (name dlqr) (type "SS × Matrix × Matrix → (K P eigenvalues) | Error") (description "Compute discrete LQR controller gain. Discrete LQR minimizes: J = sum(x'Qx + u'Ru). Solution: u[k] = -K*x[k] where K = (R + B'PB)^{-1}*B'PA. P satisfies discrete algebraic Riccati equation (DARE): P = A'PA - A'PB(R + B'PB)^{-1}B'PA + Q") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local)) (answer "(define (dlqr sys Q R) (let* ((A (ss-A sys)) (B (ss-B sys)) (n (ss-order sys)) (m (matrix-cols B)) (P (solve-dare A B Q R 1000))) (if (and (pair? P) (eq? (car P) 'error)) P (let* ((Bt (matrix-transpose B)) (BtPB (matrix-mul Bt (matrix-mul P B))) (temp-inv (matrix-inverse (matrix-add R BtPB))) (BtPA (matrix-mul Bt (matrix-mul P A))) (K (matrix-mul temp-inv BtPA)) (Acl (matrix-sub A (matrix-mul B K))) (cl-eigs (if (= n 1) (list (make-complex (matrix-ref Acl 0 0) 0)) (qr-algorithm-shifted Acl 100 1e-10)))) (list K P cl-eigs)))))"))
(task-entry (id "control-systems/hinf-synthesis/ss->tf") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22636) (name ss->tf) (type "SS → TF") (description "Convert state-space to transfer function (SISO only).\n  G(s) = C(sI - A)^-1 B + D\n  Uses characteristic polynomial for denominator.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm)) (answer "(define (ss->tf sys) (let* ((A (ss-A sys)) (B (ss-B sys)) (C (ss-C sys)) (D (ss-D sys)) (n (ss-order sys))) (if (= n 0) (tf-from-lists (list (matrix-ref D 0 0)) '(1)) (let* ((char-poly (characteristic-polynomial A)) (num-poly (ss-numerator-poly sys))) (make-tf num-poly char-poly)))))"))
(task-entry (id "control-systems/poly-algebra/make-routh-row") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22636) (name make-routh-row) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify tf-simplify-exact routh-array-exact)) (answer "(define (make-routh-row coeffs start row-len n) (let loop ((i 0) (acc '())) (if (>= i row-len) (reverse acc) (let ((idx (+ start (* i 2)))) (loop (+ i 1) (cons (if (< idx n) (list-ref coeffs idx) 0) acc))))))"))
(task-entry (id "control-systems/z-transform/matrix-column-v") (skill control-systems) (module z-transform) (tier 2) (difficulty 22637) (name matrix-column-v) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable dtf->string poly->string-z log10 pi matrix-trace-local)) (answer "(define (matrix-column-v M j) (let* ((rows (matrix-rows M)) (result (make-vector rows))) (do ((i 0 (+ i 1))) ((= i rows) result) (vector-set! result i (matrix-ref M i j)))))"))
(task-entry (id "control-systems/stability/observability-matrix") (skill control-systems) (module stability) (tier 2) (difficulty 22637) (name observability-matrix) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols matrix-hcat-list controllable?)) (answer "(define (observability-matrix sys) (let* ((A (ss-A sys)) (C (ss-C sys)) (n (matrix-rows A)) (rows (build-observability-rows C A n))) (matrix-vcat-list rows)))"))
(task-entry (id "control-systems/controller-design/solve-dare") (skill control-systems) (module controller-design) (tier 2) (difficulty 22637) (name solve-dare) (type "Matrix × Matrix × Matrix × Matrix × Nat → Matrix | Error") (description "Solve discrete algebraic Riccati equation using iteration") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local dlqr)) (answer "(define (solve-dare A B Q R max-iter) (let* ((At (matrix-transpose A)) (Bt (matrix-transpose B)) (P Q)) (let loop ((P P) (iter 0)) (if (>= iter max-iter) P (let* ((BtPB (matrix-mul Bt (matrix-mul P B))) (temp-inv (matrix-inverse (matrix-add R BtPB))) (BtPA (matrix-mul Bt (matrix-mul P A))) (K-temp (matrix-mul temp-inv BtPA)) (AtPA (matrix-mul At (matrix-mul P A))) (AtPB-K (matrix-mul (matrix-mul At (matrix-mul P B)) K-temp)) (P-new (matrix-add Q (matrix-sub AtPA AtPB-K))) (diff (matrix-frobenius-norm-local (matrix-sub P-new P)))) (if (< diff 1e-10) P-new (loop P-new (+ iter 1))))))))"))
(task-entry (id "control-systems/hinf-synthesis/ss-numerator-poly") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22637) (name ss-numerator-poly) (type "SS → Poly") (description "Compute numerator polynomial of SISO transfer function.\n  Uses coefficient matching from frequency response samples.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm ss->tf)) (answer "(define (ss-numerator-poly sys) (let* ((A (ss-A sys)) (B (ss-B sys)) (C (ss-C sys)) (D (ss-D sys)) (n (ss-order sys)) (den-poly (characteristic-polynomial A))) (if (= n 0) (make-poly (vector (matrix-ref D 0 0))) (let* ((samples (+ n 1)) (s-vals (map (lambda (k) (make-complex 0 (* k 0.5))) (iota samples))) (G-vals (map (lambda (s) (ss-eval-complex sys s)) s-vals)) (num-vals (map (lambda (s G) (complex-mul G (poly-eval-complex den-poly s))) s-vals G-vals))) (poly-from-complex-samples s-vals num-vals n)))))"))
(task-entry (id "control-systems/poly-algebra/routh-array-exact-iter") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22637) (name routh-array-exact-iter) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify tf-simplify-exact routh-array-exact make-routh-row)) (answer "(define (routh-array-exact-iter rows remaining) (if (<= remaining 0) (reverse rows) (let* ((prev-row (car rows)) (prev-prev-row (cadr rows)) (len (length prev-row))) (if (or (null? prev-row) (null? prev-prev-row)) (reverse rows) (let* ((a (car prev-prev-row)) (b (car prev-row)) (b-safe (if (= b 0) 1/1000000 b)) (new-row (make-routh-new-row prev-prev-row prev-row b-safe len))) (if (null? new-row) (reverse rows) (routh-array-exact-iter (cons new-row rows) (- remaining 1))))))))"))
(task-entry (id "control-systems/z-transform/matrix-row-v") (skill control-systems) (module z-transform) (tier 2) (difficulty 22638) (name matrix-row-v) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable dtf->string poly->string-z log10 pi matrix-trace-local matrix-column-v)) (answer "(define (matrix-row-v M i) (let* ((cols (matrix-cols M)) (result (make-vector cols))) (do ((j 0 (+ j 1))) ((= j cols) result) (vector-set! result j (matrix-ref M i j)))))"))
(task-entry (id "control-systems/stability/build-observability-rows") (skill control-systems) (module stability) (tier 2) (difficulty 22638) (name build-observability-rows) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols matrix-hcat-list controllable? observability-matrix)) (answer "(define (build-observability-rows C A n) (let loop ((i 0) (CAi C) (rows '())) (if (>= i n) (reverse rows) (loop (+ i 1) (matrix-mul CAi A) (cons CAi rows)))))"))
(task-entry (id "control-systems/controller-design/lqg") (skill control-systems) (module controller-design) (tier 2) (difficulty 22638) (name lqg) (type "SS × Matrix × Matrix × Matrix × Matrix → (K L) | Error") (description "Design LQG controller with optimal state estimation. LQG combines LQR state feedback with matrix Kalman filter state estimation. This is the full MATRIX Kalman filter for state-space control systems. (For scalar Kalman filtering, see kalman.ss). Controller: u = -K*x_hat. Estimator: x_hat' = A*x_hat + B*u + L*(y - C*x_hat). Design: 1. Design LQR gain K using Q, R. 2. Design Kalman filter gain L using Qn (process noise), Rn (measurement noise)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local dlqr solve-dare)) (answer "(define (lqg sys Q R Qn Rn) (let* ((lqr-result (lqr sys Q R))) (if (and (pair? lqr-result) (eq? (car lqr-result) 'error)) lqr-result (let ((K (car lqr-result))) (let* ((A (ss-A sys)) (C (ss-C sys)) (n (matrix-rows A)) (At (matrix-transpose A)) (Ct (matrix-transpose C)) (P-filter (solve-care At Ct Qn Rn 1000))) (if (and (pair? P-filter) (eq? (car P-filter) 'error)) P-filter (let* ((Rn-inv (matrix-inverse Rn)) (L (matrix-mul P-filter (matrix-mul Ct Rn-inv)))) (list K L))))))))"))
(task-entry (id "control-systems/hinf-synthesis/ss-eval-complex") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22638) (name ss-eval-complex) (type "SS × Complex → Complex") (description "Evaluate G(s) = C(sI-A)^-1 B + D at complex s") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm ss->tf ss-numerator-poly)) (answer "(define (ss-eval-complex sys s) (let* ((A (ss-A sys)) (B (ss-B sys)) (C (ss-C sys)) (D (ss-D sys)) (n (ss-order sys))) (if (= n 0) (make-complex (matrix-ref D 0 0) 0) (let* ((sI-A (matrix-sub-scalar-diag (matrix-scale-complex s (matrix-identity n)) A)) (C-complex (list C (make-matrix (matrix-rows C) (matrix-cols C) 0))) (B-complex (list B (make-matrix (matrix-rows B) (matrix-cols B) 0))) (inv-result (matrix-inverse-complex sI-A)) (invB (matrix-mul-complex inv-result B-complex)) (CinvB (matrix-mul-complex C-complex invB)) (result (complex-add (matrix-ref-complex CinvB 0 0) (make-complex (matrix-ref D 0 0) 0)))) result))))"))
(task-entry (id "control-systems/poly-algebra/make-routh-new-row") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22638) (name make-routh-new-row) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify tf-simplify-exact routh-array-exact make-routh-row routh-array-exact-iter)) (answer "(define (make-routh-new-row prev-prev-row prev-row b len) (let ((a (car prev-prev-row))) (let loop ((i 0) (acc '())) (if (>= i (- len 1)) (reverse acc) (let* ((c (if (< (+ i 1) len) (list-ref prev-prev-row (+ i 1)) 0)) (d (if (< (+ i 1) len) (list-ref prev-row (+ i 1)) 0)) (val (/ (- (* b c) (* a d)) b))) (loop (+ i 1) (cons val acc)))))))"))
(task-entry (id "control-systems/z-transform/matrix-vec-mul-local") (skill control-systems) (module z-transform) (tier 2) (difficulty 22639) (name matrix-vec-mul-local) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable dtf->string poly->string-z log10 pi matrix-trace-local matrix-column-v matrix-row-v)) (answer "(define (matrix-vec-mul-local M v) (let* ((rows (matrix-rows M)) (cols (matrix-cols M)) (result (make-vector rows 0))) (do ((i 0 (+ i 1))) ((= i rows) result) (let loop ((j 0) (sum 0)) (if (= j cols) (vector-set! result i sum) (loop (+ j 1) (+ sum (* (matrix-ref M i j) (vector-ref v j)))))))))"))
(task-entry (id "control-systems/stability/matrix-vcat-list") (skill control-systems) (module stability) (tier 2) (difficulty 22639) (name matrix-vcat-list) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols matrix-hcat-list controllable? observability-matrix build-observability-rows)) (answer "(define (matrix-vcat-list matrices) (if (null? matrices) '(error empty-list) (let* ((cols (matrix-cols (car matrices))) (total-rows (apply + (map matrix-rows matrices))) (result (make-matrix total-rows cols 0))) (let loop ((ms matrices) (row-offset 0)) (if (null? ms) result (let* ((m (car ms)) (m-rows (matrix-rows m))) (do ((i 0 (+ i 1))) ((= i m-rows)) (do ((j 0 (+ j 1))) ((= j cols)) (matrix-set! result (+ row-offset i) j (matrix-ref m i j)))) (loop (cdr ms) (+ row-offset m-rows))))))))"))
(task-entry (id "control-systems/controller-design/hinf-norm") (skill control-systems) (module controller-design) (tier 2) (difficulty 22639) (name hinf-norm) (type "TF → Number | Error") (description "Compute H-infinity norm of a transfer function. H-infinity control minimizes the H-infinity norm of a closed-loop transfer function, providing robust performance guarantees. The H-infinity norm is: ||G||_inf = sup_w |G(jw)|. Uses bisection on frequency response") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local dlqr solve-dare lqg)) (answer "(define (hinf-norm tf) (let* ((w-test (logspace -4 4 1000)) (mags (tf-magnitude tf w-test)) (max-mag (vector-max mags))) max-mag))"))
(task-entry (id "control-systems/hinf-synthesis/matrix-scale-complex") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22639) (name matrix-scale-complex) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm ss->tf ss-numerator-poly ss-eval-complex)) (answer "(define (matrix-scale-complex s M) (let* ((n (matrix-rows M)) (m (matrix-cols M)) (sr (complex-real s)) (si (complex-imag s)) (result-r (make-matrix n m 0)) (result-i (make-matrix n m 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j m)) (let ((v (matrix-ref M i j))) (matrix-set! result-r i j (* sr v)) (matrix-set! result-i i j (* si v))))) (list result-r result-i)))"))
(task-entry (id "control-systems/poly-algebra/routh-hurwitz-exact") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22639) (name routh-hurwitz-exact) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify tf-simplify-exact routh-array-exact make-routh-row routh-array-exact-iter make-routh-new-row)) (answer "(define (routh-hurwitz-exact p) (let* ((alg-poly (numeric->algebra-poly p Q-field)) (array (routh-array-exact alg-poly)) (first-col (map car array))) (not (has-sign-changes-exact? first-col))))"))
(task-entry (id "control-systems/z-transform/dot-product-local") (skill control-systems) (module z-transform) (tier 2) (difficulty 22640) (name dot-product-local) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable dtf->string poly->string-z log10 pi matrix-trace-local matrix-column-v matrix-row-v matrix-vec-mul-local)) (answer "(define (dot-product-local v1 v2) (let ((n (vector-length v1))) (let loop ((i 0) (sum 0)) (if (= i n) sum (loop (+ i 1) (+ sum (* (vector-ref v1 i) (vector-ref v2 i))))))))"))
(task-entry (id "control-systems/stability/observable?") (skill control-systems) (module stability) (tier 2) (difficulty 22640) (name observable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols matrix-hcat-list controllable? observability-matrix build-observability-rows matrix-vcat-list)) (answer "(define (observable? sys) (let* ((O (observability-matrix sys)) (n (ss-order sys)) (rank (stability-matrix-rank O))) (= rank n)))"))
(task-entry (id "control-systems/controller-design/vector-max") (skill control-systems) (module controller-design) (tier 2) (difficulty 22640) (name vector-max) (type "Vector → Number") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local dlqr solve-dare lqg hinf-norm)) (answer "(define (vector-max v) (let ((n (vector-length v))) (let loop ((i 1) (max-val (vector-ref v 0))) (if (>= i n) max-val (let ((val (vector-ref v i))) (loop (+ i 1) (if (> val max-val) val max-val)))))))"))
(task-entry (id "control-systems/hinf-synthesis/matrix-sub-scalar-diag") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22640) (name matrix-sub-scalar-diag) (type "") (description "Compute sI - A where sM = (Re, Im) parts of s*I") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm ss->tf ss-numerator-poly ss-eval-complex matrix-scale-complex)) (answer "(define (matrix-sub-scalar-diag sM A) (let* ((sr (car sM)) (si (cadr sM)) (n (matrix-rows A)) (result-r (make-matrix n n 0)) (result-i (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i n) (list result-r result-i)) (do ((j 0 (+ j 1))) ((= j n)) (let ((a-val (matrix-ref A i j)) (s-r (matrix-ref sr i j)) (s-i (matrix-ref si i j))) (matrix-set! result-r i j (- s-r a-val)) (matrix-set! result-i i j s-i))))))"))
(task-entry (id "control-systems/poly-algebra/has-sign-changes-exact?") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22640) (name has-sign-changes-exact?) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify tf-simplify-exact routh-array-exact make-routh-row routh-array-exact-iter make-routh-new-row routh-hurwitz-exact)) (answer "(define (has-sign-changes-exact? nums) (cond ((null? nums) #f) ((null? (cdr nums)) #f) (else (let* ((a (car nums)) (b (cadr nums)) (sign-change? (< (* a b) 0))) (or sign-change? (has-sign-changes-exact? (cdr nums)))))))"))
(task-entry (id "control-systems/z-transform/pad-poly-coeffs-local") (skill control-systems) (module z-transform) (tier 2) (difficulty 22641) (name pad-poly-coeffs-local) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg dtf-series dtf-parallel dtf-feedback dtf-unity-feedback dtf-stable? dtf-pole-magnitudes dss->dtf compute-char-poly compute-dtf-numerator dtf->dss dtf->dss-controllable dtf->string poly->string-z log10 pi matrix-trace-local matrix-column-v matrix-row-v matrix-vec-mul-local dot-product-local)) (answer "(define (pad-poly-coeffs-local coeffs n) (let ((len (vector-length coeffs))) (if (>= len n) coeffs (let ((result (make-vector n 0)) (offset (- n len))) (do ((i 0 (+ i 1))) ((= i len) result) (vector-set! result (+ i offset) (vector-ref coeffs i)))))))"))
(task-entry (id "control-systems/stability/stability-matrix-rank") (skill control-systems) (module stability) (tier 2) (difficulty 22641) (name stability-matrix-rank) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols matrix-hcat-list controllable? observability-matrix build-observability-rows matrix-vcat-list observable?)) (answer "(define (stability-matrix-rank M) (let* ((m (matrix-rows M)) (n (matrix-cols M)) (A (matrix-copy M)) (tol 1e-10)) (let row-loop ((row 0) (col 0) (rank 0)) (if (or (>= row m) (>= col n)) rank (let pivot-loop ((pr row)) (cond ((>= pr m) (row-loop row (+ col 1) rank)) ((> (abs (matrix-ref A pr col)) tol) (when (> pr row) (matrix-swap-rows! A row pr)) (do ((i (+ row 1) (+ i 1))) ((>= i m)) (let ((factor (/ (matrix-ref A i col) (matrix-ref A row col)))) (do ((j col (+ j 1))) ((>= j n)) (matrix-set! A i j (- (matrix-ref A i j) (* factor (matrix-ref A row j))))))) (row-loop (+ row 1) (+ col 1) (+ rank 1))) (else (pivot-loop (+ pr 1)))))))))"))
(task-entry (id "control-systems/controller-design/hinf-bounded?") (skill control-systems) (module controller-design) (tier 2) (difficulty 22641) (name hinf-bounded?) (type "TF × Number → Boolean") (description "Check if H-infinity norm is bounded by gamma") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local dlqr solve-dare lqg hinf-norm vector-max)) (answer "(define (hinf-bounded? tf gamma) (< (hinf-norm tf) gamma))"))
(task-entry (id "control-systems/hinf-synthesis/matrix-inverse-complex") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22641) (name matrix-inverse-complex) (type "") (description "Invert complex matrix (simple 2x2 or use augmented real)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm ss->tf ss-numerator-poly ss-eval-complex matrix-scale-complex matrix-sub-scalar-diag)) (answer "(define (matrix-inverse-complex M-complex) (let* ((Mr (car M-complex)) (Mi (cadr M-complex)) (n (matrix-rows Mr)) (aug (make-matrix (* 2 n) (* 2 n) 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! aug i j (matrix-ref Mr i j)) (matrix-set! aug i (+ j n) (- (matrix-ref Mi i j))) (matrix-set! aug (+ i n) j (matrix-ref Mi i j)) (matrix-set! aug (+ i n) (+ j n) (matrix-ref Mr i j)))) (let ((aug-inv (matrix-inverse aug))) (if (and (pair? aug-inv) (eq? (car aug-inv) 'error)) (list (make-matrix n n 0) (make-matrix n n 0)) (let ((inv-r (make-matrix n n 0)) (inv-i (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i n) (list inv-r inv-i)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! inv-r i j (matrix-ref aug-inv i j)) (matrix-set! inv-i i j (matrix-ref aug-inv (+ i n) j)))))))))"))
(task-entry (id "control-systems/poly-algebra/tf-char-poly") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22641) (name tf-char-poly) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div alg-poly-gcd alg-poly-make-monic alg-poly-extended-gcd alg-poly-square-free alg-poly-derivative alg-poly-square-free-factorization alg-sqf-iter alg-poly->string num-poly-coeffs Q-field numeric->algebra-poly algebra->numeric-poly tf-simplify tf-simplify-exact routh-array-exact make-routh-row routh-array-exact-iter make-routh-new-row routh-hurwitz-exact has-sign-changes-exact?)) (answer "(define (tf-char-poly tf) (numeric->algebra-poly (tf-den tf) Q-field))"))
(task-entry (id "control-systems/stability/matrix-copy") (skill control-systems) (module stability) (tier 2) (difficulty 22642) (name matrix-copy) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols matrix-hcat-list controllable? observability-matrix build-observability-rows matrix-vcat-list observable? stability-matrix-rank)) (answer "(define (matrix-copy M) (let* ((m (matrix-rows M)) (n (matrix-cols M)) (result (make-matrix m n 0))) (do ((i 0 (+ i 1))) ((= i m) result) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! result i j (matrix-ref M i j))))))"))
(task-entry (id "control-systems/controller-design/closed-loop-tf") (skill control-systems) (module controller-design) (tier 2) (difficulty 22642) (name closed-loop-tf) (type "TF × TF → TF") (description "Compute closed-loop transfer function for unity negative feedback. T(s) = G(s)C(s) / (1 + G(s)C(s))") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local dlqr solve-dare lqg hinf-norm vector-max hinf-bounded?)) (answer "(define (closed-loop-tf plant controller) (let* ((GC (tf-series plant controller)) (num-GC (tf-num GC)) (den-GC (tf-den GC)) (new-den (poly-add den-GC num-GC))) (make-tf num-GC new-den)))"))
(task-entry (id "control-systems/hinf-synthesis/matrix-mul-complex") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22642) (name matrix-mul-complex) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati solve-hinf-riccati-dual hinf-riccati-residual matrix-frobenius-norm-hinf matrix-near-zero? lyapunov-solve-hinf matrix-psd-project matrix-psd-project-simple spectral-radius hinf-construct-controller hinf-synthesize get-opt hinf-weight-first-order hinf-weight-constant tf->ss hinf-closed-loop-norm ss->tf ss-numerator-poly ss-eval-complex matrix-scale-complex matrix-sub-scalar-diag matrix-inverse-complex)) (answer "(define (matrix-mul-complex A-complex B-complex) (let* ((Ar (car A-complex)) (Ai (cadr A-complex)) (Br (car B-complex)) (Bi (cadr B-complex)) (Cr (matrix-sub (matrix-mul Ar Br) (matrix-mul Ai Bi))) (Ci (matrix-add (matrix-mul Ar Bi) (matrix-mul Ai Br)))) (list Cr Ci)))"))
