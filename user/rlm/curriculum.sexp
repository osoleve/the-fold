(task-entry (id "tiles/core/coord-hash") (skill tiles) (module core) (tier 1) (difficulty 12304) (name coord-hash) (type "(-> Coordinate Integer)") (description "Simple hash combining x and y - works for small boards") (notes ()) (section coordinate-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal?)) (answer "(define (coord-hash c) (+ (* (coord-x c) 1000000) (coord-y c)))"))
(task-entry (id "tiles/square/square-neighbors-ortho") (skill tiles) (module square) (tier 1) (difficulty 12304) (name square-neighbors-ortho) (type "(-> Coord (List Coord))") (description "Get 4 orthogonal neighbors (rook moves in chess)") (notes ()) (section neighbor-calculations) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor)) (answer "(define (square-neighbors-ortho coord) (map (lambda (dir) (square-neighbor coord (car dir))) square-offset-4))"))
(task-entry (id "tiles/hex/cubic->axial") (skill tiles) (module hex) (tier 1) (difficulty 12304) (name cubic->axial) (type "(-> CubicCoord AxialCoord)") (description "") (notes ()) (section coordinate-conversions) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic)) (answer "(define (cubic->axial cc) (axial-coord (cubic-coord%-x cc) (cubic-coord%-y cc)))"))
(task-entry (id "tiles/triangle/triangle-coord-equal?") (skill tiles) (module triangle) (tier 1) (difficulty 12304) (name triangle-coord-equal?) (type "") (description "") (notes ()) (section coordinates) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation)) (answer "(define (triangle-coord-equal? t1 t2) (and (= (triangle-row t1) (triangle-row t2)) (= (triangle-col t1) (triangle-col t2)) (eq? (triangle-orientation t1) (triangle-orientation t2))))"))
(task-entry (id "tiles/pathfinding/reconstruct-path") (skill tiles) (module pathfinding) (tier 1) (difficulty 12304) (name reconstruct-path) (type "(-> Hashtable Coord Coord (List Coord))") (description "Reconstruct path from came-from map") (notes ()) (section path-reconstruction) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert pqueue-pop)) (answer "(define (reconstruct-path came-from start goal) (let loop ((current goal) (path '())) (if (equal? current start) (cons start path) (let ((prev (hashtable-ref came-from current #f))) (if prev (loop prev (cons current path)) #f)))))"))
(task-entry (id "tiles/visibility/shadowcast-fov") (skill tiles) (module visibility) (tier 1) (difficulty 12304) (name shadowcast-fov) (type "(-> Board Coord Integer (-> Coord (List Coord)) (-> Coord Coord (List Coord)) (-> Coord Bool) (-> Coord Coord Number) (List Coord))") (description "Calculate field of view using recursive shadowcasting. Currently a placeholder using raycast FOV.") (notes ()) (section shadowcasting) (deps (\x27;tiles/core)) (available (has-line-of-sight? board-has-los? calculate-fov board-fov)) (answer "(define (shadowcast-fov board origin max-radius neighbor-fn line-fn blocks-vision-fn distance-fn) (calculate-fov board origin max-radius neighbor-fn line-fn blocks-vision-fn))"))
