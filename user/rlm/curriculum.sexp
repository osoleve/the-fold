(task-entry (id "data/centrality/eigenvector-centrality") (skill data) (module centrality) (tier 0) (difficulty 1302) (name eigenvector-centrality) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations*)) (answer "(define (eigenvector-centrality adj . opts) (let* ((n (matrix-rows adj)) (m (matrix-cols adj))) (if (not (= n m)) (quasiquote (error not-square (unquote n) (unquote m))) (let* ((max-iter (if (and (pair? opts) (integer? (car opts))) (car opts) *centrality-max-iterations*)) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (tol (if (and (pair? rest1) (number? (car rest1))) (car rest1) *centrality-tolerance*)) (v0 (make-vec n (/ 1.0 (sqrt n)))) (result (eigenvector-power-iteration adj v0 max-iter tol))) (if (and (pair? result) (eq? (car result) 'error)) result (eigenvector-normalize result))))))"))
(task-entry (id "data/graph-community/most-frequent-neighbor-label") (skill data) (module graph-community) (tier 0) (difficulty 1302) (name most-frequent-neighbor-label) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order)) (answer "(define (most-frequent-neighbor-label adj labels node n) (let ((counts (make-vector n 0)) (max-count 0) (max-label #f)) (do ((j 0 (+ j 1))) ((= j n)) (when (and (not (= j node)) (> (matrix-ref adj node j) 0)) (let* ((lbl (vector-ref labels j)) (new-count (+ 1 (vector-ref counts lbl)))) (vector-set! counts lbl new-count) (when (> new-count max-count) (set! max-count new-count) (set! max-label lbl))))) max-label))"))
