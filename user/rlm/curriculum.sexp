(task-entry (id "fp/poly-canonical/extract-coeff-product") (skill fp) (module poly-canonical) (tier 1) (difficulty 10607) (name extract-coeff-product) (type "") (description "") (notes ()) (section conversion) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial polynomial-expr? expr-degree extract-poly-coeffs extract-coeff-at extract-coeff-expanded)) (answer "(define (extract-coeff-product factors var-sym k) (if (null? factors) (if (= k 0) 1 0) (let ((first (car factors)) (rest (cdr factors))) (let ((first-deg (expr-degree first var-sym))) (let loop ((i 0) (total 0)) (if (> i (min first-deg k)) total (let ((c1 (extract-coeff-expanded first var-sym i)) (c2 (extract-coeff-product rest var-sym (- k i)))) (loop (+ i 1) (+ total (* c1 c2))))))))))"))
