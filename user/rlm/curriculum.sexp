(task-entry (id "numeric/convolution/convolve") (skill numeric) (module convolution) (tier 0) (difficulty 2504) (name convolve) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;vec)) (available (convolve-direct-full convolve-direct-same convolve-direct-valid convolve-fft)) (answer "(define (convolve signal kernel mode) (let ((m (vector-length kernel))) (cond ((< m 32) (case mode ((full) (convolve-direct-full signal kernel)) ((same) (convolve-direct-same signal kernel)) ((valid) (convolve-direct-valid signal kernel)) (else (error 'convolve \"invalid mode\" mode)))) (else (let ((result-full (convolve-fft signal kernel))) (case mode ((full) result-full) ((same) (let* ((n (vector-length signal)) (offset (quotient m 2)) (trimmed (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) trimmed) (vector-set! trimmed i (vector-ref result-full (+ i offset)))))) ((valid) (let* ((n (vector-length signal)) (output-len (max 0 (+ (- n m) 1)))) (if (= output-len 0) (vector) (let ((trimmed (make-vector output-len))) (do ((i 0 (+ i 1))) ((= i output-len) trimmed) (vector-set! trimmed i (vector-ref result-full (+ i (- m 1))))))))) (else (error 'convolve \"invalid mode\" mode))))))))"))
