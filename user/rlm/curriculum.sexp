(task-entry (id "optimization/interval-global/bb-loop-monotonic") (skill optimization) (module interval-global) (tier 1) (difficulty 12843) (name bb-loop-monotonic) (type "") (description "") (notes ()) (section convergence-criteria) (deps (\x27;prelude \x27;interval \x27;heap)) (available (make-interval-convergence interval-convergence? ic-width-tol ic-max-iter ic-gap-tol *default-interval-convergence* make-interval-opt-result interval-opt-result? ior-candidates ior-best-upper ior-iterations ior-reason ior-best-box ior-best-point ior-solution-box box-hull box-midpoint box-max-width box-widest-dimension bisect-box list-update make-work-item work-item-box work-item-interval work-item-lo work-item-cmp point->box eval-at-point interval-minimize bb-loop heap-pop-by filter-candidates interval-maximize interval-find-minimum interval-sphere scalar-sphere interval-rosenbrock scalar-rosenbrock interval-rastrigin scalar-rastrigin interval-opt-result->string interval-opt-result-print interval-minimize-with-gradient)) (answer "(define (bb-loop-monotonic f-interval grad-fn f-scalar work-list best-upper candidates iter width-tol max-iter gap-tol) (cond ((heap-empty? work-list) (make-interval-opt-result (filter-candidates candidates best-upper f-interval) best-upper iter 'exhausted)) ((>= iter max-iter) (make-interval-opt-result (filter-candidates candidates best-upper f-interval) best-upper iter 'max-iterations)) (else (let*-values (((rest-heap item) (heap-pop-by work-item-cmp work-list))) (let* ((box (work-item-box item)) (f-iv (work-item-interval item)) (lo (interval-lo f-iv))) (cond ((> lo best-upper) (bb-loop-monotonic f-interval grad-fn f-scalar rest-heap best-upper candidates iter width-tol max-iter gap-tol)) ((< (box-max-width box) width-tol) (bb-loop-monotonic f-interval grad-fn f-scalar rest-heap best-upper (cons box candidates) iter width-tol max-iter gap-tol)) ((< (- (interval-hi f-iv) lo) gap-tol) (bb-loop-monotonic f-interval grad-fn f-scalar rest-heap best-upper (cons box candidates) iter width-tol max-iter gap-tol)) (else (let* ((grad-ivs (grad-fn box)) (reduced-box (maybe-reduce-box-monotonic box grad-ivs)) (actually-reduced? (not (equal? reduced-box box)))) (if actually-reduced? (let* ((f-reduced (f-interval reduced-box)) (mid-reduced (box-midpoint reduced-box)) (f-mid-reduced (f-scalar mid-reduced)) (new-best (min best-upper f-mid-reduced (interval-hi f-reduced))) (item-reduced (make-work-item reduced-box f-reduced)) (new-heap (heap-insert-by work-item-cmp item-reduced rest-heap))) (bb-loop-monotonic f-interval grad-fn f-scalar new-heap new-best candidates (+ iter 1) width-tol max-iter gap-tol)) (let* ((pair (bisect-box box)) (box1 (car pair)) (box2 (cdr pair)) (f1 (f-interval box1)) (f2 (f-interval box2)) (mid1 (box-midpoint box1)) (mid2 (box-midpoint box2)) (f-mid1 (f-scalar mid1)) (f-mid2 (f-scalar mid2)) (new-best (min best-upper f-mid1 f-mid2 (interval-hi f1) (interval-hi f2))) (item1 (make-work-item box1 f1)) (item2 (make-work-item box2 f2)) (new-heap (heap-insert-by work-item-cmp item1 (heap-insert-by work-item-cmp item2 rest-heap)))) (bb-loop-monotonic f-interval grad-fn f-scalar new-heap new-best candidates (+ iter 2) width-tol max-iter gap-tol)))))))))))"))
(task-entry (id "optimization/lp/lp->string") (skill optimization) (module lp) (tier 1) (difficulty 12844) (name lp->string) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize extract-basis-matrix extract-basis-costs compute-reduced-costs find-entering-variable vec-contains? compute-direction find-leaving-variable update-basis create-phase1-lp run-phase1 pivot-out-artificials find-nonbasic-pivot simplex-core construct-solution construct-unbounded-direction lp-solve ensure-nonnegative-rhs lp-dual lp-shadow-prices lp-reduced-costs lp-basis-ranges lp-rhs-ranges lp-weak-duality? lp-strong-duality?)) (answer "(define (lp->string lp) (let* ((c (lp-c lp)) (A (lp-A lp)) (b (lp-b lp)) (m (matrix-rows A)) (n (matrix-cols A))) (string-append \"Minimize: \" (vec->string c) \"' * x\n\" \"Subject to: Ax = b\n\" \"A = \" (matrix->string A) \"\n\" \"b = \" (vec->string b) \"\n\" \"x >= 0\")))"))
(task-entry (id "optimization/ilp/vec-append") (skill optimization) (module ilp) (tier 1) (difficulty 12844) (name vec-append) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp make-ilp-optimal make-ilp-infeasible make-ilp-unbounded ilp-optimal? ilp-infeasible? ilp-unbounded? ilp-result-x ilp-result-z is-integer? solution-is-integer? find-fractional-var round-solution make-bb-node bb-node-lp bb-node-lb bb-node-ub add-bound-constraints ilp-solve branch-and-bound vector-take frac generate-gomory-cut matrix-row add-gomory-cut ilp-solve-cutting-plane find-and-generate-cut knapsack-solve set-cover-solve vec-ones vec-zeros vec-negate)) (answer "(define (vec-append v1 v2) (let* ((n1 (vector-length v1)) (n2 (vector-length v2)) (result (make-vector (+ n1 n2) 0))) (do ((i 0 (+ i 1))) ((= i n1)) (vector-set! result i (vector-ref v1 i))) (do ((i 0 (+ i 1))) ((= i n2) result) (vector-set! result (+ n1 i) (vector-ref v2 i)))))"))
(task-entry (id "optimization/interval-global/maybe-reduce-box-monotonic") (skill optimization) (module interval-global) (tier 1) (difficulty 12844) (name maybe-reduce-box-monotonic) (type "") (description "") (notes ()) (section convergence-criteria) (deps (\x27;prelude \x27;interval \x27;heap)) (available (make-interval-convergence interval-convergence? ic-width-tol ic-max-iter ic-gap-tol *default-interval-convergence* make-interval-opt-result interval-opt-result? ior-candidates ior-best-upper ior-iterations ior-reason ior-best-box ior-best-point ior-solution-box box-hull box-midpoint box-max-width box-widest-dimension bisect-box list-update make-work-item work-item-box work-item-interval work-item-lo work-item-cmp point->box eval-at-point interval-minimize bb-loop heap-pop-by filter-candidates interval-maximize interval-find-minimum interval-sphere scalar-sphere interval-rosenbrock scalar-rosenbrock interval-rastrigin scalar-rastrigin interval-opt-result->string interval-opt-result-print interval-minimize-with-gradient bb-loop-monotonic)) (answer "(define (maybe-reduce-box-monotonic box grad-ivs) (let loop ((box box) (grads grad-ivs) (new-box '()) (changed? #f)) (cond ((null? box) (if changed? (reverse new-box) (reverse new-box))) (else (let* ((iv (car box)) (grad (car grads)) (lo (interval-lo grad)) (hi (interval-hi grad))) (cond ((> lo 0) (loop (cdr box) (cdr grads) (cons (interval-singleton (interval-lo iv)) new-box) #t)) ((< hi 0) (loop (cdr box) (cdr grads) (cons (interval-singleton (interval-hi iv)) new-box) #t)) (else (loop (cdr box) (cdr grads) (cons iv new-box) changed?))))))))"))
