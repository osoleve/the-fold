(task-entry (id "control-systems/tf-convert/tf->ss-controllable") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22605) (name tf->ss-controllable) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier faddeev-leverrier compute-tf-numerator tf->ss)) (answer "(define (tf->ss-controllable num den n m) (let* ((den-coeffs (poly-coeffs den)) (num-coeffs (poly-coeffs num)) (num-padded (pad-poly-coeffs num-coeffs (+ n 1))) (b-n (vector-ref num-padded 0)) (A (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i (- n 1))) (matrix-set! A i (+ i 1) 1)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! A (- n 1) j (- (vector-ref den-coeffs (- n j))))) (let ((B (make-matrix n 1 0))) (matrix-set! B (- n 1) 0 1) (let ((C (make-matrix 1 n 0))) (do ((j 0 (+ j 1))) ((= j n)) (let* ((b-j (vector-ref num-padded (- n j))) (a-j (vector-ref den-coeffs (- n j))) (c-j (- b-j (* a-j b-n)))) (matrix-set! C 0 j c-j))) (let ((D (make-matrix 1 1 b-n))) (make-ss A B C D))))))"))
(task-entry (id "control-systems/kalman/kalman-R") (skill control-systems) (module kalman) (tier 2) (difficulty 22605) (name kalman-R) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q)) (answer "(define (kalman-R kf) (car (cddddr kf)))"))
(task-entry (id "control-systems/stability/routh-array") (skill control-systems) (module stability) (tier 2) (difficulty 22605) (name routh-array) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable?)) (answer "(define (routh-array poly) (let* ((coeffs (poly-coeffs poly)) (n (vector-length coeffs)) (degree (- n 1))) (if (< n 2) (list (vector (vector-ref coeffs 0))) (let* ((row1-len (ceiling (/ n 2))) (row1 (make-vector row1-len 0)) (row2 (make-vector row1-len 0))) (do ((i 0 (+ i 1))) ((>= i row1-len)) (let ((idx (* i 2))) (when (< idx n) (vector-set! row1 i (vector-ref coeffs idx))))) (do ((i 0 (+ i 1))) ((>= i row1-len)) (let ((idx (+ 1 (* i 2)))) (when (< idx n) (vector-set! row2 i (vector-ref coeffs idx))))) (routh-array-iter (list row2 row1) degree)))))"))
(task-entry (id "control-systems/controller-design/pole-placement-ackermann") (skill control-systems) (module controller-design) (tier 2) (difficulty 22605) (name pole-placement-ackermann) (type "SS × (List Complex) → Matrix | Error") (description "Compute state feedback gain K using Ackermann's formula. State feedback: u = -K*x where K is the feedback gain matrix. Closed-loop system: x' = (A - B*K)*x. Places closed-loop poles at specified locations. SISO only - for MIMO systems, use pole-placement instead.") (notes ("Formula: K = [0 0 ... 0 1] * inv(C_n) * p(A) where C_n is controllability matrix and p(s) = desired char poly")) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda)) (answer "(define (pole-placement-ackermann sys desired-poles) (let* ((A (ss-A sys)) (B (ss-B sys)) (n (ss-order sys)) (m (matrix-cols B))) (if (not (= m 1)) '(error ackermann-siso-only) (let ((C-mat (controllability-matrix sys))) (if (not (= (stability-matrix-rank C-mat) n)) '(error system-not-controllable) (let* ((char-poly (poly-from-roots desired-poles 1)) (pA (poly-eval-matrix char-poly A)) (C-inv (matrix-inverse C-mat)) (e-n (make-row-vector n (- n 1))) (temp (matrix-mul e-n C-inv)) (K (matrix-mul temp pA))) K))))))"))
