(task-entry (id "dsl/tagless/eval-typed-dict") (skill dsl) (module tagless) (tier 1) (difficulty 11787) (name eval-typed-dict) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops dict-ref dict-has? dict-extend dict-merge make-expr-dict expr-lit expr-add expr-neg eval-expr-dict pretty-expr-dict count-expr-dict depth-expr-dict example-expr-1 example-expr-2 make-mul-dict expr-mul eval-mul-dict pretty-mul-dict example-mul make-bool-dict bool-lit bool-and bool-or bool-not eval-bool-dict pretty-bool-dict make-cmp-dict cmp-eq cmp-lt cmp-gt eval-full-dict make-cond-dict cond-if-lazy eval-cond-dict pretty-cond-dict make-lazy-cond-dict lazy-if eval-lazy-cond-dict make-let-dict tl-let tl-var make-env-expr-dict env-lit env-add env-neg env-let env-var run-env-expr example-let make-stateful-dict state-get state-put state-pure state-bind state-monad-dict run-state make-chronicle-dict ch-scene ch-choice ch-guard ch-effect ch-text ch-start ch-choose ch-render validate-chronicle-dict graph-chronicle-dict with-logging with-tracing with-memoization run-both twice fold-expr tagless-to-free free-to-tagless optimize-neg-neg optimize-expr run-optimized make-pe-dict make-typed-expr-dict typed-int typed-bool typed-value typed-type)) (answer "(define eval-typed-dict (make-typed-expr-dict (lambda (n) (typed-int n)) (lambda (x y) (if (and (eq? (typed-type x) 'int) (eq? (typed-type y) 'int)) (typed-int (+ (typed-value x) (typed-value y))) (error 'add \"Type error: expected int\"))) (lambda (x) (if (eq? (typed-type x) 'int) (typed-int (- (typed-value x))) (error 'neg \"Type error: expected int\"))) (lambda (x y) (if (and (eq? (typed-type x) 'int) (eq? (typed-type y) 'int)) (typed-bool (= (typed-value x) (typed-value y))) (error 'eq \"Type error: expected int\"))) (lambda (c t-thunk e-thunk) (if (eq? (typed-type c) 'bool) (if (typed-value c) (t-thunk) (e-thunk)) (error 'if \"Type error: expected bool\")))))"))
