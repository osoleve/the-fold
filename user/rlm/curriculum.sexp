(task-entry (id "data/set/set-intersection") (skill data) (module set) (tier 0) (difficulty 1306) (name set-intersection) (type "(-> Set Set Set)") (description "Intersection of two sets") (notes ()) (section none) (deps (\x27;prelude)) (available (set-empty set-empty? set-member? set-add set-remove set-union)) (answer "(define (set-intersection set1 set2) (let loop ((remaining set1) (acc '())) (cond ((null? remaining) (reverse acc)) ((set-member? (car remaining) set2) (loop (cdr remaining) (cons (car remaining) acc))) (else (loop (cdr remaining) acc)))))"))
