(task-entry (id "numeric/pde-time/crank-nicolson-step") (skill numeric) (module pde-time) (tier 0) (difficulty 2512) (name crank-nicolson-step) (type "") (description "") (notes ()) (section crank-nicolson) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step)) (answer "(define (crank-nicolson-step M A u b dt tol max-iter) (let* ((half-dt (/ dt 2)) (n (sparse-csr-rows M)) (LHS (sparse-csr-add M (sparse-csr-scale (- half-dt) A))) (M-plus (sparse-csr-add M (sparse-csr-scale half-dt A))) (Mu (sparse-csr-vec-mul M-plus u)) (RHS (pde-vec-madd Mu dt b)) (result (sparse-cg-solve LHS RHS u tol max-iter))) (values (car result) (cadr result) (caddr result))))"))
