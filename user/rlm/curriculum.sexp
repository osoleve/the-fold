(task-entry (id "algebra/galois/gf2n-to-int") (skill algebra) (module galois) (tier 0) (difficulty 331) (name gf2n-to-int) (type "") (description "") (notes ()) (section gf2n-binary-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int)) (answer "(define (gf2n-to-int element) (if (gf2n-element? element) (gf2n-value element) (error 'gf2n-to-int \"not a GF(2^n) element\")))"))
(task-entry (id "algebra/group/cycle-to-permutation") (skill algebra) (module group) (tier 0) (difficulty 332) (name cycle-to-permutation) (type "(-> Integer (List Integer) Permutation)") (description "E.g., (cycle-to-permutation 3 '(0 1 2)) for the 3-cycle (0 1 2)") (notes ()) (section permutation-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S)) (answer "(define (cycle-to-permutation n cycle) (let ((result (iota n))) (if (null? cycle) result (let loop ((rest cycle) (res result)) (if (null? (cdr rest)) (list-set res (car rest) (car cycle)) (loop (cdr rest) (list-set res (car rest) (cadr rest))))))))"))
(task-entry (id "algebra/ring/is-valid-ring-homomorphism?") (skill algebra) (module ring) (tier 0) (difficulty 332) (name is-valid-ring-homomorphism?) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product is-commutative-ring? is-zero-divisor? has-zero-divisors? is-integral-domain? is-unit? ring-units make-ring-zn make-ring-z make-ring-homomorphism ring-hom? ring-hom-source ring-hom-target ring-hom-phi ring-hom-apply)) (answer "(define (is-valid-ring-homomorphism? h) (let ((r (ring-hom-source h)) (s (ring-hom-target h)) (phi (ring-hom-phi h))) (let ((elems (ring-elements r))) (and (ring-equal? s (phi (ring-one r)) (ring-one s)) (let loop ((as elems)) (if (null? as) #t (let ((a (car as))) (let inner-loop ((bs elems)) (if (null? bs) (loop (cdr as)) (let* ((b (car bs)) (sum-ab (ring-add r a b)) (prod-ab (ring-mul r a b))) (and (ring-equal? s (phi sum-ab) (ring-add s (phi a) (phi b))) (ring-equal? s (phi prod-ab) (ring-mul s (phi a) (phi b))) (inner-loop (cdr bs)))))))))))))"))
(task-entry (id "algebra/polynomial/poly-lcm") (skill algebra) (module polynomial) (tier 0) (difficulty 332) (name poly-lcm) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop)) (answer "(define (poly-lcm p1 p2) (if (or (poly-zero? p1) (poly-zero? p2)) (poly-zero-over (poly-field p1)) (poly-div (poly-mul p1 p2) (poly-gcd p1 p2))))"))
(task-entry (id "algebra/multivariate/assoc-mono") (skill algebra) (module multivariate) (tier 0) (difficulty 332) (name assoc-mono) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms)) (answer "(define (assoc-mono mono terms) (cond ((null? terms) #f) ((mono-equal? mono (cdar terms)) (car terms)) (else (assoc-mono mono (cdr terms)))))"))
(task-entry (id "algebra/poly-bridge/alg-scale") (skill algebra) (module poly-bridge) (tier 0) (difficulty 332) (name alg-scale) (type "(-> AlgebraPoly Coeff AlgebraPoly)") (description "") (notes ()) (section prefixed-algebra-operations) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul alg-poly-scale alg-poly-divmod alg-poly-div alg-poly-mod alg-poly-gcd alg-poly-extended-gcd alg-poly-derivative alg-poly-eval alg-poly-monic alg-poly->string alg-make-polynomial Q-field numeric->algebra numeric->algebra-with-field algebra->numeric alg-make alg-coeffs alg-degree alg-field alg-zero? alg-leading alg-add alg-sub alg-mul)) (answer "(define alg-scale alg-poly-scale)"))
(task-entry (id "algebra/galois/poly-power-mod") (skill algebra) (module galois) (tier 0) (difficulty 332) (name poly-power-mod) (type "(-> Polynomial Int Polynomial Polynomial)") (description "Modular polynomial exponentiation: p^n mod m") (notes ("O(log n) multiplications, each followed by reduction mod m")) (section irreducible-polynomials) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int)) (answer "(define (poly-power-mod p n m) (let ((F (poly-field p)) (base (poly-mod p m))) (if (= n 0) (poly-one-over F) (let loop ((b base) (e n) (acc (poly-one-over F))) (cond ((= e 0) acc) ((odd? e) (loop (poly-mod (poly-mul b b) m) (quotient e 2) (poly-mod (poly-mul acc b) m))) (else (loop (poly-mod (poly-mul b b) m) (quotient e 2) acc)))))))"))
(task-entry (id "algebra/group/transposition") (skill algebra) (module group) (tier 0) (difficulty 333) (name transposition) (type "(-> Integer Integer Integer Permutation)") (description "Create a transposition swapping i and j in n elements") (notes ()) (section permutation-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation)) (answer "(define (transposition n i j) (cycle-to-permutation n (list i j)))"))
(task-entry (id "algebra/ring/ring-hom-kernel") (skill algebra) (module ring) (tier 0) (difficulty 333) (name ring-hom-kernel) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product is-commutative-ring? is-zero-divisor? has-zero-divisors? is-integral-domain? is-unit? ring-units make-ring-zn make-ring-z make-ring-homomorphism ring-hom? ring-hom-source ring-hom-target ring-hom-phi ring-hom-apply is-valid-ring-homomorphism?)) (answer "(define (ring-hom-kernel h) (let ((r (ring-hom-source h)) (s (ring-hom-target h)) (phi (ring-hom-phi h))) (filter (lambda (a) (ring-equal? s (phi a) (ring-zero s))) (ring-elements r))))"))
(task-entry (id "algebra/polynomial/poly-eval") (skill algebra) (module polynomial) (tier 0) (difficulty 333) (name poly-eval) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm)) (answer "(define (poly-eval p x) (let* ((F (poly-field p)) (coeffs (reverse (poly-coeffs p))) (add (field-add-op F)) (mul (field-mul-op F))) (if (null? coeffs) (field-zero F) (let loop ((cs (cdr coeffs)) (acc (car coeffs))) (if (null? cs) acc (loop (cdr cs) (add (mul acc x) (car cs))))))))"))
(task-entry (id "algebra/multivariate/update-assoc-mono") (skill algebra) (module multivariate) (tier 0) (difficulty 333) (name update-assoc-mono) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms assoc-mono)) (answer "(define (update-assoc-mono mono new-coeff terms) (map (lambda (t) (if (mono-equal? mono (cdr t)) (cons new-coeff mono) t)) terms))"))
(task-entry (id "algebra/poly-bridge/alg-divmod") (skill algebra) (module poly-bridge) (tier 0) (difficulty 333) (name alg-divmod) (type "(-> AlgebraPoly AlgebraPoly (Pair AlgebraPoly AlgebraPoly))") (description "") (notes ()) (section prefixed-algebra-operations) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul alg-poly-scale alg-poly-divmod alg-poly-div alg-poly-mod alg-poly-gcd alg-poly-extended-gcd alg-poly-derivative alg-poly-eval alg-poly-monic alg-poly->string alg-make-polynomial Q-field numeric->algebra numeric->algebra-with-field algebra->numeric alg-make alg-coeffs alg-degree alg-field alg-zero? alg-leading alg-add alg-sub alg-mul alg-scale)) (answer "(define alg-divmod alg-poly-divmod)"))
(task-entry (id "algebra/galois/unique-prime-divisors") (skill algebra) (module galois) (tier 0) (difficulty 333) (name unique-prime-divisors) (type "") (description "") (notes ()) (section irreducible-polynomials) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod)) (answer "(define (unique-prime-divisors n) (if (<= n 1) '() (let loop ((factors (factorize n)) (seen '())) (if (null? factors) (reverse seen) (let ((p (car factors))) (if (member p seen) (loop (cdr factors) seen) (loop (cdr factors) (cons p seen))))))))"))
(task-entry (id "algebra/group/permutation-parity") (skill algebra) (module group) (tier 0) (difficulty 334) (name permutation-parity) (type "(-> Permutation Integer)") (description "Returns 0 for even permutation, 1 for odd") (notes ()) (section permutation-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition)) (answer "(define (permutation-parity perm) (let* ((n (length perm)) (inversions (let loop-i ((i 0) (count 0)) (if (= i n) count (loop-i (+ i 1) (let loop-j ((j (+ i 1)) (c count)) (if (= j n) c (loop-j (+ j 1) (if (> (list-ref perm i) (list-ref perm j)) (+ c 1) c))))))))) (modulo inversions 2)))"))
(task-entry (id "algebra/ring/ring-hom-image") (skill algebra) (module ring) (tier 0) (difficulty 334) (name ring-hom-image) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product is-commutative-ring? is-zero-divisor? has-zero-divisors? is-integral-domain? is-unit? ring-units make-ring-zn make-ring-z make-ring-homomorphism ring-hom? ring-hom-source ring-hom-target ring-hom-phi ring-hom-apply is-valid-ring-homomorphism? ring-hom-kernel)) (answer "(define (ring-hom-image h) (let ((phi (ring-hom-phi h)) (r (ring-hom-source h))) (unique-with-equal (map phi (ring-elements r)) (ring-equal-fn (ring-hom-target h)))))"))
(task-entry (id "algebra/polynomial/poly-derivative") (skill algebra) (module polynomial) (tier 0) (difficulty 334) (name poly-derivative) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm poly-eval)) (answer "(define (poly-derivative p) (let* ((F (poly-field p)) (coeffs (poly-coeffs p)) (add (field-add-op F))) (if (<= (length coeffs) 1) (poly-zero-over F) (make-polynomial F (let loop ((cs (cdr coeffs)) (k 1) (result '())) (if (null? cs) (reverse result) (loop (cdr cs) (+ k 1) (cons (poly-scalar-mul-int F (car cs) k) result))))))))"))
