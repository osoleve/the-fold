(task-entry (id "fp/simplify/factor") (skill fp) (module simplify) (tier 1) (difficulty 10624) (name factor) (type "(-> Expr Expr)") (description "Try to factor expression") (notes ("Supports: extract common factors, difference of squares, perfect square trinomials")) (section factoring) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow simplify-app expand expand-once expand-product expand-power-of-sum)) (answer "(define (factor expr) (cond ((sum? expr) (let ((factored (factor-sum (sum-terms expr)))) (if factored factored expr))) ((difference? expr) (cond ((and (diff-right expr) (power? (diff-left expr)) (power? (diff-right expr)) (num? (pow-exp (diff-left expr))) (= (num-val (pow-exp (diff-left expr))) 2) (num? (pow-exp (diff-right expr))) (= (num-val (pow-exp (diff-right expr))) 2)) (let ((a (pow-base (diff-left expr))) (b (pow-base (diff-right expr)))) (product (sum a b) (difference a b)))) (else expr))) (else expr)))"))
(task-entry (id "fp/integrate/contains-var?") (skill fp) (module integrate) (tier 1) (difficulty 10624) (name contains-var?) (type "") (description "") (notes ()) (section partial-fractions) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power integrate-quotient integrate-by-substitution try-substitution-pattern find-antiderivative-match find-u-candidates substitute-u can-express-in-u? replace-with-u try-trig-substitution integrate-by-parts sort-by-liate liate-priority polynomial? try-parts integrate-partial-fractions integrate-linear-factors)) (answer "(define (contains-var? expr var-sym) (cond ((num? expr) #f) ((var? expr) (eq? (var-name expr) var-sym)) ((sum? expr) (exists (lambda (t) (contains-var? t var-sym)) (sum-terms expr))) ((product? expr) (exists (lambda (f) (contains-var? f var-sym)) (product-factors expr))) ((difference? expr) (or (contains-var? (diff-left expr) var-sym) (and (diff-right expr) (contains-var? (diff-right expr) var-sym)))) ((quotient? expr) (or (contains-var? (quot-numer expr) var-sym) (contains-var? (quot-denom expr) var-sym))) ((power? expr) (or (contains-var? (pow-base expr) var-sym) (contains-var? (pow-exp expr) var-sym))) ((app? expr) (contains-var? (app-arg expr) var-sym)) (else #f)))"))
(task-entry (id "fp/solve/solve-linear-system") (skill fp) (module solve) (tier 1) (difficulty 10624) (name solve-linear-system) (type "(-> (List Equation) (List Symbol) (Maybe (Alist Symbol Expr)))") (description "Solve system of linear equations using symbolic Gaussian elimination") (notes ("Returns alist mapping variables to solutions")) (section linear-systems) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms solve-linear solve-quadratic solve-cubic solve-polynomial diff-to-sum solve solve-for)) (answer "(define (solve-linear-system equations vars) (let* ((n (length vars)) (exprs (map (lambda (eq) (if (equation? eq) (equation->expr eq) eq)) equations)) (matrix (build-coefficient-matrix exprs vars)) (augmented (augment-with-constants matrix exprs vars))) (if (not augmented) #f (let ((reduced (gaussian-eliminate-symbolic augmented n))) (if reduced (back-substitute-symbolic reduced vars) #f)))))"))
