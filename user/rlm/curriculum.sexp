(task-entry (id "physics/classical/constraint-graph/make-constraint-graph") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23500) (name make-constraint-graph) (type "") (description "") (notes ()) (section representation) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available ()) (answer "(define (make-constraint-graph constraints) (let ((adj (make-hashtable equal-hash equal?)) (entity-constraints (make-hashtable equal-hash equal?)) (all-entities '())) (for-each (lambda (c) (let ((entity-a (constraint-entity-a c)) (entity-b (constraint-entity-b c))) (unless (hashtable-contains? adj entity-a) (hashtable-set! adj entity-a '()) (hashtable-set! entity-constraints entity-a '()) (set! all-entities (cons entity-a all-entities))) (hashtable-set! entity-constraints entity-a (cons c (hashtable-ref entity-constraints entity-a '()))) (when entity-b (unless (hashtable-contains? adj entity-b) (hashtable-set! adj entity-b '()) (hashtable-set! entity-constraints entity-b '()) (set! all-entities (cons entity-b all-entities))) (hashtable-set! entity-constraints entity-b (cons c (hashtable-ref entity-constraints entity-b '()))) (hashtable-set! adj entity-a (cons entity-b (hashtable-ref adj entity-a '()))) (hashtable-set! adj entity-b (cons entity-a (hashtable-ref adj entity-b '())))))) constraints) (list 'constraint-graph adj entity-constraints (reverse all-entities) constraints)))"))
