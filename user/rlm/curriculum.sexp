(task-entry (id "control-systems/tf-convert/matrix-row") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22608) (name matrix-row) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier faddeev-leverrier compute-tf-numerator tf->ss tf->ss-controllable pad-poly-coeffs matrix-column)) (answer "(define (matrix-row M i) (let* ((cols (matrix-cols M)) (result (make-vector cols))) (do ((j 0 (+ j 1))) ((= j cols) result) (vector-set! result j (matrix-ref M i j)))))"))
(task-entry (id "control-systems/kalman/kalman-estimate") (skill control-systems) (module kalman) (tier 2) (difficulty 22608) (name kalman-estimate) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update)) (answer "(define (kalman-estimate kf observation) (kalman-update (kalman-predict kf) observation))"))
(task-entry (id "control-systems/stability/has-sign-changes?") (skill control-systems) (module stability) (tier 2) (difficulty 22608) (name has-sign-changes?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable?)) (answer "(define (has-sign-changes? nums) (cond ((null? nums) #f) ((null? (cdr nums)) #f) (else (let* ((a (car nums)) (b (cadr nums)) (sign-change? (< (* a b) 0))) (or sign-change? (has-sign-changes? (cdr nums)))))))"))
(task-entry (id "control-systems/controller-design/pole-placement-bass-gura") (skill control-systems) (module controller-design) (tier 2) (difficulty 22608) (name pole-placement-bass-gura) (type "SS × (List Complex) → Matrix | Error") (description "Compute state feedback gain using Bass-Gura formula. More numerically stable than Ackermann for higher-order systems. SISO only - use pole-placement for MIMO") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix)) (answer "(define (pole-placement-bass-gura sys desired-poles) (let* ((A (ss-A sys)) (B (ss-B sys)) (n (ss-order sys)) (m (matrix-cols B))) (if (not (= m 1)) '(error bass-gura-siso-only) (let* ((open-char-poly (characteristic-polynomial A)) (des-char-poly (poly-from-roots desired-poles 1)) (alpha-open (poly-coeffs-vector open-char-poly n)) (alpha-des (poly-coeffs-vector des-char-poly n)) (delta (vector-sub alpha-des alpha-open)) (C-mat (controllability-matrix sys)) (C-inv (matrix-inverse C-mat)) (W (bass-gura-W alpha-open n)) (WC-inv (matrix-mul W C-inv)) (K (matrix-mul (vector->row-matrix delta) WC-inv))) K))))"))
