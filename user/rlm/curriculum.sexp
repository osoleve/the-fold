(task-entry (id "sim/bifurcation/compute-eigenvalue-factor") (skill sim) (module bifurcation) (tier 2) (difficulty 23338) (name compute-eigenvalue-factor) (type "(-> (List Complex) Number)") (description "Compute step-size factor based on eigenvalue proximity to critical values") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor*)) (answer "(define (compute-eigenvalue-factor eigenvalues) (if (null? eigenvalues) 1.0 (let ((min-real-mag (apply min (map (lambda (e) (abs (complex-real e))) eigenvalues)))) (if (< min-real-mag *adaptive-eigenvalue-threshold*) *adaptive-shrink-factor* 1.0))))"))
(task-entry (id "sim/simulation-stream/sim-potential-energy") (skill sim) (module simulation-stream) (tier 2) (difficulty 23339) (name sim-potential-energy) (type "(-> Number Number (Stream PhysicsState) (Stream Number))") (description "Extract gravitational potential energy stream") (notes ()) (section observable-streams) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time sim-sample sim-sample-loop sim-until sim-positions sim-velocities sim-times sim-kinetic-energy)) (answer "(define (sim-potential-energy g y-ref stream) (stream-map (lambda (s) (* (physics-mass s) g (- y-ref (vec2-y (physics-pos s))))) stream))"))
(task-entry (id "sim/bifurcation/compute-curvature-factor") (skill sim) (module bifurcation) (tier 2) (difficulty 23339) (name compute-curvature-factor) (type "(-> (Pair Vec Number) (Pair Vec Number) Number)") (description "Compute step-size factor based on tangent direction change (curvature)") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor)) (answer "(define (compute-curvature-factor old-tangent new-tangent) (if (or (not old-tangent) (not new-tangent)) 1.0 (let* ((dot (+ (vec-dot (car old-tangent) (car new-tangent)) (* (cdr old-tangent) (cdr new-tangent)))) (clamped-dot (max -1.0 (min 1.0 dot))) (angle (acos (abs clamped-dot)))) (if (> angle *adaptive-curvature-threshold*) *adaptive-shrink-factor* 1.0))))"))
(task-entry (id "sim/simulation-stream/sim-total-energy") (skill sim) (module simulation-stream) (tier 2) (difficulty 23340) (name sim-total-energy) (type "(-> Number Number (Stream PhysicsState) (Stream Number))") (description "Extract total mechanical energy stream") (notes ()) (section observable-streams) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time sim-sample sim-sample-loop sim-until sim-positions sim-velocities sim-times sim-kinetic-energy sim-potential-energy)) (answer "(define (sim-total-energy g y-ref stream) (stream-map (lambda (s) (let ((ke (* 0.5 (physics-mass s) (vec2-magnitude-sq (physics-vel s)))) (pe (* (physics-mass s) g (- y-ref (vec2-y (physics-pos s)))))) (+ ke pe))) stream))"))
(task-entry (id "sim/bifurcation/compute-residual-factor") (skill sim) (module bifurcation) (tier 2) (difficulty 23340) (name compute-residual-factor) (type "(-> Nat Number)") (description "Compute step-size factor based on Newton iteration count") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor)) (answer "(define (compute-residual-factor iterations) (cond ((>= iterations *adaptive-residual-critical*) 0.25) ((> iterations *adaptive-residual-threshold*) *adaptive-shrink-factor*) (else 1.0)))"))
(task-entry (id "sim/simulation-stream/make-n-body-state") (skill sim) (module simulation-stream) (tier 2) (difficulty 23341) (name make-n-body-state) (type "(-> (List PhysicsState) Number SimState)") (description "Create state for n-body simulation") (notes ()) (section multi-body-simulation) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time sim-sample sim-sample-loop sim-until sim-positions sim-velocities sim-times sim-kinetic-energy sim-potential-energy sim-total-energy)) (answer "(define (make-n-body-state bodies time) (make-sim-state time (list 'n-body bodies) '()))"))
(task-entry (id "sim/bifurcation/compute-adaptive-step") (skill sim) (module bifurcation) (tier 2) (difficulty 23341) (name compute-adaptive-step) (type "(-> Number (List Number) Number Number)") (description "Compute new step size from factors, respecting min/max bounds") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor)) (answer "(define (compute-adaptive-step current-step factors base-step) (let* ((combined-factor (apply min factors)) (new-step (* current-step combined-factor)) (min-step *adaptive-min-step*) (max-step (* base-step *adaptive-max-step-multiplier*))) (max min-step (min max-step new-step))))"))
(task-entry (id "sim/simulation-stream/n-body-state?") (skill sim) (module simulation-stream) (tier 2) (difficulty 23342) (name n-body-state?) (type "(-> SimState Boolean)") (description "") (notes ()) (section multi-body-simulation) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time sim-sample sim-sample-loop sim-until sim-positions sim-velocities sim-times sim-kinetic-energy sim-potential-energy sim-total-energy make-n-body-state)) (answer "(define (n-body-state? s) (and (sim-state? s) (let ((data (sim-state-data s))) (and (pair? data) (eq? (car data) 'n-body)))))"))
(task-entry (id "sim/bifurcation/should-expand?") (skill sim) (module bifurcation) (tier 2) (difficulty 23342) (name should-expand?) (type "(-> Nat (List Number) Boolean)") (description "Check if step size should be expanded") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step)) (answer "(define (should-expand? good-step-count factors) (and (>= good-step-count *adaptive-expansion-count*) (every (lambda (f) (>= f 1.0)) factors)))"))
(task-entry (id "sim/simulation-stream/n-body-states") (skill sim) (module simulation-stream) (tier 2) (difficulty 23343) (name n-body-states) (type "(-> SimState (List PhysicsState))") (description "") (notes ()) (section multi-body-simulation) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time sim-sample sim-sample-loop sim-until sim-positions sim-velocities sim-times sim-kinetic-energy sim-potential-energy sim-total-energy make-n-body-state n-body-state?)) (answer "(define (n-body-states s) (list-ref (sim-state-data s) 1))"))
(task-entry (id "sim/bifurcation/continue-fixed-point-arclength-adaptive") (skill sim) (module bifurcation) (tier 2) (difficulty 23343) (name continue-fixed-point-arclength-adaptive) (type "(-> ParamODE Number Vec Nat Number (List (List Number Vec Symbol (List Complex))))") (description "Continue a fixed point branch using adaptive pseudo-arclength continuation") (notes ("Adapts step size based on eigenvalue proximity, curvature, and Newton iterations")) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand?)) (answer "(define (continue-fixed-point-arclength-adaptive psys param0 fp0 num-steps base-step) (let* ((n (vector-length fp0)) (sign (if (>= base-step 0) 1 -1)) (abs-base (abs base-step))) (let ((tangent0 (compute-tangent psys param0 fp0))) (if (not tangent0) (list (list param0 fp0 'unknown '())) (let loop ((k 0) (param param0) (fp fp0) (tangent tangent0) (current-step abs-base) (good-steps 0) (prev-tangent #f) (results '())) (if (>= k num-steps) (let* ((sys (instantiate-at psys param)) (analysis (analyze-stability-general sys fp *continuation-step-size*)) (stability (car analysis)) (eigenvalues (cdr analysis)) (final-entry (list param fp stability eigenvalues))) (reverse (cons final-entry results))) (let* ((sys (instantiate-at psys param)) (analysis (analyze-stability-general sys fp *continuation-step-size*)) (stability (car analysis)) (eigenvalues (cdr analysis)) (entry (list param fp stability eigenvalues)) (correct-result (arclength-correct-with-retry psys fp param tangent (* sign current-step) current-step))) (if (not correct-result) (reverse (cons entry results)) (let* ((new-fp (car correct-result)) (new-param (cadr correct-result)) (iterations (caddr correct-result)) (used-step (cadddr correct-result)) (new-tangent (compute-tangent psys new-param new-fp))) (if (not new-tangent) (reverse (cons entry results)) (let* ((oriented-tangent (orient-tangent new-tangent tangent)) (eig-factor (compute-eigenvalue-factor eigenvalues)) (curv-factor (compute-curvature-factor prev-tangent oriented-tangent)) (res-factor (compute-residual-factor iterations)) (factors (list eig-factor curv-factor res-factor)) (all-good (every (lambda (f) (>= f 1.0)) factors)) (new-good-steps (if all-good (+ good-steps 1) 0)) (expanded-step (if (should-expand? new-good-steps factors) (min (* used-step *adaptive-expand-factor*) (* abs-base *adaptive-max-step-multiplier*)) used-step)) (new-step (compute-adaptive-step expanded-step factors abs-base))) (loop (+ k 1) new-param new-fp oriented-tangent new-step (if (should-expand? new-good-steps factors) 0 new-good-steps) oriented-tangent (cons entry results)))))))))))))"))
(task-entry (id "sim/simulation-stream/n-body-step") (skill sim) (module simulation-stream) (tier 2) (difficulty 23344) (name n-body-step) (type "(-> (-> (List PhysicsState) (List Vec2)) Number (-> SimState SimState))") (description "Create step function for n-body simulation") (notes ()) (section multi-body-simulation) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time sim-sample sim-sample-loop sim-until sim-positions sim-velocities sim-times sim-kinetic-energy sim-potential-energy sim-total-energy make-n-body-state n-body-state? n-body-states)) (answer "(define (n-body-step force-fn dt) (lambda (state) (let* ((bodies (n-body-states state)) (forces (force-fn bodies)) (new-bodies (map (lambda (body force) (let* ((pos (physics-pos body)) (vel (physics-vel body)) (inv-m (physics-inv-mass body)) (accel (vec2-scale force inv-m)) (new-vel (vec2-add vel (vec2-scale accel dt))) (new-pos (vec2-add pos (vec2-scale new-vel dt)))) (make-updated-physics body new-pos new-vel))) bodies forces))) (make-n-body-state new-bodies (+ (sim-state-time state) dt)))))"))
(task-entry (id "sim/bifurcation/arclength-correct-with-retry") (skill sim) (module bifurcation) (tier 2) (difficulty 23344) (name arclength-correct-with-retry) (type "(-> ParamODE Vec Number (Pair Vec Number) Number Number (Option (List Vec Number Nat Number)))") (description "Attempt arclength correction with retry on failure") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive)) (answer "(define (arclength-correct-with-retry psys orig-fp orig-param tangent ds current-step) (let retry-loop ((step current-step) (attempts 0)) (if (or (>= attempts 5) (< step *adaptive-min-step*)) #f (let* ((scaled-ds (* (/ step current-step) ds)) (predicted (arclength-predict orig-fp orig-param tangent scaled-ds)) (result (arclength-correct psys (car predicted) (cdr predicted) tangent scaled-ds))) (if result (list (car result) (cadr result) (caddr result) step) (retry-loop (* step *adaptive-shrink-factor*) (+ attempts 1)))))))"))
(task-entry (id "sim/simulation-stream/sim-par") (skill sim) (module simulation-stream) (tier 2) (difficulty 23345) (name sim-par) (type "(-> (List (-> SimState SimState)) (-> (List SimState) (List SimState)))") (description "Run multiple step functions in parallel (for independent subsystems)") (notes ()) (section simulation-combinators) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns sim-take sim-at-time sim-sample sim-sample-loop sim-until sim-positions sim-velocities sim-times sim-kinetic-energy sim-potential-energy sim-total-energy make-n-body-state n-body-state? n-body-states n-body-step)) (answer "(define (sim-par step-fns) (lambda (states) (map (lambda (step state) (step state)) step-fns states)))"))
(task-entry (id "sim/bifurcation/continue-fixed-point-adaptive") (skill sim) (module bifurcation) (tier 2) (difficulty 23345) (name continue-fixed-point-adaptive) (type "(-> ParamODE Number Vec Number Number (List (List Number Vec Symbol (List Complex))))") (description "Continue a fixed point branch with adaptive step size (fixed-parameter method)") (notes ("Uses eigenvalue + residual indicators only (curvature disabled for fixed-param)")) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry)) (answer "(define (continue-fixed-point-adaptive psys param0 fp0 param-end base-step) (let ((direction (if (> param-end param0) 1 -1)) (abs-base (abs base-step))) (let loop ((param param0) (fp fp0) (current-step abs-base) (good-steps 0) (results '())) (if (if (> direction 0) (> param param-end) (< param param-end)) (reverse results) (let* ((sys (instantiate-at psys param)) (analysis (analyze-stability-general sys fp *continuation-step-size*)) (stability (car analysis)) (eigenvalues (cdr analysis)) (entry (list param fp stability eigenvalues)) (next-result (find-fixed-point-with-retry psys param direction fp current-step))) (if (not next-result) (reverse (cons entry results)) (let* ((next-fp (car next-result)) (iterations (cadr next-result)) (used-step (caddr next-result)) (eig-factor (compute-eigenvalue-factor eigenvalues)) (res-factor (compute-residual-factor iterations)) (factors (list eig-factor res-factor)) (all-good (every (lambda (f) (>= f 1.0)) factors)) (new-good-steps (if all-good (+ good-steps 1) 0)) (expanded-step (if (should-expand? new-good-steps factors) (min (* used-step *adaptive-expand-factor*) (* abs-base *adaptive-max-step-multiplier*)) used-step)) (new-step (compute-adaptive-step expanded-step factors abs-base)) (actual-next-param (+ param (* direction used-step)))) (loop actual-next-param next-fp new-step (if (should-expand? new-good-steps factors) 0 new-good-steps) (cons entry results)))))))))"))
