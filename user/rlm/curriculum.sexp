(task-entry (id "diffgeo/curvature/second-fundamental-form") (skill diffgeo) (module curvature) (tier 1) (difficulty 10733) (name second-fundamental-form) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols compute-metric-derivatives christoffel-ref riemann-tensor compute-christoffel-derivatives make-4d-array array-4d-ref array-4d-set! dgamma-ref riemann-ref ricci-tensor scalar-curvature surface? surface-param make-surface surface-at first-fundamental-form)) (answer "(define (second-fundamental-form surf u v . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *curvature-epsilon* (car epsilon-arg))) (n (surface-normal surf u v eps)) (r_uu (surface-partial-uu surf u v eps)) (r_uv (surface-partial-uv surf u v eps)) (r_vv (surface-partial-vv surf u v eps)) (L (vec-dot r_uu n)) (M (vec-dot r_uv n)) (N (vec-dot r_vv n))) (list L M N)))"))
(task-entry (id "diffgeo/geodesics/log-map") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10733) (name log-map) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final trace-geodesic-adaptive-at-times exp-map-adaptive exp-map-adaptive-t log-map-adaptive vec-finite? compute-exp-jacobian-adaptive geodesic-distance-adaptive trace-geodesic trace-geodesic-final exp-map exp-map-t)) (answer "(define (log-map metric p q . opts) (let* ((n-steps (if (null? opts) 100 (car opts))) (tol (if (or (null? opts) (null? (cdr opts))) *geodesic-tolerance* (cadr opts))) (max-iter (if (or (null? opts) (null? (cdr opts)) (null? (cddr opts))) *geodesic-max-iterations* (caddr opts))) (n (vector-length p)) (v0 (vec-sub q p)) (eps 1e-6)) (let loop ((v v0) (iter 0)) (if (>= iter max-iter) (list 'err \"log-map: failed to converge\") (let ((q-shot (exp-map metric p v n-steps))) (if (not (vec-finite? q-shot)) (loop (vec-scale 0.5 v) (+ iter 1)) (let* ((error (vec-sub q-shot q)) (error-norm (vec-norm error))) (if (< error-norm tol) (list 'ok v) (let ((J (compute-exp-jacobian metric p v n-steps eps n))) (if (not J) (loop (vec-scale 0.5 v) (+ iter 1)) (let ((dv (solve-linear-system J (vec-scale -1 error)))) (if dv (loop (vec-add v dv) (+ iter 1)) (loop (vec-sub v (vec-scale 0.1 error)) (+ iter 1))))))))))))))"))
(task-entry (id "diffgeo/forms/exterior-derivative") (skill diffgeo) (module forms) (tier 1) (difficulty 10733) (name exterior-derivative) (type "") (description "") (notes ()) (section exterior-derivative) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices count-inversions-to-sort k-form? k-form-point k-form-chart k-form-degree k-form-components k-form-dim make-k-form k-form-zero k-form-basis cotangent->1-form \x31;-form->cotangent k-form-add k-form-sub k-form-scale k-form-negate k-form-change-chart wedge wedge* interior-product remove-at)) (answer "(define (exterior-derivative omega-field point chart . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *jacobian-epsilon* (car epsilon-arg))) (omega-at-p (omega-field point)) (k (k-form-degree omega-at-p)) (n (chart-dim chart)) (coords (chart-apply chart point))) (if (>= k n) (k-form-zero point chart (+ k 1)) (let* ((indices-k (generate-multi-indices n k)) (indices-k+1 (generate-multi-indices n (+ k 1))) (num-k+1 (binomial n (+ k 1))) (result (make-vector num-k+1 0)) (coords-plus (vec-copy coords)) (coords-minus (vec-copy coords))) (do ((j 0 (+ j 1))) ((= j n)) (let ((cj (vector-ref coords j))) (vector-set! coords-plus j (+ cj eps)) (vector-set! coords-minus j (- cj eps))) (let* ((p-plus (chart-apply-inverse chart coords-plus)) (p-minus (chart-apply-inverse chart coords-minus)) (omega-plus-raw (omega-field p-plus)) (omega-minus-raw (omega-field p-minus)) (omega-plus (k-form-change-chart omega-plus-raw chart)) (omega-minus (k-form-change-chart omega-minus-raw chart)) (comps-plus (k-form-components omega-plus)) (comps-minus (k-form-components omega-minus))) (for-each (lambda (idx-I) (let* ((offset-I (multi-index->offset n idx-I)) (val-plus (vector-ref comps-plus offset-I)) (val-minus (vector-ref comps-minus offset-I)) (deriv (/ (- val-plus val-minus) (* 2 eps)))) (when (not (= deriv 0)) (when (not (member j idx-I)) (let* ((idx-jI (insert-sorted j idx-I)) (sign (insertion-sign j idx-I)) (offset-jI (multi-index->offset n idx-jI)) (contribution (* sign deriv))) (vector-set! result offset-jI (+ (vector-ref result offset-jI) contribution))))))) indices-k)) (let ((cj (vector-ref coords j))) (vector-set! coords-plus j cj) (vector-set! coords-minus j cj))) (make-k-form point chart (+ k 1) result)))))"))
