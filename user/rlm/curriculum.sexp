(task-entry (id "geometry/geometry-optics/triangle3-p1-lens") (skill geometry) (module geometry-optics) (tier 1) (difficulty 12212) (name triangle3-p1-lens) (type "") (description "") (notes ()) (section triangle3-lenses) (deps (\x27;prelude \x27;optics \x27;geometry)) (available (vec3-x-lens vec3-y-lens vec3-z-lens line3-origin-lens line3-direction-lens ray3-origin-lens ray3-direction-lens ray3-origin-x-lens ray3-origin-y-lens ray3-origin-z-lens plane3-normal-lens plane3-d-lens)) (answer "(define triangle3-p1-lens (make-lens triangle3-p1 (lambda (new-p1 t) (triangle3 new-p1 (triangle3-p2 t) (triangle3-p3 t)))))"))
(task-entry (id "geometry/geometry/plane3-d") (skill geometry) (module geometry) (tier 1) (difficulty 12213) (name plane3-d) (type "(-> Plane3 Number)") (description "") (notes ()) (section primitives) (deps (\x27;prelude \x27;vec3 \x27;matrix \x27;quaternion)) (available (point3 line3 line3? line3-origin line3-direction ray3 ray3? ray3-origin ray3-direction ray3-point-at plane3 plane3? plane3-normal)) (answer "(define (plane3-d p) (caddr p))"))
(task-entry (id "geometry/raymarch/adaptive-step") (skill geometry) (module raymarch) (tier 1) (difficulty 12213) (name adaptive-step) (type "(-> (-> Vec3 Real) Vec3 Real)") (description "Compute adaptive step size based on local SDF variation") (notes ("Can skip larger steps in areas of low curvature")) (section performance-optimization) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (raymarch-params raymarch-params-max-steps raymarch-params-max-distance raymarch-params-hit-threshold default-raymarch-params raymarch raymarch-mesh sdf-normal mesh-sdf-normal raymarch-shadow raymarch-ao simple-shading render-pixel)) (answer "(define (adaptive-step sdf-fn point) (let* ((dist (sdf-fn point)) (curvature-eps 0.1) (d-fwd (sdf-fn (vec3-add point (vec3 curvature-eps 0 0)))) (d-back (sdf-fn (vec3-sub point (vec3 curvature-eps 0 0)))) (variation (abs (- d-fwd d-back)))) (if (< variation 0.01) (* dist 1.5) dist)))"))
(task-entry (id "geometry/octree/partition-triangles-octants") (skill geometry) (module octree) (tier 1) (difficulty 12213) (name partition-triangles-octants) (type "(-> (List Triangle3) (List (Pair Vec3 Real)) (List (List Triangle3)))") (description "Partition triangles into 8 lists (one per octant)") (notes ()) (section octree-construction) (deps (\x27;prelude \x27;geometry)) (available (octree-leaf octree-node octree-leaf? octree-node? octree-center octree-size octree-primitives octree-children octree-build all-children-leaves? subdivide-octants triangle-intersects-octant? aabb-overlaps?)) (answer "(define (partition-triangles-octants triangles octants) (map (lambda (octant) (let ((center (car octant)) (size (cadr octant))) (filter (lambda (tri) (triangle-intersects-octant? tri center size)) triangles))) octants))"))
(task-entry (id "geometry/bvh/bvh-intersect-ray") (skill geometry) (module bvh) (tier 1) (difficulty 12213) (name bvh-intersect-ray) (type "") (description "") (notes ()) (section bvh-traversal) (deps (\x27;prelude \x27;geometry \x27;sort)) (available (bvh-leaf bvh-node bvh-leaf? bvh-node? bvh-bbox bvh-primitives bvh-left bvh-right triangle-centroid compute-triangles-bbox longest-axis get-axis-coord bvh-build)) (answer "(define (bvh-intersect-ray bvh ray) (letrec ((traverse (lambda (node closest-t closest-tri) (cond ((not node) (if closest-tri (list closest-tri closest-t) #f)) ((not (intersect-ray-aabb ray (bvh-bbox node))) (if closest-tri (list closest-tri closest-t) #f)) ((bvh-leaf? node) (let loop ((tris (bvh-primitives node)) (best-t closest-t) (best-tri closest-tri)) (if (null? tris) (if best-tri (list best-tri best-t) #f) (let* ((tri (car tris)) (t (intersect-ray-triangle ray tri))) (if (and t (or (not best-t) (< t best-t))) (loop (cdr tris) t tri) (loop (cdr tris) best-t best-tri)))))) ((bvh-node? node) (let* ((left-result (traverse (bvh-left node) closest-t closest-tri)) (new-closest-t (if left-result (cadr left-result) closest-t)) (new-closest-tri (if left-result (car left-result) closest-tri)) (right-result (traverse (bvh-right node) new-closest-t new-closest-tri))) (or right-result left-result))) (else (if closest-tri (list closest-tri closest-t) #f)))))) (traverse bvh #f #f)))"))
(task-entry (id "geometry/ascii-render/camera-ray") (skill geometry) (module ascii-render) (tier 1) (difficulty 12213) (name camera-ray) (type "(-> Camera Number Number Ray3)") (description "Generate ray for normalized screen coords u,v in [-1,1]") (notes ()) (section camera-and-ray-generation) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (ascii-ramp ascii-ramp-len intensity->char rgb->ansi256 ansi-fg ansi-reset make-camera camera-pos camera-forward camera-right camera-up camera-half-width camera-half-height)) (answer "(define (camera-ray cam u v) (let* ((pos (camera-pos cam)) (dir (vec3-normalize (vec3-add (vec3-add (camera-forward cam) (vec3-scale (camera-right cam) (* u (camera-half-width cam)))) (vec3-scale (camera-up cam) (* v (camera-half-height cam))))))) (ray3 pos dir)))"))
