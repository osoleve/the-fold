(task-entry (id "data/graph-matrix/complete-graph") (skill data) (module graph-matrix) (tier 0) (difficulty 1327) (name complete-graph) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize adjacency-symmetrize-sparse degree-matrix degree-matrix-sparse)) (answer "(define (complete-graph n . opts) (let ((data (make-vector (* n n) 1))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n n data)) (vector-set! data (+ (* i n) i) 0))))"))
