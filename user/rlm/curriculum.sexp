(task-entry (id "control-systems/controller-design/pid-design-zn-closed-loop") (skill control-systems) (module controller-design) (tier 2) (difficulty 22602) (name pid-design-zn-closed-loop) (type "Number × Number → (Kp Ki Kd)") (description "Ziegler-Nichols closed-loop (ultimate gain) tuning") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop)) (answer "(define (pid-design-zn-closed-loop Ku Tu) (let* ((Kp (* 0.6 Ku)) (Ti (* 0.5 Tu)) (Td (* 0.125 Tu)) (Ki (/ Kp Ti)) (Kd (* Kp Td))) (list Kp Ki Kd)))"))
