(task-entry (id "meta/dag/lattice-deps-transitive") (skill meta) (module dag) (tier 1) (difficulty 11902) (name lattice-deps-transitive) (type "") (description "") (notes ()) (section transitive-closure) (deps ()) (available (lattice-deps lattice-uses)) (answer "(define (lattice-deps-transitive skill-name) (let loop ((to-visit (kg-deps skill-name)) (visited '())) (if (null? to-visit) (reverse visited) (let ((current (car to-visit)) (rest (cdr to-visit))) (if (memq current visited) (loop rest visited) (loop (append (kg-deps current) rest) (cons current visited)))))))"))
