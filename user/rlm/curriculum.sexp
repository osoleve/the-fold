(task-entry (id "meta/bm25/count-terms") (skill meta) (module bm25) (tier 1) (difficulty 11916) (name count-terms) (type "") (description "") (notes ()) (section term-operations) (deps (core/base/prelude.ss)) (available (BM25-K1 BM25-B bm25-create bm25-doc-count bm25-total-length bm25-term-doc-freq bm25-doc-term-freq bm25-doc-lengths bm25-doc-data bm25-avg-doc-length tokenize split-hyphenated string-split-on-char string-split-words word-char? string-downcase)) (answer "(define (count-terms terms) (let loop ((terms terms) (counts '())) (if (null? terms) counts (let* ((term (car terms)) (entry (assq term counts))) (if entry (loop (cdr terms) (cons (cons term (+ 1 (cdr entry))) (remove-assq term counts))) (loop (cdr terms) (cons (cons term 1) counts)))))))"))
