(task-entry (id "geometry/convex-hull/convex-hull-perimeter") (skill geometry) (module convex-hull) (tier 1) (difficulty 12217) (name convex-hull-perimeter) (type "") (description "") (notes ()) (section utilities) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line find-furthest-from-line quickhull-recurse quickhull convex-hull convex-hull-area)) (answer "(define (convex-hull-perimeter hull) (if (< (length hull) 2) 0 (let ((first (car hull))) (let loop ((remaining hull) (sum 0)) (if (null? remaining) sum (let* ((p1 (car remaining)) (p2 (if (null? (cdr remaining)) first (cadr remaining)))) (loop (cdr remaining) (+ sum (sqrt (point2-distance-sq p1 p2))))))))))"))
(task-entry (id "geometry/voronoi/build-edge-adjacency") (skill geometry) (module voronoi) (tier 1) (difficulty 12217) (name build-edge-adjacency) (type "") (description "") (notes ()) (section adjacency) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key)) (answer "(define (build-edge-adjacency triangles) (let ((adj (make-hashtable equal-hash equal?))) (do ((i 0 (+ i 1))) ((>= i (vector-length triangles)) adj) (let* ((tri (vector-ref triangles i)) (p1 (tri2-p1 tri)) (p2 (tri2-p2 tri)) (p3 (tri2-p3 tri)) (e1 (voronoi-edge-key (canonical-edge p1 p2))) (e2 (voronoi-edge-key (canonical-edge p2 p3))) (e3 (voronoi-edge-key (canonical-edge p3 p1)))) (hashtable-update! adj e1 (lambda (v) (cons i v)) '()) (hashtable-update! adj e2 (lambda (v) (cons i v)) '()) (hashtable-update! adj e3 (lambda (v) (cons i v)) '())))))"))
