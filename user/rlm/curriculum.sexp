(task-entry (id "random/variational-inference/sample-full-gaussian") (skill random) (module variational-inference) (tier 1) (difficulty 12921) (name sample-full-gaussian) (type "") (description "") (notes ()) (section full-covariance-gaussian) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam)) (answer "(define (sample-full-gaussian vfamily prng) (let-values (((epsilons new-prng) (sample-standard-normals (full-gaussian-dim vfamily) prng))) (values (full-gaussian-reparam vfamily epsilons) new-prng)))"))
