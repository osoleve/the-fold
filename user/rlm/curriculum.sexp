(task-entry (id "tiles/core/tile-get-prop") (skill tiles) (module core) (tier 1) (difficulty 12311) (name tile-get-prop) (type "(-> Tile Symbol Any Any)") (description "Get a property from tile data with default value") (notes ()) (section tile-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks?)) (answer "(define (tile-get-prop tile prop default) (let ((data (tile-data tile))) (if (and (pair? data) (assq prop data)) (cdr (assq prop data)) default)))"))
(task-entry (id "tiles/square/square-distance") (skill tiles) (module square) (tier 1) (difficulty 12311) (name square-distance) (type "(-> Coord Coord Symbol Number)") (description "Generic distance function with metric type") (notes ()) (section distance-metrics) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho square-neighbors-diag square-neighbors-all square-neighbors square-distance-manhattan square-distance-chebyshev square-distance-euclidean)) (answer "(define (square-distance c1 c2 metric) (case metric ((manhattan) (square-distance-manhattan c1 c2)) ((chebyshev) (square-distance-chebyshev c1 c2)) ((euclidean) (square-distance-euclidean c1 c2)) (else (error 'square-distance \"Invalid metric\" metric))))"))
(task-entry (id "tiles/hex/hex-distance") (skill tiles) (module hex) (tier 1) (difficulty 12311) (name hex-distance) (type "(-> AxialCoord AxialCoord Integer)") (description "Manhattan distance in hex space (minimum number of hex steps). This is the natural distance metric for hexagons.") (notes ()) (section distance) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial hex-axial-directions hex-neighbor hex-neighbors hex-neighbors-at-distance)) (answer "(define (hex-distance c1 c2) (let* ((cube1 (axial->cubic c1)) (cube2 (axial->cubic c2)) (dx (abs (- (cubic-coord%-x cube2) (cubic-coord%-x cube1)))) (dy (abs (- (cubic-coord%-y cube2) (cubic-coord%-y cube1)))) (dz (abs (- (cubic-coord%-z cube2) (cubic-coord%-z cube1))))) (quotient (+ dx dy dz) 2)))"))
(task-entry (id "tiles/triangle/triangle-neighbors") (skill tiles) (module triangle) (tier 1) (difficulty 12311) (name triangle-neighbors) (type "(-> TriangleCoord Symbol (List TriangleCoord))") (description "Generic neighbor function. Mode: 'edge, 'vertex, or 'all") (notes ()) (section neighbors) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge triangle-neighbors-vertex triangle-neighbors-all)) (answer "(define (triangle-neighbors coord mode) (case mode ((edge) (triangle-neighbors-edge coord)) ((vertex) (triangle-neighbors-vertex coord)) ((all) (triangle-neighbors-all coord)) (else (error 'triangle-neighbors \"Invalid mode\" mode))))"))
