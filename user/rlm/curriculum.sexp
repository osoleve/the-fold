(task-entry (id "algebra/multivariate/mono-merge") (skill algebra) (module multivariate) (tier 0) (difficulty 310) (name mono-merge) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul)) (answer "(define (mono-merge m1 m2) (cond ((null? m1) m2) ((null? m2) m1) (else (let ((v1 (caar m1)) (e1 (cdar m1)) (v2 (caar m2)) (e2 (cdar m2))) (cond ((symbol<? v1 v2) (cons (car m1) (mono-merge (cdr m1) m2))) ((symbol<? v2 v1) (cons (car m2) (mono-merge m1 (cdr m2)))) (else (let ((sum (+ e1 e2))) (if (= sum 0) (mono-merge (cdr m1) (cdr m2)) (cons (cons v1 sum) (mono-merge (cdr m1) (cdr m2)))))))))))"))
(task-entry (id "algebra/groebner/any-divides-lm?") (skill algebra) (module groebner) (tier 0) (difficulty 310) (name any-divides-lm?) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger buchberger-loop buchberger-criterion-1? all-pairs reduce-basis mpoly-make-monic minimize-basis)) (answer "(define (any-divides-lm? p G) (let ((lm-p (mpoly-leading-mono p))) (any (lambda (g) (mono-divides? (mpoly-leading-mono g) lm-p)) G)))"))
