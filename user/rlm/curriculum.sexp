(task-entry (id "linalg/graph-laplacian/is-bipartite-spectral?") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 418) (name is-bipartite-spectral?) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue)) (answer "(define (is-bipartite-spectral? adj . opts) (let* ((tol (if (null? opts) 1e-6 (car opts))) (L-norm (laplacian-normalized adj)) (eigs (eigenvalues L-norm))) (if (and (pair? eigs) (eq? (car eigs) 'error)) eigs (let ((max-eig (let loop ((i 0) (m 0)) (if (= i (vector-length eigs)) m (loop (+ i 1) (max m (vector-ref eigs i))))))) (< (abs (- max-eig 2.0)) tol)))))"))
(task-entry (id "linalg/svd/low-rank-approx") (skill linalg) (module svd) (tier 0) (difficulty 418) (name low-rank-approx) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin matrix-slice-cols matrix-slice pseudoinverse build-sigma-pseudoinverse)) (answer "(define (low-rank-approx a k . opts) (let* ((m (matrix-rows a)) (n (matrix-cols a)) (max-k (min m n))) (cond ((< k 0) (quasiquote (error invalid-rank (unquote k)))) ((> k max-k) (quasiquote (error rank-exceeds-dimension (unquote k) (unquote max-k)))) (else (let* ((tol (if (pair? opts) (car opts) *svd-tolerance*)) (svd-result (svd a *svd-max-iterations* tol))) (if (and (pair? svd-result) (eq? (car svd-result) 'error)) svd-result (let* ((u (car svd-result)) (sigma (cadr svd-result)) (v (caddr svd-result)) (u-k (matrix-slice-cols u 0 k)) (sigma-k (matrix-slice sigma 0 k 0 k)) (v-k (matrix-slice-cols v 0 k)) (v-k-t (matrix-transpose v-k)) (u-sigma (matrix-mul u-k sigma-k))) (matrix-mul u-sigma v-k-t))))))))"))
