(task-entry (id "statistics/families/compute-null-deviance") (skill statistics) (module families) (tier 1) (difficulty 11215) (name compute-null-deviance) (type "") (description "") (notes ()) (section family-structure) (deps (\x27;prelude \x27;transcendental)) (available (make-glm-family glm-family? family-name family-variance family-deviance-contrib family-valid-mu? family-initialize gaussian-family binomial-family poisson-family gamma-family inverse-gaussian-family quasi-poisson-family quasi-binomial-family compute-deviance)) (answer "(define (compute-null-deviance family y) (let* ((n (vector-length y)) (y-mean (let loop ((i 0) (s 0)) (if (= i n) (/ s n) (loop (+ i 1) (+ s (vector-ref y i)))))) (mu-null (make-vector n y-mean))) (compute-deviance family y mu-null)))"))
(task-entry (id "statistics/link-functions/cloglog-link") (skill statistics) (module link-functions) (tier 1) (difficulty 11215) (name cloglog-link) (type "") (description "") (notes ()) (section link-function-structure) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available (make-link-function link-function? link-name link-g link-inverse link-derivative identity-link logit-link log-link probit-link probit-quantile probit-cdf probit-pdf inverse-link sqrt-link)) (answer "(define cloglog-link (make-link-function 'cloglog (lambda (mu) (let ((mu-safe (max (min mu (- 1 1e-10)) 1e-10))) (log (- (log (- 1 mu-safe)))))) (lambda (eta) (let ((eta-clamp (max (min eta 10) -10))) (- 1 (exp (- (exp eta-clamp)))))) (lambda (mu) (let* ((mu-safe (max (min mu (- 1 1e-10)) 1e-10)) (one-minus-mu (- 1 mu-safe)) (neg-log (- (log one-minus-mu)))) (/ 1 (* one-minus-mu (max neg-log 1e-10)))))))"))
