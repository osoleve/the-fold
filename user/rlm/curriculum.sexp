(task-entry (id "random/distributions/random-normal-standard") (skill random) (module distributions) (tier 1) (difficulty 12907) (name random-normal-standard) (type "") (description "") (notes ()) (section standard-normal) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive?)) (answer "(define random-normal-standard (state-bind random-float (lambda (u1) (state-bind random-float (lambda (u2) (let* ((r (sqrt (* -2 (safe-log u1)))) (theta (* 2 (pi-value) u2))) (state-pure (* r (cos-num theta)))))))))"))
(task-entry (id "random/probability/run-prob") (skill random) (module probability) (tier 1) (difficulty 12907) (name run-prob) (type "") (description "") (notes ()) (section running-probability-computations) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight)) (answer "(define (run-prob p prng) (let ((result (run-state (prob-state p) (cons prng 0.0)))) (let ((value (car result)) (final-state (cdr result))) (cons (cons value (cdr final-state)) (car final-state)))))"))
(task-entry (id "random/bayesian/beta-posterior-variance") (skill random) (module bayesian) (tier 1) (difficulty 12907) (name beta-posterior-variance) (type "") (description "") (notes ()) (section conjugate-prior-beta-binomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode)) (answer "(define (beta-posterior-variance prior) (let* ((alpha (beta-prior-alpha prior)) (beta (beta-prior-beta prior)) (sum (+ alpha beta))) (/ (* alpha beta) (* sum sum (+ sum 1)))))"))
(task-entry (id "random/monte-carlo/sample-max") (skill random) (module monte-carlo) (tier 1) (difficulty 12907) (name sample-max) (type "") (description "") (notes ()) (section statistical-summary-functions) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min)) (answer "(define (sample-max samples) (if (null? samples) -inf.0 (fold-left max (car samples) (cdr samples))))"))
(task-entry (id "random/variational-inference/sample-standard-normals") (skill random) (module variational-inference) (tier 1) (difficulty 12907) (name sample-standard-normals) (type "") (description "") (notes ()) (section reparameterization-trick) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim)) (answer "(define (sample-standard-normals n prng) (let loop ((k n) (rng prng) (acc '())) (if (= k 0) (values (reverse acc) rng) (let* ((result (run-state (random-normal 0 1) rng)) (sample (car result)) (new-rng (cdr result))) (loop (- k 1) new-rng (cons sample acc))))))"))
