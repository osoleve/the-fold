(task-entry (id "fp/simplify/simplify") (skill fp) (module simplify) (tier 1) (difficulty 10601) (name simplify) (type "(-> Expr Expr)") (description "Simplify expression using algebraic rules, applying repeatedly until fixed point") (notes ()) (section main-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric)) (answer "(define (simplify expr) (let ((simplified (simplify-once expr))) (if (expr=? simplified expr) simplified (simplify simplified))))"))
(task-entry (id "fp/integrate/integrate-internal") (skill fp) (module integrate) (tier 1) (difficulty 10601) (name integrate-internal) (type "(-> Expr Symbol Nat (Maybe Expr))") (description "Internal integration with depth tracking to prevent infinite recursion") (notes ()) (section main-integration) (deps (\x27;diff \x27;simplify)) (available (integrate)) (answer "(define (integrate-internal expr var-sym depth) (if (> depth 20) #f (or (integrate-table expr var-sym) (integrate-basic expr var-sym depth) (integrate-by-substitution expr var-sym depth) (integrate-by-parts expr var-sym depth) (integrate-partial-fractions expr var-sym depth))))"))
