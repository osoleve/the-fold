(task-entry (id "optimization/first-order/newton-schulz") (skill optimization) (module first-order) (tier 1) (difficulty 12812) (name newton-schulz) (type "(-> Matrix Nat Matrix)") (description "Newton-Schulz iteration for matrix orthogonalization") (notes ("For convergence, pre-scale M so spectral norm < sqrt(3).\nThis implementation uses Frobenius norm as a conservative bound.")) (section muon) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum adam adam-full rmsprop rmsprop-full adagrad adagrad-full gradient-descent-ls nesterov newton-schulz-step)) (answer "(define (newton-schulz m num-iters) (let* ((rows (matrix-rows m)) (cols (matrix-cols m)) (frob (frobenius-norm m)) (scale-factor (if (< frob 1e-12) 1.0 (/ 1.0 (max frob 1.0)))) (m-scaled (matrix-scale scale-factor m))) (let loop ((x m-scaled) (i 0)) (if (>= i num-iters) x (loop (newton-schulz-step x) (+ i 1))))))"))
(task-entry (id "optimization/newton/jacobian-numerical") (skill optimization) (module newton) (tier 1) (difficulty 12812) (name jacobian-numerical) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton make-positive-definite newton-cg newton-cg-full cg-newton-direction hessian-vector-product gauss-newton gradient-ls)) (answer "(define (jacobian-numerical r x) (let* ((n (length x)) (r0 (apply r x)) (m (length r0)) (eps 1e-7) (data (make-vector (* m n) 0))) (do ((j 0 (+ j 1))) ((= j n) (matrix-from-data m n data)) (let* ((x+ (list-update x j (lambda (v) (+ v eps)))) (r+ (apply r x+))) (do ((i 0 (+ i 1))) ((= i m)) (vector-set! data (+ (* i n) j) (/ (- (list-ref r+ i) (list-ref r0 i)) eps)))))))"))
(task-entry (id "optimization/lbfgs/lbfgs") (skill optimization) (module lbfgs) (tier 1) (difficulty 12812) (name lbfgs) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list lbfgs-history-push take-n lbfgs-direction lbfgs-two-loop initial-hessian-scale)) (answer "(define (lbfgs f x0 criteria) (lbfgs-full f x0 10 criteria))"))
