(task-entry (id "egraph/eclass/enode-canonicalize") (skill egraph) (module eclass) (tier 1) (difficulty 10006) (name enode-canonicalize) (type "(-> ENode UnionFind ENode)") (description "Return e-node with children resolved to their canonical e-class IDs.") (notes ()) (section canonical) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity)) (answer "(define (enode-canonicalize enode uf) (let* ((children (enode-children enode)) (n (vector-length children)) (canonical (make-vector n #f))) (do ((i 0 (+ i 1))) ((>= i n)) (vector-set! canonical i (uf-find uf (vector-ref children i)))) (make-enode (enode-op enode) canonical)))"))
