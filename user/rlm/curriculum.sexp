(task-entry (id "geometry/raymarch/raymarch-ao") (skill geometry) (module raymarch) (tier 1) (difficulty 12210) (name raymarch-ao) (type "(-> (-> Vec3 Real) Vec3 Vec3 Nat Real)") (description "Compute ambient occlusion factor (0 = fully occluded, 1 = no occlusion)") (notes ("Uses multiple samples along normal direction")) (section ambient-occlusion) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (raymarch-params raymarch-params-max-steps raymarch-params-max-distance raymarch-params-hit-threshold default-raymarch-params raymarch raymarch-mesh sdf-normal mesh-sdf-normal raymarch-shadow)) (answer "(define (raymarch-ao sdf-fn point normal num-samples) (max 0.0 (- 1.0 (let sample-ao ((i 0) (total 0) (sum 0.0)) (if (>= i num-samples) (/ sum num-samples) (let* ((step-size (* (+ i 1) 0.1)) (sample-point (vec3-add point (vec3-scale normal step-size))) (dist (sdf-fn sample-point)) (occlusion (- step-size dist)) (weight (/ 1.0 (expt 2.0 i)))) (sample-ao (+ i 1) total (+ sum (* weight (max 0.0 occlusion))))))))))"))
(task-entry (id "geometry/octree/subdivide-octants") (skill geometry) (module octree) (tier 1) (difficulty 12210) (name subdivide-octants) (type "(-> Vec3 Real (List (Pair Vec3 Real)))") (description "Return 8 octant centers and sizes") (notes ()) (section octree-construction) (deps (\x27;prelude \x27;geometry)) (available (octree-leaf octree-node octree-leaf? octree-node? octree-center octree-size octree-primitives octree-children octree-build all-children-leaves?)) (answer "(define (subdivide-octants center size) (let* ((cx (vec3-x center)) (cy (vec3-y center)) (cz (vec3-z center)) (hs (* size 0.5))) (list (list (vec3 (- cx hs) (- cy hs) (- cz hs)) hs) (list (vec3 (- cx hs) (- cy hs) (+ cz hs)) hs) (list (vec3 (- cx hs) (+ cy hs) (- cz hs)) hs) (list (vec3 (- cx hs) (+ cy hs) (+ cz hs)) hs) (list (vec3 (+ cx hs) (- cy hs) (- cz hs)) hs) (list (vec3 (+ cx hs) (- cy hs) (+ cz hs)) hs) (list (vec3 (+ cx hs) (+ cy hs) (- cz hs)) hs) (list (vec3 (+ cx hs) (+ cy hs) (+ cz hs)) hs))))"))
(task-entry (id "geometry/bvh/longest-axis") (skill geometry) (module bvh) (tier 1) (difficulty 12210) (name longest-axis) (type "(-> AABB Nat)") (description "") (notes ()) (section helpers) (deps (\x27;prelude \x27;geometry \x27;sort)) (available (bvh-leaf bvh-node bvh-leaf? bvh-node? bvh-bbox bvh-primitives bvh-left bvh-right triangle-centroid compute-triangles-bbox)) (answer "(define (longest-axis bbox) (let* ((extents (aabb-extents bbox)) (x (vec3-x extents)) (y (vec3-y extents)) (z (vec3-z extents))) (cond ((and (>= x y) (>= x z)) 0) ((and (>= y x) (>= y z)) 1) (else 2))))"))
