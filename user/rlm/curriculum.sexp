(task-entry (id "geometry/obj-loader/string-split") (skill geometry) (module obj-loader) (tier 1) (difficulty 12203) (name string-split) (type "") (description "") (notes ()) (section obj-parsing) (deps (\x27;prelude \x27;geometry)) (available (parse-obj-line parse-vertex parse-face)) (answer "(define (string-split str delim) (let loop ((chars (string->list str)) (current '()) (result '())) (cond ((null? chars) (reverse (if (null? current) result (cons (list->string (reverse current)) result)))) ((char=? (car chars) delim) (loop (cdr chars) '() (if (null? current) result (cons (list->string (reverse current)) result)))) (else (loop (cdr chars) (cons (car chars) current) result)))))"))
(task-entry (id "geometry/ascii-render/rgb->ansi256") (skill geometry) (module ascii-render) (tier 1) (difficulty 12203) (name rgb->ansi256) (type "(-> Number Number Number Number)") (description "Convert RGB [0,1] to ANSI 256-color code") (notes ()) (section ansi-color-codes) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (ascii-ramp ascii-ramp-len intensity->char)) (answer "(define (rgb->ansi256 r g b) (let ((ri (min 5 (max 0 (inexact->exact (round (* r 5)))))) (gi (min 5 (max 0 (inexact->exact (round (* g 5)))))) (bi (min 5 (max 0 (inexact->exact (round (* b 5))))))) (+ 16 (* ri 36) (* gi 6) bi)))"))
