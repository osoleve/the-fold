(task-entry (id "data/kdtree/kdtree-delete-rec") (skill data) (module kdtree) (tier 0) (difficulty 1338) (name kdtree-delete-rec) (type "") (description "") (notes ()) (section deletion) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater? kdtree-knn knn-heap->list kdtree-knn-rec kdtree-range kdtree-range-rec point-in-box? kdtree-radius kdtree-size kdtree-height kdtree-balanced? kdtree-fold kdtree->list kdtree-insert kdtree-insert-rec kdtree-insert-2d kdtree-insert-3d kdtree-delete kdtree-delete-2d kdtree-delete-3d)) (answer "(define (kdtree-delete-rec tree point k depth) (if (kdtree-empty? tree) tree (let* ((node-point (kdtree-point tree)) (axis (modulo depth k)) (pt-coord (point-coord point axis)) (nd-coord (point-coord node-point axis))) (cond ((points-equal? point node-point) (kdtree-delete-node tree k depth)) ((< pt-coord nd-coord) (kdtree-node node-point (kdtree-delete-rec (kdtree-left tree) point k (+ depth 1)) (kdtree-right tree) depth)) ((> pt-coord nd-coord) (kdtree-node node-point (kdtree-left tree) (kdtree-delete-rec (kdtree-right tree) point k (+ depth 1)) depth)) (else (if (kdtree-member-rec (kdtree-left tree) point k (+ depth 1)) (kdtree-node node-point (kdtree-delete-rec (kdtree-left tree) point k (+ depth 1)) (kdtree-right tree) depth) (kdtree-node node-point (kdtree-left tree) (kdtree-delete-rec (kdtree-right tree) point k (+ depth 1)) depth)))))))"))
(task-entry (id "data/quadtree/quadtree-knn") (skill data) (module quadtree) (tier 0) (difficulty 1338) (name quadtree-knn) (type "(-> Quadtree Num Num Nat (List Point))") (description "Find k nearest points to (qx, qy). Returns list sorted by distance (closest first).\nO(k log n) average case. Uses max-heap to track k closest candidates with distance-based pruning.") (notes ()) (section k-nearest-neighbors) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build quadtree-build-auto list->quadtree quadtree-insert quadtree-insert-at-depth quadtree-split quadtree-range quadtree-range-rect quadtree-radius quadtree-nearest quadtree-nearest-rec bounds-min-dist-sq sort-by-bounds-dist quadtree-knn-pair-greater?)) (answer "(define (quadtree-knn tree qx qy k-count) (if (or (quadtree-empty? tree) (<= k-count 0)) '() (let* ((result-heap (quadtree-knn-rec tree qx qy k-count heap-empty)) (pairs (quadtree-knn-heap->list result-heap))) (reverse (map cdr pairs)))))"))
