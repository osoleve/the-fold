(task-entry (id "algebra/galois/make-gf2n-large") (skill algebra) (module galois) (tier 0) (difficulty 326) (name make-gf2n-large) (type "(-> Nat Int Field)") (description "Create GF(2^n) without enumeration, for large n") (notes ()) (section gf2n-binary-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n)) (answer "(define (make-gf2n-large n irred) (let ((order (bitwise-arithmetic-shift-left 1 n))) (make-field* '() (lambda (a b) (make-gf2n-element (bitwise-xor (gf2n-value a) (gf2n-value b)) n irred)) (lambda (a b) (make-gf2n-element (gf2n-mul-raw (gf2n-value a) (gf2n-value b) n irred) n irred)) (make-gf2n-element 0 n irred) (make-gf2n-element 1 n irred) (lambda (a) a) (lambda (a b) (make-gf2n-element (gf2n-mul-raw (gf2n-value a) (gf2n-inv-raw (gf2n-value b) n irred) n irred) n irred)) (lambda (a b) (= (gf2n-value a) (gf2n-value b))) (quasiquote ((order unquote order) (characteristic . 2) (degree unquote n))))))"))
