(task-entry (id "clp/domain/make-domain") (skill clp) (module domain) (tier 1) (difficulty 10800) (name make-domain) (type "(-> Int Int Domain)") (description "Create a domain from a range [lo, hi]") (notes ()) (section domain-constructors) (deps (\x27;prelude \x27;sort)) (available ()) (answer "(define (make-domain lo hi) (if (> lo hi) '() (list (cons lo hi))))"))
(task-entry (id "clp/store/make-cstore") (skill clp) (module store) (tier 1) (difficulty 10800) (name make-cstore) (type "(-> CStore)") (description "Create an empty constraint store") (notes ()) (section constraint-store-structure) (deps (\x27;prelude \x27;logic \x27;domain)) (available ()) (answer "(define (make-cstore) (list 'cstore empty-subst '() '() '()))"))
(task-entry (id "clp/fd-constraints/in-range") (skill clp) (module fd-constraints) (tier 1) (difficulty 10800) (name in-range) (type "(-> LVar Int Int (-> CStore (Maybe CStore)))") (description "Constrain variable to be in range [lo, hi]") (notes ()) (section domain-declaration-constraints) (deps (\x27;store)) (available ()) (answer "(define (in-range var lo hi) (lambda (cs) (cstore-narrow-domain cs var (make-domain lo hi))))"))
(task-entry (id "clp/global-constraints/all-different") (skill clp) (module global-constraints) (tier 1) (difficulty 10800) (name all-different) (type "(-> (List LVar) (-> CStore (Maybe CStore)))") (description "Constrain all variables to have different values") (notes ("Uses combination of: (1) Remove singleton values from other domains (2) Check for Hall set violations")) (section all-different-constraint) (deps (\x27;propagate)) (available ()) (answer "(define (all-different vars) (lambda (cs) (all-different-propagate cs vars)))"))
(task-entry (id "clp/propagate/propagate") (skill clp) (module propagate) (tier 1) (difficulty 10800) (name propagate) (type "(-> CStore (Maybe CStore))") (description "Run propagation until fixpoint or failure using default fuel limit") (notes ()) (section propagation-loop) (deps (\x27;fd-constraints)) (available ()) (answer "(define (propagate cs) (propagate-with-fuel cs 10000))"))
(task-entry (id "clp/label/input-order") (skill clp) (module label) (tier 1) (difficulty 10800) (name input-order) (type "(-> CStore (List LVar) (Maybe LVar))") (description "Select the first unbound (non-singleton domain) variable") (notes ()) (section variable-ordering-strategies) (deps (\x27;propagate)) (available ()) (answer "(define (input-order cs vars) (let loop ((vars vars)) (cond ((null? vars) #f) (else (let ((var (car vars)) (dom (cstore-get-domain cs (car vars)))) (cond ((or (not dom) (not (domain-singleton? dom))) var) (else (loop (cdr vars)))))))))"))
(task-entry (id "clp/clp/clp-succeed") (skill clp) (module clp) (tier 1) (difficulty 10800) (name clp-succeed) (type "(-> CStore (Stream CStore))") (description "Goal that always succeeds with the given store") (notes ()) (section goal-constructors) (deps (\x27;global-constraints \x27;label)) (available ()) (answer "(define (clp-succeed cs) (stream-cons cs (lambda () stream-nil)))"))
(task-entry (id "fp/dsl/union-interpreter") (skill fp) (module dsl) (tier 1) (difficulty 10801) (name union-interpreter) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;free \x27;effects)) (available (make-instruction instruction-tag instruction-payload instruction-cont dsl-fmap dsl-pure dsl-pure? dsl-suspended? dsl-pure-value dsl-instruction dsl-bind dsl-map dsl-emit dsl-request make-interpreter interpreter? interpreter-handler run-dsl run-dsl-helper run-dsl-eff run-dsl-state dsl-trace layered-interpreter composed-interpreter expr-lit expr-var expr-binop expr-unop expr-app expr-if expr-let expr-lambda expr-lit? expr-var? expr-binop? expr-unop? expr-app? expr-if? expr-let? expr-lambda? expr-lit-value expr-var-name expr-binop-op expr-binop-left expr-binop-right expr-unop-op expr-unop-operand expr-app-fn expr-app-args expr-if-cond expr-if-then expr-if-else expr-let-name expr-let-value expr-let-body expr-lambda-params expr-lambda-body eval-expr apply-binop apply-unop apply-closure stmt-assign stmt-seq stmt-if stmt-while stmt-return stmt-expr stmt-assign? stmt-seq? stmt-if? stmt-while? stmt-return? stmt-expr? stmt-assign-var stmt-assign-expr stmt-seq-stmts stmt-if-cond stmt-if-then stmt-if-else stmt-while-cond stmt-while-body stmt-return-expr stmt-expr-expr run-stmt run-stmt-seq run-stmt-while dsl-sequence dsl-for-each dsl-fold dsl-when dsl-unless dsl-replicate dsl-ap dsl-ap2 dsl-ap3 dsl-join dsl-kleisli dsl-fish dsl-compose make-tagless-dsl tagless-dsl? tagless-ops instantiate-tagless tagless-op make-source-pos source-pos? source-pos-line source-pos-col source-pos-offset no-source-pos make-located located? located-value located-pos make-located-instruction instruction-pos dsl-emit-at dsl-request-at format-source-pos dsl-error-at middleware-identity middleware-compose middleware-stack middleware-logging middleware-timing current-time middleware-cache middleware-guard middleware-transform with-middleware dsl-fold-program dsl-instruction-list dsl-program-depth dsl-uses-tag? dsl-tag-histogram dsl-optimize-dead-code dsl-fuse dsl-fix dsl-lazy make-bounce make-done bounce? done? bounce-thunk done-value run-trampoline run-dsl-trampolined run-dsl-trampoline-helper make-mock-interpreter dsl-test-case dsl-test-error dsl-programs-equiv? dsl-interpreter-equiv? make-recording-interpreter verify-instruction-sequence calc-push! calc-add! calc-sub! calc-mul! calc-div! calc-dup! calc-swap! calc-pop! make-calc-interpreter run-calc forward! back! left! right! penup! pendown! getpos! make-turtle-interpreter run-turtle repeat dsl-ok dsl-err dsl-ok? dsl-err? dsl-ok-value dsl-err-tag dsl-err-message dsl-result-map dsl-result-bind run-dsl-safe dsl-fail dsl-assert make-fail-handler dsl-peek dsl-count-instructions dsl-trace-when dsl-trace-tags dsl-pretty-print dsl-collect-tags dsl-left-tag dsl-right-tag dsl-left-tag? dsl-right-tag? dsl-unwrap-tag dsl-inject-left dsl-inject-right)) (answer "(define (union-interpreter left-interp right-interp) (let ((left-handler (interpreter-handler left-interp)) (right-handler (interpreter-handler right-interp))) (make-interpreter (lambda (tag payload) (cond ((dsl-left-tag? tag) (left-handler (dsl-unwrap-tag tag) payload)) ((dsl-right-tag? tag) (right-handler (dsl-unwrap-tag tag) payload)) (else (error 'union-interpreter \"Unknown instruction side\" tag)))))))"))
(task-entry (id "clp/domain/domain-singleton") (skill clp) (module domain) (tier 1) (difficulty 10801) (name domain-singleton) (type "(-> Int Domain)") (description "Create a domain containing a single value") (notes ()) (section domain-constructors) (deps (\x27;prelude \x27;sort)) (available (make-domain)) (answer "(define (domain-singleton n) (list (cons n n)))"))
(task-entry (id "clp/store/cstore?") (skill clp) (module store) (tier 1) (difficulty 10801) (name cstore?) (type "(-> α Bool)") (description "Check if value is a constraint store") (notes ()) (section constraint-store-structure) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore)) (answer "(define (cstore? x) (and (pair? x) (eq? (car x) 'cstore) (= (length x) 5)))"))
(task-entry (id "clp/fd-constraints/in-domain") (skill clp) (module fd-constraints) (tier 1) (difficulty 10801) (name in-domain) (type "(-> LVar (List Int) (-> CStore (Maybe CStore)))") (description "Constrain variable to be one of the given values") (notes ()) (section domain-declaration-constraints) (deps (\x27;store)) (available (in-range)) (answer "(define (in-domain var values) (lambda (cs) (cstore-narrow-domain cs var (domain-from-list values))))"))
(task-entry (id "clp/global-constraints/all-different-propagate") (skill clp) (module global-constraints) (tier 1) (difficulty 10801) (name all-different-propagate) (type "(-> CStore (List LVar) (Maybe CStore))") (description "Propagate all-different constraint") (notes ()) (section all-different-constraint) (deps (\x27;propagate)) (available (all-different)) (answer "(define (all-different-propagate cs vars) (let ((cs1 (remove-singletons cs vars))) (if (not cs1) #f (if (check-singleton-conflict cs1 vars) #f cs1))))"))
(task-entry (id "clp/propagate/propagate-with-fuel") (skill clp) (module propagate) (tier 1) (difficulty 10801) (name propagate-with-fuel) (type "(-> CStore Nat (Maybe CStore))") (description "Propagation with explicit fuel limit to prevent infinite loops") (notes ()) (section propagation-loop) (deps (\x27;fd-constraints)) (available (propagate)) (answer "(define (propagate-with-fuel cs fuel) (if (<= fuel 0) cs (let ((popped (cstore-pop-pending cs))) (if (not popped) cs (let* ((var-id (car popped)) (cs1 (cdr popped)) (constraints (cstore-constraints cs1))) (let ((relevant (filter-constraints-by-var-id constraints var-id))) (propagate-constraints cs1 relevant (- fuel 1))))))))"))
(task-entry (id "clp/label/first-fail") (skill clp) (module label) (tier 1) (difficulty 10801) (name first-fail) (type "(-> CStore (List LVar) (Maybe LVar))") (description "Select the variable with smallest domain (fail first)") (notes ()) (section variable-ordering-strategies) (deps (\x27;propagate)) (available (input-order)) (answer "(define (first-fail cs vars) (let loop ((vars vars) (best #f) (best-size +inf.0)) (if (null? vars) best (let* ((var (car vars)) (dom (cstore-get-domain cs var))) (cond ((not dom) (loop (cdr vars) (or best var) best-size)) ((domain-singleton? dom) (loop (cdr vars) best best-size)) (else (let ((size (domain-size dom))) (if (< size best-size) (loop (cdr vars) var size) (loop (cdr vars) best best-size)))))))))"))
(task-entry (id "clp/clp/clp-fail") (skill clp) (module clp) (tier 1) (difficulty 10801) (name clp-fail) (type "(-> CStore (Stream CStore))") (description "Goal that always fails") (notes ()) (section goal-constructors) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed)) (answer "(define (clp-fail cs) stream-nil)"))
(task-entry (id "fp/dsl/make-dsl-schema") (skill fp) (module dsl) (tier 1) (difficulty 10802) (name make-dsl-schema) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;free \x27;effects)) (available (make-instruction instruction-tag instruction-payload instruction-cont dsl-fmap dsl-pure dsl-pure? dsl-suspended? dsl-pure-value dsl-instruction dsl-bind dsl-map dsl-emit dsl-request make-interpreter interpreter? interpreter-handler run-dsl run-dsl-helper run-dsl-eff run-dsl-state dsl-trace layered-interpreter composed-interpreter expr-lit expr-var expr-binop expr-unop expr-app expr-if expr-let expr-lambda expr-lit? expr-var? expr-binop? expr-unop? expr-app? expr-if? expr-let? expr-lambda? expr-lit-value expr-var-name expr-binop-op expr-binop-left expr-binop-right expr-unop-op expr-unop-operand expr-app-fn expr-app-args expr-if-cond expr-if-then expr-if-else expr-let-name expr-let-value expr-let-body expr-lambda-params expr-lambda-body eval-expr apply-binop apply-unop apply-closure stmt-assign stmt-seq stmt-if stmt-while stmt-return stmt-expr stmt-assign? stmt-seq? stmt-if? stmt-while? stmt-return? stmt-expr? stmt-assign-var stmt-assign-expr stmt-seq-stmts stmt-if-cond stmt-if-then stmt-if-else stmt-while-cond stmt-while-body stmt-return-expr stmt-expr-expr run-stmt run-stmt-seq run-stmt-while dsl-sequence dsl-for-each dsl-fold dsl-when dsl-unless dsl-replicate dsl-ap dsl-ap2 dsl-ap3 dsl-join dsl-kleisli dsl-fish dsl-compose make-tagless-dsl tagless-dsl? tagless-ops instantiate-tagless tagless-op make-source-pos source-pos? source-pos-line source-pos-col source-pos-offset no-source-pos make-located located? located-value located-pos make-located-instruction instruction-pos dsl-emit-at dsl-request-at format-source-pos dsl-error-at middleware-identity middleware-compose middleware-stack middleware-logging middleware-timing current-time middleware-cache middleware-guard middleware-transform with-middleware dsl-fold-program dsl-instruction-list dsl