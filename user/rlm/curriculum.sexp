(task-entry (id "dataset/distractor/format-numeric-option") (skill dataset) (module distractor) (tier 1) (difficulty 13421) (name format-numeric-option) (type "") (description "") (notes ()) (section assembly) (deps (\x27;prelude \x27;prng \x27;parameter \x27;sort)) (available (make-distractor-strategy distractor-strategy? distractor-strategy-name distractor-strategy-generator distractor-nearby distractor-sign-flip distractor-off-by-one distractor-double-half distractor-wrong-sign-convention distractor-order-swap distractor-random-choice distractor-formula-variant apply-distractor generate-distractors member-approx? approx-equal? generate-filler-distractors numeric-distractors counting-distractors comparison-distractors velocity-distractors)) (answer "(define (format-numeric-option n) (if (integer? n) (number->string (inexact->exact n)) (let ((s (number->string (exact->inexact n)))) (if (> (string-length s) 8) (let ((dot-pos (string-find s #\\.))) (if dot-pos (substring s 0 (min (string-length s) (+ dot-pos 3))) (substring s 0 8))) s))))"))
(task-entry (id "dataset/difficulty/check-temporal-resolution") (skill dataset) (module difficulty) (tier 1) (difficulty 13421) (name check-temporal-resolution) (type "") (description "Check that objects move at most 3 characters per frame") (notes ()) (section solvability) (deps (\x27;prelude)) (available (make-difficulty-vector difficulty-vec? dv-inference-depth dv-object-count dv-temporal-steps dv-visual-precision dv-formula-complexity inference-direct inference-derivative inference-latent inference-system classify-inference-depth difficulty-weights difficulty-score difficulty-score-default difficulty-tier tier-order tier-compare make-solvability-check solvability-check? solvability-constraints)) (answer "(define (check-temporal-resolution max-velocity dt scale) (let ((chars-per-frame (* max-velocity dt scale))) (<= chars-per-frame 3.0)))"))
