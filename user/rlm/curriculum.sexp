(task-entry (id "data/set/set-difference") (skill data) (module set) (tier 0) (difficulty 1307) (name set-difference) (type "(-> Set Set Set)") (description "Elements in set1 but not in set2") (notes ()) (section none) (deps (\x27;prelude)) (available (set-empty set-empty? set-member? set-add set-remove set-union set-intersection)) (answer "(define (set-difference set1 set2) (let loop ((remaining set1) (acc '())) (cond ((null? remaining) (reverse acc)) ((set-member? (car remaining) set2) (loop (cdr remaining) acc)) (else (loop (cdr remaining) (cons (car remaining) acc))))))"))
