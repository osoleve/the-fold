(task-entry (id "dsl/tagless/make-pe-dict") (skill dsl) (module tagless) (tier 1) (difficulty 11781) (name make-pe-dict) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops dict-ref dict-has? dict-extend dict-merge make-expr-dict expr-lit expr-add expr-neg eval-expr-dict pretty-expr-dict count-expr-dict depth-expr-dict example-expr-1 example-expr-2 make-mul-dict expr-mul eval-mul-dict pretty-mul-dict example-mul make-bool-dict bool-lit bool-and bool-or bool-not eval-bool-dict pretty-bool-dict make-cmp-dict cmp-eq cmp-lt cmp-gt eval-full-dict make-cond-dict cond-if-lazy eval-cond-dict pretty-cond-dict make-lazy-cond-dict lazy-if eval-lazy-cond-dict make-let-dict tl-let tl-var make-env-expr-dict env-lit env-add env-neg env-let env-var run-env-expr example-let make-stateful-dict state-get state-put state-pure state-bind state-monad-dict run-state make-chronicle-dict ch-scene ch-choice ch-guard ch-effect ch-text ch-start ch-choose ch-render validate-chronicle-dict graph-chronicle-dict with-logging with-tracing with-memoization run-both twice fold-expr tagless-to-free free-to-tagless optimize-neg-neg optimize-expr run-optimized)) (answer "(define (make-pe-dict) (make-dict 'partial-eval (quasiquote ((lit unquote (lambda (n) (list 'static n))) (add unquote (lambda (x y) (cond ((and (eq? (car x) 'static) (eq? (car y) 'static)) (list 'static (+ (cadr x) (cadr y)))) (else (list 'dynamic (lambda () (+ (if (eq? (car x) 'static) (cadr x) ((cadr x))) (if (eq? (car y) 'static) (cadr y) ((cadr y)))))))))) (neg unquote (lambda (x) (if (eq? (car x) 'static) (list 'static (- (cadr x))) (list 'dynamic (lambda () (- ((cadr x))))))))))))"))
