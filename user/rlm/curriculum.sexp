(task-entry (id "optimization/lp/create-phase1-lp") (skill optimization) (module lp) (tier 1) (difficulty 12828) (name create-phase1-lp) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize extract-basis-matrix extract-basis-costs compute-reduced-costs find-entering-variable vec-contains? compute-direction find-leaving-variable update-basis)) (answer "(define (create-phase1-lp A b) (let* ((m (matrix-rows A)) (n (matrix-cols A)) (eye-m (matrix-identity m)) (A-aug (matrix-hstack A eye-m)) (c-phase1 (vec-append (vec-zeros n) (vec-ones m))) (init-basis (make-vector m 0))) (do ((i 0 (+ i 1))) ((= i m)) (vector-set! init-basis i (+ n i))) (cons (make-lp c-phase1 A-aug b) init-basis)))"))
