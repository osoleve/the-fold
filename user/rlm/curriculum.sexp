(task-entry (id "diffgeo/charts/atlas-add-chart") (skill diffgeo) (module charts) (tier 1) (difficulty 10721) (name atlas-add-chart) (type "") (description "") (notes ()) (section atlas-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp)) (available (chart? chart-name chart-dim chart-domain-pred chart-coord-map chart-inverse-map make-chart chart-contains? chart-apply chart-apply-inverse make-transition transition-apply *jacobian-epsilon* jacobian-numerical transition-jacobian atlas? atlas-name atlas-charts make-atlas atlas-dim atlas-chart-count)) (answer "(define (atlas-add-chart atlas chart) (let ((charts (atlas-charts atlas)) (dim (atlas-dim atlas))) (cond ((and dim (not (= dim (chart-dim chart)))) (quasiquote (error dimension-mismatch (unquote dim) (unquote (chart-dim chart))))) (else (list 'atlas (atlas-name atlas) (cons chart charts))))))"))
(task-entry (id "diffgeo/tangent/cotangent-add") (skill diffgeo) (module tangent) (tier 1) (difficulty 10721) (name cotangent-add) (type "") (description "") (notes ()) (section tangent-vector-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts)) (available (tangent-vector? tangent-vector-point tangent-vector-chart tangent-vector-components tangent-vector-dim make-tangent-vector tangent-zero tangent-basis-vector tangent-add tangent-sub tangent-scale tangent-negate tangent-change-chart cotangent-vector? cotangent-vector-point cotangent-vector-chart cotangent-vector-components cotangent-vector-dim make-cotangent-vector cotangent-zero cotangent-basis-form)) (answer "(define (cotangent-add cv1 cv2) (let ((p1 (cotangent-vector-point cv1)) (p2 (cotangent-vector-point cv2)) (c1 (cotangent-vector-chart cv1)) (c2 (cotangent-vector-chart cv2))) (cond ((not (equal? p1 p2)) (quasiquote (error different-base-points))) ((not (eq? (chart-name c1) (chart-name c2))) (quasiquote (error different-charts (unquote (chart-name c1)) (unquote (chart-name c2))))) (else (make-cotangent-vector p1 c1 (vec-add (cotangent-vector-components cv1) (cotangent-vector-components cv2)))))))"))
(task-entry (id "diffgeo/lie-groups/so3?") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10721) (name so3?) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp so2-log)) (answer "(define (so3? x) (and (pair? x) (eq? (car x) 'so3) (= (length x) 2) (matrix? (cadr x)) (= (matrix-rows (cadr x)) 3) (= (matrix-cols (cadr x)) 3)))"))
(task-entry (id "diffgeo/curvature/make-4d-array") (skill diffgeo) (module curvature) (tier 1) (difficulty 10721) (name make-4d-array) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols compute-metric-derivatives christoffel-ref riemann-tensor compute-christoffel-derivatives)) (answer "(define (make-4d-array n) (let ((arr (make-vector n #f))) (do ((i 0 (+ i 1))) ((= i n) arr) (let ((arr-i (make-vector n #f))) (do ((j 0 (+ j 1))) ((= j n)) (let ((arr-ij (make-vector n #f))) (do ((k 0 (+ k 1))) ((= k n)) (vector-set! arr-ij k (make-vector n 0))) (vector-set! arr-i j arr-ij))) (vector-set! arr i arr-i)))))"))
(task-entry (id "diffgeo/geodesics/trace-geodesic-adaptive-final") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10721) (name trace-geodesic-adaptive-final) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive)) (answer "(define (trace-geodesic-adaptive-final metric initial-coords initial-velocity T tol) (let* ((state0 (make-geodesic-state initial-coords initial-velocity)) (dt0 (/ T 10)) (min-dt (* T 1e-10))) (let loop ((state state0) (t 0) (dt dt0) (k1-cache #f)) (if (>= t T) state (let ((h (min dt (- T t)))) (if (< h min-dt) state (let* ((result (adaptive-geodesic-step metric state h tol k1-cache)) (new-state (car result)) (actual-h (cadr result)) (suggested-h (caddr result)) (k7 (car (cddddr result)))) (loop new-state (+ t actual-h) suggested-h k7))))))))"))
(task-entry (id "diffgeo/forms/k-form-basis") (skill diffgeo) (module forms) (tier 1) (difficulty 10721) (name k-form-basis) (type "") (description "") (notes ()) (section k-form) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices count-inversions-to-sort k-form? k-form-point k-form-chart k-form-degree k-form-components k-form-dim make-k-form k-form-zero)) (answer "(define (k-form-basis point chart idx) (let* ((n (chart-dim chart)) (k (length idx)) (num-components (binomial n k)) (components (make-vector num-components 0)) (offset (multi-index->offset n idx))) (vector-set! components offset 1) (make-k-form point chart k components)))"))
