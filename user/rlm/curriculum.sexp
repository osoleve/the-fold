(task-entry (id "dataset/jsonl/iso-roundtrip-check") (skill dataset) (module jsonl) (tier 1) (difficulty 13411) (name iso-roundtrip-check) (type "") (description "") (notes ()) (section iso) (deps (core/base/prelude.ss lattice/optics/optics.ss lattice/dataset/sample.ss)) (available (make-json-object json-object? json-object-pairs make-json-array json-array? json-array-items sample->json json->sample value->json json->value sample-json-iso)) (answer "(define (iso-roundtrip-check s) (let* ((json (sample->json s)) (back (json->sample json))) (and (string=? (sample-id s) (sample-id back)) (equal? (sample-frames s) (sample-frames back)) (string=? (sample-question s) (sample-question back)) (eq? (sample-answer s) (sample-answer back)))))"))
