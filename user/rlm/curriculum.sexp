(task-entry (id "dataset/sample/sample->prompt") (skill dataset) (module sample) (tier 1) (difficulty 13431) (name sample->prompt) (type "") (description "") (notes ()) (section rendering) (deps (\x27;prelude \x27;optics \x27;parameter)) (available (make-sample sample? sample-id sample-frames sample-question sample-options sample-answer sample-metadata sample-id-lens sample-frames-lens sample-question-lens sample-options-lens sample-answer-lens sample-metadata-lens sample-category sample-difficulty sample-params sample-with-meta make-qa-lens qa-lens? qa-lens-question qa-lens-answer qa-extract-question qa-extract-answer make-option option-label option-text make-options option-by-label fisher-yates-shuffle shuffle-options)) (answer "(define (sample->prompt s) (let* ((frames (sample-frames s)) (question (sample-question s)) (options (sample-options s)) (frame-str (apply string-append (map (lambda (f) (string-append f \"\n\n\")) frames))) (opt-str (apply string-append (map (lambda (o) (string-append (symbol->string (car o)) \") \" (cdr o) \"\n\")) options)))) (string-append frame-str question \"\n\n\" opt-str)))"))
(task-entry (id "dataset/parameter/params-interpolate") (skill dataset) (module parameter) (tier 1) (difficulty 13431) (name params-interpolate) (type "") (description "") (notes ()) (section interpolation) (deps (\x27;prelude \x27;prng \x27;distributions)) (available (make-prng prng-next-float prng-next-int make-param-range param-range? param-range-name param-range-min param-range-max param-range-strategy param-range-constraint uniform-range range-int range-normal range-choice param-range-choice? param-range-choice-name param-range-choice-values param-range-choice-constraint range-with-constraint param-sample-raw sample-normal param-sample param-sample-default make-param-set param-set? param-set-ranges param-set-joint-constraint param-set-sample-raw param-set-sample param-get param-interpolate)) (answer "(define (params-interpolate ps params1 params2 t) (map (lambda (r) (let* ((name (cond ((param-range? r) (param-range-name r)) ((param-range-choice? r) (param-range-choice-name r)) (else 'unnamed))) (v1 (param-get params1 name)) (v2 (param-get params2 name))) (cons name (param-interpolate r v1 v2 t)))) (param-set-ranges ps)))"))
