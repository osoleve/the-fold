(task-entry (id "egraph/eclass/enode-equal?") (skill egraph) (module eclass) (tier 1) (difficulty 10007) (name enode-equal?) (type "(-> ENode ENode Boolean)") (description "Check structural equality of two e-nodes.") (notes ()) (section canonical) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize)) (answer "(define (enode-equal? e1 e2) (and (equal? (enode-op e1) (enode-op e2)) (let ((c1 (enode-children e1)) (c2 (enode-children e2))) (and (= (vector-length c1) (vector-length c2)) (let loop ((i 0)) (or (>= i (vector-length c1)) (and (= (vector-ref c1 i) (vector-ref c2 i)) (loop (+ i 1)))))))))"))
