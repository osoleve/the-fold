(task-entry (id "random/probability/rejection-sample") (skill random) (module probability) (tier 1) (difficulty 12942) (name rejection-sample) (type "") (description "") (notes ()) (section rejection-sampling) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist condition assume sample-once sample-many weighted-samples log-sum-exp normalize-log-weights importance-expectation importance-mean importance-variance)) (answer "(define (rejection-sample p seed max-tries) (let loop ((prng (make-pcg seed 1)) (tries max-tries)) (if (<= tries 0) nothing (let* ((result (run-prob p prng)) (value (car (car result))) (log-w (cdr (car result))) (new-prng (cdr result))) (if (> log-w -inf.0) (just value) (loop new-prng (- tries 1)))))))"))
