(task-entry (id "fp/simplify/simplify-app") (skill fp) (module simplify) (tier 1) (difficulty 10619) (name simplify-app) (type "(-> Symbol Expr Expr)") (description "Simplify function application with known identities") (notes ()) (section function-application-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow)) (answer "(define (simplify-app fn arg) (cond ((and (eq? fn 'sin) (num? arg) (= (num-val arg) 0)) (num 0)) ((and (eq? fn 'cos) (num? arg) (= (num-val arg) 0)) (num 1)) ((and (eq? fn 'tan) (num? arg) (= (num-val arg) 0)) (num 0)) ((and (eq? fn 'exp) (num? arg) (= (num-val arg) 0)) (num 1)) ((and (eq? fn 'log) (num? arg) (= (num-val arg) 1)) (num 0)) ((and (eq? fn 'log) (var? arg) (eq? (var-name arg) 'e)) (num 1)) ((and (eq? fn 'exp) (app? arg) (eq? (app-fn arg) 'log)) (app-arg arg)) ((and (eq? fn 'log) (app? arg) (eq? (app-fn arg) 'exp)) (app-arg arg)) ((and (eq? fn 'log) (power? arg)) (product (pow-exp arg) (make-app 'log (pow-base arg)))) ((and (eq? fn 'sqrt) (num? arg) (= (num-val arg) 0)) (num 0)) ((and (eq? fn 'sqrt) (num? arg) (= (num-val arg) 1)) (num 1)) ((and (eq? fn 'sqrt) (power? arg) (num? (pow-exp arg)) (= (num-val (pow-exp arg)) 2)) (make-app 'abs (pow-base arg))) ((and (eq? fn 'sinh) (num? arg) (= (num-val arg) 0)) (num 0)) ((and (eq? fn 'cosh) (num? arg) (= (num-val arg) 0)) (num 1)) ((and (eq? fn 'tanh) (num? arg) (= (num-val arg) 0)) (num 0)) ((and (eq? fn 'atan) (num? arg) (= (num-val arg) 0)) (num 0)) ((and (eq? fn 'asin) (num? arg) (= (num-val arg) 0)) (num 0)) ((and (eq? fn 'acos) (num? arg) (= (num-val arg) 1)) (num 0)) ((and (eq? fn 'sin) (app? arg) (eq? (app-fn arg) 'asin)) (app-arg arg)) ((and (eq? fn 'cos) (app? arg) (eq? (app-fn arg) 'acos)) (app-arg arg)) ((and (eq? fn 'tan) (app? arg) (eq? (app-fn arg) 'atan)) (app-arg arg)) (else (make-app fn arg))))"))
(task-entry (id "fp/integrate/liate-priority") (skill fp) (module integrate) (tier 1) (difficulty 10619) (name liate-priority) (type "") (description "") (notes ()) (section integration-by-parts) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power integrate-quotient integrate-by-substitution try-substitution-pattern find-antiderivative-match find-u-candidates substitute-u can-express-in-u? replace-with-u try-trig-substitution integrate-by-parts sort-by-liate)) (answer "(define (liate-priority expr) (cond ((and (app? expr) (eq? (app-fn expr) 'log)) 0) ((and (app? expr) (memq (app-fn expr) '(asin acos atan))) 1) ((or (var? expr) (power? expr) (polynomial? expr)) 2) ((and (app? expr) (memq (app-fn expr) '(sin cos tan))) 3) ((and (app? expr) (eq? (app-fn expr) 'exp)) 4) ((num? expr) 5) (else 3)))"))
(task-entry (id "fp/solve/solve-cubic") (skill fp) (module solve) (tier 1) (difficulty 10619) (name solve-cubic) (type "(-> Expr Symbol (Maybe (List Expr)))") (description "Solve cubic equation ax³ + bx² + cx + d = 0 using Cardano's formula") (notes ("Converts to depressed cubic, returns all 3 roots using cube roots of unity")) (section cubic-solving) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms solve-linear solve-quadratic)) (answer "(define (solve-cubic expr var-sym) (let ((coeffs (extract-poly-coefficients expr var-sym))) (if (or (not coeffs) (not (= (length coeffs) 4))) #f (let* ((d (list-ref coeffs 0)) (c (list-ref coeffs 1)) (b (list-ref coeffs 2)) (a (list-ref coeffs 3)) (b/a (simplify (division b a))) (c/a (simplify (division c a))) (d/a (simplify (division d a))) (b2/3a2 (simplify (division (power b/a (num 2)) (num 3)))) (p (simplify (difference c/a b2/3a2))) (q (simplify (sum (difference d/a (division (product b/a c/a) (num 3))) (division (product (num 2) (power b/a (num 3))) (num 27))))) (disc-inner (simplify (sum (division (power q (num 2)) (num 4)) (division (power p (num 3)) (num 27))))) (sqrt-disc (sym-sqrt disc-inner)) (neg-q/2 (simplify (division (make-neg q) (num 2)))) (u-arg (simplify (sum neg-q/2 sqrt-disc))) (v-arg (simplify (difference neg-q/2 sqrt-disc))) (cbrt-u (power u-arg (division (num 1) (num 3)))) (cbrt-v (power v-arg (division (num 1) (num 3)))) (omega (division (sum (num -1) (product (var 'i) (sym-sqrt (num 3)))) (num 2))) (omega2 (division (difference (num -1) (product (var 'i) (sym-sqrt (num 3)))) (num 2))) (t1 (simplify (sum cbrt-u cbrt-v))) (t2 (simplify (sum (product omega cbrt-u) (product omega2 cbrt-v)))) (t3 (simplify (sum (product omega2 cbrt-u) (product omega cbrt-v)))) (shift (simplify (division b/a (num 3)))) (x1 (simplify (difference t1 shift))) (x2 (simplify (difference t2 shift))) (x3 (simplify (difference t3 shift)))) (list x1 x2 x3)))))"))
(task-entry (id "fp/poly-canonical/expr-factored") (skill fp) (module poly-canonical) (tier 1) (difficulty 10619) (name expr-factored) (type "") (description "") (notes ()) (section square-free-factorization) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial polynomial-expr? expr-degree extract-poly-coeffs extract-coeff-at extract-coeff-expanded extract-coeff-product expr-eval-at-zero polynomial->expr make-term simplify-rational partial-fractions partial-fractions-linear poly-divide-expr to-polynomial-form expr-poly-gcd expr-poly-lcm expr-square-free)) (answer "(define (expr-factored expr var-sym) (let ((poly (expr->polynomial expr var-sym Q-field-sym))) (if poly (map (lambda (pair) (cons (polynomial->expr (car pair) var-sym) (cdr pair))) (poly-square-free-factorization poly)) (list (cons expr 1)))))"))
