(task-entry (id "fp/integrate/polynomial?") (skill fp) (module integrate) (tier 1) (difficulty 10620) (name polynomial?) (type "") (description "") (notes ()) (section integration-by-parts) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power integrate-quotient integrate-by-substitution try-substitution-pattern find-antiderivative-match find-u-candidates substitute-u can-express-in-u? replace-with-u try-trig-substitution integrate-by-parts sort-by-liate liate-priority)) (answer "(define (polynomial? expr) (cond ((num? expr) #t) ((var? expr) #t) ((sum? expr) (for-all polynomial? (sum-terms expr))) ((product? expr) (for-all polynomial? (product-factors expr))) ((and (power? expr) (num? (pow-exp expr)) (integer? (num-val (pow-exp expr))) (>= (num-val (pow-exp expr)) 0)) (polynomial? (pow-base expr))) (else #f)))"))
(task-entry (id "fp/solve/solve-polynomial") (skill fp) (module solve) (tier 1) (difficulty 10620) (name solve-polynomial) (type "") (description "") (notes ()) (section cubic-solving) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms solve-linear solve-quadratic solve-cubic)) (answer "(define (solve-polynomial expr var-sym) (let ((deg (polynomial-degree expr var-sym))) (cond ((< deg 0) #f) ((= deg 0) (let ((simplified (simplify expr))) (if (and (num? simplified) (= (num-val simplified) 0)) 'infinite '()))) ((= deg 1) (let ((sol (solve-linear expr var-sym))) (if sol (list sol) #f))) ((= deg 2) (solve-quadratic expr var-sym)) ((= deg 3) (solve-cubic expr var-sym)) (else (let ((coeffs (extract-poly-coefficients expr var-sym))) (if coeffs (quasiquote ((roots-of (unquote (cons '+ (map (lambda (c k) (product c (power (var var-sym) (num k)))) coeffs (iota (length coeffs)))))))) #f))))))"))
