(task-entry (id "fp/parser/merge-errors") (skill fp) (module parser) (tier 1) (difficulty 10626) (name merge-errors) (type "(-> Error Error Error)") (description "Merge two errors, keeping the one at furthest position") (notes ()) (section parse-error) (deps (\x27;prelude \x27;combinators)) (available (%newline %tab %return %backspace %page make-pos pos? pos-line pos-col pos-offset parser-initial-pos advance-pos parser-make-state parser-state? parser-state-input parser-state-index parser-state-pos parser-state-remaining parser-state-at-end? parser-state-current-char parser-initial-state make-parse-error parse-error? error-pos error-message error-expected)) (answer "(define (merge-errors e1 e2) (let ((p1 (pos-offset (error-pos e1))) (p2 (pos-offset (error-pos e2)))) (cond ((> p1 p2) e1) ((< p1 p2) e2) (else (make-parse-error (error-pos e1) (error-message e1) (append (error-expected e1) (error-expected e2)))))))"))
