(task-entry (id "game-theory/matching/build-rank-table") (skill game-theory) (module matching) (tier 1) (difficulty 13214) (name build-rank-table) (type "") (description "") (notes ()) (section gale-shapley) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks)) (answer "(define (build-rank-table prefs) (let loop ((prefs prefs) (rank 0) (table '())) (if (null? prefs) table (loop (cdr prefs) (+ rank 1) (cons (cons (car prefs) rank) table)))))"))
(task-entry (id "game-theory/voting/borda-scores") (skill game-theory) (module voting) (tier 1) (difficulty 13214) (name borda-scores) (type "") (description "") (notes ()) (section positional-rules) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores)) (answer "(define (borda-scores m) (if (<= m 0) '() (let loop ((i 0) (acc '())) (if (>= i m) (reverse acc) (loop (+ i 1) (cons (- m 1 i) acc))))))"))
(task-entry (id "game-theory/strategic-voting/find-manipulation-in-profile") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13214) (name find-manipulation-in-profile) (type "") (description "") (notes ()) (section gibbard-satterthwaite) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium all-strategic-equilibria cartesian-product-n price-of-anarchy price-of-stability count-manipulable-profiles strategy-proofness-ratio compare-strategy-proofness find-manipulation-example)) (answer "(define (find-manipulation-in-profile profile voting-rule) (let* ((n (length profile)) (true-winner (voting-rule profile))) (let search-voter ((i 0)) (if (>= i n) 'not-found (let* ((true-ranking (list-ref profile i)) (true-utility (voter-utility true-winner true-ranking))) (let search-ballot ((ballots (permutations (profile-candidates profile)))) (if (null? ballots) (search-voter (+ i 1)) (let* ((fake-ballot (car ballots)) (fake-profile (list-set profile i fake-ballot)) (fake-winner (voting-rule fake-profile)) (fake-utility (voter-utility fake-winner true-ranking))) (if (> fake-utility true-utility) (list 'found i profile fake-ballot true-winner fake-winner (- fake-utility true-utility)) (search-ballot (cdr ballots)))))))))))"))
(task-entry (id "game-theory/voting-games/voting-power-comparison") (skill game-theory) (module voting-games) (tier 1) (difficulty 13214) (name voting-power-comparison) (type "") (description "") (notes ()) (section power-analysis) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning?)) (answer "(define (voting-power-comparison profile rules) (map (lambda (rule-pair) (let ((name (car rule-pair)) (rule (cdr rule-pair))) (cons name (banzhaf-voting-power profile)))) rules))"))
