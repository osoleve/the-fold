(task-entry (id "dsl/reader/readtable-stack-lookup") (skill dsl) (module reader) (tier 1) (difficulty 11711) (name readtable-stack-lookup) (type "") (description "") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available (make-readtable readtable? readtable-entries readtable-lookup readtable-extend readtable-remove make-readtable-stack readtable-stack? readtable-stack-push readtable-stack-pop readtable-stack-current)) (answer "(define (readtable-stack-lookup stack char) (let loop ((remaining stack)) (if (null? remaining) nothing (let ((result (readtable-lookup (car remaining) char))) (if (just? result) result (loop (cdr remaining)))))))"))
