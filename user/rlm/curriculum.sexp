(task-entry (id "diffgeo/geodesics/solve-linear-system") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10735) (name solve-linear-system) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final trace-geodesic-adaptive-at-times exp-map-adaptive exp-map-adaptive-t log-map-adaptive vec-finite? compute-exp-jacobian-adaptive geodesic-distance-adaptive trace-geodesic trace-geodesic-final exp-map exp-map-t log-map compute-exp-jacobian)) (answer "(define (solve-linear-system A b) (let* ((n (vector-length b)) (aug (make-vector n #f))) (do ((i 0 (+ i 1))) ((= i n)) (let ((row (make-vector (+ n 1) 0))) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! row j (matrix-ref A i j))) (vector-set! row n (vector-ref b i)) (vector-set! aug i row))) (let forward ((k 0)) (if (>= k n) (let ((x (make-vector n 0))) (let back ((i (- n 1))) (if (< i 0) x (let ((row (vector-ref aug i)) (sum (vector-ref row n))) (do ((j (+ i 1) (+ j 1))) ((= j n)) (set! sum (- sum (* (vector-ref row j) (vector-ref x j))))) (let ((pivot (vector-ref row i))) (if (< (abs pivot) 1e-15) #f (begin (vector-set! x i (/ sum pivot)) (back (- i 1))))))))) (let* ((max-row k) (max-val (abs (vector-ref (vector-ref aug k) k)))) (do ((i (+ k 1) (+ i 1))) ((= i n)) (let ((val (abs (vector-ref (vector-ref aug i) k)))) (when (> val max-val) (set! max-val val) (set! max-row i)))) (if (< max-val 1e-15) #f (begin (when (not (= k max-row)) (let ((tmp (vector-ref aug k))) (vector-set! aug k (vector-ref aug max-row)) (vector-set! aug max-row tmp))) (let ((pivot-row (vector-ref aug k)) (pivot (vector-ref (vector-ref aug k) k))) (do ((i (+ k 1) (+ i 1))) ((= i n)) (let* ((row (vector-ref aug i)) (factor (/ (vector-ref row k) pivot))) (do ((j k (+ j 1))) ((= j (+ n 1))) (vector-set! row j (- (vector-ref row j) (* factor (vector-ref pivot-row j)))))))) (forward (+ k 1)))))))))"))
