(task-entry (id "geometry/marching-cubes/marching-cubes-cube") (skill geometry) (module marching-cubes) (tier 1) (difficulty 12203) (name marching-cubes-cube) (type "(-> (List Point3) (List Number) (List Triangle3))") (description "Generate triangles for a single cube based on corner values") (notes ()) (section grid-and-cube-utilities) (deps (\x27;prelude \x27;geometry)) (available (edge-table tri-table marching-cubes-grid)) (answer "(define (marching-cubes-cube corners values) (let* ((cube-index (compute-cube-index values)) (edge-mask (vector-ref edge-table cube-index))) (if (or (= edge-mask 0) (= edge-mask 4095)) '() (let ((edge-points (compute-edge-intersections corners values edge-mask))) (generate-cube-triangles edge-points cube-index)))))"))
(task-entry (id "geometry/mesh-gen/triangulation-points") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12203) (name triangulation-points) (type "") (description "") (notes ()) (section triangulation) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation?)) (answer "(define (triangulation-points tri) (vector-ref tri 1))"))
(task-entry (id "geometry/mesh-topology/build-vertex-map") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12203) (name build-vertex-map) (type "(-> (List Triangle3) (Values HashTable (Vector Vec3)))") (description "Build a map from vec3 positions to unique vertex indices") (notes ()) (section vertex-deduplication) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key)) (answer "(define (build-vertex-map triangles) (let ((key->idx (make-hashtable equal-hash equal?)) (vertices '()) (next-idx 0)) (for-each (lambda (tri) (for-each (lambda (v) (let ((key (vec3-key v))) (unless (hashtable-ref key->idx key #f) (hashtable-set! key->idx key next-idx) (set! vertices (cons v vertices)) (set! next-idx (+ next-idx 1))))) (list (triangle3-p1 tri) (triangle3-p2 tri) (triangle3-p3 tri)))) triangles) (values key->idx (list->vector (reverse vertices)))))"))
(task-entry (id "geometry/convex-hull/point2-distance-sq") (skill geometry) (module convex-hull) (tier 1) (difficulty 12203) (name point2-distance-sq) (type "") (description "") (notes ()) (section predicates) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear?)) (answer "(define (point2-distance-sq p1 p2) (let ((dx (- (point2-x p2) (point2-x p1))) (dy (- (point2-y p2) (point2-y p1)))) (+ (* dx dx) (* dy dy))))"))
