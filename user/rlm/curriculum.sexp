(task-entry (id "sim/simulation-stream/sim-take") (skill sim) (module simulation-stream) (tier 2) (difficulty 23330) (name sim-take) (type "(-> Number (Stream SimState) (List SimState))") (description "Take n simulation states as a list") (notes ()) (section simulation-stream-utilities) (deps (\x27;prelude \x27;stream \x27;vec2)) (available (make-sim-state sim-state? sim-state-time sim-state-data sim-state-metadata sim-state-with-time sim-state-with-data sim-unfold sim-unfold-infinite sim-unfold-with-state simulate simulate-with-dt simulate-varying-dt sim-scan sim-scan-map sim-accumulate make-physics-state physics-state? physics-pos physics-vel physics-mass physics-inv-mass make-updated-physics euler-step symplectic-euler-step verlet-step const-gravity spring-force-fn drag-force-fn combine-force-fns)) (answer "(define sim-take stream->list)"))
(task-entry (id "sim/stability/integrate-euler") (skill sim) (module stability) (tier 2) (difficulty 23330) (name integrate-euler) (type "(-> Any Number Any Number Nat (List Any))") (description "Simple forward Euler integration (for testing)") (notes ()) (section trajectory-analysis) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability stable? asymptotically-stable? unstable? classify-stability-nd analyze-stability-nd eigenvalue-result->stability eigenvalues-from-qr-result analyze-linear-system estimate-basin-of-attraction is-stable-numerically?)) (answer "(define (integrate-euler sys t0 state0 dt n) (let loop ((t t0) (state state0) (i 0) (result (list state0))) (if (>= i n) (reverse result) (let* ((f (eval-vector-field sys t state)) (new-state (vec-add state (vec-scale dt f)))) (loop (+ t dt) new-state (+ i 1) (cons new-state result))))))"))
