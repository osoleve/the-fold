(task-entry (id "geometry/mesh-topology/mesh-is-manifold?") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12213) (name mesh-is-manifold?) (type "") (description "") (notes ()) (section genus-computation) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex mesh-betti-numbers mesh-euler-characteristic mesh-f-vector mesh-connected-components mesh-genus mesh-edge-counts edge-key)) (answer "(define (mesh-is-manifold? mesh) (and (mesh-edges-are-manifold? mesh) (mesh-vertices-are-manifold? mesh)))"))
(task-entry (id "geometry/convex-hull/quickhull-recurse") (skill geometry) (module convex-hull) (tier 1) (difficulty 12213) (name quickhull-recurse) (type "") (description "") (notes ()) (section quickhull) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line find-furthest-from-line)) (answer "(define (quickhull-recurse points a b) (let ((above (points-above-line points a b))) (if (null? above) '() (let ((c (find-furthest-from-line above a b))) (append (quickhull-recurse above a c) (list c) (quickhull-recurse above c b))))))"))
(task-entry (id "geometry/voronoi/point2-key") (skill geometry) (module voronoi) (tier 1) (difficulty 12213) (name point2-key) (type "") (description "") (notes ()) (section adjacency) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right)) (answer "(define (point2-key p) (cons (point2-x p) (point2-y p)))"))
(task-entry (id "geometry/geometry-optics/triangle3-p2-lens") (skill geometry) (module geometry-optics) (tier 1) (difficulty 12213) (name triangle3-p2-lens) (type "") (description "") (notes ()) (section triangle3-lenses) (deps (\x27;prelude \x27;optics \x27;geometry)) (available (vec3-x-lens vec3-y-lens vec3-z-lens line3-origin-lens line3-direction-lens ray3-origin-lens ray3-direction-lens ray3-origin-x-lens ray3-origin-y-lens ray3-origin-z-lens plane3-normal-lens plane3-d-lens triangle3-p1-lens)) (answer "(define triangle3-p2-lens (make-lens triangle3-p2 (lambda (new-p2 t) (triangle3 (triangle3-p1 t) new-p2 (triangle3-p3 t)))))"))
(task-entry (id "geometry/geometry/plane3-from-point-normal") (skill geometry) (module geometry) (tier 1) (difficulty 12214) (name plane3-from-point-normal) (type "(-> Point3 Vec3 Plane3)") (description "Create plane from point and normal") (notes ()) (section primitives) (deps (\x27;prelude \x27;vec3 \x27;matrix \x27;quaternion)) (available (point3 line3 line3? line3-origin line3-direction ray3 ray3? ray3-origin ray3-direction ray3-point-at plane3 plane3? plane3-normal plane3-d)) (answer "(define (plane3-from-point-normal point normal) (let ((d (- (vec3-dot normal point)))) (plane3 normal d)))"))
(task-entry (id "geometry/raymarch/bvh-accelerated-raymarch") (skill geometry) (module raymarch) (tier 1) (difficulty 12214) (name bvh-accelerated-raymarch) (type "(-> Mesh Ray3 RaymarchParams (Or (List Vec3 Real Nat) #f))") (description "Hybrid approach: use BVH for initial ray-mesh intersection, then raymarch in vicinity of hit for accurate SDF") (notes ()) (section performance-optimization) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (raymarch-params raymarch-params-max-steps raymarch-params-max-distance raymarch-params-hit-threshold default-raymarch-params raymarch raymarch-mesh sdf-normal mesh-sdf-normal raymarch-shadow raymarch-ao simple-shading render-pixel adaptive-step)) (answer "(define (bvh-accelerated-raymarch mesh ray params) (let ((ray-result (mesh-intersect-ray mesh ray))) (if ray-result (let* ((coarse-hit (car ray-result)) (t-coarse (cadr ray-result)) (start-t (max 0.0 (- t-coarse 1.0))) (adjusted-ray (ray3 (ray3-point-at ray start-t) (ray3-direction ray))) (sdf-fn (lambda (p) (mesh-sdf mesh p))) (local-result (raymarch sdf-fn adjusted-ray (raymarch-params 50 10.0 0.001)))) (if local-result (let* ((local-hit (car local-result)) (local-t (cadr local-result)) (local-steps (caddr local-result)) (global-t (+ start-t local-t))) (list local-hit global-t local-steps)) (list coarse-hit t-coarse 1))) (raymarch-mesh mesh ray params))))"))
(task-entry (id "geometry/octree/any") (skill geometry) (module octree) (tier 1) (difficulty 12214) (name any) (type "(-> (-> α Bool) (List α) Bool)") (description "") (notes ()) (section octree-construction) (deps (\x27;prelude \x27;geometry)) (available (octree-leaf octree-node octree-leaf? octree-node? octree-center octree-size octree-primitives octree-children octree-build all-children-leaves? subdivide-octants triangle-intersects-octant? aabb-overlaps? partition-triangles-octants)) (answer "(define (any pred lst) (and (not (null? lst)) (or (pred (car lst)) (any pred (cdr lst)))))"))
(task-entry (id "geometry/bvh/closest-point-on-segment") (skill geometry) (module bvh) (tier 1) (difficulty 12214) (name closest-point-on-segment) (type "(-> Point3 Point3 Point3 Point3)") (description "Find closest point on line segment AB to point P") (notes ()) (section bvh-traversal) (deps (\x27;prelude \x27;geometry \x27;sort)) (available (bvh-leaf bvh-node bvh-leaf? bvh-node? bvh-bbox bvh-primitives bvh-left bvh-right triangle-centroid compute-triangles-bbox longest-axis get-axis-coord bvh-build bvh-intersect-ray)) (answer "(define (closest-point-on-segment p a b) (let* ((ab (vec3-sub b a)) (ap (vec3-sub p a)) (ab-dot (vec3-dot ab ab))) (if (< ab-dot 1e-10) a (let ((t (/ (vec3-dot ap ab) ab-dot))) (cond ((<= t 0) a) ((>= t 1) b) (else (vec3-add a (vec3-scale ab t))))))))"))
(task-entry (id "geometry/ascii-render/render-pixel-color") (skill geometry) (module ascii-render) (tier 1) (difficulty 12214) (name render-pixel-color) (type "(-> Mesh Ray3 Vec3 (Maybe (List Number Number Number)))") (description "Render a single ray, return RGB [0,1] or #f for background") (notes ()) (section mesh-rendering) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (ascii-ramp ascii-ramp-len intensity->char rgb->ansi256 ansi-fg ansi-reset make-camera camera-pos camera-forward camera-right camera-up camera-half-width camera-half-height camera-ray)) (answer "(define (render-pixel-color mesh ray light-dir) (let ((hit (mesh-intersect-ray mesh ray))) (if hit (let* ((point (car hit)) (triangle (caddr hit)) (normal (triangle-normal triangle)) (ndotl (max 0.1 (vec3-dot normal light-dir))) (r (* 1.0 ndotl)) (g (* 0.8 ndotl)) (b (* 0.2 ndotl))) (list r g b)) #f)))"))
(task-entry (id "geometry/mesh-sdf/subdivide-triangle-with-midpoints-by-id") (skill geometry) (module mesh-sdf) (tier 1) (difficulty 12214) (name subdivide-triangle-with-midpoints-by-id) (type "") (description "") (notes ()) (section mesh-construction-helpers) (deps (\x27;prelude \x27;geometry \x27;bvh)) (available (make-mesh mesh? mesh-triangles mesh-bvh mesh-sdf mesh-sdf-gradient make-mesh-cube subdivide-icosphere-triangles subdivide-icosphere-once vec3-edge-key vec3-coords<? edge-id-key ensure-edge-midpoint-by-id! get-edge-midpoint-by-id)) (answer "(define (subdivide-triangle-with-midpoints-by-id tri midpoint-table get-id) (let* ((v0 (triangle3-p1 tri)) (v1 (triangle3-p2 tri)) (v2 (triangle3-p3 tri)) (id0 (get-id v0)) (id1 (get-id v1)) (id2 (get-id v2)) (m01 (get-edge-midpoint-by-id midpoint-table id0 id1)) (m12 (get-edge-midpoint-by-id midpoint-table id1 id2)) (m20 (get-edge-midpoint-by-id midpoint-table id2 id0))) (list (triangle3 v0 m01 m20) (triangle3 m01 v1 m12) (triangle3 m20 m12 v2) (triangle3 m01 m12 m20))))"))
(task-entry (id "geometry/mesh-gen/point2-y") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12214) (name point2-y) (type "") (description "") (notes ()) (section triangulation) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location location? location-triangle location-bary point2-x)) (answer "(define (point2-y p) (vector-ref p 1))"))
(task-entry (id "geometry/mesh-topology/mesh-edges-are-manifold?") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12214) (name mesh-edges-are-manifold?) (type "") (description "") (notes ()) (section genus-computation) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex mesh-betti-numbers mesh-euler-characteristic mesh-f-vector mesh-connected-components mesh-genus mesh-edge-counts edge-key mesh-is-manifold?)) (answer "(define (mesh-edges-are-manifold? mesh) (let ((edge-counts (mesh-edge-counts mesh))) (let-values (((keys) (hashtable-keys edge-counts))) (let loop ((i 0)) (if (>= i (vector-length keys)) #t (let ((count (hashtable-ref edge-counts (vector-ref keys i) 0))) (if (and (>= count 1) (<= count 2)) (loop (+ i 1)) #f)))))))"))
(task-entry (id "geometry/convex-hull/quickhull") (skill geometry) (module convex-hull) (tier 1) (difficulty 12214) (name quickhull) (type "") (description "") (notes ()) (section quickhull) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line find-furthest-from-line quickhull-recurse)) (answer "(define (quickhull points) (cond ((< (length points) 3) points) (else (let-values (((left right) (find-extreme-points points))) (if (and (= (point2-x left) (point2-x right)) (= (point2-y left) (point2-y right))) (list left) (let ((upper (quickhull-recurse points left right)) (lower (quickhull-recurse points right left))) (append (list left) upper (list right) lower)))))))"))
(task-entry (id "geometry/voronoi/key<?") (skill geometry) (module voronoi) (tier 1) (difficulty 12214) (name key<?) (type "") (description "") (notes ()) (section adjacency) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key)) (answer "(define (key<? k1 k2) (or (< (car k1) (car k2)) (and (= (car k1) (car k2)) (< (cdr k1) (cdr k2)))))"))
(task-entry (id "geometry/geometry-optics/triangle3-p3-lens") (skill geometry) (module geometry-optics) (tier 1) (difficulty 12214) (name triangle3-p3-lens) (type "") (description "") (notes ()) (section triangle3-lenses) (deps (\x27;prelude \x27;optics \x27;geometry)) (available (vec3-x-lens vec3-y-lens vec3-z-lens line3-origin-lens line3-direction-lens ray3-origin-lens ray3-direction-lens ray3-origin-x-lens ray3-origin-y-lens ray3-origin-z-lens plane3-normal-lens plane3-d-lens triangle3-p1-lens triangle3-p2-lens)) (answer "(define triangle3-p3-lens (make-lens triangle3-p3 (lambda (new-p3 t) (triangle3 (triangle3-p1 t) (triangle3-p2 t) new-p3))))"))
(task-entry (id "geometry/geometry/plane3-from-points") (skill geometry) (module geometry) (tier 1) (difficulty 12215) (name plane3-from-points) (type "(-> Point3 Point3 Point3 (Or Plane3 Error))") (description "Create plane from three points") (notes ("Returns error if points are collinear")) (section primitives) (deps (\x27;prelude \x27;vec3 \x27;matrix \x27;quaternion)) (available (point3 line3 line3? line3-origin line3-direction ray3 ray3? ray3-origin ray3-direction ray3-point-at plane3 plane3? plane3-normal plane3-d plane3-from-point-normal)) (answer "(define (plane3-from-points p1 p2 p3) (let* ((v1 (vec3-sub p2 p1)) (v2 (vec3-sub p3 p1)) (cp (vec3-cross v1 v2)) (mag (vec3-magnitude cp))) (if (< mag 1e-10) (list 'error 'plane3-from-points \"Collinear points do not define a unique plane\") (let ((normal (vec3-scale-inv cp mag))) (plane3-from-point-normal p1 normal)))))"))
(task-entry (id "geometry/octree/octree-intersect-ray") (skill geometry) (module octree) (tier 1) (difficulty 12215) (name octree-intersect-ray) (type "(-> Octree Ray3 (Maybe (Pair Triangle3 Number)))") (description "Find closest triangle intersection along ray using octree") (notes ()) (section octree-queries) (deps (\x27;prelude \x27;geometry)) (available (octree-leaf octree-node octree-leaf? octree-node? octree-center octree-size octree-primitives octree-children octree-build all-children-leaves? subdivide-octants triangle-intersects-octant? aabb-overlaps? partition-triangles-octants any)) (answer "(define (octree-intersect-ray octree ray) (let traverse ((node octree) (closest-t #f) (closest-tri #f)) (cond ((not node) (if closest-tri (list closest-tri closest-t) #f)) ((not (ray-intersects-octant? ray (octree-center node) (octree-size node))) (if closest-tri (list closest-tri closest-t) #f)) ((octree-leaf? node) (let loop ((tris (octree-primitives node)) (best-t closest-t) (best-tri closest-tri)) (if (null? tris) (if best-tri (list best-tri best-t) #f) (let* ((tri (car tris)) (t (intersect-ray-triangle ray tri))) (if (and t (or (not best-t) (< t best-t))) (loop (cdr tris) t tri) (loop (cdr tris) best-t best-tri)))))) ((octree-node? node) (let ((children (vector->list (octree-children node)))) (fold-left (lambda (result child) (let ((tri (if result (car result) closest-tri)) (t (if result (cadr result) closest-t))) (or (traverse child t tri) result))) (if closest-tri (list closest-tri closest-t) #f) children))) (else (if closest-tri (list closest-tri closest-t) #f)))))"))
(task-entry (id "geometry/bvh/closest-point-on-triangle") (skill geometry) (module bvh) (tier 1) (difficulty 12215) (name closest-point-on-triangle) (type "(-> Point3 Triangle3 Point3)") (description "Find the closest point on a triangle to the given point") (notes ()) (section bvh-traversal) (deps (\x27;prelude \x27;geometry \x27;sort)) (available (bvh-leaf bvh-node bvh-leaf? bvh-node? bvh-bbox bvh-primitives bvh-left bvh-right triangle-centroid compute-triangles-bbox longest-axis get-axis-coord bvh-build bvh-intersect-ray closest-point-on-segment)) (answer "(define (closest-point-on-triangle point tri) (let* ((a (triangle3-p1 tri)) (b (triangle3-p2 tri)) (c (triangle3-p3 tri)) (normal (triangle-normal tri)) (dist (vec3-dot normal (vec3-sub point a))) (projected (vec3-sub point (vec3-scale normal dist))) (bary (barycentric-coords projected a b c)) (u (car bary)) (v (cadr bary)) (w (caddr bary))) (if (and (>= u -1e-4) (>= v -1e-4) (>= w -1e-4)) projected (let* ((p-ab (closest-point-on-segment point a b)) (p-bc (closest-point-on-segment point b c)) (p-ca (closest-point-on-segment point c a)) (d-ab (distance-point-point point p-ab)) (d-bc (distance-point-point point p-bc)) (d-ca (distance-point-point point p-ca))) (cond ((and (<= d-ab d-bc) (<= d-ab d-ca)) p-ab) ((and (<= d-bc d-ab) (<= d-bc d-ca)) p-bc) (else p-ca))))))"))
(task-entry (id "geometry/ascii-render/render-frame") (skill geometry) (module ascii-render) (tier 1) (difficulty 12215) (name render-frame) (type "(-> Mesh Camera Vec3 Number Number String)") (description "Render mesh to colored ASCII string; width/height in characters") (notes ()) (section frame-rendering) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (ascii-ramp ascii-ramp-len intensity->char rgb->ansi256 ansi-fg ansi-reset make-camera camera-pos camera-forward camera-right camera-up camera-half-width camera-half-height camera-ray render-pixel-color)) (answer "(define (render-frame mesh cam light-dir width height) (let ((result '())) (do ((y 0 (+ y 1))) ((>= y height) (apply string-append (reverse result))) (do ((x 0 (+ x 1))) ((>= x width)) (let* ((u (- (* 2.0 (/ x width)) 1.0)) (v (- 1.0 (* 2.0 (/ y height)))) (ray (camera-ray cam u v)) (color (render-pixel-color mesh ray light-dir))) (if color (let* ((r (car color)) (g (cadr color)) (b (caddr color)) (intensity (/ (+ r g b) 3.0)) (ch (intensity->char intensity)) (ansi-code (rgb->ansi256 r g b))) (set! result (cons (string-append (ansi-fg ansi-code) (string ch)) result))) (set! result (cons \" \" result))))) (set! result (cons (string-append ansi-reset \"\n\") result)))))"))
