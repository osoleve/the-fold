(task-entry (id "optimization/lp/find-entering-variable") (skill optimization) (module lp) (tier 1) (difficulty 12823) (name find-entering-variable) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize extract-basis-matrix extract-basis-costs compute-reduced-costs)) (answer "(define (find-entering-variable reduced-costs basis) (let ((n (vector-length reduced-costs))) (let loop ((j 0)) (cond ((= j n) #f) ((and (< (vector-ref reduced-costs j) (- *lp-tolerance*)) (not (vec-contains? basis j))) j) (else (loop (+ j 1)))))))"))
(task-entry (id "optimization/ilp/find-fractional-var") (skill optimization) (module ilp) (tier 1) (difficulty 12823) (name find-fractional-var) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp make-ilp-optimal make-ilp-infeasible make-ilp-unbounded ilp-optimal? ilp-infeasible? ilp-unbounded? ilp-result-x ilp-result-z is-integer? solution-is-integer?)) (answer "(define (find-fractional-var x integer-vars) (let loop ((vars integer-vars)) (cond ((null? vars) #f) ((not (is-integer? (vector-ref x (car vars)))) (car vars)) (else (loop (cdr vars))))))"))
