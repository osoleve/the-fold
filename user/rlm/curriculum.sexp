(key (vector-ref keys i)) (x1 (list-ref key 0)) (y1 (list-ref key 1)) (x2 (list-ref key 2)) (y2 (list-ref key 3)) (p1 (make-point2 x1 y1)) (p2 (make-point2 x2 y2))) (hashtable-set! boundary-verts (vertex-key p1) p1) (hashtable-set! boundary-verts (vertex-key p2) p2))))) (let-values (((_ vals) (hashtable-entries boundary-verts))) (vector->list vals))))"))
