(task-entry (id "game-theory/fair-division/envy-free-up-to-one?") (skill game-theory) (module fair-division) (tier 1) (difficulty 13249) (name envy-free-up-to-one?) (type "") (description "") (notes ()) (section discrete-fair-division) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax make-adjusted-winner-problem adjusted-winner equalize-allocations transfer-to-equalize transfer-loop update-fraction remove-good format-allocation make-discrete-problem discrete-problem-players discrete-problem-goods-count discrete-problem-valuation round-robin discrete-allocation-value)) (answer "(define (envy-free-up-to-one? dp allocs) (let ((n (discrete-problem-players dp))) (let outer ((i 0)) (if (>= i n) #t (let ((my-val (discrete-allocation-value dp i (vector-ref allocs i)))) (let inner ((j 0)) (if (>= j n) (outer (+ i 1)) (if (= i j) (inner (+ j 1)) (let* ((j-bundle (vector-ref allocs j)) (other-val (discrete-allocation-value dp i j-bundle))) (if (<= other-val my-val) (inner (+ j 1)) (let check-remove ((goods j-bundle)) (if (null? goods) #f (let* ((removed (car goods)) (without (filter (lambda (g) (not (eq? g removed))) j-bundle)) (reduced-val (discrete-allocation-value dp i without))) (if (<= reduced-val my-val) (inner (+ j 1)) (check-remove (cdr goods))))))))))))))))"))
(task-entry (id "game-theory/coop-games/banzhaf-index") (skill game-theory) (module coop-games) (tier 1) (difficulty 13250) (name banzhaf-index) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky make-additive-game make-unanimity-game make-weighted-voting-game make-airport-game make-bankruptcy-game make-gloves-game coop-game-superadditive? coop-game-convex? coop-game-monotonic? coop-game-simple? is-winning? is-blocking? is-pivotal?)) (answer "(define (banzhaf-index g fuel) (let* ((n (coop-game-players g)) (grand (coop-game-grand-coalition g)) (raw-scores (make-vector n 0))) (let outer ((i 0) (fuel fuel)) (if (or (>= i n) (<= fuel 0)) (let ((total (let sum-loop ((j 0) (s 0)) (if (>= j n) s (sum-loop (+ j 1) (+ s (vector-ref raw-scores j))))))) (if (= total 0) raw-scores (let norm-loop ((j 0)) (if (>= j n) raw-scores (begin (vector-set! raw-scores j (/ (vector-ref raw-scores j) total)) (norm-loop (+ j 1))))))) (begin (let inner ((S 0) (count 0) (fuel fuel)) (if (or (> S grand) (<= fuel 0)) (vector-set! raw-scores i count) (inner (+ S 1) (if (is-pivotal? g S i) (+ count 1) count) (- fuel 1)))) (outer (+ i 1) fuel))))))"))
