(task-entry (id "physics/diff/traced-vec2/vec2-gradient") (skill physics/diff) (module traced-vec2) (tier 2) (difficulty 23142) (name vec2-gradient) (type "") (description "") (notes ()) (section gradient-utilities) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff)) (available (traced-vec2 traced-vec2? traced-vec2-x traced-vec2-y traced-vec2-zero lift-vec2 lift-vec2-const unpack-traced-vec2 traced-vec2->list traced-vec2-add traced-vec2-sub traced-vec2-neg traced-vec2-mul traced-vec2-div traced-vec2-scale traced-vec2-scale-inv traced-vec2-dot traced-vec2-cross traced-vec2-magnitude-sq traced-vec2-magnitude traced-vec2-smooth-magnitude traced-vec2-distance-sq traced-vec2-distance traced-vec2-smooth-distance traced-vec2-normalize traced-vec2-smooth-normalize traced-vec2-safe-normalize traced-vec2-rotate traced-vec2-rotate-90 traced-vec2-rotate-neg-90 traced-vec2-perp traced-vec2-reflect traced-vec2-project traced-vec2-reject traced-vec2-lerp traced-vec2-min traced-vec2-max traced-softplus traced-softmax2 traced-softmin2 traced-smooth-abs traced-smooth-clamp)) (answer "(define (vec2-gradient f p) (let* ((grads (gradient (lambda (x y) (f (traced-vec2 x y))) (list (vec2-x p) (vec2-y p))))) (vec2 (car grads) (cadr grads))))"))
(task-entry (id "physics/diff/traced-vec2/vec2-gradient-2arg") (skill physics/diff) (module traced-vec2) (tier 2) (difficulty 23143) (name vec2-gradient-2arg) (type "") (description "") (notes ()) (section gradient-utilities) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff)) (available (traced-vec2 traced-vec2? traced-vec2-x traced-vec2-y traced-vec2-zero lift-vec2 lift-vec2-const unpack-traced-vec2 traced-vec2->list traced-vec2-add traced-vec2-sub traced-vec2-neg traced-vec2-mul traced-vec2-div traced-vec2-scale traced-vec2-scale-inv traced-vec2-dot traced-vec2-cross traced-vec2-magnitude-sq traced-vec2-magnitude traced-vec2-smooth-magnitude traced-vec2-distance-sq traced-vec2-distance traced-vec2-smooth-distance traced-vec2-normalize traced-vec2-smooth-normalize traced-vec2-safe-normalize traced-vec2-rotate traced-vec2-rotate-90 traced-vec2-rotate-neg-90 traced-vec2-perp traced-vec2-reflect traced-vec2-project traced-vec2-reject traced-vec2-lerp traced-vec2-min traced-vec2-max traced-softplus traced-softmax2 traced-softmin2 traced-smooth-abs traced-smooth-clamp vec2-gradient)) (answer "(define (vec2-gradient-2arg f a b) (let* ((grads (gradient (lambda (ax ay bx by) (f (traced-vec2 ax ay) (traced-vec2 bx by))) (list (vec2-x a) (vec2-y a) (vec2-x b) (vec2-y b))))) (values (vec2 (list-ref grads 0) (list-ref grads 1)) (vec2 (list-ref grads 2) (list-ref grads 3)))))"))
