(task-entry (id "optimization/ilp/ilp-result->string") (skill optimization) (module ilp) (tier 1) (difficulty 12849) (name ilp-result->string) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp make-ilp-optimal make-ilp-infeasible make-ilp-unbounded ilp-optimal? ilp-infeasible? ilp-unbounded? ilp-result-x ilp-result-z is-integer? solution-is-integer? find-fractional-var round-solution make-bb-node bb-node-lp bb-node-lb bb-node-ub add-bound-constraints ilp-solve branch-and-bound vector-take frac generate-gomory-cut matrix-row add-gomory-cut ilp-solve-cutting-plane find-and-generate-cut knapsack-solve set-cover-solve vec-ones vec-zeros vec-negate vec-append vec-copy vec-dot matrix-vstack matrix-hstack)) (answer "(define (ilp-result->string result) (cond ((ilp-optimal? result) (string-append \"Optimal integer solution:\n\" \"  x* = \" (vec->string (ilp-result-x result)) \"\n\" \"  z* = \" (number->string (ilp-result-z result)))) ((ilp-infeasible? result) \"No feasible integer solution exists\") ((ilp-unbounded? result) \"Problem is unbounded\") (else \"Unknown result\")))"))
