(task-entry (id "physics-problems/physics-problem/category-distractor-strategies") (skill physics-problems) (module physics-problem) (tier 2) (difficulty 23615) (name category-distractor-strategies) (type "") (description "") (notes ()) (section options) (deps (\x27;prelude \x27;vec2 \x27;sample \x27;parameter \x27;presentation \x27;distractor \x27;difficulty \x27;simulation)) (available (make-physics-problem physics-problem? problem-name problem-category problem-params problem-world-setup problem-question-gen problem-answer-compute problem-difficulty generate-problem-instance generate-problem-id generate-problem-options find-correct-label string-contains-approx? format-answer)) (answer "(define (category-distractor-strategies category) (case category ((spatial count size distance) counting-distractors) ((velocity speed kinematic) velocity-distractors) ((mass momentum dynamic) numeric-distractors) (else numeric-distractors)))"))
