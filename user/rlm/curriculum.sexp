(task-entry (id "autodiff/higher-order-diff/mixed-partial") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12766) (name mixed-partial) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin rec-cos jet-pad-coeffs jet-add jet-sub jet-neg jet-mul jet-sq jet-div jet-recip jet-exp jet-log jet-sqrt jet-sin-cos jet-sin jet-cos jet-tan jet-pow jet-atan jet-asin jet-acos jet-sinh-cosh jet-sinh jet-cosh jet-tanh rec-atan rec-asin rec-acos nth-derivative all-derivatives taylor-coefficients taylor-series taylor-remainder-bound partial-derivative)) (answer "(define (mixed-partial f args orders) (let* ((active-indices (filter (lambda (i) (> (list-ref orders i) 0)) (iota (length args))))) (if (= (length active-indices) 1) (partial-derivative f args (car active-indices) (list-ref orders (car active-indices))) (if (null? active-indices) (jet-value (apply f (map jet-lift args))) (let* ((first-var (car active-indices)) (first-order (list-ref orders first-var)) (remaining-orders (list-update orders first-var (lambda (_) 0))) (inner-f (lambda jets (let* ((args-inner (map jet-value jets)) (first-jet (jet-variable (list-ref args-inner first-var) first-order)) (jets-inner (map (lambda (x i) (if (= i first-var) first-jet x)) jets (iota (length jets)))) (result (apply f jets-inner))) (jet (list (jet-deriv result first-order))))))) (mixed-partial inner-f args remaining-orders))))))"))
(task-entry (id "autodiff/higher-order-diff/gradient-jet") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12767) (name gradient-jet) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin rec-cos jet-pad-coeffs jet-add jet-sub jet-neg jet-mul jet-sq jet-div jet-recip jet-exp jet-log jet-sqrt jet-sin-cos jet-sin jet-cos jet-tan jet-pow jet-atan jet-asin jet-acos jet-sinh-cosh jet-sinh jet-cosh jet-tanh rec-atan rec-asin rec-acos nth-derivative all-derivatives taylor-coefficients taylor-series taylor-remainder-bound partial-derivative mixed-partial)) (answer "(define (gradient-jet f args) (let ((n (length args))) (map (lambda (i) (partial-derivative f args i 1)) (iota n))))"))
(task-entry (id "autodiff/higher-order-diff/hessian-jet") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12768) (name hessian-jet) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin rec-cos jet-pad-coeffs jet-add jet-sub jet-neg jet-mul jet-sq jet-div jet-recip jet-exp jet-log jet-sqrt jet-sin-cos jet-sin jet-cos jet-tan jet-pow jet-atan jet-asin jet-acos jet-sinh-cosh jet-sinh jet-cosh jet-tanh rec-atan rec-asin rec-acos nth-derivative all-derivatives taylor-coefficients taylor-series taylor-remainder-bound partial-derivative mixed-partial gradient-jet)) (answer "(define (hessian-jet f args) (let* ((n (length args)) (result (make-vector (* n n) 0)) (diagonals (map (lambda (i) (let* ((jets (map (lambda (x idx) (if (= idx i) (jet-variable x 2) (jet-lift x))) args (iota n))) (result-jet (apply f jets))) (jet-deriv result-jet 2))) (iota n)))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! result (+ (* i n) i) (list-ref diagonals i))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n n result)) (do ((j (+ i 1) (+ j 1))) ((= j n)) (let* ((diag-i (list-ref diagonals i)) (diag-j (list-ref diagonals j)) (jets (map (lambda (x idx) (cond ((= idx i) (jet-variable x 2)) ((= idx j) (jet-variable x 2)) (else (jet-lift x)))) args (iota n))) (result-jet (apply f jets)) (e2-coeff (jet-coeff result-jet 2)) (sum-term (* 2 e2-coeff)) (h-ij (/ (- sum-term diag-i diag-j) 2))) (vector-set! result (+ (* i n) j) h-ij) (vector-set! result (+ (* j n) i) h-ij))))))"))
