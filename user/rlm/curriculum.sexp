(task-entry (id "optimization/first-order/sgd") (skill optimization) (module first-order) (tier 1) (difficulty 12801) (name sgd) (type "(-> (-> (List TracedValue) TracedValue) (List Number) Number Nat (List Number))") (description "Simple SGD interface (no convergence tracking)") (notes ()) (section gradient-descent) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent)) (answer "(define (sgd f x0 lr max-iters) (let loop ((x x0) (iter 0)) (if (>= iter max-iters) x (let* ((grad (gradient f x)) (x-new (map (lambda (xi gi) (- xi (* lr gi))) x grad))) (loop x-new (+ iter 1))))))"))
(task-entry (id "optimization/newton/newton-method-full") (skill optimization) (module newton) (tier 1) (difficulty 12801) (name newton-method-full) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method)) (answer "(define (newton-method-full f x0 criteria use-line-search regularization) (let* ((init-grad (gradient f x0)) (init-f (apply f x0)) (init-state (initial-convergence-state init-f init-grad))) (let loop ((x x0) (state init-state)) (let ((reason (converged? criteria state))) (if reason (make-opt-result x (cs-f-val state) (gradient f x) (cs-iter state) reason) (let* ((grad (gradient f x)) (hess (hessian f x)) (hess-reg (matrix-add-diagonal hess regularization)) (neg-grad (map - grad)) (d-result (newton-solve-direction hess-reg neg-grad)) (direction (if (eq? (car d-result) 'error) (map - grad) d-result)) (ls-result (if use-line-search (armijo-backtrack f x grad direction) (list (vec-add-scaled x direction 1.0) 1.0))) (x-new (car ls-result)) (f-new (apply f x-new)) (grad-new (gradient f x-new)) (new-state (update-convergence-state state f-new grad-new x x-new))) (loop x-new new-state)))))))"))
(task-entry (id "optimization/lbfgs/lbfgs-history?") (skill optimization) (module lbfgs) (tier 1) (difficulty 12801) (name lbfgs-history?) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history)) (answer "(define (lbfgs-history? h) (and (pair? h) (eq? (car h) 'lbfgs-history)))"))
(task-entry (id "optimization/optimize/minimize-bounded") (skill optimization) (module optimize) (tier 1) (difficulty 12801) (name minimize-bounded) (type "(-> (-> (List TracedValue) TracedValue) (List Number) (List Number) (List Number) OptResult)") (description "Minimize with box constraints") (notes ()) (section unified-interface) (deps (\x27;prelude \x27;convergence \x27;line-search \x27;first-order \x27;newton \x27;lbfgs)) (available (minimize)) (answer "(define (minimize-bounded f x0 lower upper . opts) (let ((criteria (if (and (pair? opts) (convergence-criteria? (car opts))) (car opts) *default-convergence*))) (lbfgs-b f x0 lower upper criteria)))"))
