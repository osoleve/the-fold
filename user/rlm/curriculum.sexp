(task-entry (id "data/graph-homology/cycle-basis-homology") (skill data) (module graph-homology) (tier 0) (difficulty 1304) (name cycle-basis-homology) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;homology)) (available (graph->simplicial-complex graph-adjacency->simplicial-complex graph-betti-numbers graph-betti-numbers-from-adjacency)) (answer "(define (cycle-basis-homology edges vertices) (let* ((sc (graph->simplicial-complex edges vertices)) (n-edges (length edges)) (edge-list (sc-edges sc))) (if (= n-edges 0) '() (let* ((boundary-1 (sc-boundary-matrix sc 1)) (null-basis (z2-null-space boundary-1))) (map (lambda (null-vec) (edges-from-z2-null-vector null-vec edge-list)) null-basis)))))"))
(task-entry (id "data/pagerank/matrix-row-sum") (skill data) (module pagerank) (tier 0) (difficulty 1304) (name matrix-row-sum) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations* adjacency->transition)) (answer "(define (matrix-row-sum m i) (let ((n (matrix-cols m))) (let loop ((j 0) (sum 0)) (if (>= j n) sum (loop (+ j 1) (+ sum (matrix-ref m i j)))))))"))
(task-entry (id "data/graph-matrix/edge-weight") (skill data) (module graph-matrix) (tier 0) (difficulty 1304) (name edge-weight) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to)) (answer "(define (edge-weight edge) (if (= (length edge) 3) (caddr edge) 1))"))
(task-entry (id "data/centrality/vec-distance") (skill data) (module centrality) (tier 0) (difficulty 1304) (name vec-distance) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration)) (answer "(define (vec-distance v1 v2) (let ((n (vector-length v1))) (sqrt (let loop ((i 0) (sum 0)) (if (= i n) sum (let ((d (- (vector-ref v1 i) (vector-ref v2 i)))) (loop (+ i 1) (+ sum (* d d)))))))))"))
