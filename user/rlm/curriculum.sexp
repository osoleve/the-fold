(task-entry (id "geometry/mesh-topology/vec3-key") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12202) (name vec3-key) (type "(-> Vec3 (List Integer Integer Integer))") (description "Create a hashable key from a vec3 position") (notes ()) (section vertex-deduplication) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize)) (answer "(define (vec3-key v) (list (quantize (vec3-x v)) (quantize (vec3-y v)) (quantize (vec3-z v))))"))
