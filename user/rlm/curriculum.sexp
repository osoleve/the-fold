(task-entry (id "crypto/elliptic-curve/ec-on-curve?") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10513) (name ec-on-curve?) (type "(-> Curve Point Boolean)") (description "Check if point satisfies curve equation y² = x³ + ax + b (mod p)") (notes ()) (section point-validation) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity?)) (answer "(define (ec-on-curve? curve pt) (if (ec-infinity? pt) #t (let* ((p (ec-p curve)) (a (ec-a curve)) (b (ec-b curve)) (x (ec-point-x pt)) (y (ec-point-y pt)) (lhs (mod* y y p)) (x2 (mod* x x p)) (x3 (mod* x2 x p)) (ax (mod* a x p)) (rhs (mod+ x3 (mod+ ax b p) p))) (= lhs rhs))))"))
