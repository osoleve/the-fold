(task-entry (id "linalg/vec/vec-product") (skill linalg) (module vec) (tier 0) (difficulty 433) (name vec-product) (type "(-> (Vec Num) Num)") (description "Product of all elements") (notes ()) (section vector-utilities) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop vec-slice vec-add vec-sub vec-mul vec-div vec-scale vec-negate vec-dot vec-norm-squared vec-norm vec-norm-l1 vec-norm-linf vec-normalize vec-distance vec-equal? vec-approx-equal? vec-sum)) (answer "(define (vec-product v) (vec-fold * 1 v))"))
(task-entry (id "linalg/quaternion/quat-slerp") (skill linalg) (module quaternion) (tier 0) (difficulty 433) (name quat-slerp) (type "") (description "") (notes ()) (section quaternion-arithmetic) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at quat? quat-identity? quat-unit? quat-w quat-x quat-y quat-z quat-scalar quat-vector quat->list list->quat quat-add quat-sub quat-neg quat-scale quat-mul quat-magnitude-sq quat-magnitude quat-normalize quat-conjugate quat-inverse quat-dot quat-angle quat-lerp quat-nlerp)) (answer "(define (quat-slerp a b t) (let* ((dot (quat-dot a b)) (dot (if (< dot 0) (- dot) dot)) (b (if (< (quat-dot a b) 0) (quat-neg b) b))) (if (> dot 0.9995) (quat-nlerp a b t) (let* ((theta (acos dot)) (sin-theta (sin theta)) (s0 (/ (sin (* (- 1 t) theta)) sin-theta)) (s1 (/ (sin (* t theta)) sin-theta))) (quat-add (quat-scale a s0) (quat-scale b s1))))))"))
