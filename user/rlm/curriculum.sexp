(task-entry (id "clp/domain/domain-contains?") (skill clp) (module domain) (tier 1) (difficulty 10808) (name domain-contains?) (type "(-> Domain Int Bool)") (description "Check if domain contains a specific value") (notes ()) (section domain-predicates) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton?)) (answer "(define (domain-contains? dom n) (let loop ((intervals dom)) (cond ((null? intervals) #f) ((< n (caar intervals)) #f) ((<= n (cdar intervals)) #t) (else (loop (cdr intervals))))))"))
(task-entry (id "clp/store/cstore-set-constraints") (skill clp) (module store) (tier 1) (difficulty 10808) (name cstore-set-constraints) (type "(-> CStore (List Constraint) CStore)") (description "Set active constraints in store") (notes ()) (section constraint-store-structure) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains)) (answer "(define (cstore-set-constraints cs constraints) (list 'cstore (cstore-subst cs) (cstore-domains cs) constraints (cstore-pending cs)))"))
(task-entry (id "clp/fd-constraints/<=fd-var-var") (skill clp) (module fd-constraints) (tier 1) (difficulty 10808) (name <=fd-var-var) (type "(-> CStore LVar LVar (Maybe CStore))") (description "Propagate x <= y constraint for two variables") (notes ()) (section comparison-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd)) (answer "(define (<=fd-var-var cs x y) (let ((dom-x (cstore-get-domain cs x)) (dom-y (cstore-get-domain cs y))) (cond ((and dom-x dom-y) (let* ((cs1 (cstore-narrow-domain cs x (domain-restrict-max dom-x (domain-max dom-y)))) (cs2 (and cs1 (cstore-narrow-domain cs1 y (domain-restrict-min (cstore-get-domain cs1 y) (domain-min (cstore-get-domain cs1 x))))))) cs2)) (else cs))))"))
(task-entry (id "clp/global-constraints/element-propagate") (skill clp) (module global-constraints) (tier 1) (difficulty 10808) (name element-propagate) (type "(-> CStore LVar (List Int) LVar (Maybe CStore))") (description "Propagate element constraint by narrowing index and value domains") (notes ()) (section element-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element)) (answer "(define (element-propagate cs index array value) (let* ((n (length array)) (idx-dom (cstore-get-domain cs index)) (val-dom (cstore-get-domain cs value))) (let ((cs1 (if idx-dom (cstore-narrow-domain cs index (make-domain 1 n)) (cstore-set-domain cs index (make-domain 1 n))))) (if (not cs1) #f (let ((idx-dom (cstore-get-domain cs1 index))) (let* ((possible-vals (filter-map (lambda (i) (if (domain-contains? idx-dom i) (list-ref array (- i 1)) #f)) (range 1 (+ n 1)))) (val-constraint (domain-from-list possible-vals))) (let ((cs2 (cstore-narrow-domain cs1 value val-constraint))) (if (not cs2) #f (let ((val-dom (cstore-get-domain cs2 value))) (if val-dom (let* ((valid-indices (filter (lambda (i) (domain-contains? val-dom (list-ref array (- i 1)))) (domain->list idx-dom))) (idx-constraint (domain-from-list valid-indices))) (cstore-narrow-domain cs2 index idx-constraint)) cs2))))))))))"))
(task-entry (id "clp/propagate/post-<=fd") (skill clp) (module propagate) (tier 1) (difficulty 10808) (name post-<=fd) (type "(-> CStore (Or LVar Int) (Or LVar Int) (Maybe CStore))") (description "Post less-or-equal constraint and propagate") (notes ()) (section high-level-constraint-posting) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd post-<fd)) (answer "(define (post-<=fd cs x y) (let ((vars (filter lvar? (list x y)))) (if (null? vars) ((<=fd x y) cs) (post-constraint cs '<=fd vars (<=fd x y)))))"))
(task-entry (id "clp/label/label-with") (skill clp) (module label) (tier 1) (difficulty 10808) (name label-with) (type "(-> VarOrder ValSelect CStore (List LVar) (Stream CStore))") (description "Label variables with custom strategies") (notes ()) (section labeling-functions) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label)) (answer "(define (label-with var-order val-select cs vars) (let ((var (var-order cs vars))) (if (not var) (stream-cons cs (lambda () stream-nil)) (let ((dom (cstore-get-domain cs var))) (if (or (not dom) (domain-empty? dom)) stream-nil (label-values var-order val-select cs vars var dom))))))"))
(task-entry (id "clp/clp/goal-in-domain") (skill clp) (module clp) (tier 1) (difficulty 10808) (name goal-in-domain) (type "(-> LVar (List Int) Goal)") (description "Constrain var to list of values") (notes ()) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range)) (answer "(define (goal-in-domain var vals) (clp-goal (in-domain var vals)))"))
