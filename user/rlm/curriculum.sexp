(task-entry (id "physics/diff/rollout/rollout-checkpoints") (skill physics/diff) (module rollout) (tier 2) (difficulty 23106) (name rollout-checkpoints) (type "") (description "") (notes ()) (section basic-rollout) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body \x27;traced-integrators)) (available (traced-rollout traced-rollout-with-gravity traced-rollout-with-force traced-rollout-trajectory traced-trajectory-final checkpoint-interval)) (answer "(define (rollout-checkpoints initial-body step-fn num-steps checkpoint-freq) (let* ((num-checkpoints (+ 1 (exact (ceiling (/ num-steps checkpoint-freq))))) (checkpoints (make-vector num-checkpoints))) (vector-set! checkpoints 0 initial-body) (let loop ((body initial-body) (step 0) (ckpt-idx 1)) (if (>= step num-steps) checkpoints (let ((new-body (step-fn body)) (next-step (+ step 1))) (if (and (= (mod next-step checkpoint-freq) 0) (< ckpt-idx num-checkpoints)) (begin (vector-set! checkpoints ckpt-idx new-body) (loop new-body next-step (+ ckpt-idx 1))) (loop new-body next-step ckpt-idx)))))))"))
(task-entry (id "physics/diff/optimize/estimate-mass") (skill physics/diff) (module optimize) (tier 2) (difficulty 23106) (name estimate-mass) (type "") (description "") (notes ()) (section gradient-descent) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body \x27;traced-integrators \x27;rollout)) (available (gradient-descent-step gradient-descent momentum-step gradient-descent-momentum adam-step adam)) (answer "(define (estimate-mass observations gravity dt initial-guess max-iters) (let* ((loss-fn (lambda (mass-list) (let ((mass (car mass-list))) (fold-left + 0 (map (lambda (obs) (let* ((start (car obs)) (observed-end (cdr obs)) (inertia (circle-inertia mass 1)) (body (make-rigid-body (rigid-body-pos start) (rigid-body-vel start) (rigid-body-angle start) (rigid-body-angular-vel start) mass inertia)) (new-vel (vec2-add (rigid-body-vel body) (vec2-scale gravity dt))) (new-pos (vec2-add (rigid-body-pos body) (vec2-scale new-vel dt))) (pos-error (vec2-distance-sq new-pos (rigid-body-pos observed-end))) (vel-error (vec2-distance-sq new-vel (rigid-body-vel observed-end)))) (+ pos-error vel-error))) observations))))) (result (adam loss-fn (list initial-guess) 0.01 max-iters))) (car result)))"))
