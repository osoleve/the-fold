(task-entry (id "statistics/model-protocol/model-rmse") (skill statistics) (module model-protocol) (tier 1) (difficulty 11201) (name model-rmse) (type "(-> Model Num)") (description "Compute root mean squared error") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;result-types \x27;sort)) (available (model-mse)) (answer "(define (model-rmse model) (sqrt (model-mse model)))"))
(task-entry (id "statistics/summary-stats/variance") (skill statistics) (module summary-stats) (tier 1) (difficulty 11201) (name variance) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean)) (answer "(define (variance xs) (let* ((n (length xs)) (mu (mean xs)) (ss (fold-left + 0 (map (lambda (x) (expt (- x mu) 2)) xs)))) (if (<= n 1) 0 (/ ss (- n 1)))))"))
(task-entry (id "statistics/design-matrix/has-intercept?") (skill statistics) (module design-matrix) (tier 1) (difficulty 11201) (name has-intercept?) (type "(-> Matrix Bool)") (description "Check if first column is all 1s (likely an intercept)") (notes ()) (section intercept-handling) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept)) (answer "(define (has-intercept? X) (let ((m (matrix-rows X))) (let loop ((i 0)) (if (= i m) #t (if (= (matrix-ref X i 0) 1) (loop (+ i 1)) #f)))))"))
(task-entry (id "statistics/diagnostics/hat-matrix-diagonal") (skill statistics) (module diagnostics) (tier 1) (difficulty 11201) (name hat-matrix-diagonal) (type "(-> Matrix Vec)") (description "Compute only the diagonal of the hat matrix (leverage values)") (notes ("More efficient than computing full H for large n" "h_ii = x_i' (X'X)^(-1) x_i")) (section hat-matrix-and-leverage) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers)) (available (hat-matrix)) (answer "(define (hat-matrix-diagonal X) (let* ((m (matrix-rows X)) (n (matrix-cols X)) (XtX (matrix-mul (matrix-transpose X) X)) (XtX-inv (matrix-inverse XtX)) (h (make-vector m))) (if (and (pair? XtX-inv) (eq? (car XtX-inv) 'error)) XtX-inv (begin (do ((i 0 (+ i 1))) ((= i m)) (let ((xi (make-vector n))) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! xi j (matrix-ref X i j))) (let* ((temp (make-vector n 0))) (do ((r 0 (+ r 1))) ((= r n)) (let ((sum (let loop ((c 0) (s 0)) (if (= c n) s (loop (+ c 1) (+ s (* (matrix-ref XtX-inv r c) (vector-ref xi c)))))))) (vector-set! temp r sum))) (let ((hii (let loop ((j 0) (s 0)) (if (= j n) s (loop (+ j 1) (+ s (* (vector-ref xi j) (vector-ref temp j)))))))) (vector-set! h i hii))))) h))))"))
(task-entry (id "statistics/linear/linear-model-compute-diagnostics") (skill statistics) (module linear) (tier 1) (difficulty 11201) (name linear-model-compute-diagnostics) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit)) (answer "(define (linear-model-compute-diagnostics X y beta n p) (let* ((fitted (matrix-vec-mul X beta)) (residuals (residuals-raw y fitted)) (sse (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (expt (vector-ref residuals i) 2)))))) (df-residual (- n p)) (mse (if (> df-residual 0) (/ sse df-residual) 0)) (sigma (sqrt mse)) (se (compute-coefficient-se X mse)) (t-values (if (or (not se) (and (pair? se) (eq? (car se) 'error))) (make-vector p 0) (compute-t-values beta se))) (p-values (compute-p-values t-values df-residual)) (r-squared (compute-r-squared y fitted)) (adj-r-squared (compute-adj-r-squared r-squared n p))) (make-linear-model-result beta se t-values p-values r-squared adj-r-squared residuals fitted sse mse n p)))"))
(task-entry (id "statistics/regularized/ridge-diagnostics") (skill statistics) (module regularized) (tier 1) (difficulty 11201) (name ridge-diagnostics) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit)) (answer "(define (ridge-diagnostics X y beta lambda n p) (let* ((fitted (matrix-vec-mul X beta)) (residuals (make-vector n)) (sse 0)) (do ((i 0 (+ i 1))) ((= i n)) (let ((r (- (vector-ref y i) (vector-ref fitted i)))) (vector-set! residuals i r) (set! sse (+ sse (* r r))))) (let* ((df-residual (- n p)) (mse (if (> df-residual 0) (/ sse df-residual) 0)) (r-squared (compute-r-squared-ridge y fitted)) (se (make-vector p 0)) (t-values (make-vector p 0)) (p-values (make-vector p 1))) (make-linear-model-result beta se t-values p-values r-squared r-squared residuals fitted sse mse n p))))"))
(task-entry (id "statistics/glm/irls-loop") (skill statistics) (module glm) (tier 1) (difficulty 11201) (name irls-loop) (type "") (description "") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available (glm-fit)) (answer "(define (irls-loop family link X y mu eta iter max-iter tol n p) (if (>= iter max-iter) (irls-finalize family link X y mu eta iter #f n p) (let* ((result (irls-step family link X y mu eta n p))) (if (and (pair? result) (eq? (car result) 'error)) result (let* ((beta-new (car result)) (eta-new (cadr result)) (mu-new (caddr result)) (converged? (irls-converged? eta eta-new tol))) (if converged? (irls-finalize family link X y mu-new eta-new iter #t n p) (irls-loop family link X y mu-new eta-new (+ iter 1) max-iter tol n p)))))))"))
