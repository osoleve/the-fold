(task-entry (id "data/graph-matrix/dijkstra-naive") (skill data) (module graph-matrix) (tier 0) (difficulty 1340) (name dijkstra-naive) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize adjacency-symmetrize-sparse degree-matrix degree-matrix-sparse complete-graph cycle-graph path-graph star-graph bipartite-graph adjacency-power adjacency-reachability matrix-power-fast *infinity* transitive-closure floyd-warshall has-negative-cycle? dijkstra)) (answer "(define (dijkstra-naive adj source) (let* ((n (matrix-rows adj)) (dist (make-vector n *infinity*)) (pred (make-vector n -1)) (visited (make-vector n #f))) (vector-set! dist source 0) (do ((iter 0 (+ iter 1))) ((= iter n)) (let ((u (dijkstra-find-min dist visited n))) (when (and u (< (vector-ref dist u) *infinity*)) (vector-set! visited u #t) (do ((v 0 (+ v 1))) ((= v n)) (let ((w (matrix-ref adj u v))) (when (and (> w 0) (not (vector-ref visited v))) (let ((alt (+ (vector-ref dist u) w))) (when (< alt (vector-ref dist v)) (vector-set! dist v alt) (vector-set! pred v u))))))))) (cons dist pred)))"))
