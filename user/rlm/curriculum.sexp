(task-entry (id "autodiff/traced-optics/traversal-over-indexed") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12703) (name traversal-over-indexed) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value untrace-value lift-at-optic)) (answer "(define (traversal-over-indexed trav f s) (let ((idx (box 0))) (traversal-over trav (lambda (a) (let ((i (unbox idx))) (set-box! idx (+ i 1)) (f i a))) s)))"))
(task-entry (id "autodiff/higher-order-diff/hessian-reverse-forward") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12704) (name hessian-reverse-forward) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian)) (answer "(define (hessian-reverse-forward f args n) (let ((result (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n n result)) (let ((grad-i-fn (lambda dual-args (gradient-i f dual-args i)))) (do ((j 0 (+ j 1))) ((= j n)) (let* ((dual-args (let loop ((xs args) (k 0)) (if (null? xs) '() (cons (if (= k j) (dual-variable (car xs)) (dual-lift (car xs))) (loop (cdr xs) (+ k 1)))))) (grad-i (apply grad-i-fn dual-args))) (vector-set! result (+ (* i n) j) (dual-deriv grad-i))))))))"))
