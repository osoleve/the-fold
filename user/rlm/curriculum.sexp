(task-entry (id "numeric/affine/affine-sqr") (skill numeric) (module affine) (tier 0) (difficulty 2519) (name affine-sqr) (type "") (description "") (notes ()) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval affine->interval affine-radius affine-neg merge-terms affine-add affine-sub affine-scale affine-add-constant affine-mul)) (answer "(define (affine-sqr af) (let* ((x0 (affine-center af)) (terms (affine-terms af)) (r (affine-radius af))) (let* ((center (+ (* x0 x0) (/ (* r r) 2))) (linear-terms (map (lambda (t) (cons (car t) (* 2 x0 (cdr t)))) terms)) (error-coef (/ (* r r) 2)) (error-term (if (zero? error-coef) '() (list (cons (affine-fresh-noise-id!) error-coef))))) (make-affine center (append linear-terms error-term)))))"))
(task-entry (id "numeric/fem/apply-dirichlet-penalty!") (skill numeric) (module fem) (tier 0) (difficulty 2519) (name apply-dirichlet-penalty!) (type "") (description "") (notes ()) (section boundary) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes apply-dirichlet-bc!)) (answer "(define (apply-dirichlet-penalty! K F boundary-nodes g mesh) (let ((penalty 1e15)) (for-each (lambda (i) (let* ((p (fem-mesh-node mesh i)) (g-val (g (point2-x p) (point2-y p))) (rows (sparse-coo-row-indices K)) (cols (sparse-coo-col-indices K)) (vals (sparse-coo-values K)) (nnz (vector-length rows))) (let loop ((k 0)) (cond ((= k nnz) (void)) ((and (= (vector-ref rows k) i) (= (vector-ref cols k) i)) (vector-set! vals k (+ (vector-ref vals k) penalty))) (else (loop (+ k 1))))) (vector-set! F i (* penalty g-val)))) boundary-nodes)))"))
(task-entry (id "numeric/pde-time/estimate-mesh-spacing") (skill numeric) (module pde-time) (tier 0) (difficulty 2519) (name estimate-mesh-spacing) (type "") (description "") (notes ()) (section stability) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step mol-rk4-step cfl-parabolic cfl-hyperbolic)) (answer "(define (estimate-mesh-spacing nodes) (let* ((n (vector-length nodes)) (min-dist +inf.0)) (when (>= n 2) (let ((samples (min 100 (- n 1)))) (do ((i 0 (+ i 1))) ((= i samples)) (let* ((p1 (vector-ref nodes i)) (p2 (vector-ref nodes (+ i 1))) (dx (- (if (pair? p1) (car p1) p1) (if (pair? p2) (car p2) p2))) (dist (abs dx))) (when (and (> dist 0) (< dist min-dist)) (set! min-dist dist)))))) min-dist))"))
