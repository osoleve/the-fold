(task-entry (id "fp/free-algebra/validate-algebra") (skill fp) (module free-algebra) (tier 1) (difficulty 10613) (name validate-algebra) (type "(-> Algebra (Result Algebra String))") (description "Validate that an algebra correctly implements its signature\nChecks:\n  1. All signature operations have implementations\n  2. All implementations are procedures\n  3. No extra operations beyond the signature") (notes ()) (section algebra-definition) (deps (\x27;adjunction \x27;rule \x27;engine)) (available (make-signature signature? signature-name signature-operations signature-laws signature-op-arity signature-has-op? make-algebra algebra? algebra-signature algebra-carrier algebra-ops algebra-op)) (answer "(define (validate-algebra alg) (if (not (algebra? alg)) (list 'err \"Not an algebra\") (let* ((sig (algebra-signature alg)) (sig-ops (signature-operations sig)) (alg-ops (algebra-ops alg)) (sig-names (map car sig-ops)) (alg-names (map car alg-ops))) (let ((missing (filter (lambda (name) (not (assq name alg-ops))) sig-names))) (if (pair? missing) (list 'err (format \"Missing operations: ~a\" missing)) (let ((non-procs (filter (lambda (entry) (not (procedure? (cdr entry)))) alg-ops))) (if (pair? non-procs) (list 'err (format \"Non-procedure implementations: ~a\" (map car non-procs))) (let ((extra (filter (lambda (name) (not (assq name sig-ops))) alg-names))) (if (pair? extra) (list 'ok alg extra) (list 'ok alg))))))))))"))
