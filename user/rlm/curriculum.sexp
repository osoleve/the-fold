(task-entry (id "data/graph-matrix/matrix-power-fast") (skill data) (module graph-matrix) (tier 0) (difficulty 1334) (name matrix-power-fast) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize adjacency-symmetrize-sparse degree-matrix degree-matrix-sparse complete-graph cycle-graph path-graph star-graph bipartite-graph adjacency-power adjacency-reachability)) (answer "(define (matrix-power-fast m k) (cond ((= k 0) (matrix-identity (matrix-rows m))) ((= k 1) m) ((even? k) (let ((half (matrix-power-fast m (quotient k 2)))) (matrix-mul half half))) (else (matrix-mul m (matrix-power-fast m (- k 1))))))"))
(task-entry (id "data/graph-layout/hierarchical-layout") (skill data) (module graph-layout) (tier 0) (difficulty 1334) (name hierarchical-layout) (type "") (description "") (notes ()) (section hierarchical) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens graph-nodes-each graph-all-positions graph-all-velocities *repulsion-constant* *attraction-constant* *gravity-constant* *damping* *min-distance* *max-displacement* calculate-repulsion calculate-attraction layout-step node-index run-layout layout-bounds normalize-layout)) (answer "(define (hierarchical-layout node-ids edges depth-fn) (let* ((depths (map (lambda (id) (cons id (depth-fn id))) node-ids)) (max-depth (fold-left (lambda (m p) (max m (cdr p))) 0 depths)) (by-depth (make-vector (+ max-depth 1) '()))) (for-each (lambda (p) (let ((d (cdr p))) (vector-set! by-depth d (cons (car p) (vector-ref by-depth d))))) depths) (let ((nodes '())) (do ((d 0 (+ d 1))) ((> d max-depth)) (let* ((nodes-at-depth (reverse (vector-ref by-depth d))) (n (length nodes-at-depth)) (x (* d 100))) (do ((i 0 (+ i 1)) (ns nodes-at-depth (cdr ns))) ((null? ns)) (let ((y (if (= n 1) 50 (* 100 (/ i (- n 1)))))) (set! nodes (cons (make-graph-node (car ns) x y) nodes)))))) (list 'layout-graph (reverse nodes) edges))))"))
(task-entry (id "data/kdtree/kdtree-insert-3d") (skill data) (module kdtree) (tier 0) (difficulty 1334) (name kdtree-insert-3d) (type "(-> KDTree Point KDTree)") (description "Convenience: insert into 3D tree") (notes ()) (section insertion) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater? kdtree-knn knn-heap->list kdtree-knn-rec kdtree-range kdtree-range-rec point-in-box? kdtree-radius kdtree-size kdtree-height kdtree-balanced? kdtree-fold kdtree->list kdtree-insert kdtree-insert-rec kdtree-insert-2d)) (answer "(define (kdtree-insert-3d tree point) (kdtree-insert tree point 3))"))
(task-entry (id "data/quadtree/quadtree-nearest-rec") (skill data) (module quadtree) (tier 0) (difficulty 1334) (name quadtree-nearest-rec) (type "") (description "") (notes ()) (section nearest-neighbor) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build quadtree-build-auto list->quadtree quadtree-insert quadtree-insert-at-depth quadtree-split quadtree-range quadtree-range-rect quadtree-radius quadtree-nearest)) (answer "(define (quadtree-nearest-rec tree qx qy best-dist best-point) (cond ((quadtree-empty? tree) (cons best-point best-dist)) ((quadtree-leaf? tree) (let ((points (quadtree-leaf-points tree))) (fold-left (lambda (acc pt) (let* ((dx (- (car pt) qx)) (dy (- (cadr pt) qy)) (d-sq (+ (* dx dx) (* dy dy)))) (if (< d-sq (cdr acc)) (cons pt d-sq) acc))) (cons best-point best-dist) points))) ((quadtree-node? tree) (let ((bounds (quadtree-bounds tree))) (if (> (bounds-min-dist-sq bounds qx qy) best-dist) (cons best-point best-dist) (let* ((children (list (quadtree-ne tree) (quadtree-nw tree) (quadtree-se tree) (quadtree-sw tree))) (sorted (sort-by-bounds-dist children qx qy))) (fold-left (lambda (acc child) (let ((child-bounds (quadtree-bounds child))) (if (> (bounds-min-dist-sq child-bounds qx qy) (cdr acc)) acc (quadtree-nearest-rec child qx qy (cdr acc) (car acc))))) (cons best-point best-dist) sorted)))))))"))
