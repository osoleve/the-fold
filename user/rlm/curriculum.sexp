(task-entry (id "optics/schema/fields-keep-only-iso") (skill optics) (module schema) (tier 1) (difficulty 11012) (name fields-keep-only-iso) (type "(-> (List Symbol) (PIso Alist Alist))") (description "Keep only specified fields (destructive forward, cannot restore). Backward is identity since removed fields are gone") (notes ()) (section bulk-operations) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso field-split-iso field-merge-iso field-move-to-front-iso nested-field-iso field-ensure-iso field-with-default-iso fields-rename-iso)) (answer "(define (fields-keep-only-iso fields) (make-p-iso (lambda (alist) (filter (lambda (pair) (memq (car pair) fields)) alist)) identity))"))
