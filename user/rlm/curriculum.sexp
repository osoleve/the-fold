ld id (lambda (e) (if (entity-3d-static? e) e (let* ((body (entity-3d-body e)) (inv-mass (rigid-body-3d-inv-mass body)) (new-vel (vec3-add (rigid-body-3d-vel body) (vec3-scale force inv-mass))) (new-body (rigid-body-3d-with-vel body new-vel))) (entity-3d-with-body e new-body))))))"))
