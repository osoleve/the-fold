(task-entry (id "algebra/tropical/newton-polygon") (skill algebra) (module tropical) (tier 0) (difficulty 320) (name newton-polygon) (type "") (description "") (notes ()) (section tropical-polynomials) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add tropical-matrix-power tropical-matrix-closure tropical-eigenvalue tropical-critical-edges tropical-poly-eval)) (answer "(define (newton-polygon coeffs) (let ((points (let loop ((cs coeffs) (i 0) (acc '())) (if (null? cs) (reverse acc) (if (finite? (car cs)) (loop (cdr cs) (+ i 1) (cons (cons i (car cs)) acc)) (loop (cdr cs) (+ i 1) acc)))))) (if (< (length points) 2) points (let loop ((pts (cdr points)) (hull (list (car points)))) (if (null? pts) (reverse hull) (let ((p (car pts))) (loop (cdr pts) (trim-hull hull p))))))))"))
