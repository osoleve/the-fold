(task-entry (id "physics/classical/raycasting/ray2-aabb") (skill physics/classical) (module raycasting) (tier 2) (difficulty 23513) (name ray2-aabb) (type "") (description "") (notes ()) (section ray-aabb) (deps (\x27;prelude \x27;vec2 \x27;collision-detection)) (available (*ray-epsilon* make-ray2 ray2? ray2-origin ray2-direction ray2-max-dist ray2-point-at make-hit-info hit-info? hit-info-distance hit-info-point hit-info-normal hit-info-shape)) (answer "(define (ray2-aabb ray aabb) (let* ((origin (ray2-origin ray)) (dir (ray2-direction ray)) (max-dist (ray2-max-dist ray)) (min-p (aabb-min aabb)) (max-p (aabb-max aabb)) (ox (vec2-x origin)) (oy (vec2-y origin)) (dx (vec2-x dir)) (dy (vec2-y dir))) (let*-values (((tx1 tx2 tx-face) (if (< (abs dx) *ray-epsilon*) (if (and (>= ox (vec2-x min-p)) (<= ox (vec2-x max-p))) (values -inf.0 +inf.0 'none) (values +inf.0 -inf.0 'none)) (let* ((inv-dx (/ 1.0 dx)) (t1 (* (- (vec2-x min-p) ox) inv-dx)) (t2 (* (- (vec2-x max-p) ox) inv-dx))) (if (< t1 t2) (values t1 t2 (if (< dx 0) 'right 'left)) (values t2 t1 (if (< dx 0) 'left 'right)))))) ((ty1 ty2 ty-face) (if (< (abs dy) *ray-epsilon*) (if (and (>= oy (vec2-y min-p)) (<= oy (vec2-y max-p))) (values -inf.0 +inf.0 'none) (values +inf.0 -inf.0 'none)) (let* ((inv-dy (/ 1.0 dy)) (t1 (* (- (vec2-y min-p) oy) inv-dy)) (t2 (* (- (vec2-y max-p) oy) inv-dy))) (if (< t1 t2) (values t1 t2 (if (< dy 0) 'top 'bottom)) (values t2 t1 (if (< dy 0) 'bottom 'top))))))) (let* ((tmin (max tx1 ty1)) (tmax (min tx2 ty2))) (cond ((> tmin tmax) #f) ((< tmax 0) #f) ((> tmin max-dist) #f) (else (let* ((t (if (< tmin 0) tmax tmin)) (hit-face (cond ((< tmin 0) (if (= tmax tx2) 'x 'y)) ((= tmin tx1) 'x) (else 'y)))) (if (and (>= t 0) (<= t max-dist)) (let* ((point (ray2-point-at ray t)) (normal (cond ((eq? hit-face 'x) (if (< tmin 0) (vec2 (if (> dx 0) 1 -1) 0) (vec2 (if (< dx 0) 1 -1) 0))) (else (if (< tmin 0) (vec2 0 (if (> dy 0) 1 -1)) (vec2 0 (if (< dy 0) 1 -1))))))) (make-hit-info t point normal aabb)) #f))))))))"))
