(task-entry (id "diffgeo/tangent/tangent-sub") (skill diffgeo) (module tangent) (tier 1) (difficulty 10709) (name tangent-sub) (type "") (description "") (notes ()) (section tangent-vector-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts)) (available (tangent-vector? tangent-vector-point tangent-vector-chart tangent-vector-components tangent-vector-dim make-tangent-vector tangent-zero tangent-basis-vector tangent-add)) (answer "(define (tangent-sub tv1 tv2) (let ((p1 (tangent-vector-point tv1)) (p2 (tangent-vector-point tv2)) (c1 (tangent-vector-chart tv1)) (c2 (tangent-vector-chart tv2))) (cond ((not (equal? p1 p2)) (quasiquote (error different-base-points))) ((not (eq? (chart-name c1) (chart-name c2))) (quasiquote (error different-charts (unquote (chart-name c1)) (unquote (chart-name c2))))) (else (make-tangent-vector p1 c1 (vec-sub (tangent-vector-components tv1) (tangent-vector-components tv2)))))))"))
