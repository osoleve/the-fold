(task-entry (id "tiles/square/square-board-capacity") (skill tiles) (module square) (tier 1) (difficulty 12319) (name square-board-capacity) (type "(-> Board Integer)") (description "Returns the total number of squares in the board (width * height). This is the theoretical capacity based on geometry, not the number of tiles currently stored. For stored tile count, use (board-size board).") (notes ()) (section board-creation) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho square-neighbors-diag square-neighbors-all square-neighbors square-distance-manhattan square-distance-chebyshev square-distance-euclidean square-distance square-line square-range square-ring make-square-board square-board-width square-board-height square-in-bounds?)) (answer "(define (square-board-capacity board) (* (square-board-width board) (square-board-height board)))"))
(task-entry (id "tiles/hex/hex-board-capacity") (skill tiles) (module hex) (tier 1) (difficulty 12319) (name hex-board-capacity) (type "(-> Board Integer)") (description "Returns the total number of hexes that fit in the board's radius. This is the theoretical capacity based on geometry, not the number of tiles currently stored. For stored tile count, use (board-size board). Formula: 1 + 3*n*(n+1) where n is the radius") (notes ()) (section board-creation) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial hex-axial-directions hex-neighbor hex-neighbors hex-neighbors-at-distance hex-distance hex-line hex-range hex-ring hex-rotate-left hex-rotate-right make-hex-board hex-board-radius)) (answer "(define (hex-board-capacity board) (let ((r (hex-board-radius board))) (+ 1 (* 3 r (+ r 1)))))"))
(task-entry (id "tiles/triangle/triangle-rotate-180") (skill tiles) (module triangle) (tier 1) (difficulty 12319) (name triangle-rotate-180) (type "(-> TriangleCoord Integer Integer TriangleCoord)") (description "Rotate triangle 180° around center point. Flips orientation and inverts position.") (notes ()) (section transformations) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge triangle-neighbors-vertex triangle-neighbors-all triangle-neighbors triangle-distance-manhattan triangle-line triangle-range make-triangle-board triangle-board-rows triangle-board-cols triangle-in-bounds?)) (answer "(define (triangle-rotate-180 coord center-r center-c) (let ((r (triangle-row coord)) (c (triangle-col coord)) (ori (triangle-orientation coord))) (triangle-coord (- (* 2 center-r) r) (- (* 2 center-c) c) (if (eq? ori 'up) 'down 'up))))"))
(task-entry (id "tiles/topology-analysis/find-bridges-with-weights") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12319) (name find-bridges-with-weights) (type "") (description "Find all bridges with component sizes using Tarjan's algorithm.\nReturns list of weighted bridges: ((coord1 . coord2) size1 size2 weight)\nwhere size1 is the subtree size, size2 is remaining nodes, weight = size1 * size2.\nO(V+E) time complexity.") (notes ()) (section bottleneck-detection) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<? collect-square-faces coords-adjacent? board-betti-numbers board-connected-regions board-terrain-holes board-topology-analysis board-critical-edges board-critical-edges-weighted weighted-bridge-edge weighted-bridge-size1 weighted-bridge-size2 weighted-bridge-weight)) (answer "(define (find-bridges-with-weights board neighbor-fn) (let* ((walkable-coords (filter (lambda (c) (let ((tile (board-get board c))) (and tile (tile-walkable? tile)))) (board-coords board))) (n (length walkable-coords)) (coord->idx (make-hashtable coord-hash coord-equal?)) (idx->coord (make-vector n))) (if (< n 2) '() (begin (let build-idx ((coords walkable-coords) (i 0)) (unless (null? coords) (hashtable-set! coord->idx (car coords) i) (vector-set! idx->coord i (car coords)) (build-idx (cdr coords) (+ i 1)))) (let* ((adj (make-vector n '())) (_ (for-each (lambda (c) (let ((i (hashtable-ref coord->idx c #f))) (when i (let ((neighbors (filter-map (lambda (nc) (hashtable-ref coord->idx nc #f)) (neighbor-fn c)))) (vector-set! adj i neighbors))))) walkable-coords)) (disc (make-vector n -1)) (low (make-vector n -1)) (parent (make-vector n -1)) (subtree (make-vector n 1)) (time-counter (list 0)) (bridges '())) (letrec ((dfs (lambda (u) (let ((current-time (car time-counter))) (vector-set! disc u current-time) (vector-set! low u current-time) (set-car! time-counter (+ current-time 1)) (for-each (lambda (v) (cond ((= (vector-ref disc v) -1) (vector-set! parent v u) (dfs v) (vector-set! subtree u (+ (vector-ref subtree u) (vector-ref subtree v))) (vector-set! low u (min (vector-ref low u) (vector-ref low v))) (when (> (vector-ref low v) (vector-ref disc u)) (let* ((size1 (vector-ref subtree v)) (size2 (- n size1)) (weight (* size1 size2))) (set! bridges (cons (list (cons (vector-ref idx->coord u) (vector-ref idx->coord v)) size1 size2 weight) bridges))))) ((not (= v (vector-ref parent u))) (vector-set! low u (min (vector-ref low u) (vector-ref disc v)))))) (vector-ref adj u)))))) (let run-dfs ((i 0)) (when (< i n) (when (= (vector-ref disc i) -1) (dfs i)) (run-dfs (+ i 1)))) bridges))))))"))
(task-entry (id "tiles/core/board-size") (skill tiles) (module core) (tier 1) (difficulty 12320) (name board-size) (type "(-> Board Integer)") (description "Returns the number of tiles currently stored on the board. NOTE: This counts stored tiles, not theoretical capacity. For an empty sparse board (created without default-tile), this returns 0. For geometric capacity (e.g., how many hexes fit in the radius), use shape-specific functions like hex-board-capacity.") (notes ()) (section board-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords)) (answer "(define (board-size board) (hashtable-size (board%-tiles board)))"))
(task-entry (id "tiles/triangle/triangle-reflect-horizontal") (skill tiles) (module triangle) (tier 1) (difficulty 12320) (name triangle-reflect-horizontal) (type "(-> TriangleCoord Integer TriangleCoord)") (description "Reflect triangle across vertical axis at column C") (notes ()) (section transformations) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge triangle-neighbors-vertex triangle-neighbors-all triangle-neighbors triangle-distance-manhattan triangle-line triangle-range make-triangle-board triangle-board-rows triangle-board-cols triangle-in-bounds? triangle-rotate-180)) (answer "(define (triangle-reflect-horizontal coord axis-col) (let ((r (triangle-row coord)) (c (triangle-col coord)) (ori (triangle-orientation coord))) (triangle-coord r (- (* 2 axis-col) c) ori)))"))
(task-entry (id "tiles/topology-analysis/board-bottleneck-score") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12320) (name board-bottleneck-score) (type "") (description "") (notes ()) (section bottleneck-detection) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<? collect-square-faces coords-adjacent? board-betti-numbers board-connected-regions board-terrain-holes board-topology-analysis board-critical-edges board-critical-edges-weighted weighted-bridge-edge weighted-bridge-size1 weighted-bridge-size2 weighted-bridge-weight find-bridges-with-weights)) (answer "(define (board-bottleneck-score board neighbor-fn tile-coord) (let ((weighted-bridges (find-bridges-with-weights board neighbor-fn))) (fold-left + 0 (map weighted-bridge-weight (filter (lambda (wb) (let ((edge (weighted-bridge-edge wb))) (or (coord-equal? (car edge) tile-coord) (coord-equal? (cdr edge) tile-coord)))) weighted-bridges)))))"))
(task-entry (id "tiles/core/board-empty?") (skill tiles) (module core) (tier 1) (difficulty 12321) (name board-empty?) (type "(-> Board Boolean)") (description "Returns #t if no tiles are stored on the board") (notes ()) (section board-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size)) (answer "(define (board-empty? board) (= (board-size board) 0))"))
(task-entry (id "tiles/triangle/triangle-reflect-vertical") (skill tiles) (module triangle) (tier 1) (difficulty 12321) (name triangle-reflect-vertical) (type "(-> TriangleCoord Integer TriangleCoord)") (description "Reflect triangle across horizontal axis at row R. Flips orientation.") (notes ()) (section transformations) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge triangle-neighbors-vertex triangle-neighbors-all triangle-neighbors triangle-distance-manhattan triangle-line triangle-range make-triangle-board triangle-board-rows triangle-board-cols triangle-in-bounds? triangle-rotate-180 triangle-reflect-horizontal)) (answer "(define (triangle-reflect-vertical coord axis-row) (let ((r (triangle-row coord)) (c (triangle-col coord)) (ori (triangle-orientation coord))) (triangle-coord (- (* 2 axis-row) r) c (if (eq? ori 'up) 'down 'up))))"))
(task-entry (id "tiles/topology-analysis/board-bottleneck-scores-all") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12321) (name board-bottleneck-scores-all) (type "") (description "") (notes ()) (section bottleneck-detection) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<? collect-square-faces coords-adjacent? board-betti-numbers board-connected-regions board-terrain-holes board-topology-analysis board-critical-edges board-critical-edges-weighted weighted-bridge-edge weighted-bridge-size1 weighted-bridge-size2 weighted-bridge-weight find-bridges-with-weights board-bottleneck-score)) (answer "(define (board-bottleneck-scores-all board neighbor-fn) (let ((weighted-bridges (find-bridges-with-weights board neighbor-fn)) (scores (make-hashtable coord-hash coord-equal?))) (for-each (lambda (wb) (let* ((edge (weighted-bridge-edge wb)) (c1 (car edge)) (c2 (cdr edge)) (weight (weighted-bridge-weight wb))) (hashtable-set! scores c1 (+ (hashtable-ref scores c1 0) weight)) (hashtable-set! scores c2 (+ (hashtable-ref scores c2 0) weight)))) weighted-bridges) (let-values (((keys vals) (hashtable-entries scores))) (let ((key-list (vector->list keys)) (val-list (vector->list vals))) (merge-sort-by (lambda (a b) (> (cdr a) (cdr b))) (map cons key-list val-list))))))"))
(task-entry (id "tiles/core/square-directions-8") (skill tiles) (module core) (tier 1) (difficulty 12322) (name square-directions-8) (type "") (description "") (notes ()) (section direction-types) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size board-empty?)) (answer "(define square-directions-8 '(n ne e se s sw w nw))"))
(task-entry (id "tiles/topology-analysis/board-most-critical-bridges") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12322) (name board-most-critical-bridges) (type "") (description "") (notes ()) (section bottleneck-detection) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<? collect-square-faces coords-adjacent? board-betti-numbers board-connected-regions board-terrain-holes board-topology-analysis board-critical-edges board-critical-edges-weighted weighted-bridge-edge weighted-bridge-size1 weighted-bridge-size2 weighted-bridge-weight find-bridges-with-weights board-bottleneck-score board-bottleneck-scores-all)) (answer "(define (board-most-critical-bridges board neighbor-fn k) (let* ((bridges (find-bridges-with-weights board neighbor-fn)) (sorted (merge-sort-by (lambda (a b) (> (weighted-bridge-weight a) (weighted-bridge-weight b))) bridges))) (take k sorted)))"))
(task-entry (id "tiles/core/square-directions-4") (skill tiles) (module core) (tier 1) (difficulty 12323) (name square-directions-4) (type "") (description "") (notes ()) (section direction-types) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size board-empty? square-directions-8)) (answer "(define square-directions-4 '(n e s w))"))
(task-entry (id "tiles/topology-analysis/board-topology-summary") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12323) (name board-topology-summary) (type "") (description "") (notes ()) (section strategic-analysis) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<? collect-square-faces coords-adjacent? board-betti-numbers board-connected-regions board-terrain-holes board-topology-analysis board-critical-edges board-critical-edges-weighted weighted-bridge-edge weighted-bridge-size1 weighted-bridge-size2 weighted-bridge-weight find-bridges-with-weights board-bottleneck-score board-bottleneck-scores-all board-most-critical-bridges)) (answer "(define (board-topology-summary board neighbor-fn) (let* ((sc (board->simplicial-complex board neighbor-fn)) (betti (sc-betti-numbers sc)) (weighted (find-bridges-with-weights board neighbor-fn)) (total-tiles (length (board-coords board))) (walkable (length (filter (lambda (c) (let ((t (board-get board c))) (and t (tile-walkable? t)))) (board-coords board))))) (printf \"~n=== Board Topology Summary ===~n\") (printf \"Total tiles:        ~a~n\" total-tiles) (printf \"Walkable tiles:     ~a~n\" walkable) (printf \"Walkable ratio:     ~a%~n\" (round (* 100 (/ walkable total-tiles)))) (printf \"~n--- Homology ---~n\") (printf \"Connected regions:  ~a (β₀)~n\" (if (null? betti) 0 (car betti))) (printf \"Terrain holes:      ~a (β₁)~n\" (if (< (length betti) 2) 0 (cadr betti))) (printf \"~n--- Strategic Analysis ---~n\") (printf \"Critical edges:     ~a~n\" (length weighted)) (when (not (null? weighted)) (let ((sorted (merge-sort-by (lambda (a b) (> (weighted-bridge-weight a) (weighted-bridge-weight b))) weighted)) (max-show 10)) (printf \"~nTop chokepoints (by strategic weight):~n\") (for-each (lambda (wb) (let ((edge (weighted-bridge-edge wb)) (s1 (weighted-bridge-size1 wb)) (s2 (weighted-bridge-size2 wb)) (w (weighted-bridge-weight wb))) (printf \"  (~a,~a) ↔ (~a,~a)  [~a × ~a = ~a]~n\" (coord-x (car edge)) (coord-y (car edge)) (coord-x (cdr edge)) (coord-y (cdr edge)) s1 s2 w))) (take max-show sorted)))) (printf \"===============================~n\")))"))
