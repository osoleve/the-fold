(task-entry (id "info/coding/find-symbol-for-code") (skill info) (module coding) (tier 1) (difficulty 11121) (name find-symbol-for-code) (type "(-> Real (List (List Symbol Real Real)) (List Symbol Real Real))") (description "") (notes ()) (section arithmetic-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob huffman-codes huffman-codes-helper huffman-encode huffman-decode huffman-decode-helper huffman-average-length huffman-efficiency arithmetic-encode arithmetic-encode-helper build-cumulative-probs arithmetic-decode arithmetic-decode-helper)) (answer "(define (find-symbol-for-code code cumulative) (let loop ((remaining cumulative)) (if (null? remaining) (error \"find-symbol-for-code\" \"code out of range\") (let* ((entry (car remaining)) (low (cadr entry)) (high (caddr entry))) (if (and (>= code low) (< code high)) entry (loop (cdr remaining)))))))"))
