(task-entry (id "statistics/distributions/t-quantile") (skill statistics) (module distributions) (tier 1) (difficulty 11201) (name t-quantile) (type "") (description "") (notes ()) (section student-t-distribution) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available (t-cdf)) (answer "(define (t-quantile p df) (cond ((<= p 0) (error 't-quantile \"p must be in (0, 1)\" p)) ((>= p 1) (error 't-quantile \"p must be in (0, 1)\" p)) ((<= df 0) (error 't-quantile \"df must be positive\" df)) (else (let* ((z0 (standard-normal-quantile p)) (x0 (if (> df 30) z0 (* z0 (sqrt (/ df (- df 2))))))) (newton-raphson-quantile (lambda (x) (t-cdf x df)) (lambda (x) (t-pdf x df)) p x0 50 1e-10)))))"))
