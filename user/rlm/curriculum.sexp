(task-entry (id "algebra/galois/gf-ext-add") (skill algebra) (module galois) (tier 0) (difficulty 313) (name gf-ext-add) (type "") (description "") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations)) (answer "(define (gf-ext-add a b base-field n modulus) (let* ((ca (gf-ext-coeffs a)) (cb (gf-ext-coeffs b)) (add-op (field-add-op base-field)) (zero (field-zero base-field))) (make-gf-ext-element (gf-ext-normalize (map (lambda (i) (add-op (list-ref-or ca i zero) (list-ref-or cb i zero))) (iota n)) n base-field) modulus base-field)))"))
(task-entry (id "algebra/tropical/tropical-matrix-mul") (skill algebra) (module tropical) (tier 0) (difficulty 313) (name tropical-matrix-mul) (type "") (description "") (notes ()) (section matrix-operations) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity)) (answer "(define (tropical-matrix-mul sr A B) (let* ((m (matrix-rows A)) (p (matrix-cols A)) (n (matrix-cols B)) (zero (semiring-zero sr)) (data (make-vector (* m n) zero))) (do ((i 0 (+ i 1))) ((= i m)) (do ((j 0 (+ j 1))) ((= j n)) (let loop ((k 0) (acc zero)) (if (= k p) (vector-set! data (+ (* i n) j) acc) (loop (+ k 1) (tropical-add sr acc (tropical-mul sr (matrix-ref A i k) (matrix-ref B k j)))))))) (list 'matrix m n data)))"))
(task-entry (id "algebra/group/verify-associativity") (skill algebra) (module group) (tier 0) (difficulty 314) (name verify-associativity) (type "(-> Group Boolean)") (description "Check that (a ∘ b) ∘ c = a ∘ (b ∘ c) for all elements") (notes ()) (section group-axiom-verification) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure)) (answer "(define (verify-associativity g) (let ((elems (group-elements g)) (op (group-op g)) (eq? (group-equal-fn g))) (let loop-a ((as elems)) (if (null? as) #t (let loop-b ((bs elems)) (if (null? bs) (loop-a (cdr as)) (let loop-c ((cs elems)) (if (null? cs) (loop-b (cdr bs)) (let* ((a (car as)) (b (car bs)) (c (car cs)) (left (op (op a b) c)) (right (op a (op b c)))) (if (eq? left right) (loop-c (cdr cs)) #f))))))))))"))
