(task-entry (id "algebra/galois/gf-ext-equal?") (skill algebra) (module galois) (tier 0) (difficulty 318) (name gf-ext-equal?) (type "") (description "") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div)) (answer "(define (gf-ext-equal? a b base-field) (let* ((ca (gf-ext-coeffs a)) (cb (gf-ext-coeffs b)) (eq-fn (field-equal-fn base-field))) (and (= (length ca) (length cb)) (let loop ((as ca) (bs cb)) (or (null? as) (and (eq-fn (car as) (car bs)) (loop (cdr as) (cdr bs))))))))"))
(task-entry (id "algebra/tropical/tropical-critical-edges") (skill algebra) (module tropical) (tier 0) (difficulty 318) (name tropical-critical-edges) (type "") (description "") (notes ()) (section eigenvalue) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add tropical-matrix-power tropical-matrix-closure tropical-eigenvalue)) (answer "(define (tropical-critical-edges A eigenval) (let* ((n (matrix-rows A)) (B-data (make-vector (* n n) +inf.0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let ((a-ij (matrix-ref A i j))) (when (finite? a-ij) (vector-set! B-data (+ (* i n) j) (- a-ij eigenval)))))) (let* ((B (list 'matrix n n B-data)) (B* (tropical-matrix-closure min-plus-semiring B))) (let loop-i ((i 0) (result '())) (if (= i n) (reverse result) (let loop-j ((j 0) (result result)) (if (= j n) (loop-i (+ i 1) result) (let ((b-ij (matrix-ref B i j)) (d-ji (matrix-ref B* j i))) (if (and (finite? b-ij) (finite? d-ji) (= (+ b-ij d-ji) 0)) (loop-j (+ j 1) (cons (list i j) result)) (loop-j (+ j 1) result))))))))))"))
(task-entry (id "algebra/group/Z") (skill algebra) (module group) (tier 0) (difficulty 319) (name Z) (type "(-> Integer Group)") (description "Alias for make-cyclic-group") (notes ()) (section cyclic-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group)) (answer "(define Z make-cyclic-group)"))
(task-entry (id "algebra/ring/is-zero-divisor?") (skill algebra) (module ring) (tier 0) (difficulty 319) (name is-zero-divisor?) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product is-commutative-ring?)) (answer "(define (is-zero-divisor? r a) (let ((elems (ring-elements r)) (zero (ring-zero r))) (if (ring-equal? r a zero) #f (let loop ((bs elems)) (if (null? bs) #f (let ((b (car bs))) (if (and (not (ring-equal? r b zero)) (or (ring-equal? r (ring-mul r a b) zero) (ring-equal? r (ring-mul r b a) zero))) #t (loop (cdr bs)))))))))"))
(task-entry (id "algebra/field/field-equal?") (skill algebra) (module field) (tier 0) (difficulty 319) (name field-equal?) (type "") (description "") (notes ()) (section field-representation) (deps (\x27;prelude \x27;ring)) (available (make-field make-field* field? field-elements field-add-op field-mul-op field-zero field-one field-neg-fn field-div-fn field-equal-fn field-metadata field-meta-ref field-add field-mul field-neg field-sub field-div field-inv)) (answer "(define (field-equal? f a b) ((field-equal-fn f) a b))"))
(task-entry (id "algebra/polynomial/poly-mul") (skill algebra) (module polynomial) (tier 0) (difficulty 319) (name poly-mul) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale)) (answer "(define (poly-mul p1 p2) (let* ((F (poly-field p1)) (c1 (poly-coeffs p1)) (c2 (poly-coeffs p2)) (zero (field-zero F)) (add (field-add-op F)) (mul (field-mul-op F)) (n1 (length c1)) (n2 (length c2)) (n (+ n1 n2 -1))) (if (or (poly-zero? p1) (poly-zero? p2)) (poly-zero-over F) (make-polynomial F (let loop ((k 0) (result '())) (if (= k n) (reverse result) (loop (+ k 1) (cons (poly-mul-coeff-at add mul c1 c2 k n1 n2 zero) result))))))))"))
(task-entry (id "algebra/multivariate/mono-compare-lex") (skill algebra) (module multivariate) (tier 0) (difficulty 319) (name mono-compare-lex) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal?)) (answer "(define (mono-compare-lex m1 m2 vars) (let loop ((vs vars)) (if (null? vs) 0 (let ((v (car vs))) (let ((e1 (mono-degree-in m1 v)) (e2 (mono-degree-in m2 v))) (cond ((> e1 e2) 1) ((< e1 e2) -1) (else (loop (cdr vs)))))))))"))
(task-entry (id "algebra/groebner/is-groebner-basis?") (skill algebra) (module groebner) (tier 0) (difficulty 319) (name is-groebner-basis?) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger buchberger-loop buchberger-criterion-1? all-pairs reduce-basis mpoly-make-monic minimize-basis any-divides-lm? interreduce remove-equal any ideal-membership? solve-system ideal-intersection ideal-quotient normal-form)) (answer "(define (is-groebner-basis? G) (let ((n (length G)) (pairs (all-pairs (length G)))) (let loop ((ps pairs)) (if (null? ps) #t (let* ((pair (car ps)) (fi (list-ref G (car pair))) (fj (list-ref G (cdr pair))) (s (s-polynomial fi fj)) (r (reduce-poly s G))) (if (mpoly-zero? r) (loop (cdr ps)) #f))))))"))
(task-entry (id "algebra/poly-bridge/Q-field") (skill algebra) (module poly-bridge) (tier 0) (difficulty 319) (name Q-field) (type "") (description "") (notes ()) (section standard-rational-field) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul alg-poly-scale alg-poly-divmod alg-poly-div alg-poly-mod alg-poly-gcd alg-poly-extended-gcd alg-poly-derivative alg-poly-eval alg-poly-monic alg-poly->string alg-make-polynomial)) (answer "(define Q-field (make-field '() + * 0 1 - (lambda (a b) (/ a b)) =))"))
(task-entry (id "algebra/galois/list-ref-or") (skill algebra) (module galois) (tier 0) (difficulty 319) (name list-ref-or) (type "") (description "") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal?)) (answer "(define (list-ref-or lst i default) (if (< i (length lst)) (list-ref lst i) default))"))
(task-entry (id "algebra/tropical/tropical-poly-eval") (skill algebra) (module tropical) (tier 0) (difficulty 319) (name tropical-poly-eval) (type "") (description "") (notes ()) (section tropical-polynomials) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add tropical-matrix-power tropical-matrix-closure tropical-eigenvalue tropical-critical-edges)) (answer "(define (tropical-poly-eval sr coeffs x) (let ((⊕ (semiring-add sr)) (⊗ (semiring-mul sr)) (zero (semiring-zero sr))) (let loop ((cs coeffs) (i 0) (acc zero)) (if (null? cs) acc (let ((term (⊗ (car cs) (tropical-power sr x i)))) (loop (cdr cs) (+ i 1) (⊕ acc term)))))))"))
(task-entry (id "algebra/group/cyclic-generator") (skill algebra) (module group) (tier 0) (difficulty 320) (name cyclic-generator) (type "(-> Integer Integer)") (description "Returns the standard generator of Z_n (which is 1)") (notes ()) (section cyclic-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z)) (answer "(define (cyclic-generator n) 1)"))
(task-entry (id "algebra/ring/has-zero-divisors?") (skill algebra) (module ring) (tier 0) (difficulty 320) (name has-zero-divisors?) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product is-commutative-ring? is-zero-divisor?)) (answer "(define (has-zero-divisors? r) (let ((elems (ring-elements r))) (let loop ((as elems)) (if (null? as) #f (if (is-zero-divisor? r (car as)) #t (loop (cdr as)))))))"))
(task-entry (id "algebra/field/field-power") (skill algebra) (module field) (tier 0) (difficulty 320) (name field-power) (type "") (description "") (notes ()) (section field-representation) (deps (\x27;prelude \x27;ring)) (available (make-field make-field* field? field-elements field-add-op field-mul-op field-zero field-one field-neg-fn field-div-fn field-equal-fn field-metadata field-meta-ref field-add field-mul field-neg field-sub field-div field-inv field-equal?)) (answer "(define (field-power f a n) (cond ((= n 0) (field-one f)) ((< n 0) (field-inv f (field-power f a (- n)))) ((= n 1) a) ((even? n) (let ((half (field-power f a (/ n 2)))) (field-mul f half half))) (else (field-mul f a (field-power f a (- n 1))))))"))
(task-entry (id "algebra/polynomial/poly-mul-coeff-at") (skill algebra) (module polynomial) (tier 0) (difficulty 320) (name poly-mul-coeff-at) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul)) (answer "(define (poly-mul-coeff-at add mul c1 c2 k n1 n2 zero) (let loop ((i 0) (sum zero)) (if (> i k) sum (let ((j (- k i))) (if (and (< i n1) (< j n2)) (loop (+ i 1) (add sum (mul (list-ref c1 i) (list-ref c2 j)))) (loop (+ i 1) sum))))))"))
(task-entry (id "algebra/multivariate/mono-compare-grlex") (skill algebra) (module multivariate) (tier 0) (difficulty 320) (name mono-compare-grlex) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex)) (answer "(define (mono-compare-grlex m1 m2 vars) (let ((d1 (mono-degree m1)) (d2 (mono-degree m2))) (cond ((> d1 d2) 1) ((< d1 d2) -1) (else (mono-compare-lex m1 m2 vars)))))"))
(task-entry (id "algebra/groebner/groebner->string") (skill algebra) (module groebner) (tier 0) (difficulty 320) (name groebner->string) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger buchberger-loop buchberger-criterion-1? all-pairs reduce-basis mpoly-make-monic minimize-basis any-divides-lm? interreduce remove-equal any ideal-membership? solve-system ideal-intersection ideal-quotient normal-form is-groebner-basis?)) (answer "(define (groebner->string G) (string-append \"Gröbner basis with \" (number->string (length G)) \" elements:\n\" (string-join (map (lambda (g) (string-append \"  \" (mpoly->string g))) G) \"\n\")))"))
