(task-entry (id "statistics/model-protocol/cv-score") (skill statistics) (module model-protocol) (tier 1) (difficulty 11206) (name cv-score) (type "(-> (-> Matrix Vec Model) Matrix Vec Nat Num)") (description "K-fold cross-validation returning mean MSE") (notes ()) (section cross-validation) (deps (\x27;prelude \x27;protocol \x27;result-types \x27;sort)) (available (model-mse model-rmse model-mae compare-models-aic compare-models-bic model-summary)) (answer "(define (cv-score fit-fn X y k) (let* ((n (matrix-rows X)) (fold-size (quotient n k)) (total-error 0)) (do ((fold 0 (+ fold 1))) ((= fold k) (/ total-error n)) (let* ((start (* fold fold-size)) (end (if (= fold (- k 1)) n (+ start fold-size))) (split (cv-split X y start end n)) (X-train (car split)) (y-train (cadr split)) (X-test (caddr split)) (y-test (cadddr split)) (model (fit-fn X-train y-train))) (if (and (pair? model) (eq? (car model) 'error)) (set! total-error (+ total-error (* 1e10 (- end start)))) (let* ((predictions (model-predict model X-test)) (fold-mse (compute-mse predictions y-test))) (set! total-error (+ total-error (* fold-mse (- end start))))))))))"))
