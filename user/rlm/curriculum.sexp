(task-entry (id "statistics/f-test/f-test-nested-models") (skill statistics) (module f-test) (tier 1) (difficulty 11205) (name f-test-nested-models) (type "") (description "") (notes ()) (section variance-ratio-test) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;stat/distributions)) (available (f-test-variance variance-ratio-ci levene-test bartlett-test f-test-regression)) (answer "(define (f-test-nested-models r2-full r2-reduced n p-full p-reduced) (let* ((df1 (- p-full p-reduced)) (df2 (- n p-full)) (r2-diff (- r2-full r2-reduced)) (f-stat (if (or (<= df1 0) (<= df2 0) (>= r2-full 1)) 0 (/ (* r2-diff df2) (* (- 1 r2-full) df1)))) (p-value (if (= f-stat 0) 1 (f-pvalue f-stat df1 df2)))) (make-test-result 'f-test-nested f-stat (cons df1 df2) p-value #f #f)))"))
