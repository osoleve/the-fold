(task-entry (id "data/avl-tree/rebalance") (skill data) (module avl-tree) (tier 0) (difficulty 1313) (name rebalance) (type "(-> AVL AVL)") (description "Rebalance tree after insertion or deletion") (notes ()) (section smart-constructor-and-rotations) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node rotate-left rotate-right)) (answer "(define (rebalance tree) (let ((bf (avl-balance-factor tree))) (cond ((> bf 1) (if (< (avl-balance-factor (avl-left tree)) 0) (rotate-right (make-avl-node (avl-key tree) (avl-value tree) (rotate-left (avl-left tree)) (avl-right tree))) (rotate-right tree))) ((< bf -1) (if (> (avl-balance-factor (avl-right tree)) 0) (rotate-left (make-avl-node (avl-key tree) (avl-value tree) (avl-left tree) (rotate-right (avl-right tree)))) (rotate-left tree))) (else tree))))"))
