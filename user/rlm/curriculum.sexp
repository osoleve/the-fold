(task-entry (id "numeric/fem/sparse-csr-diagonal") (skill numeric) (module fem) (tier 0) (difficulty 2524) (name sparse-csr-diagonal) (type "") (description "") (notes ()) (section sparse-cg) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes apply-dirichlet-bc! apply-dirichlet-penalty! *fem-tolerance* *fem-max-iterations* sparse-cg sparse-cg-loop)) (answer "(define (sparse-csr-diagonal A) (let* ((n (sparse-csr-rows A)) (row-ptrs (sparse-csr-row-ptrs A)) (col-indices (sparse-csr-col-indices A)) (vals (sparse-csr-values A)) (diag (make-vector n 0.0))) (do ((i 0 (+ i 1))) ((= i n) diag) (let ((start (vector-ref row-ptrs i)) (end (vector-ref row-ptrs (+ i 1)))) (do ((k start (+ k 1))) ((= k end)) (when (= (vector-ref col-indices k) i) (vector-set! diag i (vector-ref vals k))))))))"))
(task-entry (id "numeric/pde-time/cg-loop") (skill numeric) (module pde-time) (tier 0) (difficulty 2524) (name cg-loop) (type "") (description "") (notes ()) (section sparse-utils) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step mol-rk4-step cfl-parabolic cfl-hyperbolic estimate-mesh-spacing adaptive-euler-step integrate-adaptive sparse-csr-identity sparse-cg-solve)) (answer "(define (cg-loop A b x r p rr iter max-iter tol n) (let ((r-norm (sqrt rr))) (cond ((< r-norm tol) (list x r-norm iter)) ((>= iter max-iter) (list x r-norm iter)) (else (let* ((Ap (sparse-csr-vec-mul A p)) (pAp (pde-vec-dot p Ap))) (if (< (abs pAp) *pde-epsilon*) (list x r-norm iter) (let* ((alpha (/ rr pAp)) (x-new (pde-vec-madd x alpha p)) (r-new (pde-vec-madd r (- alpha) Ap)) (rr-new (pde-vec-dot r-new r-new)) (beta (/ rr-new rr)) (p-new (pde-vec-madd r-new beta p))) (cg-loop A b x-new r-new p-new rr-new (+ iter 1) max-iter tol n))))))))"))
(task-entry (id "numeric/complex/complex-sqrt") (skill numeric) (module complex) (tier 0) (difficulty 2525) (name complex-sqrt) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;transcendental)) (available (make-complex complex? complex-real complex-imag real-num->complex i-value make-polar complex-magnitude complex-angle complex->polar polar->complex complex-add complex-sub complex-mul complex-div complex-negate complex-conjugate complex-reciprocal complex-equal? complex-zero? complex-real? complex-imaginary? complex-exp complex-log complex-pow)) (answer "(define (complex-sqrt z) (let* ((a (complex-real z)) (b (complex-imag z)) (r (complex-magnitude z))) (if (= b 0) (if (>= a 0) (make-complex (sqrt a) 0) (make-complex 0 (sqrt (- a)))) (let ((re (sqrt (/ (+ r a) 2))) (im (* (if (>= b 0) 1 -1) (sqrt (/ (- r a) 2))))) (make-complex re im)))))"))
