(task-entry (id "autodiff/differentiable-signal/traced-dft-real") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12709) (name traced-dft-real) (type "(-> (Vector (Either Traced Number)) (Vector Traced))") (description "Traced DFT operation for real-valued signals") (notes ()) (section traced-dft) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel)) (answer "(define (traced-dft-real x) (let* ((tape (vec-extract-tape x)) (n (vector-length x)) (x-vals (vec-extract-values x)) (x-complex (real->complex-vec x-vals)) (result-complex (dft x-complex)) (result-mag (magnitude-spectrum result-complex))) (if (not tape) result-complex (let ((result (make-vector (* 2 n))) (input-ids (let ((ids (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) ids) (vector-set! ids i (traced-id (vector-ref x i))))))) (do ((k 0 (+ k 1))) ((= k n) result) (let* ((c (vector-ref result-complex k)) (re (complex-real c)) (im (complex-imag c)) (re-id (fresh-id)) (im-id (fresh-id))) (reverse-tape-push! tape (list re-id 'dft-real-re (vector->list input-ids) (make-dft-re-local-grads n k))) (reverse-tape-push! tape (list im-id 'dft-real-im (vector->list input-ids) (make-dft-im-local-grads n k))) (vector-set! result (* 2 k) (traced re re-id tape)) (vector-set! result (+ (* 2 k) 1) (traced im im-id tape))))))))"))
