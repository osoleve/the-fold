(task-entry (id "fp/poly-canonical/expr-degree") (skill fp) (module poly-canonical) (tier 1) (difficulty 10603) (name expr-degree) (type "") (description "") (notes ()) (section conversion) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial polynomial-expr?)) (answer "(define (expr-degree expr var-sym) (cond ((num? expr) 0) ((var? expr) (if (eq? (var-name expr) var-sym) 1 0)) ((sum? expr) (apply max (map (lambda (t) (expr-degree t var-sym)) (sum-terms expr)))) ((product? expr) (apply + (map (lambda (f) (expr-degree f var-sym)) (product-factors expr)))) ((difference? expr) (max (expr-degree (diff-left expr) var-sym) (if (diff-right expr) (expr-degree (diff-right expr) var-sym) 0))) ((power? expr) (if (and (num? (pow-exp expr)) (integer? (num-val (pow-exp expr))) (>= (num-val (pow-exp expr)) 0)) (* (expr-degree (pow-base expr) var-sym) (num-val (pow-exp expr))) 999)) (else 0)))"))
