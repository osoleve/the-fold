(task-entry (id "algebra/polynomial/poly-divmod") (skill algebra) (module polynomial) (tier 0) (difficulty 323) (name poly-divmod) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal?)) (answer "(define (poly-divmod p1 p2) (let* ((F (poly-field p1)) (d2 (poly-degree p2))) (if (poly-zero? p2) (error 'poly-divmod \"division by zero polynomial\") (poly-divmod-loop p1 p2 (poly-zero-over F) F))))"))
