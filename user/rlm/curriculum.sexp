(task-entry (id "physics/classical/ode-integrators/integrate-adaptive") (skill physics/classical) (module ode-integrators) (tier 2) (difficulty 23516) (name integrate-adaptive) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (state-add state-sub state-scale state-madd euler-step midpoint-step heun-step rk4-step symplectic-euler-step symplectic-euler-step-b verlet-step velocity-verlet-step leapfrog-step integrate integrate-symplectic rk45-step)) (answer "(define (integrate-adaptive f t0 state0 t-end dt-initial tol max-steps) (let loop ((t t0) (state state0) (dt dt-initial) (steps 0) (results (list (list t0 state0)))) (cond ((>= t t-end) (reverse results)) ((>= steps max-steps) (reverse results)) (else (let* ((dt-clamped (min dt (- t-end t))) (result (rk45-step f t state dt-clamped tol)) (new-state (car result)) (error (cadr result)) (suggested-dt (caddr result))) (if (< error tol) (loop (+ t dt-clamped) new-state (min suggested-dt (* 2 dt)) (+ steps 1) (cons (list (+ t dt-clamped) new-state) results)) (loop t state (/ dt 2) steps results)))))))"))
