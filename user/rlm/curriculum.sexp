(task-entry (id "optimization/lp/lp-basis-ranges") (skill optimization) (module lp) (tier 1) (difficulty 12840) (name lp-basis-ranges) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize extract-basis-matrix extract-basis-costs compute-reduced-costs find-entering-variable vec-contains? compute-direction find-leaving-variable update-basis create-phase1-lp run-phase1 pivot-out-artificials find-nonbasic-pivot simplex-core construct-solution construct-unbounded-direction lp-solve ensure-nonnegative-rhs lp-dual lp-shadow-prices lp-reduced-costs)) (answer "(define (lp-basis-ranges lp result) (if (not (lp-optimal? result)) '(error not-optimal) (let* ((A (lp-A lp)) (c (lp-c lp)) (n (vector-length c)) (basis (lp-result-basis result)) (m (vector-length basis)) (B (extract-basis-matrix A basis)) (B-inv (matrix-inverse B))) (if (and (pair? B-inv) (eq? (car B-inv) 'error)) B-inv (let ((reduced (compute-reduced-costs c A basis B-inv)) (ranges '())) (do ((j 0 (+ j 1))) ((= j n) (reverse ranges)) (let ((is-basic (vec-contains? basis j)) (rc (vector-ref reduced j))) (set! ranges (cons (list j (if is-basic -inf.0 rc) (if is-basic +inf.0 (- rc))) ranges)))))))))"))
(task-entry (id "optimization/ilp/set-cover-solve") (skill optimization) (module ilp) (tier 1) (difficulty 12840) (name set-cover-solve) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp make-ilp-optimal make-ilp-infeasible make-ilp-unbounded ilp-optimal? ilp-infeasible? ilp-unbounded? ilp-result-x ilp-result-z is-integer? solution-is-integer? find-fractional-var round-solution make-bb-node bb-node-lp bb-node-lb bb-node-ub add-bound-constraints ilp-solve branch-and-bound vector-take frac generate-gomory-cut matrix-row add-gomory-cut ilp-solve-cutting-plane find-and-generate-cut knapsack-solve)) (answer "(define (set-cover-solve coverage costs) (let* ((m (matrix-rows coverage)) (n (matrix-cols coverage)) (A-ge coverage) (b-ge (vec-ones m)) (BIG-M 1000000) (n-total (+ n m m)) (A-full (make-matrix m n-total 0)) (b-full (vec-ones m)) (c-full (make-vector n-total 0))) (do ((i 0 (+ i 1))) ((= i m)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! A-full i j (matrix-ref coverage i j))) (matrix-set! A-full i (+ n i) -1) (matrix-set! A-full i (+ n m i) 1)) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! c-full j (vector-ref costs j))) (do ((i 0 (+ i 1))) ((= i m)) (vector-set! c-full (+ n m i) BIG-M)) (let* ((A-bin (make-matrix n n-total 0)) (b-bin (vec-ones n))) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! A-bin j j 1)) (let* ((A-stack (matrix-vstack A-full A-bin)) (b-stack (vec-append b-full b-bin)) (n-slack n) (A-bin-slack (make-matrix m n-slack 0)) (A-bin-slack2 (matrix-identity n)) (A-final (matrix-hstack A-stack (matrix-vstack A-bin-slack A-bin-slack2))) (c-final (vec-append c-full (vec-zeros n))) (ilp (make-ilp c-final A-final b-stack (iota n))) (result (ilp-solve ilp))) (cond ((not (ilp-optimal? result)) 'infeasible) ((> (ilp-result-z result) (/ BIG-M 2)) 'infeasible) (else (let* ((x-full (ilp-result-x result)) (selected '())) (do ((j 0 (+ j 1))) ((= j n) (reverse selected)) (when (> (vector-ref x-full j) 0.5) (set! selected (cons j selected)))))))))))"))
