(task-entry (id "physics/classical/constraint-graph/cg-color-constraints") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23525) (name cg-color-constraints) (type "") (description "") (notes ()) (section coloring) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints toposort-dag)) (answer "(define (cg-color-constraints graph) (let* ((constraints (cg-constraints graph)) (n (length constraints)) (constraint-vec (list->vector constraints)) (colors (make-vector n -1)) (conflict-adj (build-constraint-conflicts graph constraints))) (let loop ((i 0)) (when (< i n) (let ((used (make-eqv-hashtable))) (for-each (lambda (neighbor-idx) (let ((c (vector-ref colors neighbor-idx))) (when (>= c 0) (hashtable-set! used c #t)))) (vector-ref conflict-adj i)) (let find-color ((c 0)) (if (hashtable-ref used c #f) (find-color (+ c 1)) (vector-set! colors i c)))) (loop (+ i 1)))) (let ((groups (make-eqv-hashtable))) (let loop ((i 0)) (when (< i n) (let ((c (vector-ref colors i))) (hashtable-set! groups c (cons (vector-ref constraint-vec i) (hashtable-ref groups c '())))) (loop (+ i 1)))) (let-values (((keys vals) (hashtable-entries groups))) (map reverse (vector->list vals))))))"))
