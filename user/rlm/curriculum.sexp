(task-entry (id "game-theory/mechanism/second-price-auction") (skill game-theory) (module mechanism) (tier 1) (difficulty 13214) (name second-price-auction) (type "(-> (Vector Number) AuctionOutcome)") (description "Second-price sealed-bid (Vickrey) auction: highest bidder wins, pays second-highest bid") (notes ("DSIC: Truthful bidding is a dominant strategy. Winner's utility = valuation - payment = v - second-highest-bid. Ties broken by *tie-break-strategy*.")) (section single-item-auctions) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction)) (answer "(define (second-price-auction bids) (let* ((winners (bids-winners bids)) (winner (select-winner winners)) (payment (bids-second-max bids))) (make-auction-outcome winner payment)))"))
(task-entry (id "game-theory/evolutionary/pop-size") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13214) (name pop-size) (type "") (description "") (notes ()) (section population-state) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec)) (answer "(define (pop-size pop) (vector-length (pop-vec pop)))"))
(task-entry (id "game-theory/mcdm/mcdm-condorcet") (skill game-theory) (module mcdm) (tier 1) (difficulty 13214) (name mcdm-condorcet) (type "(-> DecisionProblem (Maybe Alternative))") (description "Find Condorcet winner: alternative that beats all others pairwise. Returns #f if no such alternative exists (Condorcet paradox)") (notes ()) (section aggregation-methods) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland)) (answer "(define (mcdm-condorcet dp) (condorcet-winner (dp->profile dp)))"))
(task-entry (id "game-theory/normal-form/is-strictly-dominated-p2?") (skill game-theory) (module normal-form) (tier 1) (difficulty 13215) (name is-strictly-dominated-p2?) (type "") (description "") (notes ()) (section dominated-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1?)) (answer "(define (is-strictly-dominated-p2? game j) (let ((n2 (game-num-strategies game 1))) (ormap (lambda (other) (and (not (= other j)) (strictly-dominates-p2? game other j))) (iota n2))))"))
(task-entry (id "game-theory/extensive-form/make-extensive-game") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13215) (name make-extensive-game) (type "(-> Nat Node ExtensiveGame)") (description "Create an extensive form game from root node") (notes ()) (section game-construction) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children)) (answer "(define (make-extensive-game num-players root) (list 'extensive-game num-players root '()))"))
(task-entry (id "game-theory/coop-games/coop-game-value") (skill game-theory) (module coop-games) (tier 1) (difficulty 13215) (name coop-game-value) (type "(-> CoopGame Coalition Real)") (description "Get characteristic function value for coalition S") (notes ()) (section cooperative-game-record-type) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players)) (answer "(define (coop-game-value g S) ((coop-game%-v g) S))"))
(task-entry (id "game-theory/matching/receiver-prefers?") (skill game-theory) (module matching) (tier 1) (difficulty 13215) (name receiver-prefers?) (type "") (description "") (notes ()) (section gale-shapley) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table)) (answer "(define (receiver-prefers? ranks p1-id p2-id) (let ((r1 (assoc p1-id ranks)) (r2 (assoc p2-id ranks))) (cond ((not r1) #f) ((not r2) #t) (else (< (cdr r1) (cdr r2))))))"))
(task-entry (id "game-theory/voting/antiplurality-scores") (skill game-theory) (module voting) (tier 1) (difficulty 13215) (name antiplurality-scores) (type "") (description "") (notes ()) (section positional-rules) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores)) (answer "(define (antiplurality-scores m) (if (<= m 0) '() (append (make-list (- m 1) 1) '(0))))"))
(task-entry (id "game-theory/strategic-voting/gibbard-satterthwaite-demo") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13215) (name gibbard-satterthwaite-demo) (type "") (description "Demonstrate Gibbard-Satterthwaite by finding manipulations for Plurality, Borda, Copeland, and Schulze") (notes ()) (section gibbard-satterthwaite) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium? find-strategic-equilibrium all-strategic-equilibria cartesian-product-n price-of-anarchy price-of-stability count-manipulable-profiles strategy-proofness-ratio compare-strategy-proofness find-manipulation-example find-manipulation-in-profile)) (answer "(define (gibbard-satterthwaite-demo) (let ((rules (quasiquote ((plurality unquote plurality-winner) (borda unquote borda-winner) (copeland unquote copeland-winner) (schulze unquote schulze-winner))))) (for-each (lambda (rule-pair) (let* ((name (car rule-pair)) (rule (cdr rule-pair)) (example (find-manipulation-example rule 3))) (display (symbol->string name)) (display \": \") (if (eq? example 'not-found) (display \"No manipulation found (surprising!)\n\") (begin (display \"Manipulation found!\n\") (display \"  Voter \") (display (list-ref example 1)) (display \" in profile \") (display (list-ref example 2)) (newline) (display \"  True winner: \") (display (list-ref example 4)) (display \", Fake ballot yields: \") (display (list-ref example 5)) (newline))))) rules)))"))
(task-entry (id "game-theory/voting-games/power-concentration") (skill game-theory) (module voting-games) (tier 1) (difficulty 13215) (name power-concentration) (type "") (description "") (notes ()) (section power-analysis) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison)) (answer "(define (power-concentration power-vec) (let loop ((i 0) (sum 0)) (if (>= i (vector-length power-vec)) sum (let ((p (vector-ref power-vec i))) (loop (+ i 1) (+ sum (* p p)))))))"))
(task-entry (id "game-theory/multi-winner/approval-profile-voters") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13215) (name approval-profile-voters) (type "") (description "") (notes ()) (section approval-voting) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile)) (answer "(define (approval-profile-voters profile) (length profile))"))
(task-entry (id "game-theory/fair-division/division-piece") (skill game-theory) (module fair-division) (tier 1) (difficulty 13215) (name division-piece) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign!)) (answer "(define (division-piece div i) (vector-ref div i))"))
(task-entry (id "game-theory/mechanism/all-pay-auction") (skill game-theory) (module mechanism) (tier 1) (difficulty 13215) (name all-pay-auction) (type "(-> (Vector Number) AuctionOutcome)") (description "All-pay auction: everyone pays their bid, highest bidder wins") (notes ("Models contests where effort is sunk (lobbying, R&D). Not truthful. Revenue can exceed valuation in equilibrium. Ties broken by *tie-break-strategy*.")) (section single-item-auctions) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction)) (answer "(define (all-pay-auction bids) (let* ((n (bids-length bids)) (winners (bids-winners bids)) (winner (select-winner winners)) (payments (let ((v (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) v) (vector-set! v i (bids-ref bids i)))))) (make-auction-outcome winner payments)))"))
(task-entry (id "game-theory/evolutionary/pop-freq") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13215) (name pop-freq) (type "") (description "") (notes ()) (section population-state) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size)) (answer "(define (pop-freq pop i) (vector-ref (pop-vec pop) i))"))
(task-entry (id "game-theory/mcdm/mcdm-ranking") (skill game-theory) (module mcdm) (tier 1) (difficulty 13215) (name mcdm-ranking) (type "(-> DecisionProblem Symbol (List Alternative))") (description "Full ranking of alternatives. Methods: 'borda, 'schulze, 'copeland, 'minimax") (notes ()) (section aggregation-methods) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet)) (answer "(define (mcdm-ranking dp method) (let ((profile (dp->profile dp))) (case method ((borda) (positional-ranking profile (borda-scores (profile-num-candidates profile)))) ((schulze) (schulze-ranking profile)) ((copeland) (copeland-ranking profile)) ((minimax) (minimax-ranking profile)) (else (error 'mcdm-ranking \"Unknown method\" method)))))"))
(task-entry (id "game-theory/normal-form/find-dominated-strategies") (skill game-theory) (module normal-form) (tier 1) (difficulty 13216) (name find-dominated-strategies) (type "") (description "") (notes ()) (section dominated-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2?)) (answer "(define (find-dominated-strategies game) (let ((n1 (game-num-strategies game 0)) (n2 (game-num-strategies game 1))) (cons (filter (lambda (i) (is-strictly-dominated-p1? game i)) (iota n1)) (filter (lambda (j) (is-strictly-dominated-p2? game j)) (iota n2)))))"))
(task-entry (id "game-theory/extensive-form/extensive-game?") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13216) (name extensive-game?) (type "(-> α Bool)") (description "") (notes ()) (section game-construction) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game)) (answer "(define (extensive-game? x) (and (pair? x) (eq? (car x) 'extensive-game)))"))
(task-entry (id "game-theory/coop-games/coop-game-grand-coalition") (skill game-theory) (module coop-games) (tier 1) (difficulty 13216) (name coop-game-grand-coalition) (type "(-> CoopGame Coalition)") (description "The grand coalition N = {0, 1, ..., n-1}") (notes ()) (section cooperative-game-record-type) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value)) (answer "(define (coop-game-grand-coalition g) (- (bitwise-arithmetic-shift-left 1 (coop-game-players g)) 1))"))
(task-entry (id "game-theory/matching/find-receiver-idx") (skill game-theory) (module matching) (tier 1) (difficulty 13216) (name find-receiver-idx) (type "") (description "") (notes ()) (section gale-shapley) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers?)) (answer "(define (find-receiver-idx receivers r-id) (let ((n (vector-length receivers))) (let loop ((i 0)) (cond ((= i n) #f) ((equal? (vector-ref receivers i) r-id) i) (else (loop (+ i 1)))))))"))
