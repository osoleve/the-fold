(task-entry (id "geometry/mesh-topology/vertex-link-edges") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12216) (name vertex-link-edges) (type "") (description "") (notes ()) (section genus-computation) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex mesh-betti-numbers mesh-euler-characteristic mesh-f-vector mesh-connected-components mesh-genus mesh-edge-counts edge-key mesh-is-manifold? mesh-edges-are-manifold? mesh-vertices-are-manifold?)) (answer "(define (vertex-link-edges sc v) (let* ((triangles (sc-simplices-dim sc 2)) (incident (filter (lambda (t) (list-member? v (simplex-vertices t))) triangles)) (link-edges (map (lambda (t) (let ((verts (filter (lambda (x) (not (equal? x v))) (simplex-vertices t)))) (cons (car verts) (cadr verts)))) incident)) (link-verts (unique-list (append-map (lambda (e) (list (car e) (cdr e))) link-edges)))) (list link-verts link-edges)))"))
(task-entry (id "geometry/convex-hull/convex-hull-area") (skill geometry) (module convex-hull) (tier 1) (difficulty 12216) (name convex-hull-area) (type "") (description "") (notes ()) (section utilities) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line find-furthest-from-line quickhull-recurse quickhull convex-hull)) (answer "(define (convex-hull-area hull) (if (< (length hull) 3) 0 (let ((first (car hull))) (abs (/ (let loop ((remaining hull) (sum 0)) (if (null? remaining) sum (let* ((p1 (car remaining)) (p2 (if (null? (cdr remaining)) first (cadr remaining))) (x1 (point2-x p1)) (y1 (point2-y p1)) (x2 (point2-x p2)) (y2 (point2-y p2))) (loop (cdr remaining) (+ sum (- (* x1 y2) (* x2 y1))))))) 2)))))"))
