(task-entry (id "data/kdtree/point-distance-sq") (skill data) (module kdtree) (tier 0) (difficulty 1310) (name point-distance-sq) (type "(-> Point Point Num)") (description "Squared Euclidean distance between points") (notes ()) (section point-utilities) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord)) (answer "(define (point-distance-sq p1 p2) (let loop ((a p1) (b p2) (sum 0)) (if (null? a) sum (let ((d (- (car a) (car b)))) (loop (cdr a) (cdr b) (+ sum (* d d)))))))"))
