(task-entry (id "optimization/newton/make-positive-definite") (skill optimization) (module newton) (tier 1) (difficulty 12805) (name make-positive-definite) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton)) (answer "(define (make-positive-definite m) (let* ((n (matrix-rows m)) (min-diag (let loop ((i 0) (min-val +inf.0)) (if (= i n) min-val (let* ((diag (matrix-ref m i i)) (off-sum (let inner ((j 0) (sum 0)) (if (= j n) sum (inner (+ j 1) (if (= i j) sum (+ sum (abs (matrix-ref m i j)))))))) (lower-bound (- diag off-sum))) (loop (+ i 1) (min min-val lower-bound)))))) (tau (if (< min-diag 1e-6) (+ (abs min-diag) 1e-6) 0))) (if (> tau 0) (matrix-add-diagonal m tau) m)))"))
