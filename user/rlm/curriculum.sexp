(task-entry (id "physics/classical/integrators/integrate-with-substeps") (skill physics/classical) (module integrators) (tier 2) (difficulty 23528) (name integrate-with-substeps) (type "") (description "") (notes ()) (section sub-stepping) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet integrate-body-rk4 make-time-acc time-acc? time-acc-remaining time-acc-fixed-dt time-acc-max-steps time-acc-add time-acc-consume time-acc-alpha substep-body)) (answer "(define (integrate-with-substeps body force-fn time-acc) (let ((fixed-dt (time-acc-fixed-dt time-acc)) (max-steps (time-acc-max-steps time-acc))) (let loop ((b body) (t time-acc) (steps 0)) (let* ((result (time-acc-consume t)) (new-t (car result)) (consumed (cadr result))) (if (or (= consumed 0) (>= steps max-steps)) (list b new-t) (let ((new-b (integrate-body-verlet b force-fn fixed-dt))) (loop new-b new-t (+ steps 1))))))))"))
(task-entry (id "physics/classical/rigid-body/apply-impulse-at-point") (skill physics/classical) (module rigid-body) (tier 2) (difficulty 23528) (name apply-impulse-at-point) (type "") (description "") (notes ()) (section impulse) (deps (\x27;prelude \x27;vec2)) (available (make-rigid-body rigid-body? rigid-body-pos rigid-body-vel rigid-body-angle rigid-body-angular-vel rigid-body-mass rigid-body-inv-mass rigid-body-inertia rigid-body-inv-inertia rigid-body-static? rigid-body-with-pos rigid-body-with-vel rigid-body-with-angle rigid-body-with-angular-vel rigid-body-with-mass rigid-body-with-inertia rigid-body-with-state make-static-rigid-body circle-inertia rectangle-inertia rod-inertia point-mass-inertia local-to-world world-to-local rigid-body-velocity-at apply-linear-impulse apply-angular-impulse)) (answer "(define (apply-impulse-at-point body impulse world-point) (if (rigid-body-static? body) body (let* ((pos (rigid-body-pos body)) (r (vec2-sub world-point pos)) (inv-mass (rigid-body-inv-mass body)) (inv-inertia (rigid-body-inv-inertia body)) (new-vel (vec2-add (rigid-body-vel body) (vec2-scale impulse inv-mass))) (torque-impulse (vec2-cross r impulse)) (new-omega (+ (rigid-body-angular-vel body) (* torque-impulse inv-inertia)))) (rigid-body-with-state body (rigid-body-pos body) new-vel (rigid-body-angle body) new-omega))))"))
(task-entry (id "physics/classical/collision-detection/point-in-aabb?") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23528) (name point-in-aabb?) (type "") (description "") (notes ()) (section point-in-shape) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon)) (answer "(define (point-in-aabb? point aabb) (let ((px (vec2-x point)) (py (vec2-y point)) (min-x (vec2-x (aabb-min aabb))) (min-y (vec2-y (aabb-min aabb))) (max-x (vec2-x (aabb-max aabb))) (max-y (vec2-y (aabb-max aabb)))) (and (>= px min-x) (<= px max-x) (>= py min-y) (<= py max-y))))"))
(task-entry (id "physics/classical/collision-response/calculate-impulse") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23528) (name calculate-impulse) (type "") (description "") (notes ()) (section impulse) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material combine-materials velocity-at-point relative-velocity-at relative-velocity normal-velocity-at normal-velocity tangent-velocity get-inv-mass get-inv-inertia get-body-pos calculate-impulse-with-rotation)) (answer "(define (calculate-impulse body-a body-b normal restitution) (let* ((vel-along-normal (normal-velocity body-a body-b normal)) (inv-mass-a (body-inv-mass body-a)) (inv-mass-b (body-inv-mass body-b)) (total-inv-mass (+ inv-mass-a inv-mass-b))) (if (> vel-along-normal 0) 0 (/ (* (- (+ 1 restitution)) vel-along-normal) total-inv-mass))))"))
(task-entry (id "physics/classical/constraints/constraint-anchor-world-a") (skill physics/classical) (module constraints) (tier 2) (difficulty 23528) (name constraint-anchor-world-a) (type "") (description "") (notes ()) (section helper:) (deps (\x27;prelude \x27;vec2 \x27;rigid-body)) (available (make-constraint constraint? constraint-type constraint-id constraint-entity-a constraint-entity-b constraint-data constraint-solver-velocity constraint-solver-position constraint-cached-lambda constraint-with-cached-lambda make-distance-constraint-data distance-data-anchor-a distance-data-anchor-b distance-data-target make-revolute-constraint-data revolute-data-anchor-a revolute-data-anchor-b make-spring-constraint-data spring-data-anchor-a spring-data-anchor-b spring-data-rest-length spring-data-stiffness spring-data-damping make-weld-constraint-data weld-data-anchor-a weld-data-anchor-b weld-data-reference-angle)) (answer "(define (constraint-anchor-world-a world constraint) (let* ((entity-id (constraint-entity-a constraint)) (data (constraint-data constraint)) (local-anchor (car data))) (constraint-entity-anchor-world world entity-id local-anchor)))"))
(task-entry (id "physics/classical/constraint-graph/cg-stats") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23528) (name cg-stats) (type "") (description "") (notes ()) (section utilities) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints toposort-dag cg-color-constraints build-constraint-conflicts cg-chromatic-number)) (answer "(define (cg-stats graph) (let* ((entities (cg-entities graph)) (constraints (cg-constraints graph)) (islands (cg-find-islands graph)) (sccs (cg-find-sccs graph)) (colors (cg-color-constraints graph))) (quasiquote ((entities unquote (length entities)) (constraints unquote (length constraints)) (islands unquote (length islands)) (largest-island unquote (if (null? islands) 0 (apply max (map island-size islands)))) (sccs unquote (length sccs)) (largest-scc unquote (if (null? sccs) 0 (apply max (map scc-size sccs)))) (colors unquote (length colors)) (max-parallel unquote (if (null? colors) 0 (apply max (map length colors))))))))"))
