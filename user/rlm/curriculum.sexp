(task-entry (id "data/quadtree/bounds-intersects?") (skill data) (module quadtree) (tier 0) (difficulty 1307) (name bounds-intersects?) (type "(-> Bounds Bounds Boolean)") (description "Check if two bounding boxes intersect") (notes ()) (section core-representation) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains?)) (answer "(define (bounds-intersects? b1 b2) (not (or (> (- (bounds-cx b1) (bounds-hw b1)) (+ (bounds-cx b2) (bounds-hw b2))) (< (+ (bounds-cx b1) (bounds-hw b1)) (- (bounds-cx b2) (bounds-hw b2))) (> (- (bounds-cy b1) (bounds-hh b1)) (+ (bounds-cy b2) (bounds-hh b2))) (< (+ (bounds-cy b1) (bounds-hh b1)) (- (bounds-cy b2) (bounds-hh b2))))))"))
