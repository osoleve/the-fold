(task-entry (id "dataset/parameter/param-interpolate") (skill dataset) (module parameter) (tier 1) (difficulty 13430) (name param-interpolate) (type "") (description "") (notes ()) (section interpolation) (deps (\x27;prelude \x27;prng \x27;distributions)) (available (make-prng prng-next-float prng-next-int make-param-range param-range? param-range-name param-range-min param-range-max param-range-strategy param-range-constraint uniform-range range-int range-normal range-choice param-range-choice? param-range-choice-name param-range-choice-values param-range-choice-constraint range-with-constraint param-sample-raw sample-normal param-sample param-sample-default make-param-set param-set? param-set-ranges param-set-joint-constraint param-set-sample-raw param-set-sample param-get)) (answer "(define (param-interpolate r v1 v2 t) (cond ((param-range? r) (let ((strategy (param-range-strategy r))) (case strategy ((uniform uniform-int) (let ((result (+ (* (- 1 t) v1) (* t v2)))) (if (eq? strategy 'uniform-int) (inexact->exact (round result)) result))) ((log-uniform) (exp (+ (* (- 1 t) (log v1)) (* t (log v2))))) (else (+ (* (- 1 t) v1) (* t v2)))))) ((param-range-choice? r) (if (< t 0.5) v1 v2)) (else (+ (* (- 1 t) v1) (* t v2)))))"))
