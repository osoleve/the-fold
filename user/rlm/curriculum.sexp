(task-entry (id "fp/units/dim->string") (skill fp) (module units) (tier 1) (difficulty 10712) (name dim->string) (type "(-> Dimension String)") (description "Display dimension in standard notation.") (notes ()) (section dimension-display) (deps (\x27;prelude)) (available (make-dim dim-length dim-time dim-mass dim-current dim-temperature dim-amount dim-luminosity dim? dim=? dim-one dim-length-base dim-time-base dim-mass-base dim-current-base dim-temperature-base dim-amount-base dim-luminosity-base dim* dim/ dim-pow dim-sqrt dim-inv make-qty qty-value qty-dim qty? qty+ qty- qty* qty/ qty-scale qty-pow qty-sqrt qty-neg qty-abs qty=? qty<? qty>? qty<=? qty>=? meter second kilogram ampere kelvin mole candela dim-velocity dim-acceleration dim-force dim-energy dim-power dim-pressure dim-frequency dim-charge dim-voltage dim-resistance dim-area dim-volume newton joule watt pascal hertz coulomb volt ohm yotta zetta exa peta tera giga mega kilo hecto deca deci centi milli micro nano pico femto atto zepto yocto kilometer centimeter millimeter micrometer nanometer millisecond microsecond nanosecond gram milligram kilowatt megawatt gigawatt kilojoule megajoule milliampere microampere kilohertz megahertz gigahertz kilovolt millivolt kiloohm megaohm)) (answer "(define (dim->string d) (let ((names '(\"m\" \"s\" \"kg\" \"A\" \"K\" \"mol\" \"cd\")) (exps d)) (let loop ((i 0) (parts '())) (if (= i 7) (if (null? parts) \"1\" (string-join (reverse parts) \".\")) (let ((exp (list-ref exps i)) (name (list-ref names i))) (loop (+ i 1) (cond ((= exp 0) parts) ((= exp 1) (cons name parts)) (else (cons (string-append name \"^\" (number->string exp)) parts)))))))))"))
(task-entry (id "diffgeo/charts/*jacobian-epsilon*") (skill diffgeo) (module charts) (tier 1) (difficulty 10712) (name *jacobian-epsilon*) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp)) (available (chart? chart-name chart-dim chart-domain-pred chart-coord-map chart-inverse-map make-chart chart-contains? chart-apply chart-apply-inverse make-transition transition-apply)) (answer "(define *jacobian-epsilon* 1e-7)"))
(task-entry (id "diffgeo/tangent/tangent-change-chart") (skill diffgeo) (module tangent) (tier 1) (difficulty 10712) (name tangent-change-chart) (type "") (description "") (notes ()) (section tangent-vector-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts)) (available (tangent-vector? tangent-vector-point tangent-vector-chart tangent-vector-components tangent-vector-dim make-tangent-vector tangent-zero tangent-basis-vector tangent-add tangent-sub tangent-scale tangent-negate)) (answer "(define (tangent-change-chart tv new-chart) (let* ((point (tangent-vector-point tv)) (old-chart (tangent-vector-chart tv)) (old-components (tangent-vector-components tv))) (cond ((not (chart-contains? new-chart point)) (quasiquote (error point-not-in-target-chart (unquote (chart-name new-chart))))) ((eq? (chart-name old-chart) (chart-name new-chart)) tv) (else (let* ((old-coords (chart-apply old-chart point)) (J (transition-jacobian old-chart new-chart old-coords)) (new-components (matrix-vec-mul J old-components))) (make-tangent-vector point new-chart new-components))))))"))
(task-entry (id "diffgeo/lie-groups/so2-inverse") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10712) (name so2-inverse) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose)) (answer "(define (so2-inverse g) (list 'so2 (matrix-transpose (so2-matrix g))))"))
(task-entry (id "diffgeo/curvature/metric-inverse") (skill diffgeo) (module curvature) (tier 1) (difficulty 10712) (name metric-inverse) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric)) (answer "(define (metric-inverse m coords) (matrix-inverse (metric-at m coords)))"))
