(task-entry (id "algebra/multivariate/mpoly->string") (skill algebra) (module multivariate) (tier 0) (difficulty 359) (name mpoly->string) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms assoc-mono update-assoc-mono mpoly-zero mpoly-one mpoly-constant mpoly-var mpoly-from-terms mpoly-zero? mpoly-degree mpoly-degree-in mpoly-leading-term mpoly-leading-coeff mpoly-leading-mono mpoly-add mpoly-neg mpoly-sub mpoly-scale mpoly-mul-term mpoly-mul mpoly-power mpoly-equal? mpoly-divmod mpoly-div-loop list-set mpoly-eval mpoly-eval-term expt-int)) (answer "(define (mpoly->string p) (let* ((F (mpoly-field p)) (terms (mpoly-terms p)) (zero (field-zero F)) (eq-fn (field-equal-fn F))) (if (and (= (length terms) 1) (null? (cdar terms)) (eq-fn (caar terms) zero)) \"0\" (let loop ((ts terms) (first? #t) (result \"\")) (if (null? ts) result (let ((str (mpoly-term->string (car ts) first? F))) (loop (cdr ts) (and first? (string=? str \"\")) (string-append result str))))))))"))
(task-entry (id "algebra/poly-bridge/sig-poly-mul") (skill algebra) (module poly-bridge) (tier 0) (difficulty 359) (name sig-poly-mul) (type "") (description "") (notes ()) (section compatibility-aliases) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul alg-poly-scale alg-poly-divmod alg-poly-div alg-poly-mod alg-poly-gcd alg-poly-extended-gcd alg-poly-derivative alg-poly-eval alg-poly-monic alg-poly->string alg-make-polynomial Q-field numeric->algebra numeric->algebra-with-field algebra->numeric alg-make alg-coeffs alg-degree alg-field alg-zero? alg-leading alg-add alg-sub alg-mul alg-scale alg-divmod alg-div alg-mod alg-gcd alg-extended-gcd alg-derivative alg-eval alg-monic bridge-gcd bridge-divmod bridge-simplify bridge-coprime? alg->string numeric->string alg-poly-from-roots make-numeric-from-roots make-numeric-from-ascending make-algebra-from-descending sig-make-polynomial sig-poly-field sig-poly-coeffs sig-poly-degree sig-poly-zero? sig-poly-leading sig-poly-add sig-poly-sub)) (answer "(define sig-poly-mul alg-mul)"))
(task-entry (id "algebra/multivariate/mpoly-term->string") (skill algebra) (module multivariate) (tier 0) (difficulty 360) (name mpoly-term->string) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms assoc-mono update-assoc-mono mpoly-zero mpoly-one mpoly-constant mpoly-var mpoly-from-terms mpoly-zero? mpoly-degree mpoly-degree-in mpoly-leading-term mpoly-leading-coeff mpoly-leading-mono mpoly-add mpoly-neg mpoly-sub mpoly-scale mpoly-mul-term mpoly-mul mpoly-power mpoly-equal? mpoly-divmod mpoly-div-loop list-set mpoly-eval mpoly-eval-term expt-int mpoly->string)) (answer "(define (mpoly-term->string term first? F) (let* ((coeff (car term)) (mono (cdr term)) (zero (field-zero F)) (one (field-one F)) (eq-fn (field-equal-fn F)) (mono-str (mono->string mono))) (cond ((eq-fn coeff zero) \"\") ((string=? mono-str \"1\") (if first? (coeff->display-string coeff) (if (and (number? coeff) (< coeff 0)) (string-append \" - \" (coeff->display-string (- coeff))) (string-append \" + \" (coeff->display-string coeff))))) ((eq-fn coeff one) (if first? mono-str (string-append \" + \" mono-str))) ((and (number? coeff) (= coeff -1)) (if first? (string-append \"-\" mono-str) (string-append \" - \" mono-str))) (else (if first? (string-append (coeff->display-string coeff) \"*\" mono-str) (if (and (number? coeff) (< coeff 0)) (string-append \" - \" (coeff->display-string (- coeff)) \"*\" mono-str) (string-append \" + \" (coeff->display-string coeff) \"*\" mono-str)))))))"))
