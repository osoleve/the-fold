(task-entry (id "numeric/digital-filters/bilinear-transform") (skill numeric) (module digital-filters) (tier 0) (difficulty 2527) (name bilinear-transform) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window bessel-i0 sinc fir-lowpass fir-highpass fir-bandpass fir-bandstop fir-filter make-iir-filter iir-filter? iir-filter-b iir-filter-a iir-filter-signal make-biquad biquad? biquad-b0 biquad-b1 biquad-b2 biquad-a1 biquad-a2 biquad-filter cascade-biquads butterworth-lowpass-poles)) (answer "(define (bilinear-transform s fc) (let* ((t (/ 1.0 fc)) (st (complex-scale t s))) (complex-div (complex-add (make-complex 1 0) (complex-scale 0.5 st)) (complex-sub (make-complex 1 0) (complex-scale 0.5 st)))))"))
