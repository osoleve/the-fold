(task-entry (id "geometry/marching-cubes/marching-cubes-grid") (skill geometry) (module marching-cubes) (tier 1) (difficulty 12202) (name marching-cubes-grid) (type "(-> SDF-Function AABB Number (List Triangle3))") (description "Extract triangle mesh from SDF using marching cubes") (notes ()) (section grid-and-cube-utilities) (deps (\x27;prelude \x27;geometry)) (available (edge-table tri-table)) (answer "(define (marching-cubes-grid sdf-fn bounds resolution) (let* ((bmin (aabb-min bounds)) (bmax (aabb-max bounds)) (xmin (vec3-x bmin)) (ymin (vec3-y bmin)) (zmin (vec3-z bmin)) (xmax (vec3-x bmax)) (ymax (vec3-y bmax)) (zmax (vec3-z bmax)) (dx (/ (- xmax xmin) resolution)) (dy (/ (- ymax ymin) resolution)) (dz (/ (- zmax zmin) resolution)) (triangles '())) (do ((ix 0 (+ ix 1))) ((>= ix resolution) triangles) (do ((iy 0 (+ iy 1))) ((>= iy resolution)) (do ((iz 0 (+ iz 1))) ((>= iz resolution)) (let* ((x0 (+ xmin (* ix dx))) (y0 (+ ymin (* iy dy))) (z0 (+ zmin (* iz dz))) (x1 (+ x0 dx)) (y1 (+ y0 dy)) (z1 (+ z0 dz)) (corners (list (vec3 x0 y0 z0) (vec3 x1 y0 z0) (vec3 x1 y0 z1) (vec3 x0 y0 z1) (vec3 x0 y1 z0) (vec3 x1 y1 z0) (vec3 x1 y1 z1) (vec3 x0 y1 z1))) (values (map sdf-fn corners)) (cube-tris (marching-cubes-cube corners values))) (set! triangles (append triangles cube-tris))))))))"))
