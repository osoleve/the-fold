(task-entry (id "physics/classical3d/collision-detection3d/closest-point-on-box3d") (skill physics/classical3d) (module collision-detection3d) (tier 2) (difficulty 22405) (name closest-point-on-box3d) (type "") (description "") (notes ()) (section point-in-shape-tests) (deps (\x27;prelude \x27;vec3 \x27;shapes3d)) (available (point-in-aabb3d? point-in-sphere3d? point-in-box3d? closest-point-on-segment-3d closest-point-on-aabb3d)) (answer "(define (closest-point-on-box3d point box) (let* ((center (box3d-center box)) (half (box3d-half-extents box)) (local (vec3-sub point center)) (clamped-x (max (- (vec3-x half)) (min (vec3-x local) (vec3-x half)))) (clamped-y (max (- (vec3-y half)) (min (vec3-y local) (vec3-y half)))) (clamped-z (max (- (vec3-z half)) (min (vec3-z local) (vec3-z half))))) (vec3-add center (vec3 clamped-x clamped-y clamped-z))))"))
