(task-entry (id "tiles/render/render-hex-board") (skill tiles) (module render) (tier 1) (difficulty 12303) (name render-hex-board) (type "(-> Board MetaData (-> Tile String) String)") (description "Render hexagonal board as ASCII art. Simplified rendering with single character per hex.") (notes ()) (section hex-rendering) (deps (\x27;tiles/core)) (available (default-tile-char render-square-board render-square-board-with-overlay)) (answer "(define (render-hex-board board meta style-fn) (let* ((radius (cdr (assq 'radius meta))) (coords (board-tiles board)) (min-q (apply min (map (lambda (entry) (let ((c (car entry))) (car c))) coords))) (max-q (apply max (map (lambda (entry) (let ((c (car entry))) (car c))) coords))) (min-r (apply min (map (lambda (entry) (let ((c (car entry))) (cdr c))) coords))) (max-r (apply max (map (lambda (entry) (let ((c (car entry))) (cdr c))) coords)))) (let loop-r ((r min-r) (lines '())) (if (> r max-r) (apply string-append (reverse lines)) (let* ((offset (if (even? r) \"\" \" \")) (row-chars (list offset))) (let loop-q ((q min-q) (chars row-chars)) (if (> q max-q) (loop-r (+ r 1) (cons (apply string-append (reverse (cons \"\n\" chars))) lines)) (let* ((coord (cons q r)) (tile (board-get board coord)) (char (if tile (string-append (style-fn tile) \" \") \"  \"))) (loop-q (+ q 1) (cons char chars))))))))))"))
