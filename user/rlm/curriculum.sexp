(task-entry (id "game-theory/mechanism/is-budget-balanced?") (skill game-theory) (module mechanism) (tier 1) (difficulty 13242) (name is-budget-balanced?) (type "(-> (Vector Number) Number Boolean)") (description "Check if payments sum to zero (within tolerance)") (notes ()) (section budget-balance) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations vcg-enumerate-helper pivot-mechanism myerson-virtual-value optimal-reserve-uniform k-double-auction double-auction-trades double-auction-volume double-auction-buyer-surplus double-auction-seller-surplus double-auction-total-surplus dutch-auction make-direct-mechanism check-ex-post-ir)) (answer "(define (is-budget-balanced? payments tolerance) (let ((total (let loop ((i 0) (sum 0)) (if (>= i (vector-length payments)) sum (loop (+ i 1) (+ sum (vector-ref payments i))))))) (< (abs total) tolerance)))"))
(task-entry (id "game-theory/extensive-form/tree->string") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13243) (name tree->string) (type "(-> Node Nat String)") (description "") (notes ()) (section display) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game make-centipede-game centipede-4 entry-deterrence stackelberg-simple signaling-simple make-info-set info-set? info-set-player info-set-label info-set-nodes add-info-set perfect-information?)) (answer "(define (tree->string node depth) (let ((indent (make-string (* 2 depth) #\\ ))) (cond ((terminal? node) (format \"~aTerminal: ~a\n\" indent (terminal-payoffs node))) ((decision? node) (string-append (format \"~aP~a chooses:\n\" indent (decision-player node)) (apply string-append (map (lambda (a c) (string-append (format \"~a  ~a ->\n\" indent a) (tree->string c (+ depth 2)))) (decision-actions node) (decision-children node))))) ((chance? node) (string-append (format \"~aNature:\n\" indent) (apply string-append (map (lambda (o p c) (string-append (format \"~a  ~a (~a) ->\n\" indent o p) (tree->string c (+ depth 2)))) (chance-outcomes node) (chance-probs node) (chance-children node))))) (else \"Unknown node\n\"))))"))
(task-entry (id "game-theory/coop-games/coop-game-superadditive?") (skill game-theory) (module coop-games) (tier 1) (difficulty 13243) (name coop-game-superadditive?) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky make-additive-game make-unanimity-game make-weighted-voting-game make-airport-game make-bankruptcy-game make-gloves-game)) (answer "(define (coop-game-superadditive? g fuel) (let* ((n (coop-game-players g)) (grand (coop-game-grand-coalition g)) (is-cost (coop-game-cost? g))) (let outer ((S 0) (fuel fuel)) (if (or (> S grand) (<= fuel 0)) #t (let inner ((T 0) (fuel fuel)) (if (or (> T grand) (<= fuel 0)) (outer (+ S 1) fuel) (if (= 0 (coalition-intersection S T)) (let ((union-val (coop-game-value g (coalition-union S T))) (sum-val (+ (coop-game-value g S) (coop-game-value g T)))) (if (if is-cost (<= union-val sum-val) (>= union-val sum-val)) (inner (+ T 1) (- fuel 1)) #f)) (inner (+ T 1) fuel))))))))"))
(task-entry (id "game-theory/matching/check-bottleneck-feasibility") (skill game-theory) (module matching) (tier 1) (difficulty 13243) (name check-bottleneck-feasibility) (type "") (description "") (notes ()) (section weighted-matching-ilp) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank stable-match-receiver-optimal same-matched-agents? symbol<? weighted-matching-ilp extract-ilp-matches bottleneck-matching-ilp collect-edge-weights sort-numbers remove-duplicates-numbers binary-search-bottleneck)) (answer "(define (check-bottleneck-feasibility n m weight threshold required-size) (let* ((num-vars (* n m)) (num-constraints (+ n m)) (num-slacks num-constraints) (total-vars (+ num-vars num-slacks)) (c (make-vector total-vars 0)) (A (make-matrix num-constraints total-vars 0)) (b (make-vector num-constraints 1))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j m)) (let ((var-idx (+ (* i m) j)) (w (weight i j))) (when (<= w threshold) (vector-set! c var-idx -1))))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j m)) (matrix-set! A i (+ (* i m) j) 1)) (matrix-set! A i (+ num-vars i) 1)) (do ((j 0 (+ j 1))) ((= j m)) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! A (+ n j) (+ (* i m) j) 1)) (matrix-set! A (+ n j) (+ num-vars n j) 1)) (let* ((ilp (make-ilp c A b (iota num-vars))) (result (ilp-solve ilp))) (if (ilp-optimal? result) (let* ((x (ilp-result-x result)) (matches (extract-ilp-matches x n m)) (match-count (length matches))) (if (>= match-count required-size) (cons matches threshold) #f)) #f))))"))
(task-entry (id "game-theory/voting/permutations") (skill game-theory) (module voting) (tier 1) (difficulty 13243) (name permutations) (type "") (description "") (notes ()) (section manipulation-detection) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score minimax-winner minimax-ranking smith-set any? build-margin-matrix schulze-strengths schulze-winner schulze-ranking manipulation-possible? list-set)) (answer "(define (permutations lst) (if (null? lst) '(()) (append-map (lambda (x) (map (lambda (p) (cons x p)) (permutations (remove x lst)))) lst)))"))
