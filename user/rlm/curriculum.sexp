(task-entry (id "game-theory/mechanism/check-ex-post-ir") (skill game-theory) (module mechanism) (tier 1) (difficulty 13241) (name check-ex-post-ir) (type "(-> (-> (Vector Number) AuctionOutcome) (Vector Number) Boolean)") (description "Check if all bidders have non-negative utility (ex-post IR)") (notes ()) (section individual-rationality) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations vcg-enumerate-helper pivot-mechanism myerson-virtual-value optimal-reserve-uniform k-double-auction double-auction-trades double-auction-volume double-auction-buyer-surplus double-auction-seller-surplus double-auction-total-surplus dutch-auction make-direct-mechanism)) (answer "(define (check-ex-post-ir auction valuations) (let* ((outcome (auction valuations)) (n (vector-length valuations))) (let loop ((i 0)) (if (>= i n) #t (let ((utility (bidder-utility outcome i (vector-ref valuations i)))) (if (>= utility 0) (loop (+ i 1)) #f))))))"))
(task-entry (id "game-theory/extensive-form/perfect-information?") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13242) (name perfect-information?) (type "(-> ExtensiveGame Bool)") (description "Check if game has perfect information (no non-trivial info sets)") (notes ()) (section information-sets) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game make-centipede-game centipede-4 entry-deterrence stackelberg-simple signaling-simple make-info-set info-set? info-set-player info-set-label info-set-nodes add-info-set)) (answer "(define (perfect-information? game) (null? (game-info-sets game)))"))
(task-entry (id "game-theory/coop-games/make-gloves-game") (skill game-theory) (module coop-games) (tier 1) (difficulty 13242) (name make-gloves-game) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky make-additive-game make-unanimity-game make-weighted-voting-game make-airport-game make-bankruptcy-game)) (answer "(define (make-gloves-game L R) (let ((n (+ L R))) (make-coop-game n (lambda (S) (let ((left-count (let loop ((i 0) (count 0)) (if (>= i L) count (loop (+ i 1) (if (coalition-member? i S) (+ count 1) count))))) (right-count (let loop ((i L) (count 0)) (if (>= i n) count (loop (+ i 1) (if (coalition-member? i S) (+ count 1) count)))))) (min left-count right-count))))))"))
(task-entry (id "game-theory/matching/binary-search-bottleneck") (skill game-theory) (module matching) (tier 1) (difficulty 13242) (name binary-search-bottleneck) (type "") (description "") (notes ()) (section weighted-matching-ilp) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank stable-match-receiver-optimal same-matched-agents? symbol<? weighted-matching-ilp extract-ilp-matches bottleneck-matching-ilp collect-edge-weights sort-numbers remove-duplicates-numbers)) (answer "(define (binary-search-bottleneck n m weight sorted-weights required-size) (let* ((unique-weights (remove-duplicates-numbers sorted-weights)) (num-thresholds (length unique-weights)) (weight-vec (list->vector unique-weights))) (if (= num-thresholds 0) #f (let loop ((lo 0) (hi (- num-thresholds 1)) (best-result #f)) (if (> lo hi) best-result (let* ((mid (quotient (+ lo hi) 2)) (threshold (vector-ref weight-vec mid)) (feasible-result (check-bottleneck-feasibility n m weight threshold required-size))) (if feasible-result (loop lo (- mid 1) feasible-result) (loop (+ mid 1) hi best-result))))))))"))
