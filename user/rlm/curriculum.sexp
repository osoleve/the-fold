(task-entry (id "topology/homology/z2-matrix-print") (skill topology) (module homology) (tier 1) (difficulty 11831) (name z2-matrix-print) (type "(-> Z2Matrix Void)") (description "Print a Z_2 matrix for debugging") (notes ()) (section debugging-visualization) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti sc-betti-numbers sc-homology-summary make-sphere make-torus make-klein-bottle make-projective-plane sc-connected-components list-index)) (answer "(define (z2-matrix-print m) (let ((rows (z2-matrix-rows m)) (cols (z2-matrix-cols m))) (printf \"~ax~a Z_2 matrix:~n\" rows cols) (do ((i 0 (+ i 1))) ((= i rows)) (printf \"  [\") (do ((j 0 (+ j 1))) ((= j cols)) (printf \" ~a\" (z2-matrix-ref m i j))) (printf \" ]~n\"))))"))
