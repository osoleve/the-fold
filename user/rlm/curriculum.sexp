(task-entry (id "random/variational-inference/vi-fit") (skill random) (module variational-inference) (tier 1) (difficulty 12951) (name vi-fit) (type "") (description "") (notes ()) (section variational-inference-main-loop) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf vi-step-mf make-adam-state adam-state? adam-state-m adam-state-v adam-state-t adam-update vi-step-adam vi-step-adam-traced)) (answer "(define vi-fit (case-lambda ((log-joint initial-vfamily num-iters learning-rate) (vi-fit log-joint initial-vfamily num-iters learning-rate 42 10 100)) ((log-joint initial-vfamily num-iters learning-rate seed) (vi-fit log-joint initial-vfamily num-iters learning-rate seed 10 100)) ((log-joint initial-vfamily num-iters learning-rate seed elbo-samples) (vi-fit log-joint initial-vfamily num-iters learning-rate seed elbo-samples 100)) ((log-joint initial-vfamily num-iters learning-rate seed elbo-samples track-every) (let* ((prng (make-pcg seed 1)) (d (vfamily-dim initial-vfamily)) (adam (make-adam-state (* 2 d)))) (let loop ((iter 0) (vfamily initial-vfamily) (rng prng) (adam-state adam) (elbo-history '())) (if (>= iter num-iters) (list 'vi-result vfamily (reverse elbo-history) iter) (let*-values (((new-vfamily new-rng new-adam) (vi-step-adam log-joint vfamily rng adam-state learning-rate))) (let-values (((elbo final-rng) (if (= 0 (modulo iter track-every)) (elbo-estimate log-joint new-vfamily new-rng elbo-samples) (values #f new-rng)))) (loop (+ iter 1) new-vfamily final-rng new-adam (if elbo (cons (cons iter elbo) elbo-history) elbo-history))))))))))"))
(task-entry (id "random/distributions/random-dirichlet") (skill random) (module distributions) (tier 1) (difficulty 12952) (name random-dirichlet) (type "(-> (List Number) (State RNG (List Number)))") (description "State monad sampler for Dirichlet distribution") (notes ()) (section multivariate-distributions) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli bernoulli-pmf random-bernoulli geometric geometric-pmf geometric-cdf geometric-quantile random-geometric poisson poisson-pmf poisson-cdf random-poisson binomial binomial-pmf random-binomial gamma random-gamma beta random-beta categorical random-categorical random-normal-vector)) (answer "(define (random-dirichlet alphas) (if (null? alphas) (error 'random-dirichlet \"empty alpha list\") (if (not (andmap positive? alphas)) (error 'random-dirichlet \"all alphas must be positive\" alphas) (state-bind (state-sequence (map (lambda (a) (random-gamma a 1)) alphas)) (lambda (gammas) (let ((total (fold-left + 0 gammas))) (state-pure (map (lambda (g) (/ g total)) gammas))))))))"))
