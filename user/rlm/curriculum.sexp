(task-entry (id "dataset/sexp/sexp-length") (skill dataset) (module sexp) (tier 1) (difficulty 13408) (name sexp-length) (type "") (description "") (notes ()) (section pretty) (deps (core/base/prelude.ss lattice/dataset/sample.ss lattice/data/sort.ss)) (available (sample->canonical-sexp sort-alist canonical-sexp->sample dataset->sexp sexp->dataset sexp->string sexp->pretty-string pp-sexp)) (answer "(define (sexp-length sexp) (cond ((null? sexp) 2) ((not (pair? sexp)) (cond ((string? sexp) (+ 2 (string-length sexp))) ((symbol? sexp) (string-length (symbol->string sexp))) ((number? sexp) (string-length (number->string sexp))) (else 10))) (else (+ 2 (apply + (map sexp-length sexp))))))"))
(task-entry (id "dataset/jsonl/value->json") (skill dataset) (module jsonl) (tier 1) (difficulty 13408) (name value->json) (type "") (description "") (notes ()) (section conversion) (deps (core/base/prelude.ss lattice/optics/optics.ss lattice/dataset/sample.ss)) (available (make-json-object json-object? json-object-pairs make-json-array json-array? json-array-items sample->json json->sample)) (answer "(define (value->json v) (cond ((list? v) (make-json-array (map value->json v))) ((pair? v) (make-json-object (list (cons (symbol->string (car v)) (value->json (cdr v)))))) (else v)))"))
