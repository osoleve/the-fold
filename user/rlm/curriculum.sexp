(task-entry (id "physics-problems/physics-problem/generate-problem-options") (skill physics-problems) (module physics-problem) (tier 2) (difficulty 23611) (name generate-problem-options) (type "") (description "") (notes ()) (section options) (deps (\x27;prelude \x27;vec2 \x27;sample \x27;parameter \x27;presentation \x27;distractor \x27;difficulty \x27;simulation)) (available (make-physics-problem physics-problem? problem-name problem-category problem-params problem-world-setup problem-question-gen problem-answer-compute problem-difficulty generate-problem-instance generate-problem-id)) (answer "(define (generate-problem-options correct-answer category rng) (cond ((number? correct-answer) (let* ((strategies (category-distractor-strategies category)) (result (make-numeric-options correct-answer strategies rng format-numeric-option))) (car result))) ((symbol? correct-answer) (let* ((all-choices (category-comparison-choices category)) (result (make-symbolic-options correct-answer all-choices rng))) (car result))) (else (let* ((texts (list (format-answer correct-answer) \"Not enough information\" \"Cannot determine\" \"None of the above\")) (shuffled (shuffle-list texts rng)) (labels '(A B C D))) (map cons labels shuffled)))))"))
(task-entry (id "physics-problems/simulation/make-box") (skill physics-problems) (module simulation) (tier 2) (difficulty 23611) (name make-box) (type "") (description "") (notes ()) (section entity-helpers) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static)) (answer "(define (make-box id pos width height mass vel) (let* ((hw (/ width 2)) (hh (/ height 2)) (body (make-body-2d pos vel mass)) (shape (make-aabb (vec2 (- hw) (- hh)) (vec2 hw hh))) (material (make-material 0.6 0.4 0.3))) (make-entity id body shape material '())))"))
(task-entry (id "physics-problems/spatial/count-setup") (skill physics-problems) (module spatial) (tier 2) (difficulty 23611) (name count-setup) (type "") (description "") (notes ()) (section counting) (deps (\x27;physics-problem)) (available (size-comparison-params size-comparison-setup size-comparison-question size-comparison-answer size-comparison-problem distance-params distance-setup distance-question distance-answer distance-problem count-params)) (answer "(define (count-setup params) (let* ((n (cdr (assq 'n params))) (spread (cdr (assq 'spread params))) (entities (make-count-entities n spread))) (setup-no-gravity-world entities)))"))
(task-entry (id "physics-problems/physics-problem/find-correct-label") (skill physics-problems) (module physics-problem) (tier 2) (difficulty 23612) (name find-correct-label) (type "") (description "") (notes ()) (section options) (deps (\x27;prelude \x27;vec2 \x27;sample \x27;parameter \x27;presentation \x27;distractor \x27;difficulty \x27;simulation)) (available (make-physics-problem physics-problem? problem-name problem-category problem-params problem-world-setup problem-question-gen problem-answer-compute problem-difficulty generate-problem-instance generate-problem-id generate-problem-options)) (answer "(define (find-correct-label options correct-answer) (let ((formatted (format-answer correct-answer))) (let loop ((opts options)) (if (null? opts) 'A (if (string-contains-approx? (cdar opts) formatted) (caar opts) (loop (cdr opts)))))))"))
(task-entry (id "physics-problems/simulation/make-ground") (skill physics-problems) (module simulation) (tier 2) (difficulty 23612) (name make-ground) (type "") (description "") (notes ()) (section entity-helpers) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static make-box)) (answer "(define (make-ground y width) (let ((body (make-static-body (vec2 0 y))) (shape (make-aabb (vec2 (- width) -1) (vec2 width 0))) (material (make-material 0.5 0.5 0.3))) (make-entity 'ground body shape material '())))"))
(task-entry (id "physics-problems/spatial/make-count-entities") (skill physics-problems) (module spatial) (tier 2) (difficulty 23612) (name make-count-entities) (type "") (description "") (notes ()) (section counting) (deps (\x27;physics-problem)) (available (size-comparison-params size-comparison-setup size-comparison-question size-comparison-answer size-comparison-problem distance-params distance-setup distance-question distance-answer distance-problem count-params count-setup)) (answer "(define (make-count-entities n spread) (let loop ((i 0) (entities '())) (if (>= i n) entities (let* ((row (quotient i 3)) (col (modulo i 3)) (x (+ -10 (* col spread))) (y (+ 5 (* row spread))) (id (string->symbol (string-append \"ball-\" (number->string i))))) (loop (+ i 1) (cons (make-ball id (vec2 x y) 1.5 1.0 (vec2 0 0)) entities))))))"))
(task-entry (id "physics-problems/physics-problem/string-contains-approx?") (skill physics-problems) (module physics-problem) (tier 2) (difficulty 23613) (name string-contains-approx?) (type "") (description "") (notes ()) (section options) (deps (\x27;prelude \x27;vec2 \x27;sample \x27;parameter \x27;presentation \x27;distractor \x27;difficulty \x27;simulation)) (available (make-physics-problem physics-problem? problem-name problem-category problem-params problem-world-setup problem-question-gen problem-answer-compute problem-difficulty generate-problem-instance generate-problem-id generate-problem-options find-correct-label)) (answer "(define (string-contains-approx? haystack needle) (or (string=? haystack needle) (and (> (string-length haystack) 0) (> (string-length needle) 0) (let ((hay-num (string->number haystack)) (need-num (string->number needle))) (and hay-num need-num (< (abs (- hay-num need-num)) (* 0.01 (max (abs hay-num) 1))))))))"))
(task-entry (id "physics-problems/simulation/setup-problem-world") (skill physics-problems) (module simulation) (tier 2) (difficulty 23613) (name setup-problem-world) (type "") (description "") (notes ()) (section world-setup) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static make-box make-ground)) (answer "(define (setup-problem-world entities gravity) (let ((world (make-world gravity))) (for-each (lambda (e) (world-add-entity! world e)) entities) world))"))
