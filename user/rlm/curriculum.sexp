(task-entry (id "algebra/polynomial/poly-normalize-coeffs") (skill algebra) (module polynomial) (tier 0) (difficulty 307) (name poly-normalize-coeffs) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at)) (answer "(define (poly-normalize-coeffs field coeffs) (let ((zero (field-zero field)) (eq-fn (field-equal-fn field))) (let loop ((cs (reverse coeffs))) (cond ((null? cs) (list zero)) ((eq-fn (car cs) zero) (loop (cdr cs))) (else (reverse cs))))))"))
