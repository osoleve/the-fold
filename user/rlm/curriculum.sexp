(task-entry (id "fp/simplify/simplify-pow") (skill fp) (module simplify) (tier 1) (difficulty 10618) (name simplify-pow) (type "(-> Expr Expr Expr)") (description "Simplify power expression") (notes ()) (section power-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove)) (answer "(define (simplify-pow base exp) (cond ((and (num? exp) (= (num-val exp) 0)) (num 1)) ((and (num? exp) (= (num-val exp) 1)) base) ((and (num? base) (= (num-val base) 0) (num? exp) (> (num-val exp) 0)) (num 0)) ((and (num? base) (= (num-val base) 1)) (num 1)) ((and (num? base) (num? exp) (integer? (num-val exp)) (<= (abs (num-val exp)) 10)) (num (expt (num-val base) (num-val exp)))) ((power? base) (power (pow-base base) (simplify (product (pow-exp base) exp)))) ((and (product? base) (num? exp)) (make-product-from-list (map (lambda (f) (simplify-pow f exp)) (product-factors base)))) (else (power base exp))))"))
