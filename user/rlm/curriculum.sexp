(task-entry (id "algebra/groebner/buchberger-loop") (skill algebra) (module groebner) (tier 0) (difficulty 304) (name buchberger-loop) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger)) (answer "(define (buchberger-loop G pairs Fld vars ordering) (if (null? pairs) G (let* ((pair (car pairs)) (i (car pair)) (j (cdr pair)) (fi (list-ref G i)) (fj (list-ref G j))) (if (buchberger-criterion-1? fi fj) (buchberger-loop G (cdr pairs) Fld vars ordering) (let* ((s (s-polynomial fi fj)) (r (reduce-poly s G))) (if (mpoly-zero? r) (buchberger-loop G (cdr pairs) Fld vars ordering) (let* ((new-idx (length G)) (new-G (append G (list r))) (new-pairs (append (cdr pairs) (map (lambda (k) (cons k new-idx)) (range 0 new-idx))))) (buchberger-loop new-G new-pairs Fld vars ordering))))))))"))
