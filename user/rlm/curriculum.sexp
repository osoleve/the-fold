(task-entry (id "info/rate-distortion/in-region?") (skill info) (module rate-distortion) (tier 1) (difficulty 11128) (name in-region?) (type "") (description "") (notes ()) (section lloyd-max-quantization) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr snr-db psnr mean variance gaussian-rate-distortion gaussian-distortion-rate binary-rate-distortion binary-distortion-rate binary-entropy-inverse binary-search-entropy uniform-quantize uniform-quantize-list uniform-quantization-distortion quantization-bits lloyd-max-quantizer uniform-init-levels lloyd-max-iterate compute-boundaries compute-centroids partition-by-boundaries)) (answer "(define (in-region? x i boundaries) (let ((lower (if (= i 0) -inf.0 (list-ref boundaries (- i 1)))) (upper (if (>= i (length boundaries)) +inf.0 (list-ref boundaries i)))) (and (>= x lower) (< x upper))))"))
(task-entry (id "info/coding/lz78-decode-helper") (skill info) (module coding) (tier 1) (difficulty 11128) (name lz78-decode-helper) (type "(-> (List (Pair Nat Symbol)) (List (Pair Nat (List Symbol))) (List Symbol) (List Symbol))") (description "") (notes ()) (section lempel-ziv-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob huffman-codes huffman-codes-helper huffman-encode huffman-decode huffman-decode-helper huffman-average-length huffman-efficiency arithmetic-encode arithmetic-encode-helper build-cumulative-probs arithmetic-decode arithmetic-decode-helper find-symbol-for-code arithmetic-code-length lz78-encode lz78-encode-helper lz78-find-longest-match prefix-match-length lz78-decode)) (answer "(define (lz78-decode-helper remaining dict acc) (if (null? remaining) (reverse acc) (let* ((entry (car remaining)) (idx (car entry)) (sym (cdr entry)) (prefix (if (= idx 0) '() (cdr (list-ref dict (- idx 1))))) (phrase (if (eq? sym 'EOF) prefix (append prefix (list sym)))) (new-dict (append dict (list (cons (length dict) phrase))))) (lz78-decode-helper (cdr remaining) new-dict (append (reverse phrase) acc)))))"))
