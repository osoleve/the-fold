(task-entry (id "algebra/ring/ring-product") (skill algebra) (module ring) (tier 0) (difficulty 317) (name ring-product) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum)) (answer "(define (ring-product r elements) (if (null? elements) (ring-one r) (let loop ((elems (cdr elements)) (acc (car elements))) (if (null? elems) acc (loop (cdr elems) (ring-mul r acc (car elems)))))))"))
