(task-entry (id "info/rate-distortion/lloyd-max-quantizer") (skill info) (module rate-distortion) (tier 1) (difficulty 11122) (name lloyd-max-quantizer) (type "(-> (List Real) Nat Nat (List Real))") (description "Train Lloyd-Max quantizer on samples") (notes ()) (section lloyd-max-quantization) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr snr-db psnr mean variance gaussian-rate-distortion gaussian-distortion-rate binary-rate-distortion binary-distortion-rate binary-entropy-inverse binary-search-entropy uniform-quantize uniform-quantize-list uniform-quantization-distortion quantization-bits)) (answer "(define (lloyd-max-quantizer samples n-levels max-iter) (if (or (null? samples) (<= n-levels 0)) '() (let* ((sorted (sort-by < samples)) (min-val (car sorted)) (max-val (car (reverse sorted))) (init-levels (uniform-init-levels min-val max-val n-levels))) (lloyd-max-iterate samples init-levels max-iter))))"))
