(task-entry (id "algebra/multivariate/mpoly-equal?") (skill algebra) (module multivariate) (tier 0) (difficulty 352) (name mpoly-equal?) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms assoc-mono update-assoc-mono mpoly-zero mpoly-one mpoly-constant mpoly-var mpoly-from-terms mpoly-zero? mpoly-degree mpoly-degree-in mpoly-leading-term mpoly-leading-coeff mpoly-leading-mono mpoly-add mpoly-neg mpoly-sub mpoly-scale mpoly-mul-term mpoly-mul mpoly-power)) (answer "(define (mpoly-equal? p1 p2) (let* ((F (mpoly-field p1)) (eq-fn (field-equal-fn F)) (t1 (mpoly-terms p1)) (t2 (mpoly-terms p2))) (and (= (length t1) (length t2)) (let loop ((l1 t1) (l2 t2)) (or (null? l1) (and (eq-fn (caar l1) (caar l2)) (mono-equal? (cdar l1) (cdar l2)) (loop (cdr l1) (cdr l2))))))))"))
