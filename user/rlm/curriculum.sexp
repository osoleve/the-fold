(task-entry (id "dsl/staging/subst-expr") (skill dsl) (module staging) (tier 1) (difficulty 11750) (name subst-expr) (type "") (description "") (notes ()) (section staging-detection) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code code? code-stage code-expr stage-quote? stage-splice? stage-run? make-stage-env stage-env? stage-env-level stage-env-bindings stage-env-fragments stage-env-incr stage-env-decr stage-env-bind stage-env-lookup stage-env-add-fragment stage-expand code-combine code-lift code-unlift code-type code-well-staged? stage-add stage-mul stage-sub stage-div stage-if stage-let stage-lambda stage-app make-csp csp? csp-name csp-value lift-csp power-staged power-specialized code->string compile-staged run-staged stage-match-clause? stage-match stage-fix code-type-syntax? code-type-stage code-type-inner infer-staged-type inline-staged beta-reduce-staged)) (answer "(define (subst-expr expr var replacement) (cond ((eq? expr var) replacement) ((and (pair? expr) (eq? (car expr) 'lambda)) (if (memq var (cadr expr)) expr (quasiquote (lambda (unquote (cadr expr)) (unquote-splicing (map (lambda (e) (subst-expr e var replacement)) (cddr expr))))))) ((and (pair? expr) (eq? (car expr) 'let)) (let* ((bindings (cadr expr)) (bound-vars (map car bindings))) (if (memq var bound-vars) expr (quasiquote (let (unquote (map (lambda (b) (list (car b) (subst-expr (cadr b) var replacement))) bindings)) (unquote-splicing (map (lambda (e) (subst-expr e var replacement)) (cddr expr)))))))) ((pair? expr) (map (lambda (e) (subst-expr e var replacement)) expr)) (else expr)))"))
