(task-entry (id "linalg/vec/vec-take") (skill linalg) (module vec) (tier 0) (difficulty 414) (name vec-take) (type "(-> (Vec a) Nat (Or (Vec a) Error))") (description "Take first n elements") (notes ()) (section vector-transformations) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append)) (answer "(define (vec-take v n) (let ((len (vector-length v))) (if (> n len) (quasiquote (error out-of-bounds (unquote n) (unquote len))) (let* ((result (make-vector n 0)) (src v)) (range-do! i 0 n (vector-set! result i (vector-ref src i))) result))))"))
