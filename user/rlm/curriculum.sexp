(task-entry (id "numeric/affine/numerical-derivative") (skill numeric) (module affine) (tier 0) (difficulty 2527) (name numerical-derivative) (type "(-> (-> Number Number) Number Number)") (description "Compute f'(x) using central difference") (notes ()) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval affine->interval affine-radius affine-neg merge-terms affine-add affine-sub affine-scale affine-add-constant affine-mul affine-sqr affine-recip affine-div affine-sqrt affine-sqrt-positive *deriv-h* *bisection-tol* *bisection-max-iter*)) (answer "(define (numerical-derivative f x) (let ((h (max *deriv-h* (* (abs x) 1e-8)))) (/ (- (f (+ x h)) (f (- x h))) (* 2 h))))"))
(task-entry (id "numeric/fem/sparse-pcg-loop") (skill numeric) (module fem) (tier 0) (difficulty 2527) (name sparse-pcg-loop) (type "") (description "") (notes ()) (section sparse-cg) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes apply-dirichlet-bc! apply-dirichlet-penalty! *fem-tolerance* *fem-max-iterations* sparse-cg sparse-cg-loop sparse-csr-diagonal vec-div-pointwise sparse-pcg)) (answer "(define (sparse-pcg-loop A b x r z p rz M iter max-iter tol n) (let ((r-norm (sqrt (vec-dot r r)))) (cond ((< r-norm tol) (list x r-norm iter)) ((>= iter max-iter) (list x r-norm iter)) (else (let* ((Ap (sparse-csr-vec-mul A p)) (pAp (vec-dot p Ap))) (if (< (abs pAp) 1e-30) (list x r-norm iter) (let* ((alpha (/ rz pAp)) (x-new (vec-add x (vec-scale alpha p))) (r-new (vec-sub r (vec-scale alpha Ap))) (z-new (vec-div-pointwise r-new M)) (rz-new (vec-dot r-new z-new)) (beta (/ rz-new rz)) (p-new (vec-add z-new (vec-scale beta p)))) (sparse-pcg-loop A b x-new r-new z-new p-new rz-new M (+ iter 1) max-iter tol n))))))))"))
(task-entry (id "numeric/pde-time/integrate-pde") (skill numeric) (module pde-time) (tier 0) (difficulty 2527) (name integrate-pde) (type "") (description "") (notes ()) (section driver) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step mol-rk4-step cfl-parabolic cfl-hyperbolic estimate-mesh-spacing adaptive-euler-step integrate-adaptive sparse-csr-identity sparse-cg-solve cg-loop make-time-stepper sparse-csr-diagonal-vec)) (answer "(define (integrate-pde stepper u0 t0 t-end dt max-steps) (let loop ((t t0) (u (vector-copy u0)) (steps 0) (results (list (cons t0 (vector-copy u0))))) (cond ((>= t t-end) (reverse results)) ((>= steps max-steps) (reverse results)) (else (let* ((dt-clamped (min dt (- t-end t))) (u-new (stepper u t dt-clamped))) (loop (+ t dt-clamped) u-new (+ steps 1) (cons (cons (+ t dt-clamped) (vector-copy u-new)) results)))))))"))
(task-entry (id "numeric/complex/complex-tan") (skill numeric) (module complex) (tier 0) (difficulty 2528) (name complex-tan) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;transcendental)) (available (make-complex complex? complex-real complex-imag real-num->complex i-value make-polar complex-magnitude complex-angle complex->polar polar->complex complex-add complex-sub complex-mul complex-div complex-negate complex-conjugate complex-reciprocal complex-equal? complex-zero? complex-real? complex-imaginary? complex-exp complex-log complex-pow complex-sqrt complex-sin complex-cos)) (answer "(define (complex-tan z) (complex-div (complex-sin z) (complex-cos z)))"))
(task-entry (id "numeric/digital-filters/butterworth-lowpass") (skill numeric) (module digital-filters) (tier 0) (difficulty 2528) (name butterworth-lowpass) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window bessel-i0 sinc fir-lowpass fir-highpass fir-bandpass fir-bandstop fir-filter make-iir-filter iir-filter? iir-filter-b iir-filter-a iir-filter-signal make-biquad biquad? biquad-b0 biquad-b1 biquad-b2 biquad-a1 biquad-a2 biquad-filter cascade-biquads butterworth-lowpass-poles bilinear-transform)) (answer "(define (butterworth-lowpass cutoff order) (let* ((wc (* (pi-value) cutoff)) (fc (tan wc)) (poles (butterworth-lowpass-poles order)) (z-poles (map (lambda (p) (bilinear-transform p fc)) poles)) (z-zeros (make-list order (make-complex -1 0)))) (poles-zeros->tf z-poles z-zeros)))"))
(task-entry (id "numeric/wavelet/wavelet-energy-ratio") (skill numeric) (module wavelet) (tier 0) (difficulty 2528) (name wavelet-energy-ratio) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (haar-scaling-filter haar-wavelet-filter daubechies-4-scaling-filter qmf-wavelet-from-scaling daubechies-4-wavelet-filter daubechies-6-scaling-filter daubechies-6-wavelet-filter reverse-filter convolve-downsample upsample-convolve dwt-step dwt idwt-step idwt get-wavelet-filters dwt-family idwt-family wavelet-decompose wavelet-reconstruct get-approximation get-details get-detail-level hard-threshold soft-threshold threshold-coefficients wavelet-denoise wavelet-energy wavelet-energy-distribution)) (answer "(define (wavelet-energy-ratio dwt-result) (let* ((energies (wavelet-energy-distribution dwt-result)) (total-energy (apply + energies))) (map (lambda (e) (/ e total-energy)) energies)))"))
(task-entry (id "numeric/signal-poly/jury-table") (skill numeric) (module signal-poly) (tier 0) (difficulty 2528) (name jury-table) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;digital-filters)) (available (Q-field-sig sig-make-polynomial sig-normalize-coeffs sig-poly-field sig-poly-coeffs sig-poly-degree sig-poly-zero? sig-poly-leading sig-poly-add sig-poly-sub sig-poly-mul list-set sig-poly-scale sig-poly-divmod sig-poly-zero-over sig-poly-one-over sig-poly-divmod-iter sig-poly-div sig-poly-mod sig-poly-gcd sig-poly-make-monic num-poly-coeffs-sig numeric->signal-poly signal->numeric-poly filter-num-poly filter-den-poly filter-coprime? filter-simplify)) (answer "(define (jury-table poly) (let* ((coeffs (sig-poly-coeffs poly)) (n (length coeffs))) (if (< n 2) (list coeffs) (jury-table-iter (list coeffs (reverse coeffs)) (- n 1)))))"))
(task-entry (id "numeric/interpolate/chebyshev-eval") (skill numeric) (module interpolate) (tier 0) (difficulty 2528) (name chebyshev-eval) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;numeric/polynomial)) (available (binary-search-segment binary-search-segment-vec lerp lerp-inverse interp-linear lagrange-basis interp-lagrange divided-differences interp-newton interp-hermite hermite-tangent-estimate thomas-algorithm cubic-spline-natural matrix-set! spline-eval interp-cubic-spline bezier-linear bezier-quadratic bezier-cubic bezier-general bezier-derivative polyfit linreg linreg-r2 chebyshev-nodes chebyshev-nodes-interval chebyshev-t chebyshev-coeffs)) (answer "(define (chebyshev-eval coeffs x) (let ((n (length coeffs))) (if (= n 0) 0 (let loop ((i (- n 1)) (b1 0) (b2 0)) (if (< i 0) (- b1 (* x b2)) (loop (- i 1) (+ (list-ref coeffs i) (* 2 x b1) (- b2)) b1))))))"))
