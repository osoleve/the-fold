(task-entry (id "sim/stability/is-stable-numerically?") (skill sim) (module stability) (tier 2) (difficulty 23329) (name is-stable-numerically?) (type "(-> Any Any Number Number Nat Bool)") (description "Test stability by numerical integration from nearby initial condition") (notes ()) (section trajectory-analysis) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d analyze-stability stable? asymptotically-stable? unstable? classify-stability-nd analyze-stability-nd eigenvalue-result->stability eigenvalues-from-qr-result analyze-linear-system estimate-basin-of-attraction)) (answer "(define (is-stable-numerically? sys equilibrium perturbation-size time-steps dt) (let* ((n (vector-length equilibrium)) (perturbation (vec-scale perturbation-size (vec-ones n))) (initial (vec-add equilibrium perturbation)) (trajectory (integrate-euler sys 0 initial dt time-steps))) (let ((final-state (car (reverse trajectory)))) (< (vec-norm (vec-sub final-state equilibrium)) (* 2 perturbation-size)))))"))
