(task-entry (id "numeric/fem/assemble-load") (skill numeric) (module fem) (tier 0) (difficulty 2516) (name assemble-load) (type "") (description "") (notes ()) (section assembly) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass)) (answer "(define (assemble-load mesh f) (let* ((n (fem-mesh-num-nodes mesh)) (ne (fem-mesh-num-elements mesh)) (F (make-vector n 0.0))) (do ((e 0 (+ e 1))) ((= e ne)) (let* ((elem (fem-mesh-element mesh e)) (pts (fem-mesh-element-nodes mesh e)) (Fe (element-load (car pts) (cadr pts) (caddr pts) f)) (i0 (vector-ref elem 0)) (i1 (vector-ref elem 1)) (i2 (vector-ref elem 2))) (vector-set! F i0 (+ (vector-ref F i0) (vector-ref Fe 0))) (vector-set! F i1 (+ (vector-ref F i1) (vector-ref Fe 1))) (vector-set! F i2 (+ (vector-ref F i2) (vector-ref Fe 2))))) F))"))
(task-entry (id "numeric/pde-time/mol-rk4-step") (skill numeric) (module pde-time) (tier 0) (difficulty 2516) (name mol-rk4-step) (type "") (description "") (notes ()) (section method-of-lines) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step)) (answer "(define (mol-rk4-step A b u t dt) (let* ((f (mol-rhs A b)) (half-dt (/ dt 2)) (k1 (f u t)) (k2 (f (pde-vec-madd u half-dt k1) (+ t half-dt))) (k3 (f (pde-vec-madd u half-dt k2) (+ t half-dt))) (k4 (f (pde-vec-madd u dt k3) (+ t dt))) (weighted (pde-vec-add k1 (pde-vec-add (pde-vec-scale 2 k2) (pde-vec-add (pde-vec-scale 2 k3) k4))))) (pde-vec-madd u (/ dt 6) weighted)))"))
