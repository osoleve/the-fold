(task-entry (id "fp/solve/extract-poly-coefficients") (skill fp) (module solve) (tier 1) (difficulty 10609) (name extract-poly-coefficients) (type "") (description "") (notes ()) (section equation-representation) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var?)) (answer "(define (extract-poly-coefficients expr var-sym) (let ((simplified (simplify expr))) (if (not (is-polynomial? simplified var-sym)) #f (let ((deg (polynomial-degree simplified var-sym))) (if (< deg 0) (list simplified) (let loop ((k 0) (coeffs '())) (if (> k deg) (reverse coeffs) (loop (+ k 1) (cons (extract-coefficient-of-degree simplified var-sym k) coeffs)))))))))"))
(task-entry (id "fp/poly-canonical/polynomial->expr") (skill fp) (module poly-canonical) (tier 1) (difficulty 10609) (name polynomial->expr) (type "") (description "") (notes ()) (section conversion) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial polynomial-expr? expr-degree extract-poly-coeffs extract-coeff-at extract-coeff-expanded extract-coeff-product expr-eval-at-zero)) (answer "(define (polynomial->expr poly var-sym) (let* ((coeffs (poly-coeffs poly)) (n (length coeffs)) (x (var var-sym))) (let loop ((k 0) (terms '())) (if (>= k n) (if (null? terms) (num 0) (make-sum-from-list (reverse terms))) (let ((c (list-ref coeffs k))) (if (= c 0) (loop (+ k 1) terms) (loop (+ k 1) (cons (make-term c k x) terms))))))))"))
