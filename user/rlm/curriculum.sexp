entity s) s) (let ((f (lambda (x) (if (number? x) (+ x 1) x))) (g (lambda (x) (if (number? x) (* x 2) x)))) (equal? (grate-over grate (compose2 g f) s) (grate-over grate g (grate-over grate f s)))))) test-ss))"))
