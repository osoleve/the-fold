(task-entry (id "algebra/galois/poly-has-root?") (skill algebra) (module galois) (tier 0) (difficulty 338) (name poly-has-root?) (type "") (description "") (notes ()) (section irreducible-polynomials) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod unique-prime-divisors poly-frobenius-power rabin-irreducible? poly-irreducible? poly-has-factor-up-to-degree?)) (answer "(define (poly-has-root? p F) (let ((elts (field-elements F))) (if (null? elts) #f (let loop ((es elts)) (and (not (null? es)) (or (field-equal? F (poly-eval p (car es)) (field-zero F)) (loop (cdr es))))))))"))
(task-entry (id "algebra/group/is-subgroup?") (skill algebra) (module group) (tier 0) (difficulty 339) (name is-subgroup?) (type "(-> Group (List Element) Boolean)") (description "Test if a subset H forms a subgroup of G") (notes ()) (section subgroup-testing) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity dihedral-op dihedral-inverse make-dihedral-group D)) (answer "(define (is-subgroup? g h-elements) (let ((op (group-op g)) (e (group-identity g)) (inv (group-inverse-fn g)) (eq? (group-equal-fn g))) (and (not (null? h-elements)) (ormap (lambda (x) (eq? x e)) h-elements) (let loop-a ((as h-elements)) (if (null? as) #t (let loop-b ((bs h-elements)) (if (null? bs) (loop-a (cdr as)) (let ((result (op (car as) (car bs)))) (if (ormap (lambda (x) (eq? x result)) h-elements) (loop-b (cdr bs)) #f)))))) (let loop ((es h-elements)) (if (null? es) #t (let ((a-inv (inv (car es)))) (if (ormap (lambda (x) (eq? x a-inv)) h-elements) (loop (cdr es)) #f)))))))"))
(task-entry (id "algebra/ring/is-valid-ideal?") (skill algebra) (module ring) (tier 0) (difficulty 339) (name is-valid-ideal?) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product is-commutative-ring? is-zero-divisor? has-zero-divisors? is-integral-domain? is-unit? ring-units make-ring-zn make-ring-z make-ring-homomorphism ring-hom? ring-hom-source ring-hom-target ring-hom-phi ring-hom-apply is-valid-ring-homomorphism? ring-hom-kernel ring-hom-image make-ideal ideal? ideal-ring ideal-elements)) (answer "(define (is-valid-ideal? ideal) (let* ((r (ideal-ring ideal)) (i-elems (ideal-elements ideal)) (r-elems (ring-elements r))) (and (let loop ((as i-elems)) (if (null? as) #t (let inner-loop ((bs i-elems)) (if (null? bs) (loop (cdr as)) (and (member-equal (ring-add r (car as) (car bs)) i-elems (ring-equal-fn r)) (inner-loop (cdr bs))))))) (let loop ((rs r-elems)) (if (null? rs) #t (let inner-loop ((is i-elems)) (if (null? is) (loop (cdr rs)) (and (member-equal (ring-mul r (car rs) (car is)) i-elems (ring-equal-fn r)) (member-equal (ring-mul r (car is) (car rs)) i-elems (ring-equal-fn r)) (inner-loop (cdr is))))))))))"))
(task-entry (id "algebra/polynomial/poly-lagrange-interpolate") (skill algebra) (module polynomial) (tier 0) (difficulty 339) (name poly-lagrange-interpolate) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm poly-eval poly-derivative poly-scalar-mul-int poly-square-free poly-square-free-factorization poly-sqf-loop)) (answer "(define (poly-lagrange-interpolate F points) (if (null? points) (poly-zero-over F) (let ((n (length points)) (xs (map car points)) (ys (map cdr points))) (poly-lagrange-sum F xs ys 0 (poly-zero-over F)))))"))
(task-entry (id "algebra/multivariate/mpoly-zero?") (skill algebra) (module multivariate) (tier 0) (difficulty 339) (name mpoly-zero?) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms assoc-mono update-assoc-mono mpoly-zero mpoly-one mpoly-constant mpoly-var mpoly-from-terms)) (answer "(define (mpoly-zero? p) (let* ((F (mpoly-field p)) (terms (mpoly-terms p)) (eq-fn (field-equal-fn F)) (zero (field-zero F))) (and (= (length terms) 1) (null? (cdar terms)) (eq-fn (caar terms) zero))))"))
(task-entry (id "algebra/poly-bridge/alg-eval") (skill algebra) (module poly-bridge) (tier 0) (difficulty 339) (name alg-eval) (type "(-> AlgebraPoly Coeff Coeff)") (description "") (notes ()) (section prefixed-algebra-operations) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul alg-poly-scale alg-poly-divmod alg-poly-div alg-poly-mod alg-poly-gcd alg-poly-extended-gcd alg-poly-derivative alg-poly-eval alg-poly-monic alg-poly->string alg-make-polynomial Q-field numeric->algebra numeric->algebra-with-field algebra->numeric alg-make alg-coeffs alg-degree alg-field alg-zero? alg-leading alg-add alg-sub alg-mul alg-scale alg-divmod alg-div alg-mod alg-gcd alg-extended-gcd alg-derivative)) (answer "(define alg-eval alg-poly-eval)"))
(task-entry (id "algebra/galois/poly-has-monic-factor-of-degree?") (skill algebra) (module galois) (tier 0) (difficulty 339) (name poly-has-monic-factor-of-degree?) (type "") (description "") (notes ()) (section irreducible-polynomials) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod unique-prime-divisors poly-frobenius-power rabin-irreducible? poly-irreducible? poly-has-factor-up-to-degree? poly-has-root?)) (answer "(define (poly-has-monic-factor-of-degree? p deg F elts) (let loop ((coeffs-list (all-coeff-combinations elts deg))) (and (not (null? coeffs-list)) (let* ((coeffs (car coeffs-list)) (monic-coeffs (append coeffs (list (field-one F)))) (divisor (make-polynomial F monic-coeffs))) (or (poly-divides? divisor p) (loop (cdr coeffs-list)))))))"))
(task-entry (id "algebra/group/generate-subgroup") (skill algebra) (module group) (tier 0) (difficulty 340) (name generate-subgroup) (type "(-> Group (List Element) (List Element))") (description "Generate the subgroup of G generated by the given elements") (notes ()) (section subgroup-testing) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity dihedral-op dihedral-inverse make-dihedral-group D is-subgroup?)) (answer "(define (generate-subgroup g generators) (let ((op (group-op g)) (e (group-identity g)) (inv (group-inverse-fn g)) (eq? (group-equal-fn g))) (let loop ((current (cons e generators))) (let* ((new-elements (append-map (lambda (a) (append (map (lambda (b) (op a b)) current) (list (inv a)))) current)) (unique (fold-left (lambda (acc x) (if (ormap (lambda (y) (eq? x y)) acc) acc (cons x acc))) current new-elements))) (if (= (length unique) (length current)) current (loop unique))))))"))
(task-entry (id "algebra/ring/make-principal-ideal") (skill algebra) (module ring) (tier 0) (difficulty 340) (name make-principal-ideal) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power ring-sum ring-product is-commutative-ring? is-zero-divisor? has-zero-divisors? is-integral-domain? is-unit? ring-units make-ring-zn make-ring-z make-ring-homomorphism ring-hom? ring-hom-source ring-hom-target ring-hom-phi ring-hom-apply is-valid-ring-homomorphism? ring-hom-kernel ring-hom-image make-ideal ideal? ideal-ring ideal-elements is-valid-ideal?)) (answer "(define (make-principal-ideal r a) (let ((elems (unique-with-equal (map (lambda (r-elem) (ring-mul r r-elem a)) (ring-elements r)) (ring-equal-fn r)))) (make-ideal r elems)))"))
(task-entry (id "algebra/polynomial/poly-lagrange-sum") (skill algebra) (module polynomial) (tier 0) (difficulty 340) (name poly-lagrange-sum) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm poly-eval poly-derivative poly-scalar-mul-int poly-square-free poly-square-free-factorization poly-sqf-loop poly-lagrange-interpolate)) (answer "(define (poly-lagrange-sum F xs ys i acc) (if (= i (length xs)) acc (let* ((xi (list-ref xs i)) (yi (list-ref ys i)) (Li (poly-lagrange-basis F xs i)) (term (poly-scale Li yi))) (poly-lagrange-sum F xs ys (+ i 1) (poly-add acc term)))))"))
