(task-entry (id "geometry/convex-hull/remove-collinear-except-furthest") (skill geometry) (module convex-hull) (tier 1) (difficulty 12207) (name remove-collinear-except-furthest) (type "") (description "") (notes ()) (section graham-scan) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle)) (answer "(define (remove-collinear-except-furthest origin sorted) (if (null? sorted) '() (let loop ((remaining (cdr sorted)) (current (car sorted)) (result '())) (if (null? remaining) (reverse (cons current result)) (let ((next (car remaining))) (if (< (abs (- (polar-angle origin current) (polar-angle origin next))) 1e-10) (if (> (point2-distance-sq origin next) (point2-distance-sq origin current)) (loop (cdr remaining) next result) (loop (cdr remaining) current result)) (loop (cdr remaining) next (cons current result))))))))"))
