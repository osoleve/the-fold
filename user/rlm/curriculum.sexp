(task-entry (id "statistics/design-matrix/one-hot-encode") (skill statistics) (module design-matrix) (tier 1) (difficulty 11208) (name one-hot-encode) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode)) (answer "(define (one-hot-encode categories) (let* ((n (length categories)) (levels (unique-values categories)) (k (length levels)) (level-index (lambda (x) (let loop ((ls levels) (i 0)) (if (null? ls) -1 (if (equal? x (car ls)) i (loop (cdr ls) (+ i 1))))))) (data (make-vector (* n k) 0))) (let loop ((xs categories) (row 0)) (if (null? xs) (list 'matrix n k data) (let ((idx (level-index (car xs)))) (vector-set! data (+ (* row k) idx) 1) (loop (cdr xs) (+ row 1)))))))"))
(task-entry (id "statistics/diagnostics/dffits") (skill statistics) (module diagnostics) (tier 1) (difficulty 11208) (name dffits) (type "(-> Vec Vec Vec)") (description "DFFITS measures the influence of observation i on its own fitted value") (notes ("DFFITS_i = t_i * sqrt(h_ii / (1 - h_ii)) where t_i is the externally studentized residual" "Points with |DFFITS_i| > 2*sqrt(p/n) are potentially influential")) (section influence-measures) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers)) (available (hat-matrix hat-matrix-diagonal residuals-raw residuals-standardized residuals-studentized residuals-studentized-external cooks-distance cooks-distance-threshold)) (answer "(define (dffits studentized-external leverage) (let* ((n (vector-length studentized-external)) (df (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) df) (let* ((ti (vector-ref studentized-external i)) (hi (vector-ref leverage i)) (denom (max (- 1 hi) 1e-10))) (vector-set! df i (* ti (sqrt (/ hi denom)))))) df))"))
(task-entry (id "statistics/linear/weight-matrix") (skill statistics) (module linear) (tier 1) (difficulty 11208) (name weight-matrix) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit linear-model-compute-diagnostics compute-coefficient-se compute-t-values compute-p-values compute-r-squared compute-adj-r-squared weighted-linear-fit)) (answer "(define (weight-matrix X weights) (let* ((m (matrix-rows X)) (n (matrix-cols X)) (data (make-vector (* m n)))) (do ((i 0 (+ i 1))) ((= i m)) (let ((w (sqrt (vector-ref weights i)))) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! data (+ (* i n) j) (* w (matrix-ref X i j)))))) (list 'matrix m n data)))"))
