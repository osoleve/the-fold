(task-entry (id "diffgeo/geodesics/rk4-geodesic-step") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10709) (name rk4-geodesic-step) (type "") (description "") (notes ()) (section geodesic-state) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative)) (answer "(define (rk4-geodesic-step metric state dt) (let* ((x0 (geodesic-state-coords state)) (v0 (geodesic-state-velocity state)) (n (vector-length x0)) (d1 (geodesic-derivative metric state)) (dx1 (car d1)) (dv1 (cdr d1)) (x2 (vec-add x0 (vec-scale (* 0.5 dt) dx1))) (v2 (vec-add v0 (vec-scale (* 0.5 dt) dv1))) (d2 (geodesic-derivative metric (make-geodesic-state x2 v2))) (dx2 (car d2)) (dv2 (cdr d2)) (x3 (vec-add x0 (vec-scale (* 0.5 dt) dx2))) (v3 (vec-add v0 (vec-scale (* 0.5 dt) dv2))) (d3 (geodesic-derivative metric (make-geodesic-state x3 v3))) (dx3 (car d3)) (dv3 (cdr d3)) (x4 (vec-add x0 (vec-scale dt dx3))) (v4 (vec-add v0 (vec-scale dt dv3))) (d4 (geodesic-derivative metric (make-geodesic-state x4 v4))) (dx4 (car d4)) (dv4 (cdr d4)) (dx-weighted (vec-scale (/ dt 6.0) (vec-add dx1 (vec-add (vec-scale 2 dx2) (vec-add (vec-scale 2 dx3) dx4))))) (dv-weighted (vec-scale (/ dt 6.0) (vec-add dv1 (vec-add (vec-scale 2 dv2) (vec-add (vec-scale 2 dv3) dv4))))) (x-new (vec-add x0 dx-weighted)) (v-new (vec-add v0 dv-weighted))) (make-geodesic-state x-new v-new)))"))
(task-entry (id "diffgeo/forms/shuffle-sign") (skill diffgeo) (module forms) (tier 1) (difficulty 10709) (name shuffle-sign) (type "") (description "") (notes ()) (section permutation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign)) (answer "(define (shuffle-sign idx1 idx2) (if (indices-overlap? idx1 idx2) #f (let* ((merged (merge-indices idx1 idx2)) (combined (append idx1 idx2)) (n (length combined))) (count-inversions-to-sort combined merged))))"))
(task-entry (id "diffgeo/symbolic-metrics/make-cylindrical-metric-exact") (skill diffgeo) (module symbolic-metrics) (tier 1) (difficulty 10709) (name make-cylindrical-metric-exact) (type "(-> Chart MetricSymbolic)") (description "Cylindrical metric with exact derivatives") (notes ()) (section metric-derivative-protocol) (deps (\x27;curvature)) (available (metric-symbolic? make-metric-symbolic metric-symbolic-deriv-fn metric-chart* metric-fn* metric-dim* metric-at* make-polar-metric-exact make-spherical-metric-exact)) (answer "(define (make-cylindrical-metric-exact chart) (let ((zero-3x3 (diagonal (vector 0 0 0)))) (make-metric-symbolic chart (lambda (coords) (let ((rho (vector-ref coords 0))) (diagonal (vector 1 (* rho rho) 1)))) (lambda (coords) (let* ((rho (vector-ref coords 0)) (dg (make-vector 3 #f))) (vector-set! dg 0 (diagonal (vector 0 (* 2 rho) 0))) (vector-set! dg 1 zero-3x3) (vector-set! dg 2 zero-3x3) dg)))))"))
