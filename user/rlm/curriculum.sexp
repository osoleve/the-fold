(task-entry (id "statistics/differencing/exp-transform") (skill statistics) (module differencing) (tier 1) (difficulty 11211) (name exp-transform) (type "") (description "") (notes ()) (section simple-differencing) (deps (\x27;prelude)) (available (vec-diff difference lag-diff seasonal-difference integrate integrate-from-last integrate-d is-stationary? vec-variance-simple subvec log-transform)) (answer "(define (exp-transform xs) (let* ((n (vector-length xs)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (exp (vector-ref xs i))))))"))
(task-entry (id "statistics/ar-poly/ma-invertible-simple?") (skill statistics) (module ar-poly) (tier 1) (difficulty 11211) (name ma-invertible-simple?) (type "") (description "") (notes ()) (section rational-field-for-exact-coefficient-arithmetic) (deps (\x27;field \x27;algebra/polynomial)) (available (Q-field-ts ar-char-poly-vec ar-char-poly ar-companion-poly ma-char-poly arma-common-factors arma-reducible? arma-reduce algebra-poly->ar-coeffs algebra-poly->ma-coeffs ar-stable-simple?)) (answer "(define (ma-invertible-simple? theta) (let ((q (vector-length theta))) (cond ((= q 0) #t) ((= q 1) (< (abs (vector-ref theta 0)) 1)) ((= q 2) (let ((theta1 (vector-ref theta 0)) (theta2 (vector-ref theta 1))) (and (> (+ theta1 theta2) -1) (> (- theta2 theta1) -1) (< (abs theta2) 1)))) (else #f))))"))
