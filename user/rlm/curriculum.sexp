(task-entry (id "optimization/interval-contract/make-bound-contractor") (skill optimization) (module interval-contract) (tier 1) (difficulty 12804) (name make-bound-contractor) (type "(-> Nat Real Real Contractor)") (description "Create contractor that constrains dimension i to [lo, hi]") (notes ()) (section basic-contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal?)) (answer "(define (make-bound-contractor dim lo hi) (lambda (box) (let* ((iv (list-ref box dim)) (new-lo (max (interval-lo iv) lo)) (new-hi (min (interval-hi iv) hi))) (if (> new-lo new-hi) 'empty (list-update box dim (interval new-lo new-hi))))))"))
