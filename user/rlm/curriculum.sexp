(task-entry (id "algebra/groebner/mpoly-make-monic") (skill algebra) (module groebner) (tier 0) (difficulty 308) (name mpoly-make-monic) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger buchberger-loop buchberger-criterion-1? all-pairs reduce-basis)) (answer "(define (mpoly-make-monic p F) (if (mpoly-zero? p) p (let* ((lc (mpoly-leading-coeff p)) (inv-lc (field-inv F lc))) (mpoly-scale p inv-lc))))"))
(task-entry (id "algebra/poly-bridge/alg-poly-scale") (skill algebra) (module poly-bridge) (tier 0) (difficulty 308) (name alg-poly-scale) (type "") (description "") (notes ()) (section none) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul)) (answer "(define alg-poly-scale poly-scale)"))
(task-entry (id "algebra/galois/gf-ext-normalize") (skill algebra) (module galois) (tier 0) (difficulty 308) (name gf-ext-normalize) (type "") (description "") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field)) (answer "(define (gf-ext-normalize coeffs n base-field) (let* ((zero (field-zero base-field)) (eq-fn (field-equal-fn base-field)) (padded (if (< (length coeffs) n) (append coeffs (make-list (- n (length coeffs)) zero)) (take n coeffs)))) (let loop ((cs (reverse padded))) (cond ((null? (cdr cs)) (reverse cs)) ((eq-fn (car cs) zero) (loop (cdr cs))) (else (reverse cs))))))"))
