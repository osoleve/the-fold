(task-entry (id "linalg/matrix/matrix-vec-mul") (skill linalg) (module matrix) (tier 0) (difficulty 422) (name matrix-vec-mul) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose matrix-map matrix-map2 matrix-fold matrix-add matrix-sub matrix-hadamard matrix-scale matrix-negate matrix-mul)) (answer "(define (matrix-vec-mul m v) (let ((rows (matrix-rows m)) (cols (matrix-cols m)) (n (vector-length v))) (if (not (= cols n)) (quasiquote (error dimension-mismatch (unquote cols) (unquote n))) (let ((data (matrix-data m)) (result (make-vector rows 0))) (do ((i 0 (+ i 1))) ((= i rows) result) (do ((j 0 (+ j 1)) (sum 0 (+ sum (* (vector-ref data (+ (* i cols) j)) (vector-ref v j))))) ((= j cols) (vector-set! result i sum))))))))"))
(task-entry (id "linalg/matrix-eigen/eigenvectors") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 422) (name eigenvectors) (type "") (description "") (notes ()) (section symmetric-eigen) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop eigen-decomposition symmetric-eigen symmetric-eigen-loop symmetric-converged? spectral-radius eigenvalue-condition eigenvalues)) (answer "(define (eigenvectors a) (let ((result (eigen-decomposition a))) (cond ((and (pair? result) (eq? (car result) 'error)) result) ((and (pair? result) (eq? (car result) 'complex-eigenvalues)) (quasiquote (error complex-eigenvalues-no-real-eigenvectors (unquote (cadr result)) (unquote (caddr result))))) (else (cdr result)))))"))
(task-entry (id "linalg/iterative-solvers/make-jacobi-preconditioner") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 422) (name make-jacobi-preconditioner) (type "") (description "") (notes ()) (section utilities) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres gmres-outer gmres-arnoldi gmres-arnoldi-loop apply-givens-rotations compute-givens gmres-solve-update vector-copy)) (answer "(define (make-jacobi-preconditioner a) (let* ((n (matrix-rows a)) (diag-inv (make-vector n 0.0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((d (matrix-ref a i i))) (vector-set! diag-inv i (if (> (abs d) *iterative-tolerance*) (/ 1.0 d) 0.0)))) (lambda (r) (let ((z (make-vector n 0.0))) (do ((i 0 (+ i 1))) ((= i n) z) (vector-set! z i (* (vector-ref r i) (vector-ref diag-inv i))))))))"))
