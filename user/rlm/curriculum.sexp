(task-entry (id "autodiff/differentiable/d-chain") (skill autodiff) (module differentiable) (tier 1) (difficulty 12712) (name d-chain) (type "") (description "") (notes ()) (section differentiable-typeclass) (deps (\x27;prelude \x27;kinds \x27;infer \x27;resolve \x27;comp-graph \x27;reverse-diff)) (available (TC-Differentiable differentiable-real-methods inst-Differentiable-Real differentiable-dual-methods inst-Differentiable-Dual differentiable-traced-methods inst-Differentiable-Traced differentiable-hyperdual-methods inst-Differentiable-Hyperdual differentiable-instances ad-instances d-pow)) (answer "(define (d-chain inst f g) (lambda (x) (f (g x))))"))
(task-entry (id "autodiff/differentiable-signal/diff-dft") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12712) (name diff-dft) (type "(-> (Vector Number) (-> (Vector Complex) Number) (Vector Number))") (description "Compute gradient of loss function w.r.t. signal through DFT") (notes ()) (section high-level-operations) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real make-dft-re-local-grads make-dft-im-local-grads)) (answer "(define (diff-dft signal loss-fn) (let* ((n (vector-length signal)) (X (dft (real->complex-vec signal))) (eps 1e-7) (grad-X (make-vector n)) (loss-0 (loss-fn X))) (do ((k 0 (+ k 1))) ((= k n)) (let* ((X-k (vector-ref X k)) (X+ (vector-copy X)) (_ (vector-set! X+ k (make-complex (+ (complex-real X-k) eps) (complex-imag X-k)))) (loss-re+ (loss-fn X+)) (grad-re (/ (- loss-re+ loss-0) eps)) (X++ (vector-copy X)) (_ (vector-set! X++ k (make-complex (complex-real X-k) (+ (complex-imag X-k) eps)))) (loss-im+ (loss-fn X++)) (grad-im (/ (- loss-im+ loss-0) eps))) (vector-set! grad-X k (make-complex grad-re grad-im)))) (dft-vjp-real grad-X)))"))
