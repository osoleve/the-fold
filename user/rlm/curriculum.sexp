(task-entry (id "topology/persistent/lex<?") (skill topology) (module persistent) (tier 1) (difficulty 11804) (name lex<?) (type "(-> (List α) (List α) Boolean)") (description "") (notes ()) (section filtration) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order)) (answer "(define (lex<? lst1 lst2) (cond ((null? lst1) (not (null? lst2))) ((null? lst2) #f) ((< (car lst1) (car lst2)) #t) ((> (car lst1) (car lst2)) #f) (else (lex<? (cdr lst1) (cdr lst2)))))"))
