(task-entry (id "numeric/pde-time/integrate-adaptive") (skill numeric) (module pde-time) (tier 0) (difficulty 2521) (name integrate-adaptive) (type "") (description "") (notes ()) (section adaptive) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step mol-rk4-step cfl-parabolic cfl-hyperbolic estimate-mesh-spacing adaptive-euler-step)) (answer "(define (integrate-adaptive f u0 t0 t-end dt0 tol safety max-steps) (let loop ((t t0) (u u0) (dt dt0) (steps 0) (results (list (cons t0 (vector-copy u0))))) (cond ((>= t t-end) (reverse results)) ((>= steps max-steps) (reverse results)) (else (let ((dt-clamped (min dt (- t-end t)))) (let-values (((u-new dt-new error) (adaptive-euler-step f u t dt-clamped tol safety))) (if (< error tol) (loop (+ t dt-clamped) u-new dt-new (+ steps 1) (cons (cons (+ t dt-clamped) (vector-copy u-new)) results)) (loop t u (/ dt 2) steps results))))))))"))
