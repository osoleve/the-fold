(task-entry (id "statistics/differencing/box-cox") (skill statistics) (module differencing) (tier 1) (difficulty 11212) (name box-cox) (type "") (description "") (notes ()) (section simple-differencing) (deps (\x27;prelude)) (available (vec-diff difference lag-diff seasonal-difference integrate integrate-from-last integrate-d is-stationary? vec-variance-simple subvec log-transform exp-transform)) (answer "(define (box-cox xs lambda) (let* ((n (vector-length xs)) (result (make-vector n))) (if (< (abs lambda) 1e-10) (log-transform xs) (do ((i 0 (+ i 1))) ((= i n) result) (let ((x (max (vector-ref xs i) 1e-10))) (vector-set! result i (/ (- (expt x lambda) 1) lambda)))))))"))
(task-entry (id "statistics/ar-poly/fit-poly-trend") (skill statistics) (module ar-poly) (tier 1) (difficulty 11212) (name fit-poly-trend) (type "") (description "") (notes ()) (section rational-field-for-exact-coefficient-arithmetic) (deps (\x27;field \x27;algebra/polynomial)) (available (Q-field-ts ar-char-poly-vec ar-char-poly ar-companion-poly ma-char-poly arma-common-factors arma-reducible? arma-reduce algebra-poly->ar-coeffs algebra-poly->ma-coeffs ar-stable-simple? ma-invertible-simple?)) (answer "(define (fit-poly-trend xs degree) (let* ((n (vector-length xs)) (mean (/ (vector-fold + 0 xs) n))) (if (= degree 0) (make-polynomial Q-field-ts (list mean)) (make-polynomial Q-field-ts (list mean)))))"))
