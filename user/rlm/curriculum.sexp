(task-entry (id "clp/store/constraint?") (skill clp) (module store) (tier 1) (difficulty 10822) (name constraint?) (type "(-> α Bool)") (description "Check if value is a constraint") (notes ()) (section constraint-management) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint)) (answer "(define (constraint? x) (and (pair? x) (eq? (car x) 'constraint)))"))
(task-entry (id "clp/fd-constraints/abs-fd") (skill clp) (module fd-constraints) (tier 1) (difficulty 10822) (name abs-fd) (type "(-> (Or LVar Int) (Or LVar Int) (-> CStore (Maybe CStore)))") (description "Constrain |x| = y") (notes ()) (section absolute-value) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd =/=fd =/=fd-var-const =/=fd-var-var \x2B;fd fd-value \x2B;fd-bounds fd-bounds fd-narrow-bounds \x2D;fd *fd *fd-bounds)) (answer "(define (abs-fd x y) (lambda (cs) (let ((x-val (fd-value cs x)) (y-val (fd-value cs y))) (cond ((and x-val y-val) (if (= (abs x-val) y-val) cs #f)) (x-val ((=fd y (abs x-val)) cs)) (y-val (cstore-narrow-domain cs x (domain-union (domain-singleton y-val) (domain-singleton (- y-val))))) (else (let* ((cs1 ((>=fd y 0) cs)) (x-bounds (and cs1 (fd-bounds cs1 x))) (y-bounds (and cs1 (fd-bounds cs1 y)))) (if (and x-bounds y-bounds) (let* ((x-lo (car x-bounds)) (x-hi (cdr x-bounds)) (y-hi (cdr y-bounds)) (cs2 (fd-narrow-bounds cs1 x (- y-hi) y-hi))) cs2) cs1)))))))"))
