(task-entry (id "optimization/interval-global/box-hull") (skill optimization) (module interval-global) (tier 1) (difficulty 12815) (name box-hull) (type "") (description "") (notes ()) (section convergence-criteria) (deps (\x27;prelude \x27;interval \x27;heap)) (available (make-interval-convergence interval-convergence? ic-width-tol ic-max-iter ic-gap-tol *default-interval-convergence* make-interval-opt-result interval-opt-result? ior-candidates ior-best-upper ior-iterations ior-reason ior-best-box ior-best-point ior-solution-box)) (answer "(define (box-hull box1 box2) (map interval-hull box1 box2))"))
(task-entry (id "optimization/interval-contract/sphere-other-sq") (skill optimization) (module interval-contract) (tier 1) (difficulty 12815) (name sphere-other-sq) (type "") (description "") (notes ()) (section quadratic-contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract contract-linear-var remove-dim sum-interval-bounds make-linear-ge-contractor make-linear-eq-contractor make-sphere-contractor contract-sphere-dim)) (answer "(define (sphere-other-sq box center dim) (let loop ((d 0) (ivs box) (cs center) (sum 0)) (cond ((null? ivs) sum) ((= d dim) (loop (+ d 1) (cdr ivs) (cdr cs) sum)) (else (let* ((iv (car ivs)) (c (car cs)) (min-dist (cond ((interval-contains? iv c) 0) ((< c (interval-lo iv)) (- (interval-lo iv) c)) (else (- c (interval-hi iv)))))) (loop (+ d 1) (cdr ivs) (cdr cs) (+ sum (* min-dist min-dist))))))))"))
(task-entry (id "optimization/interval-newton/interval-contains-no-root?") (skill optimization) (module interval-newton) (tier 1) (difficulty 12815) (name interval-contains-no-root?) (type "(-> (-> Interval Interval) (-> Interval Interval) Interval Boolean)") (description "") (notes ()) (section existence-tests) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step interval-newton-step-rigorous interval-newton-root interval-find-all-roots interval-might-contain-root? interval-bisection-root bisection-loop interval-contains-unique-root?)) (answer "(define (interval-contains-no-root? f-iv f-deriv-iv X) (let ((step-result (interval-newton-step-rigorous f-iv f-deriv-iv X))) (eq? (car step-result) 'no-root)))"))
(task-entry (id "optimization/line-search/wolfe-zoom") (skill optimization) (module line-search) (tier 1) (difficulty 12816) (name wolfe-zoom) (type "") (description "") (notes ()) (section overview) (deps (\x27;prelude \x27;reverse-diff)) (available (*armijo-c1* *wolfe-c2* *backtrack-rho* *max-ls-iters* *initial-step* *default-alpha-max* dot-product vec-add-scaled armijo-condition? armijo-backtrack armijo-backtrack-full curvature-condition? strong-curvature-condition? wolfe-line-search wolfe-line-search-full wolfe-bracket)) (answer "(define (wolfe-zoom f x grad direction f-old grad-dot-d alpha-lo alpha-hi c1 c2 max-iters) (let loop ((lo alpha-lo) (hi alpha-hi) (iter 0)) (if (or (>= iter max-iters) (< (abs (- hi lo)) 1e-10)) (let* ((alpha (/ (+ lo hi) 2)) (x-new (vec-add-scaled x direction alpha))) (list x-new alpha)) (let* ((alpha (/ (+ lo hi) 2)) (x-new (vec-add-scaled x direction alpha)) (f-new (apply f x-new)) (f-lo (apply f (vec-add-scaled x direction lo)))) (cond ((or (> f-new (+ f-old (* c1 alpha grad-dot-d))) (>= f-new f-lo)) (loop lo alpha (+ iter 1))) (else (let* ((grad-new (gradient f x-new)) (grad-new-dot-d (dot-product grad-new direction))) (cond ((strong-curvature-condition? grad-new-dot-d grad-dot-d c2) (list x-new alpha)) ((>= (* grad-new-dot-d (- hi lo)) 0) (loop alpha lo (+ iter 1))) (else (loop alpha hi (+ iter 1)))))))))))"))
(task-entry (id "optimization/convergence/vec-diff-norm") (skill optimization) (module convergence) (tier 1) (difficulty 12816) (name vec-diff-norm) (type "(-> (List Number) (List Number) Number)") (description "Compute ||v1 - v2||") (notes ()) (section vector-norms) (deps (\x27;prelude \x27;vec)) (available (make-convergence-criteria *default-convergence* convergence-criteria? cc-grad-tol cc-f-tol cc-x-tol cc-max-iter make-convergence-state convergence-state? cs-iter cs-f-val cs-grad-norm cs-f-change cs-x-change converged? vec-norm)) (answer "(define (vec-diff-norm v1 v2) (vec-norm (map - v1 v2)))"))
(task-entry (id "optimization/first-order/muon-matrix-full") (skill optimization) (module first-order) (tier 1) (difficulty 12816) (name muon-matrix-full) (type "(-> (-> (List TracedValue) TracedValue) Matrix Number Number Nat ConvergenceCriteria MatrixOptResult)") (description "Muon optimizer for matrices with all hyperparameters") (notes ()) (section muon) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum adam adam-full rmsprop rmsprop-full adagrad adagrad-full gradient-descent-ls nesterov newton-schulz-step newton-schulz muon muon-full muon-matrix)) (answer "(define (muon-matrix-full f m0 lr beta ns-iters criteria) (let* ((rows (matrix-rows m0)) (cols (matrix-cols m0)) (x0 (vector->list (matrix-data m0))) (n (length x0)) (init-m (make-list n 0)) (init-grad (gradient f x0)) (init-f (apply f x0)) (init-state (initial-convergence-state init-f init-grad))) (let loop ((x x0) (m init-m) (state init-state)) (let ((reason (converged? criteria state))) (if reason (let ((result-matrix (matrix-from-vec rows cols (list->vector x)))) (list 'matrix-opt-result result-matrix (cs-f-val state) (gradient f x) (cs-iter state) reason)) (let* ((grad (gradient f x)) (m-new (map (lambda (mi gi) (+ (* beta mi) gi)) m grad)) (m-matrix (matrix-from-vec rows cols (list->vector m-new))) (m-orth-matrix (newton-schulz m-matrix ns-iters)) (m-orth (vector->list (matrix-data m-orth-matrix))) (x-new (map (lambda (xi mi) (- xi (* lr mi))) x m-orth)) (f-new (apply f x-new)) (grad-new (gradient f x-new)) (new-state (update-convergence-state state f-new grad-new x x-new))) (loop x-new m-new new-state)))))))"))
