(task-entry (id "egraph/saturation/saturate-iteration") (skill egraph) (module saturation) (tier 1) (difficulty 10017) (name saturate-iteration) (type "(-> EGraph (List Rule) Nat Nat)") (description "Run one saturation iteration. Returns applications count.") (notes ()) (section loop) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate)) (answer "(define (saturate-iteration eg rules limit) (let ((uf (egraph-uf eg)) (count 0) (stop #f)) (for-each (lambda (root) (unless stop (for-each (lambda (rule) (unless stop (let ((matches (ematch eg (rule-lhs rule) root))) (for-each (lambda (subst) (unless stop (let* ((rhs (rule-rhs rule)) (rhs-term (pattern-apply subst rhs)) (rhs-id (add-instantiated-term eg rhs-term)) (root-class (egraph-find eg root)) (rhs-class (egraph-find eg rhs-id))) (unless (= root-class rhs-class) (egraph-merge! eg root rhs-id) (set! count (+ count 1)) (when (and (> limit 0) (>= count limit)) (set! stop #t)))))) matches)))) rules))) (uf-roots uf)) count))"))
