(task-entry (id "dsl/partial-eval/bta") (skill dsl) (module partial-eval) (tier 1) (difficulty 11712) (name bta) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt? bt-join bt-meet bt<=? make-bt-env bt-env-extend bt-env-lookup bt-env-extend-many pe-primitive?)) (answer "(define (bta expr env) (cond ((or (number? expr) (boolean? expr) (string? expr) (null? expr)) bt-static) ((and (pair? expr) (eq? (car expr) 'quote)) bt-static) ((symbol? expr) (bt-env-lookup env expr)) ((and (pair? expr) (eq? (car expr) 'lambda)) (let* ((params (cadr expr)) (body (caddr expr)) (body-env (bt-env-extend-many env params (map (lambda (_) bt-dynamic) params))) (body-bt (bta body body-env))) bt-static)) ((and (pair? expr) (eq? (car expr) 'if)) (let ((cond-bt (bta (cadr expr) env)) (then-bt (bta (caddr expr) env)) (else-bt (if (null? (cdddr expr)) bt-static (bta (cadddr expr) env)))) (if (eq? cond-bt bt-static) (bt-join then-bt else-bt) bt-dynamic))) ((and (pair? expr) (eq? (car expr) 'let)) (let* ((bindings (cadr expr)) (body (caddr expr)) (binding-bts (map (lambda (b) (bta (cadr b) env)) bindings)) (body-env (bt-env-extend-many env (map car bindings) binding-bts))) (bta body body-env))) ((and (pair? expr) (eq? (car expr) 'letrec)) (let* ((bindings (cadr expr)) (body (caddr expr)) (vars (map car bindings))) (let ((body-env (bt-env-extend-many env vars (map (lambda (_) bt-dynamic) vars)))) (bta body body-env)))) ((pair? expr) (let* ((op (car expr)) (op-bt (if (and (symbol? op) (pe-primitive? op)) bt-static (bta op env))) (arg-bts (map (lambda (a) (bta a env)) (cdr expr)))) (fold-left bt-join op-bt arg-bts))) (else bt-dynamic)))"))
(task-entry (id "dsl/compose/functor-row?") (skill dsl) (module compose) (tier 1) (difficulty 11712) (name functor-row?) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap row-fmap-helper register-fmap make-functor-row)) (answer "(define (functor-row? x) (and (pair? x) (eq? (car x) 'functor-row)))"))
