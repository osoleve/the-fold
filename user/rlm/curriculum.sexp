(task-entry (id "physics/classical/ode-integrators/symplectic-euler-step-b") (skill physics/classical) (module ode-integrators) (tier 2) (difficulty 23509) (name symplectic-euler-step-b) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (state-add state-sub state-scale state-madd euler-step midpoint-step heun-step rk4-step symplectic-euler-step)) (answer "(define (symplectic-euler-step-b a t pos vel dt) (let* ((new-pos (state-madd pos dt vel)) (accel (a (+ t dt) new-pos)) (new-vel (state-madd vel dt accel))) (list new-pos new-vel)))"))
