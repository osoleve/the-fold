(task-entry (id "algebra/galois/make-gf-p2") (skill algebra) (module galois) (tier 0) (difficulty 348) (name make-gf-p2) (type "") (description "Create GF(p^2) using x^2 + 1 (requires p ≡ 3 mod 4)") (notes ()) (section standard-irreducibles) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod unique-prime-divisors poly-frobenius-power rabin-irreducible? poly-irreducible? poly-has-factor-up-to-degree? poly-has-root? poly-has-monic-factor-of-degree? gf2-8-aes-irred make-gf2-8-aes gf2-4-irred make-gf2-4 gf2-16-irred make-gf2-16 gf2-32-irred make-gf2-32)) (answer "(define (make-gf-p2 p) (let* ((base (gf-prime p)) (one (field-one base)) (zero (field-zero base)) (modulus (make-polynomial base (list one zero one)))) (make-gf-extension p 2 modulus)))"))
(task-entry (id "algebra/group/kernel") (skill algebra) (module group) (tier 0) (difficulty 349) (name kernel) (type "(-> Homomorphism (List Element))") (description "Compute the kernel: elements that map to the identity") (notes ()) (section group-homomorphisms) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity dihedral-op dihedral-inverse make-dihedral-group D is-subgroup? generate-subgroup make-homomorphism homomorphism? homomorphism-source homomorphism-target homomorphism-mapping homomorphism-apply verify-homomorphism is-isomorphism?)) (answer "(define (kernel h) (let* ((source (homomorphism-source h)) (target (homomorphism-target h)) (phi (homomorphism-mapping h)) (e-t (group-identity target)) (eq? (group-equal-fn target))) (filter (lambda (a) (eq? (phi a) e-t)) (group-elements source))))"))
