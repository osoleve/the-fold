(task-entry (id "fp/goals/decompose-goal") (skill fp) (module goals) (tier 1) (difficulty 10627) (name decompose-goal) (type "(-> Goal (List eq-goal))") (description "Expand a high-level goal into concrete equality goals with metavariables.\n\nAssociativity decomposes to:\n  (op (op (?x) (?y)) (?z)) = (op (?x) (op (?y) (?z)))\n\nLeft identity decomposes to:\n  (op e (?x)) = (?x)\n\nRight identity decomposes to:\n  (op (?x) e) = (?x)\n\nInverse decomposes to one or two equalities depending on side.") (notes ()) (section goal-decomposition) (deps (\x27;prelude \x27;rule)) (available (goal? goal-type goal-context make-eq-goal eq-goal? eq-goal-lhs eq-goal-rhs eq-goal-carrier make-assoc-goal assoc-goal? assoc-goal-op make-left-id-goal left-id-goal? left-id-goal-op left-id-goal-identity make-right-id-goal right-id-goal? right-id-goal-op right-id-goal-identity make-id-goal id-goal? make-inv-goal inv-goal? inv-goal-op inv-goal-inv inv-goal-identity inv-goal-side)) (answer "(define (decompose-goal goal) (let ((ctx (goal-context goal)) (type (goal-type goal))) (case type ((eq) (list goal)) ((assoc) (let ((op (assoc-goal-op goal))) (list (make-eq-goal ctx (quasiquote ((unquote op) ((unquote op) (?x) (?y)) (?z))) (quasiquote ((unquote op) (?x) ((unquote op) (?y) (?z)))))))) ((left-id) (let ((op (left-id-goal-op goal)) (e (left-id-goal-identity goal))) (list (make-eq-goal ctx (quasiquote ((unquote op) (unquote e) (?x))) '(?x))))) ((right-id) (let ((op (right-id-goal-op goal)) (e (right-id-goal-identity goal))) (list (make-eq-goal ctx (quasiquote ((unquote op) (?x) (unquote e))) '(?x))))) ((inv) (let ((op (inv-goal-op goal)) (inv-op (inv-goal-inv goal)) (e (inv-goal-identity goal)) (side (inv-goal-side goal))) (case side ((left) (list (make-eq-goal ctx (quasiquote ((unquote op) ((unquote inv-op) (?x)) (?x))) e))) ((right) (list (make-eq-goal ctx (quasiquote ((unquote op) (?x) ((unquote inv-op) (?x)))) e))) ((both) (list (make-eq-goal ctx (quasiquote ((unquote op) ((unquote inv-op) (?x)) (?x))) e) (make-eq-goal ctx (quasiquote ((unquote op) (?x) ((unquote inv-op) (?x)))) e))) (else '())))) (else '()))))"))
