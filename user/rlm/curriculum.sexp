(task-entry (id "autodiff/differentiable-signal/vec-extract-tape") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12702) (name vec-extract-tape) (type "(-> (Vector Traced) (Option Tape))") (description "") (notes ()) (section vector-utilities) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values)) (answer "(define (vec-extract-tape v) (if (and (vector? v) (> (vector-length v) 0) (traced? (vector-ref v 0))) (traced-tape (vector-ref v 0)) #f))"))
