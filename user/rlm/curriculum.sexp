(task-entry (id "random/variational-inference/vi-fit-linear-regression") (skill random) (module variational-inference) (tier 1) (difficulty 12958) (name vi-fit-linear-regression) (type "") (description "") (notes ()) (section convenience-common-model-fitting) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf vi-step-mf make-adam-state adam-state? adam-state-m adam-state-v adam-state-t adam-update vi-step-adam vi-step-adam-traced vi-fit vi-fit-traced vi-result? vi-result-vfamily vi-result-elbo-history vi-result-iterations vi-fit-normal-mean)) (answer "(define vi-fit-linear-regression (case-lambda ((X y) (vi-fit-linear-regression X y 1.0 2000 0.01)) ((X y sigma2) (vi-fit-linear-regression X y sigma2 2000 0.01)) ((X y sigma2 num-iters) (vi-fit-linear-regression X y sigma2 num-iters 0.01)) ((X y sigma2 num-iters lr) (let* ((n (length y)) (d (length (car X))) (log-joint (lambda (beta) (+ (fold-left + 0 (map (lambda (bi) (log-normal-pdf bi 0 10)) beta)) (fold-left + 0 (map (lambda (xi yi) (let ((pred (fold-left + 0 (map * xi beta)))) (log-normal-pdf yi pred sigma2))) X y))))) (traced-log-joint (make-traced-log-joint-linear-regression X y sigma2 10)) (init-means (make-list d 0.0)) (init-log-stds (make-list d 0.0)) (init-vfamily (make-mf-gaussian init-means init-log-stds))) (vi-fit-traced log-joint traced-log-joint init-vfamily num-iters lr)))))"))
(task-entry (id "random/variational-inference/vi-summary") (skill random) (module variational-inference) (tier 1) (difficulty 12959) (name vi-summary) (type "") (description "") (notes ()) (section diagnostics) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf vi-step-mf make-adam-state adam-state? adam-state-m adam-state-v adam-state-t adam-update vi-step-adam vi-step-adam-traced vi-fit vi-fit-traced vi-result? vi-result-vfamily vi-result-elbo-history vi-result-iterations vi-fit-normal-mean vi-fit-linear-regression)) (answer "(define (vi-summary result) (let* ((vfamily (vi-result-vfamily result)) (history (vi-result-elbo-history result)) (final-elbo (if (null? history) #f (cdar (last-pair history)))) (first-elbo (if (null? history) #f (cdar history)))) (quasiquote ((type unquote (cond ((mf-gaussian? vfamily) 'mean-field-gaussian) ((full-gaussian? vfamily) 'full-gaussian) (else 'unknown))) (dimension unquote (vfamily-dim vfamily)) (iterations unquote (vi-result-iterations result)) (final-elbo unquote final-elbo) (elbo-improvement unquote (if (and first-elbo final-elbo) (- final-elbo first-elbo) #f)) (posterior-mean unquote (cond ((mf-gaussian? vfamily) (mf-gaussian-means vfamily)) ((full-gaussian? vfamily) (full-gaussian-means vfamily)) (else #f))) (posterior-std unquote (cond ((mf-gaussian? vfamily) (mf-gaussian-stds vfamily)) (else #f)))))))"))
(task-entry (id "random/variational-inference/last-pair") (skill random) (module variational-inference) (tier 1) (difficulty 12960) (name last-pair) (type "") (description "") (notes ()) (section diagnostics) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf vi-step-mf make-adam-state adam-state? adam-state-m adam-state-v adam-state-t adam-update vi-step-adam vi-step-adam-traced vi-fit vi-fit-traced vi-result? vi-result-vfamily vi-result-elbo-history vi-result-iterations vi-fit-normal-mean vi-fit-linear-regression vi-summary)) (answer "(define (last-pair lst) (if (null? (cdr lst)) lst (last-pair (cdr lst))))"))
(task-entry (id "random/variational-inference/vi-check-convergence") (skill random) (module variational-inference) (tier 1) (difficulty 12961) (name vi-check-convergence) (type "") (description "") (notes ()) (section diagnostics) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf vi-step-mf make-adam-state adam-state? adam-state-m adam-state-v adam-state-t adam-update vi-step-adam vi-step-adam-traced vi-fit vi-fit-traced vi-result? vi-result-vfamily vi-result-elbo-history vi-result-iterations vi-fit-normal-mean vi-fit-linear-regression vi-summary last-pair)) (answer "(define (vi-check-convergence result threshold) (let ((history (vi-result-elbo-history result))) (if (< (length history) 2) #f (let* ((recent (take 2 history)) (elbo1 (cdar recent)) (elbo0 (cdadr recent)) (rel-change (abs (/ (- elbo1 elbo0) (+ (abs elbo0) 1e-8))))) (< rel-change threshold)))))"))
(task-entry (id "game-theory/normal-form/make-game") (skill game-theory) (module normal-form) (tier 1) (difficulty 13200) (name make-game) (type "(-> (List Symbol) (List Symbol) (List (List (Pair Number Number))) Game)") (description "Create a normal form game from lists") (notes ()) (section game-representation) (deps (\x27;prelude)) (available ()) (answer "(define (make-game strats1 strats2 payoff-lists) (let ((s1 (list->vector strats1)) (s2 (list->vector strats2)) (matrix (list->vector (map list->vector payoff-lists)))) (make-game% s1 s2 matrix)))"))
