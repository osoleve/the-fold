(task-entry (id "info/coding/lz78-encode-helper") (skill info) (module coding) (tier 1) (difficulty 11124) (name lz78-encode-helper) (type "(-> (List Symbol) (List (Pair Nat (List Symbol))) Nat (List (Pair Nat Symbol)) (List (Pair Nat Symbol)))") (description "") (notes ()) (section lempel-ziv-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob huffman-codes huffman-codes-helper huffman-encode huffman-decode huffman-decode-helper huffman-average-length huffman-efficiency arithmetic-encode arithmetic-encode-helper build-cumulative-probs arithmetic-decode arithmetic-decode-helper find-symbol-for-code arithmetic-code-length lz78-encode)) (answer "(define (lz78-encode-helper remaining dict next-index acc) (if (null? remaining) (reverse acc) (let* ((match (lz78-find-longest-match remaining dict)) (match-idx (car match)) (match-len (cadr match)) (next-sym (if (< match-len (length remaining)) (list-ref remaining match-len) 'EOF)) (consume (+ match-len (if (eq? next-sym 'EOF) 0 1))) (new-phrase (take-n consume remaining)) (new-dict (append dict (list (cons next-index new-phrase)))) (new-remaining (drop-n consume remaining))) (lz78-encode-helper new-remaining new-dict (+ next-index 1) (cons (cons match-idx next-sym) acc)))))"))
