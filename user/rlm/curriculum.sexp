(task-entry (id "linalg/graph-laplacian/kmeans-init-pp") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 427) (name kmeans-init-pp) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue is-bipartite-spectral? effective-resistance total-effective-resistance laplacian-summary spectral-clustering spectral-clustering-unnorm k-smallest-indices spectral-embedding kmeans-cluster)) (answer "(define (kmeans-init-pp points k) (let* ((n (matrix-rows points)) (d (matrix-cols points)) (centroids (make-matrix k d 0)) (first-idx (modulo (* 2654435761 n) n))) (do ((j 0 (+ j 1))) ((= j d)) (matrix-set! centroids 0 j (matrix-ref points first-idx j))) (do ((c 1 (+ c 1))) ((= c k) centroids) (let ((distances (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((min-dist +inf.0)) (do ((cc 0 (+ cc 1))) ((= cc c)) (let ((dist (point-centroid-distance points i centroids cc d))) (set! min-dist (min min-dist dist)))) (vector-set! distances i min-dist))) (let* ((total (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (vector-ref distances i)))))) (next-idx (let loop ((i 0) (max-idx 0) (max-dist 0)) (if (= i n) max-idx (if (> (vector-ref distances i) max-dist) (loop (+ i 1) i (vector-ref distances i)) (loop (+ i 1) max-idx max-dist)))))) (do ((j 0 (+ j 1))) ((= j d)) (matrix-set! centroids c j (matrix-ref points next-idx j))))))))"))
(task-entry (id "linalg/numeric-instances/matrix-hadamard") (skill linalg) (module numeric-instances) (tier 0) (difficulty 427) (name matrix-hadamard) (type "") (description "") (notes ()) (section matrix-num-instance) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (vec+ vec- vec* vec-abs vec-signum vec-from-integer vec/ vec-recip vec-pi vec-exp vec-log vec-sqrt vec-pow vec-sin vec-cos vec-tan vec-asin vec-acos vec-atan vec-sinh vec-cosh vec-tanh vec-asinh vec-acosh vec-atanh matrix+ matrix-)) (answer "(define (matrix-hadamard m1 m2) (let ((r1 (matrix-rows m1)) (c1 (matrix-cols m1)) (r2 (matrix-rows m2)) (c2 (matrix-cols m2))) (if (or (not (= r1 r2)) (not (= c1 c2))) (quasiquote (error dimension-mismatch ((unquote r1) (unquote c1)) ((unquote r2) (unquote c2)))) (let ((data1 (matrix-data m1)) (data2 (matrix-data m2)) (result (make-vector (* r1 c1) 0))) (do ((i 0 (+ i 1))) ((= i (* r1 c1))) (vector-set! result i (* (vector-ref data1 i) (vector-ref data2 i)))) (list 'matrix r1 c1 result)))))"))
(task-entry (id "linalg/vec/vec-normalize") (skill linalg) (module vec) (tier 0) (difficulty 428) (name vec-normalize) (type "(-> (Vec Num) (Or (Vec Num) Error))") (description "Normalize to unit length") (notes ()) (section vector-products-and-norms) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop vec-slice vec-add vec-sub vec-mul vec-div vec-scale vec-negate vec-dot vec-norm-squared vec-norm vec-norm-l1 vec-norm-linf)) (answer "(define (vec-normalize v) (let ((n (vec-norm v))) (if (= n 0) '(error zero-vector) (vec-scale (/ 1 n) v))))"))
(task-entry (id "linalg/quaternion/quat-inverse") (skill linalg) (module quaternion) (tier 0) (difficulty 428) (name quat-inverse) (type "") (description "") (notes ()) (section quaternion-arithmetic) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at quat? quat-identity? quat-unit? quat-w quat-x quat-y quat-z quat-scalar quat-vector quat->list list->quat quat-add quat-sub quat-neg quat-scale quat-mul quat-magnitude-sq quat-magnitude quat-normalize quat-conjugate)) (answer "(define (quat-inverse q) (let ((mag-sq (quat-magnitude-sq q))) (if (< mag-sq 1e-10) (quat-identity) (quat-scale (quat-conjugate q) (/ 1 mag-sq)))))"))
(task-entry (id "linalg/matrix/matrix-trace") (skill linalg) (module matrix) (tier 0) (difficulty 428) (name matrix-trace) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose matrix-map matrix-map2 matrix-fold matrix-add matrix-sub matrix-hadamard matrix-scale matrix-negate matrix-mul matrix-vec-mul vec-matrix-mul matrix-equal? matrix-approx-equal? matrix-square? matrix-symmetric?)) (answer "(define (matrix-trace m) (vec-sum (matrix-diagonal m)))"))
