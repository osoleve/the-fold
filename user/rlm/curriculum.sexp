(task-entry (id "numeric/fem/fem-locate-point") (skill numeric) (module fem) (tier 0) (difficulty 2546) (name fem-locate-point) (type "") (description "") (notes ()) (section spatial-index) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes apply-dirichlet-bc! apply-dirichlet-penalty! *fem-tolerance* *fem-max-iterations* sparse-cg sparse-cg-loop sparse-csr-diagonal vec-div-pointwise sparse-pcg sparse-pcg-loop vec-dot vec-add vec-sub vec-scale fem-solve-poisson fem-solve-poisson-full make-fem-spatial-index fem-spatial-index? fem-spatial-index-mesh fem-spatial-index-grid fem-spatial-index-grid-size fem-spatial-index-x-min fem-spatial-index-x-max fem-spatial-index-y-min fem-spatial-index-y-max fem-spatial-index-dx fem-spatial-index-dy fem-point-in-element?)) (answer "(define (fem-locate-point index x y) (let* ((mesh (fem-spatial-index-mesh index)) (grid (fem-spatial-index-grid index)) (gs (fem-spatial-index-grid-size index)) (x-min (fem-spatial-index-x-min index)) (y-min (fem-spatial-index-y-min index)) (dx (fem-spatial-index-dx index)) (dy (fem-spatial-index-dy index)) (ci (inexact->exact (floor (/ (- x x-min) dx)))) (cj (inexact->exact (floor (/ (- y y-min) dy))))) (if (or (< ci 0) (>= ci gs) (< cj 0) (>= cj gs)) #f (let ((candidates (vector-ref grid (+ (* cj gs) ci)))) (let loop ((elems candidates)) (if (null? elems) #f (let ((bary (fem-point-in-element? mesh (car elems) x y))) (if bary (cons (car elems) bary) (loop (cdr elems))))))))))"))
(task-entry (id "numeric/digital-filters/filter-process-sample!") (skill numeric) (module digital-filters) (tier 0) (difficulty 2547) (name filter-process-sample!) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window bessel-i0 sinc fir-lowpass fir-highpass fir-bandpass fir-bandstop fir-filter make-iir-filter iir-filter? iir-filter-b iir-filter-a iir-filter-signal make-biquad biquad? biquad-b0 biquad-b1 biquad-b2 biquad-a1 biquad-a2 biquad-filter cascade-biquads butterworth-lowpass-poles bilinear-transform butterworth-lowpass complex-sum poles-zeros->tf vector-scale-real poly-from-roots poly-mul-binomial chebyshev1-lowpass chebyshev1-poles asinh cosh sinh freqz eval-transfer-function eval-poly magnitude-response log10 phase-response make-filter-state filter-state?)) (answer "(define (filter-process-sample! state sample) (let* ((b (cdr (assq 'b state))) (a (cdr (assq 'a state))) (x-hist (cdr (assq 'x-hist state))) (y-hist (cdr (assq 'y-hist state))) (nb (vector-length b)) (na (vector-length a)) (a0 (vector-ref a 0))) (do ((j (- nb 1) (- j 1))) ((= j 0)) (vector-set! x-hist j (vector-ref x-hist (- j 1)))) (vector-set! x-hist 0 sample) (let ((sum 0.0)) (do ((j 0 (+ j 1))) ((= j nb)) (set! sum (+ sum (* (vector-ref b j) (vector-ref x-hist j))))) (do ((j 1 (+ j 1))) ((= j na)) (set! sum (- sum (* (vector-ref a j) (vector-ref y-hist j))))) (set! sum (/ sum a0)) (do ((j (- na 1) (- j 1))) ((= j 0)) (vector-set! y-hist j (vector-ref y-hist (- j 1)))) (vector-set! y-hist 0 sum) sum)))"))
