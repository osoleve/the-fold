(task-entry (id "topology/simplicial-complex/make-simplex") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11803) (name make-simplex) (type "(-> (List Vertex) Simplex)") (description "Create a simplex from a list of vertices") (notes ("Vertices are sorted for canonical representation. Duplicate vertices are removed (degenerate simplices normalized)")) (section simplex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order)) (answer "(define (make-simplex vertices) (list 'simplex (unique-sorted (sort-by generic<? vertices))))"))
(task-entry (id "topology/homology/z2-matrix-cols") (skill topology) (module homology) (tier 1) (difficulty 11803) (name z2-matrix-cols) (type "(-> Z2Matrix Integer)") (description "") (notes ()) (section z2-matrix-operations) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows)) (answer "(define (z2-matrix-cols m) (caddr m))"))
(task-entry (id "topology/persistent/filtration-order") (skill topology) (module persistent) (tier 1) (difficulty 11803) (name filtration-order) (type "(-> (Pair Simplex Number) (Pair Simplex Number) Boolean)") (description "Ordering: first by birth time, then by dimension, then by vertices") (notes ()) (section filtration) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs)) (answer "(define (filtration-order p1 p2) (let ((t1 (cdr p1)) (t2 (cdr p2)) (s1 (car p1)) (s2 (car p2))) (cond ((< t1 t2) #t) ((> t1 t2) #f) ((< (simplex-dim s1) (simplex-dim s2)) #t) ((> (simplex-dim s1) (simplex-dim s2)) #f) (else (lex<? (simplex-vertices s1) (simplex-vertices s2))))))"))
