(task-entry (id "physics-problems/spatial/position-params") (skill physics-problems) (module spatial) (tier 2) (difficulty 23616) (name position-params) (type "") (description "") (notes ()) (section position) (deps (\x27;physics-problem)) (available (size-comparison-params size-comparison-setup size-comparison-question size-comparison-answer size-comparison-problem distance-params distance-setup distance-question distance-answer distance-problem count-params count-setup make-count-entities count-question count-answer count-problem)) (answer "(define position-params (make-param-set (list (uniform-range 'x-left -15.0 -3.0) (uniform-range 'x-right 3.0 15.0) (uniform-range 'y1 2.0 18.0) (uniform-range 'y2 2.0 18.0) (uniform-range 'r 1.5 2.5) (range-int 'swap 0 1)) (lambda (params) (let ((xl (cdr (assq 'x-left params))) (xr (cdr (assq 'x-right params)))) (> (- xr xl) 5.0)))))"))
(task-entry (id "physics-problems/physics-problem/generate-problem-batch") (skill physics-problems) (module physics-problem) (tier 2) (difficulty 23617) (name generate-problem-batch) (type "") (description "") (notes ()) (section batch) (deps (\x27;prelude \x27;vec2 \x27;sample \x27;parameter \x27;presentation \x27;distractor \x27;difficulty \x27;simulation)) (available (make-physics-problem physics-problem? problem-name problem-category problem-params problem-world-setup problem-question-gen problem-answer-compute problem-difficulty generate-problem-instance generate-problem-id generate-problem-options find-correct-label string-contains-approx? format-answer category-distractor-strategies category-comparison-choices)) (answer "(define (generate-problem-batch problem rng config count) (let loop ((remaining count) (samples '())) (if (<= remaining 0) (reverse samples) (let ((sample (generate-problem-instance problem rng config))) (loop (- remaining 1) (cons sample samples))))))"))
(task-entry (id "physics-problems/simulation/simulate-n-steps") (skill physics-problems) (module simulation) (tier 2) (difficulty 23617) (name simulate-n-steps) (type "") (description "") (notes ()) (section simulation) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static make-box make-ground setup-problem-world setup-no-gravity-world setup-gravity-world simulate-step)) (answer "(define (simulate-n-steps world dt n) (if (<= n 0) world (simulate-n-steps (simulate-step world dt) dt (- n 1))))"))
(task-entry (id "physics-problems/spatial/position-setup") (skill physics-problems) (module spatial) (tier 2) (difficulty 23617) (name position-setup) (type "") (description "") (notes ()) (section position) (deps (\x27;physics-problem)) (available (size-comparison-params size-comparison-setup size-comparison-question size-comparison-answer size-comparison-problem distance-params distance-setup distance-question distance-answer distance-problem count-params count-setup make-count-entities count-question count-answer count-problem position-params)) (answer "(define (position-setup params) (let* ((xl (cdr (assq 'x-left params))) (xr (cdr (assq 'x-right params))) (y1 (cdr (assq 'y1 params))) (y2 (cdr (assq 'y2 params))) (r (cdr (assq 'r params))) (swap? (= 1 (cdr (assq 'swap params)))) (xa (if swap? xr xl)) (xb (if swap? xl xr))) (setup-no-gravity-world (list (make-ball 'ball-a (vec2 xa y1) r 1.0 (vec2 0 0)) (make-ball 'ball-b (vec2 xb y2) r 1.0 (vec2 0 0))))))"))
(task-entry (id "physics-problems/physics-problem/validate-problem-params") (skill physics-problems) (module physics-problem) (tier 2) (difficulty 23618) (name validate-problem-params) (type "") (description "") (notes ()) (section validation) (deps (\x27;prelude \x27;vec2 \x27;sample \x27;parameter \x27;presentation \x27;distractor \x27;difficulty \x27;simulation)) (available (make-physics-problem physics-problem? problem-name problem-category problem-params problem-world-setup problem-question-gen problem-answer-compute problem-difficulty generate-problem-instance generate-problem-id generate-problem-options find-correct-label string-contains-approx? format-answer category-distractor-strategies category-comparison-choices generate-problem-batch)) (answer "(define (validate-problem-params problem params) (and (list? params) (> (length params) 0)))"))
(task-entry (id "physics-problems/simulation/simulate-frames") (skill physics-problems) (module simulation) (tier 2) (difficulty 23618) (name simulate-frames) (type "") (description "") (notes ()) (section simulation) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static make-box make-ground setup-problem-world setup-no-gravity-world setup-gravity-world simulate-step simulate-n-steps)) (answer "(define (simulate-frames world config n-frames) (let ((dt (problem-config-dt config)) (steps-per-frame (problem-config-frames-per-step config))) (let loop ((w world) (frames '()) (remaining n-frames)) (if (<= remaining 0) (reverse frames) (let ((next-w (simulate-n-steps w dt steps-per-frame))) (loop next-w (cons w frames) (- remaining 1)))))))"))
(task-entry (id "physics-problems/spatial/position-question") (skill physics-problems) (module spatial) (tier 2) (difficulty 23618) (name position-question) (type "") (description "") (notes ()) (section position) (deps (\x27;physics-problem)) (available (size-comparison-params size-comparison-setup size-comparison-question size-comparison-answer size-comparison-problem distance-params distance-setup distance-question distance-answer distance-problem count-params count-setup make-count-entities count-question count-answer count-problem position-params position-setup)) (answer "(define (position-question params) \"Two balls (A and B) are shown. Which ball is further to the right?\")"))
