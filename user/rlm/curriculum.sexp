(task-entry (id "info/coding/arithmetic-decode-helper") (skill info) (module coding) (tier 1) (difficulty 11120) (name arithmetic-decode-helper) (type "(-> Real (List (List Symbol Real Real)) Nat (List Symbol) (List Symbol))") (description "") (notes ()) (section arithmetic-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob huffman-codes huffman-codes-helper huffman-encode huffman-decode huffman-decode-helper huffman-average-length huffman-efficiency arithmetic-encode arithmetic-encode-helper build-cumulative-probs arithmetic-decode)) (answer "(define (arithmetic-decode-helper code cumulative length acc) (if (= length 0) (reverse acc) (let* ((sym-interval (find-symbol-for-code code cumulative)) (sym (car sym-interval)) (sym-low (cadr sym-interval)) (sym-high (caddr sym-interval)) (new-code (/ (- code sym-low) (- sym-high sym-low)))) (arithmetic-decode-helper new-code cumulative (- length 1) (cons sym acc)))))"))
(task-entry (id "optics/optics/->setter") (skill optics) (module optics) (tier 1) (difficulty 11121) (name ->setter) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate? grate-cotraverse-fn grate-review grate-over grate-set grate-zipWith grate-zipWith3 grate-zip grate-compose grate-id grate-fn grate-pair-same grate-list-rep iso->grate grate->setter optic-type optic-compose >>> ->traversal ->fold)) (answer "(define (->setter o) (case (optic-type o) ((setter) o) ((lens) (lens->setter o)) ((traversal) (traversal->setter o)) ((iso) (iso->setter o)) ((grate) (grate->setter o)) ((prism) (traversal->setter (prism->traversal o))) ((affine) (traversal->setter (affine->traversal o))) ((fold) (error '->setter \"Cannot convert fold to setter (read-only). Folds can only compose with read-capable optics via ->fold\")) ((getter) (error '->setter \"Cannot convert getter to setter (read-only). Use getter->fold and fold-compose for read-only composition\")) (else (error '->setter \"Unknown optic type\" (optic-type o)))))"))
