(task-entry (id "linalg/vec/vec-dot") (skill linalg) (module vec) (tier 0) (difficulty 423) (name vec-dot) (type "(-> (Vec Num) (Vec Num) (Or Num Error))") (description "Dot product (inner product)") (notes ()) (section vector-products-and-norms) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop vec-slice vec-add vec-sub vec-mul vec-div vec-scale vec-negate)) (answer "(define (vec-dot v1 v2) (let ((n1 (vector-length v1)) (n2 (vector-length v2))) (if (not (= n1 n2)) (quasiquote (error dimension-mismatch (unquote n1) (unquote n2))) (dot-product-loop i n1 (vector-ref v1 i) (vector-ref v2 i)))))"))
(task-entry (id "linalg/quaternion/quat-mul") (skill linalg) (module quaternion) (tier 0) (difficulty 423) (name quat-mul) (type "") (description "") (notes ()) (section quaternion-arithmetic) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at quat? quat-identity? quat-unit? quat-w quat-x quat-y quat-z quat-scalar quat-vector quat->list list->quat quat-add quat-sub quat-neg quat-scale)) (answer "(define (quat-mul a b) (let ((aw (quat-w a)) (ax (quat-x a)) (ay (quat-y a)) (az (quat-z a)) (bw (quat-w b)) (bx (quat-x b)) (by (quat-y b)) (bz (quat-z b))) (quat (- (* aw bw) (* ax bx) (* ay by) (* az bz)) (+ (* aw bx) (* ax bw) (* ay bz) (- (* az by))) (+ (* aw by) (- (* ax bz)) (* ay bw) (* az bx)) (+ (* aw bz) (* ax by) (- (* ay bx)) (* az bw)))))"))
(task-entry (id "linalg/matrix/vec-matrix-mul") (skill linalg) (module matrix) (tier 0) (difficulty 423) (name vec-matrix-mul) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose matrix-map matrix-map2 matrix-fold matrix-add matrix-sub matrix-hadamard matrix-scale matrix-negate matrix-mul matrix-vec-mul)) (answer "(define (vec-matrix-mul v m) (let ((rows (matrix-rows m)) (cols (matrix-cols m)) (n (vector-length v))) (if (not (= rows n)) (quasiquote (error dimension-mismatch (unquote n) (unquote rows))) (let ((data (matrix-data m)) (result (make-vector cols 0))) (do ((j 0 (+ j 1))) ((= j cols) result) (do ((i 0 (+ i 1)) (sum 0 (+ sum (* (vector-ref v i) (vector-ref data (+ (* i cols) j)))))) ((= i rows) (vector-set! result j sum))))))))"))
(task-entry (id "linalg/matrix-eigen/verify-eigenvalue") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 423) (name verify-eigenvalue) (type "") (description "") (notes ()) (section symmetric-eigen) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop eigen-decomposition symmetric-eigen symmetric-eigen-loop symmetric-converged? spectral-radius eigenvalue-condition eigenvalues eigenvectors)) (answer "(define (verify-eigenvalue a lambda v . opts) (let* ((tol (if (pair? opts) (car opts) *eigen-tolerance*)) (av (matrix-vec-mul a v)) (lambda-v (vec-scale lambda v)) (diff (vec-sub av lambda-v)) (residual (vec-norm diff))) (< residual tol)))"))
(task-entry (id "linalg/iterative-solvers/is-diagonally-dominant?") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 423) (name is-diagonally-dominant?) (type "") (description "") (notes ()) (section utilities) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres gmres-outer gmres-arnoldi gmres-arnoldi-loop apply-givens-rotations compute-givens gmres-solve-update vector-copy make-jacobi-preconditioner)) (answer "(define (is-diagonally-dominant? a) (let ((n (matrix-rows a))) (let loop ((i 0)) (if (= i n) #t (let* ((diag (abs (matrix-ref a i i))) (sum (let sloop ((j 0) (s 0.0)) (if (= j n) s (if (= j i) (sloop (+ j 1) s) (sloop (+ j 1) (+ s (abs (matrix-ref a i j))))))))) (if (> diag sum) (loop (+ i 1)) #f))))))"))
