(task-entry (id "optimization/lp/find-leaving-variable") (skill optimization) (module lp) (tier 1) (difficulty 12826) (name find-leaving-variable) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize extract-basis-matrix extract-basis-costs compute-reduced-costs find-entering-variable vec-contains? compute-direction)) (answer "(define (find-leaving-variable xB direction basis) (let* ((m (vector-length xB)) (min-ratio +inf.0) (min-idx #f)) (do ((i 0 (+ i 1))) ((= i m) (if min-idx min-idx 'unbounded)) (let ((di (vector-ref direction i))) (when (> di *lp-tolerance*) (let* ((ratio (/ (vector-ref xB i) di)) (basis-idx (vector-ref basis i))) (when (or (< ratio (- min-ratio *lp-tolerance*)) (and (< (abs (- ratio min-ratio)) *lp-tolerance*) (or (not min-idx) (< basis-idx (vector-ref basis min-idx))))) (set! min-ratio ratio) (set! min-idx i))))))))"))
