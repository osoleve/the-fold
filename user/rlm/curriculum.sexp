(task-entry (id "fp/cost-analysis/work-analysis") (skill fp) (module cost-analysis) (tier 1) (difficulty 10622) (name work-analysis) (type "(-> Expr WorkAnalysis)") (description "Generate a detailed work analysis report.") (notes ()) (section work-analysis-report) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost *form-costs* form-cost *estimate-work-fuel* estimate-work estimate-work-with-fuel estimate-let-work estimate-branch-work estimate-cond-work estimate-hof-work estimate-list-size parallel-beneficial? parallel-beneficial-n? suggested-parallelism)) (answer "(define (work-analysis expr) (let* ((total (estimate-work expr)) (complexity (expr-complexity-class expr)) (hotspots (find-hotspots expr 3)) (parallelizable (> total *min-parallel-work*))) (quasiquote (work-analysis (total-cost unquote total) (complexity-class unquote complexity) (hotspots unquote hotspots) (parallelizable? unquote parallelizable) (suggested-splits unquote (if parallelizable (min 4 (quotient total *min-parallel-work*)) 1))))))"))
