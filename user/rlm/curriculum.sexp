(task-entry (id "optics/block-optics/block-ref-at") (skill optics) (module block-optics) (tier 1) (difficulty 11003) (name block-ref-at) (type "(-> Nat (Affine Block Bytevector))") (description "Focus on a specific ref by index.\nReturns nothing if index is out of bounds.") (notes ()) (section ref-access) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens)) (answer "(define (block-ref-at n) (make-affine (lambda (blk) (let ((refs (block-refs blk))) (if (and (>= n 0) (< n (vector-length refs))) (just (vector-ref refs n)) nothing))) (lambda (new-ref blk) (let* ((refs (block-refs blk)) (len (vector-length refs))) (if (< n len) (let ((new-refs (make-vector len))) (do ((i 0 (+ i 1))) ((= i len)) (vector-set! new-refs i (if (= i n) new-ref (vector-ref refs i)))) (make-block (block-tag blk) (block-payload blk) new-refs)) blk)))))"))
