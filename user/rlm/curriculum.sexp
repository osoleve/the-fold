(task-entry (id "sim/bifurcation/find-fixed-point-with-retry") (skill sim) (module bifurcation) (tier 2) (difficulty 23346) (name find-fixed-point-with-retry) (type "(-> ParamODE Number Number Vec Number (Option (List Vec Nat Number)))") (description "Find fixed point with retry on failure, shrinking step toward original param") (notes ()) (section adaptive-step-size) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive)) (answer "(define (find-fixed-point-with-retry psys orig-param direction fp-guess current-step) (let retry-loop ((step current-step) (attempts 0)) (if (or (>= attempts 5) (< step *adaptive-min-step*)) #f (let* ((target-param (+ orig-param (* direction step))) (sys (instantiate-at psys target-param)) (result (find-fixed-point-robust-with-iters sys fp-guess *continuation-tolerance* *continuation-step-size* *continuation-max-newton*))) (if result (list (car result) (cadr result) step) (retry-loop (* step *adaptive-shrink-factor*) (+ attempts 1)))))))"))
