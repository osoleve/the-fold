(task-entry (id "physics/classical/constraint-graph/scc-internal-constraints") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23520) (name scc-internal-constraints) (type "") (description "") (notes ()) (section sccs) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints)) (answer "(define (scc-internal-constraints graph entity-list) (let ((entity-set (make-hashtable equal-hash equal?)) (seen (make-hashtable equal-hash equal?)) (result '())) (for-each (lambda (e) (hashtable-set! entity-set e #t)) entity-list) (for-each (lambda (entity) (for-each (lambda (c) (unless (hashtable-ref seen (constraint-id c) #f) (hashtable-set! seen (constraint-id c) #t) (let ((a (constraint-entity-a c)) (b (constraint-entity-b c))) (when (and (hashtable-ref entity-set a #f) (or (not b) (hashtable-ref entity-set b #f))) (set! result (cons c result)))))) (cg-constraints-for graph entity))) entity-list) (reverse result)))"))
