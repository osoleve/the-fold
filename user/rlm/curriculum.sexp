(task-entry (id "statistics/families/quasi-poisson-family") (skill statistics) (module families) (tier 1) (difficulty 11212) (name quasi-poisson-family) (type "") (description "") (notes ()) (section family-structure) (deps (\x27;prelude \x27;transcendental)) (available (make-glm-family glm-family? family-name family-variance family-deviance-contrib family-valid-mu? family-initialize gaussian-family binomial-family poisson-family gamma-family inverse-gaussian-family)) (answer "(define quasi-poisson-family (make-glm-family 'quasi-poisson (lambda (mu) mu) (lambda (y mu) (let* ((mu-safe (max mu 1e-10)) (y-safe (max y 1e-10)) (term1 (if (> y 0) (* y (log (/ y-safe mu-safe))) 0)) (term2 (- y mu))) (* 2 (- term1 term2)))) (lambda (mu) (> mu 0)) (lambda (y) (max y 0.1))))"))
(task-entry (id "statistics/link-functions/probit-pdf") (skill statistics) (module link-functions) (tier 1) (difficulty 11212) (name probit-pdf) (type "") (description "") (notes ()) (section link-function-structure) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available (make-link-function link-function? link-name link-g link-inverse link-derivative identity-link logit-link log-link probit-link probit-quantile probit-cdf)) (answer "(define (probit-pdf x) (/ (exp (* -0.5 x x)) (sqrt (* 2 (pi-value)))))"))
