(task-entry (id "random/bayesian/gamma-poisson-posterior") (skill random) (module bayesian) (tier 1) (difficulty 12919) (name gamma-poisson-posterior) (type "") (description "") (notes ()) (section conjugate-prior-gamma-poisson) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate)) (answer "(define (gamma-poisson-posterior prior sum-obs n) (let ((alpha (gamma-prior-shape prior)) (beta (gamma-prior-rate prior))) (make-gamma-prior (+ alpha sum-obs) (+ beta n))))"))
(task-entry (id "random/monte-carlo/mh-sample") (skill random) (module monte-carlo) (tier 1) (difficulty 12919) (name mh-sample) (type "") (description "") (notes ()) (section metropolis-hastings-mcmc) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain)) (answer "(define (mh-sample log-target proposal initial n-samples burn-in) (state-bind (mh-chain log-target proposal initial burn-in) (lambda (burn-samples) (let ((last-burn (if (null? burn-samples) initial (car (reverse burn-samples))))) (mh-chain log-target proposal last-burn n-samples)))))"))
(task-entry (id "random/variational-inference/chol-num-elements") (skill random) (module variational-inference) (tier 1) (difficulty 12919) (name chol-num-elements) (type "") (description "") (notes ()) (section full-covariance-gaussian) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix)) (answer "(define (chol-num-elements n) (/ (* n (+ n 1)) 2))"))
