(task-entry (id "fp/parser/trace-parser") (skill fp) (module parser) (tier 1) (difficulty 10710) (name trace-parser) (type "(-> String (Parser α) (Parser α))") (description "Print debug info when parser is invoked") (notes ()) (section debugging-utilities) (deps (\x27;prelude \x27;combinators)) (available (%newline %tab %return %backspace %page make-pos pos? pos-line pos-col pos-offset parser-initial-pos advance-pos parser-make-state parser-state? parser-state-input parser-state-index parser-state-pos parser-state-remaining parser-state-at-end? parser-state-current-char parser-initial-state make-parse-error parse-error? error-pos error-message error-expected merge-errors format-error format-expected make-parser parser? run-parser parser-parse parse-all parser-pure parser-fail parser-eof parser-any-char parser-satisfy parser-char parser-char-ci parser-one-of parser-none-of parser-digit parser-letter parser-alpha-num parser-space parser-lower parser-upper newline-char tab-char parser-string parser-bind parser-then parser-left parser-right parser-map parser-ap parser-or parser-choice parser-try parser-optional parser-option-maybe parser-many parser-some parser-count parser-between parser-sep-by parser-sep-by1 parser-end-by parser-end-by1 parser-many-till parser-look-ahead parser-not-followed-by parser-label parser-spaces parser-spaces1 parser-lexeme parser-symbol parser-parens parser-braces parser-brackets parser-angles comma-sep semi-sep parser-natural parser-integer decimal parser-identifier parser-keyword chainl1 chainl chainr1 chainr skip-many skip-some sep-end-by sep-end-by1 many-accum fold-p scan-p until exactly at-most at-least range-of get-pos get-input with-pos parser-with-span)) (answer "(define (trace-parser label p) (make-parser (lambda (state) (let ((remaining (parser-state-remaining state))) (display \"TRACE \") (display label) (display \" at \") (display (pos-line (parser-state-pos state))) (display \":\") (display (pos-col (parser-state-pos state))) (di