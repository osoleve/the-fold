(task-entry (id "optimization/lbfgs/projected-line-search") (skill optimization) (module lbfgs) (tier 1) (difficulty 12821) (name projected-line-search) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list lbfgs-history-push take-n lbfgs-direction lbfgs-two-loop initial-hessian-scale lbfgs lbfgs-full minimize minimize-with lbfgs-b lbfgs-b-full project-box projected-gradient converged-bound?)) (answer "(define (projected-line-search f x grad direction lower upper) (let* ((f-old (apply f x)) (grad-dot-d (dot-product grad direction)) (c1 1e-4) (rho 0.5) (max-iters 50)) (let loop ((alpha 1.0) (iter 0)) (if (>= iter max-iters) (list x 0) (let* ((x-trial (vec-add-scaled x direction alpha)) (x-proj (project-box x-trial lower upper)) (f-new (apply f x-proj)) (actual-step (map - x-proj x)) (actual-alpha (if (> (vec-norm direction) 1e-10) (/ (vec-norm actual-step) (vec-norm direction)) alpha))) (if (or (<= f-new (+ f-old (* c1 actual-alpha grad-dot-d))) (< (vec-norm actual-step) 1e-10)) (list x-proj actual-alpha) (loop (* rho alpha) (+ iter 1))))))))"))
(task-entry (id "optimization/lp/extract-basis-costs") (skill optimization) (module lp) (tier 1) (difficulty 12821) (name extract-basis-costs) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize extract-basis-matrix)) (answer "(define (extract-basis-costs c basis) (let* ((m (vector-length basis)) (cb (make-vector m 0))) (do ((i 0 (+ i 1))) ((= i m) cb) (vector-set! cb i (vector-ref c (vector-ref basis i))))))"))
(task-entry (id "optimization/ilp/is-integer?") (skill optimization) (module ilp) (tier 1) (difficulty 12821) (name is-integer?) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp make-ilp-optimal make-ilp-infeasible make-ilp-unbounded ilp-optimal? ilp-infeasible? ilp-unbounded? ilp-result-x ilp-result-z)) (answer "(define (is-integer? x) (< (abs (- x (round x))) *ilp-tolerance*))"))
