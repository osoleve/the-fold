(task-entry (id "data/centrality/harmonic-closeness-node") (skill data) (module centrality) (tier 0) (difficulty 1313) (name harmonic-closeness-node) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality standard-closeness-node)) (answer "(define (harmonic-closeness-node dist i n) (let loop ((j 0) (sum 0)) (if (= j n) (/ sum (- n 1.0)) (if (= i j) (loop (+ j 1) sum) (let ((d (matrix-ref dist i j))) (if (or (>= d *infinity*) (= d 0)) (loop (+ j 1) sum) (loop (+ j 1) (+ sum (/ 1.0 d)))))))))"))
(task-entry (id "data/graph-community/uf-union") (skill data) (module graph-community) (tier 0) (difficulty 1313) (name uf-union) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find)) (answer "(define (uf-union parent rank x y) (let ((rx (vector-ref rank x)) (ry (vector-ref rank y))) (cond ((< rx ry) (vector-set! parent x y)) ((> rx ry) (vector-set! parent y x)) (else (vector-set! parent y x) (vector-set! rank x (+ rx 1))))))"))
