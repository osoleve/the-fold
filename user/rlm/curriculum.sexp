(task-entry (id "egraph/egraph/egraph-dirty") (skill egraph) (module egraph) (tier 1) (difficulty 10013) (name egraph-dirty) (type "") (description "") (notes ()) (section worklist) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat!)) (answer "(define (egraph-dirty eg) (vector->list (hashtable-keys (egraph-dirty-set eg))))"))
