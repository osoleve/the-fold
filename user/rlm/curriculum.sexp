(task-entry (id "tiles/render/render-hex-board-with-overlay") (skill tiles) (module render) (tier 1) (difficulty 12304) (name render-hex-board-with-overlay) (type "(-> Board MetaData (-> Tile String) (List Coord) String String)") (description "Render hex board with highlighted coordinates") (notes ()) (section hex-rendering) (deps (\x27;tiles/core)) (available (default-tile-char render-square-board render-square-board-with-overlay render-hex-board)) (answer "(define (render-hex-board-with-overlay board meta style-fn overlay overlay-char) (let* ((radius (cdr (assq 'radius meta))) (coords (board-tiles board)) (overlay-set (let ((ht (make-hashtable equal-hash equal?))) (for-each (lambda (c) (hashtable-set! ht c #t)) overlay) ht)) (min-q (apply min (map (lambda (entry) (let ((c (car entry))) (car c))) coords))) (max-q (apply max (map (lambda (entry) (let ((c (car entry))) (car c))) coords))) (min-r (apply min (map (lambda (entry) (let ((c (car entry))) (cdr c))) coords))) (max-r (apply max (map (lambda (entry) (let ((c (car entry))) (cdr c))) coords)))) (let loop-r ((r min-r) (lines '())) (if (> r max-r) (apply string-append (reverse lines)) (let* ((offset (if (even? r) \"\" \" \")) (row-chars (list offset))) (let loop-q ((q min-q) (chars row-chars)) (if (> q max-q) (loop-r (+ r 1) (cons (apply string-append (reverse (cons \"\n\" chars))) lines)) (let* ((coord (cons q r)) (in-overlay? (hashtable-ref overlay-set coord #f)) (tile (board-get board coord)) (char (cond (in-overlay? (string-append overlay-char \" \")) (tile (string-append (style-fn tile) \" \")) (else \"  \")))) (loop-q (+ q 1) (cons char chars))))))))))"))
