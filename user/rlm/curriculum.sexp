(task-entry (id "statistics/diagnostics/residuals-raw") (skill statistics) (module diagnostics) (tier 1) (difficulty 11202) (name residuals-raw) (type "(-> Vec Vec Vec)") (description "Raw residuals: e_i = y_i - y-hat_i") (notes ()) (section residual-types) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers)) (available (hat-matrix hat-matrix-diagonal)) (answer "(define (residuals-raw y fitted) (let* ((n (vector-length y)) (e (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) e) (vector-set! e i (- (vector-ref y i) (vector-ref fitted i))))))"))
(task-entry (id "statistics/linear/compute-coefficient-se") (skill statistics) (module linear) (tier 1) (difficulty 11202) (name compute-coefficient-se) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit linear-model-compute-diagnostics)) (answer "(define (compute-coefficient-se X mse) (let* ((p (matrix-cols X)) (XtX (matrix-mul (matrix-transpose X) X)) (XtX-inv (matrix-inverse XtX))) (if (and (pair? XtX-inv) (eq? (car XtX-inv) 'error)) XtX-inv (let ((se (make-vector p))) (do ((j 0 (+ j 1))) ((= j p) se) (let ((var-j (* (matrix-ref XtX-inv j j) mse))) (vector-set! se j (sqrt (max var-j 0)))))))))"))
(task-entry (id "statistics/regularized/compute-r-squared-ridge") (skill statistics) (module regularized) (tier 1) (difficulty 11202) (name compute-r-squared-ridge) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics)) (answer "(define (compute-r-squared-ridge y fitted) (let* ((n (vector-length y)) (y-mean (vec-mean y)) (sst (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (expt (- (vector-ref y i) y-mean) 2)))))) (sse (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (expt (- (vector-ref y i) (vector-ref fitted i)) 2))))))) (if (= sst 0) 1 (- 1 (/ sse sst)))))"))
(task-entry (id "statistics/glm/irls-step") (skill statistics) (module glm) (tier 1) (difficulty 11202) (name irls-step) (type "") (description "") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available (glm-fit irls-loop)) (answer "(define (irls-step family link X y mu eta n p) (let* ((var-fn (family-variance family)) (g-inv (link-inverse link)) (g-deriv (link-derivative link)) (W (make-vector n)) (z (make-vector n))) (do ((i 0 (+ i 1))) ((= i n)) (let* ((mu-i (vector-ref mu i)) (eta-i (vector-ref eta i)) (y-i (vector-ref y i)) (V-i (var-fn mu-i)) (g-prime-i (g-deriv mu-i)) (g-prime-sq (* g-prime-i g-prime-i)) (w-i (/ 1 (max (* V-i g-prime-sq) 1e-10))) (z-i (+ eta-i (* (- y-i mu-i) g-prime-i)))) (vector-set! W i w-i) (vector-set! z i z-i))) (let ((beta (weighted-least-squares X z W n p))) (if (and (pair? beta) (eq? (car beta) 'error)) beta (let* ((eta-new (matrix-vec-mul X beta)) (mu-new (make-vector n))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! mu-new i (g-inv (vector-ref eta-new i)))) (list beta eta-new mu-new))))))"))
