(task-entry (id "fp/units/dim-sqrt") (skill fp) (module units) (tier 1) (difficulty 10621) (name dim-sqrt) (type "(-> Dimension (Maybe Dimension))") (description "Square root of dimension (all exponents must be even).") (notes ()) (section dimension-arithmetic) (deps (\x27;prelude)) (available (make-dim dim-length dim-time dim-mass dim-current dim-temperature dim-amount dim-luminosity dim? dim=? dim-one dim-length-base dim-time-base dim-mass-base dim-current-base dim-temperature-base dim-amount-base dim-luminosity-base dim* dim/ dim-pow)) (answer "(define (dim-sqrt d) (if (andmap even? d) (map (lambda (e) (quotient e 2)) d) #f))"))
(task-entry (id "fp/cost-analysis/suggested-parallelism") (skill fp) (module cost-analysis) (tier 1) (difficulty 10621) (name suggested-parallelism) (type "(-> (List Expr) Nat)") (description "Suggest optimal number of parallel tasks for a workload.\nReturns 1 for sequential, or N for N-way parallelism.") (notes ()) (section parallelization-decision) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost *form-costs* form-cost *estimate-work-fuel* estimate-work estimate-work-with-fuel estimate-let-work estimate-branch-work estimate-cond-work estimate-hof-work estimate-list-size parallel-beneficial? parallel-beneficial-n?)) (answer "(define (suggested-parallelism exprs) (let* ((works (map estimate-work exprs)) (total-work (fold-left + 0 works)) (n (length exprs))) (cond ((< total-work *min-parallel-work*) 1) ((<= n 1) 1) (else (let* ((avg-work (quotient total-work n)) (viable-tasks (length (filter (lambda (w) (> w (quotient *parallel-overhead* 2))) works)))) (max 1 viable-tasks))))))"))
