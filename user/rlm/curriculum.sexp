(task-entry (id "tiles/square/square-distance-euclidean") (skill tiles) (module square) (tier 1) (difficulty 12310) (name square-distance-euclidean) (type "(-> Coord Coord Real)") (description "Euclidean distance (L2 metric) - Used for: straight-line distance, range calculations") (notes ()) (section distance-metrics) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho square-neighbors-diag square-neighbors-all square-neighbors square-distance-manhattan square-distance-chebyshev)) (answer "(define (square-distance-euclidean c1 c2) (euclidean-distance (coord-x c1) (coord-y c1) (coord-x c2) (coord-y c2)))"))
(task-entry (id "tiles/hex/hex-neighbors-at-distance") (skill tiles) (module hex) (tier 1) (difficulty 12310) (name hex-neighbors-at-distance) (type "(-> AxialCoord Integer (List AxialCoord))") (description "Get all hexes at exactly N steps away (ring)") (notes ()) (section neighbors) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial hex-axial-directions hex-neighbor hex-neighbors)) (answer "(define (hex-neighbors-at-distance center distance) (if (= distance 0) (list center) (let* ((cc (axial->cubic center)) (x (cubic-coord%-x cc)) (y (cubic-coord%-y cc)) (z (cubic-coord%-z cc))) (let* ((start-cube (cubic-coord (+ x distance) (- y distance) z)) (directions '((0 -1 1) (-1 0 1) (-1 1 0) (0 1 -1) (1 0 -1) (1 -1 0)))) (let loop ((current start-cube) (dir-idx 0) (step 0) (results '())) (if (>= dir-idx 6) (map cubic->axial results) (if (>= step distance) (loop current (+ dir-idx 1) 0 results) (let* ((dir (list-ref directions dir-idx)) (next (cubic-coord (+ (cubic-coord%-x current) (list-ref dir 0)) (+ (cubic-coord%-y current) (list-ref dir 1)) (+ (cubic-coord%-z current) (list-ref dir 2))))) (loop next dir-idx (+ step 1) (cons current results))))))))))"))
(task-entry (id "tiles/triangle/triangle-neighbors-all") (skill tiles) (module triangle) (tier 1) (difficulty 12310) (name triangle-neighbors-all) (type "(-> TriangleCoord (List TriangleCoord))") (description "Get all neighbors (edge + vertex + flip)") (notes ()) (section neighbors) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge triangle-neighbors-vertex)) (answer "(define (triangle-neighbors-all t) (append (triangle-neighbors-edge t) (triangle-neighbors-vertex t) (list (triangle-flip t))))"))
(task-entry (id "tiles/pathfinding/find-path-bfs") (skill tiles) (module pathfinding) (tier 1) (difficulty 12310) (name find-path-bfs) (type "(-> Board Coord Coord (-> Coord (List Coord)) (Maybe (List Coord)))") (description "Find path on board using BFS") (notes ()) (section board-integration) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert pqueue-pop reconstruct-path bfs-path dijkstra-path astar-path board-walkable? board-cost)) (answer "(define (find-path-bfs board start goal neighbor-fn) (bfs-path start goal neighbor-fn (lambda (c) (board-walkable? board c))))"))
