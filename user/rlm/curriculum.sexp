(task-entry (id "autodiff/typed-gradients/validate-gradient-spec") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12733) (name validate-gradient-spec) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix safe-hessian scalar-fn vector-fn t-gradient t-gradient-fn t-jacobian t-jacobian-fn t-hessian t-hessian-fn infer-gradient-dim)) (answer "(define (validate-gradient-spec spec test-args) (if (not (gradient-spec? spec)) (list 'error 'invalid-spec) (let ((result (safe-gradient spec test-args))) (dim-gradient-ok? result))))"))
(task-entry (id "autodiff/interval-autodiff/reduce-box-by-monotonicity") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12733) (name reduce-box-by-monotonicity) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp iv-traced-log iv-traced-sin iv-traced-cos iv-traced-pow interval-backward interval-gradient gradient-sign monotonicity-info all-monotonic? any monotonic-dimension)) (answer "(define (reduce-box-by-monotonicity box grad-intervals) (let loop ((box box) (grads grad-intervals) (idx 0) (new-box '())) (cond ((null? box) (reverse new-box)) (else (let* ((iv (car box)) (grad (car grads)) (sign (gradient-sign grad))) (case sign ((positive) (loop (cdr box) (cdr grads) (+ idx 1) (cons (interval-singleton (interval-lo iv)) new-box))) ((negative) (loop (cdr box) (cdr grads) (+ idx 1) (cons (interval-singleton (interval-hi iv)) new-box))) (else (loop (cdr box) (cdr grads) (+ idx 1) (cons iv new-box)))))))))"))
(task-entry (id "autodiff/higher-order-diff/jet-pad-coeffs") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12734) (name jet-pad-coeffs) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin rec-cos)) (answer "(define (jet-pad-coeffs v1 v2) (let* ((n1 (vector-length v1)) (n2 (vector-length v2)) (n (max n1 n2)) (pad (lambda (v len) (if (= len (vector-length v)) v (let ((result (make-vector len 0))) (do ((i 0 (+ i 1))) ((= i (vector-length v)) result) (vector-set! result i (vector-ref v i)))))))) (values (pad v1 n) (pad v2 n) n)))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-reverse-tape?") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12734) (name sparse-reverse-tape?) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern sparse-jvp sparse-vjp sparse-hessian sparse-hessian-exact sparse-hessian-vector-product sparse-traced sparse-traced? sparse-traced-value sparse-traced-id sparse-traced-tape make-sparse-reverse-tape)) (answer "(define (sparse-reverse-tape? t) (and (pair? t) (eq? (car t) 'sparse-reverse-tape)))"))
(task-entry (id "autodiff/typed-gradients/format-gradient-error") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12734) (name format-gradient-error) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix safe-hessian scalar-fn vector-fn t-gradient t-gradient-fn t-jacobian t-jacobian-fn t-hessian t-hessian-fn infer-gradient-dim validate-gradient-spec)) (answer "(define (format-gradient-error err) (if (and (pair? err) (eq? (car err) 'error)) (let ((kind (cadr err))) (case kind ((dimension-mismatch) (let ((expected (caddr err)) (got (cadddr err))) (format \"Dimension mismatch: expected ~a components, got ~a\" (cadr expected) (cadr got)))) ((input-dimension-mismatch) (let ((expected (caddr err)) (got (cadddr err))) (format \"Input dimension mismatch: function expects ~a arguments, got ~a\" (cadr expected) (cadr got)))) ((not-a-scalar-function) (format \"Not a scalar function: output dimension is ~a (expected 1)\" (cadr (caddr err)))) ((index-out-of-bounds) (let ((index (caddr err)) (dim (cadddr err))) (format \"Index ~a out of bounds for gradient of dimension ~a\" (cadr index) (cadr dim)))) (else (format \"Gradient error: ~s\" err)))) (format \"Unknown error: ~s\" err)))"))
(task-entry (id "autodiff/interval-autodiff/with-monotonicity-pruning") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12734) (name with-monotonicity-pruning) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp iv-traced-log iv-traced-sin iv-traced-cos iv-traced-pow interval-backward interval-gradient gradient-sign monotonicity-info all-monotonic? any monotonic-dimension reduce-box-by-monotonicity)) (answer "(define (with-monotonicity-pruning f-interval grad-fn) (lambda (box) (let* ((grad-ivs (grad-fn box)) (reduced-box (reduce-box-by-monotonicity box grad-ivs))) (f-interval reduced-box))))"))
(task-entry (id "autodiff/higher-order-diff/jet-add") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12735) (name jet-add) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin rec-cos jet-pad-coeffs)) (answer "(define (jet-add a b) (let* ((a (jet-lift a)) (b (jet-lift b)) (ca (jet-coeffs a)) (cb (jet-coeffs b))) (let-values (((pa pb n) (jet-pad-coeffs ca cb))) (let ((result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) (jet (vector->list result))) (vector-set! result i (rec-add (vector-ref pa i) (vector-ref pb i))))))))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-tape-entries") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12735) (name sparse-tape-entries) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern sparse-jvp sparse-vjp sparse-hessian sparse-hessian-exact sparse-hessian-vector-product sparse-traced sparse-traced? sparse-traced-value sparse-traced-id sparse-traced-tape make-sparse-reverse-tape sparse-reverse-tape?)) (answer "(define (sparse-tape-entries t) (unbox (cadr t)))"))
(task-entry (id "autodiff/typed-gradients/TC-DimDifferentiable") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12735) (name TC-DimDifferentiable) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix safe-hessian scalar-fn vector-fn t-gradient t-gradient-fn t-jacobian t-jacobian-fn t-hessian t-hessian-fn infer-gradient-dim validate-gradient-spec format-gradient-error)) (answer "(define TC-DimDifferentiable (quasiquote (typeclass DimDifferentiable (kind (* Nat) Constraint) (supers ()) (methods ((dim forall (d n) (=> (DimDifferentiable d n) (-> d Nat))) (gradientOf forall (d n) (=> (DimDifferentiable d n) (-> d (-> (Vec n Number) (DimGradient n))))))))))"))
(task-entry (id "autodiff/higher-order-diff/jet-sub") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12736) (name jet-sub) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin rec-cos jet-pad-coeffs jet-add)) (answer "(define (jet-sub a b) (let* ((a (jet-lift a)) (b (jet-lift b)) (ca (jet-coeffs a)) (cb (jet-coeffs b))) (let-values (((pa pb n) (jet-pad-coeffs ca cb))) (let ((result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) (jet (vector->list result))) (vector-set! result i (rec-sub (vector-ref pa i) (vector-ref pb i))))))))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-tape-push!") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12736) (name sparse-tape-push!) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern sparse-jvp sparse-vjp sparse-hessian sparse-hessian-exact sparse-hessian-vector-product sparse-traced sparse-traced? sparse-traced-value sparse-traced-id sparse-traced-tape make-sparse-reverse-tape sparse-reverse-tape? sparse-tape-entries)) (answer "(define (sparse-tape-push! tape entry) (set-box! (cadr tape) (cons entry (unbox (cadr tape)))))"))
