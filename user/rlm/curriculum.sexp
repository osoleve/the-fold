(task-entry (id "physics/classical/constraint-graph/toposort-dag") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23524) (name toposort-dag) (type "") (description "") (notes ()) (section toposort) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints)) (answer "(define (toposort-dag adj) (let* ((n (vector-length adj)) (in-degree (make-vector n 0)) (result '())) (let loop ((i 0)) (when (< i n) (for-each (lambda (j) (vector-set! in-degree j (+ 1 (vector-ref in-degree j)))) (vector-ref adj i)) (loop (+ i 1)))) (let ((queue (let loop ((i 0) (q '())) (if (>= i n) q (if (= 0 (vector-ref in-degree i)) (loop (+ i 1) (cons i q)) (loop (+ i 1) q)))))) (let process ((q queue)) (unless (null? q) (let ((node (car q)) (rest (cdr q))) (set! result (cons node result)) (let ((new-queue (fold-left (lambda (q neighbor) (let ((new-deg (- (vector-ref in-degree neighbor) 1))) (vector-set! in-degree neighbor new-deg) (if (= new-deg 0) (cons neighbor q) q))) rest (vector-ref adj node)))) (process new-queue))))) (if (= (length result) n) (reverse result) #f))))"))
