(task-entry (id "autodiff/traced-optics/optimize-at") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12710) (name optimize-at) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value untrace-value lift-at-optic traversal-over-indexed optic-gradient extract-gradient zero-like optic-gradient-list optic-gradient-maybe grad-at)) (answer "(define (optimize-at optic s loss-fn rate) (let ((otype (optic-type optic))) (case otype ((lens iso affine) (let ((grad (optic-gradient loss-fn optic s)) (focus (view optic s))) (set-lens optic (subtract-scaled focus grad rate) s))) ((traversal) (optimize-traversal optic s loss-fn rate)) ((prism) (let ((maybe-grad (optic-gradient-maybe loss-fn optic s))) (if (nothing? maybe-grad) s (let ((grad (from-just maybe-grad)) (focus (from-just (preview optic s)))) (review optic (subtract-scaled focus grad rate)))))) (else (error 'optimize-at \"Unsupported optic type for optimization\" otype)))))"))
(task-entry (id "autodiff/higher-order-diff/second-derivative") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12711) (name second-derivative) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative)) (answer "(define (second-derivative f x) (let ((h (hessian (lambda (x) (f x)) (list x)))) (matrix-ref h 0 0)))"))
(task-entry (id "autodiff/differentiable/d-pow") (skill autodiff) (module differentiable) (tier 1) (difficulty 12711) (name d-pow) (type "") (description "") (notes ()) (section differentiable-typeclass) (deps (\x27;prelude \x27;kinds \x27;infer \x27;resolve \x27;comp-graph \x27;reverse-diff)) (available (TC-Differentiable differentiable-real-methods inst-Differentiable-Real differentiable-dual-methods inst-Differentiable-Dual differentiable-traced-methods inst-Differentiable-Traced differentiable-hyperdual-methods inst-Differentiable-Hyperdual differentiable-instances ad-instances)) (answer "(define (d-pow inst x n) (let ((d* (get-method inst 'd*)) (d/ (get-method inst 'd/)) (lift (get-method inst 'lift))) (cond ((= n 0) (lift 1)) ((= n 1) x) ((< n 0) (d/ (lift 1) (d-pow inst x (- n)))) ((even? n) (let ((half (d-pow inst x (/ n 2)))) (d* half half))) (else (d* x (d-pow inst x (- n 1)))))))"))
(task-entry (id "autodiff/differentiable-signal/make-dft-im-local-grads") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12711) (name make-dft-im-local-grads) (type "(-> Int Int (List Number))") (description "") (notes ()) (section traced-dft) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real make-dft-re-local-grads)) (answer "(define (make-dft-im-local-grads n k) (let ((result (make-vector n)) (two-pi (* 2 (pi-value)))) (do ((m 0 (+ m 1))) ((= m n) (vector->list result)) (vector-set! result m (sin (/ (* -1 two-pi k m) n))))))"))
