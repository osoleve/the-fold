(task-entry (id "random/distributions/exponential-pdf") (skill random) (module distributions) (tier 1) (difficulty 12922) (name exponential-pdf) (type "(-> Number Number Number)") (description "Exponential probability density at x") (notes ()) (section exponential-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential)) (answer "(define (exponential-pdf x rate) (if (< x 0) 0 (* rate (exp-num (* (- rate) x)))))"))
