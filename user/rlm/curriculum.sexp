(task-entry (id "data/quadtree/quadtree-knn-rec") (skill data) (module quadtree) (tier 0) (difficulty 1340) (name quadtree-knn-rec) (type "") (description "") (notes ()) (section k-nearest-neighbors) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build quadtree-build-auto list->quadtree quadtree-insert quadtree-insert-at-depth quadtree-split quadtree-range quadtree-range-rect quadtree-radius quadtree-nearest quadtree-nearest-rec bounds-min-dist-sq sort-by-bounds-dist quadtree-knn-pair-greater? quadtree-knn quadtree-knn-heap->list)) (answer "(define (quadtree-knn-rec tree qx qy k-count heap) (cond ((quadtree-empty? tree) heap) ((quadtree-leaf? tree) (fold-left (lambda (h pt) (let* ((dx (- (car pt) qx)) (dy (- (cadr pt) qy)) (dist-sq (+ (* dx dx) (* dy dy))) (current-size (heap-size h)) (threshold (if (or (= current-size 0) (< current-size k-count)) +inf.0 (car (heap-value h))))) (if (< dist-sq threshold) (let ((h2 (heap-insert-by quadtree-knn-pair-greater? (cons dist-sq pt) h))) (if (> (heap-size h2) k-count) (heap-delete-top-by quadtree-knn-pair-greater? h2) h2)) h))) heap (quadtree-leaf-points tree))) ((quadtree-node? tree) (let ((bounds (quadtree-bounds tree)) (current-size (heap-size heap))) (let ((threshold (if (or (= current-size 0) (< current-size k-count)) +inf.0 (car (heap-value heap))))) (if (> (bounds-min-dist-sq bounds qx qy) threshold) heap (let* ((children (list (quadtree-ne tree) (quadtree-nw tree) (quadtree-se tree) (quadtree-sw tree))) (sorted (sort-by-bounds-dist children qx qy))) (fold-left (lambda (h child) (let* ((child-bounds (quadtree-bounds child)) (h-size (heap-size h)) (child-threshold (if (or (= h-size 0) (< h-size k-count)) +inf.0 (car (heap-value h))))) (if (> (bounds-min-dist-sq child-bounds qx qy) child-threshold) h (quadtree-knn-rec child qx qy k-count h)))) heap sorted))))))))"))
(task-entry (id "data/avl-tree/avl-range-by") (skill data) (module avl-tree) (tier 0) (difficulty 1341) (name avl-range-by) (type "(-> (-> κ κ Boolean) κ κ AVL (List (Pair κ α)))") (description "") (notes ()) (section range-queries) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node rotate-left rotate-right rebalance avl-lookup avl-lookup-by avl-contains? avl-contains-by? avl-insert avl-insert-by avl-min-node avl-max-node avl-delete-min avl-delete-min-by avl-delete avl-delete-by avl-min avl-max avl-min-value avl-max-value avl-size avl->list avl-keys avl-values list->avl avl-from-keys avl-fold avl-fold-right avl-map avl-filter avl-range)) (answer "(define (avl-range-by cmp lo hi tree) (if (avl-empty? tree) '() (let ((k (avl-key tree)) (v (avl-value tree))) (append (if (cmp lo k) (avl-range-by cmp lo hi (avl-left tree)) '()) (if (and (not (cmp k lo)) (not (cmp hi k))) (list (cons k v)) '()) (if (cmp k hi) (avl-range-by cmp lo hi (avl-right tree)) '())))))"))
