(task-entry (id "algebra/polynomial/poly-ext-gcd-loop") (skill algebra) (module polynomial) (tier 0) (difficulty 331) (name poly-ext-gcd-loop) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd)) (answer "(define (poly-ext-gcd-loop r0 r1 s0 s1 t0 t1 F) (if (poly-zero? r1) (if (poly-zero? r0) (list r0 s0 t0) (let* ((lc (poly-leading-coeff r0)) (inv-lc (field-inv F lc))) (list (poly-scale r0 inv-lc) (poly-scale s0 inv-lc) (poly-scale t0 inv-lc)))) (let* ((qr (poly-divmod r0 r1)) (q (car qr)) (r2 (cdr qr)) (s2 (poly-sub s0 (poly-mul q s1))) (t2 (poly-sub t0 (poly-mul q t1)))) (poly-ext-gcd-loop r1 r2 s1 s2 t1 t2 F))))"))
(task-entry (id "algebra/multivariate/mpoly-combine-terms") (skill algebra) (module multivariate) (tier 0) (difficulty 331) (name mpoly-combine-terms) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize)) (answer "(define (mpoly-combine-terms terms add eq-fn zero) (if (null? terms) '() (let loop ((ts terms) (acc '())) (if (null? ts) acc (let* ((term (car ts)) (coeff (car term)) (mono (cdr term)) (existing (assoc-mono mono acc))) (if existing (loop (cdr ts) (update-assoc-mono mono (add (car existing) coeff) acc)) (loop (cdr ts) (cons term acc))))))))"))
