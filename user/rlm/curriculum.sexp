(task-entry (id "algebra/multivariate/mpoly-scale") (skill algebra) (module multivariate) (tier 0) (difficulty 348) (name mpoly-scale) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms assoc-mono update-assoc-mono mpoly-zero mpoly-one mpoly-constant mpoly-var mpoly-from-terms mpoly-zero? mpoly-degree mpoly-degree-in mpoly-leading-term mpoly-leading-coeff mpoly-leading-mono mpoly-add mpoly-neg mpoly-sub)) (answer "(define (mpoly-scale p c) (let ((F (mpoly-field p)) (mul (field-mul-op (mpoly-field p)))) (make-mpoly (mpoly-field p) (mpoly-vars p) (mpoly-ordering p) (map (lambda (t) (cons (mul c (car t)) (cdr t))) (mpoly-terms p)))))"))
