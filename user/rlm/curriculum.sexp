(task-entry (id "physics/classical/ascii-renderer/draw-velocity-vector!") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23545) (name draw-velocity-vector!) (type "") (description "") (notes ()) (section debug:) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line! draw-filled-circle! polygon-scanline-intersections fill-between-pairs! draw-filled-polygon! draw-filled-aabb! draw-aabb-outline! fmod angle->arrow-char)) (answer "(define (draw-velocity-vector! frame entity vel-scale config) (let* ((body (entity-body entity)) (pos (if (rigid-body? body) (rigid-body-pos body) (body-pos body))) (vel (if (rigid-body? body) (rigid-body-vel body) (body-vel body))) (speed (vec2-magnitude vel))) (when (> speed 0.5) (let* ((end-pos (vec2-add pos (vec2-scale vel vel-scale))) (start (world->screen pos config)) (end (world->screen end-pos config)) (angle (atan (vec2-y vel) (vec2-x vel))) (arrow-char (angle->arrow-char angle))) (draw-line! frame (car start) (cdr start) (car end) (cdr end) #\\. config) (safe-frame-set! frame (car end) (cdr end) arrow-char config)))))"))
(task-entry (id "physics/classical/collision-detection/shape-aabb") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23546) (name shape-aabb) (type "") (description "") (notes ()) (section generic) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon? closest-point-on-segment circle-polygon-manifold project-polygon project-circle intervals-overlap polygon-polygon? polygon-polygon-manifold shape-type)) (answer "(define (shape-aabb s) (cond ((aabb? s) s) ((circle? s) (circle-aabb s)) ((polygon? s) (polygon-aabb s)) (else (make-aabb (vec2 0 0) (vec2 0 0)))))"))
