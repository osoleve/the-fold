(task-entry (id "random/variational-inference/traced-log-normal-pdf") (skill random) (module variational-inference) (tier 1) (difficulty 12941) (name traced-log-normal-pdf) (type "") (description "") (notes ()) (section traced-log-joint-construction) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced)) (answer "(define (traced-log-normal-pdf z t-mu t-log-sigma) (let* ((const-term (make-traced-const (* -0.5 (log (* 2 3.141592653589793))) #f)) (z-const (make-traced-const z #f)) (diff (traced-sub z-const t-mu)) (diff-sq (traced-mul diff diff)) (var (traced-exp (traced-mul t-log-sigma (make-traced-const 2 #f)))) (mahal (traced-div diff-sq var))) (traced-sub (traced-sub const-term t-log-sigma) (traced-mul (make-traced-const 0.5 #f) mahal))))"))
(task-entry (id "random/prng/random-bytes") (skill random) (module prng) (tier 1) (difficulty 12942) (name random-bytes) (type "") (description "Generate n random bytes using protocol dispatch") (notes ()) (section random-bytes-generation) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float random-float-range random-int-range random-bool random-element shuffle sample weighted-choice random-list random-vector with-random with-random-stream gen-advance gen-split random-split)) (answer "(define (random-bytes n) (if (<= n 0) (state-pure (make-bytevector 0)) (make-state (lambda (gen) (let ((bv (make-bytevector n)) (bytes-per-call (/ (prng-output-bits gen) 8))) (let loop ((i 0) (g gen)) (if (>= i n) (cons bv g) (let* ((r (prng-next g)) (val (car r)) (ng (cdr r))) (let byte-loop ((j 0) (v val)) (if (or (>= (+ i j) n) (>= j bytes-per-call)) (loop (+ i bytes-per-call) ng) (begin (bytevector-u8-set! bv (+ i j) (bitwise-and v 255)) (byte-loop (+ j 1) (ash v -8)))))))))))))"))
