(task-entry (id "linalg/matrix-eigen/eigen-decomposition") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 415) (name eigen-decomposition) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop)) (answer "(define (eigen-decomposition a . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (if (not (= n m)) (quasiquote (error not-square (unquote n) (unquote m))) (let* ((max-iter (if (and (pair? opts) (integer? (car opts))) (car opts) *eigen-max-iterations*)) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (tol (if (and (pair? rest1) (number? (car rest1))) (car rest1) *eigen-tolerance*)) (eigenvalue-result (qr-algorithm-shifted a max-iter tol))) (cond ((and (pair? eigenvalue-result) (eq? (car eigenvalue-result) 'error)) eigenvalue-result) ((and (pair? eigenvalue-result) (eq? (car eigenvalue-result) 'complex-eigenvalues)) eigenvalue-result) (else (let ((eigenvalues eigenvalue-result) (eigenvectors (make-matrix n n 0))) (let loop ((i 0)) (if (= i n) (cons eigenvalues eigenvectors) (let* ((lambda-i (vector-ref eigenvalues i)) (v-i (inverse-iteration a lambda-i (vec-unit n i) max-iter tol))) (if (and (pair? v-i) (eq? (car v-i) 'error)) (quasiquote (error eigenvector-computation-failed (unquote i) (unquote lambda-i))) (begin (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! eigenvectors j i (vector-ref v-i j))) (loop (+ i 1))))))))))))))"))
(task-entry (id "linalg/iterative-solvers/gmres-outer") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 415) (name gmres-outer) (type "") (description "") (notes ()) (section gmres) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres)) (answer "(define (gmres-outer a b restart x total-iter max-iter tol n) (let* ((ax (matrix-vec-mul a x)) (r (vec-sub b ax)) (r-norm (vec-norm r))) (cond ((< r-norm tol) (list x total-iter r-norm)) ((>= total-iter max-iter) (quasiquote (error no-convergence (unquote total-iter) (unquote r-norm)))) (else (let ((result (gmres-arnoldi a b x r r-norm restart tol n))) (if (and (pair? result) (eq? (car result) 'error)) result (let* ((x-new (car result)) (iters (cadr result)) (final-res (caddr result)) (new-total (+ total-iter iters))) (if (< final-res tol) (list x-new new-total final-res) (gmres-outer a b restart x-new new-total max-iter tol n)))))))))"))
