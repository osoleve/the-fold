(task-entry (id "statistics/exponential/holt-damped-forecast") (skill statistics) (module exponential) (tier 1) (difficulty 11212) (name holt-damped-forecast) (type "") (description "") (notes ()) (section simple-exponential-smoothing-ses) (deps (\x27;prelude)) (available (simple-exponential-smooth ses-forecast optimize-ses-alpha holt-smooth holt-forecast holt-fitted holt-winters holt-winters-additive holt-winters-multiplicative hw-forecast hw-fitted holt-damped)) (answer "(define (holt-damped-forecast result h) (let* ((phi (list-ref result 2)) (last-level (list-ref result 5)) (last-trend (list-ref result 6)) (forecasts (make-vector h))) (do ((i 1 (+ i 1))) ((> i h) forecasts) (let ((phi-sum (if (< (abs (- phi 1)) 1e-10) (exact->inexact i) (* phi (/ (- 1 (expt phi i)) (- 1 phi)))))) (vector-set! forecasts (- i 1) (+ last-level (* phi-sum last-trend)))))))"))
(task-entry (id "statistics/forecast/forecast-accuracy") (skill statistics) (module forecast) (tier 1) (difficulty 11212) (name forecast-accuracy) (type "") (description "") (notes ()) (section forecast-accuracy-metrics) (deps (\x27;prelude)) (available (mae mse rmse mape smape mase naive-forecast drift-forecast seasonal-naive-forecast mean-forecast forecast-intervals standard-normal-quantile-approx)) (answer "(define (forecast-accuracy actual forecast) (list 'accuracy-result (cons 'mae (mae actual forecast)) (cons 'mse (mse actual forecast)) (cons 'rmse (rmse actual forecast)) (cons 'mape (mape actual forecast)) (cons 'smape (smape actual forecast))))"))
