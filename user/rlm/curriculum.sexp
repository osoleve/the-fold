(task-entry (id "fp/cost-analysis/estimate-list-size") (skill fp) (module cost-analysis) (tier 1) (difficulty 10618) (name estimate-list-size) (type "(-> Expr Nat)") (description "Heuristically estimate the size of a list expression.\nReturns conservative estimates for unknown cases.") (notes ()) (section work-estimation-engine) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost *form-costs* form-cost *estimate-work-fuel* estimate-work estimate-work-with-fuel estimate-let-work estimate-branch-work estimate-cond-work estimate-hof-work)) (answer "(define (estimate-list-size expr) (cond ((null? expr) 0) ((and (pair? expr) (eq? (car expr) 'quote) (pair? (cdr expr))) (let ((quoted (cadr expr))) (if (list? quoted) (length quoted) 10))) ((and (pair? expr) (eq? (car expr) 'list)) (length (cdr expr))) ((and (pair? expr) (eq? (car expr) 'iota) (pair? (cdr expr)) (number? (cadr expr))) (cadr expr)) ((and (pair? expr) (eq? (car expr) 'range) (pair? (cdr expr)) (number? (cadr expr)) (pair? (cddr expr)) (number? (caddr expr))) (max 0 (- (caddr expr) (cadr expr)))) ((and (pair? expr) (memq (car expr) '(map filter))) (if (and (pair? (cdr expr)) (pair? (cddr expr))) (estimate-list-size (caddr expr)) 10)) (else 10)))"))
