(task-entry (id "physics/classical/collision-detection/make-regular-polygon") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23527) (name make-regular-polygon) (type "") (description "") (notes ()) (section shape) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box)) (answer "(define (make-regular-polygon center radius n) (let* ((angle-step (/ (* 2 3.141592653589793) n)) (verts (let loop ((i 0) (vs '())) (if (>= i n) (reverse vs) (let ((angle (* i angle-step))) (loop (+ i 1) (cons (vec2-add center (vec2 (* radius (cos angle)) (* radius (sin angle)))) vs))))))) (make-polygon verts)))"))
(task-entry (id "physics/classical/collision-response/calculate-impulse-with-rotation") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23527) (name calculate-impulse-with-rotation) (type "") (description "") (notes ()) (section impulse) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material combine-materials velocity-at-point relative-velocity-at relative-velocity normal-velocity-at normal-velocity tangent-velocity get-inv-mass get-inv-inertia get-body-pos)) (answer "(define (calculate-impulse-with-rotation body-a body-b contact normal restitution) (let* ((vel-along-normal (normal-velocity-at body-a body-b contact normal)) (inv-mass-a (get-inv-mass body-a)) (inv-mass-b (get-inv-mass body-b)) (inv-i-a (get-inv-inertia body-a)) (inv-i-b (get-inv-inertia body-b)) (r-a (vec2-sub contact (get-body-pos body-a))) (r-b (vec2-sub contact (get-body-pos body-b))) (rn-a (vec2-cross r-a normal)) (rn-b (vec2-cross r-b normal)) (effective-mass (+ inv-mass-a inv-mass-b (* rn-a rn-a inv-i-a) (* rn-b rn-b inv-i-b)))) (if (> vel-along-normal 0) 0 (if (< effective-mass 1e-4) 0 (/ (* (- (+ 1 restitution)) vel-along-normal) effective-mass)))))"))
