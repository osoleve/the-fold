(task-entry (id "autodiff/differentiable-signal/make-conv-local-grads") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12715) (name make-conv-local-grads) (type "(-> Int Int Int (Vector Number) Symbol (List Number))") (description "") (notes ()) (section traced-convolution) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real make-dft-re-local-grads make-dft-im-local-grads diff-dft diff-convolution traced-convolve-1d)) (answer "(define (make-conv-local-grads i n m kernel mode) (let ((grads (make-vector n 0))) (case mode ((full) (do ((j 0 (+ j 1))) ((= j n) (vector->list grads)) (let ((k-idx (- i j))) (when (and (>= k-idx 0) (< k-idx m)) (vector-set! grads j (vector-ref kernel k-idx)))))) ((same) (let ((offset (quotient m 2))) (do ((j 0 (+ j 1))) ((= j n) (vector->list grads)) (let ((k-idx (- (+ i offset) j))) (when (and (>= k-idx 0) (< k-idx m)) (vector-set! grads j (vector-ref kernel k-idx))))))) ((valid) (do ((j 0 (+ j 1))) ((= j n) (vector->list grads)) (let ((k-idx (- (+ i (- m 1)) j))) (when (and (>= k-idx 0) (< k-idx m) (>= (+ i j) 0) (< (+ i j) n)) (vector-set! grads j (vector-ref kernel k-idx)))))) (else (vector->list grads)))))"))
