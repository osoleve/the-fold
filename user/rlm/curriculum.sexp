(task-entry (id "game-theory/coop-games/random-permutation") (skill game-theory) (module coop-games) (tier 1) (difficulty 13251) (name random-permutation) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky make-additive-game make-unanimity-game make-weighted-voting-game make-airport-game make-bankruptcy-game make-gloves-game coop-game-superadditive? coop-game-convex? coop-game-monotonic? coop-game-simple? is-winning? is-blocking? is-pivotal? banzhaf-index)) (answer "(define (random-permutation n) (let ((v (make-vector n))) (do ((i 0 (+ i 1))) ((>= i n)) (vector-set! v i i)) (do ((i (- n 1) (- i 1))) ((< i 1) v) (let* ((j (random (+ i 1))) (tmp (vector-ref v i))) (vector-set! v i (vector-ref v j)) (vector-set! v j tmp)))))"))
(task-entry (id "game-theory/fair-division/maximin-search-greedy") (skill game-theory) (module fair-division) (tier 1) (difficulty 13251) (name maximin-search-greedy) (type "") (description "") (notes ()) (section discrete-fair-division) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax make-adjusted-winner-problem adjusted-winner equalize-allocations transfer-to-equalize transfer-loop update-fraction remove-good format-allocation make-discrete-problem discrete-problem-players discrete-problem-goods-count discrete-problem-valuation round-robin discrete-allocation-value envy-free-up-to-one? maximin-share)) (answer "(define (maximin-search-greedy dp player num-bundles goods) (if (null? goods) 0 (let* ((bundles (make-vector num-bundles '())) (vals (make-vector num-bundles 0)) (sorted-goods (sort-by (lambda (j1 j2) (> (discrete-problem-valuation dp player j1) (discrete-problem-valuation dp player j2))) goods))) (for-each (lambda (g) (let* ((min-idx (argmin (vector->list vals))) (g-val (discrete-problem-valuation dp player g))) (vector-set! bundles min-idx (cons g (vector-ref bundles min-idx))) (vector-set! vals min-idx (+ (vector-ref vals min-idx) g-val)))) sorted-goods) (apply min (vector->list vals)))))"))
(task-entry (id "game-theory/coop-games/shapley-value-sample") (skill game-theory) (module coop-games) (tier 1) (difficulty 13252) (name shapley-value-sample) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky make-additive-game make-unanimity-game make-weighted-voting-game make-airport-game make-bankruptcy-game make-gloves-game coop-game-superadditive? coop-game-convex? coop-game-monotonic? coop-game-simple? is-winning? is-blocking? is-pivotal? banzhaf-index random-permutation)) (answer "(define (shapley-value-sample game num-samples fuel) (let* ((n (coop-game-players game)) (sums (make-vector n 0.0))) (if (= n 0) sums (begin (do ((sample 0 (+ sample 1))) ((>= sample num-samples)) (let ((perm (random-permutation n))) (let loop ((i 0) (coalition 0)) (when (< i n) (let* ((agent-idx (vector-ref perm i)) (with-agent (bitwise-ior coalition (bitwise-arithmetic-shift-left 1 agent-idx))) (v-with (coop-game-value game with-agent)) (v-without (if (= coalition 0) 0 (coop-game-value game coalition))) (marginal (- v-with v-without))) (vector-set! sums agent-idx (+ (vector-ref sums agent-idx) marginal)) (loop (+ i 1) with-agent)))))) (let* ((avg-values (let ((v (make-vector n 0.0))) (do ((i 0 (+ i 1))) ((>= i n) v) (vector-set! v i (/ (vector-ref sums i) num-samples))))) (total (let loop ((i 0) (sum 0)) (if (>= i n) sum (loop (+ i 1) (+ sum (vector-ref avg-values i))))))) (if (= total 0) (let ((equal-share (/ 1.0 n))) (do ((i 0 (+ i 1))) ((>= i n) avg-values) (vector-set! avg-values i equal-share))) (begin (do ((i 0 (+ i 1))) ((>= i n) avg-values) (vector-set! avg-values i (/ (vector-ref avg-values i) total))))))))))"))
