(task-entry (id "game-theory/voting-games/power-gini") (skill game-theory) (module voting-games) (tier 1) (difficulty 13216) (name power-gini) (type "") (description "") (notes ()) (section power-analysis) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison power-concentration)) (answer "(define (power-gini power-vec) (let* ((n (vector-length power-vec)) (sorted (sort-by < (vector->list power-vec))) (total (apply + sorted))) (if (or (= n 0) (= total 0)) 0 (let loop ((items sorted) (i 1) (numerator 0)) (if (null? items) (/ numerator (* n total)) (loop (cdr items) (+ i 1) (+ numerator (* (- (* 2 i) n 1) (car items)))))))))"))
