(task-entry (id "fp/cost-analysis/estimate-let-work") (skill fp) (module cost-analysis) (tier 1) (difficulty 10614) (name estimate-let-work) (type "(-> Expr Nat Nat)") (description "Estimate work for let/let*/letrec forms.") (notes ()) (section work-estimation-engine) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost *form-costs* form-cost *estimate-work-fuel* estimate-work estimate-work-with-fuel)) (answer "(define (estimate-let-work expr fuel) (let* ((form (car expr)) (bindings-and-body (cdr expr)) (bindings (if (and (pair? bindings-and-body) (pair? (car bindings-and-body)) (pair? (caar bindings-and-body))) (car bindings-and-body) '())) (body (if (pair? bindings-and-body) (cdr bindings-and-body) '())) (binding-cost (fold-left + 0 (map (lambda (b) (if (and (pair? b) (>= (length b) 2)) (estimate-work-with-fuel (cadr b) (- fuel 1)) 0)) bindings))) (body-cost (fold-left + 0 (map (lambda (e) (estimate-work-with-fuel e (- fuel 1))) body)))) (+ (form-cost form) binding-cost body-cost)))"))
