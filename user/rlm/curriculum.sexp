(task-entry (id "fp/cost-analysis/*form-costs*") (skill fp) (module cost-analysis) (tier 1) (difficulty 10609) (name *form-costs*) (type "Alist") (description "Base costs for different expression forms.") (notes ()) (section expression-form-costs) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost)) (answer "(define *form-costs* '((lambda . 5) (fn . 5) (let . 3) (let* . 4) (letrec . 6) (if . 2) (cond . 3) (case . 4) (and . 1) (or . 1) (begin . 1) (quote . 1) (quasiquote . 5) (set! . 3) (define . 5)))"))
(task-entry (id "fp/rule/metavar?") (skill fp) (module rule) (tier 1) (difficulty 10609) (name metavar?) (type "(-> Any Boolean)") (description "Check if pattern element is a metavariable.\nMetavariables are lists starting with a ?-prefixed symbol.") (notes ()) (section metavariable-detection) (deps (\x27;prelude)) (available (get-opt make-rule rule? rule-name rule-lhs rule-rhs rule-category rule-direction rule-conditions)) (answer "(define (metavar? x) (and (pair? x) (symbol? (car x)) (let ((s (symbol->string (car x)))) (and (> (string-length s) 0) (char=? (string-ref s 0) #\\?)))))"))
