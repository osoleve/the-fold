(task-entry (id "numeric/fem/apply-dirichlet-bc!") (skill numeric) (module fem) (tier 0) (difficulty 2518) (name apply-dirichlet-bc!) (type "") (description "") (notes ()) (section boundary) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes)) (answer "(define (apply-dirichlet-bc! K F boundary-nodes g mesh) (let* ((n (sparse-coo-rows K)) (bc-set (make-hashtable equal-hash equal?)) (bc-values (make-vector n 0.0)) (rows (sparse-coo-row-indices K)) (cols (sparse-coo-col-indices K)) (vals (sparse-coo-values K)) (nnz (vector-length rows))) (for-each (lambda (i) (let ((p (fem-mesh-node mesh i))) (hashtable-set! bc-set i #t) (vector-set! bc-values i (g (point2-x p) (point2-y p))))) boundary-nodes) (for-each (lambda (i) (let ((g-val (vector-ref bc-values i)) (diag-found #f)) (do ((k 0 (+ k 1))) ((= k nnz)) (when (= (vector-ref rows k) i) (if (= (vector-ref cols k) i) (begin (vector-set! vals k 1.0) (set! diag-found #t)) (vector-set! vals k 0.0)))) (do ((k 0 (+ k 1))) ((= k nnz)) (let ((row (vector-ref rows k)) (col (vector-ref cols k)) (val (vector-ref vals k))) (when (and (= col i) (not (= row i)) (not (hashtable-ref bc-set row #f))) (vector-set! F row (- (vector-ref F row) (* val g-val))) (vector-set! vals k 0.0)))) (vector-set! F i g-val))) boundary-nodes)))"))
