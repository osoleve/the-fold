(task-entry (id "statistics/linear/weighted-linear-fit") (skill statistics) (module linear) (tier 1) (difficulty 11207) (name weighted-linear-fit) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit linear-model-compute-diagnostics compute-coefficient-se compute-t-values compute-p-values compute-r-squared compute-adj-r-squared)) (answer "(define (weighted-linear-fit X y weights) (let* ((n (matrix-rows X)) (p (matrix-cols X))) (if (or (not (= n (vector-length y))) (not (= n (vector-length weights)))) (list 'error 'dimension-mismatch n (vector-length y)) (let* ((X-weighted (weight-matrix X weights)) (y-weighted (weight-vector y weights)) (beta (matrix-least-squares X-weighted y-weighted))) (if (and (pair? beta) (eq? (car beta) 'error)) beta (weighted-diagnostics X y beta weights n p))))))"))
(task-entry (id "statistics/regularized/lasso-finalize") (skill statistics) (module regularized) (tier 1) (difficulty 11207) (name lasso-finalize) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics compute-r-squared-ridge lasso-fit lasso-coordinate-descent lasso-partial-residual soft-threshold)) (answer "(define (lasso-finalize X y beta n p) (let* ((fitted (matrix-vec-mul X beta)) (residuals (make-vector n)) (sse 0)) (do ((i 0 (+ i 1))) ((= i n)) (let ((r (- (vector-ref y i) (vector-ref fitted i)))) (vector-set! residuals i r) (set! sse (+ sse (* r r))))) (let* ((df-residual (- n (count-nonzero beta))) (mse (if (> df-residual 0) (/ sse df-residual) 0)) (r-squared (compute-r-squared-ridge y fitted)) (se (make-vector p 0)) (t-values (make-vector p 0)) (p-values (make-vector p 1))) (make-linear-model-result beta se t-values p-values r-squared r-squared residuals fitted sse mse n p))))"))
