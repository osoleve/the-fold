(task-entry (id "autodiff/traced-optics/untrace-value") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12701) (name untrace-value) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value)) (answer "(define (untrace-value v) (cond ((traced? v) (traced-value v)) ((traced-vec2? v) (unpack-traced-vec2 v)) ((and (pair? v) (not (list? v))) (cons (untrace-value (car v)) (untrace-value (cdr v)))) ((list? v) (map untrace-value v)) (else v)))"))
(task-entry (id "autodiff/higher-order-diff/jacobian-forward") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12702) (name jacobian-forward) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse)) (answer "(define (jacobian-forward f args n m) (let ((result (make-vector (* m n) 0))) (do ((j 0 (+ j 1))) ((= j n) (list 'matrix m n result)) (let* ((dual-args (let loop ((xs args) (k 0)) (if (null? xs) '() (cons (if (= k j) (dual-variable (car xs)) (dual-lift (car xs))) (loop (cdr xs) (+ k 1)))))) (outputs (apply f dual-args))) (if (or (dual? outputs) (not (list? outputs))) (vector-set! result j (dual-deriv outputs)) (do ((i 0 (+ i 1)) (outs outputs (cdr outs))) ((= i m)) (vector-set! result (+ (* i n) j) (dual-deriv (car outs)))))))))"))
