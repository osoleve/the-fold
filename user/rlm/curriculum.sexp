(task-entry (id "random/bayesian/gamma-posterior-variance") (skill random) (module bayesian) (tier 1) (difficulty 12921) (name gamma-posterior-variance) (type "") (description "") (notes ()) (section conjugate-prior-gamma-poisson) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean)) (answer "(define (gamma-posterior-variance prior) (let ((alpha (gamma-prior-shape prior)) (beta (gamma-prior-rate prior))) (/ alpha (* beta beta))))"))
