(task-entry (id "algebra/polynomial/poly-equal?") (skill algebra) (module polynomial) (tier 0) (difficulty 322) (name poly-equal?) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power)) (answer "(define (poly-equal? p1 p2) (let* ((F (poly-field p1)) (eq-fn (field-equal-fn F)) (c1 (poly-coeffs p1)) (c2 (poly-coeffs p2))) (and (= (length c1) (length c2)) (let loop ((l1 c1) (l2 c2)) (or (null? l1) (and (eq-fn (car l1) (car l2)) (loop (cdr l1) (cdr l2))))))))"))
(task-entry (id "algebra/multivariate/make-ordering") (skill algebra) (module multivariate) (tier 0) (difficulty 322) (name make-ordering) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex)) (answer "(define (make-ordering type vars) (case type ((lex) (lambda (m1 m2) (mono-compare-lex m1 m2 vars))) ((grlex deglex) (lambda (m1 m2) (mono-compare-grlex m1 m2 vars))) ((grevlex degrevlex) (lambda (m1 m2) (mono-compare-grevlex m1 m2 vars))) (else (error 'make-ordering \"unknown ordering type\" type))))"))
