(task-entry (id "geometry/voronoi/find-unbounded-sites") (skill geometry) (module voronoi) (tier 1) (difficulty 12223) (name find-unbounded-sites) (type "") (description "") (notes ()) (section construction) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell voronoi-diagram)) (answer "(define (find-unbounded-sites edge-adj sites) (let ((n (vector-length sites)) (unbounded (make-vector (vector-length sites) #f))) (let-values (((keys vals) (hashtable-entries edge-adj))) (do ((i 0 (+ i 1))) ((>= i (vector-length keys)) unbounded) (let ((tri-list (vector-ref vals i))) (when (= (length tri-list) 1) (let* ((ek (vector-ref keys i)) (edge-pts (edge-key->points ek)) (s1 (find-site-index sites (car edge-pts))) (s2 (find-site-index sites (cdr edge-pts)))) (when (>= s1 0) (vector-set! unbounded s1 #t)) (when (>= s2 0) (vector-set! unbounded s2 #t)))))))))"))
