(task-entry (id "egraph/egraph/egraph-pop-dirty!") (skill egraph) (module egraph) (tier 1) (difficulty 10016) (name egraph-pop-dirty!) (type "") (description "") (notes ()) (section worklist) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty!)) (answer "(define (egraph-pop-dirty! eg) (let ((ht (egraph-dirty-set eg))) (if (zero? (hashtable-size ht)) #f (let ((keys (hashtable-keys ht))) (let ((id (vector-ref keys 0))) (hashtable-delete! ht id) id)))))"))
(task-entry (id "egraph/match/pattern-apply") (skill egraph) (module match) (tier 1) (difficulty 10016) (name pattern-apply) (type "(-> Substitution Pattern Term)") (description "Apply substitution to pattern, yielding a term with e-class refs.") (notes ()) (section application) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref eclass-ref? eclass-ref-id)) (answer "(define (pattern-apply subst pattern) (cond ((pattern-var? pattern) (let ((binding (subst-lookup subst pattern))) (if binding (make-eclass-ref binding) (error 'pattern-apply \"Unbound pattern variable\" pattern)))) ((pair? pattern) (cons (car pattern) (map (lambda (p) (pattern-apply subst p)) (cdr pattern)))) (else pattern)))"))
(task-entry (id "egraph/saturation/saturate") (skill egraph) (module saturation) (tier 1) (difficulty 10016) (name saturate) (type "(-> EGraph (List Rule) SaturationConfig SaturationResult)") (description "Run equality saturation. Returns result with status.") (notes ()) (section loop) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated?)) (answer "(define (saturate eg rules config) (let ((fuel (config-fuel config)) (node-limit (config-node-limit config)) (iter-limit (config-iter-limit config))) (let loop ((iteration 0) (total-applied 0)) (cond ((and (> fuel 0) (>= iteration fuel)) (make-saturation-result 'fuel-exhausted iteration total-applied (egraph-class-count eg) (egraph-node-count eg))) ((and (> node-limit 0) (> (egraph-node-count eg) node-limit)) (make-saturation-result 'node-limit iteration total-applied (egraph-class-count eg) (egraph-node-count eg))) (else (let ((applied (saturate-iteration eg rules iter-limit))) (egraph-saturate-rebuild! eg) (cond ((zero? applied) (make-saturation-result 'saturated iteration total-applied (egraph-class-count eg) (egraph-node-count eg))) ((and (> iter-limit 0) (>= applied iter-limit)) (make-saturation-result 'iter-limit (+ iteration 1) (+ total-applied applied) (egraph-class-count eg) (egraph-node-count eg))) (else (loop (+ iteration 1) (+ total-applied applied))))))))))"))
