(task-entry (id "egraph/match/subst->string") (skill egraph) (module match) (tier 1) (difficulty 10024) (name subst->string) (type "(-> Substitution String)") (description "Convert substitution to string for debugging.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref eclass-ref? eclass-ref-id pattern-apply make-rule rule-lhs rule-rhs rule? apply-rule add-instantiated-term apply-rules)) (answer "(define (subst->string subst) (if (null? subst) \"{}\" (string-append \"{\" (apply string-append (map (lambda (binding) (format \"~a→e~a \" (car binding) (cdr binding))) subst)) \"}\")))"))
(task-entry (id "egraph/saturation/basic-arith-rules") (skill egraph) (module saturation) (tier 1) (difficulty 10024) (name basic-arith-rules) (type "") (description "") (notes ()) (section rulesets) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate saturate-iteration saturate-simple saturate-with-fuel arith-identity-rules arith-comm-rules arith-assoc-rules arith-distrib-rules)) (answer "(define basic-arith-rules (append arith-identity-rules arith-comm-rules))"))
(task-entry (id "egraph/scheduler/make-backoff-scheduler") (skill egraph) (module scheduler) (tier 1) (difficulty 10024) (name make-backoff-scheduler) (type "(-> Scheduler)") (description "Create a backoff scheduler.") (notes ()) (section backoff) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost*)) (answer "(define (make-backoff-scheduler) (make-scheduler 'backoff (lambda (rules) (map make-rule-stats rules)) (lambda (state eg) (let* ((active-stats (filter (lambda (s) (should-run? s)) state)) (rules (map stats-rule active-stats))) (cons state (uf-roots (egraph-uf eg))))) (lambda (state rule matches) (let ((stats (find-stats state rule))) (when stats (update-stats! stats matches))) state)))"))
