(task-entry (id "physics/classical/constraint-graph/build-constraint-conflicts") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23526) (name build-constraint-conflicts) (type "") (description "") (notes ()) (section coloring) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints toposort-dag cg-color-constraints)) (answer "(define (build-constraint-conflicts graph constraints) (let* ((n (length constraints)) (adj (make-vector n '())) (id->idx (make-hashtable equal-hash equal?))) (let loop ((cs constraints) (i 0)) (unless (null? cs) (hashtable-set! id->idx (constraint-id (car cs)) i) (loop (cdr cs) (+ i 1)))) (for-each (lambda (entity) (let ((entity-constraints (cg-constraints-for graph entity))) (for-each (lambda (c1) (let ((i (hashtable-ref id->idx (constraint-id c1) #f))) (when i (for-each (lambda (c2) (let ((j (hashtable-ref id->idx (constraint-id c2) #f))) (when (and j (not (= i j))) (unless (member j (vector-ref adj i)) (vector-set! adj i (cons j (vector-ref adj i))))))) entity-constraints)))) entity-constraints))) (cg-entities graph)) adj))"))
