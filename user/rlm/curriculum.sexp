(task-entry (id "statistics/t-test/t-test-two-sample-equal") (skill statistics) (module t-test) (tier 1) (difficulty 11203) (name t-test-two-sample-equal) (type "") (description "") (notes ()) (section one-sample-t-test) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;stat/distributions)) (available (t-test-one-sample t-test-one-sample-list t-test-two-sample)) (answer "(define (t-test-two-sample-equal xs ys confidence) (let* ((n1 (vector-length xs)) (n2 (vector-length ys)) (x-bar (vec-mean xs)) (y-bar (vec-mean ys)) (s1-sq (vec-variance xs)) (s2-sq (vec-variance ys)) (s-pooled-sq (/ (+ (* (- n1 1) s1-sq) (* (- n2 1) s2-sq)) (+ n1 n2 -2))) (s-pooled (sqrt s-pooled-sq)) (se (* s-pooled (sqrt (+ (/ 1 n1) (/ 1 n2))))) (diff (- x-bar y-bar)) (t-stat (/ diff se)) (df (+ n1 n2 -2)) (p-value (t-pvalue-two-tailed t-stat df)) (t-crit (t-quantile (+ 0.5 (/ confidence 2)) df)) (ci-lower (- diff (* t-crit se))) (ci-upper (+ diff (* t-crit se))) (effect-size (/ diff s-pooled))) (make-test-result 't-test-two-sample-equal t-stat df p-value (cons ci-lower ci-upper) effect-size)))"))
(task-entry (id "statistics/chi-squared/chi-squared-test-independence") (skill statistics) (module chi-squared) (tier 1) (difficulty 11203) (name chi-squared-test-independence) (type "") (description "") (notes ()) (section goodness-of-fit-test) (deps (\x27;prelude \x27;matrix \x27;result-types \x27;stat/distributions)) (available (chi-squared-test-goodness chi-squared-test-goodness-uniform chi-squared-test-goodness-proportions)) (answer "(define (chi-squared-test-independence table) (let* ((nrows (matrix-rows table)) (ncols (matrix-cols table)) (row-totals (make-vector nrows 0)) (col-totals (make-vector ncols 0)) (grand-total 0)) (do ((i 0 (+ i 1))) ((= i nrows)) (do ((j 0 (+ j 1))) ((= j ncols)) (let ((val (matrix-ref table i j))) (vector-set! row-totals i (+ (vector-ref row-totals i) val)) (vector-set! col-totals j (+ (vector-ref col-totals j) val)) (set! grand-total (+ grand-total val))))) (let* ((chi-sq (let loop-i ((i 0) (sum 0)) (if (= i nrows) sum (loop-i (+ i 1) (let loop-j ((j 0) (s sum)) (if (= j ncols) s (let* ((o (matrix-ref table i j)) (e (/ (* (vector-ref row-totals i) (vector-ref col-totals j)) (max grand-total 1))) (e-safe (max e 1e-10)) (contrib (/ (expt (- o e) 2) e-safe))) (loop-j (+ j 1) (+ s contrib))))))))) (df (* (- nrows 1) (- ncols 1))) (p-value (chi-squared-pvalue chi-sq df)) (n grand-total) (k (min nrows ncols)) (cramers-v (sqrt (/ chi-sq (* n (max (- k 1) 1)))))) (make-test-result 'chi-squared-independence chi-sq df p-value #f cramers-v))))"))
