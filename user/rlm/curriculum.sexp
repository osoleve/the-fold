(task-entry (id "random/distributions/random-beta") (skill random) (module distributions) (tier 1) (difficulty 12948) (name random-beta) (type "(-> Number Number (State RNG Number))") (description "State monad sampler for beta distribution") (notes ()) (section beta-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli bernoulli-pmf random-bernoulli geometric geometric-pmf geometric-cdf geometric-quantile random-geometric poisson poisson-pmf poisson-cdf random-poisson binomial binomial-pmf random-binomial gamma random-gamma beta)) (answer "(define (random-beta alpha beta) (cond ((<= alpha 0) (error 'random-beta \"alpha must be positive\" alpha)) ((<= beta 0) (error 'random-beta \"beta must be positive\" beta)) (else (state-bind (random-gamma alpha 1) (lambda (x) (state-bind (random-gamma beta 1) (lambda (y) (state-pure (/ x (+ x y))))))))))"))
