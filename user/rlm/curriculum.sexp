(task-entry (id "tiles/hex/hex-neighbor") (skill tiles) (module hex) (tier 1) (difficulty 12308) (name hex-neighbor) (type "(-> AxialCoord Symbol AxialCoord)") (description "Get neighbor in a specific direction") (notes ()) (section neighbors) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial hex-axial-directions)) (answer "(define (hex-neighbor coord dir) (let ((offset (alist-ref hex-axial-directions dir))) (if offset (axial-coord (+ (coord-x coord) (car offset)) (+ (coord-y coord) (cdr offset))) (error 'hex-neighbor \"Invalid direction\" dir))))"))
(task-entry (id "tiles/triangle/triangle-neighbors-edge") (skill tiles) (module triangle) (tier 1) (difficulty 12308) (name triangle-neighbors-edge) (type "(-> TriangleCoord (List TriangleCoord))") (description "Get 3 edge-adjacent neighbors") (notes ()) (section neighbors) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip)) (answer "(define (triangle-neighbors-edge t) (let ((row (triangle-row t)) (col (triangle-col t)) (ori (triangle-orientation t))) (if (eq? ori 'up) (list (triangle-coord row (- col 1) 'down) (triangle-coord row (+ col 1) 'down) (triangle-coord (+ row 1) col 'up)) (list (triangle-coord row (- col 1) 'up) (triangle-coord row (+ col 1) 'up) (triangle-coord (- row 1) col 'down)))))"))
(task-entry (id "tiles/pathfinding/board-walkable?") (skill tiles) (module pathfinding) (tier 1) (difficulty 12308) (name board-walkable?) (type "(-> Board Coord Bool)") (description "Check if a coordinate is walkable on the board") (notes ()) (section board-integration) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert pqueue-pop reconstruct-path bfs-path dijkstra-path astar-path)) (answer "(define (board-walkable? board coord) (let ((tile (board-get board coord))) (and tile (tile-walkable? tile))))"))
