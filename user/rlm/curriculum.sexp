(task-entry (id "physics/classical/constraint-graph/filter-map") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23536) (name filter-map) (type "") (description "") (notes ()) (section topology) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints toposort-dag cg-color-constraints build-constraint-conflicts cg-chromatic-number cg-stats cg-print-stats cg->simplicial-complex cg-cycle-count cg-topology-analysis cg-find-bridges cg-cycle-analysis cg-print-topology)) (answer "(define (filter-map f lst) (let loop ((lst lst) (acc '())) (if (null? lst) (reverse acc) (let ((result (f (car lst)))) (loop (cdr lst) (if result (cons result acc) acc))))))"))
(task-entry (id "physics/classical/world/world-update-constraint!") (skill physics/classical) (module world) (tier 2) (difficulty 23536) (name world-update-constraint!) (type "") (description "") (notes ()) (section constraint) (deps (\x27;prelude \x27;vec2 \x27;integrators \x27;collision-detection \x27;collision-response \x27;raycasting \x27;constraints \x27;constraint-solver \x27;sort)) (available (make-entity entity? entity-id entity-body entity-shape entity-material entity-user-data entity-with-body entity-pos entity-vel entity-static? transform-shape entity-world-shape make-world-config config-fixed-dt config-max-substeps config-solver-iterations config-cell-size make-world world? world-entities world-gravity world-spatial-hash world-config world-time-acc world-constraints world-with-time-acc world-add-entity! world-remove-entity! world-get-entity world-entity-list world-update-entity! world-add-constraint! world-remove-constraint! world-get-constraint world-constraint-list)) (answer "(define (world-update-constraint! world id f) (let ((constraint (world-get-constraint world id))) (when constraint (hashtable-set! (world-constraints world) id (f constraint)))))"))
