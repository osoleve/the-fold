(task-entry (id "diffgeo/geodesics/geodesic-length") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10741) (name geodesic-length) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final trace-geodesic-adaptive-at-times exp-map-adaptive exp-map-adaptive-t log-map-adaptive vec-finite? compute-exp-jacobian-adaptive geodesic-distance-adaptive trace-geodesic trace-geodesic-final exp-map exp-map-t log-map compute-exp-jacobian solve-linear-system parallel-transport-derivative parallel-transport-step parallel-transport parallel-transport-along-geodesic geodesic-distance)) (answer "(define (geodesic-length metric states) (if (or (null? states) (null? (cdr states))) 0 (let loop ((states states) (length 0)) (if (null? (cdr states)) length (let* ((s1 (car states)) (s2 (cadr states)) (x1 (geodesic-state-coords s1)) (x2 (geodesic-state-coords s2)) (dx (vec-sub x2 x1)) (x-mid (vec-scale 0.5 (vec-add x1 x2))) (ds (metric-norm metric x-mid dx))) (loop (cdr states) (+ length ds)))))))"))
