(task-entry (id "diffgeo/forms/indices-overlap?") (skill diffgeo) (module forms) (tier 1) (difficulty 10710) (name indices-overlap?) (type "") (description "") (notes ()) (section permutation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign)) (answer "(define (indices-overlap? idx1 idx2) (let loop ((lst1 idx1) (lst2 idx2)) (cond ((or (null? lst1) (null? lst2)) #f) ((= (car lst1) (car lst2)) #t) ((< (car lst1) (car lst2)) (loop (cdr lst1) lst2)) (else (loop lst1 (cdr lst2))))))"))
(task-entry (id "diffgeo/symbolic-metrics/make-euclidean-metric-exact") (skill diffgeo) (module symbolic-metrics) (tier 1) (difficulty 10710) (name make-euclidean-metric-exact) (type "(-> Chart MetricSymbolic)") (description "Euclidean metric with exact (zero) derivatives") (notes ()) (section metric-derivative-protocol) (deps (\x27;curvature)) (available (metric-symbolic? make-metric-symbolic metric-symbolic-deriv-fn metric-chart* metric-fn* metric-dim* metric-at* make-polar-metric-exact make-spherical-metric-exact make-cylindrical-metric-exact)) (answer "(define (make-euclidean-metric-exact chart) (let* ((n (chart-dim chart)) (zero-matrix (diagonal (make-vector n 0)))) (make-metric-symbolic chart (lambda (coords) (matrix-identity n)) (lambda (coords) (make-vector n zero-matrix)))))"))
