(task-entry (id "optimization/first-order/muon") (skill optimization) (module first-order) (tier 1) (difficulty 12813) (name muon) (type "(-> (-> (List TracedValue) TracedValue) (List Number) Number ConvergenceCriteria OptResult)") (description "Muon optimizer for vector parameters") (notes ("For vectors, orthogonalization is normalization: m/||m||.\nFor matrix parameters, use muon-matrix instead.")) (section muon) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum adam adam-full rmsprop rmsprop-full adagrad adagrad-full gradient-descent-ls nesterov newton-schulz-step newton-schulz)) (answer "(define (muon f x0 lr criteria) (muon-full f x0 lr 0.95 criteria))"))
(task-entry (id "optimization/newton/list-update-newton") (skill optimization) (module newton) (tier 1) (difficulty 12813) (name list-update-newton) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton make-positive-definite newton-cg newton-cg-full cg-newton-direction hessian-vector-product gauss-newton gradient-ls jacobian-numerical)) (answer "(define (list-update-newton lst idx f) (if (= idx 0) (cons (f (car lst)) (cdr lst)) (cons (car lst) (list-update-newton (cdr lst) (- idx 1) f))))"))
(task-entry (id "optimization/lbfgs/lbfgs-full") (skill optimization) (module lbfgs) (tier 1) (difficulty 12813) (name lbfgs-full) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list lbfgs-history-push take-n lbfgs-direction lbfgs-two-loop initial-hessian-scale lbfgs)) (answer "(define (lbfgs-full f x0 m criteria) (let* ((init-grad (gradient f x0)) (init-f (apply f x0)) (init-state (initial-convergence-state init-f init-grad)) (init-history (make-lbfgs-history m))) (let loop ((x x0) (grad init-grad) (history init-history) (state init-state)) (let ((reason (converged? criteria state))) (if reason (make-opt-result x (cs-f-val state) grad (cs-iter state) reason) (let* ((direction (lbfgs-direction history grad)) (ls-result (wolfe-line-search f x grad direction)) (x-new (car ls-result)) (alpha (cadr ls-result)) (grad-new (gradient f x-new)) (f-new (apply f x-new)) (s (map - x-new x)) (y (map - grad-new grad)) (history-new (if (> alpha 0) (lbfgs-history-push history s y) history)) (new-state (update-convergence-state state f-new grad-new x x-new))) (loop x-new grad-new history-new new-state)))))))"))
