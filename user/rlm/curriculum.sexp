(task-entry (id "diffgeo/curvature/surface-partial-vv") (skill diffgeo) (module curvature) (tier 1) (difficulty 10740) (name surface-partial-vv) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols compute-metric-derivatives christoffel-ref riemann-tensor compute-christoffel-derivatives make-4d-array array-4d-ref array-4d-set! dgamma-ref riemann-ref ricci-tensor scalar-curvature surface? surface-param make-surface surface-at first-fundamental-form second-fundamental-form gaussian-curvature mean-curvature principal-curvatures surface-partial-u surface-partial-v surface-partial-uu)) (answer "(define (surface-partial-vv surf u v eps) (let ((r-plus (surface-at surf u (+ v eps))) (r-center (surface-at surf u v)) (r-minus (surface-at surf u (- v eps)))) (vec-scale (/ 1.0 (* eps eps)) (vec-add (vec-sub r-plus r-center) (vec-sub r-minus r-center)))))"))
(task-entry (id "diffgeo/geodesics/geodesic-distance") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10740) (name geodesic-distance) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final trace-geodesic-adaptive-at-times exp-map-adaptive exp-map-adaptive-t log-map-adaptive vec-finite? compute-exp-jacobian-adaptive geodesic-distance-adaptive trace-geodesic trace-geodesic-final exp-map exp-map-t log-map compute-exp-jacobian solve-linear-system parallel-transport-derivative parallel-transport-step parallel-transport parallel-transport-along-geodesic)) (answer "(define (geodesic-distance metric p q . opts) (let ((result (apply log-map metric p q opts))) (if (and (pair? result) (eq? (car result) 'ok)) (let ((v (cadr result))) (metric-norm metric p v)) result)))"))
(task-entry (id "diffgeo/forms/hodge-star-euclidean") (skill diffgeo) (module forms) (tier 1) (difficulty 10740) (name hodge-star-euclidean) (type "") (description "") (notes ()) (section hodge-star) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices count-inversions-to-sort k-form? k-form-point k-form-chart k-form-degree k-form-components k-form-dim make-k-form k-form-zero k-form-basis cotangent->1-form \x31;-form->cotangent k-form-add k-form-sub k-form-scale k-form-negate k-form-change-chart wedge wedge* interior-product remove-at exterior-derivative insert-sorted insertion-sign d-scalar k-form-apply matrix-det-small pullback-k-form)) (answer "(define (hodge-star-euclidean kf) (let* ((point (k-form-point kf)) (chart (k-form-chart kf)) (n (chart-dim chart)) (k (k-form-degree kf)) (m (- n k)) (comps (k-form-components kf)) (indices-k (generate-multi-indices n k)) (indices-m (generate-multi-indices n m)) (num-m (binomial n m)) (result (make-vector num-m 0))) (for-each (lambda (idx-I) (let ((omega-I (vector-ref comps (multi-index->offset n idx-I)))) (when (not (= omega-I 0)) (let* ((idx-Ic (complement-index n idx-I)) (sign (levi-civita-sign n (append idx-I idx-Ic))) (offset-Ic (multi-index->offset n idx-Ic)) (contribution (* sign omega-I))) (vector-set! result offset-Ic contribution))))) indices-k) (make-k-form point chart m result)))"))
