(task-entry (id "optics/profunctor-optics/p-traversal->p-fold") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11108) (name p-traversal->p-fold) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong? strong-profunctor strong-first strong-second pfirst psecond make-choice swap-either choice? choice-profunctor choice-left choice-right pleft pright make-closed closed-profunctor? closed-profunctor closed-fn pclosed make-wander wander? wander-strong wander-choice wander-wander pwander profunctor-fn strong-fn choice-fn closed-fn-instance wander-fn make-forget forget? run-forget profunctor-forget strong-forget make-tagged tagged? run-tagged profunctor-tagged choice-tagged make-star star? star-functor run-star profunctor-star make-p-iso p-iso? p-iso-forward p-iso-backward run-p-iso p-iso-compose make-p-lens p-lens? p-lens-getter p-lens-setter run-p-lens p-lens-compose make-p-prism p-prism? p-prism-match p-prism-build run-p-prism p-prism-compose make-p-affine p-affine? p-affine-preview p-affine-set run-p-affine p-affine-compose make-p-traversal p-traversal? p-traversal-traverse p-traversal-fold-fn run-p-traversal p-traversal-to-list p-traversal-over p-traversal-set p-traversal-compose p-traversal-each p-traversal-both p-traversal-filtered make-p-fold p-fold? p-fold-fn p-fold-to-list p-fold-preview p-fold-has p-fold-length p-fold-all p-fold-any p-fold-compose p-fold-each p-fold-filtered p-fold-taking traversal->p-traversal p-traversal->traversal p-lens->p-traversal p-prism->p-traversal p-affine->p-traversal)) (answer "(define (p-traversal->p-fold ptrav) (make-p-fold (p-traversal-fold-fn ptrav)))"))
(task-entry (id "info/entropy/joint-entropy") (skill info) (module entropy) (tier 1) (difficulty 11108) (name joint-entropy) (type "(-> (List (List Number)) Number)") (description "Joint entropy H(X,Y) from joint probability matrix") (notes ()) (section joint-entropy) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy)) (answer "(define (joint-entropy joint-probs) (let ((flat (flatten joint-probs))) (entropy flat)))"))
(task-entry (id "info/statistical-measures/alpha-divergence") (skill info) (module statistical-measures) (tier 1) (difficulty 11108) (name alpha-divergence) (type "(-> Real (List Real) (List Real) Real)") (description "Alpha-divergence (Rényi divergence), generalizes KL, Hellinger, chi-squared") (notes ()) (section alpha-divergence) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared jeffreys-divergence)) (answer "(define (alpha-divergence alpha p q) (cond ((or (null? p) (null? q)) 0) ((= alpha 1) (kl-divergence p q)) ((= alpha 0) (- (log-num (fold-left + 0 (map (lambda (pi qi) (if (and (> pi 0) (> qi 0)) qi 0)) p q))))) (else (let ((sum-term (fold-left + 0 (map (lambda (pi qi) (cond ((and (<= pi 0) (<= qi 0)) 0) ((or (<= pi 0) (<= qi 0)) 0) (else (* (expt pi alpha) (expt qi (- 1 alpha)))))) p q)))) (if (<= sum-term 0) +inf.0 (/ (log-num sum-term) (* alpha (- alpha 1))))))))"))
(task-entry (id "info/channel-capacity/awgn-capacity-bandwidth") (skill info) (module channel-capacity) (tier 1) (difficulty 11108) (name awgn-capacity-bandwidth) (type "(-> Real Real Real Real)") (description "Shannon-Hartley theorem for bandwidth-limited channels") (notes ()) (section awgn-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity awgn-capacity-db)) (answer "(define (awgn-capacity-bandwidth bandwidth signal-power noise-density) (let ((noise-power (* noise-density bandwidth))) (if (<= noise-power 0) +inf.0 (* bandwidth (log2 (+ 1 (/ signal-power noise-power)))))))"))
(task-entry (id "info/rate-distortion/snr-db") (skill info) (module rate-distortion) (tier 1) (difficulty 11108) (name snr-db) (type "(-> (List Real) (List Real) Real)") (description "Signal-to-noise ratio in decibels: 10 * log10(SNR)") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr)) (answer "(define (snr-db original reconstructed) (let ((s (snr original reconstructed))) (if (= s +inf.0) +inf.0 (* 10 (/ (log2 s) (log2 10))))))"))
(task-entry (id "info/coding/sort-by-prob") (skill info) (module coding) (tier 1) (difficulty 11108) (name sort-by-prob) (type "(-> (List Node) (List Node))") (description "Sort nodes by probability (ascending)") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop)) (answer "(define (sort-by-prob nodes) (sort-by (lambda (a b) (< (huffman-prob a) (huffman-prob b))) nodes))"))
(task-entry (id "info/partition-info/partition-nmi") (skill info) (module partition-info) (tier 1) (difficulty 11108) (name partition-nmi) (type "(-> Vector Vector Number)") (description "Normalized Mutual Information between two partitions.\n   NMI(A,B) = I(A;B) / sqrt(H(A) * H(B)), in [0, 1].\n   NMI = 1 means identical partitions, NMI = 0 means independent.\n   This is the standard metric for comparing community detection results\n   against ground truth.") (notes ()) (section normalized-mutual-information) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy partition-sizes sort-labels insert-sorted partition-mi build-contingency-table unique-labels label-index-map)) (answer "(define (partition-nmi labels-a labels-b) (let ((ha (partition-entropy labels-a)) (hb (partition-entropy labels-b)) (mi (partition-mi labels-a labels-b))) (if (or (<= ha 0) (<= hb 0)) (if (and (<= ha 0) (<= hb 0)) 1.0 0.0) (/ mi (sqrt (* ha hb))))))"))
(task-entry (id "optics/optics/grate-compose") (skill optics) (module optics) (tier 1) (difficulty 11109) (name grate-compose) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate? grate-cotraverse-fn grate-review grate-over grate-set grate-zipWith grate-zipWith3 grate-zip)) (answer "(define (grate-compose outer inner) (make-grate (lambda (sctod) ((grate-cotraverse-fn outer) (lambda (sa) ((grate-cotraverse-fn inner) (lambda (ac) (sctod (compose2 ac sa)))))))))"))
(task-entry (id "optics/profunctor-optics/p-lens->p-fold") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11109) (name p-lens->p-fold) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong? strong-profunctor strong-first strong-second pfirst psecond make-choice swap-either choice? choice-profunctor choice-left choice-right pleft pright make-closed closed-profunctor? closed-profunctor closed-fn pclosed make-wander wander? wander-strong wander-choice wander-wander pwander profunctor-fn strong-fn choice-fn closed-fn-instance wander-fn make-forget forget? run-forget profunctor-forget strong-forget make-tagged tagged? run-tagged profunctor-tagged choice-tagged make-star star? star-functor run-star profunctor-star make-p-iso p-iso? p-iso-forward p-iso-backward run-p-iso p-iso-compose make-p-lens p-lens? p-lens-getter p-lens-setter run-p-lens p-lens-compose make-p-prism p-prism? p-prism-match p-prism-build run-p-prism p-prism-compose make-p-affine p-affine? p-affine-preview p-affine-set run-p-affine p-affine-compose make-p-traversal p-traversal? p-traversal-traverse p-traversal-fold-fn run-p-traversal p-traversal-to-list p-traversal-over p-traversal-set p-traversal-compose p-traversal-each p-traversal-both p-traversal-filtered make-p-fold p-fold? p-fold-fn p-fold-to-list p-fold-preview p-fold-has p-fold-length p-fold-all p-fold-any p-fold-compose p-fold-each p-fold-filtered p-fold-taking traversal->p-traversal p-traversal->traversal p-lens->p-traversal p-prism->p-traversal p-affine->p-traversal p-traversal->p-fold)) (answer "(define (p-lens->p-fold plens) (make-p-fold (lambda (s) (list ((p-lens-getter plens) s)))))"))
(task-entry (id "info/entropy/conditional-entropy") (skill info) (module entropy) (tier 1) (difficulty 11109) (name conditional-entropy) (type "(-> (List (List Number)) (List Number) Number)") (description "Conditional entropy H(X|Y) = H(X,Y) - H(Y)") (notes ()) (section conditional-entropy) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy)) (answer "(define (conditional-entropy joint-probs marginal-y) (let ((h-joint (joint-entropy joint-probs)) (h-y (entropy marginal-y))) (- h-joint h-y)))"))
(task-entry (id "info/statistical-measures/squared-hellinger-distance") (skill info) (module statistical-measures) (tier 1) (difficulty 11109) (name squared-hellinger-distance) (type "(-> (List Real) (List Real) Real)") (description "Squared Hellinger distance H²(P,Q) = 1 - BC(P,Q)") (notes ()) (section squared-hellinger-distance) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared jeffreys-divergence alpha-divergence)) (answer "(define (squared-hellinger-distance p q) (let ((bc (bhattacharyya-coefficient p q))) (- 1 bc)))"))
(task-entry (id "info/channel-capacity/snr-for-capacity") (skill info) (module channel-capacity) (tier 1) (difficulty 11109) (name snr-for-capacity) (type "(-> Real Real)") (description "Required SNR to achieve target capacity") (notes ()) (section awgn-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity awgn-capacity-db awgn-capacity-bandwidth)) (answer "(define (snr-for-capacity target-capacity) (- (expt 2 (* 2 target-capacity)) 1))"))
(task-entry (id "info/rate-distortion/psnr") (skill info) (module rate-distortion) (tier 1) (difficulty 11109) (name psnr) (type "(-> (List Real) (List Real) Real Real)") (description "Peak signal-to-noise ratio in dB") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr snr-db)) (answer "(define (psnr original reconstructed peak) (let ((m (mse original reconstructed))) (if (<= m 0) +inf.0 (* 10 (/ (log2 (/ (* peak peak) m)) (log2 10))))))"))
(task-entry (id "info/coding/huffman-codes") (skill info) (module coding) (tier 1) (difficulty 11109) (name huffman-codes) (type "(-> Node (List (Pair Symbol String)))") (description "Extract code assignments from Huffman tree") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob)) (answer "(define (huffman-codes tree) (huffman-codes-helper tree \"\"))"))
(task-entry (id "info/partition-info/partition-vi") (skill info) (module partition-info) (tier 1) (difficulty 11109) (name partition-vi) (type "(-> Vector Vector Number)") (description "Variation of Information between two partitions.\n   VI(A,B) = H(A|B) + H(B|A) = H(A) + H(B) - 2*I(A;B).\n   VI is a true metric on the space of partitions (satisfies triangle inequality).\n   VI = 0 means identical partitions.") (notes ()) (section variation-of-information) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy partition-sizes sort-labels insert-sorted partition-mi build-contingency-table unique-labels label-index-map partition-nmi)) (answer "(define (partition-vi labels-a labels-b) (let ((ha (partition-entropy labels-a)) (hb (partition-entropy labels-b)) (mi (partition-mi labels-a labels-b))) (max 0 (+ ha hb (* -2 mi)))))"))
(task-entry (id "optics/optics/grate-id") (skill optics) (module optics) (tier 1) (difficulty 11110) (name grate-id) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate? grate-cotraverse-fn grate-review grate-over grate-set grate-zipWith grate-zipWith3 grate-zip grate-compose)) (answer "(define grate-id (make-grate (lambda (satob) (satob identity))))"))
(task-entry (id "optics/profunctor-optics/p-prism->p-fold") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11110) (name p-prism->p-fold) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong? strong-profunctor strong-first strong-second pfirst psecond make-choice swap-either choice? choice-profunctor choice-left choice-right pleft pright make-closed closed-profunctor? closed-profunctor closed-fn pclosed make-wander wander? wander-strong wander-choice wander-wander pwander profunctor-fn strong-fn choice-fn closed-fn-instance wander-fn make-forget forget? run-forget profunctor-forget strong-forget make-tagged tagged? run-tagged profunctor-tagged choice-tagged make-star star? star-functor run-star profunctor-star make-p-iso p-iso? p-iso-forward p-iso-backward run-p-iso p-iso-compose make-p-lens p-lens? p-lens-getter p-lens-setter run-p-lens p-lens-compose make-p-prism p-prism? p-prism-match p-prism-build run-p-prism p-prism-compose make-p-affine p-affine? p-affine-preview p-affine-set run-p-affine p-affine-compose make-p-traversal p-traversal? p-traversal-traverse p-traversal-fold-fn run-p-traversal p-traversal-to-list p-traversal-over p-traversal-set p-traversal-compose p-traversal-each p-traversal-both p-traversal-filtered make-p-fold p-fold? p-fold-fn p-fold-to-list p-fold-preview p-fold-has p-fold-length p-fold-all p-fold-any p-fold-compose p-fold-each p-fold-filtered p-fold-taking traversal->p-traversal p-traversal->traversal p-lens->p-traversal p-prism->p-traversal p-affine->p-traversal p-traversal->p-fold p-lens->p-fold)) (answer "(define (p-prism->p-fold pprism) (make-p-fold (lambda (s) (let ((e ((p-prism-match pprism) s))) (if (right? e) (list (from-right e)) '())))))"))
(task-entry (id "info/entropy/conditional-entropy-direct") (skill info) (module entropy) (tier 1) (difficulty 11110) (name conditional-entropy-direct) (type "(-> (List (List Number)) (List Number) Number)") (description "Compute H(X|Y) directly from conditional probability distributions") (notes ()) (section conditional-entropy) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy)) (answer "(define (conditional-entropy-direct conditional-probs weights-y) (let ((total-weight (fold-left + 0 weights-y))) (if (<= total-weight 0) 0 (let* ((normalized-weights (map (lambda (w) (/ w total-weight)) weights-y)) (conditional-entropies (map entropy conditional-probs))) (fold-left + 0 (map * normalized-weights conditional-entropies))))))"))
(task-entry (id "info/statistical-measures/triangular-discrimination") (skill info) (module statistical-measures) (tier 1) (difficulty 11110) (name triangular-discrimination) (type "(-> (List Real) (List Real) Real)") (description "Triangular discrimination Δ(P,Q) = sum((p_i - q_i)^2 / (p_i + q_i))") (notes ()) (section triangular-discrimination) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared jeffreys-divergence alpha-divergence squared-hellinger-distance)) (answer "(define (triangular-discrimination p q) (if (or (null? p) (null? q)) 0 (fold-left + 0 (map (lambda (pi qi) (let ((sum-pq (+ pi qi))) (if (<= sum-pq 0) 0 (let ((diff (- pi qi))) (/ (* diff diff) sum-pq))))) p q))))"))
(task-entry (id "info/channel-capacity/dmc-mutual-information") (skill info) (module channel-capacity) (tier 1) (difficulty 11110) (name dmc-mutual-information) (type "(-> (List (List Real)) (List Real) Real)") (description "Compute I(X;Y) for DMC with transition matrix and input distribution") (notes ()) (section discrete-memoryless-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity awgn-capacity-db awgn-capacity-bandwidth snr-for-capacity)) (answer "(define (dmc-mutual-information transition input-dist) (let* ((output-dist (dmc-output-distribution transition input-dist)) (joint (dmc-joint-distribution transition input-dist))) (mutual-information-from-joint joint)))"))
(task-entry (id "info/rate-distortion/mean") (skill info) (module rate-distortion) (tier 1) (difficulty 11110) (name mean) (type "(-> (List Real) Real)") (description "") (notes ()) (section statistical-helpers) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr snr-db psnr)) (answer "(define (mean xs) (if (null? xs) 0 (/ (fold-left + 0 xs) (length xs))))"))
(task-entry (id "info/coding/huffman-codes-helper") (skill info) (module coding) (tier 1) (difficulty 11110) (name huffman-codes-helper) (type "(-> Node String (List (Pair Symbol String)))") (description "") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob huffman-codes)) (answer "(define (huffman-codes-helper node prefix) (if (huffman-leaf? node) (list (cons (huffman-symbol node) prefix)) (let* ((children (huffman-children node)) (left (car children)) (right (cdr children))) (append (huffman-codes-helper left (string-append prefix \"0\")) (huffman-codes-helper right (string-append prefix \"1\"))))))"))
(task-entry (id "info/partition-info/partition-vi-normalized") (skill info) (module partition-info) (tier 1) (difficulty 11110) (name partition-vi-normalized) (type "(-> Vector Vector Number)") (description "Normalized Variation of Information: VI(A,B) / log2(n).\n   Bounded in [0, 1], independent of partition size.") (notes ()) (section variation-of-information) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy partition-sizes sort-labels insert-sorted partition-mi build-contingency-table unique-labels label-index-map partition-nmi partition-vi)) (answer "(define (partition-vi-normalized labels-a labels-b) (let* ((n (vector-length labels-a)) (vi (partition-vi labels-a labels-b))) (if (<= n 1) 0 (/ vi (log2 n)))))"))
(task-entry (id "optics/optics/grate-fn") (skill optics) (module optics) (tier 1) (difficulty 11111) (name grate-fn) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate? grate-cotraverse-fn grate-review grate-over grate-set grate-zipWith grate-zipWith3 grate-zip grate-compose grate-id)) (answer "(define grate-fn (make-grate (lambda (satob) (lambda (x) (satob (lambda (f) (f x)))))))"))
