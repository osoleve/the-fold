(task-entry (id "algebra/multivariate/mono-divides?") (skill algebra) (module multivariate) (tier 0) (difficulty 311) (name mono-divides?) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge)) (answer "(define (mono-divides? m1 m2) (let loop ((m1 m1) (m2 m2)) (cond ((null? m1) #t) ((null? m2) #f) (else (let ((v1 (caar m1)) (e1 (cdar m1)) (v2 (caar m2)) (e2 (cdar m2))) (cond ((symbol<? v1 v2) #f) ((symbol<? v2 v1) (loop m1 (cdr m2))) (else (and (<= e1 e2) (loop (cdr m1) (cdr m2))))))))))"))
(task-entry (id "algebra/groebner/interreduce") (skill algebra) (module groebner) (tier 0) (difficulty 311) (name interreduce) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger buchberger-loop buchberger-criterion-1? all-pairs reduce-basis mpoly-make-monic minimize-basis any-divides-lm?)) (answer "(define (interreduce G Fld) (let loop ((remaining G) (done '())) (if (null? remaining) (reverse done) (let* ((p (car remaining)) (others (append (cdr remaining) done)) (reduced (if (null? others) p (reduce-poly-full p others)))) (loop (cdr remaining) (cons (mpoly-make-monic reduced Fld) done))))))"))
(task-entry (id "algebra/poly-bridge/alg-poly-mod") (skill algebra) (module poly-bridge) (tier 0) (difficulty 311) (name alg-poly-mod) (type "") (description "") (notes ()) (section none) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul alg-poly-scale alg-poly-divmod alg-poly-div)) (answer "(define alg-poly-mod poly-mod)"))
(task-entry (id "algebra/galois/gf-ext-enumerate") (skill algebra) (module galois) (tier 0) (difficulty 311) (name gf-ext-enumerate) (type "") (description "") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large)) (answer "(define (gf-ext-enumerate p n base-field modulus) (let* ((zero (field-zero base-field)) (elts (field-elements base-field))) (let loop ((coeffs-list (all-coeff-combinations elts n))) (map (lambda (coeffs) (make-gf-ext-element (gf-ext-normalize coeffs n base-field) modulus base-field)) coeffs-list))))"))
(task-entry (id "algebra/tropical/tropical-power") (skill algebra) (module tropical) (tier 0) (difficulty 311) (name tropical-power) (type "") (description "") (notes ()) (section scalar-operations) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul)) (answer "(define (tropical-power sr a n) (cond ((= n 0) (semiring-one sr)) ((= n 1) a) ((even? n) (let ((half (tropical-power sr a (quotient n 2)))) (tropical-mul sr half half))) (else (tropical-mul sr a (tropical-power sr a (- n 1))))))"))
(task-entry (id "algebra/group/element-order") (skill algebra) (module group) (tier 0) (difficulty 312) (name element-order) (type "(-> Group Element (Union Integer Boolean))") (description "Find the smallest positive n such that a^n = e") (notes ()) (section group-operations) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal?)) (answer "(define (element-order g a) (let loop ((n 1) (current a)) (if (> n (group-order g)) #f (if (group-equal? g current (group-identity g)) n (loop (+ n 1) (group-compose g current a))))))"))
(task-entry (id "algebra/ring/ring-neg") (skill algebra) (module ring) (tier 0) (difficulty 312) (name ring-neg) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul)) (answer "(define (ring-neg r a) ((ring-neg-fn r) a))"))
(task-entry (id "algebra/field/field-meta-ref") (skill algebra) (module field) (tier 0) (difficulty 312) (name field-meta-ref) (type "") (description "") (notes ()) (section field-representation) (deps (\x27;prelude \x27;ring)) (available (make-field make-field* field? field-elements field-add-op field-mul-op field-zero field-one field-neg-fn field-div-fn field-equal-fn field-metadata)) (answer "(define (field-meta-ref f key) (let ((meta (field-metadata f))) (cond ((assq key meta) => cdr) (else #f))))"))
(task-entry (id "algebra/polynomial/poly-monomial") (skill algebra) (module polynomial) (tier 0) (difficulty 312) (name poly-monomial) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant)) (answer "(define (poly-monomial field coeff degree) (let ((zero (field-zero field))) (if ((field-equal-fn field) coeff zero) (poly-zero-over field) (make-polynomial field (append (make-list degree zero) (list coeff))))))"))
(task-entry (id "algebra/multivariate/mono-div") (skill algebra) (module multivariate) (tier 0) (difficulty 312) (name mono-div) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides?)) (answer "(define (mono-div m1 m2) (mono-div-helper m1 m2))"))
(task-entry (id "algebra/groebner/remove-equal") (skill algebra) (module groebner) (tier 0) (difficulty 312) (name remove-equal) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger buchberger-loop buchberger-criterion-1? all-pairs reduce-basis mpoly-make-monic minimize-basis any-divides-lm? interreduce)) (answer "(define (remove-equal x lst eq-fn) (filter (lambda (y) (not (eq-fn x y))) lst))"))
(task-entry (id "algebra/poly-bridge/alg-poly-gcd") (skill algebra) (module poly-bridge) (tier 0) (difficulty 312) (name alg-poly-gcd) (type "") (description "") (notes ()) (section none) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul alg-poly-scale alg-poly-divmod alg-poly-div alg-poly-mod)) (answer "(define alg-poly-gcd poly-gcd)"))
(task-entry (id "algebra/galois/all-coeff-combinations") (skill algebra) (module galois) (tier 0) (difficulty 312) (name all-coeff-combinations) (type "") (description "") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate)) (answer "(define (all-coeff-combinations elements n) (if (= n 0) '(()) (let ((rest (all-coeff-combinations elements (- n 1)))) (append-map (lambda (e) (map (lambda (r) (cons e r)) rest)) elements))))"))
(task-entry (id "algebra/tropical/tropical-matrix-identity") (skill algebra) (module tropical) (tier 0) (difficulty 312) (name tropical-matrix-identity) (type "") (description "") (notes ()) (section matrix-operations) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power)) (answer "(define (tropical-matrix-identity sr n) (let ((data (make-vector (* n n) (semiring-zero sr))) (one (semiring-one sr))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! data (+ (* i n) i) one)) (list 'matrix n n data)))"))
(task-entry (id "algebra/group/verify-closure") (skill algebra) (module group) (tier 0) (difficulty 313) (name verify-closure) (type "(-> Group Boolean)") (description "Check that the operation is closed over the elements") (notes ()) (section group-axiom-verification) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order)) (answer "(define (verify-closure g) (let ((elems (group-elements g)) (op (group-op g)) (eq? (group-equal-fn g))) (let loop-a ((as elems)) (if (null? as) #t (let loop-b ((bs elems)) (if (null? bs) (loop-a (cdr as)) (let ((result (op (car as) (car bs)))) (if (ormap (lambda (e) (eq? e result)) elems) (loop-b (cdr bs)) #f))))))))"))
(task-entry (id "algebra/ring/ring-sub") (skill algebra) (module ring) (tier 0) (difficulty 313) (name ring-sub) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg)) (answer "(define (ring-sub r a b) (ring-add r a (ring-neg r b)))"))
