(task-entry (id "control-systems/discrete-control/vec-add") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22621) (name vec-add) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output dss-simulate dss-impulse-response dss-step-response dss-stable? find-complex-at-index recommend-sample-rate)) (answer "(define (vec-add v1 v2) (let* ((n (vector-length v1)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (+ (vector-ref v1 i) (vector-ref v2 i))))))"))
(task-entry (id "control-systems/hinf-synthesis/solve-hinf-riccati-dual") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22621) (name solve-hinf-riccati-dual) (type "Matrix × Matrix × Matrix × Nat → Matrix | Error") (description "Solve dual H-infinity Riccati: AY + YA' + Q + Y*R*Y = 0") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma solve-hinf-riccati)) (answer "(define (solve-hinf-riccati-dual A R Q max-iter) (let ((At (matrix-transpose A))) (solve-hinf-riccati At R Q max-iter)))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-gcd") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22621) (name alg-poly-gcd) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod alg-poly-div)) (answer "(define (alg-poly-gcd p1 p2) (if (alg-poly-zero? p2) (alg-poly-make-monic p1) (alg-poly-gcd p2 (alg-poly-mod p1 p2))))"))
(task-entry (id "control-systems/state-space/matrix-column-as-matrix") (skill control-systems) (module state-space) (tier 2) (difficulty 22622) (name matrix-column-as-matrix) (type "(-> Matrix Nat Matrix)") (description "Extract column j as an n×1 matrix") (notes ()) (section controllability) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix ss-controllability-matrix)) (answer "(define (matrix-column-as-matrix m j) (let* ((n (matrix-rows m)) (result (make-matrix n 1 0))) (do ((i 0 (+ i 1))) ((= i n) result) (matrix-set! result i 0 (matrix-ref m i j)))))"))
