(task-entry (id "fp/expr/difference") (skill fp) (module expr) (tier 1) (difficulty 10611) (name difference) (type "(-> Expr Expr Expr)") (description "Create difference with basic simplifications") (notes ()) (section smart-constructors) (deps (\x27;prelude)) (available (num var make-sum make-product make-diff make-neg make-div make-pow make-app sum product)) (answer "(define (difference e1 e2) (cond ((and (num? e2) (= (num-val e2) 0)) e1) ((and (num? e1) (= (num-val e1) 0)) (make-neg e2)) ((expr=? e1 e2) (num 0)) ((and (num? e1) (num? e2)) (num (- (num-val e1) (num-val e2)))) (else (list '- e1 e2))))"))
