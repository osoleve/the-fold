(task-entry (id "statistics/forecast/drift-forecast") (skill statistics) (module forecast) (tier 1) (difficulty 11207) (name drift-forecast) (type "") (description "") (notes ()) (section forecast-accuracy-metrics) (deps (\x27;prelude)) (available (mae mse rmse mape smape mase naive-forecast)) (answer "(define (drift-forecast xs h) (let* ((n (vector-length xs)) (first-val (vector-ref xs 0)) (last-val (vector-ref xs (- n 1))) (slope (/ (- last-val first-val) (max (- n 1) 1))) (forecasts (make-vector h))) (do ((i 1 (+ i 1))) ((> i h) forecasts) (vector-set! forecasts (- i 1) (+ last-val (* i slope))))))"))
