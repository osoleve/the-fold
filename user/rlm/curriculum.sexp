t counter-reset counter-get log-info log-warn log-error log-debug run-state-writer run-state-in-writer run-reader-writer run-reader-in-writer with-state with-reader with-writer with-exception with-nondet local-state local-reader)) (answer "(define (interleave eff1 eff2) (cond ((eff-pure? eff1) (eff-return (left (eff-pure-value eff1)))) ((eff-pure? eff2) (eff-return (right (eff-pure-value eff2)))) ((eff-queue? eff1) (interleave (eff-normalize eff1) eff2)) ((eff-queue? eff2) (interleave eff1 (eff-normalize eff2))) ((eff-op? eff1) (make-eff-op (eff-op-effect eff1) (lambda (resp) (interleave eff2 ((eff-op-cont eff1) resp)))))))"))
