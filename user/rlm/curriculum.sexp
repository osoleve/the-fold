(task-entry (id "autodiff/higher-order-diff/jet-neg") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12737) (name jet-neg) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin rec-cos jet-pad-coeffs jet-add jet-sub)) (answer "(define (jet-neg a) (let* ((a (jet-lift a)) (ca (jet-coeffs a)) (n (vector-length ca)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) (jet (vector->list result))) (vector-set! result i (- (vector-ref ca i))))))"))
(task-entry (id "autodiff/sparse-autodiff/sparse-backward") (skill autodiff) (module sparse-autodiff) (tier 1) (difficulty 12737) (name sparse-backward) (type "") (description "") (notes ()) (section sparse-gradient-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;comp-graph \x27;reverse-diff \x27;higher-order-diff)) (available (sparse-grad? make-sparse-grad sparse-grad-nnz sparse-grad-indices sparse-grad-values sparse-grad-ref sparse-grad->dense dense->sparse-grad sparse-grad-add sparse-grad-scale sparsity-pattern? make-sparsity-pattern pattern-rows pattern-cols pattern-nnz pattern-row-indices pattern-col-indices detect-sparsity pattern-from-explicit diagonal-pattern banded-pattern sparse-jacobian sparse-jacobian-with-pattern sparse-jvp sparse-vjp sparse-hessian sparse-hessian-exact sparse-hessian-vector-product sparse-traced sparse-traced? sparse-traced-value sparse-traced-id sparse-traced-tape make-sparse-reverse-tape sparse-reverse-tape? sparse-tape-entries sparse-tape-push!)) (answer "(define (sparse-backward tape output-id seed n) (let ((grads (make-hashtable equal-hash equal?))) (hashtable-set! grads output-id seed) (for-each (lambda (entry) (let* ((result-id (car entry)) (input-ids (caddr entry)) (local-grads (cadddr entry)) (result-grad (hashtable-ref grads result-id 0))) (for-each (lambda (input-id local-grad) (when input-id (let ((current (hashtable-ref grads input-id 0))) (hashtable-set! grads input-id (+ current (* result-grad local-grad)))))) input-ids local-grads))) (sparse-tape-entries tape)) (let-values (((keys vals) (hashtable-entries grads))) (let* ((ks (vector->list keys)) (vs (vector->list vals)) (nz-pairs (filter (lambda (p) (not (= (cdr p) 0))) (map cons ks vs))) (nnz (length nz-pairs)) (indices (make-vector nnz 0)) (values (make-vector nnz 0))) (do ((k 0 (+ k 1)) (ps nz-pairs (cdr ps))) ((= k nnz) (make-sparse-grad indices values)) (vector-set! indices k (caar ps)) (vector-set! values k (cdar ps)))))))"))
(task-entry (id "autodiff/typed-gradients/compose-gradient-fns") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12737) (name compose-gradient-fns) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix safe-hessian scalar-fn vector-fn t-gradient t-gradient-fn t-jacobian t-jacobian-fn t-hessian t-hessian-fn infer-gradient-dim validate-gradient-spec format-gradient-error TC-DimDifferentiable dim-differentiable-gradient-spec-methods)) (answer "(define (compose-gradient-fns f-spec g-spec) (if (not (and (gradient-spec? f-spec) (gradient-spec? g-spec))) (list 'error 'invalid-specs) (let ((f-input (gradient-spec-input-dim f-spec)) (g-output (gradient-spec-output-dim g-spec)) (g-input (gradient-spec-input-dim g-spec))) (if (not (= f-input g-output)) (list 'error 'composition-dimension-mismatch (list 'f-expects f-input) (list 'g-produces g-output)) (let ((f (gradient-spec-fn f-spec)) (g (gradient-spec-fn g-spec))) (make-gradient-spec g-input 1 (lambda traced-args (let ((g-result (apply g traced-args))) (if (list? g-result) (apply f g-result) (f g-result))))))))))"))
