(task-entry (id "autodiff/interval-autodiff/interval-traced-op") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12713) (name interval-traced-op) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var)) (answer "(define (interval-traced-op op-name result-iv inputs local-grad-ivs tape) (let ((result-id (interval-fresh-id)) (input-ids (map (lambda (x) (if (interval-traced? x) (interval-traced-id x) #f)) inputs))) (interval-tape-push! tape (list result-id op-name input-ids local-grad-ivs)) (interval-traced result-iv result-id tape)))"))
