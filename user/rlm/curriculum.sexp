(task-entry (id "physics/classical/collision-response/combine-materials") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23517) (name combine-materials) (type "") (description "") (notes ()) (section material) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material)) (answer "(define (combine-materials mat-a mat-b) (let ((e-a (material-restitution mat-a)) (e-b (material-restitution mat-b)) (sf-a (material-static-friction mat-a)) (sf-b (material-static-friction mat-b)) (df-a (material-dynamic-friction mat-a)) (df-b (material-dynamic-friction mat-b))) (list (min e-a e-b) (sqrt (* sf-a sf-b)) (sqrt (* df-a df-b)))))"))
