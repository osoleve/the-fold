(task-entry (id "game-theory/mechanism/bids-second-max") (skill game-theory) (module mechanism) (tier 1) (difficulty 13207) (name bids-second-max) (type "(-> (Vector Number) Number)") (description "Second-highest bid (0 if < 2 bidders)") (notes ()) (section bid-representation) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max)) (answer "(define (bids-second-max bids) (let ((n (bids-length bids))) (if (< n 2) 0 (let loop ((i 0) (first -inf.0) (second -inf.0)) (if (>= i n) second (let ((b (bids-ref bids i))) (cond ((> b first) (loop (+ i 1) b first)) ((> b second) (loop (+ i 1) first b)) (else (loop (+ i 1) first second)))))))))"))
