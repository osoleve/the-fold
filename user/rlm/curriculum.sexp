(task-entry (id "fp/proof-tactics/tactic-refl") (skill fp) (module proof-tactics) (tier 1) (difficulty 10613) (name tactic-refl) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;engine \x27;rewrite/laws)) (available (make-proof-goal proof-goal? goal-lhs goal-rhs goal-context goal-trivial? tactic-success tactic-failure tactic-success? tactic-failure? tactic-subgoals tactic-builder tactic-error)) (answer "(define (tactic-refl goal) (if (not (proof-goal? goal)) (tactic-failure '(not-a-goal)) (let ((lhs (goal-lhs goal)) (rhs (goal-rhs goal))) (if (equal? lhs rhs) (tactic-success '() (lambda () (quasiquote (refl (unquote lhs))))) (tactic-failure (quasiquote (sides-not-equal (unquote lhs) (unquote rhs))))))))"))
