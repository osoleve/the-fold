(task-entry (id "linalg/vec/vec-drop") (skill linalg) (module vec) (tier 0) (difficulty 415) (name vec-drop) (type "(-> (Vec a) Nat (Or (Vec a) Error))") (description "Drop first n elements") (notes ()) (section vector-transformations) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take)) (answer "(define (vec-drop v n) (let ((len (vector-length v))) (if (> n len) (quasiquote (error out-of-bounds (unquote n) (unquote len))) (let* ((new-len (- len n)) (result (make-vector new-len 0)) (src v) (offset n)) (range-do! i 0 new-len (vector-set! result i (vector-ref src (+ offset i)))) result))))"))
