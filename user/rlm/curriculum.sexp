(task-entry (id "egraph/match/ematch-children") (skill egraph) (module match) (tier 1) (difficulty 10009) (name ematch-children) (type "(-> EGraph (List Pattern) (List EClassId) Substitution (List Substitution))") (description "Match patterns against child e-classes.") (notes ()) (section matching) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern)) (answer "(define (ematch-children eg patterns child-ids subst) (if (null? patterns) (list subst) (let* ((pattern (car patterns)) (child-id (car child-ids)) (first-substs (ematch-pattern eg pattern child-id subst))) (append-map (lambda (s) (ematch-children eg (cdr patterns) (cdr child-ids) s)) first-substs))))"))
(task-entry (id "egraph/saturation/saturation-result?") (skill egraph) (module saturation) (tier 1) (difficulty 10009) (name saturation-result?) (type "(-> Any Boolean)") (description "Check if x is a saturation result.") (notes ()) (section result) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result)) (answer "(define (saturation-result? x) (and (vector? x) (>= (vector-length x) 6) (eq? (vector-ref x 0) saturation-result-tag)))"))
(task-entry (id "egraph/cost/ast-depth-cost") (skill egraph) (module cost) (tier 1) (difficulty 10009) (name ast-depth-cost) (type "") (description "") (notes ()) (section basic-models) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost ast-size-cost)) (answer "(define ast-depth-cost (make-cost-model 'ast-depth (lambda (node child-cost) (let ((children (enode-children node))) (if (zero? (vector-length children)) 1 (+ 1 (fold-left (lambda (acc i) (max acc (child-cost (vector-ref children i)))) 0 (iota (vector-length children)))))))))"))
(task-entry (id "egraph/extract/optimize") (skill egraph) (module extract) (tier 1) (difficulty 10009) (name optimize) (type "(-> Term (List Rule) CostModel Term)") (description "Apply rules via equality saturation, extract optimal form.") (notes ()) (section convenience) (deps (\x27;prelude \x27;egraph/cost \x27;egraph/saturation)) (available (extraction-state-tag make-extraction-state extraction-state? state-egraph state-costs state-best-nodes extract extract-term extract-all)) (answer "(define (optimize term rules cost-model) (let ((eg (make-egraph))) (let ((root (egraph-add-term! eg term))) (saturate-simple eg rules) (let ((state (make-extraction-state eg cost-model))) (extract state root)))))"))
