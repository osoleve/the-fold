(task-entry (id "optics/block-optics/collect-block-tree") (skill optics) (module block-optics) (tier 1) (difficulty 11022) (name collect-block-tree) (type "(-> (-> Bytevector (Maybe Block)) Block (List Block))") (description "Collect all blocks reachable from a root block (DFS).\nDoes not include duplicates (based on refs visited).") (notes ()) (section utilities) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens block-ref-at block-refs-each block-refs-count follow-ref block-child-at block-children-each block-type-prism block-lambda-prism block-app-prism block-ref-prism block-literal-prism block-expr-prism block-payload-string-iso block-payload-as-string-lens block-payload-sexpr-affine >>> block-has-refs? block-is-leaf? block-tag-is?)) (answer "(define (collect-block-tree fetch root) (let ((visited (make-hashtable equal-hash equal?))) (let dfs ((blk root) (acc '())) (let ((refs (block-refs blk))) (let loop ((i 0) (acc (cons blk acc))) (if (= i (vector-length refs)) acc (let ((ref (vector-ref refs i))) (if (hashtable-ref visited ref #f) (loop (+ i 1) acc) (begin (hashtable-set! visited ref #t) (let ((child (fetch ref))) (if child (loop (+ i 1) (dfs child acc)) (loop (+ i 1) acc))))))))))))"))
