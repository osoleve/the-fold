(task-entry (id "linalg/vec/vec-slice") (skill linalg) (module vec) (tier 0) (difficulty 416) (name vec-slice) (type "(-> (Vec a) Nat Nat (Or (Vec a) Error))") (description "Extract slice from start (inclusive) to end (exclusive)") (notes ()) (section vector-transformations) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop)) (answer "(define (vec-slice v start end) (let ((len (vector-length v))) (cond ((< start 0) (quasiquote (error out-of-bounds (unquote start) (unquote len)))) ((> end len) (quasiquote (error out-of-bounds (unquote end) (unquote len)))) ((> start end) (quasiquote (error invalid-range (unquote start) (unquote end)))) (else (let* ((new-len (- end start)) (result (make-vector new-len 0)) (src v) (offset start)) (range-do! i 0 new-len (vector-set! result i (vector-ref src (+ offset i)))) result)))))"))
