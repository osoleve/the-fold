(task-entry (id "random/bayesian/posterior-summary") (skill random) (module bayesian) (tier 1) (difficulty 12949) (name posterior-summary) (type "") (description "") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode log-beta-pdf log-beta log-normal-pdf log-gamma-pdf log-poisson-pmf log-factorial kl-divergence-normal kl-divergence-beta digamma log-marginal-likelihood-beta-binomial log-binomial-coeff log-marginal-likelihood-normal-normal bayes-factor log-bayes-factor interpret-bayes-factor bic aic sequential-beta-update sequential-normal-update sequential-gamma-update)) (answer "(define (posterior-summary prior) (cond ((beta-prior? prior) (quasiquote ((type . beta) (mean unquote (beta-posterior-mean prior)) (mode unquote (beta-posterior-mode prior)) (variance unquote (beta-posterior-variance prior)) (ci-95 unquote (beta-credible-interval prior 0.95))))) ((normal-prior? prior) (quasiquote ((type . normal) (mean unquote (normal-prior-mean prior)) (variance unquote (normal-prior-variance prior)) (ci-95 unquote (normal-posterior-credible-interval prior 0.95))))) ((gamma-prior? prior) (quasiquote ((type . gamma) (mean unquote (gamma-posterior-mean prior)) (mode unquote (gamma-posterior-mode prior)) (variance unquote (gamma-posterior-variance prior))))) ((dirichlet-prior? prior) (quasiquote ((type . dirichlet) (mean unquote (dirichlet-posterior-mean prior)) (mode unquote (dirichlet-posterior-mode prior))))) (else '((type . unknown)))))"))
(task-entry (id "random/variational-inference/vi-step-adam") (skill random) (module variational-inference) (tier 1) (difficulty 12949) (name vi-step-adam) (type "") (description "") (notes ()) (section adam-optimizer-for-vi) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf vi-step-mf make-adam-state adam-state? adam-state-m adam-state-v adam-state-t adam-update)) (answer "(define vi-step-adam (case-lambda ((log-joint vfamily prng adam-state lr) (vi-step-adam log-joint vfamily prng adam-state lr 0.9 0.999 1e-8)) ((log-joint vfamily prng adam-state lr beta1) (vi-step-adam log-joint vfamily prng adam-state lr beta1 0.999 1e-8)) ((log-joint vfamily prng adam-state lr beta1 beta2) (vi-step-adam log-joint vfamily prng adam-state lr beta1 beta2 1e-8)) ((log-joint vfamily prng adam-state lr beta1 beta2 eps) (let* ((d (vfamily-dim vfamily)) (params (vfamily-params vfamily)) (type (cond ((mf-gaussian? vfamily) 'mf-gaussian) ((full-gaussian? vfamily) 'full-gaussian)))) (let-values (((epsilons new-prng) (sample-standard-normals d prng))) (let* ((grad (cond ((mf-gaussian? vfamily) (elbo-gradient-mf log-joint (mf-gaussian-means vfamily) (mf-gaussian-log-stds vfamily) epsilons)) (else (error 'vi-step-adam \"Only mean-field Gaussian supported\"))))) (let-values (((new-adam deltas) (adam-update adam-state grad lr beta1 beta2 eps))) (let* ((new-params (map + params deltas)) (new-vfamily (vfamily-from-params type d new-params))) (values new-vfamily new-prng new-adam)))))))))"))
(task-entry (id "random/distributions/random-categorical") (skill random) (module distributions) (tier 1) (difficulty 12950) (name random-categorical) (type "(-> (List Number) (State RNG Nat))") (description "State monad sampler for categorical distribution") (notes ()) (section categorical-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli bernoulli-pmf random-bernoulli geometric geometric-pmf geometric-cdf geometric-quantile random-geometric poisson poisson-pmf poisson-cdf random-poisson binomial binomial-pmf random-binomial gamma random-gamma beta random-beta categorical)) (answer "(define (random-categorical weights) (if (null? weights) (error 'random-categorical \"empty weight list\") (let ((total (fold-left + 0 weights))) (if (<= total 0) (error 'random-categorical \"weights must sum to positive\" total) (state-bind (random-float-range 0 total) (lambda (r) (state-pure (let loop ((ws weights) (acc 0) (i 0)) (if (null? ws) (- i 1) (let ((new-acc (+ acc (car ws)))) (if (< r new-acc) i (loop (cdr ws) new-acc (+ i 1)))))))))))))"))
