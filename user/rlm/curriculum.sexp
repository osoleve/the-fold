(task-entry (id "geometry/raymarch/raymarch-mesh") (skill geometry) (module raymarch) (tier 1) (difficulty 12206) (name raymarch-mesh) (type "(-> Mesh Ray3 RaymarchParams (Or (List Vec3 Real Nat) #f))") (description "Specialized raymarcher for mesh SDFs (uses BVH acceleration)") (notes ()) (section raymarch-algorithm) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (raymarch-params raymarch-params-max-steps raymarch-params-max-distance raymarch-params-hit-threshold default-raymarch-params raymarch)) (answer "(define (raymarch-mesh mesh ray params) (let ((sdf-fn (lambda (p) (mesh-sdf mesh p)))) (raymarch sdf-fn ray params)))"))
