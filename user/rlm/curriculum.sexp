(task-entry (id "info/entropy/normalized-mutual-information") (skill info) (module entropy) (tier 1) (difficulty 11128) (name normalized-mutual-information) (type "(-> (List (List Number)) (List Number) (List Number) Number)") (description "NMI(X,Y) = I(X;Y) / sqrt(H(X) * H(Y)), normalized to [0, 1]") (notes ()) (section variation-of-information) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy conditional-entropy-direct mutual-information mutual-information-from-joint compute-marginal-x compute-marginal-y cross-entropy kl-divergence symmetric-kl jensen-shannon-divergence gaussian-entropy uniform-entropy exponential-entropy laplace-entropy sample-entropy count-occurrences assoc-helper update-count variation-of-information)) (answer "(define (normalized-mutual-information joint-probs marginal-x marginal-y) (let ((mi (mutual-information joint-probs marginal-x marginal-y)) (h-x (entropy marginal-x)) (h-y (entropy marginal-y))) (if (or (<= h-x 0) (<= h-y 0)) 0 (/ mi (sqrt (* h-x h-y))))))"))
