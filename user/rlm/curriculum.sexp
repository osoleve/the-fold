(task-entry (id "clp/clp/take-solutions") (skill clp) (module clp) (tier 1) (difficulty 10823) (name take-solutions) (type "(-> Nat (Stream CStore) (List LVar) (List (List Int)))") (description "Extract variable values from solution stores") (notes ()) (section running-clp) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp)) (answer "(define (take-solutions n stream vars) (if (or (<= n 0) (stream-nil? stream)) '() (let* ((cs (stream-head stream)) (values (map (lambda (v) (cstore-get-value cs v)) vars))) (cons values (take-solutions (- n 1) (stream-tail stream) vars)))))"))
(task-entry (id "clp/domain/domain-fold") (skill clp) (module domain) (tier 1) (difficulty 10824) (name domain-fold) (type "(-> Domain α (-> Int α α) α)") (description "Fold over domain values") (notes ()) (section domain-enumeration) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals interval<? domain-subtract-value domain-subtract domain-restrict-min domain-restrict-max domain->list domain-for-each)) (answer "(define (domain-fold dom init f) (let loop ((intervals dom) (acc init)) (if (null? intervals) acc (let* ((interval (car intervals)) (lo (car interval)) (hi (cdr interval))) (let inner ((n lo) (acc acc)) (if (> n hi) (loop (cdr intervals) acc) (inner (+ n 1) (f n acc))))))))"))
