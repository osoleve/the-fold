(task-entry (id "data/centrality/all-centralities") (skill data) (module centrality) (tier 0) (difficulty 1322) (name all-centralities) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality standard-closeness-node harmonic-closeness-node closeness-centrality-from-adj closeness-centrality-from-edges betweenness-centrality betweenness-from-source betweenness-centrality-from-edges rank-by-centrality top-k-central centrality-correlation)) (answer "(define (all-centralities adj) (let ((dist (floyd-warshall adj))) (list (cons 'eigenvector (eigenvector-centrality adj)) (cons 'katz (katz-centrality adj)) (cons 'closeness (closeness-centrality dist)) (cons 'betweenness (betweenness-centrality adj)))))"))
(task-entry (id "data/graph-community/community-betti-numbers") (skill data) (module graph-community) (tier 0) (difficulty 1322) (name community-betti-numbers) (type "") (description "") (notes ()) (section community-homology) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find uf-union connected-components is-connected? mst-from-adjacency modularity-ilp compute-degrees compute-modularity-matrix build-modularity-ilp community-induced-edges)) (answer "(define (community-betti-numbers adj nodes) (if (null? nodes) (cons 0 0) (let ((edges (community-induced-edges adj nodes))) (graph-betti-numbers edges nodes))))"))
(task-entry (id "data/graph-layout/*attraction-constant*") (skill data) (module graph-layout) (tier 0) (difficulty 1322) (name *attraction-constant*) (type "") (description "") (notes ()) (section forces) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens graph-nodes-each graph-all-positions graph-all-velocities *repulsion-constant*)) (answer "(define *attraction-constant* 0.005)"))
(task-entry (id "data/kdtree/kdtree-range") (skill data) (module kdtree) (tier 0) (difficulty 1322) (name kdtree-range) (type "(-> KDTree Point Point (List Point))") (description "Find all points within axis-aligned bounding box [min, max].\nO(√n + k) where k is number of results.") (notes ()) (section range-queries) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater? kdtree-knn knn-heap->list kdtree-knn-rec)) (answer "(define (kdtree-range tree min-point max-point) (if (kdtree-empty? tree) '() (let ((k (point-dimension min-point))) (kdtree-range-rec tree min-point max-point k))))"))
(task-entry (id "data/quadtree/*quadtree-max-depth*") (skill data) (module quadtree) (tier 0) (difficulty 1322) (name *quadtree-max-depth*) (type "") (description "Maximum tree depth to prevent infinite recursion on duplicate points") (notes ()) (section construction) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity*)) (answer "(define *quadtree-max-depth* 16)"))
(task-entry (id "data/avl-tree/avl-delete-min-by") (skill data) (module avl-tree) (tier 0) (difficulty 1323) (name avl-delete-min-by) (type "(-> (-> κ κ Boolean) AVL AVL)") (description "") (notes ()) (section deletion) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node rotate-left rotate-right rebalance avl-lookup avl-lookup-by avl-contains? avl-contains-by? avl-insert avl-insert-by avl-min-node avl-max-node avl-delete-min)) (answer "(define (avl-delete-min-by cmp tree) (if (avl-empty? tree) (error 'avl-delete-min \"Cannot delete from empty tree\") (if (avl-empty? (avl-left tree)) (avl-right tree) (rebalance (make-avl-node (avl-key tree) (avl-value tree) (avl-delete-min-by cmp (avl-left tree)) (avl-right tree))))))"))
(task-entry (id "data/sort/nth-smallest") (skill data) (module sort) (tier 0) (difficulty 1323) (name nth-smallest) (type "(-> Nat (List α) α)") (description "Find the nth smallest element (0-indexed)") (notes ("Uses quickselect for O(n) average performance")) (section utilities) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort sort-by-key sort-by-key-desc sort-desc quicksort-desc sorted? sorted-by? sorted-desc? unique-sorted sort-unique)) (answer "(define (nth-smallest n lst) (if (null? lst) (error 'nth-smallest \"List is empty\") (let* ((pivot (car lst)) (parts (partition < pivot (cdr lst))) (lt (car parts)) (eq (cadr parts)) (gt (caddr parts)) (lt-len (length lt))) (cond ((< n lt-len) (nth-smallest n lt)) ((< n (+ lt-len 1 (length eq))) pivot) (else (nth-smallest (- n lt-len 1 (length eq)) gt))))))"))
(task-entry (id "data/heap/heap-size") (skill data) (module heap) (tier 0) (difficulty 1323) (name heap-size) (type "(-> Heap Nat)") (description "Get number of elements in heap.") (notes ("O(n)")) (section bulk-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge heap-insert heap-min heap-peek heap-delete-min heap-pop heap-merge-max heap-insert-max heap-max heap-delete-max heap-pop-max heap-merge-by heap-insert-by heap-delete-top-by)) (answer "(define (heap-size heap) (if (heap-empty? heap) 0 (+ 1 (heap-size (heap-left heap)) (heap-size (heap-right heap)))))"))
(task-entry (id "data/graph-primitives/same-hash-set?") (skill data) (module graph-primitives) (tier 0) (difficulty 1323) (name same-hash-set?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;collection-utils)) (available (bytevector-hash make-visited visited-add visited-contains? visited-remove make-queue queue-empty? queue-normalize queue-enqueue queue-enqueue-all queue-dequeue make-stack stack-empty? stack-push stack-push-all stack-pop hash-equal? hash-in-list? remove-hash unique-hashes path-length unique-cycles cycle-in-list?)) (answer "(define (same-hash-set? lst1 lst2) (and (= (length lst1) (length lst2)) (let ((hash-set (make-hashtable equal-hash equal?))) (for-each (lambda (h) (hashtable-set! hash-set h #t)) lst2) (let loop ((l lst1)) (if (null? l) #t (and (hashtable-contains? hash-set (car l)) (loop (cdr l))))))))"))
(task-entry (id "data/graph-matrix/adjacency-symmetrize") (skill data) (module graph-matrix) (tier 0) (difficulty 1323) (name adjacency-symmetrize) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose)) (answer "(define (adjacency-symmetrize m) (matrix-add m (matrix-transpose m)))"))
(task-entry (id "data/centrality/centrality-summary") (skill data) (module centrality) (tier 0) (difficulty 1323) (name centrality-summary) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality standard-closeness-node harmonic-closeness-node closeness-centrality-from-adj closeness-centrality-from-edges betweenness-centrality betweenness-from-source betweenness-centrality-from-edges rank-by-centrality top-k-central centrality-correlation all-centralities)) (answer "(define (centrality-summary adj) (let* ((n (matrix-rows adj)) (all (all-centralities adj)) (ev-top (car (top-k-central (cdr (assoc 'eigenvector all)) 1))) (katz-top (car (top-k-central (cdr (assoc 'katz all)) 1))) (close-top (car (top-k-central (cdr (assoc 'closeness all)) 1))) (btwn-top (car (top-k-central (cdr (assoc 'betweenness all)) 1)))) (string-append \"Centrality summary for \" (number->string n) \" node graph:\n\" \"  Most influential (eigenvector): node \" (number->string (car ev-top)) \"\n\" \"  Best connected (Katz): node \" (number->string (car katz-top)) \"\n\" \"  Most central (closeness): node \" (number->string (car close-top)) \"\n\" \"  Most bridge-like (betweenness): node \" (number->string (car btwn-top)))))"))
(task-entry (id "data/graph-community/all-communities-betti") (skill data) (module graph-community) (tier 0) (difficulty 1323) (name all-communities-betti) (type "") (description "") (notes ()) (section community-homology) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find uf-union connected-components is-connected? mst-from-adjacency modularity-ilp compute-degrees compute-modularity-matrix build-modularity-ilp community-induced-edges community-betti-numbers)) (answer "(define (all-communities-betti adj labels) (let* ((n (vector-length labels)) (groups (make-hashtable equal-hash equal?))) (do ((i 0 (+ i 1))) ((= i n)) (let* ((lbl (vector-ref labels i)) (existing (hashtable-ref groups lbl '()))) (hashtable-set! groups lbl (cons i existing)))) (let* ((keys (hashtable-keys groups)) (sorted-keys (sort-by < (vector->list keys)))) (map (lambda (lbl) (let* ((nodes (reverse (hashtable-ref groups lbl '()))) (size (length nodes)) (betti (community-betti-numbers adj nodes)) (b0 (car betti)) (b1 (cdr betti))) (list lbl size b0 b1))) sorted-keys))))"))
(task-entry (id "data/graph-layout/*gravity-constant*") (skill data) (module graph-layout) (tier 0) (difficulty 1323) (name *gravity-constant*) (type "") (description "") (notes ()) (section forces) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens graph-nodes-each graph-all-positions graph-all-velocities *repulsion-constant* *attraction-constant*)) (answer "(define *gravity-constant* 0.01)"))
(task-entry (id "data/kdtree/kdtree-range-rec") (skill data) (module kdtree) (tier 0) (difficulty 1323) (name kdtree-range-rec) (type "") (description "") (notes ()) (section range-queries) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater? kdtree-knn knn-heap->list kdtree-knn-rec kdtree-range)) (answer "(define (kdtree-range-rec tree min-pt max-pt k) (if (kdtree-empty? tree) '() (let* ((node-point (kdtree-point tree)) (depth (kdtree-depth tree)) (axis (modulo depth k)) (node-coord (point-coord node-point axis)) (min-coord (point-coord min-pt axis)) (max-coord (point-coord max-pt axis)) (in-range? (point-in-box? node-point min-pt max-pt)) (search-left? (<= min-coord node-coord)) (search-right? (>= max-coord node-coord))) (append (if in-range? (list node-point) '()) (if search-left? (kdtree-range-rec (kdtree-left tree) min-pt max-pt k) '()) (if search-right? (kdtree-range-rec (kdtree-right tree) min-pt max-pt k) '())))))"))
(task-entry (id "data/quadtree/quadtree-create") (skill data) (module quadtree) (tier 0) (difficulty 1323) (name quadtree-create) (type "(-> Bounds Quadtree)") (description "Create an empty quadtree with given bounds") (notes ()) (section construction) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth*)) (answer "(define (quadtree-create bounds) (quadtree-leaf bounds '()))"))
(task-entry (id "data/avl-tree/avl-delete") (skill data) (module avl-tree) (tier 0) (difficulty 1324) (name avl-delete) (type "(-> κ AVL AVL)") (description "Delete key from tree. Returns unchanged tree if key not found") (notes ()) (section deletion) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node rotate-left rotate-right rebalance avl-lookup avl-lookup-by avl-contains? avl-contains-by? avl-insert avl-insert-by avl-min-node avl-max-node avl-delete-min avl-delete-min-by)) (answer "(define (avl-delete key tree) (avl-delete-by < key tree))"))
(task-entry (id "data/sort/median") (skill data) (module sort) (tier 0) (difficulty 1324) (name median) (type "(-> (List α) α)") (description "Find the median element") (notes ()) (section utilities) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort sort-by-key sort-by-key-desc sort-desc quicksort-desc sorted? sorted-by? sorted-desc? unique-sorted sort-unique nth-smallest)) (answer "(define (median lst) (let ((len (length lst))) (if (= len 0) (error 'median \"Cannot find median of empty list\") (nth-smallest (quotient len 2) lst))))"))
(task-entry (id "data/heap/heap-fold") (skill data) (module heap) (tier 0) (difficulty 1324) (name heap-fold) (type "(-> (-> β α β) β Heap β)") (description "Fold over all heap elements via tree traversal. Order is unspecified (not heap order).") (notes ("O(n)" "Tail-recursive on left spine (potentially O(n)), standard recursive on right spine (O(log n) by leftist property).")) (section bulk-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge heap-insert heap-min heap-peek heap-delete-min heap-pop heap-merge-max heap-insert-max heap-max heap-delete-max heap-pop-max heap-merge-by heap-insert-by heap-delete-top-by heap-size)) (answer "(define (heap-fold fn init heap) (if (heap-empty? heap) init (let* ((acc (fn init (heap-value heap))) (acc-right (heap-fold fn acc (heap-right heap)))) (heap-fold fn acc-right (heap-left heap)))))"))
(task-entry (id "data/graph-matrix/adjacency-symmetrize-sparse") (skill data) (module graph-matrix) (tier 0) (difficulty 1324) (name adjacency-symmetrize-sparse) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize)) (answer "(define (adjacency-symmetrize-sparse m) (sparse-csr-add m (sparse-csr-transpose m)))"))
(task-entry (id "data/graph-community/community-homology-quality") (skill data) (module graph-community) (tier 0) (difficulty 1324) (name community-homology-quality) (type "") (description "") (notes ()) (section community-homology) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find uf-union connected-components is-connected? mst-from-adjacency modularity-ilp compute-degrees compute-modularity-matrix build-modularity-ilp community-induced-edges community-betti-numbers all-communities-betti)) (answer "(define (community-homology-quality size b0 b1) (cond ((= size 0) 0.0) ((= b0 0) 0.0) ((= size 1) 0.5) (else (let* ((connectivity (sqrt (/ 1.0 b0))) (max-b1 (/ (* (- size 1) (- size 2)) 2)) (cycle-density (if (> max-b1 0) (min 1.0 (/ b1 max-b1)) 0.0)) (score (+ (* 0.7 connectivity) (* 0.3 cycle-density)))) score))))"))
(task-entry (id "data/graph-layout/*damping*") (skill data) (module graph-layout) (tier 0) (difficulty 1324) (name *damping*) (type "") (description "") (notes ()) (section forces) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens graph-nodes-each graph-all-positions graph-all-velocities *repulsion-constant* *attraction-constant* *gravity-constant*)) (answer "(define *damping* 0.85)"))
(task-entry (id "data/kdtree/point-in-box?") (skill data) (module kdtree) (tier 0) (difficulty 1324) (name point-in-box?) (type "(-> Point Point Point Boolean)") (description "Check if point is within axis-aligned bounding box [min, max] (inclusive)") (notes ()) (section range-queries) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater? kdtree-knn knn-heap->list kdtree-knn-rec kdtree-range kdtree-range-rec)) (answer "(define (point-in-box? point min-pt max-pt) (let loop ((pt point) (lo min-pt) (hi max-pt)) (cond ((null? pt) #t) ((or (< (car pt) (car lo)) (> (car pt) (car hi))) #f) (else (loop (cdr pt) (cdr lo) (cdr hi))))))"))
(task-entry (id "data/quadtree/quadtree-build") (skill data) (module quadtree) (tier 0) (difficulty 1324) (name quadtree-build) (type "(-> (List Point) Bounds Quadtree)") (description "Build a quadtree from a list of 2D points (each point is (x y))") (notes ()) (section construction) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create)) (answer "(define (quadtree-build points bounds) (fold-left (lambda (tree pt) (quadtree-insert tree (car pt) (cadr pt) pt)) (quadtree-create bounds) points))"))
(task-entry (id "data/avl-tree/avl-delete-by") (skill data) (module avl-tree) (tier 0) (difficulty 1325) (name avl-delete-by) (type "(-> (-> κ κ Boolean) κ AVL AVL)") (description "") (notes ()) (section deletion) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node rotate-left rotate-right rebalance avl-lookup avl-lookup-by avl-contains? avl-contains-by? avl-insert avl-insert-by avl-min-node avl-max-node avl-delete-min avl-delete-min-by avl-delete)) (answer "(define (avl-delete-by cmp key tree) (if (avl-empty? tree) tree (let ((k (avl-key tree)) (v (avl-value tree)) (left (avl-left tree)) (right (avl-right tree))) (cond ((cmp key k) (rebalance (make-avl-node k v (avl-delete-by cmp key left) right))) ((cmp k key) (rebalance (make-avl-node k v left (avl-delete-by cmp key right)))) (else (cond ((avl-empty? left) right) ((avl-empty? right) left) (else (let ((succ (avl-min-node right))) (rebalance (make-avl-node (car succ) (cdr succ) left (avl-delete-min-by cmp right)))))))))))"))
(task-entry (id "data/sort/min-element") (skill data) (module sort) (tier 0) (difficulty 1325) (name min-element) (type "(-> (List α) α)") (description "Find minimum element") (notes ("O(n)")) (section utilities) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort sort-by-key sort-by-key-desc sort-desc quicksort-desc sorted? sorted-by? sorted-desc? unique-sorted sort-unique nth-smallest median)) (answer "(define (min-element lst) (if (null? lst) (error 'min-element \"Cannot find min of empty list\") (fold-left (lambda (m x) (if (< x m) x m)) (car lst) (cdr lst))))"))
(task-entry (id "data/heap/list->heap") (skill data) (module heap) (tier 0) (difficulty 1325) (name list->heap) (type "(-> (List α) Heap)") (description "Build min-heap from list.") (notes ("O(n log n)")) (section bulk-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge heap-insert heap-min heap-peek heap-delete-min heap-pop heap-merge-max heap-insert-max heap-max heap-delete-max heap-pop-max heap-merge-by heap-insert-by heap-delete-top-by heap-size heap-fold)) (answer "(define (list->heap lst) (fold-left (lambda (h x) (heap-insert x h)) heap-empty lst))"))
(task-entry (id "data/graph-matrix/degree-matrix") (skill data) (module graph-matrix) (tier 0) (difficulty 1325) (name degree-matrix) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize adjacency-symmetrize-sparse)) (answer "(define (degree-matrix m . mode-opt) (let* ((mode (if (null? mode-opt) 'out (car mode-opt))) (n (adjacency-matrix-node-count m)) (degrees (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! degrees i (case mode ((out) (adjacency-out-degree m i)) ((in) (adjacency-in-degree m i)) ((total) (+ (adjacency-out-degree m i) (adjacency-in-degree m i)))))) (diagonal degrees)))"))
(task-entry (id "data/graph-community/aggregate-community-quality") (skill data) (module graph-community) (tier 0) (difficulty 1325) (name aggregate-community-quality) (type "") (description "") (notes ()) (section community-homology) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find uf-union connected-components is-connected? mst-from-adjacency modularity-ilp compute-degrees compute-modularity-matrix build-modularity-ilp community-induced-edges community-betti-numbers all-communities-betti community-homology-quality)) (answer "(define (aggregate-community-quality adj labels) (let* ((betti-list (all-communities-betti adj labels)) (n (vector-length labels)) (weighted-sum 0.0)) (for-each (lambda (entry) (let* ((size (cadr entry)) (b0 (caddr entry)) (b1 (cadddr entry)) (quality (community-homology-quality size b0 b1)) (weight (/ size n))) (set! weighted-sum (+ weighted-sum (* weight quality))))) betti-list) weighted-sum))"))
(task-entry (id "data/graph-layout/*min-distance*") (skill data) (module graph-layout) (tier 0) (difficulty 1325) (name *min-distance*) (type "") (description "") (notes ()) (section forces) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens graph-nodes-each graph-all-positions graph-all-velocities *repulsion-constant* *attraction-constant* *gravity-constant* *damping*)) (answer "(define *min-distance* 10.0)"))
(task-entry (id "data/kdtree/kdtree-radius") (skill data) (module kdtree) (tier 0) (difficulty 1325) (name kdtree-radius) (type "(-> KDTree Point Num (List Point))") (description "Find all points within radius of center point.\nUses range query for initial filtering, then distance check.") (notes ()) (section range-queries) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater? kdtree-knn knn-heap->list kdtree-knn-rec kdtree-range kdtree-range-rec point-in-box?)) (answer "(define (kdtree-radius tree center radius) (if (kdtree-empty? tree) '() (let* ((k (point-dimension center)) (min-pt (map (lambda (c) (- c radius)) center)) (max-pt (map (lambda (c) (+ c radius)) center)) (candidates (kdtree-range tree min-pt max-pt)) (radius-sq (* radius radius))) (filter (lambda (pt) (<= (point-distance-sq pt center) radius-sq)) candidates))))"))
(task-entry (id "data/quadtree/quadtree-build-auto") (skill data) (module quadtree) (tier 0) (difficulty 1325) (name quadtree-build-auto) (type "(-> (List Point) Quadtree)") (description "Build quadtree with auto-computed bounds from points") (notes ()) (section construction) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build)) (answer "(define (quadtree-build-auto points) (if (null? points) quadtree-empty (let* ((xs (map car points)) (ys (map cadr points)) (min-x (apply min xs)) (max-x (apply max xs)) (min-y (apply min ys)) (max-y (apply max ys)) (cx (/ (+ min-x max-x) 2)) (cy (/ (+ min-y max-y) 2)) (hw (/ (- max-x min-x) 2)) (hh (/ (- max-y min-y) 2)) (hw+ (if (zero? hw) 1 (* hw 1.01))) (hh+ (if (zero? hh) 1 (* hh 1.01)))) (quadtree-build points (make-bounds cx cy hw+ hh+)))))"))
