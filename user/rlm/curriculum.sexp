mpute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant matrix-determinant-lu find-pivot-row-det swap-rows-det! analyze-bifurcations count-stability-changes *branch-switch-perturbation* *branch-switch-tolerance* *branch-switch-max-iter* compute-critical-eigenvector find-min-singular-value-index switch-branch switch-branch-adaptive)) (answer "(define (continue-switched-branch psys param fp num-steps step-size) (continue-fixed-point-arclength psys param fp num-steps step-size))"))
(task-entry (id "sim/bifurcation/find-all-branches-at-bifurcation") (skill sim) (module bifurcation) (tier 2) (difficulty 23406) (name find-all-branches-at-bifurcation) (type "(-> ParamODE Number Vec (List (Pair Symbol Vec)))") (description "Find all fixed point branches at a bifurcation") (notes ("At pitchfork: returns 3 branches (original + upper + lower).\nAt transcritical: returns 2 branches that exchange stability.")) (section branch-switching) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant matrix-determinant-lu find-pivot-row-det swap-rows-det! analyze-bifurcations count-stability-changes *branch-switch-perturbation* *branch-switch-tolerance* *branch-switch-max-iter* compute-critical-eigenvector find-min-singular-value-index switch-branch switch-branch-adaptive continue-switched-branch)) (answer "(define (find-all-branches-at-bifurcation psys param fp) (let* ((upper (switch-branch-adaptive psys param fp 'upper)) (lower (switch-branch-adaptive psys param fp 'lower)) (branches (list (cons 'original fp)))) (let* ((with-upper (if (and upper (car upper)) (cons (cons 'upper (car upper)) branches) branches)) (with-lower (if (and lower (car lower) (or (not upper) (not (car upper)) (let* ((upper-param (cdr upper)) (lower-param (cdr lower))) (if (< (abs (- upper-param lower-param)) 1e-10) (> (vec-norm (vec-sub (car lower) (car upper))) 1e-6) (let* ((sys-at-upper (instantiate-at psys upper-param)) (lower-projected (find-fixed-point-robust sys-at-upper (car lower) *branch-switch-tolerance* *continuation-step-size* *branch-switch-max-iter*))) (or (not lower-projected) (> (vec-norm (vec-sub lower-projected (car upper))) 1e-6))))))) (cons (cons 'lower (car lower)) with-upper) with-upper))) with-lower)))"))
