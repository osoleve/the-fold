(task-entry (id "egraph/egraph/egraph-node-count") (skill egraph) (module egraph) (tier 1) (difficulty 10025) (name egraph-node-count) (type "(-> EGraph Nat)") (description "Total number of e-nodes in the e-graph.") (notes ()) (section introspection) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup egraph-add-enode! egraph-merge! egraph-rebuild! egraph-saturate-rebuild! egraph-add-term! egraph-class-count)) (answer "(define (egraph-node-count eg) (eclass-node-count (egraph-classes eg) (egraph-uf eg)))"))
(task-entry (id "egraph/match/pattern->string") (skill egraph) (module match) (tier 1) (difficulty 10025) (name pattern->string) (type "(-> Pattern String)") (description "Convert pattern to string for debugging.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref eclass-ref? eclass-ref-id pattern-apply make-rule rule-lhs rule-rhs rule? apply-rule add-instantiated-term apply-rules subst->string)) (answer "(define (pattern->string pattern) (cond ((pattern-var? pattern) (symbol->string pattern)) ((symbol? pattern) (symbol->string pattern)) ((number? pattern) (number->string pattern)) ((pair? pattern) (string-append \"(\" (symbol->string (car pattern)) \" \" (apply string-append (map (lambda (p) (string-append (pattern->string p) \" \")) (cdr pattern))) \")\")) (else \"?\")))"))
(task-entry (id "egraph/saturation/full-arith-rules") (skill egraph) (module saturation) (tier 1) (difficulty 10025) (name full-arith-rules) (type "") (description "") (notes ()) (section rulesets) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate saturate-iteration saturate-simple saturate-with-fuel arith-identity-rules arith-comm-rules arith-assoc-rules arith-distrib-rules basic-arith-rules)) (answer "(define full-arith-rules (append arith-identity-rules arith-comm-rules arith-assoc-rules arith-distrib-rules))"))
(task-entry (id "egraph/scheduler/should-run?") (skill egraph) (module scheduler) (tier 1) (difficulty 10025) (name should-run?) (type "(-> RuleStats Boolean)") (description "Check if rule should run based on priority.") (notes ()) (section backoff) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler)) (answer "(define (should-run? stats) (let ((priority (stats-priority stats))) (or (>= priority 0.5) (< (random 1.0) priority))))"))
(task-entry (id "egraph/eclass/eclass-merge!") (skill egraph) (module eclass) (tier 1) (difficulty 10026) (name eclass-merge!) (type "(-> EClassStore UnionFind EClassId EClassId (List EClassId))") (description "Merge e-class data, returns parent IDs needing rebuild.") (notes ()) (section merge) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity! eclass-get eclass-get-or-create! eclass-add-node! eclass-add-parent! eclass-get-nodes eclass-get-parents)) (answer "(define (eclass-merge! store uf id1 id2) (let* ((new-root (uf-find uf id1)) (data1 (eclass-get store id1)) (data2 (eclass-get store id2))) (cond ((and (= id1 id2) (= id1 new-root)) '()) (else (let* ((target-data (eclass-get-or-create! store new-root)) (target-parents (eclass-parents target-data)) (affected-set (make-eqv-hashtable))) (define (merge-parents-from! data) (when data (for-each (lambda (p) (hashtable-set! target-parents p #t) (hashtable-set! affected-set p #t)) (vector->list (hashtable-keys (eclass-parents data)))))) (when (and data1 (not (= id1 new-root))) (eclass-set-nodes! target-data (append (eclass-nodes data1) (eclass-nodes target-data))) (merge-parents-from! data1)) (when (and data2 (not (= id2 new-root)) (not (= id2 id1))) (eclass-set-nodes! target-data (append (eclass-nodes data2) (eclass-nodes target-data))) (merge-parents-from! data2)) (for-each (lambda (p) (hashtable-set! affected-set p #t)) (vector->list (hashtable-keys target-parents))) (vector->list (hashtable-keys affected-set)))))))"))
(task-entry (id "egraph/egraph/egraph-size") (skill egraph) (module egraph) (tier 1) (difficulty 10026) (name egraph-size) (type "(-> EGraph Nat)") (description "Total elements created in the e-graph.") (notes ()) (section introspection) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup egraph-add-enode! egraph-merge! egraph-rebuild! egraph-saturate-rebuild! egraph-add-term! egraph-class-count egraph-node-count)) (answer "(define (egraph-size eg) (uf-size (egraph-uf eg)))"))
(task-entry (id "egraph/saturation/result->string") (skill egraph) (module saturation) (tier 1) (difficulty 10026) (name result->string) (type "(-> SaturationResult String)") (description "Convert saturation result to string.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate saturate-iteration saturate-simple saturate-with-fuel arith-identity-rules arith-comm-rules arith-assoc-rules arith-distrib-rules basic-arith-rules full-arith-rules)) (answer "(define (result->string r) (format \"SaturationResult(~a, iters=~a, applied=~a, classes=~a, nodes=~a)\" (result-status r) (result-iterations r) (result-rules-applied r) (result-final-classes r) (result-final-nodes r)))"))
(task-entry (id "egraph/scheduler/find-stats") (skill egraph) (module scheduler) (tier 1) (difficulty 10026) (name find-stats) (type "(-> (List RuleStats) Rule (Or RuleStats #f))") (description "") (notes ()) (section backoff) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler should-run?)) (answer "(define (find-stats state rule) (find (lambda (s) (equal? (stats-rule s) rule)) state))"))
(task-entry (id "egraph/eclass/eclass-node-count") (skill egraph) (module eclass) (tier 1) (difficulty 10027) (name eclass-node-count) (type "(-> EClassStore UnionFind Nat)") (description "Count total e-nodes in all e-classes.") (notes ()) (section introspection) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity! eclass-get eclass-get-or-create! eclass-add-node! eclass-add-parent! eclass-get-nodes eclass-get-parents eclass-merge!)) (answer "(define (eclass-node-count store uf) (let ((data-vec (eclass-store-data store)) (n (uf-size uf)) (count 0)) (do ((i 0 (+ i 1))) ((>= i n) count) (when (and (< i (vector-length data-vec)) (= i (uf-find uf i))) (let ((data (vector-ref data-vec i))) (when data (set! count (+ count (length (eclass-nodes data))))))))))"))
(task-entry (id "egraph/egraph/egraph-stats-report") (skill egraph) (module egraph) (tier 1) (difficulty 10027) (name egraph-stats-report) (type "(-> EGraph Alist)") (description "Get e-graph statistics as alist.") (notes ()) (section introspection) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup egraph-add-enode! egraph-merge! egraph-rebuild! egraph-saturate-rebuild! egraph-add-term! egraph-class-count egraph-node-count egraph-size)) (answer "(define (egraph-stats-report eg) (quasiquote ((classes unquote (egraph-class-count eg)) (nodes unquote (egraph-node-count eg)) (adds unquote (egraph-stat-adds eg)) (merges unquote (egraph-stat-merges eg)) (rebuilds unquote (egraph-stat-rebuilds eg)) (hashcons-hits unquote (egraph-stat-hits eg)) (dirty unquote (length (egraph-dirty eg))))))"))
(task-entry (id "egraph/saturation/saturation-debug") (skill egraph) (module saturation) (tier 1) (difficulty 10027) (name saturation-debug) (type "(-> EGraph (List Rule) SaturationConfig Void)") (description "Run saturation with debug output.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag make-saturation-result saturation-result? result-status result-iterations result-rules-applied result-final-classes result-final-nodes result-saturated? saturate saturate-iteration saturate-simple saturate-with-fuel arith-identity-rules arith-comm-rules arith-assoc-rules arith-distrib-rules basic-arith-rules full-arith-rules result->string)) (answer "(define (saturation-debug eg rules config) (printf \"Starting saturation with ~a rules~n\" (length rules)) (printf \"Config: fuel=~a, node-limit=~a, iter-limit=~a~n\" (config-fuel config) (config-node-limit config) (config-iter-limit config)) (printf \"Initial: ~a classes, ~a nodes~n\" (egraph-class-count eg) (egraph-node-count eg)) (let ((result (saturate eg rules config))) (printf \"Result: ~a~n\" (result->string result)) result))"))
(task-entry (id "egraph/scheduler/update-stats!") (skill egraph) (module scheduler) (tier 1) (difficulty 10027) (name update-stats!) (type "(-> RuleStats Nat Void)") (description "Update rule statistics based on match count.") (notes ()) (section backoff) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler should-run? find-stats)) (answer "(define (update-stats! stats matches) (stats-set-total-matches! stats (+ (stats-total-matches stats) matches)) (stats-set-last-matches! stats matches) (if (zero? matches) (begin (stats-set-zero-streaks! stats (+ (stats-zero-streaks stats) 1)) (when (>= (stats-zero-streaks stats) *backoff-threshold*) (let ((new-priority (* (stats-priority stats) *backoff-factor*))) (stats-set-priority! stats (max *min-priority* new-priority))))) (begin (stats-set-zero-streaks! stats 0) (let ((new-priority (* (stats-priority stats) *recovery-boost*))) (stats-set-priority! stats (min 1.0 new-priority))))))"))
(task-entry (id "egraph/eclass/eclass-all-nodes") (skill egraph) (module eclass) (tier 1) (difficulty 10028) (name eclass-all-nodes) (type "(-> EClassStore UnionFind (List (Pair EClassId (List ENode))))") (description "Get all e-classes with their nodes as (id . nodes) pairs.") (notes ()) (section introspection) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity! eclass-get eclass-get-or-create! eclass-add-node! eclass-add-parent! eclass-get-nodes eclass-get-parents eclass-merge! eclass-node-count)) (answer "(define (eclass-all-nodes store uf) (let ((data-vec (eclass-store-data store)) (n (uf-size uf)) (result '())) (do ((i 0 (+ i 1))) ((>= i n) (reverse result)) (when (and (< i (vector-length data-vec)) (= i (uf-find uf i))) (let ((data (vector-ref data-vec i))) (when (and data (pair? (eclass-nodes data))) (set! result (cons (cons i (eclass-nodes data)) result))))))))"))
(task-entry (id "egraph/egraph/egraph-class-nodes") (skill egraph) (module egraph) (tier 1) (difficulty 10028) (name egraph-class-nodes) (type "(-> EGraph EClassId (List ENode))") (description "Get all e-nodes in an e-class.") (notes ()) (section introspection) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup egraph-add-enode! egraph-merge! egraph-rebuild! egraph-saturate-rebuild! egraph-add-term! egraph-class-count egraph-node-count egraph-size egraph-stats-report)) (answer "(define (egraph-class-nodes eg id) (let ((root (egraph-find eg id))) (eclass-get-nodes (egraph-classes eg) root)))"))
(task-entry (id "egraph/scheduler/make-worklist-scheduler") (skill egraph) (module scheduler) (tier 1) (difficulty 10028) (name make-worklist-scheduler) (type "(-> Scheduler)") (description "Create a worklist-based scheduler.") (notes ()) (section worklist) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler should-run? find-stats update-stats!)) (answer "(define (make-worklist-scheduler) (make-scheduler 'worklist (lambda (rules) (cons rules '())) (lambda (state eg) (let ((rules (car state)) (worklist (cdr state)) (all-roots (uf-roots (egraph-uf eg)))) (let ((classes (if (null? worklist) all-roots worklist))) (cons (cons rules '()) classes)))) (lambda (state rule matches) state)))"))
(task-entry (id "egraph/eclass/op->string") (skill egraph) (module eclass) (tier 1) (difficulty 10029) (name op->string) (type "") (description "") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity! eclass-get eclass-get-or-create! eclass-add-node! eclass-add-parent! eclass-get-nodes eclass-get-parents eclass-merge! eclass-node-count eclass-all-nodes)) (answer "(define (op->string op) (cond ((symbol? op) (symbol->string op)) ((number? op) (number->string op)) ((string? op) (string-append \"\"\" op \"\"\")) ((boolean? op) (if op \"#t\" \"#f\")) ((char? op) (string-append \"#\\\" (string op))) (else (format \"~s\" op))))"))
(task-entry (id "egraph/egraph/egraph-debug") (skill egraph) (module egraph) (tier 1) (difficulty 10029) (name egraph-debug) (type "(-> EGraph Void)") (description "Print e-graph state for debugging.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find egraph-lookup egraph-add-enode! egraph-merge! egraph-rebuild! egraph-saturate-rebuild! egraph-add-term! egraph-class-count egraph-node-count egraph-size egraph-stats-report egraph-class-nodes)) (answer "(define (egraph-debug eg) (let ((stats (egraph-stats-report eg))) (printf \"E-Graph:~n\") (printf \"  Classes: ~a~n\" (cdr (assq 'classes stats))) (printf \"  Nodes: ~a~n\" (cdr (assq 'nodes stats))) (printf \"  Adds: ~a, Merges: ~a, Rebuilds: ~a~n\" (cdr (assq 'adds stats)) (cdr (assq 'merges stats)) (cdr (assq 'rebuilds stats))) (printf \"  Hashcons hits: ~a~n\" (cdr (assq 'hashcons-hits stats))) (printf \"  Dirty: ~a~n\" (cdr (assq 'dirty stats))) (printf \"~nClasses:~n\") (let* ((uf (egraph-uf eg)) (classes (egraph-classes eg)) (all (eclass-all-nodes classes uf))) (for-each (lambda (entry) (let ((id (car entry)) (nodes (cdr entry))) (printf \"  e~a: ~a~n\" id (map enode->string nodes)))) all))))"))
(task-entry (id "egraph/scheduler/make-priority-scheduler") (skill egraph) (module scheduler) (tier 1) (difficulty 10029) (name make-priority-scheduler) (type "(-> Scheduler)") (description "Create a priority-based scheduler.") (notes ()) (section priority) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler should-run? find-stats update-stats! make-worklist-scheduler)) (answer "(define (make-priority-scheduler) (make-scheduler 'priority (lambda (rules) (map make-rule-stats rules)) (lambda (state eg) (let* ((sorted (sort-by (lambda (a b) (> (stats-priority a) (stats-priority b))) state)) (rules (map stats-rule sorted))) (cons state (uf-roots (egraph-uf eg))))) (lambda (state rule matches) (let ((stats (find-stats state rule))) (when stats (update-stats! stats matches))) state)))"))
(task-entry (id "egraph/eclass/enode->string") (skill egraph) (module eclass) (tier 1) (difficulty 10030) (name enode->string) (type "(-> ENode String)") (description "Convert e-node to string representation.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity! eclass-get eclass-get-or-create! eclass-add-node! eclass-add-parent! eclass-get-nodes eclass-get-parents eclass-merge! eclass-node-count eclass-all-nodes op->string)) (answer "(define (enode->string enode) (let ((children (enode-children enode))) (if (zero? (vector-length children)) (op->string (enode-op enode)) (string-append \"(\" (op->string (enode-op enode)) \" \" (let loop ((i 0) (acc \"\")) (if (>= i (vector-length children)) acc (loop (+ i 1) (string-append acc (if (> i 0) \" \" \"\") \"e\" (number->string (vector-ref children i)))))) \")\"))))"))
(task-entry (id "egraph/scheduler/saturate-scheduled") (skill egraph) (module scheduler) (tier 1) (difficulty 10030) (name saturate-scheduled) (type "(-> EGraph (List Rule) Scheduler SaturationConfig SaturationResult)") (description "Run saturation with custom scheduling.") (notes ()) (section saturate) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler should-run? find-stats update-stats! make-worklist-scheduler make-priority-scheduler)) (answer "(define (saturate-scheduled eg rules scheduler config) (let* ((init-fn (scheduler-init scheduler)) (select-fn (scheduler-select scheduler)) (update-fn (scheduler-update scheduler)) (state (init-fn rules)) (fuel (config-fuel config)) (node-limit (config-node-limit config)) (iter-limit (config-iter-limit config))) (let loop ((iteration 0) (total-applied 0) (sched-state state)) (cond ((and (> fuel 0) (>= total-applied fuel)) (make-saturation-result 'fuel-exhausted iteration total-applied (egraph-class-count eg) (egraph-node-count eg))) ((and (> node-limit 0) (> (egraph-node-count eg) node-limit)) (make-saturation-result 'node-limit iteration total-applied (egraph-class-count eg) (egraph-node-count eg))) (else (let* ((selection (select-fn sched-state eg)) (new-state (car selection)) (classes (cdr selection)) (active-rules (cond ((and (pair? new-state) (rule-stats? (car new-state))) (map stats-rule new-state)) ((and (pair? new-state) (list? (car new-state)) (list? (cdr new-state))) (car new-state)) ((and (pair? new-state) (pair? (car new-state))) new-state) (else rules))) (applied (scheduled-iteration eg active-rules classes iter-limit))) (let ((updated-state (fold-left (lambda (s r) (update-fn s r 0)) new-state active-rules))) (egraph-rebuild! eg) (cond ((zero? applied) (make-saturation-result 'saturated iteration total-applied (egraph-class-count eg) (egraph-node-count eg))) (else (loop (+ iteration 1) (+ total-applied applied) updated-state))))))))))"))
(task-entry (id "egraph/eclass/eclass-debug") (skill egraph) (module eclass) (tier 1) (difficulty 10031) (name eclass-debug) (type "(-> EClassStore UnionFind EClassId Void)") (description "Print e-class contents.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal? enode-hash eclass-tag make-eclass-data eclass-data? eclass-nodes eclass-parents eclass-set-nodes! eclass-store-tag make-eclass-store eclass-store? eclass-store-data ensure-eclass-capacity! eclass-get eclass-get-or-create! eclass-add-node! eclass-add-parent! eclass-get-nodes eclass-get-parents eclass-merge! eclass-node-count eclass-all-nodes op->string enode->string)) (answer "(define (eclass-debug store uf id) (let* ((root (uf-find uf id)) (data (eclass-get store root))) (printf \"E-Class ~a (root: ~a)~n\" id root) (if data (begin (printf \"  Nodes: ~a~n\" (length (eclass-nodes data))) (for-each (lambda (n) (printf \"    ~a~n\" (enode->string n))) (eclass-nodes data)) (printf \"  Parents: ~a~n\" (hashtable-keys (eclass-parents data)))) (printf \"  (empty)~n\"))))"))
(task-entry (id "egraph/scheduler/scheduled-iteration") (skill egraph) (module scheduler) (tier 1) (difficulty 10031) (name scheduled-iteration) (type "(-> EGraph (List Rule) (List ClassId) Nat Nat)") (description "Apply rules to specific classes.") (notes ()) (section saturate) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler should-run? find-stats update-stats! make-worklist-scheduler make-priority-scheduler saturate-scheduled)) (answer "(define (scheduled-iteration eg rules classes limit) (let ((count 0) (stop #f)) (for-each (lambda (class-id) (unless stop (for-each (lambda (rule) (unless stop (let ((matches (ematch eg (rule-lhs rule) class-id))) (for-each (lambda (subst) (unless stop (let* ((rhs-term (pattern-apply subst (rule-rhs rule))) (rhs-id (add-instantiated-term eg rhs-term)) (class-root (egraph-find eg class-id)) (rhs-root (egraph-find eg rhs-id))) (unless (= class-root rhs-root) (egraph-merge! eg class-id rhs-id) (set! count (+ count 1)) (when (and (> limit 0) (>= count limit)) (set! stop #t)))))) matches)))) rules))) classes) count))"))
(task-entry (id "egraph/scheduler/optimize-scheduled") (skill egraph) (module scheduler) (tier 1) (difficulty 10032) (name optimize-scheduled) (type "(-> Term (List Rule) CostModel Scheduler Term)") (description "Optimize with custom scheduling.") (notes ()) (section convenience) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler should-run? find-stats update-stats! make-worklist-scheduler make-priority-scheduler saturate-scheduled scheduled-iteration)) (answer "(define (optimize-scheduled term rules cost-model scheduler) (let ((eg (make-egraph))) (let ((root (egraph-add-term! eg term))) (saturate-scheduled eg rules scheduler (default-saturation-config)) (let ((state (make-extraction-state eg cost-model))) (extract state root)))))"))
(task-entry (id "egraph/scheduler/scheduler->string") (skill egraph) (module scheduler) (tier 1) (difficulty 10033) (name scheduler->string) (type "(-> Scheduler String)") (description "Convert scheduler to string.") (notes ()) (section debug) (deps (\x27;prelude \x27;egraph/saturation \x27;sort)) (available (rule-stats-tag make-rule-stats rule-stats? stats-rule stats-total-matches stats-last-matches stats-zero-streaks stats-priority stats-set-total-matches! stats-set-last-matches! stats-set-zero-streaks! stats-set-priority! scheduler-tag make-scheduler scheduler? scheduler-name scheduler-init scheduler-select scheduler-update simple-scheduler *backoff-threshold* *backoff-factor* *min-priority* *recovery-boost* make-backoff-scheduler should-run? find-stats update-stats! make-worklist-scheduler make-priority-scheduler saturate-scheduled scheduled-iteration optimize-scheduled)) (answer "(define (scheduler->string s) (format \"Scheduler(~a)\" (scheduler-name s)))"))
