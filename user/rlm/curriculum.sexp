(task-entry (id "game-theory/mechanism/bids-max") (skill game-theory) (module mechanism) (tier 1) (difficulty 13206) (name bids-max) (type "(-> (Vector Number) Number)") (description "Maximum bid") (notes ()) (section bid-representation) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length)) (answer "(define (bids-max bids) (let ((n (bids-length bids))) (if (= n 0) 0 (let loop ((i 1) (max-bid (bids-ref bids 0))) (if (>= i n) max-bid (loop (+ i 1) (max max-bid (bids-ref bids i))))))))"))
