(task-entry (id "random/distributions/*erfc-p*") (skill random) (module distributions) (tier 1) (difficulty 12910) (name *erfc-p*) (type "") (description "") (notes ()) (section standard-normal) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs*)) (answer "(define *erfc-p* 0.3275911)"))
