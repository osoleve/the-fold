(task-entry (id "algebra/galois/poly-frobenius-power") (skill algebra) (module galois) (tier 0) (difficulty 334) (name poly-frobenius-power) (type "(-> Polynomial Int Int Polynomial Polynomial)") (description "Compute x^(q^k) mod f via iterated Frobenius map") (notes ("O(k * log(q) * d²) where d = deg(f)" "Avoids computing q^k as integer; iterates x → x^q k times")) (section irreducible-polynomials) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod unique-prime-divisors)) (answer "(define (poly-frobenius-power x q k f) (let loop ((result x) (i 0)) (if (>= i k) result (loop (poly-power-mod result q f) (+ i 1)))))"))
(task-entry (id "algebra/group/dihedral-op") (skill algebra) (module group) (tier 0) (difficulty 335) (name dihedral-op) (type "(-> Integer (-> Element Element Element))") (description "Group operation for D_n") (notes ()) (section dihedral-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity)) (answer "(define (dihedral-op n) (lambda (a b) (let ((a-type (car a)) (a-k (cdr a)) (b-type (car b)) (b-k (cdr b))) (cond ((and (eq? a-type 'r) (eq? b-type 'r)) (cons 'r (modulo (+ a-k b-k) n))) ((and (eq? a-type 'r) (eq? b-type 's)) (cons 's (modulo (- b-k a-k) n))) ((and (eq? a-type 's) (eq? b-type 'r)) (cons 's (modulo (+ a-k b-k) n))) ((and (eq? a-type 's) (eq? b-type 's)) (cons 'r (modulo (- b-k a-k) n)))))))"))
