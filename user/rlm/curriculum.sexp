(task-entry (id "meta/bm25/tokenize") (skill meta) (module bm25) (tier 1) (difficulty 11910) (name tokenize) (type "") (description "") (notes ()) (section term-operations) (deps (core/base/prelude.ss)) (available (BM25-K1 BM25-B bm25-create bm25-doc-count bm25-total-length bm25-term-doc-freq bm25-doc-term-freq bm25-doc-lengths bm25-doc-data bm25-avg-doc-length)) (answer "(define (tokenize str) (if (not (string? str)) '() (let* ((words (string-split-words (string-downcase str))) (base-tokens (filter-map (lambda (w) (if (> (string-length w) 1) (string->symbol w) #f)) words)) (split-tokens (append-map (lambda (sym) (split-hyphenated sym)) base-tokens))) (remove-duplicates (append base-tokens split-tokens)))))"))
(task-entry (id "meta/search/lattice-find-exact") (skill meta) (module search) (tier 1) (difficulty 11910) (name lattice-find-exact) (type "") (description "") (notes ()) (section search-api) (deps ()) (available (*skill-index* *module-index* *export-index* *module-cache* *export-module-map* *search-ready* lattice-index! ensure-indexed! lattice-find search-with-context)) (answer "(define (lattice-find-exact sym) (ensure-indexed!) (cond ((kg-skill-data sym) => (lambda (data) (list sym 1.0 'skill data))) ((assq sym (kg-exports)) => (lambda (entry) (let ((mod (hashtable-ref *export-module-map* sym #f))) (list sym 1.0 'export (quasiquote ((name unquote sym) (unquote-splicing (if mod (quasiquote ((module unquote mod))) '())))))))) ((find-module-by-name sym) => (lambda (mod-entry) (list (car mod-entry) 1.0 'module (quasiquote ((name unquote (car mod-entry))))))) (else #f)))"))
(task-entry (id "meta/type-search/in-output-position?") (skill meta) (module type-search) (tier 1) (difficulty 11910) (name in-output-position?) (type "") (description "") (notes ()) (section type-signature-utilities) (deps ()) (available (has-type-sig? string-contains? extract-type-sig truncate-at-description extract-first-type-token skip-whitespace string-trim-right-ws string-find string-trim-left-ws in-input-position?)) (answer "(define (in-output-position? type-sig query) (let ((arrow-pos (or (string-find-substr type-sig \"→\") (string-find-substr type-sig \"->\")))) (if (not arrow-pos) #f (let* ((arrow-len (if (string-find-substr type-sig \"→\") 1 2)) (after-arrow (string-downcase (substring type-sig (+ arrow-pos arrow-len) (string-length type-sig))))) (string-contains? after-arrow (string-downcase query))))))"))
