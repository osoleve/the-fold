(task-entry (id "linalg/vec2/vec2-from-polar") (skill linalg) (module vec2) (tier 0) (difficulty 407) (name vec2-from-polar) (type "(-> Number Number Vec2)") (description "Create vector from polar coordinates (r, theta)") (notes ()) (section \x32;d-specific-construction) (deps (\x27;prelude \x27;vec-common)) (available (vec2-cross vec2-perp-dot vec2-angle vec2-angle-between vec2-angle-to vec2-heading vec2-from-angle)) (answer "(define (vec2-from-polar r theta) (vec2 (* r (cos theta)) (* r (sin theta))))"))
(task-entry (id "linalg/quaternion/quat-look-at") (skill linalg) (module quaternion) (tier 0) (difficulty 407) (name quat-look-at) (type "") (description "") (notes ()) (section quaternion-construction) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors)) (answer "(define (quat-look-at forward up) (let* ((f (vec3-normalize forward)) (r (vec3-normalize (vec3-cross up f))) (u (vec3-cross f r)) (m (list (list (vec3-x r) (vec3-x u) (vec3-x f)) (list (vec3-y r) (vec3-y u) (vec3-y f)) (list (vec3-z r) (vec3-z u) (vec3-z f))))) (quat-from-rotation-matrix m)))"))
(task-entry (id "linalg/matrix/matrix-from-vec") (skill linalg) (module matrix) (tier 0) (difficulty 407) (name matrix-from-vec) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists)) (answer "(define (matrix-from-vec rows cols data) (if (= (vector-length data) (* rows cols)) (list 'matrix rows cols (vec-copy data)) (quasiquote (error dimension-mismatch (unquote (vector-length data)) (unquote (* rows cols))))))"))
(task-entry (id "linalg/matrix-decomp/qr-orthogonalize-remaining!") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 407) (name qr-orthogonalize-remaining!) (type "") (description "Orthogonalize columns j+1..n-1 against column j.") (notes ()) (section qr-decomposition) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance* matrix-copy matrix-set! matrix-column matrix-lu matrix-lu-solve qr-find-orthogonal-basis)) (answer "(define (qr-orthogonalize-remaining! q r j m n) (do ((i (+ j 1) (+ i 1))) ((= i n)) (let* ((col-i (matrix-column q i)) (col-j (matrix-column q j)) (proj (vec-dot col-j col-i))) (matrix-set! r j i proj) (do ((row 0 (+ row 1))) ((= row m)) (matrix-set! q row i (- (matrix-ref q row i) (* proj (matrix-ref q row j))))))))"))
(task-entry (id "linalg/matrix-solvers/matrix-gauss-elim") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 407) (name matrix-gauss-elim) (type "") (description "") (notes ()) (section least-squares) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute matrix-back-substitute matrix-solve matrix-inverse permutation-parity matrix-determinant matrix-least-squares)) (answer "(define (matrix-gauss-elim a) (let* ((m (matrix-rows a)) (n (matrix-cols a)) (ref (matrix-copy a))) (let loop ((k 0) (i 0)) (if (or (= k n) (= i m)) ref (let find-pivot ((r i) (max-row i) (max-val (abs (matrix-ref ref i k)))) (if (= r m) (if (< max-val *matrix-tolerance*) (loop (+ k 1) i) (begin (when (not (= max-row i)) (let ((cols (matrix-cols ref)) (data (matrix-data ref))) (do ((col 0 (+ col 1))) ((= col cols)) (let ((idx-i (+ (* i cols) col)) (idx-max (+ (* max-row cols) col))) (let ((temp (vector-ref data idx-i))) (vector-set! data idx-i (vector-ref data idx-max)) (vector-set! data idx-max temp)))))) (let ((pivot-val (matrix-ref ref i k))) (do ((r-elim (+ i 1) (+ r-elim 1))) ((= r-elim m)) (let ((factor (/ (matrix-ref ref r-elim k) pivot-val))) (do ((c k (+ c 1))) ((= c n)) (matrix-set! ref r-elim c (- (matrix-ref ref r-elim c) (* factor (matrix-ref ref i c)))))))) (loop (+ k 1) (+ i 1)))) (let ((val (abs (matrix-ref ref r k)))) (if (> val max-val) (find-pivot (+ r 1) r val) (find-pivot (+ r 1) max-row max-val)))))))))"))
(task-entry (id "linalg/matrix-eigen/qr-algorithm-shifted") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 407) (name qr-algorithm-shifted) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged?)) (answer "(define (qr-algorithm-shifted a . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (if (not (= n m)) (quasiquote (error not-square (unquote n) (unquote m))) (if (= n 1) (vector (matrix-ref a 0 0)) (let* ((max-iter (if (and (pair? opts) (integer? (car opts))) (car opts) *eigen-max-iterations*)) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (tol (if (and (pair? rest1) (number? (car rest1))) (car rest1) *eigen-tolerance*))) (qr-algorithm-shifted-loop a n 0 max-iter tol))))))"))
(task-entry (id "linalg/iterative-solvers/gauss-seidel-loop") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 407) (name gauss-seidel-loop) (type "") (description "") (notes ()) (section gauss-seidel-iteration) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel)) (answer "(define (gauss-seidel-loop a b x iter max-iter tol n) (let ((res (residual a x b))) (cond ((converged? res tol) (list x iter res)) ((>= iter max-iter) (quasiquote (error no-convergence (unquote iter) (unquote res)))) (else (do ((i 0 (+ i 1))) ((= i n)) (let ((a-ii (matrix-ref a i i))) (when (>= (abs a-ii) *iterative-tolerance*) (let ((sum (let loop ((j 0) (s 0.0)) (if (= j n) s (if (= j i) (loop (+ j 1) s) (loop (+ j 1) (+ s (* (matrix-ref a i j) (vector-ref x j))))))))) (vector-set! x i (/ (- (vector-ref b i) sum) a-ii)))))) (gauss-seidel-loop a b x (+ iter 1) max-iter tol n)))))"))
(task-entry (id "linalg/sparse/sparse-coo-values") (skill linalg) (module sparse) (tier 0) (difficulty 407) (name sparse-coo-values) (type "") (description "") (notes ()) (section coo-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices)) (answer "(define (sparse-coo-values m) (list-ref m 5))"))
(task-entry (id "linalg/graph-laplacian/laplacian-connected-components") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 407) (name laplacian-connected-components) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index)) (answer "(define (laplacian-connected-components adj) (let* ((L (laplacian adj)) (eigs (eigenvalues L))) (if (and (pair? eigs) (eq? (car eigs) 'error)) eigs (let* ((n (vector-length eigs)) (max-eig (let loop ((i 0) (m 0)) (if (= i n) m (loop (+ i 1) (max m (abs (vector-ref eigs i))))))) (tol (* 1e-8 (max 1.0 max-eig)))) (let loop ((i 0) (count 0)) (if (= i n) count (loop (+ i 1) (if (< (abs (vector-ref eigs i)) tol) (+ count 1) count))))))))"))
(task-entry (id "linalg/svd/compute-u-from-av") (skill linalg) (module svd) (tier 0) (difficulty 407) (name compute-u-from-av) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix)) (answer "(define (compute-u-from-av a v singular-values m n tol) (let ((u (make-matrix m m 0)) (rank (count-nonzero-singular-values singular-values tol))) (do ((i 0 (+ i 1))) ((= i (min rank n))) (let* ((sigma-i (vector-ref singular-values i)) (v-i (matrix-col v i)) (av-i (matrix-vec-mul a v-i)) (u-i (vec-scale (/ 1.0 sigma-i) av-i))) (do ((j 0 (+ j 1))) ((= j m)) (matrix-set! u j i (vector-ref u-i j))))) (if (< rank m) (complete-orthogonal-basis! u rank m) u) u))"))
(task-entry (id "linalg/numeric-instances/vec-recip") (skill linalg) (module numeric-instances) (tier 0) (difficulty 407) (name vec-recip) (type "") (description "") (notes ()) (section vec-num-instance) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (vec+ vec- vec* vec-abs vec-signum vec-from-integer vec/)) (answer "(define (vec-recip v) (vec-map (lambda (x) (/ 1 x)) v))"))
(task-entry (id "linalg/dep-linalg/matrix-mul-typed") (skill linalg) (module dep-linalg) (tier 0) (difficulty 407) (name matrix-mul-typed) (type "Π m n p A. Matrix m n A → Matrix n p A → Matrix m p A") (description "Multiplies two matrices with dimension-safe type.") (notes ()) (section matrix-operations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (dep-linalg-types vec-append-typed vec-zip-typed vec-head-typed vec-tail-typed vec-map-typed vec-fold-typed)) (answer "(define (matrix-mul-typed m n p A m1 m2) (matrix-mul m1 m2))"))
(task-entry (id "linalg/vec/vec-last") (skill linalg) (module vec) (tier 0) (difficulty 408) (name vec-last) (type "(-> (Vec a) (Or a Error))") (description "Get last element") (notes ()) (section vector-accessors) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first)) (answer "(define (vec-last v) (let ((n (vector-length v))) (if (> n 0) (vector-ref v (- n 1)) '(error empty-vector))))"))
(task-entry (id "linalg/vec2/vec2-rotate") (skill linalg) (module vec2) (tier 0) (difficulty 408) (name vec2-rotate) (type "(-> Vec2 Number Vec2)") (description "Rotate vector by angle (radians)") (notes ()) (section \x32;d-rotation) (deps (\x27;prelude \x27;vec-common)) (available (vec2-cross vec2-perp-dot vec2-angle vec2-angle-between vec2-angle-to vec2-heading vec2-from-angle vec2-from-polar)) (answer "(define (vec2-rotate v angle) (let ((c (cos angle)) (s (sin angle)) (x (vec2-x v)) (y (vec2-y v))) (vec2 (- (* x c) (* y s)) (+ (* x s) (* y c)))))"))
(task-entry (id "linalg/quaternion/quat?") (skill linalg) (module quaternion) (tier 0) (difficulty 408) (name quat?) (type "") (description "") (notes ()) (section quaternion-construction) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at)) (answer "(define (quat? q) (and (pair? q) (eq? (car q) 'quat)))"))
(task-entry (id "linalg/matrix/matrix-ref") (skill linalg) (module matrix) (tier 0) (difficulty 408) (name matrix-ref) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec)) (answer "(define (matrix-ref m i j) (let ((rows (matrix-rows m)) (cols (matrix-cols m)) (data (matrix-data m))) (if (and (>= i 0) (< i rows) (>= j 0) (< j cols)) (vector-ref data (+ (* i cols) j)) (quasiquote (error out-of-bounds ((unquote i) (unquote j)) ((unquote rows) (unquote cols)))))))"))
(task-entry (id "linalg/matrix-decomp/matrix-qr") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 408) (name matrix-qr) (type "") (description "QR decomposition using Modified Gram-Schmidt algorithm. Handles singular/rank-deficient matrices gracefully by finding orthogonal basis vectors when linear dependence is detected. This allows eigenvalue algorithms to converge to 0 eigenvalues for singular matrices like graph Laplacians.") (notes ()) (section qr-decomposition) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance* matrix-copy matrix-set! matrix-column matrix-lu matrix-lu-solve qr-find-orthogonal-basis qr-orthogonalize-remaining!)) (answer "(define (matrix-qr a) (let* ((m (matrix-rows a)) (n (matrix-cols a))) (if (< m n) (quasiquote (error underdetermined (unquote m) (unquote n))) (let ((q (matrix-copy a)) (r (make-matrix n n 0))) (let col-loop ((j 0)) (if (= j n) (list q r) (let* ((col-j (matrix-column q j)) (norm (vec-norm col-j))) (if (< norm *matrix-tolerance*) (let ((basis-vec (qr-find-orthogonal-basis q j m))) (if (not basis-vec) (quasiquote (error rank-deficient-recovery-failed (unquote j))) (begin (matrix-set! r j j 0) (do ((row 0 (+ row 1))) ((= row m)) (matrix-set! q row j (vector-ref basis-vec row))) (qr-orthogonalize-remaining! q r j m n) (col-loop (+ j 1))))) (begin (matrix-set! r j j norm) (do ((i 0 (+ i 1))) ((= i m)) (matrix-set! q i j (/ (matrix-ref q i j) norm))) (qr-orthogonalize-remaining! q r j m n) (col-loop (+ j 1)))))))))))"))
(task-entry (id "linalg/matrix-solvers/matrix-rank") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 408) (name matrix-rank) (type "") (description "") (notes ()) (section least-squares) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute matrix-back-substitute matrix-solve matrix-inverse permutation-parity matrix-determinant matrix-least-squares matrix-gauss-elim)) (answer "(define (matrix-rank a) (let* ((ref (matrix-gauss-elim a)) (m (matrix-rows ref)) (n (matrix-cols ref))) (let loop ((i 0) (rank 0)) (if (= i m) rank (let row-loop ((j 0)) (cond ((= j n) (loop (+ i 1) rank)) ((> (abs (matrix-ref ref i j)) *matrix-tolerance*) (loop (+ i 1) (+ rank 1))) (else (row-loop (+ j 1)))))))))"))
(task-entry (id "linalg/matrix-eigen/qr-algorithm-shifted-loop") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 408) (name qr-algorithm-shifted-loop) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted)) (answer "(define (qr-algorithm-shifted-loop a active-size iter max-iter tol) (cond ((>= iter max-iter) (extract-eigenvalues-with-complex-check a (matrix-rows a) tol)) ((<= active-size 0) (extract-eigenvalues-with-complex-check a (matrix-rows a) tol)) ((= active-size 1) (extract-eigenvalues-with-complex-check a (matrix-rows a) tol)) ((= active-size 2) (let* ((full-n (matrix-rows a)) (start (- full-n active-size)) (complex-pair (detect-complex-2x2-block a start tol))) (if complex-pair (extract-eigenvalues-with-complex-check a full-n tol) (let* ((i (- full-n 1)) (sub (if (>= i 1) (matrix-ref a i (- i 1)) 0))) (if (< (abs sub) tol) (qr-algorithm-shifted-loop a (- active-size 1) iter max-iter tol) (qr-iterate-once a active-size iter max-iter tol full-n)))))) (else (let* ((full-n (matrix-rows a)) (start (- full-n active-size)) (i (- full-n 1)) (has-complex-block (and (>= i 1) (detect-complex-2x2-block a (- i 1) tol)))) (if has-complex-block (qr-algorithm-shifted-loop a (- active-size 2) iter max-iter tol) (let ((sub (if (>= i 1) (matrix-ref a i (- i 1)) 0))) (if (< (abs sub) tol) (qr-algorithm-shifted-loop a (- active-size 1) iter max-iter tol) (qr-iterate-once a active-size iter max-iter tol full-n))))))))"))
(task-entry (id "linalg/iterative-solvers/sor") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 408) (name sor) (type "") (description "") (notes ()) (section sor) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop)) (answer "(define (sor a b omega . opts) (cond ((or (<= omega 0) (>= omega 2)) (quasiquote (error invalid-omega (unquote omega)))) (else (let* ((n (matrix-rows a)) (m (matrix-cols a))) (cond ((not (= n m)) (quasiquote (error not-square (unquote n) (unquote m)))) ((not (= n (vector-length b))) (quasiquote (error dimension-mismatch (unquote n) (unquote (vector-length b))))) (else (let* ((x0 (if (and (pair? opts) (vector? (car opts))) (car opts) (make-vector n 0.0))) (rest1 (if (and (pair? opts) (vector? (car opts))) (cdr opts) opts)) (max-iter (if (and (pair? rest1) (integer? (car rest1))) (car rest1) *iterative-max-iterations*)) (rest2 (if (and (pair? rest1) (integer? (car rest1))) (cdr rest1) rest1)) (tol (if (and (pair? rest2) (number? (car rest2))) (car rest2) *iterative-tolerance*))) (sor-loop a b omega (vector-copy x0) 0 max-iter tol n))))))))"))
