(task-entry (id "physics/classical3d/collision-detection3d/shapes-collide-3d?") (skill physics/classical3d) (module collision-detection3d) (tier 2) (difficulty 22420) (name shapes-collide-3d?) (type "") (description "") (notes ()) (section point-in-shape-tests) (deps (\x27;prelude \x27;vec3 \x27;shapes3d)) (available (point-in-aabb3d? point-in-sphere3d? point-in-box3d? closest-point-on-segment-3d closest-point-on-aabb3d closest-point-on-box3d sphere-sphere? sphere-sphere-manifold aabb3d-aabb3d? aabb3d-aabb3d-manifold sphere-aabb3d? sphere-aabb3d-manifold sphere-inside-aabb-normal sphere-box3d? sphere-box3d-manifold sphere-inside-box-normal box3d-box3d? box3d-box3d-manifold shape-type-3d shape-aabb-3d)) (answer "(define (shapes-collide-3d? a b) (let ((type-a (shape-type-3d a)) (type-b (shape-type-3d b))) (cond ((and (eq? type-a 'sphere3d) (eq? type-b 'sphere3d)) (sphere-sphere? a b)) ((and (eq? type-a 'sphere3d) (eq? type-b 'aabb3d)) (sphere-aabb3d? a b)) ((and (eq? type-a 'aabb3d) (eq? type-b 'sphere3d)) (sphere-aabb3d? b a)) ((and (eq? type-a 'sphere3d) (eq? type-b 'box3d)) (sphere-box3d? a b)) ((and (eq? type-a 'box3d) (eq? type-b 'sphere3d)) (sphere-box3d? b a)) ((and (eq? type-a 'aabb3d) (eq? type-b 'aabb3d)) (aabb3d-aabb3d? a b)) ((and (eq? type-a 'box3d) (eq? type-b 'box3d)) (box3d-box3d? a b)) ((and (eq? type-a 'box3d) (eq? type-b 'aabb3d)) (aabb3d-aabb3d? (box3d-aabb a) b)) ((and (eq? type-a 'aabb3d) (eq? type-b 'box3d)) (aabb3d-aabb3d? a (box3d-aabb b))) (else (aabb3d-aabb3d? (shape-aabb-3d a) (shape-aabb-3d b))))))"))
