(task-entry (id "fp/diff/deriv") (skill fp) (module diff) (tier 1) (difficulty 10602) (name deriv) (type "(-> Expr Symbol Expr)") (description "Compute derivative of expr with respect to var-sym using standard calculus rules") (notes ()) (section basic-differentiation) (deps (\x27;expr)) (available (fold-sum fold-product)) (answer "(define (deriv expr var-sym) (cond ((num? expr) (num 0)) ((var? expr) (if (eq? (var-name expr) var-sym) (num 1) (num 0))) ((sum? expr) (let ((terms (sum-terms expr))) (fold-sum (map (lambda (e) (deriv e var-sym)) terms)))) ((product? expr) (let ((factors (product-factors expr))) (cond ((= (length factors) 2) (let ((f (car factors)) (g (cadr factors))) (sum (product (deriv f var-sym) g) (product f (deriv g var-sym))))) (else (fold-sum (map (lambda (i) (fold-product (map (lambda (j e) (if (= i j) (deriv e var-sym) e)) (iota (length factors)) factors))) (iota (length factors)))))))) ((difference? expr) (if (diff-right expr) (difference (deriv (diff-left expr) var-sym) (deriv (diff-right expr) var-sym)) (make-neg (deriv (diff-left expr) var-sym)))) ((quotient? expr) (let ((f (quot-numer expr)) (g (quot-denom expr))) (division (difference (product (deriv f var-sym) g) (product f (deriv g var-sym))) (power g (num 2))))) ((power? expr) (let ((f (pow-base expr)) (g (pow-exp expr))) (cond ((num? g) (product (product g (power f (difference g (num 1)))) (deriv f var-sym))) ((num? f) (product (product expr (sym-log f)) (deriv g var-sym))) (else (product expr (sum (product (deriv g var-sym) (sym-log f)) (product g (division (deriv f var-sym) f)))))))) ((app? expr) (let ((fn (app-fn expr)) (u (app-arg expr)) (du (deriv (app-arg expr) var-sym))) (product (deriv-fn fn u) du))) (else (num 0))))"))
(task-entry (id "fp/simplify/simplify-once") (skill fp) (module simplify) (tier 1) (difficulty 10602) (name simplify-once) (type "(-> Expr Expr)") (description "Single pass of simplification") (notes ()) (section main-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify)) (answer "(define (simplify-once expr) (cond ((num? expr) expr) ((var? expr) expr) ((sum? expr) (simplify-sum (map simplify-once (sum-terms expr)))) ((product? expr) (simplify-product (map simplify-once (product-factors expr)))) ((difference? expr) (if (diff-right expr) (simplify-diff (simplify-once (diff-left expr)) (simplify-once (diff-right expr))) (simplify-neg (simplify-once (diff-left expr))))) ((quotient? expr) (simplify-quot (simplify-once (quot-numer expr)) (simplify-once (quot-denom expr)))) ((power? expr) (simplify-pow (simplify-once (pow-base expr)) (simplify-once (pow-exp expr)))) ((app? expr) (simplify-app (app-fn expr) (simplify-once (app-arg expr)))) (else expr)))"))
(task-entry (id "fp/integrate/integrate-table") (skill fp) (module integrate) (tier 1) (difficulty 10602) (name integrate-table) (type "(-> Expr Symbol (Maybe Expr))") (description "Table-based lookup for common integrals") (notes ()) (section integration-table) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal)) (answer "(define (integrate-table expr var-sym) (let ((x (var var-sym))) (cond ((num? expr) (product expr x)) ((and (var? expr) (eq? (var-name expr) var-sym)) (division (power x (num 2)) (num 2))) ((and (var? expr) (not (eq? (var-name expr) var-sym))) (product expr x)) ((and (app? expr) (eq? (app-fn expr) 'sin) (var? (app-arg expr)) (eq? (var-name (app-arg expr)) var-sym)) (make-neg (sym-cos x))) ((and (app? expr) (eq? (app-fn expr) 'cos) (var? (app-arg expr)) (eq? (var-name (app-arg expr)) var-sym)) (sym-sin x)) ((and (app? expr) (eq? (app-fn expr) 'tan) (var? (app-arg expr)) (eq? (var-name (app-arg expr)) var-sym)) (make-neg (sym-log (make-app 'abs (sym-cos x))))) ((and (power? expr) (num? (pow-exp expr)) (= (num-val (pow-exp expr)) 2) (quotient? (pow-base expr)) (num? (quot-numer (pow-base expr))) (= (num-val (quot-numer (pow-base expr))) 1) (app? (quot-denom (pow-base expr))) (eq? (app-fn (quot-denom (pow-base expr))) 'cos)) (sym-tan x)) ((and (app? expr) (eq? (app-fn expr) 'exp) (var? (app-arg expr)) (eq? (var-name (app-arg expr)) var-sym)) (sym-exp x)) ((and (quotient? expr) (num? (quot-numer expr)) (= (num-val (quot-numer expr)) 1) (var? (quot-denom expr)) (eq? (var-name (quot-denom expr)) var-sym)) (sym-log (make-app 'abs x))) ((and (app? expr) (eq? (app-fn expr) 'log) (var? (app-arg expr)) (eq? (var-name (app-arg expr)) var-sym)) (difference (product x (sym-log x)) x)) ((and (app? expr) (eq? (app-fn expr) 'sqrt) (var? (app-arg expr)) (eq? (var-name (app-arg expr)) var-sym)) (product (division (num 2) (num 3)) (power x (division (num 3) (num 2))))) ((is-arcsin-integrand? expr var-sym) (sym-asin x)) ((is-arctan-integrand? expr var-sym) (sym-atan x)) ((and (app? expr) (eq? (app-fn expr) 'sinh) (var? (app-arg expr)) (eq? (var-name (app-arg expr)) var-sym)) (sym-cosh x)) ((and (app? expr) (eq? (app-fn expr) 'cosh) (var? (app-arg expr)) (eq? (var-name (app-arg expr)) var-sym)) (sym-sinh x)) (else #f))))"))
