n-list dsl-program-depth dsl-uses-tag? dsl-tag-histogram dsl-optimize-dead-code dsl-fuse dsl-fix dsl-lazy make-bounce make-done bounce? done? bounce-thunk done-value run-trampoline run-dsl-trampolined run-dsl-trampoline-helper make-mock-interpreter dsl-test-case dsl-test-error dsl-programs-equiv? dsl-interpreter-equiv? make-recording-interpreter verify-instruction-sequence calc-push! calc-add! calc-sub! calc-mul! calc-div! calc-dup! calc-swap! calc-pop! make-calc-interpreter run-calc forward! back! left! right! penup! pendown! getpos! make-turtle-interpreter run-turtle repeat dsl-ok dsl-err dsl-ok? dsl-err? dsl-ok-value dsl-err-tag dsl-err-message dsl-result-map dsl-result-bind run-dsl-safe dsl-fail dsl-assert make-fail-handler dsl-peek dsl-count-instructions dsl-trace-when dsl-trace-tags dsl-pretty-print dsl-collect-tags dsl-left-tag dsl-right-tag dsl-left-tag? dsl-right-tag? dsl-unwrap-tag dsl-inject-left dsl-inject-right union-interpreter make-dsl-schema dsl-schema? dsl-schema-instructions dsl-validate calc-schema turtle-schema dsl-finally dsl-bracket dsl-to-eff)) (answer "(define (make-eff-interpreter handler) (lambda (effect k) (let* ((tag (effect-tag effect)) (payload (effect-payload effect)) (result (handler tag payload))) (k result))))"))
(task-entry (id "clp/domain/domain-max") (skill clp) (module domain) (tier 1) (difficulty 10811) (name domain-max) (type "(-> Domain (Maybe Int))") (description "Get the maximum value in the domain") (notes ()) (section domain-accessors) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min)) (answer "(define (domain-max dom) (if (null? dom) #f (cdr (list-last dom))))"))
(task-entry (id "clp/store/cstore-set-domain") (skill clp) (module store) (tier 1) (difficulty 10811) (name cstore-set-domain) (type "(-> CStore LVar Domain (Maybe CStore))") (description "Set the domain of a variable") (notes ("Only adds variable to pending queue if domain actually changed")) (section domain-operations-on-store) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain)) (answer "(define (cstore-set-domain cs var dom) (if (domain-empty? dom) #f (let* ((id (lvar-id var)) (domains (cstore-domains cs)) (old-dom (let ((binding (assoc id domains))) (if binding (cdr binding) #f))) (changed? (or (not old-dom) (not (domain=? old-dom dom)))) (new-domains (if changed? (alist-update id dom domains) domains)) (pending (cstore-pending cs)) (new-pending (if (and changed? (not (member id pending))) (cons id pending) pending))) (list 'cstore (cstore-subst cs) new-domains (cstore-constraints cs) new-pending))))"))
(task-entry (id "clp/fd-constraints/=/=fd") (skill clp) (module fd-constraints) (tier 1) (difficulty 10811) (name =/=fd) (type "(-> (Or LVar Int) (Or LVar Int) (-> CStore (Maybe CStore)))") (description "Constrain x ≠ y (disequality)") (notes ()) (section comparison-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd <fd-var-var <=fd <=fd-var-var >fd >=fd)) (answer "(define (=/=fd x y) (lambda (cs) (cond ((and (integer? x) (integer? y)) (if (not (= x y)) cs #f)) ((integer? x) (=/=fd-var-const cs y x)) ((integer? y) (=/=fd-var-const cs x y)) (else (=/=fd-var-var cs x y)))))"))
(task-entry (id "clp/global-constraints/sum-fd-propagate") (skill clp) (module global-constraints) (tier 1) (difficulty 10811) (name sum-fd-propagate) (type "(-> CStore (List LVar) (Or LVar Int) (Maybe CStore))") (description "Bounds propagation for sum constraint") (notes ()) (section sum-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd)) (answer "(define (sum-fd-propagate cs vars result) (let* ((bounds (map (lambda (v) (fd-bounds cs v)) vars)) (result-bounds (fd-bounds cs result))) (if (any not bounds) cs (let* ((sum-lo (apply + (map car bounds))) (sum-hi (apply + (map cdr bounds)))) (if (not result-bounds) (if (lvar? result) (cstore-set-domain cs result (make-domain sum-lo sum-hi)) (if (and (>= result sum-lo) (<= result sum-hi)) cs #f)) (let* ((res-lo (car result-bounds)) (res-hi (cdr result-bounds)) (new-res-lo (max res-lo sum-lo)) (new-res-hi (min res-hi sum-hi))) (if (> new-res-lo new-res-hi) #f (let ((cs1 (fd-narrow-bounds cs result new-res-lo new-res-hi))) (and cs1 (sum-fd-narrow-vars cs1 vars result))))))))))"))
(task-entry (id "clp/propagate/post-=/=fd") (skill clp) (module propagate) (tier 1) (difficulty 10811) (name post-=/=fd) (type "(-> CStore (Or LVar Int) (Or LVar Int) (Maybe CStore))") (description "Post disequality constraint and propagate") (notes ()) (section high-level-constraint-posting) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd post-<fd post-<=fd post->fd post->=fd)) (answer "(define (post-=/=fd cs x y) (let ((vars (filter lvar? (list x y)))) (if (null? vars) ((=/=fd x y) cs) (post-constraint cs '=/=fd vars (=/=fd x y)))))"))
(task-entry (id "clp/label/label-all") (skill clp) (module label) (tier 1) (difficulty 10811) (name label-all) (type "(-> CStore (List LVar) (List CStore))") (description "Get all solutions as a list (may be expensive for large search spaces)") (notes ("Default limit of 1000 solutions")) (section convenience-labeling) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with label-values try-value)) (answer "(define (label-all cs vars) (label-all-with-limit cs vars 1000))"))
