(task-entry (id "optics/bidirectional/migrate") (skill optics) (module bidirectional) (tier 1) (difficulty 11006) (name migrate) (type "(-> Migration Data Data)") (description "Apply the migration in the forward direction.\nTransforms data from `from-version` to `to-version`.") (notes ()) (section core-operations) (deps (\x27;profunctor-optics)) (available (make-migration migration? migration-name migration-from migration-to migration-iso)) (answer "(define (migrate m data) ((p-iso-forward (migration-iso m)) data))"))
(task-entry (id "optics/format-iso/bytevector->sexpr") (skill optics) (module format-iso) (tier 1) (difficulty 11006) (name bytevector->sexpr) (type "(-> Bytevector Any)") (description "Parse UTF-8 bytevector as S-expression.") (notes ()) (section sexpr-bytevector) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string sexpr->bytevector)) (answer "(define (bytevector->sexpr bv) (string->sexpr (utf8->string bv)))"))
(task-entry (id "optics/schema/field-merge-iso") (skill optics) (module schema) (tier 1) (difficulty 11006) (name field-merge-iso) (type "(-> (List Symbol) Symbol (-> Alist a) (-> a Alist) (PIso Alist Alist))") (description "Merge multiple fields into one (inverse of split)") (notes ()) (section field-split-merge) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso field-split-iso)) (answer "(define (field-merge-iso source-fields target-field merger splitter) (make-p-iso (lambda (alist) (let ((source-pairs (filter (lambda (p) (memq (car p) source-fields)) alist))) (if (= (length source-pairs) (length source-fields)) (cons (cons target-field (merger source-pairs)) (filter (lambda (p) (not (memq (car p) source-fields))) alist)) alist))) (lambda (alist) (let* ((pair (assq target-field alist)) (value (if pair (cdr pair) #f))) (if value (let ((split-values (splitter value))) (append split-values (filter (lambda (p) (not (eq? (car p) target-field))) alist))) alist)))))"))
(task-entry (id "optics/block-migration/block-migrate-payload") (skill optics) (module block-migration) (tier 1) (difficulty 11006) (name block-migrate-payload) (type "(-> BlockMigration Block Block)") (description "Apply migration's payload iso to a block.\nAssumes block has sexpr-parseable payload.") (notes ()) (section transformation) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag block-migration-to-tag block-migration-payload-iso block-migration-applies?)) (answer "(define (block-migrate-payload bm blk) (let* ((from-tag (block-migration-from-tag bm)) (to-tag (block-migration-to-tag bm)) (payload-iso (block-migration-payload-iso bm))) (if (not (eq? (block-tag blk) from-tag)) blk (let* ((payload (block-payload blk)) (sexpr (bytevector->sexpr payload)) (new-sexpr ((p-iso-forward payload-iso) sexpr)) (new-payload (sexpr->bytevector new-sexpr))) (make-block to-tag new-payload (block-refs blk))))))"))
(task-entry (id "optics/optics/iso-flip") (skill optics) (module optics) (tier 1) (difficulty 11007) (name iso-flip) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over)) (answer "(define (iso-flip iso) (make-iso (iso-backward iso) (iso-forward iso)))"))
(task-entry (id "optics/block-optics/block-child-at") (skill optics) (module block-optics) (tier 1) (difficulty 11007) (name block-child-at) (type "(-> (-> Bytevector (Maybe Block)) Nat (Affine Block Block))") (description "Compose block-ref-at with follow-ref to access a child block.") (notes ()) (section cas-aware) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens block-ref-at block-refs-each block-refs-count follow-ref)) (answer "(define (block-child-at fetch n) (affine-compose (block-ref-at n) (follow-ref fetch)))"))
(task-entry (id "optics/profunctor-optics/rmap") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11007) (name rmap) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap)) (answer "(define (rmap prof g pa) ((profunctor-rmap prof) g pa))"))
(task-entry (id "optics/bidirectional/rollback") (skill optics) (module bidirectional) (tier 1) (difficulty 11007) (name rollback) (type "(-> Migration Data Data)") (description "Apply the migration in the backward direction.\nTransforms data from `to-version` back to `from-version`.") (notes ()) (section core-operations) (deps (\x27;profunctor-optics)) (available (make-migration migration? migration-name migration-from migration-to migration-iso migrate)) (answer "(define (rollback m data) ((p-iso-backward (migration-iso m)) data))"))
(task-entry (id "optics/format-iso/iso-sexpr-bytevector") (skill optics) (module format-iso) (tier 1) (difficulty 11007) (name iso-sexpr-bytevector) (type "") (description "") (notes ()) (section sexpr-bytevector) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string sexpr->bytevector bytevector->sexpr)) (answer "(define iso-sexpr-bytevector (make-p-iso sexpr->bytevector bytevector->sexpr))"))
(task-entry (id "optics/schema/field-move-to-front-iso") (skill optics) (module schema) (tier 1) (difficulty 11007) (name field-move-to-front-iso) (type "(-> Symbol (PIso Alist Alist))") (description "Move a field to the front of the alist") (notes ("Backward doesn't restore position (just identity)")) (section field-move) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso field-split-iso field-merge-iso)) (answer "(define (field-move-to-front-iso field) (make-p-iso (lambda (alist) (let ((pair (assq field alist))) (if pair (cons pair (filter (lambda (p) (not (eq? (car p) field))) alist)) alist))) identity))"))
(task-entry (id "optics/block-migration/block-rollback-payload") (skill optics) (module block-migration) (tier 1) (difficulty 11007) (name block-rollback-payload) (type "(-> BlockMigration Block Block)") (description "Apply migration's payload iso backward.") (notes ()) (section transformation) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag block-migration-to-tag block-migration-payload-iso block-migration-applies? block-migrate-payload)) (answer "(define (block-rollback-payload bm blk) (let* ((from-tag (block-migration-from-tag bm)) (to-tag (block-migration-to-tag bm)) (payload-iso (block-migration-payload-iso bm))) (if (not (eq? (block-tag blk) to-tag)) blk (let* ((payload (block-payload blk)) (sexpr (bytevector->sexpr payload)) (new-sexpr ((p-iso-backward payload-iso) sexpr)) (new-payload (sexpr->bytevector new-sexpr))) (make-block from-tag new-payload (block-refs blk))))))"))
(task-entry (id "optics/optics/iso-compose") (skill optics) (module optics) (tier 1) (difficulty 11008) (name iso-compose) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip)) (answer "(define (iso-compose outer inner) (make-iso (compose2 (iso-forward inner) (iso-forward outer)) (compose2 (iso-backward outer) (iso-backward inner))))"))
(task-entry (id "optics/block-optics/block-children-each") (skill optics) (module block-optics) (tier 1) (difficulty 11008) (name block-children-each) (type "(-> (-> Bytevector (Maybe Block)) (Traversal Block ? Block Block))") (description "Traverse all child blocks (following refs through CAS).\nThis composes block-refs-each with follow-ref.\n\nNote: Uses a custom traversal since we need to filter out\nmissing refs (hashes not in CAS).") (notes ()) (section cas-aware) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens block-ref-at block-refs-each block-refs-count follow-ref block-child-at)) (answer "(define (block-children-each fetch) (make-traversal (lambda (_f blk) blk) (lambda (blk) (filter-map (lambda (ref) (fetch ref)) (vector->list (block-refs blk))))))"))
(task-entry (id "optics/profunctor-optics/make-strong") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11008) (name make-strong) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap)) (answer "(define (make-strong prof first-fn) (list 'strong prof first-fn (lambda (pab) (dimap prof swap swap (first-fn pab)))))"))
(task-entry (id "optics/bidirectional/migration-apply") (skill optics) (module bidirectional) (tier 1) (difficulty 11008) (name migration-apply) (type "(-> Migration Data Direction Data)") (description "Apply migration in specified direction ('forward or 'backward).") (notes ()) (section core-operations) (deps (\x27;profunctor-optics)) (available (make-migration migration? migration-name migration-from migration-to migration-iso migrate rollback)) (answer "(define (migration-apply m data direction) (case direction ((forward) (migrate m data)) ((backward) (rollback m data)) (else (error 'migration-apply \"Invalid direction\" direction))))"))
(task-entry (id "optics/format-iso/iso-list-vector") (skill optics) (module format-iso) (tier 1) (difficulty 11008) (name iso-list-vector) (type "") (description "") (notes ()) (section list-vector) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string sexpr->bytevector bytevector->sexpr iso-sexpr-bytevector)) (answer "(define iso-list-vector (make-p-iso list->vector vector->list))"))
(task-entry (id "optics/schema/nested-field-iso") (skill optics) (module schema) (tier 1) (difficulty 11008) (name nested-field-iso) (type "(-> (List Symbol) PIso (PIso Alist Alist))") (description "Transform a nested field value. Path is a list of symbols representing the path to the field") (notes ()) (section nested-fields) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso field-split-iso field-merge-iso field-move-to-front-iso)) (answer "(define (nested-field-iso path value-iso) (if (null? path) value-iso (make-p-iso (lambda (alist) (let* ((field (car path)) (rest-path (cdr path))) (map (lambda (pair) (if (eq? (car pair) field) (cons field (if (null? rest-path) ((p-iso-forward value-iso) (cdr pair)) ((p-iso-forward (nested-field-iso rest-path value-iso)) (cdr pair)))) pair)) alist))) (lambda (alist) (let* ((field (car path)) (rest-path (cdr path))) (map (lambda (pair) (if (eq? (car pair) field) (cons field (if (null? rest-path) ((p-iso-backward value-iso) (cdr pair)) ((p-iso-backward (nested-field-iso rest-path value-iso)) (cdr pair)))) pair)) alist))))))"))
(task-entry (id "optics/block-migration/block-with-refs") (skill optics) (module block-migration) (tier 1) (difficulty 11008) (name block-with-refs) (type "(-> Block (Vector Bytevector) Block)") (description "Create new block with updated refs.") (notes ()) (section refs) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag block-migration-to-tag block-migration-payload-iso block-migration-applies? block-migrate-payload block-rollback-payload)) (answer "(define (block-with-refs blk new-refs) (make-block (block-tag blk) (block-payload blk) new-refs))"))
(task-entry (id "optics/optics/iso-id") (skill optics) (module optics) (tier 1) (difficulty 11009) (name iso-id) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose)) (answer "(define iso-id (make-iso identity identity))"))
(task-entry (id "optics/block-optics/block-type-prism") (skill optics) (module block-optics) (tier 1) (difficulty 11009) (name block-type-prism) (type "(-> Symbol (Prism Block Block))") (description "Match blocks with a specific tag.") (notes ()) (section type-prisms) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens block-ref-at block-refs-each block-refs-count follow-ref block-child-at block-children-each)) (answer "(define (block-type-prism expected-tag) (make-prism (lambda (blk) (if (eq? (block-tag blk) expected-tag) (just blk) nothing)) identity))"))
(task-entry (id "optics/profunctor-optics/strong?") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11009) (name strong?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong)) (answer "(define (strong? x) (and (pair? x) (eq? (car x) 'strong)))"))
(task-entry (id "optics/bidirectional/migration-compose") (skill optics) (module bidirectional) (tier 1) (difficulty 11009) (name migration-compose) (type "(-> Migration Migration Migration)") (description "Compose two migrations: (m1 ; m2) where m1.to = m2.from.\nResult transforms from m1.from to m2.to.\n\nForward:  m1.forward then m2.forward\nBackward: m2.backward then m1.backward") (notes ()) (section composition) (deps (\x27;profunctor-optics)) (available (make-migration migration? migration-name migration-from migration-to migration-iso migrate rollback migration-apply)) (answer "(define (migration-compose m1 m2) (unless (equal? (migration-to m1) (migration-from m2)) (error 'migration-compose \"Version mismatch: ~a.to (~a) != ~a.from (~a)\" (migration-name m1) (migration-to m1) (migration-name m2) (migration-from m2))) (let* ((iso1 (migration-iso m1)) (iso2 (migration-iso m2)) (combined-iso (make-p-iso (compose2 (p-iso-forward iso2) (p-iso-forward iso1)) (compose2 (p-iso-backward iso1) (p-iso-backward iso2)))) (combined-name (string->symbol (format \"~a->~a\" (migration-from m1) (migration-to m2))))) (make-migration combined-name (migration-from m1) (migration-to m2) combined-iso)))"))
(task-entry (id "optics/format-iso/iso-alist-keys-sorted") (skill optics) (module format-iso) (tier 1) (difficulty 11009) (name iso-alist-keys-sorted) (type "") (description "") (notes ()) (section alist) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string sexpr->bytevector bytevector->sexpr iso-sexpr-bytevector iso-list-vector)) (answer "(define iso-alist-keys-sorted (make-p-iso (lambda (alist) (sort-by (lambda (a b) (string<? (symbol->string (car a)) (symbol->string (car b)))) alist)) identity))"))
(task-entry (id "optics/schema/field-ensure-iso") (skill optics) (module schema) (tier 1) (difficulty 11009) (name field-ensure-iso) (type "(-> Symbol Any (PIso Alist Alist))") (description "Ensure a field exists with default if missing. Forward: add field if missing. Backward: identity (don't remove field that might have been present)") (notes ()) (section field-defaults) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso field-split-iso field-merge-iso field-move-to-front-iso nested-field-iso)) (answer "(define (field-ensure-iso field default) (make-p-iso (lambda (alist) (if (assq field alist) alist (cons (cons field default) alist))) identity))"))
(task-entry (id "optics/block-migration/block-migrate-with-refs") (skill optics) (module block-migration) (tier 1) (difficulty 11009) (name block-migrate-with-refs) (type "(-> BlockMigration Block (Vector Bytevector) Block)") (description "Apply migration with updated refs (for tree traversal).") (notes ()) (section refs) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag block-migration-to-tag block-migration-payload-iso block-migration-applies? block-migrate-payload block-rollback-payload block-with-refs)) (answer "(define (block-migrate-with-refs bm blk new-refs) (let* ((from-tag (block-migration-from-tag bm)) (to-tag (block-migration-to-tag bm)) (payload-iso (block-migration-payload-iso bm))) (if (not (eq? (block-tag blk) from-tag)) (make-block (block-tag blk) (block-payload blk) new-refs) (let* ((payload (block-payload blk)) (sexpr (bytevector->sexpr payload)) (new-sexpr ((p-iso-forward payload-iso) sexpr)) (new-payload (sexpr->bytevector new-sexpr))) (make-block to-tag new-payload new-refs)))))"))
(task-entry (id "optics/optics/iso-curried") (skill optics) (module optics) (tier 1) (difficulty 11010) (name iso-curried) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id)) (answer "(define iso-curried (make-iso (lambda (f) (lambda (a) (lambda (b) (f (cons a b))))) (lambda (f) (lambda (ab) ((f (car ab)) (cdr ab))))))"))
(task-entry (id "optics/block-optics/block-lambda-prism") (skill optics) (module block-optics) (tier 1) (difficulty 11010) (name block-lambda-prism) (type "") (description "") (notes ()) (section type-prisms) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens block-ref-at block-refs-each block-refs-count follow-ref block-child-at block-children-each block-type-prism)) (answer "(define block-lambda-prism (block-type-prism 'lambda))"))
(task-entry (id "optics/profunctor-optics/strong-profunctor") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11010) (name strong-profunctor) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong?)) (answer "(define (strong-profunctor s) (cadr s))"))
(task-entry (id "optics/bidirectional/migration-chain") (skill optics) (module bidirectional) (tier 1) (difficulty 11010) (name migration-chain) (type "(-> (List Migration) Migration)") (description "Compose a list of migrations into a single migration.\nMigrations must form a valid chain: each m.to = next m.from.") (notes ()) (section composition) (deps (\x27;profunctor-optics)) (available (make-migration migration? migration-name migration-from migration-to migration-iso migrate rollback migration-apply migration-compose)) (answer "(define (migration-chain migrations) (cond ((null? migrations) (error 'migration-chain \"Empty migration list\")) ((null? (cdr migrations)) (car migrations)) (else (fold-left migration-compose (car migrations) (cdr migrations)))))"))
(task-entry (id "optics/format-iso/iso-number-string") (skill optics) (module format-iso) (tier 1) (difficulty 11010) (name iso-number-string) (type "") (description "") (notes ()) (section numbers) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string sexpr->bytevector bytevector->sexpr iso-sexpr-bytevector iso-list-vector iso-alist-keys-sorted)) (answer "(define iso-number-string (make-p-iso number->string string->number))"))
(task-entry (id "optics/schema/field-with-default-iso") (skill optics) (module schema) (tier 1) (difficulty 11010) (name field-with-default-iso) (type "(-> Any (PIso (Maybe a) a))") (description "Provide default for a field value. Used with field-transform-iso when field might be missing") (notes ()) (section field-defaults) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso field-transform-if-present-iso field-split-iso field-merge-iso field-move-to-front-iso nested-field-iso field-ensure-iso)) (answer "(define (field-with-default-iso default) (make-p-iso (lambda (v) (if v v default)) identity))"))
(task-entry (id "optics/block-migration/parse-versioned-tag") (skill optics) (module block-migration) (tier 1) (difficulty 11010) (name parse-versioned-tag) (type "(-> Symbol (Pair Symbol (Maybe Number)))") (description "Parse a versioned tag like 'bbs-issue-v2 into base and version.") (notes ()) (section version-detection) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag block-migration-to-tag block-migration-payload-iso block-migration-applies? block-migrate-payload block-rollback-payload block-with-refs block-migrate-with-refs)) (answer "(define (parse-versioned-tag tag) (let* ((s (symbol->string tag)) (len (string-length s))) (let loop ((i (- len 1))) (cond ((< i 2) (cons tag #f)) ((and (char=? (string-ref s i) #\\v) (char=? (string-ref s (- i 1)) #\\-)) (let ((num-str (substring s (+ i 1) len))) (let ((num (string->number num-str))) (if num (cons (string->symbol (substring s 0 (- i 1))) num) (cons tag #f))))) (else (loop (- i 1)))))))"))
