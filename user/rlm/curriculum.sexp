(task-entry (id "physics/classical/ascii-renderer/draw-filled-circle!") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23537) (name draw-filled-circle!) (type "") (description "") (notes ()) (section filled) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line!)) (answer "(define (draw-filled-circle! frame cx cy radius char config) (let ((w (config-width config)) (h (config-height config))) (do ((dy (- radius) (+ dy 1))) ((> dy radius)) (let* ((y (+ cy dy)) (dy-sq (* dy dy)) (r-sq (* radius radius))) (when (and (>= y 0) (< y h) (<= dy-sq r-sq)) (let ((dx (inexact->exact (floor (sqrt (- r-sq dy-sq)))))) (do ((x (- cx dx) (+ x 1))) ((> x (+ cx dx))) (when (and (>= x 0) (< x w)) (frame-set! frame x y char)))))))))"))
