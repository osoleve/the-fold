(task-entry (id "optimization/first-order/gradient-descent-ls") (skill optimization) (module first-order) (tier 1) (difficulty 12809) (name gradient-descent-ls) (type "(-> (-> (List TracedValue) TracedValue) (List Number) ConvergenceCriteria OptResult)") (description "Gradient descent with Armijo line search") (notes ()) (section line-search-variants) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum adam adam-full rmsprop rmsprop-full adagrad adagrad-full)) (answer "(define (gradient-descent-ls f x0 criteria) (let* ((init-grad (gradient f x0)) (init-f (apply f x0)) (init-state (initial-convergence-state init-f init-grad))) (let loop ((x x0) (state init-state)) (let ((reason (converged? criteria state))) (if reason (make-opt-result x (cs-f-val state) (gradient f x) (cs-iter state) reason) (let* ((grad (gradient f x)) (direction (map - grad)) (ls-result (armijo-backtrack f x grad direction)) (x-new (car ls-result)) (f-new (apply f x-new)) (grad-new (gradient f x-new)) (new-state (update-convergence-state state f-new grad-new x x-new))) (loop x-new new-state)))))))"))
(task-entry (id "optimization/newton/hessian-vector-product") (skill optimization) (module newton) (tier 1) (difficulty 12809) (name hessian-vector-product) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton make-positive-definite newton-cg newton-cg-full cg-newton-direction)) (answer "(define (hessian-vector-product f x v) (let* ((eps 1e-6) (x+ (vec-add-scaled x v eps)) (x- (vec-add-scaled x v (- eps))) (grad+ (gradient f x+)) (grad- (gradient f x-))) (map (lambda (g+ g-) (/ (- g+ g-) (* 2 eps))) grad+ grad-)))"))
