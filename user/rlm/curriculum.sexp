(task-entry (id "game-theory/extensive-form/signaling-simple") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13235) (name signaling-simple) (type "") (description "") (notes ()) (section classic-games) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper solve-spe spe-result? spe-payoffs spe-strategy expected-utility ultimatum-game make-centipede-game centipede-4 entry-deterrence stackelberg-simple)) (answer "(define signaling-simple (make-extensive-game 2 (make-chance '(high-type low-type) '(0.5 0.5) (list (make-decision 0 '(signal no-signal) (list (make-decision 1 '(accept reject) (list (make-terminal '(9 10)) (make-terminal '(-1 0)))) (make-decision 1 '(accept reject) (list (make-terminal '(10 10)) (make-terminal '(0 0)))))) (make-decision 0 '(signal no-signal) (list (make-decision 1 '(accept reject) (list (make-terminal '(5 -5)) (make-terminal '(-5 0)))) (make-decision 1 '(accept reject) (list (make-terminal '(10 -5)) (make-terminal '(0 0))))))))))"))
(task-entry (id "game-theory/coop-games/nash-bargaining") (skill game-theory) (module coop-games) (tier 1) (difficulty 13235) (name nash-bargaining) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set)) (answer "(define (nash-bargaining g) (if (not (= 2 (coop-game-players g))) (error 'nash-bargaining \"requires 2-player game\") (let* ((bs (bargaining-set g)) (d0 (vector-ref bs 0)) (d1 (vector-ref bs 1)) (v01 (coop-game-value g 3)) (surplus (- v01 d0 d1))) (vector (+ d0 (/ surplus 2)) (+ d1 (/ surplus 2))))))"))
