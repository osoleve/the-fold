(task-entry (id "fp/proof-tactics/tactic-repeat") (skill fp) (module proof-tactics) (tier 1) (difficulty 10621) (name tactic-repeat) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;engine \x27;rewrite/laws)) (available (make-proof-goal proof-goal? goal-lhs goal-rhs goal-context goal-trivial? tactic-success tactic-failure tactic-success? tactic-failure? tactic-subgoals tactic-builder tactic-error tactic-refl tactic-sym tactic-trans tactic-rewrite tactic-topdown tactic-bottomup tactic-try *tactic-repeat-fuel*)) (answer "(define tactic-repeat (case-lambda ((t) (tactic-repeat t *tactic-repeat-fuel*)) ((t fuel) (lambda (goal) (let loop ((current-goal goal) (remaining fuel) (proof-steps '())) (if (<= remaining 0) (tactic-success (if (goal-trivial? current-goal) '() (list current-goal)) (lambda (proofs) (fold-proofs proof-steps proofs))) (let ((result (t current-goal))) (if (tactic-failure? result) (tactic-success (if (goal-trivial? current-goal) '() (list current-goal)) (lambda (proofs) (fold-proofs proof-steps proofs))) (let ((subgoals (tactic-subgoals result)) (builder (tactic-builder result))) (if (null? subgoals) (tactic-success '() (lambda () (fold-proofs (cons builder proof-steps) '()))) (let ((next-goal (car subgoals))) (if (equal? next-goal current-goal) (tactic-success (if (goal-trivial? current-goal) '() (list current-goal)) (lambda (proofs) (fold-proofs proof-steps proofs))) (loop next-goal (- remaining 1) (cons builder proof-steps))))))))))))))"))
