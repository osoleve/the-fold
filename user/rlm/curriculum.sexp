(task-entry (id "fp/zipper-lens/zipper-collect") (skill fp) (module zipper-lens) (tier 1) (difficulty 10637) (name zipper-collect) (type "(-> (-> α (Maybe β)) (ListZipper α) (List β))") (description "Collect results from a partial function applied to each element") (notes ()) (section traversal-utilities) (deps (\x27;prelude \x27;combinators \x27;templates \x27;zipper \x27;tree-zipper)) (available (zipper-focus-lens zipper-focus-maybe-lens zipper-left-lens zipper-right-lens zipper-position-lens tree-zipper-focus-lens tree-zipper-value-lens tree-zipper-children-lens tree-zipper-crumbs-lens tree-zipper-depth-lens make-affine affine? affine-getter affine-setter preview-affine set-affine over-affine zipper-left-affine zipper-right-affine zipper-nth-affine tree-up-affine tree-down-affine tree-left-affine tree-right-affine tree-nth-child-affine tree-child-value-affine follow-path zipper-to-lens tree-path-to-lens list-set extend-with-lens map-with-context neighbor-lens window-lens zipper-each zipper-all? zipper-any?)) (answer "(define (zipper-collect f z) (let loop ((current (zipper-start z)) (acc '())) (if (not (zipper-has-focus? current)) (reverse acc) (let* ((result (f (zipper-focus current))) (new-acc (if (just? result) (cons (from-just result) acc) acc)) (next (zipper-right! current))) (if (nothing? next) (reverse new-acc) (loop (from-just next) new-acc))))))"))
(task-entry (id "fp/expr/bindings-consistent?") (skill fp) (module expr) (tier 1) (difficulty 10637) (name bindings-consistent?) (type "") (description "") (notes ()) (section pattern-matching) (deps (\x27;prelude)) (available (num var make-sum make-product make-diff make-neg make-div make-pow make-app sum product difference division power num? var? sum? product? difference? quotient? power? app? num-val var-name sum-terms product-factors diff-left diff-right quot-numer quot-denom pow-base pow-exp app-fn app-arg list-all-equal? expr=? match-expr)) (answer "(define (bindings-consistent? b1 b2) (let loop ((bindings b1)) (if (null? bindings) #t (let* ((pair (car bindings)) (var (car pair)) (val (cdr pair)) (existing (assq var b2))) (if existing (if (equal? val (cdr existing)) (loop (cdr bindings)) #f) (loop (cdr bindings)))))))"))
(task-entry (id "fp/simplify/to-canonical") (skill fp) (module simplify) (tier 1) (difficulty 10637) (name to-canonical) (type "(-> Expr Expr)") (description "Convert to canonical form: sorted by complexity, numeric constants first") (notes ()) (section canonical-form) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow simplify-app expand expand-once expand-product expand-power-of-sum factor factor-sum find-common-factor get-factors divides? divide-out simplify-trig simplify-trig-once simplify-pythagorean-identity find-sin-squared find-matching-cos-squared simplify-double-angle-product remove-first)) (answer "(define (to-canonical expr) (cond ((num? expr) expr) ((var? expr) expr) ((sum? expr) (let ((terms (map to-canonical (sum-terms expr)))) (make-sum-from-list (sort-by-complexity terms)))) ((product? expr) (let ((factors (map to-canonical (product-factors expr)))) (make-product-from-list (sort-by-complexity factors)))) ((difference? expr) (if (diff-right expr) (difference (to-canonical (diff-left expr)) (to-canonical (diff-right expr))) (make-neg (to-canonical (diff-left expr))))) ((quotient? expr) (division (to-canonical (quot-numer expr)) (to-canonical (quot-denom expr)))) ((power? expr) (power (to-canonical (pow-base expr)) (to-canonical (pow-exp expr)))) ((app? expr) (make-app (app-fn expr) (to-canonical (app-arg expr)))) (else expr)))"))
