(task-entry (id "dsl/staging/stage-if") (skill dsl) (module staging) (tier 1) (difficulty 11727) (name stage-if) (type "") (description "") (notes ()) (section staging-detection) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code code? code-stage code-expr stage-quote? stage-splice? stage-run? make-stage-env stage-env? stage-env-level stage-env-bindings stage-env-fragments stage-env-incr stage-env-decr stage-env-bind stage-env-lookup stage-env-add-fragment stage-expand code-combine code-lift code-unlift code-type code-well-staged? stage-add stage-mul stage-sub stage-div)) (answer "(define (stage-if cond-c then-c else-c) (let ((s (code-stage cond-c))) (if (and (= s (code-stage then-c)) (= s (code-stage else-c))) (make-code s (quasiquote (if (unquote (code-expr cond-c)) (unquote (code-expr then-c)) (unquote (code-expr else-c))))) (error 'stage-if \"stage mismatch\"))))"))
(task-entry (id "dsl/tagless/pretty-bool-dict") (skill dsl) (module tagless) (tier 1) (difficulty 11728) (name pretty-bool-dict) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops dict-ref dict-has? dict-extend dict-merge make-expr-dict expr-lit expr-add expr-neg eval-expr-dict pretty-expr-dict count-expr-dict depth-expr-dict example-expr-1 example-expr-2 make-mul-dict expr-mul eval-mul-dict pretty-mul-dict example-mul make-bool-dict bool-lit bool-and bool-or bool-not eval-bool-dict)) (answer "(define pretty-bool-dict (make-bool-dict (lambda (b) (if b \"true\" \"false\")) (lambda (x y) (string-append \"(\" x \" && \" y \")\")) (lambda (x y) (string-append \"(\" x \" || \" y \")\")) (lambda (x) (string-append \"(!\" x \")\"))))"))
