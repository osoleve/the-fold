(task-entry (id "autodiff/typed-gradients/dim-gradient-ref") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12704) (name dim-gradient-ref) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values)) (answer "(define (dim-gradient-ref g i) (if (not (dim-gradient? g)) (list 'error 'not-a-gradient g) (let ((values (dim-gradient-values g)) (dim (dim-gradient-dim g))) (if (or (< i 0) (>= i dim)) (list 'error 'index-out-of-bounds (list 'index i) (list 'dimension dim)) (list-ref values i)))))"))
