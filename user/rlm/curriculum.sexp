(task-entry (id "tiles/square/make-square-board") (skill tiles) (module square) (tier 1) (difficulty 12315) (name make-square-board) (type "") (description "") (notes ()) (section board-creation) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho square-neighbors-diag square-neighbors-all square-neighbors square-distance-manhattan square-distance-chebyshev square-distance-euclidean square-distance square-line square-range square-ring)) (answer "(define make-square-board (case-lambda ((width height) (make-board 'square (quasiquote ((width unquote width) (height unquote height))))) ((width height default-tile) (let ((board (make-board 'square (quasiquote ((width unquote width) (height unquote height)))))) (let loop ((x 0) (y 0) (b board)) (cond ((>= y height) b) ((>= x width) (loop 0 (+ y 1) b)) (else (loop (+ x 1) y (board-set b (square-coord x y) default-tile)))))))))"))
(task-entry (id "tiles/hex/hex-rotate-left") (skill tiles) (module hex) (tier 1) (difficulty 12315) (name hex-rotate-left) (type "(-> AxialCoord AxialCoord AxialCoord)") (description "Rotate coord 60° counter-clockwise around center") (notes ()) (section rotation-reflection) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial hex-axial-directions hex-neighbor hex-neighbors hex-neighbors-at-distance hex-distance hex-line hex-range hex-ring)) (answer "(define (hex-rotate-left center coord) (let* ((rel (axial-coord (- (coord-x coord) (coord-x center)) (- (coord-y coord) (coord-y center)))) (cube (axial->cubic rel)) (x (cubic-coord%-x cube)) (y (cubic-coord%-y cube)) (z (cubic-coord%-z cube)) (rotated (cubic-coord (- z) (- x) (- y))) (result (cubic->axial rotated))) (axial-coord (+ (coord-x result) (coord-x center)) (+ (coord-y result) (coord-y center)))))"))
(task-entry (id "tiles/triangle/make-triangle-board") (skill tiles) (module triangle) (tier 1) (difficulty 12315) (name make-triangle-board) (type "(-> Integer Integer Board)") (description "Create rectangular triangular board. Each (row, col) contains 2 triangles.") (notes ()) (section board-creation) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge triangle-neighbors-vertex triangle-neighbors-all triangle-neighbors triangle-distance-manhattan triangle-line triangle-range)) (answer "(define make-triangle-board (case-lambda ((rows cols) (make-board 'triangle (quasiquote ((rows unquote rows) (cols unquote cols))) triangle-coord-hash triangle-coord-equal?)) ((rows cols default-tile) (let ((board (make-board 'triangle (quasiquote ((rows unquote rows) (cols unquote cols))) triangle-coord-hash triangle-coord-equal?))) (let loop-r ((r 0) (b board)) (if (>= r rows) b (let loop-c ((c 0) (board2 b)) (if (>= c cols) (loop-r (+ r 1) board2) (let* ((b1 (board-set board2 (triangle-coord r c 'up) default-tile)) (b2 (board-set b1 (triangle-coord r c 'down) default-tile))) (loop-c (+ c 1) b2))))))))))"))
