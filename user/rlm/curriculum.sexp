(task-entry (id "optics/format-iso/iso-sexpr-string") (skill optics) (module format-iso) (tier 1) (difficulty 11004) (name iso-sexpr-string) (type "") (description "") (notes ()) (section sexpr) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr)) (answer "(define iso-sexpr-string (make-p-iso sexpr->string-fmt string->sexpr))"))
(task-entry (id "optics/schema/field-transform-if-present-iso") (skill optics) (module schema) (tier 1) (difficulty 11004) (name field-transform-if-present-iso) (type "(-> Symbol PIso (PIso Alist Alist))") (description "Like field-transform-iso but safely skips if field is missing. Use this for optional fields where absence is valid") (notes ()) (section field-transform) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso field-transform-iso)) (answer "(define (field-transform-if-present-iso field value-iso) (make-p-iso (lambda (alist) (if (assq field alist) (map (lambda (pair) (if (eq? (car pair) field) (cons field ((p-iso-forward value-iso) (cdr pair))) pair)) alist) alist)) (lambda (alist) (if (assq field alist) (map (lambda (pair) (if (eq? (car pair) field) (cons field ((p-iso-backward value-iso) (cdr pair))) pair)) alist) alist))))"))
(task-entry (id "optics/block-migration/block-migration-payload-iso") (skill optics) (module block-migration) (tier 1) (difficulty 11004) (name block-migration-payload-iso) (type "(-> BlockMigration PIso)") (description "") (notes ()) (section block-migration-type) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag block-migration-to-tag)) (answer "(define (block-migration-payload-iso bm) (cadddr bm))"))
