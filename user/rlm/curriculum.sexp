(task-entry (id "linalg/matrix-decomp/matrix-copy") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 401) (name matrix-copy) (type "") (description "Copy a matrix to a new data structure.") (notes ()) (section helper-functions) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance*)) (answer "(define (matrix-copy m) (let* ((rows (matrix-rows m)) (cols (matrix-cols m)) (data (matrix-data m)) (new-data (make-vector (* rows cols) 0))) (do ((i 0 (+ i 1))) ((= i (* rows cols)) (list 'matrix rows cols new-data)) (vector-set! new-data i (vector-ref data i)))))"))
(task-entry (id "linalg/matrix-solvers/matrix-back-substitute") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 401) (name matrix-back-substitute) (type "") (description "") (notes ()) (section substitution) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute)) (answer "(define (matrix-back-substitute u y) (let* ((n (vector-length y)) (x (make-vector n 0))) (do ((i (- n 1) (- i 1))) ((< i 0) x) (let ((sum (let loop ((j (+ i 1)) (s 0)) (if (= j n) s (loop (+ j 1) (+ s (* (matrix-ref u i j) (vector-ref x j)))))))) (vector-set! x i (/ (- (vector-ref y i) sum) (matrix-ref u i i)))))))"))
