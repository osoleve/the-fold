(task-entry (id "physics/classical/ascii-renderer/render-entity-shape!") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23549) (name render-entity-shape!) (type "") (description "") (notes ()) (section entity) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line! draw-filled-circle! polygon-scanline-intersections fill-between-pairs! draw-filled-polygon! draw-filled-aabb! draw-aabb-outline! fmod angle->arrow-char draw-velocity-vector! draw-contact! draw-constraint! get-entity-shape-world)) (answer "(define (render-entity-shape! frame entity char config) (let ((shape (get-entity-shape-world entity))) (cond ((circle? shape) (let* ((center (circle-center shape)) (radius (circle-radius shape)) (screen (world->screen center config)) (screen-radius (max 1 (inexact->exact (round (* radius (config-scale config))))))) (draw-filled-circle! frame (car screen) (cdr screen) screen-radius char config))) ((aabb? shape) (draw-filled-aabb! frame shape char config)) ((polygon? shape) (draw-filled-polygon! frame (polygon-vertices shape) char config)))))"))
