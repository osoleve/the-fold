(task-entry (id "fp/simplify/find-sin-squared") (skill fp) (module simplify) (tier 1) (difficulty 10633) (name find-sin-squared) (type "(-> Expr (Maybe Expr))") (description "Check if expression is sin^2(x), return x if so") (notes ()) (section trigonometric-identities) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow simplify-app expand expand-once expand-product expand-power-of-sum factor factor-sum find-common-factor get-factors divides? divide-out simplify-trig simplify-trig-once simplify-pythagorean-identity)) (answer "(define (find-sin-squared expr) (if (and (power? expr) (num? (pow-exp expr)) (= (num-val (pow-exp expr)) 2) (app? (pow-base expr)) (eq? (app-fn (pow-base expr)) 'sin)) (app-arg (pow-base expr)) #f))"))
