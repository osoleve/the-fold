(task-entry (id "linalg/matrix-eigen/symmetric-converged?") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 418) (name symmetric-converged?) (type "") (description "") (notes ()) (section symmetric-eigen) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop eigen-decomposition symmetric-eigen symmetric-eigen-loop)) (answer "(define (symmetric-converged? a tol) (let ((n (matrix-rows a))) (let row-loop ((i 0)) (if (>= i n) #t (let col-loop ((j 0)) (if (>= j n) (row-loop (+ i 1)) (if (and (not (= i j)) (> (abs (matrix-ref a i j)) tol)) #f (col-loop (+ j 1)))))))))"))
(task-entry (id "linalg/iterative-solvers/apply-givens-rotations") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 418) (name apply-givens-rotations) (type "") (description "") (notes ()) (section gmres) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres gmres-outer gmres-arnoldi gmres-arnoldi-loop)) (answer "(define (apply-givens-rotations h-data cs sn j k) (do ((i 0 (+ i 1))) ((= i j)) (let* ((h-ij-idx (+ (* i k) j)) (h-i1j-idx (+ (* (+ i 1) k) j)) (h-ij (vector-ref h-data h-ij-idx)) (h-i1j (vector-ref h-data h-i1j-idx)) (c (vector-ref cs i)) (s (vector-ref sn i)) (new-hij (+ (* c h-ij) (* s h-i1j))) (new-hi1j (+ (* (- s) h-ij) (* c h-i1j)))) (vector-set! h-data h-ij-idx new-hij) (vector-set! h-data h-i1j-idx new-hi1j))))"))
