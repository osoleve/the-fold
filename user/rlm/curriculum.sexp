(task-entry (id "dataset/presentation/string-split-lines") (skill dataset) (module presentation) (tier 1) (difficulty 13438) (name string-split-lines) (type "") (description "") (notes ()) (section rendering) (deps (\x27;prelude \x27;layout)) (available (make-text-block text-block? text-block-content text-block-width text-block-alignment make-frame-block frame-block? frame-block-content frame-block-width frame-block-height frame-block-border? make-textbox textbox? textbox-label textbox-pairs textbox-width textbox-style make-spacer spacer? spacer-height make-divider divider? divider-width divider-char layout-vstack layout-vstack? layout-vstack-elements layout-hstack layout-hstack? layout-hstack-elements layout-hstack-gap layout-beside layout-above element-height element-width render-element render-text-block render-frame-block)) (answer "(define (string-split-lines s) (let loop ((chars (string->list s)) (current '()) (lines '())) (cond ((null? chars) (reverse (if (null? current) lines (cons (list->string (reverse current)) lines)))) ((char=? (car chars) #\\\n) (loop (cdr chars) '() (cons (list->string (reverse current)) lines))) (else (loop (cdr chars) (cons (car chars) current) lines)))))"))
