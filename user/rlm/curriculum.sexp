(task-entry (id "physics/classical/integrators/spring-force") (skill physics/classical) (module integrators) (tier 2) (difficulty 23531) (name spring-force) (type "") (description "") (notes ()) (section common) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet integrate-body-rk4 make-time-acc time-acc? time-acc-remaining time-acc-fixed-dt time-acc-max-steps time-acc-add time-acc-consume time-acc-alpha substep-body integrate-with-substeps interpolate-body gravity-force)) (answer "(define (spring-force anchor k damping) (lambda (body) (let* ((pos (body-pos body)) (vel (body-vel body)) (displacement (vec2-sub anchor pos)) (spring-f (vec2-scale displacement k)) (damp-f (vec2-scale vel (- damping)))) (vec2-add spring-f damp-f))))"))
(task-entry (id "physics/classical/rigid-body/rigid-body-angular-momentum") (skill physics/classical) (module rigid-body) (tier 2) (difficulty 23531) (name rigid-body-angular-momentum) (type "") (description "") (notes ()) (section energy) (deps (\x27;prelude \x27;vec2)) (available (make-rigid-body rigid-body? rigid-body-pos rigid-body-vel rigid-body-angle rigid-body-angular-vel rigid-body-mass rigid-body-inv-mass rigid-body-inertia rigid-body-inv-inertia rigid-body-static? rigid-body-with-pos rigid-body-with-vel rigid-body-with-angle rigid-body-with-angular-vel rigid-body-with-mass rigid-body-with-inertia rigid-body-with-state make-static-rigid-body circle-inertia rectangle-inertia rod-inertia point-mass-inertia local-to-world world-to-local rigid-body-velocity-at apply-linear-impulse apply-angular-impulse apply-impulse-at-point rigid-body-kinetic-energy rigid-body-linear-momentum)) (answer "(define (rigid-body-angular-momentum body) (* (rigid-body-inertia body) (rigid-body-angular-vel body)))"))
(task-entry (id "physics/classical/collision-detection/aabb-aabb?") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23531) (name aabb-aabb?) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon?)) (answer "(define (aabb-aabb? a b) (let ((a-min (aabb-min a)) (a-max (aabb-max a)) (b-min (aabb-min b)) (b-max (aabb-max b))) (and (<= (vec2-x a-min) (vec2-x b-max)) (>= (vec2-x a-max) (vec2-x b-min)) (<= (vec2-y a-min) (vec2-y b-max)) (>= (vec2-y a-max) (vec2-y b-min)))))"))
(task-entry (id "physics/classical/collision-response/apply-impulse-at") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23531) (name apply-impulse-at) (type "") (description "") (notes ()) (section impulse) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material combine-materials velocity-at-point relative-velocity-at relative-velocity normal-velocity-at normal-velocity tangent-velocity get-inv-mass get-inv-inertia get-body-pos calculate-impulse-with-rotation calculate-impulse calculate-friction-impulse body-is-static?)) (answer "(define (apply-impulse-at body impulse contact) (if (body-is-static? body) body (if (rigid-body? body) (let* ((inv-mass (rigid-body-inv-mass body)) (inv-i (rigid-body-inv-inertia body)) (r (vec2-sub contact (rigid-body-pos body))) (torque (vec2-cross r impulse)) (new-vel (vec2-add (rigid-body-vel body) (vec2-scale impulse inv-mass))) (new-omega (+ (rigid-body-angular-vel body) (* torque inv-i)))) (rigid-body-with-angular-vel (rigid-body-with-vel body new-vel) new-omega)) (let ((new-vel (vec2-add (body-vel body) (vec2-scale impulse (body-inv-mass body))))) (body-with-vel body new-vel)))))"))
