(task-entry (id "linalg/graph-laplacian/laplacian-trace") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 413) (name laplacian-trace) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition)) (answer "(define (laplacian-trace L) (let ((n (matrix-rows L))) (let loop ((i 0) (sum 0)) (if (= i n) sum (loop (+ i 1) (+ sum (matrix-ref L i i)))))))"))
(task-entry (id "linalg/svd/svd-thin") (skill linalg) (module svd) (tier 0) (difficulty 413) (name svd-thin) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data)) (answer "(define (svd-thin a . opts) (let* ((m (matrix-rows a)) (n (matrix-cols a)) (max-iter (if (and (pair? opts) (integer? (car opts))) (car opts) *svd-max-iterations*)) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (tol (if (and (pair? rest1) (number? (car rest1))) (car rest1) *svd-tolerance*)) (full-svd (svd a max-iter tol))) (if (and (pair? full-svd) (eq? (car full-svd) 'error)) full-svd (let* ((u-full (car full-svd)) (sigma-full (cadr full-svd)) (v-full (caddr full-svd)) (k (min m n))) (if (>= m n) (list (matrix-slice-cols u-full 0 n) (matrix-slice sigma-full 0 n 0 n) v-full) (list u-full (matrix-slice sigma-full 0 m 0 m) (matrix-slice-cols v-full 0 m)))))))"))
