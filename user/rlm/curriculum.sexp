(task-entry (id "statistics/design-matrix/chebyshev-t") (skill statistics) (module design-matrix) (tier 1) (difficulty 11214) (name chebyshev-t) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p)) (answer "(define (chebyshev-t n x) (cond ((= n 0) 1) ((= n 1) x) (else (let loop ((k 2) (t-2 1) (t-1 x)) (if (> k n) t-1 (let ((t-k (- (* 2 x t-1) t-2))) (loop (+ k 1) t-1 t-k)))))))"))
(task-entry (id "statistics/linear/compute-XtX-inverse") (skill statistics) (module linear) (tier 1) (difficulty 11214) (name compute-XtX-inverse) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit linear-model-compute-diagnostics compute-coefficient-se compute-t-values compute-p-values compute-r-squared compute-adj-r-squared weighted-linear-fit weight-matrix weight-vector weighted-diagnostics compute-weighted-se linear-model-predict linear-model-predict-interval)) (answer "(define (compute-XtX-inverse X) (let* ((n (matrix-rows X)) (p (matrix-cols X)) (XtX-data (make-vector (* p p) 0))) (do ((j 0 (+ j 1))) ((= j p)) (do ((k 0 (+ k 1))) ((= k p)) (let ((sum (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (* (matrix-ref X i j) (matrix-ref X i k)))))))) (vector-set! XtX-data (+ (* j p) k) sum)))) (matrix-inverse (list 'matrix p p XtX-data))))"))
(task-entry (id "statistics/regularized/split-fold") (skill statistics) (module regularized) (tier 1) (difficulty 11214) (name split-fold) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics compute-r-squared-ridge lasso-fit lasso-coordinate-descent lasso-partial-residual soft-threshold lasso-finalize count-nonzero elastic-net-fit elastic-net-coordinate-descent elastic-net-update cross-validate-lambda cv-error-for-lambda)) (answer "(define (split-fold X y start end n) (let* ((p (matrix-cols X)) (n-test (- end start)) (n-train (- n n-test)) (X-train-data (make-vector (* n-train p))) (X-test-data (make-vector (* n-test p))) (y-train (make-vector n-train)) (y-test (make-vector n-test))) (let ((train-idx 0) (test-idx 0)) (do ((i 0 (+ i 1))) ((= i n)) (if (and (>= i start) (< i end)) (begin (vector-set! y-test test-idx (vector-ref y i)) (do ((j 0 (+ j 1))) ((= j p)) (vector-set! X-test-data (+ (* test-idx p) j) (matrix-ref X i j))) (set! test-idx (+ test-idx 1))) (begin (vector-set! y-train train-idx (vector-ref y i)) (do ((j 0 (+ j 1))) ((= j p)) (vector-set! X-train-data (+ (* train-idx p) j) (matrix-ref X i j))) (set! train-idx (+ train-idx 1)))))) (list (list 'matrix n-train p X-train-data) y-train (list 'matrix n-test p X-test-data) y-test)))"))
(task-entry (id "statistics/glm/glm-predict") (skill statistics) (module glm) (tier 1) (difficulty 11214) (name glm-predict) (type "") (description "") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available (glm-fit irls-loop irls-step weighted-least-squares irls-converged? irls-finalize compute-glm-se compute-z-values compute-z-pvalues compute-deviance-residuals logistic-fit poisson-fit gamma-fit probit-fit)) (answer "(define (glm-predict model X-new) (let* ((beta (glm-coefficients model)) (link-name (glm-link model)) (link (case link-name ((identity) identity-link) ((logit) logit-link) ((log) log-link) ((probit) probit-link) (else identity-link))) (g-inv (link-inverse link)) (eta (matrix-vec-mul X-new beta)) (n (vector-length eta)) (mu (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) mu) (vector-set! mu i (g-inv (vector-ref eta i))))))"))
