(task-entry (id "autodiff/symbolic-diff/simplify-once") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12707) (name simplify-once) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify)) (answer "(define (simplify-once expr) (cond ((num? expr) expr) ((var? expr) expr) ((sum? expr) (simplify-sum (map simplify-once (sum-terms expr)))) ((product? expr) (simplify-product (map simplify-once (product-factors expr)))) ((difference? expr) (if (diff-right expr) (simplify-diff (simplify-once (diff-left expr)) (simplify-once (diff-right expr))) (simplify-neg (simplify-once (diff-left expr))))) ((quotient? expr) (simplify-quot (simplify-once (quot-numer expr)) (simplify-once (quot-denom expr)))) ((power? expr) (simplify-pow (simplify-once (pow-base expr)) (simplify-once (pow-exp expr)))) ((app? expr) (simplify-app (app-fn expr) (simplify-once (app-arg expr)))) (else expr)))"))
