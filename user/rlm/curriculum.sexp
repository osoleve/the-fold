(task-entry (id "physics/classical/particles/particle-system-add-emitter") (skill physics/classical) (module particles) (tier 2) (difficulty 23550) (name particle-system-add-emitter) (type "(particle-system-add-emitter : ParticleSystem × Emitter → ParticleSystem)") (description "") (notes ()) (section particle) (deps (\x27;prelude \x27;sort \x27;vec2 \x27;prng)) (available (make-particle particle? particle-pos particle-vel particle-lifetime particle-max-life particle-size particle-color particle-user-data particle-alive? particle-age particle-with-pos particle-with-vel particle-with-state gravity-field wind-field drag-field attractor-field vortex-field turbulence-field combine-fields integrate-particle update-particle update-particles make-emitter emitter? emitter-pos emitter-rate emitter-spread emitter-direction emitter-speed-min emitter-speed-max emitter-lifetime-min emitter-lifetime-max emitter-size-min emitter-size-max emitter-color emitter-user-data emitter-accumulator emitter-with-pos emitter-with-direction emitter-with-accumulator spawn-particle emitter-emit make-particle-system particle-system? particle-system-emitters particle-system-particles particle-system-forces particle-system-count)) (answer "(define (particle-system-add-emitter ps emitter) (make-particle-system (cons emitter (particle-system-emitters ps)) (particle-system-particles ps) (particle-system-forces ps)))"))
(task-entry (id "physics/classical/ascii-renderer/render-world!") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23550) (name render-world!) (type "") (description "") (notes ()) (section high-level) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line! draw-filled-circle! polygon-scanline-intersections fill-between-pairs! draw-filled-polygon! draw-filled-aabb! draw-aabb-outline! fmod angle->arrow-char draw-velocity-vector! draw-contact! draw-constraint! get-entity-shape-world render-entity-shape!)) (answer "(define (render-world! frame world renderer entity-char-fn) (let ((config (renderer-config renderer)) (debug (renderer-debug renderer)) (style (renderer-style renderer))) (for-each (lambda (entity) (let* ((is-static (entity-static? entity)) (char (if entity-char-fn (entity-char-fn entity) (if is-static (style-static-char style) (style-fill-char style))))) (render-entity-shape! frame entity char config))) (world-entity-list world)) (when (debug-show-constraints debug) (for-each (lambda (c) (draw-constraint! frame world c config)) (world-constraint-list world))) (when (debug-show-velocity debug) (for-each (lambda (entity) (unless (entity-static? entity) (draw-velocity-vector! frame entity 0.1 config))) (world-entity-list world))) (when (debug-show-aabb debug) (for-each (lambda (entity) (let ((shape (get-entity-shape-world entity))) (draw-aabb-outline! frame (shape-aabb shape) style config))) (world-entity-list world)))))"))
