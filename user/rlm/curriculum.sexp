(task-entry (id "random/monte-carlo/importance-sample") (skill random) (module monte-carlo) (tier 1) (difficulty 12911) (name importance-sample) (type "") (description "") (notes ()) (section importance-sampling) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate)) (answer "(define (importance-sample f weight-fn proposal-sampler n) (state-bind (random-list n proposal-sampler) (lambda (samples) (let* ((weights (map weight-fn samples)) (fvals (map f samples)) (weighted-vals (map * fvals weights)) (total-weight (fold-left + 0 weights)) (sum-sq-weights (fold-left + 0 (map (lambda (w) (* w w)) weights))) (estimate (/ (fold-left + 0 weighted-vals) total-weight)) (ess-ratio (/ (* total-weight total-weight) (* n sum-sq-weights)))) (state-pure (cons estimate ess-ratio))))))"))
(task-entry (id "random/variational-inference/mf-gaussian-log-prob") (skill random) (module variational-inference) (tier 1) (difficulty 12911) (name mf-gaussian-log-prob) (type "") (description "") (notes ()) (section log-probabilities-for-variational-families) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian)) (answer "(define (mf-gaussian-log-prob vfamily z) (let ((means (mf-gaussian-means vfamily)) (log-stds (mf-gaussian-log-stds vfamily))) (fold-left + 0 (map (lambda (zi mui log-si) (log-normal-pdf zi mui (exp (* 2 log-si)))) z means log-stds))))"))
