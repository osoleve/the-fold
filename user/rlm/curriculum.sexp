(task-entry (id "geometry/obj-loader/get-vertex") (skill geometry) (module obj-loader) (tier 1) (difficulty 12207) (name get-vertex) (type "(-> (Vector Vec3) Number Vec3)") (description "OBJ indices are 1-based, can be negative (relative)") (notes ()) (section obj-loading) (deps (\x27;prelude \x27;geometry)) (available (parse-obj-line parse-vertex parse-face string-split load-obj-from-string faces->triangles face->triangles)) (answer "(define (get-vertex vertices idx) (let ((n (vector-length vertices))) (if (< idx 0) (vector-ref vertices (+ n idx)) (vector-ref vertices (- idx 1)))))"))
(task-entry (id "geometry/ascii-render/camera-pos") (skill geometry) (module ascii-render) (tier 1) (difficulty 12207) (name camera-pos) (type "(-> Camera Vec3)") (description "") (notes ()) (section camera-and-ray-generation) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (ascii-ramp ascii-ramp-len intensity->char rgb->ansi256 ansi-fg ansi-reset make-camera)) (answer "(define (camera-pos cam) (list-ref cam 1))"))
(task-entry (id "geometry/mesh-sdf/subdivide-icosphere-triangles") (skill geometry) (module mesh-sdf) (tier 1) (difficulty 12207) (name subdivide-icosphere-triangles) (type "(-> (List Triangle3) Number Number (List Triangle3))") (description "Apply n levels of subdivision to a list of triangles; uses shared edge midpoint table to ensure adjacent triangles share exact vertices") (notes ()) (section mesh-construction-helpers) (deps (\x27;prelude \x27;geometry \x27;bvh)) (available (make-mesh mesh? mesh-triangles mesh-bvh mesh-sdf mesh-sdf-gradient make-mesh-cube)) (answer "(define (subdivide-icosphere-triangles triangles radius levels) (if (<= levels 0) triangles (let ((subdivided (subdivide-icosphere-once triangles radius))) (subdivide-icosphere-triangles subdivided radius (- levels 1)))))"))
(task-entry (id "geometry/marching-cubes/marching-cubes") (skill geometry) (module marching-cubes) (tier 1) (difficulty 12207) (name marching-cubes) (type "(-> SDF-Function Point3 Number Number (List Triangle3))") (description "Extract isosurface mesh from SDF") (notes ()) (section high-level-api) (deps (\x27;prelude \x27;geometry)) (available (edge-table tri-table marching-cubes-grid marching-cubes-cube compute-cube-index compute-edge-intersections generate-cube-triangles)) (answer "(define (marching-cubes sdf-fn center size resolution) (let* ((bmin (vec3 (- (vec3-x center) size) (- (vec3-y center) size) (- (vec3-z center) size))) (bmax (vec3 (+ (vec3-x center) size) (+ (vec3-y center) size) (+ (vec3-z center) size))) (bounds (aabb bmin bmax))) (marching-cubes-grid sdf-fn bounds resolution)))"))
