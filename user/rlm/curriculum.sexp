(task-entry (id "fp/parser-examples/ini-value") (skill fp) (module parser-examples) (tier 1) (difficulty 10653) (name ini-value) (type "") (description "") (notes ()) (section ini-parser) (deps (\x27;prelude \x27;parser)) (available (%newline-ex %tab-ex %return-ex %backspace-ex %page-ex %backslash %char-b %char-f %char-n %char-r %char-t json-null json-bool json-number json-string-char json-string json-value json-array json-pair json-object parse-json sexp-comment sexp-whitespace sexp-lexeme sexp-symbol-char sexp-symbol sexp-string sexp-boolean sexp-value sexp-list sexp-quote sexp-quasiquote sexp-unquote parse-sexp parse-sexps arith-number arith-expr arith-term arith-factor arith-atom arith-unary chain-left1 parse-arith eval-arith ini-comment ini-hspace ini-line-end ini-skip-line ini-blank-or-comment ini-skip-blanks ini-section-name ini-section-header ini-key)) (answer "(define ini-value (parser-map (lambda (chars) (let* ((len (length chars)) (last-non-ws (let loop ((i (- len 1)) (lst (reverse chars))) (cond ((< i 0) -1) ((not (char-whitespace? (car lst))) i) (else (loop (- i 1) (cdr lst))))))) (if (< last-non-ws 0) \"\" (list->string (take (+ last-non-ws 1) chars))))) (parser-many (parser-satisfy (lambda (c) (not (char=? c %newline-ex))) \"value character\"))))"))
