(task-entry (id "random/bayesian/predictive-beta-binomial") (skill random) (module bayesian) (tier 1) (difficulty 12950) (name predictive-beta-binomial) (type "") (description "") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode log-beta-pdf log-beta log-normal-pdf log-gamma-pdf log-poisson-pmf log-factorial kl-divergence-normal kl-divergence-beta digamma log-marginal-likelihood-beta-binomial log-binomial-coeff log-marginal-likelihood-normal-normal bayes-factor log-bayes-factor interpret-bayes-factor bic aic sequential-beta-update sequential-normal-update sequential-gamma-update posterior-summary)) (answer "(define (predictive-beta-binomial prior k n) (let* ((alpha (beta-prior-alpha prior)) (beta (beta-prior-beta prior)) (log-prob (+ (log-binomial-coeff n k) (log-beta (+ alpha k) (+ beta (- n k))) (- (log-beta alpha beta))))) (exp log-prob)))"))
