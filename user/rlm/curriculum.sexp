(task-entry (id "algebra/field/mod-inverse") (skill algebra) (module field) (tier 0) (difficulty 326) (name mod-inverse) (type "") (description "") (notes ()) (section field-representation) (deps (\x27;prelude \x27;ring)) (available (make-field make-field* field? field-elements field-add-op field-mul-op field-zero field-one field-neg-fn field-div-fn field-equal-fn field-metadata field-meta-ref field-add field-mul field-neg field-sub field-div field-inv field-equal? field-power field->ring Q-field R-field make-field-zp make-field-zp-large)) (answer "(define (mod-inverse a m) (let loop ((old-r m) (r (modulo a m)) (old-s 0) (s 1)) (if (= r 0) (if (= old-r 1) (modulo old-s m) (error 'mod-inverse \"no inverse exists\")) (let ((q (quotient old-r r))) (loop r (- old-r (* q r)) s (- old-s (* q s)))))))"))
