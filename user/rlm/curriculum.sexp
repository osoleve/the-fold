(task-entry (id "markdown/html/render-html") (skill markdown) (module html) (tier 1) (difficulty 12107) (name render-html) (type "") (description "") (notes ()) (section tag-rendering-helpers) (deps (\x27;prelude \x27;markdown-ast)) (available (html-escape html-escape-attr html-tag html-tag-nl html-tag-attrs html-void-tag html-void-tag-attrs)) (answer "(define (render-html node) (cond ((string? node) (html-escape node)) ((not (pair? node)) \"\") ((null? node) \"\") (else (let ((tag (car node)) (children (cdr node))) (case tag ((document) (render-children children \"\n\")) ((h1 h2 h3 h4 h5 h6) (html-tag-nl tag (render-inlines children))) ((p) (html-tag-nl 'p (render-inlines children))) ((code-block) (let ((lang (car children)) (code (cadr children))) (if (string=? lang \"\") (string-append \"<pre><code>\" (html-escape code) \"</code></pre>\n\") (string-append \"<pre><code class=\"language-\" (html-escape lang) \"\">\" (html-escape code) \"</code></pre>\n\")))) ((blockquote) (html-tag-nl 'blockquote (render-children children \"\n\"))) ((ul ol) (html-tag-nl tag (render-children children \"\"))) ((li) (html-tag 'li (render-inlines children))) ((table) (let ((header (car children)) (rows (cadr children))) (string-append \"<table>\n<thead>\n<tr>\n\" (apply string-append (map (lambda (cell) (string-append \"<th>\" (render-inlines cell) \"</th>\n\")) header)) \"</tr>\n</thead>\n<tbody>\n\" (apply string-append (map (lambda (row) (string-append \"<tr>\n\" (apply string-append (map (lambda (cell) (string-append \"<td>\" (render-inlines cell) \"</td>\n\")) row)) \"</tr>\n\")) rows)) \"</tbody>\n</table>\n\"))) ((hr) \"<hr>\n\") ((text) (html-escape (car children))) ((strong) (html-tag 'strong (render-inlines children))) ((em) (html-tag 'em (render-inlines children))) ((code) (html-tag 'code (html-escape (car children)))) ((link) (let ((url (car children)) (title (cadr children)) (text (caddr children))) (if (string=? title \"\") (html-tag-attrs 'a (quasiquote ((href unquote url))) (render-inlines text)) (html-tag-attrs 'a (quasiquote ((href unquote url) (title unquote title))) (render-inlines text))))) ((br) \"<br>\n\") (else (render-children children \"\")))))))"))
