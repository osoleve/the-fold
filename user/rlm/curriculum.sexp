(task-entry (id "random/monte-carlo/mh-chain") (skill random) (module monte-carlo) (tier 1) (difficulty 12918) (name mh-chain) (type "") (description "") (notes ()) (section metropolis-hastings-mcmc) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step)) (answer "(define (mh-chain log-target proposal initial n) (let loop ((i 0) (current initial) (acc '())) (if (>= i n) (state-pure (reverse acc)) (state-bind (mh-symmetric-step log-target proposal current) (lambda (next) (loop (+ i 1) next (cons next acc)))))))"))
(task-entry (id "random/variational-inference/chol-flat-to-matrix") (skill random) (module variational-inference) (tier 1) (difficulty 12918) (name chol-flat-to-matrix) (type "") (description "") (notes ()) (section full-covariance-gaussian) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim)) (answer "(define (chol-flat-to-matrix flat n) (let loop ((i 0) (row 0) (col 0) (current-row '()) (rows '()) (remaining flat)) (cond ((= row n) (reverse rows)) ((> col row) (loop i (+ row 1) 0 '() (cons (reverse current-row) rows) remaining)) (else (loop (+ i 1) row (+ col 1) (cons (car remaining) current-row) rows (cdr remaining))))))"))
(task-entry (id "random/prng/make-xorshift128") (skill random) (module prng) (tier 1) (difficulty 12919) (name make-xorshift128) (type "") (description "") (notes ()) (section xorshift128+-generator) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random)) (answer "(define (make-xorshift128 seed) (let* ((sm0 (make-splitmix seed)) (r1 (splitmix-next sm0)) (s0 (car r1)) (sm1 (cdr r1)) (r2 (splitmix-next sm1)) (s1 (car r2))) (list 'xorshift128 (if (= s0 0) 1 s0) (if (= s1 0) 1 s1))))"))
(task-entry (id "random/distributions/normal-quantile") (skill random) (module distributions) (tier 1) (difficulty 12919) (name normal-quantile) (type "(-> Number Number Number Number)") (description "Normal quantile at probability p") (notes ()) (section normal-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf)) (answer "(define (normal-quantile p mean stddev) (+ mean (* stddev (standard-normal-quantile p))))"))
