(task-entry (id "control-systems/hinf-synthesis/gp-C1") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22605) (name gp-C1) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2)) (answer "(define (gp-C1 gp) (list-ref gp 4))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-degree") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22605) (name alg-poly-degree) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs)) (answer "(define (alg-poly-degree p) (- (length (alg-poly-coeffs p)) 1))"))
