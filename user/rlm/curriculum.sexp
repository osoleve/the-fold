(task-entry (id "geometry/mesh-gen/tri2-edges") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12233) (name tri2-edges) (type "") (description "") (notes ()) (section edges) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location location? location-triangle location-bary point2-x point2-y vertex-key make-tri2 tri2? tri2-p1 tri2-p2 tri2-p3 tri2-points orient2d tri2-signed-area tri2-area tri2-circumcenter tri2-circumradius-sq point-in-circumcircle? make-edge edge-p1 edge-p2 points-equal? edges-equal?)) (answer "(define (tri2-edges tri) (let ((p1 (tri2-p1 tri)) (p2 (tri2-p2 tri)) (p3 (tri2-p3 tri))) (list (make-edge p1 p2) (make-edge p2 p3) (make-edge p3 p1))))"))
(task-entry (id "geometry/voronoi/clip-to-halfplane") (skill geometry) (module voronoi) (tier 1) (difficulty 12233) (name clip-to-halfplane) (type "") (description "") (notes ()) (section bounded) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell voronoi-diagram find-unbounded-sites build-voronoi-edges edge-key->points find-site-index voronoi-cell-polygon voronoi-cell-centroid voronoi-neighbors voronoi-nearest-site point2-distance-sq clip-polygon-to-rect)) (answer "(define (clip-to-halfplane poly inside? intersect) (if (null? poly) '() (let loop ((remaining poly) (prev (car (reverse poly))) (result '())) (if (null? remaining) (reverse result) (let* ((curr (car remaining)) (prev-in (inside? prev)) (curr-in (inside? curr))) (cond ((and prev-in curr-in) (loop (cdr remaining) curr (cons curr result))) ((and (not prev-in) curr-in) (loop (cdr remaining) curr (cons curr (cons (intersect prev curr) result)))) ((and prev-in (not curr-in)) (loop (cdr remaining) curr (cons (intersect prev curr) result))) (else (loop (cdr remaining) curr result))))))))"))
