(task-entry (id "optimization/interval-newton/interval-newton-root") (skill optimization) (module interval-newton) (tier 1) (difficulty 12809) (name interval-newton-root) (type "(-> (-> Interval Interval) (-> Interval Interval) Interval Real Nat NewtonResult)") (description "") (notes ()) (section iterative-newton) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step interval-newton-step-rigorous)) (answer "(define (interval-newton-root f-iv f-deriv-iv X0 tol max-iter) (let loop ((X X0) (iter 0) (status 'possible)) (cond ((>= iter max-iter) (list 'found X status iter)) ((< (interval-width X) tol) (list 'found X status iter)) (else (let ((step-result (interval-newton-step-rigorous f-iv f-deriv-iv X))) (case (car step-result) ((no-root) (list 'failed 'no-root iter)) ((unique) (loop (cdr step-result) (+ iter 1) 'unique)) ((contracted) (loop (cdr step-result) (+ iter 1) status)) ((division-by-zero no-improvement) (let* ((pair (interval-bisect X)) (left (car pair)) (right (cdr pair)) (left-result (interval-newton-root f-iv f-deriv-iv left tol (- max-iter iter)))) (if (eq? (car left-result) 'found) left-result (interval-newton-root f-iv f-deriv-iv right tol (- max-iter iter))))) (else (list 'failed 'unknown-error iter))))))))"))
(task-entry (id "optimization/line-search/armijo-backtrack-full") (skill optimization) (module line-search) (tier 1) (difficulty 12810) (name armijo-backtrack-full) (type "") (description "") (notes ()) (section overview) (deps (\x27;prelude \x27;reverse-diff)) (available (*armijo-c1* *wolfe-c2* *backtrack-rho* *max-ls-iters* *initial-step* *default-alpha-max* dot-product vec-add-scaled armijo-condition? armijo-backtrack)) (answer "(define (armijo-backtrack-full f x grad direction alpha c1 rho max-iters) (let* ((f-old (apply f x)) (grad-dot-d (dot-product grad direction))) (if (>= grad-dot-d 0) (list x 0) (let loop ((alpha alpha) (iter 0)) (if (>= iter max-iters) (list (vec-add-scaled x direction alpha) alpha) (let* ((x-new (vec-add-scaled x direction alpha)) (f-new (apply f x-new))) (if (armijo-condition? f-new f-old alpha grad-dot-d c1) (list x-new alpha) (loop (* rho alpha) (+ iter 1)))))))))"))
