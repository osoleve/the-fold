(task-entry (id "egraph/match/subst-merge") (skill egraph) (module match) (tier 1) (difficulty 10007) (name subst-merge) (type "(-> Substitution Substitution (Or Substitution #f))") (description "Merge two substitutions. Returns #f if incompatible.") (notes ()) (section substitutions) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend)) (answer "(define (subst-merge subst1 subst2) (let loop ((s1 subst1) (result subst2)) (if (null? s1) result (let* ((binding (car s1)) (var (car binding)) (class-id (cdr binding)) (new-result (subst-try-extend result var class-id))) (if new-result (loop (cdr s1) new-result) #f)))))"))
