(task-entry (id "optimization/line-search/initial-step-size") (skill optimization) (module line-search) (tier 1) (difficulty 12818) (name initial-step-size) (type "") (description "") (notes ()) (section overview) (deps (\x27;prelude \x27;reverse-diff)) (available (*armijo-c1* *wolfe-c2* *backtrack-rho* *max-ls-iters* *initial-step* *default-alpha-max* dot-product vec-add-scaled armijo-condition? armijo-backtrack armijo-backtrack-full curvature-condition? strong-curvature-condition? wolfe-line-search wolfe-line-search-full wolfe-bracket wolfe-zoom exact-quadratic-step)) (answer "(define (initial-step-size grad f-val) (let ((grad-norm (sqrt (fold-left + 0 (map (lambda (x) (* x x)) grad))))) (if (< grad-norm 1e-10) 1.0 (min 1.0 (/ (abs f-val) (+ grad-norm 1e-10))))))"))
