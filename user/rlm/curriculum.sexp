(task-entry (id "clp/label/try-value") (skill clp) (module label) (tier 1) (difficulty 10810) (name try-value) (type "(-> CStore LVar Int (Maybe CStore))") (description "Try assigning a value to a variable and propagate") (notes ()) (section labeling-functions) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with label-values)) (answer "(define (try-value cs var val) (let ((cs1 (cstore-set-domain cs var (domain-singleton val)))) (and cs1 (propagate cs1))))"))
