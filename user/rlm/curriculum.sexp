(task-entry (id "topology/simplicial-complex/generic<?") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11800) (name generic<?) (type "(-> α α Boolean)") (description "Universal comparison function for canonical ordering") (notes ("Handles: numbers, symbols, strings, bytevectors, and lists (lexicographically)")) (section generic-comparison) (deps (\x27;set \x27;sort)) (available ()) (answer "(define (generic<? a b) (cond ((and (number? a) (number? b)) (< a b)) ((and (symbol? a) (symbol? b)) (string<? (symbol->string a) (symbol->string b))) ((and (string? a) (string? b)) (string<? a b)) ((and (bytevector? a) (bytevector? b)) (bytevector<? a b)) ((and (list? a) (list? b)) (cond ((null? a) (not (null? b))) ((null? b) #f) ((generic<? (car a) (car b)) #t) ((generic<? (car b) (car a)) #f) (else (generic<? (cdr a) (cdr b))))) (else (< (type-order a) (type-order b)))))"))
(task-entry (id "topology/homology/z2-matrix") (skill topology) (module homology) (tier 1) (difficulty 11800) (name z2-matrix) (type "(-> Integer Integer Vector Z2Matrix)") (description "Create a Z_2 matrix from row-major data") (notes ()) (section z2-matrix-operations) (deps (\x27;simplicial-complex)) (available ()) (answer "(define (z2-matrix rows cols data) (list 'z2-matrix rows cols data))"))
(task-entry (id "topology/persistent/make-filtration") (skill topology) (module persistent) (tier 1) (difficulty 11800) (name make-filtration) (type "(-> (List (Pair Simplex Number)) Filtration)") (description "Create a filtration from simplex-birthtime pairs") (notes ("Pairs are sorted by (birth-time, dimension, vertices) for canonical order")) (section filtration) (deps (\x27;homology)) (available ()) (answer "(define (make-filtration pairs) (list 'filtration (sort-by filtration-order pairs)))"))
(task-entry (id "dsl/compose/term-interpret-with-handlers") (skill dsl) (module compose) (tier 1) (difficulty 11801) (name term-interpret-with-handlers) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap row-fmap-helper register-fmap make-functor-row functor-row? functor-row-functors functor-row-contains? functor-row-index functor-row-extend functor-row-union build-injection-path inject-by-index make-tagged-functor tagged-functor? tagged-functor-tag tagged-functor-value inject lit-f add-f neg-f arith-fmap get-f put-f state-f-fmap standard-fmap-registry lift-arith lift-state arith-state-row arith-state-fmap dsl-lit dsl-add dsl-get dsl-put free-arith-lit free-arith-add free-state-get free-state-put make-handler-stack handler-stack? handler-stack-handlers run-with-stack run-with-composed-stack push-handler pop-handler effect-row-handled effect-row-requires effect-row-satisfies eff-lift-row eff-restrict define-effect-handler combine-effect-handlers state+reader-handler state+writer-handler state+exception-handler empty-dict dict-singleton dict-from-list dict-concat make-interface interface? interface-name interface-operations dict-satisfies? assert-interface iface-expr iface-bool iface-cmp iface-cond iface-state interface-union make-interpreter interpreter? interpreter-name interpreter-make combine-interpreters make-transformer transformer? transformer-name transformer-apply chain-transformers with-logging-default logging-transformer memoizing-transformer extend-dsl restrict-dsl rename-dsl override-dsl tagless->free make-ast-dict expr-ast-dict tagless-program->free free->tagless make-term-interpreter)) (answer "(define (term-interpret-with-handlers handlers term d) (cond ((pure-free? term) (from-pure-free term)) ((free-suspended? term) (term-interpret-with-handlers handlers (from-free term) d)) ((inl? term) (term-interpret-with-handlers handlers (from-inl term) d)) ((inr? term) (term-interpret-with-handlers handlers (from-inr term) d)) ((tagged-functor? term) (let* ((inner (tagged-functor-value term)) (handler (assq (car inner) handlers))) (if handler ((cdr handler) d inner (lambda (sub) (term-interpret-with-handlers handlers sub d))) (error 'term-interpret \"Unknown term type in tagged-functor\" (car inner) (tagged-functor-tag term))))) ((pair? term) (let ((handler (assq (car term) handlers))) (if handler ((cdr handler) d term (lambda (sub) (term-interpret-with-handlers handlers sub d))) (error 'term-interpret \"Unknown term type\" (car term))))) (else term)))"))
(task-entry (id "topology/simplicial-complex/bytevector<?") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11801) (name bytevector<?) (type "(-> Bytevector Bytevector Boolean)") (description "Lexicographic comparison of bytevectors") (notes ("Compares byte-by-byte; shorter vector is less if prefix matches")) (section generic-comparison) (deps (\x27;set \x27;sort)) (available (generic<?)) (answer "(define (bytevector<? a b) (let ((len-a (bytevector-length a)) (len-b (bytevector-length b))) (let loop ((i 0)) (cond ((= i len-a) (< len-a len-b)) ((= i len-b) #f) (else (let ((byte-a (bytevector-u8-ref a i)) (byte-b (bytevector-u8-ref b i))) (cond ((< byte-a byte-b) #t) ((> byte-a byte-b) #f) (else (loop (+ i 1))))))))))"))
(task-entry (id "topology/homology/z2-matrix?") (skill topology) (module homology) (tier 1) (difficulty 11801) (name z2-matrix?) (type "(-> α Boolean)") (description "") (notes ()) (section z2-matrix-operations) (deps (\x27;simplicial-complex)) (available (z2-matrix)) (answer "(define (z2-matrix? x) (and (pair? x) (eq? (car x) 'z2-matrix)))"))
(task-entry (id "topology/persistent/filtration?") (skill topology) (module persistent) (tier 1) (difficulty 11801) (name filtration?) (type "(-> α Boolean)") (description "") (notes ()) (section filtration) (deps (\x27;homology)) (available (make-filtration)) (answer "(define (filtration? x) (and (pair? x) (eq? (car x) 'filtration)))"))
(task-entry (id "dsl/compose/expr-interpret-handlers") (skill dsl) (module compose) (tier 1) (difficulty 11802) (name expr-interpret-handlers) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap row-fmap-helper register-fmap make-functor-row functor-row? functor-row-functors functor-row-contains? functor-row-index functor-row-extend functor-row-union build-injection-path inject-by-index make-tagged-functor tagged-functor? tagged-functor-tag tagged-functor-value inject lit-f add-f neg-f arith-fmap get-f put-f state-f-fmap standard-fmap-registry lift-arith lift-state arith-state-row arith-state-fmap dsl-lit dsl-add dsl-get dsl-put free-arith-lit free-arith-add free-state-get free-state-put make-handler-stack handler-stack? handler-stack-handlers run-with-stack run-with-composed-stack push-handler pop-handler effect-row-handled effect-row-requires effect-row-satisfies eff-lift-row eff-restrict define-effect-handler combine-effect-handlers state+reader-handler state+writer-handler state+exception-handler empty-dict dict-singleton dict-from-list dict-concat make-interface interface? interface-name interface-operations dict-satisfies? assert-interface iface-expr iface-bool iface-cmp iface-cond iface-state interface-union make-interpreter interpreter? interpreter-name interpreter-make combine-interpreters make-transformer transformer? transformer-name transformer-apply chain-transformers with-logging-default logging-transformer memoizing-transformer extend-dsl restrict-dsl rename-dsl override-dsl tagless->free make-ast-dict expr-ast-dict tagless-program->free free->tagless make-term-interpreter term-interpret-with-handlers)) (answer "(define expr-interpret-handlers (quasiquote ((lit unquote (lambda (d term recurse) (expr-lit d (cadr term)))) (add unquote (lambda (d term recurse) (expr-add d (recurse (cadr term)) (recurse (caddr term))))) (neg unquote (lambda (d term recurse) (expr-neg d (recurse (cadr term))))))))"))
(task-entry (id "topology/simplicial-complex/type-order") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11802) (name type-order) (type "(-> α Integer)") (description "Assign numeric order to types for consistent mixed-type comparison") (notes ()) (section generic-comparison) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<?)) (answer "(define (type-order x) (cond ((number? x) 0) ((symbol? x) 1) ((string? x) 2) ((bytevector? x) 3) ((list? x) 4) (else 5)))"))
