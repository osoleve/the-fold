(task-entry (id "optics/block-optics/block-payload-sexpr-affine") (skill optics) (module block-optics) (tier 1) (difficulty 11017) (name block-payload-sexpr-affine) (type "") (description "") (notes ()) (section payload-optics) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens block-ref-at block-refs-each block-refs-count follow-ref block-child-at block-children-each block-type-prism block-lambda-prism block-app-prism block-ref-prism block-literal-prism block-expr-prism block-payload-string-iso block-payload-as-string-lens)) (answer "(define block-payload-sexpr-affine (make-affine (lambda (blk) (guard (ex (else nothing)) (let* ((str (utf8->string (block-payload blk))) (port (open-input-string str)) (result (read port))) (if (eof-object? result) nothing (if (eof-object? (read port)) (just result) nothing))))) (lambda (sexpr blk) (let ((new-payload (string->utf8 (format \"~s\" sexpr)))) (make-block (block-tag blk) new-payload (block-refs blk))))))"))
