(task-entry (id "random/bayesian/log-beta") (skill random) (module bayesian) (tier 1) (difficulty 12930) (name log-beta) (type "") (description "") (notes ()) (section log-probability-functions-for-mcmc/vi) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode log-beta-pdf)) (answer "(define (log-beta a b) (- (+ (log-gamma a) (log-gamma b)) (log-gamma (+ a b))))"))
(task-entry (id "random/monte-carlo/stratified-sample") (skill random) (module monte-carlo) (tier 1) (difficulty 12930) (name stratified-sample) (type "") (description "") (notes ()) (section variance-reduction-stratified-sampling) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate antithetic-integrate control-variate-estimate)) (answer "(define (stratified-sample f a b k n) (let* ((per-stratum (max 1 (quotient n k))) (width (- b a)) (stratum-width (/ width k))) (letrec ((sample-stratum (lambda (i) (let ((lo (+ a (* i stratum-width))) (hi (+ a (* (+ i 1) stratum-width)))) (state-bind (random-list per-stratum (random-float-range lo hi)) (lambda (xs) (state-pure (map f xs)))))))) (state-bind (state-sequence (map sample-stratum (iota k))) (lambda (stratum-results) (let* ((all-means (map sample-mean stratum-results)) (estimate (* width (sample-mean all-means))) (stratum-vars (map sample-variance stratum-results)) (total-var (fold-left + 0 stratum-vars)) (se (* width (sqrt (/ total-var (* k k per-stratum)))))) (state-pure (cons estimate se))))))))"))
(task-entry (id "random/variational-inference/vfamily-params") (skill random) (module variational-inference) (tier 1) (difficulty 12930) (name vfamily-params) (type "") (description "") (notes ()) (section generic-variational-family-interface) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy)) (answer "(define (vfamily-params v) (cond ((mf-gaussian? v) (append (mf-gaussian-means v) (mf-gaussian-log-stds v))) ((full-gaussian? v) (append (full-gaussian-means v) (full-gaussian-chol v))) (else (error 'vfamily-params \"Unknown variational family\" v))))"))
(task-entry (id "random/prng/random-element") (skill random) (module prng) (tier 1) (difficulty 12931) (name random-element) (type "") (description "") (notes ()) (section sampling-utilities) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float random-float-range random-int-range random-bool)) (answer "(define (random-element lst) (if (null? lst) (error 'random-element \"empty list\") (state-map (lambda (i) (list-ref lst i)) (random-int-range 0 (- (length lst) 1)))))"))
(task-entry (id "random/distributions/bernoulli-pmf") (skill random) (module distributions) (tier 1) (difficulty 12931) (name bernoulli-pmf) (type "(-> Bool Number Number)") (description "Bernoulli probability mass") (notes ()) (section bernoulli-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli)) (answer "(define (bernoulli-pmf success? p) (if success? p (- 1 p)))"))
(task-entry (id "random/probability/observe-dist") (skill random) (module probability) (tier 1) (difficulty 12931) (name observe-dist) (type "") (description "") (notes ()) (section conditioning) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe)) (answer "(define (observe-dist likelihood-fn p) (prob-bind p (lambda (x) (prob-then (score (likelihood-fn x)) (prob-pure x)))))"))
(task-entry (id "random/bayesian/log-normal-pdf") (skill random) (module bayesian) (tier 1) (difficulty 12931) (name log-normal-pdf) (type "") (description "") (notes ()) (section log-probability-functions-for-mcmc/vi) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode log-beta-pdf log-beta)) (answer "(define (log-normal-pdf x mean variance) (let ((diff (- x mean))) (- (- (* 0.5 (log (* 2 3.141592653589793 variance)))) (/ (* diff diff) (* 2 variance)))))"))
(task-entry (id "random/monte-carlo/effective-sample-size") (skill random) (module monte-carlo) (tier 1) (difficulty 12931) (name effective-sample-size) (type "") (description "") (notes ()) (section convergence-diagnostics) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate antithetic-integrate control-variate-estimate stratified-sample)) (answer "(define (effective-sample-size samples) (let* ((n (length samples)) (batch-size (max 1 (inexact->exact (floor (sqrt n))))) (n-batches (quotient n batch-size)) (batches (split-into-batches samples batch-size)) (batch-means (map sample-mean batches)) (overall-mean (sample-mean samples)) (overall-var (sample-variance samples)) (batch-var (sample-variance batch-means))) (if (> batch-var 0) (/ (* n overall-var) (* batch-size batch-var)) n)))"))
(task-entry (id "random/variational-inference/vfamily-from-params") (skill random) (module variational-inference) (tier 1) (difficulty 12931) (name vfamily-from-params) (type "") (description "") (notes ()) (section generic-variational-family-interface) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params)) (answer "(define (vfamily-from-params type dim params) (case type ((mf-gaussian) (let ((means (take dim params)) (log-stds (drop dim params))) (make-mf-gaussian means log-stds))) ((full-gaussian) (let ((means (take dim params)) (chol (drop dim params))) (make-full-gaussian means chol))) (else (error 'vfamily-from-params \"Unknown type\" type))))"))
(task-entry (id "random/prng/shuffle") (skill random) (module prng) (tier 1) (difficulty 12932) (name shuffle) (type "") (description "") (notes ()) (section sampling-utilities) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float random-float-range random-int-range random-bool random-element)) (answer "(define (shuffle lst) (let ((vec (list->vector lst)) (n (length lst))) (letrec ((shuffle-step (lambda (i) (if (>= i (- n 1)) (state-pure (vector->list vec)) (state-bind (random-int-range i (- n 1)) (lambda (j) (let ((tmp (vector-ref vec i))) (vector-set! vec i (vector-ref vec j)) (vector-set! vec j tmp) (shuffle-step (+ i 1))))))))) (shuffle-step 0))))"))
(task-entry (id "random/distributions/random-bernoulli") (skill random) (module distributions) (tier 1) (difficulty 12932) (name random-bernoulli) (type "(-> Number (State RNG Bool))") (description "State monad sampler for Bernoulli distribution") (notes ()) (section bernoulli-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli bernoulli-pmf)) (answer "(define (random-bernoulli p) (if (or (< p 0) (> p 1)) (error 'random-bernoulli \"probability must be in [0,1]\" p) (state-map (lambda (u) (< u p)) random-float)))"))
(task-entry (id "random/probability/condition") (skill random) (module probability) (tier 1) (difficulty 12932) (name condition) (type "") (description "") (notes ()) (section conditioning) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist)) (answer "(define (condition pred p) (prob-bind p (lambda (x) (if (pred x) (prob-pure x) (prob-then (factor -inf.0) (prob-pure x))))))"))
(task-entry (id "random/bayesian/log-gamma-pdf") (skill random) (module bayesian) (tier 1) (difficulty 12932) (name log-gamma-pdf) (type "") (description "") (notes ()) (section log-probability-functions-for-mcmc/vi) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode log-beta-pdf log-beta log-normal-pdf)) (answer "(define (log-gamma-pdf x shape rate) (if (<= x 0) -inf.0 (+ (* shape (log rate)) (* (- shape 1) (log x)) (- (* rate x)) (- (log-gamma shape)))))"))
(task-entry (id "random/monte-carlo/split-into-batches") (skill random) (module monte-carlo) (tier 1) (difficulty 12932) (name split-into-batches) (type "") (description "") (notes ()) (section convergence-diagnostics) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate antithetic-integrate control-variate-estimate stratified-sample effective-sample-size)) (answer "(define (split-into-batches lst batch-size) (if (or (null? lst) (< (length lst) batch-size)) '() (cons (take batch-size lst) (split-into-batches (list-tail lst batch-size) batch-size))))"))
(task-entry (id "random/variational-inference/elbo-estimate") (skill random) (module variational-inference) (tier 1) (difficulty 12932) (name elbo-estimate) (type "") (description "") (notes ()) (section elbo-computation) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params)) (answer "(define (elbo-estimate log-joint vfamily prng K) (let loop ((k K) (rng prng) (total 0)) (if (= k 0) (values (/ total K) rng) (let*-values (((z new-rng) (vfamily-sample vfamily rng)) ((log-p) (log-joint z)) ((log-q) (vfamily-log-prob vfamily z))) (loop (- k 1) new-rng (+ total (- log-p log-q)))))))"))
(task-entry (id "random/prng/sample") (skill random) (module prng) (tier 1) (difficulty 12933) (name sample) (type "") (description "Reservoir sampling. O(n) using internal vector.") (notes ()) (section sampling-utilities) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float random-float-range random-int-range random-bool random-element shuffle)) (answer "(define (sample k lst) (let ((n (length lst))) (cond ((> k n) (error 'sample \"k > list length\" k n)) ((= k n) (shuffle lst)) ((= k 0) (state-pure '())) (else (let ((reservoir (list->vector (take k lst))) (rest (drop k lst))) (letrec ((fill-reservoir (lambda (rem i) (if (null? rem) (state-pure (vector->list reservoir)) (state-bind (random-int-range 0 i) (lambda (j) (when (< j k) (vector-set! reservoir j (car rem))) (fill-reservoir (cdr rem) (+ i 1)))))))) (fill-reservoir rest k)))))))"))
