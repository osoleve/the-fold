(task-entry (id "physics/classical3d/constraint-solver3d/correct-distance-position-3d") (skill physics/classical3d) (module constraint-solver3d) (tier 2) (difficulty 22408) (name correct-distance-position-3d) (type "") (description "") (notes ()) (section solver-constants) (deps (\x27;prelude \x27;vec3 \x27;quaternion \x27;rigid-body3d \x27;constraints3d)) (available (*baumgarte-factor-3d* *position-slop-3d* *angular-slop-3d* apply-impulse-at-point-3d apply-angular-impulse-3d velocity-at-point-3d compute-effective-mass-inv-3d solve-distance-velocity-3d)) (answer "(define (correct-distance-position-3d body-a body-b pos-a pos-b target-dist) (let* ((delta (vec3-sub pos-b pos-a)) (current-dist (vec3-magnitude delta)) (C (- current-dist target-dist)) (n (if (< current-dist 1e-4) (vec3 1 0 0) (vec3-normalize delta)))) (if (<= (abs C) *position-slop-3d*) (values body-a body-b) (let* ((inv-mass-a (rigid-body-3d-inv-mass body-a)) (inv-mass-b (if body-b (rigid-body-3d-inv-mass body-b) 0)) (total-inv-mass (+ inv-mass-a inv-mass-b)) (correction-mag (* *baumgarte-factor-3d* (- (abs C) *position-slop-3d*) (if (> C 0) 1 -1))) (correction-vec (vec3-scale n correction-mag)) (new-pos-a (if (and (not (rigid-body-3d-static? body-a)) (> total-inv-mass 1e-4)) (vec3-add (rigid-body-3d-pos body-a) (vec3-scale correction-vec (/ inv-mass-a total-inv-mass))) (rigid-body-3d-pos body-a))) (new-pos-b (if (and body-b (not (rigid-body-3d-static? body-b)) (> total-inv-mass 1e-4)) (vec3-sub (rigid-body-3d-pos body-b) (vec3-scale correction-vec (/ inv-mass-b total-inv-mass))) (if body-b (rigid-body-3d-pos body-b) #f))) (new-a (rigid-body-3d-with-pos body-a new-pos-a)) (new-b (if body-b (rigid-body-3d-with-pos body-b new-pos-b) #f))) (values new-a new-b)))))"))
(task-entry (id "physics/classical3d/world3d/entity-3d-pos") (skill physics/classical3d) (module world3d) (tier 2) (difficulty 22408) (name entity-3d-pos) (type "") (description "") (notes ()) (section physics-entity) (deps (\x27;prelude \x27;vec3 \x27;quaternion \x27;rigid-body3d \x27;shapes3d \x27;collision-detection3d \x27;constraint-solver3d)) (available (make-entity-3d entity-3d? entity-3d-id entity-3d-body entity-3d-shape entity-3d-material entity-3d-user-data entity-3d-with-body)) (answer "(define (entity-3d-pos e) (rigid-body-3d-pos (entity-3d-body e)))"))
(task-entry (id "physics/classical3d/rigid-body3d/mat3-mul-vec3") (skill physics/classical3d) (module rigid-body3d) (tier 2) (difficulty 22409) (name mat3-mul-vec3) (type "") (description "") (notes ()) (section mat3-utilities) (deps (\x27;vec3 \x27;quaternion)) (available (mat3-identity mat3-zero mat3-diagonal mat3-ref mat3-row mat3-col mat3-transpose mat3-scale mat3-add)) (answer "(define (mat3-mul-vec3 m v) (vec3 (+ (* (mat3-ref m 0 0) (vec3-x v)) (* (mat3-ref m 0 1) (vec3-y v)) (* (mat3-ref m 0 2) (vec3-z v))) (+ (* (mat3-ref m 1 0) (vec3-x v)) (* (mat3-ref m 1 1) (vec3-y v)) (* (mat3-ref m 1 2) (vec3-z v))) (+ (* (mat3-ref m 2 0) (vec3-x v)) (* (mat3-ref m 2 1) (vec3-y v)) (* (mat3-ref m 2 2) (vec3-z v)))))"))
