(task-entry (id "diffgeo/tangent/cotangent-sub") (skill diffgeo) (module tangent) (tier 1) (difficulty 10722) (name cotangent-sub) (type "") (description "") (notes ()) (section tangent-vector-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts)) (available (tangent-vector? tangent-vector-point tangent-vector-chart tangent-vector-components tangent-vector-dim make-tangent-vector tangent-zero tangent-basis-vector tangent-add tangent-sub tangent-scale tangent-negate tangent-change-chart cotangent-vector? cotangent-vector-point cotangent-vector-chart cotangent-vector-components cotangent-vector-dim make-cotangent-vector cotangent-zero cotangent-basis-form cotangent-add)) (answer "(define (cotangent-sub cv1 cv2) (let ((p1 (cotangent-vector-point cv1)) (p2 (cotangent-vector-point cv2)) (c1 (cotangent-vector-chart cv1)) (c2 (cotangent-vector-chart cv2))) (cond ((not (equal? p1 p2)) (quasiquote (error different-base-points))) ((not (eq? (chart-name c1) (chart-name c2))) (quasiquote (error different-charts (unquote (chart-name c1)) (unquote (chart-name c2))))) (else (make-cotangent-vector p1 c1 (vec-sub (cotangent-vector-components cv1) (cotangent-vector-components cv2)))))))"))
