(task-entry (id "diffgeo/lie-groups/so2-log") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10720) (name so2-log) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp)) (answer "(define (so2-log g) (make-so2-alg (so2-angle g)))"))
(task-entry (id "diffgeo/curvature/compute-christoffel-derivatives") (skill diffgeo) (module curvature) (tier 1) (difficulty 10720) (name compute-christoffel-derivatives) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols compute-metric-derivatives christoffel-ref riemann-tensor)) (answer "(define (compute-christoffel-derivatives m coords eps n) (let ((dgamma (make-4d-array n)) (coords-plus (vec-copy coords)) (coords-minus (vec-copy coords))) (do ((mm 0 (+ mm 1))) ((= mm n) dgamma) (let ((cm (vector-ref coords mm))) (vector-set! coords-plus mm (+ cm eps)) (vector-set! coords-minus mm (- cm eps)) (let ((gamma-plus (christoffel-symbols m coords-plus eps)) (gamma-minus (christoffel-symbols m coords-minus eps))) (do ((l 0 (+ l 1))) ((= l n)) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let ((deriv (/ (- (christoffel-ref gamma-plus l i j) (christoffel-ref gamma-minus l i j)) (* 2 eps)))) (array-4d-set! dgamma mm l i j deriv)))))) (vector-set! coords-plus mm cm) (vector-set! coords-minus mm cm)))))"))
(task-entry (id "diffgeo/geodesics/trace-geodesic-adaptive") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10720) (name trace-geodesic-adaptive) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step)) (answer "(define (trace-geodesic-adaptive metric initial-coords initial-velocity T tol) (let* ((state0 (make-geodesic-state initial-coords initial-velocity)) (dt0 (/ T 10)) (min-dt (* T 1e-10))) (let loop ((state state0) (t 0) (dt dt0) (states (list state0)) (total-rejects 0) (k1-cache #f)) (if (>= t T) (reverse states) (let ((h (min dt (- T t)))) (if (< h min-dt) (reverse states) (let* ((result (adaptive-geodesic-step metric state h tol k1-cache)) (new-state (car result)) (actual-h (cadr result)) (suggested-h (caddr result)) (rejects (cadddr result)) (k7 (car (cddddr result)))) (loop new-state (+ t actual-h) suggested-h (cons new-state states) (+ total-rejects rejects) k7))))))))"))
