(task-entry (id "info/entropy/mutual-information") (skill info) (module entropy) (tier 1) (difficulty 11111) (name mutual-information) (type "(-> (List (List Number)) (List Number) (List Number) Number)") (description "Mutual information I(X;Y) = H(X) + H(Y) - H(X,Y)") (notes ()) (section mutual-information) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy conditional-entropy-direct)) (answer "(define (mutual-information joint-probs marginal-x marginal-y) (let ((h-x (entropy marginal-x)) (h-y (entropy marginal-y)) (h-joint (joint-entropy joint-probs))) (+ h-x (- h-y h-joint))))"))
(task-entry (id "info/statistical-measures/pearson-divergence") (skill info) (module statistical-measures) (tier 1) (difficulty 11111) (name pearson-divergence) (type "(-> (List Real) (List Real) Real)") (description "Pearson chi-squared divergence (alias for chi-squared-divergence)") (notes ()) (section pearson-and-neyman) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared jeffreys-divergence alpha-divergence squared-hellinger-distance triangular-discrimination)) (answer "(define pearson-divergence chi-squared-divergence)"))
(task-entry (id "info/channel-capacity/dmc-output-distribution") (skill info) (module channel-capacity) (tier 1) (difficulty 11111) (name dmc-output-distribution) (type "(-> (List (List Real)) (List Real) (List Real))") (description "Compute P(Y) = sum_x P(Y|X=x) * P(X=x)") (notes ()) (section discrete-memoryless-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity awgn-capacity-db awgn-capacity-bandwidth snr-for-capacity dmc-mutual-information)) (answer "(define (dmc-output-distribution transition input-dist) (let* ((n-outputs (if (null? transition) 0 (length (car transition)))) (n-inputs (length transition))) (map (lambda (j) (fold-left + 0 (map (lambda (i) (* (list-ref input-dist i) (list-ref (list-ref transition i) j))) (iota n-inputs)))) (iota n-outputs))))"))
(task-entry (id "info/rate-distortion/variance") (skill info) (module rate-distortion) (tier 1) (difficulty 11111) (name variance) (type "(-> (List Real) Real)") (description "Population variance: (1/n) * sum((xi - mu)^2)") (notes ()) (section statistical-helpers) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr snr-db psnr mean)) (answer "(define (variance xs) (if (null? xs) 0 (let ((mu (mean xs))) (/ (fold-left + 0 (map (lambda (x) (squared-error x mu)) xs)) (length xs)))))"))
(task-entry (id "info/coding/huffman-encode") (skill info) (module coding) (tier 1) (difficulty 11111) (name huffman-encode) (type "(-> (List Symbol) Node String)") (description "Encode message using Huffman tree") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob huffman-codes huffman-codes-helper)) (answer "(define (huffman-encode message tree) (let ((code-table (huffman-codes tree))) (apply string-append (map (lambda (sym) (let ((entry (assq sym code-table))) (if entry (cdr entry) (error \"huffman-encode\" \"symbol not in code table\" sym)))) message))))"))
