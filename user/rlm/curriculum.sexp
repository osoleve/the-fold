(task-entry (id "optimization/interval-global/list-update") (skill optimization) (module interval-global) (tier 1) (difficulty 12820) (name list-update) (type "") (description "") (notes ()) (section convergence-criteria) (deps (\x27;prelude \x27;interval \x27;heap)) (available (make-interval-convergence interval-convergence? ic-width-tol ic-max-iter ic-gap-tol *default-interval-convergence* make-interval-opt-result interval-opt-result? ior-candidates ior-best-upper ior-iterations ior-reason ior-best-box ior-best-point ior-solution-box box-hull box-midpoint box-max-width box-widest-dimension bisect-box)) (answer "(define (list-update lst idx val) (if (= idx 0) (cons val (cdr lst)) (cons (car lst) (list-update (cdr lst) (- idx 1) val))))"))
(task-entry (id "optimization/interval-contract/make-box-constraints") (skill optimization) (module interval-contract) (tier 1) (difficulty 12820) (name make-box-constraints) (type "") (description "") (notes ()) (section constrained-optimization) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract contract-linear-var remove-dim sum-interval-bounds make-linear-ge-contractor make-linear-eq-contractor make-sphere-contractor contract-sphere-dim sphere-other-sq interval-minimize-constrained bb-loop-constrained add-contracted-boxes add-box-to-heap)) (answer "(define (make-box-constraints bounds) (let loop ((dim 0) (bs bounds) (acc '())) (if (null? bs) (reverse acc) (let ((lo (caar bs)) (hi (cdar bs))) (loop (+ dim 1) (cdr bs) (cons (make-bound-contractor dim lo hi) acc))))))"))
