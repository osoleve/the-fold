(task-entry (id "pipeline/dsl/with-retry-policy") (skill pipeline) (module dsl) (tier 2) (difficulty 21519) (name with-retry-policy) (type "") (description "") (notes ()) (section flow-control-patterns) (deps (\x27;pipeline/stage \x27;pipeline/effects \x27;pipeline/context \x27;council)) (available (define-pipeline* named-stage stage* config with-model with-fuel with-persona with-env \x2D;-> <-- pipe-into parse-json to-json split-lines join-lines on-success on-failure try-all retry)) (answer "(define (with-retry-policy policy stage) (let ((max-attempts (retry-max-attempts policy)) (delay-fn (retry-delay-fn policy)) (retry-pred (retry-on-predicate policy)) (exhaust-action (retry-on-exhaust policy))) (make-stage 'with-retry (lambda (ctx input) (let* ((attempt (or (ctx-env-ref ctx 'retry-attempt) 0)) (result (run-stage stage ctx input))) (cond ((stage-ok? result) result) ((and (stage-err? result) (< attempt max-attempts) (retry-pred (stage-err-code result))) (stage-retry (format \"Retry attempt ~a/~a: ~a\" (+ attempt 1) max-attempts (stage-err-message result)) (delay-fn attempt))) (else (case exhaust-action ((fail) result) ((halt) (stage-halt (format \"Retry exhausted after ~a attempts: ~a\" attempt (if (stage-err? result) (stage-err-message result) \"unknown error\")))) (else result)))))))))"))
