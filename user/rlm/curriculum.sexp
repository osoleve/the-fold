(task-entry (id "dsl/partial-eval/bt-env-lookup") (skill dsl) (module partial-eval) (tier 1) (difficulty 11709) (name bt-env-lookup) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt? bt-join bt-meet bt<=? make-bt-env bt-env-extend)) (answer "(define (bt-env-lookup env var) (let ((entry (assq var env))) (if entry (cdr entry) bt-dynamic)))"))
(task-entry (id "dsl/compose/row-fmap-helper") (skill dsl) (module compose) (tier 1) (difficulty 11709) (name row-fmap-helper) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap)) (answer "(define (row-fmap-helper f value depth functors fmap-alist) (cond ((null? functors) (error 'row-fmap \"Value not in row\" value)) ((inl? value) (let* ((tag (car functors)) (fmap-entry (assq tag fmap-alist))) (if fmap-entry (inl ((cdr fmap-entry) f (from-inl value))) (error 'row-fmap \"No fmap for functor\" tag)))) ((inr? value) (inr (row-fmap-helper f (from-inr value) (+ depth 1) (cdr functors) fmap-alist))) (else (error 'row-fmap \"Malformed coproduct value\" value))))"))
