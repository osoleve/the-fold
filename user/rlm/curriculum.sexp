(task-entry (id "diffgeo/curvature/sectional-curvature") (skill diffgeo) (module curvature) (tier 1) (difficulty 10750) (name sectional-curvature) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols compute-metric-derivatives christoffel-ref riemann-tensor compute-christoffel-derivatives make-4d-array array-4d-ref array-4d-set! dgamma-ref riemann-ref ricci-tensor scalar-curvature surface? surface-param make-surface surface-at first-fundamental-form second-fundamental-form gaussian-curvature mean-curvature principal-curvatures surface-partial-u surface-partial-v surface-partial-uu surface-partial-vv surface-partial-uv surface-normal vec3-cross make-sphere-surface make-torus-surface make-paraboloid-surface make-saddle-surface classify-point-curvature surface-classify)) (answer "(define (sectional-curvature m coords X Y . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *curvature-epsilon* (car epsilon-arg))) (n (metric-dim m)) (g (metric-at m coords)) (R (riemann-tensor m coords eps)) (numerator 0) (gXX (metric-inner-product m coords X X)) (gYY (metric-inner-product m coords Y Y)) (gXY (metric-inner-product m coords X Y)) (denominator (- (* gXX gYY) (* gXY gXY)))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (do ((k 0 (+ k 1))) ((= k n)) (do ((l 0 (+ l 1))) ((= l n)) (let ((R-ijkl 0)) (do ((mm 0 (+ mm 1))) ((= mm n)) (set! R-ijkl (+ R-ijkl (* (matrix-ref g l mm) (riemann-ref R mm i j k))))) (set! numerator (+ numerator (* R-ijkl (vector-ref Y i) (vector-ref X j) (vector-ref Y k) (vector-ref X l))))))))) (if (< (abs denominator) 1e-15) 0 (/ numerator denominator))))"))
