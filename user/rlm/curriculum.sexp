(task-entry (id "algebra/tropical/tropical-poly-roots") (skill algebra) (module tropical) (tier 0) (difficulty 322) (name tropical-poly-roots) (type "") (description "") (notes ()) (section tropical-polynomials) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add tropical-matrix-power tropical-matrix-closure tropical-eigenvalue tropical-critical-edges tropical-poly-eval newton-polygon trim-hull)) (answer "(define (tropical-poly-roots coeffs) (let ((hull (newton-polygon coeffs))) (if (< (length hull) 2) '() (let loop ((pts (cdr hull)) (prev (car hull)) (acc '())) (if (null? pts) (reverse acc) (let* ((cur (car pts)) (slope (/ (- (cdr cur) (cdr prev)) (- (car cur) (car prev))))) (loop (cdr pts) cur (cons slope acc))))))))"))
(task-entry (id "algebra/group/permutation-inverse") (skill algebra) (module group) (tier 0) (difficulty 323) (name permutation-inverse) (type "(-> Permutation Permutation)") (description "Compute the inverse permutation") (notes ()) (section permutation-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose)) (answer "(define (permutation-inverse perm) (let* ((n (length perm)) (result (make-list n 0))) (let loop ((i 0) (res result)) (if (= i n) res (loop (+ i 1) (list-set res (list-ref perm i) i))))))"))
