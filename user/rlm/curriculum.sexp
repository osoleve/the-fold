(task-entry (id "diffgeo/lie-groups/so3-exp") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10736) (name so3-exp) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp so2-log so3? so3-matrix make-so3-from-matrix make-so3 so3-identity so3-compose so3-inverse so3-act so3-alg? so3-alg-vec make-so3-alg so3-hat so3-vee so3-alg-to-matrix so3-matrix-to-alg)) (answer "(define (so3-exp xi) (let* ((omega (so3-alg-vec xi)) (theta (vec-norm omega))) (if (< theta *lie-epsilon*) (let* ((omega-hat (so3-hat omega)) (omega-hat-sq (matrix-mul omega-hat omega-hat)) (I (identity-matrix 3)) (term1 (matrix-add I omega-hat)) (term2 (matrix-scale 0.5 omega-hat-sq))) (list 'so3 (matrix-add term1 term2))) (let* ((axis (vec-scale (/ 1.0 theta) omega)) (axis-hat (so3-hat axis)) (axis-hat-sq (matrix-mul axis-hat axis-hat)) (I (identity-matrix 3)) (sin-term (matrix-scale (sin theta) axis-hat)) (cos-term (matrix-scale (- 1 (cos theta)) axis-hat-sq))) (list 'so3 (matrix-add (matrix-add I sin-term) cos-term))))))"))
(task-entry (id "diffgeo/curvature/principal-curvatures") (skill diffgeo) (module curvature) (tier 1) (difficulty 10736) (name principal-curvatures) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols compute-metric-derivatives christoffel-ref riemann-tensor compute-christoffel-derivatives make-4d-array array-4d-ref array-4d-set! dgamma-ref riemann-ref ricci-tensor scalar-curvature surface? surface-param make-surface surface-at first-fundamental-form second-fundamental-form gaussian-curvature mean-curvature)) (answer "(define (principal-curvatures surf u v . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *curvature-epsilon* (car epsilon-arg))) (K (gaussian-curvature surf u v eps)) (H (mean-curvature surf u v eps)) (discriminant (- (* H H) K))) (if (< discriminant 0) (list H H) (let ((sqrt-disc (sqrt discriminant))) (list (+ H sqrt-disc) (- H sqrt-disc))))))"))
(task-entry (id "diffgeo/geodesics/parallel-transport-derivative") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10736) (name parallel-transport-derivative) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final trace-geodesic-adaptive-at-times exp-map-adaptive exp-map-adaptive-t log-map-adaptive vec-finite? compute-exp-jacobian-adaptive geodesic-distance-adaptive trace-geodesic trace-geodesic-final exp-map exp-map-t log-map compute-exp-jacobian solve-linear-system)) (answer "(define (parallel-transport-derivative metric coords velocity V) (let* ((n (metric-dim metric)) (gamma (cached-christoffel-symbols metric coords *geodesic-epsilon*)) (dV (make-vector n 0))) (do ((k 0 (+ k 1))) ((= k n) dV) (let ((sum 0)) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (set! sum (+ sum (* (christoffel-ref gamma k i j) (vector-ref velocity i) (vector-ref V j)))))) (vector-set! dV k (- sum))))))"))
(task-entry (id "diffgeo/forms/d-scalar") (skill diffgeo) (module forms) (tier 1) (difficulty 10736) (name d-scalar) (type "") (description "") (notes ()) (section exterior-derivative) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices count-inversions-to-sort k-form? k-form-point k-form-chart k-form-degree k-form-components k-form-dim make-k-form k-form-zero k-form-basis cotangent->1-form \x31;-form->cotangent k-form-add k-form-sub k-form-scale k-form-negate k-form-change-chart wedge wedge* interior-product remove-at exterior-derivative insert-sorted insertion-sign)) (answer "(define (d-scalar f point chart . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *jacobian-epsilon* (car epsilon-arg))) (coords (chart-apply chart point)) (n (chart-dim chart)) (grad (make-vector n 0)) (coords-plus (vec-copy coords)) (coords-minus (vec-copy coords))) (do ((i 0 (+ i 1))) ((= i n)) (let ((ci (vector-ref coords i))) (vector-set! coords-plus i (+ ci eps)) (vector-set! coords-minus i (- ci eps))) (let* ((p-plus (chart-apply-inverse chart coords-plus)) (p-minus (chart-apply-inverse chart coords-minus)) (deriv (/ (- (f p-plus) (f p-minus)) (* 2 eps)))) (vector-set! grad i deriv)) (let ((ci (vector-ref coords i))) (vector-set! coords-plus i ci) (vector-set! coords-minus i ci))) (make-k-form point chart 1 grad)))"))
