(task-entry (id "tiles/core/clamp") (skill tiles) (module core) (tier 1) (difficulty 12327) (name clamp) (type "(-> Number Number Number Number)") (description "Clamp value between min and max") (notes ()) (section utilities) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size board-empty? square-directions-8 square-directions-4 hex-directions-pointy hex-directions-flat triangle-directions)) (answer "(define (clamp value min-val max-val) (max min-val (min max-val value)))"))
(task-entry (id "tiles/core/sign") (skill tiles) (module core) (tier 1) (difficulty 12328) (name sign) (type "(-> Number Number)") (description "Return sign of number (-1, 0, or 1)") (notes ()) (section utilities) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size board-empty? square-directions-8 square-directions-4 hex-directions-pointy hex-directions-flat triangle-directions clamp)) (answer "(define (sign n) (cond ((> n 0) 1) ((< n 0) -1) (else 0)))"))
(task-entry (id "tiles/core/manhattan-distance") (skill tiles) (module core) (tier 1) (difficulty 12329) (name manhattan-distance) (type "(-> Number Number Number Number Number)") (description "Manhattan distance (L1 metric)") (notes ()) (section utilities) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size board-empty? square-directions-8 square-directions-4 hex-directions-pointy hex-directions-flat triangle-directions clamp sign)) (answer "(define (manhattan-distance x1 y1 x2 y2) (+ (abs (- x2 x1)) (abs (- y2 y1))))"))
(task-entry (id "tiles/core/chebyshev-distance") (skill tiles) (module core) (tier 1) (difficulty 12330) (name chebyshev-distance) (type "(-> Number Number Number Number Number)") (description "Chebyshev distance (L∞ metric, king's move in chess)") (notes ()) (section utilities) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size board-empty? square-directions-8 square-directions-4 hex-directions-pointy hex-directions-flat triangle-directions clamp sign manhattan-distance)) (answer "(define (chebyshev-distance x1 y1 x2 y2) (max (abs (- x2 x1)) (abs (- y2 y1))))"))
(task-entry (id "tiles/core/euclidean-distance") (skill tiles) (module core) (tier 1) (difficulty 12331) (name euclidean-distance) (type "(-> Number Number Number Number Number)") (description "Euclidean distance (L2 metric)") (notes ()) (section utilities) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size board-empty? square-directions-8 square-directions-4 hex-directions-pointy hex-directions-flat triangle-directions clamp sign manhattan-distance chebyshev-distance)) (answer "(define (euclidean-distance x1 y1 x2 y2) (sqrt (+ (expt (- x2 x1) 2) (expt (- y2 y1) 2))))"))
(task-entry (id "tiles/core/deduplicate") (skill tiles) (module core) (tier 1) (difficulty 12332) (name deduplicate) (type "(-> (List a) (-> a a Boolean) (List a))") (description "Remove duplicates from list using equality predicate") (notes ()) (section list-utilities) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size board-empty? square-directions-8 square-directions-4 hex-directions-pointy hex-directions-flat triangle-directions clamp sign manhattan-distance chebyshev-distance euclidean-distance)) (answer "(define (deduplicate lst equal?) (let loop ((lst lst) (seen '())) (if (null? lst) (reverse seen) (if (memp (lambda (x) (equal? x (car lst))) seen) (loop (cdr lst) seen) (loop (cdr lst) (cons (car lst) seen))))))"))
(task-entry (id "tiles/core/alist-ref") (skill tiles) (module core) (tier 1) (difficulty 12333) (name alist-ref) (type "") (description "") (notes ()) (section list-utilities) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable? tile-cost tile-blocks? tile-get-prop make-board board-shape board-meta board-get board-set board-remove board-tiles board-coords board-size board-empty? square-directions-8 square-directions-4 hex-directions-pointy hex-directions-flat triangle-directions clamp sign manhattan-distance chebyshev-distance euclidean-distance deduplicate)) (answer "(define alist-ref (case-lambda ((alist key) (let ((pair (assq key alist))) (if pair (cdr pair) #f))) ((alist key default) (let ((pair (assq key alist))) (if pair (cdr pair) default)))))"))
(task-entry (id "autodiff/higher-order-diff/jacobian") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12700) (name jacobian) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available ()) (answer "(define (jacobian f args) (let* ((n (length args)) (sample-result (apply f (map (lambda (x) (make-traced-var x (make-reverse-tape))) args))) (m (if (or (traced? sample-result) (not (list? sample-result))) 1 (length sample-result)))) (jacobian-reverse f args n m)))"))
(task-entry (id "autodiff/differentiable/TC-Differentiable") (skill autodiff) (module differentiable) (tier 1) (difficulty 12700) (name TC-Differentiable) (type "") (description "") (notes ()) (section differentiable-typeclass) (deps (\x27;prelude \x27;kinds \x27;infer \x27;resolve \x27;comp-graph \x27;reverse-diff)) (available ()) (answer "(define TC-Differentiable (make-typeclass 'Differentiable K* '() '((lift forall (d) (=> (Differentiable d) (-> Real d))) (primal forall (d) (=> (Differentiable d) (-> d Real))) (tangent forall (d) (=> (Differentiable d) (-> d Real))) (d+ forall (d) (=> (Differentiable d) (-> d d d))) (d* forall (d) (=> (Differentiable d) (-> d d d))) (d- forall (d) (=> (Differentiable d) (-> d d d))) (d/ forall (d) (=> (Differentiable d) (-> d d d))) (d-neg forall (d) (=> (Differentiable d) (-> d d))) (d-sq forall (d) (=> (Differentiable d) (-> d d))) (d-sqrt forall (d) (=> (Differentiable d) (-> d d))) (d-exp forall (d) (=> (Differentiable d) (-> d d))) (d-log forall (d) (=> (Differentiable d) (-> d d))) (d-sin forall (d) (=> (Differentiable d) (-> d d))) (d-cos forall (d) (=> (Differentiable d) (-> d d))))))"))
