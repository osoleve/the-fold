(task-entry (id "linalg/graph-laplacian/laplacian-max-eigenvalue") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 417) (name laplacian-max-eigenvalue) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian)) (answer "(define (laplacian-max-eigenvalue adj) (let* ((L (laplacian adj)) (eigs (eigenvalues L))) (if (and (pair? eigs) (eq? (car eigs) 'error)) eigs (let ((n (vector-length eigs))) (let loop ((i 0) (max-val 0)) (if (= i n) max-val (loop (+ i 1) (max max-val (vector-ref eigs i)))))))))"))
(task-entry (id "linalg/svd/build-sigma-pseudoinverse") (skill linalg) (module svd) (tier 0) (difficulty 417) (name build-sigma-pseudoinverse) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin matrix-slice-cols matrix-slice pseudoinverse)) (answer "(define (build-sigma-pseudoinverse sigma m n tol) (let* ((sigma-pinv (make-matrix n m 0)) (k (min m n))) (do ((i 0 (+ i 1))) ((= i k) sigma-pinv) (let ((s (matrix-ref sigma i i))) (when (> (abs s) tol) (matrix-set! sigma-pinv i i (/ 1.0 s)))))))"))
