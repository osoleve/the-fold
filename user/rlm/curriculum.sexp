(task-entry (id "physics/classical3d/shapes3d/aabb3d-contains-point?") (skill physics/classical3d) (module shapes3d) (tier 2) (difficulty 22435) (name aabb3d-contains-point?) (type "") (description "") (notes ()) (section sphere3d) (deps (\x27;vec3)) (available (sphere3d sphere3d? sphere3d-center sphere3d-radius sphere3d-diameter sphere3d-volume sphere3d-surface-area sphere3d-aabb sphere3d-with-center sphere3d-with-radius sphere3d-contains-point? box3d box3d? box3d-center box3d-half-extents box3d-extents box3d-min box3d-max box3d-volume box3d-surface-area box3d-aabb box3d-with-center box3d-with-half-extents box3d-contains-point? box3d-corner box3d-corners aabb3d aabb3d? aabb3d-min aabb3d-max aabb3d-center aabb3d-half-extents aabb3d-extents aabb3d-volume aabb3d-surface-area)) (answer "(define (aabb3d-contains-point? a p) (let ((min-c (aabb3d-min a)) (max-c (aabb3d-max a))) (and (>= (vec3-x p) (vec3-x min-c)) (<= (vec3-x p) (vec3-x max-c)) (>= (vec3-y p) (vec3-y min-c)) (<= (vec3-y p) (vec3-y max-c)) (>= (vec3-z p) (vec3-z min-c)) (<= (vec3-z p) (vec3-z max-c)))))"))
(task-entry (id "physics/classical3d/collision-detection3d/find-collision-pairs-3d") (skill physics/classical3d) (module collision-detection3d) (tier 2) (difficulty 22435) (name find-collision-pairs-3d) (type "") (description "") (notes ()) (section point-in-shape-tests) (deps (\x27;prelude \x27;vec3 \x27;shapes3d)) (available (point-in-aabb3d? point-in-sphere3d? point-in-box3d? closest-point-on-segment-3d closest-point-on-aabb3d closest-point-on-box3d sphere-sphere? sphere-sphere-manifold aabb3d-aabb3d? aabb3d-aabb3d-manifold sphere-aabb3d? sphere-aabb3d-manifold sphere-inside-aabb-normal sphere-box3d? sphere-box3d-manifold sphere-inside-box-normal box3d-box3d? box3d-box3d-manifold shape-type-3d shape-aabb-3d shapes-collide-3d? shapes-manifold-3d manifold-normal manifold-penetration manifold-contact cell-key-3d make-spatial-hash-3d spatial-hash-3d-cell-size spatial-hash-3d-table point-to-cell-3d aabb-to-cells-3d spatial-hash-3d-insert! spatial-hash-3d-query spatial-hash-3d-clear! pair-key-3d)) (answer "(define (find-collision-pairs-3d items sh) (spatial-hash-3d-clear! sh) (for-each (lambda (item) (let ((obj (car item)) (shape (cdr item))) (spatial-hash-3d-insert! sh obj (shape-aabb-3d shape)))) items) (let ((pairs '()) (seen (make-hashtable string-hash string=?))) (for-each (lambda (item) (let* ((obj-a (car item)) (shape-a (cdr item)) (candidates (spatial-hash-3d-query sh (shape-aabb-3d shape-a)))) (for-each (lambda (obj-b) (let ((key (pair-key-3d obj-a obj-b))) (when (and (not (eq? obj-a obj-b)) (not (hashtable-ref seen key #f))) (hashtable-set! seen key #t) (set! pairs (cons (cons obj-a obj-b) pairs))))) candidates))) items) pairs))"))
