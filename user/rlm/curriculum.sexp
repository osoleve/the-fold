(task-entry (id "algebra/galois/gf2n-mul-raw") (skill algebra) (module galois) (tier 0) (difficulty 327) (name gf2n-mul-raw) (type "") (description "") (notes ()) (section gf2n-binary-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large)) (answer "(define (gf2n-mul-raw a b n irred) (let ((high-bit (bitwise-arithmetic-shift-left 1 n))) (let loop ((a a) (b b) (result 0)) (if (= b 0) result (let* ((new-result (if (odd? b) (bitwise-xor result a) result)) (a-shifted (bitwise-arithmetic-shift-left a 1)) (a-reduced (if (>= a-shifted high-bit) (bitwise-xor a-shifted irred) a-shifted))) (loop a-reduced (bitwise-arithmetic-shift-right b 1) new-result))))))"))
(task-entry (id "algebra/group/permute-list") (skill algebra) (module group) (tier 0) (difficulty 328) (name permute-list) (type "(-> List (List List))") (description "Generate all permutations of a list") (notes ()) (section permutation-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations)) (answer "(define (permute-list lst) (if (null? lst) '(()) (append-map (lambda (x) (map (lambda (p) (cons x p)) (permute-list (remove x lst)))) lst)))"))
