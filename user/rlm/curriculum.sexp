(task-entry (id "data/sort/vector-sort-by!") (skill data) (module sort) (tier 0) (difficulty 1333) (name vector-sort-by!) (type "(-> (-> α α Boolean) (Vector α) Void)") (description "Sort vector in-place using heapsort with custom comparator") (notes ("O(n log n) worst-case, O(1) extra space" "Transparent implementation using only vector-ref/vector-set!")) (section vector-sorting) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort sort-by-key sort-by-key-desc sort-desc quicksort-desc sorted? sorted-by? sorted-desc? unique-sorted sort-unique nth-smallest median min-element max-element min-by max-by take-sorted top-k bottom-k vector-swap!)) (answer "(define (vector-sort-by! cmp vec) (let ((n (vector-length vec))) (define (sift-down! root end) (let loop ((r root)) (let ((left (+ (* 2 r) 1))) (when (< left end) (let* ((right (+ left 1)) (largest r) (largest (if (cmp (vector-ref vec largest) (vector-ref vec left)) left largest)) (largest (if (and (< right end) (cmp (vector-ref vec largest) (vector-ref vec right))) right largest))) (unless (= largest r) (vector-swap! vec r largest) (loop largest))))))) (let loop ((start (- (quotient n 2) 1))) (when (>= start 0) (sift-down! start n) (loop (- start 1)))) (let loop ((end (- n 1))) (when (> end 0) (vector-swap! vec 0 end) (sift-down! 0 end) (loop (- end 1))))))"))
