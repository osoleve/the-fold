(task-entry (id "game-theory/voting/smith-set") (skill game-theory) (module voting) (tier 1) (difficulty 13235) (name smith-set) (type "(-> PreferenceProfile (List Candidate))") (description "Compute the Smith set: smallest dominating set. Uses iterative elimination: start with all candidates, remove any candidate beaten by someone staying.") (notes ()) (section smith-set) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score minimax-winner minimax-ranking)) (answer "(define (smith-set profile) (if (profile-empty? profile) '() (let ((candidates (profile-candidates profile))) (let ((dominated-by (make-eq-hashtable))) (for-each (lambda (c) (hashtable-set! dominated-by c (filter (lambda (other) (> (pairwise-margin other c profile) 0)) (remove c candidates)))) candidates) (let loop ((remaining candidates)) (let ((removable (filter (lambda (c) (any? (lambda (other) (and (not (eq? other c)) (member other remaining) (> (pairwise-margin other c profile) 0))) remaining)) remaining))) (let ((truly-dominated (filter (lambda (c) (let ((dominated-count (count-if (lambda (other) (and (not (eq? other c)) (member other remaining) (> (pairwise-margin other c profile) 0))) remaining))) (and (> dominated-count 0) (not (any? (lambda (other) (and (not (eq? other c)) (member other remaining) (> (pairwise-margin c other profile) 0) (= dominated-count (- (length remaining) 1)))) remaining))))) remaining))) (let ((to-remove (filter (lambda (c) (let ((dominated-by-all? (for-all? (lambda (other) (or (eq? other c) (> (pairwise-margin other c profile) 0))) remaining))) dominated-by-all?)) remaining))) (if (or (null? to-remove) (= (length to-remove) (length remaining))) remaining (loop (filter (lambda (c) (not (member c to-remove))) remaining)))))))))))"))
(task-entry (id "game-theory/multi-winner/representation-coverage") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13235) (name representation-coverage) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction cc-greedy cc-loop cc-marginal-score cc-total-satisfaction proportionality-score)) (answer "(define (representation-coverage approval-profile committee) (if (null? approval-profile) 1 (let ((covered (count-if (lambda (approvals) (any? (lambda (c) (member c approvals)) committee)) approval-profile))) (/ covered (length approval-profile)))))"))
(task-entry (id "game-theory/fair-division/make-adjusted-winner-problem") (skill game-theory) (module fair-division) (tier 1) (difficulty 13235) (name make-adjusted-winner-problem) (type "") (description "") (notes ()) (section adjusted-winner) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax)) (answer "(define (make-adjusted-winner-problem goods points-1 points-2) (let ((n (length goods))) (if (not (= n (length points-1))) (error 'make-adjusted-winner-problem \"points-1 length mismatch\") (if (not (= n (length points-2))) (error 'make-adjusted-winner-problem \"points-2 length mismatch\") (make-adjusted-winner-problem% (list->vector goods) (vector (list->vector points-1) (list->vector points-2)))))))"))
