(task-entry (id "fp/integrate/linear-coefficients") (skill fp) (module integrate) (tier 1) (difficulty 10627) (name linear-coefficients) (type "") (description "") (notes ()) (section partial-fractions) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power integrate-quotient integrate-by-substitution try-substitution-pattern find-antiderivative-match find-u-candidates substitute-u can-express-in-u? replace-with-u try-trig-substitution integrate-by-parts sort-by-liate liate-priority polynomial? try-parts integrate-partial-fractions integrate-linear-factors contains-var? linear-in? degree-of)) (answer "(define (linear-coefficients expr var-sym) (cond ((num? expr) (list (num 0) expr)) ((and (var? expr) (eq? (var-name expr) var-sym)) (list (num 1) (num 0))) ((and (var? expr) (not (eq? (var-name expr) var-sym))) (list (num 0) expr)) ((sum? expr) (let* ((coeffs (map (lambda (t) (linear-coefficients t var-sym)) (sum-terms expr))) (as (map car coeffs)) (bs (map cadr coeffs))) (list (fold-left sum (num 0) as) (fold-left sum (num 0) bs)))) ((product? expr) (let* ((factors (product-factors expr)) (const-factors (filter (lambda (f) (not (contains-var? f var-sym))) factors)) (var-factors (filter (lambda (f) (contains-var? f var-sym)) factors))) (if (and (<= (length var-factors) 1) (or (null? var-factors) (and (var? (car var-factors)) (eq? (var-name (car var-factors)) var-sym)))) (list (fold-left product (num 1) const-factors) (num 0)) (list (num 0) expr)))) ((difference? expr) (if (diff-right expr) (let ((lcoeffs (linear-coefficients (diff-left expr) var-sym)) (rcoeffs (linear-coefficients (diff-right expr) var-sym))) (list (difference (car lcoeffs) (car rcoeffs)) (difference (cadr lcoeffs) (cadr rcoeffs)))) (let ((coeffs (linear-coefficients (diff-left expr) var-sym))) (list (make-neg (car coeffs)) (make-neg (cadr coeffs)))))) (else (list (num 0) expr))))"))
(task-entry (id "fp/solve/gaussian-eliminate-symbolic") (skill fp) (module solve) (tier 1) (difficulty 10627) (name gaussian-eliminate-symbolic) (type "") (description "") (notes ()) (section linear-systems) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms solve-linear solve-quadratic solve-cubic solve-polynomial diff-to-sum solve solve-for solve-linear-system build-coefficient-matrix augment-with-constants)) (answer "(define (gaussian-eliminate-symbolic matrix n) (let loop ((m matrix) (col 0)) (if (>= col n) m (let ((pivot-row (find-nonzero-pivot m col))) (if (not pivot-row) (loop m (+ col 1)) (let* ((m1 (swap-rows m col pivot-row)) (m2 (eliminate-below m1 col))) (loop m2 (+ col 1))))))))"))
