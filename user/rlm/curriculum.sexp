(task-entry (id "game-theory/coop-games/shapley-value-adaptive") (skill game-theory) (module coop-games) (tier 1) (difficulty 13255) (name shapley-value-adaptive) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky make-additive-game make-unanimity-game make-weighted-voting-game make-airport-game make-bankruptcy-game make-gloves-game coop-game-superadditive? coop-game-convex? coop-game-monotonic? coop-game-simple? is-winning? is-blocking? is-pivotal? banzhaf-index random-permutation shapley-value-sample *shapley-exact-threshold* *shapley-default-samples*)) (answer "(define (shapley-value-adaptive game fuel) (let ((n (coop-game-players game))) (if (<= n *shapley-exact-threshold*) (shapley-value game fuel) (shapley-value-sample game *shapley-default-samples* fuel))))"))
(task-entry (id "game-theory/fair-division/opposing-valuations-cake") (skill game-theory) (module fair-division) (tier 1) (difficulty 13255) (name opposing-valuations-cake) (type "") (description "") (notes ()) (section discrete-fair-division) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax make-adjusted-winner-problem adjusted-winner equalize-allocations transfer-to-equalize transfer-loop update-fraction remove-good format-allocation make-discrete-problem discrete-problem-players discrete-problem-goods-count discrete-problem-valuation round-robin discrete-allocation-value envy-free-up-to-one? maximin-share maximin-search-greedy argmin uniform-cake simple-cake-2)) (answer "(define (opposing-valuations-cake) (let ((c (make-cake 3))) (cake-set-valuation! c 0 (lambda (x) (- 2 (* 2 x)))) (cake-set-valuation! c 1 (lambda (x) 1)) (cake-set-valuation! c 2 (lambda (x) (* 2 x))) c))"))
