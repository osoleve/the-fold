(task-entry (id "tiles/turns/turn-log-action") (skill tiles) (module turns) (tier 1) (difficulty 12308) (name turn-log-action) (type "(-> TurnState Symbol Any TurnState)") (description "Add action to history") (notes ()) (section actions) (deps (\x27;sort)) (available (make-turn-state make-turn-state-from-game turn-current-unit turn-current-phase turn-number turn-actions-remaining turn-can-act? turn-spend-action)) (answer "(define (turn-log-action ts action-type details) (let ((entry (list (turn-state%-turn-number ts) (turn-state%-active-unit ts) action-type details)) (history (turn-state%-history ts))) (make-turn-state% (turn-state%-turn-number ts) (turn-state%-active-unit ts) (turn-state%-turn-order ts) (turn-state%-action-points ts) (turn-state%-phase ts) (cons entry history))))"))
