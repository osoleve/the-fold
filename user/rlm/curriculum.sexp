(task-entry (id "linalg/sparse/sparse-csc-ref") (skill linalg) (module sparse) (tier 0) (difficulty 430) (name sparse-csc-ref) (type "") (description "") (notes ()) (section csr-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr? make-sparse-csr sparse-csr-rows sparse-csr-cols sparse-csr-row-ptrs sparse-csr-col-indices sparse-csr-values sparse-csr-nnz sparse-csr-ref sparse-csr-row sparse-csr-row-alist sparse-csc? make-sparse-csc sparse-csc-rows sparse-csc-cols sparse-csc-col-ptrs sparse-csc-row-indices sparse-csc-values sparse-csc-nnz)) (answer "(define (sparse-csc-ref m i j) (let* ((col-ptrs (sparse-csc-col-ptrs m)) (row-idx (sparse-csc-row-indices m)) (vals (sparse-csc-values m)) (start (vector-ref col-ptrs j)) (end (vector-ref col-ptrs (+ j 1)))) (let loop ((k start)) (cond ((= k end) 0) ((= (vector-ref row-idx k) i) (vector-ref vals k)) (else (loop (+ k 1)))))))"))
(task-entry (id "linalg/graph-laplacian/recompute-centroids") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 430) (name recompute-centroids) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue is-bipartite-spectral? effective-resistance total-effective-resistance laplacian-summary spectral-clustering spectral-clustering-unnorm k-smallest-indices spectral-embedding kmeans-cluster kmeans-init-pp nearest-centroid point-centroid-distance)) (answer "(define (recompute-centroids points labels k d n) (let ((centroids (make-matrix k d 0)) (counts (make-vector k 0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((c (vector-ref labels i))) (vector-set! counts c (+ 1 (vector-ref counts c))) (do ((j 0 (+ j 1))) ((= j d)) (matrix-set! centroids c j (+ (matrix-ref centroids c j) (matrix-ref points i j)))))) (do ((c 0 (+ c 1))) ((= c k)) (let ((cnt (vector-ref counts c))) (if (> cnt 0) (do ((j 0 (+ j 1))) ((= j d)) (matrix-set! centroids c j (/ (matrix-ref centroids c j) cnt))) (let ((furthest-idx (find-furthest-point points centroids c k d n))) (do ((j 0 (+ j 1))) ((= j d)) (matrix-set! centroids c j (matrix-ref points furthest-idx j))))))) centroids))"))
