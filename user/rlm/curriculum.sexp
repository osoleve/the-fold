(task-entry (id "optimization/first-order/adam") (skill optimization) (module first-order) (tier 1) (difficulty 12803) (name adam) (type "(-> (-> (List TracedValue) TracedValue) (List Number) Number ConvergenceCriteria OptResult)") (description "Adam optimizer with default hyperparameters") (notes ()) (section adam) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum)) (answer "(define (adam f x0 lr criteria) (adam-full f x0 lr 0.9 0.999 1e-8 criteria))"))
(task-entry (id "optimization/newton/matrix-add-diagonal") (skill optimization) (module newton) (tier 1) (difficulty 12803) (name matrix-add-diagonal) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction)) (answer "(define (matrix-add-diagonal m lambda) (let* ((n (matrix-rows m)) (data (matrix-data m)) (len (vector-length data)) (new-data (make-vector len 0))) (do ((k 0 (+ k 1))) ((= k len)) (vector-set! new-data k (vector-ref data k))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n n new-data)) (let ((idx (+ (* i n) i))) (vector-set! new-data idx (+ (vector-ref new-data idx) lambda))))))"))
