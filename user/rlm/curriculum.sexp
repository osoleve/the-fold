(task-entry (id "algebra/galois/gf-ext-mul") (skill algebra) (module galois) (tier 0) (difficulty 315) (name gf-ext-mul) (type "") (description "") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg)) (answer "(define (gf-ext-mul a b base-field n modulus) (let* ((ca (gf-ext-coeffs a)) (cb (gf-ext-coeffs b)) (pa (make-polynomial base-field ca)) (pb (make-polynomial base-field cb)) (product (poly-mul pa pb)) (reduced (poly-mod product modulus)) (result-coeffs (poly-coeffs reduced))) (make-gf-ext-element (gf-ext-normalize result-coeffs n base-field) modulus base-field)))"))
(task-entry (id "algebra/tropical/tropical-matrix-power") (skill algebra) (module tropical) (tier 0) (difficulty 315) (name tropical-matrix-power) (type "") (description "") (notes ()) (section matrix-operations) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add)) (answer "(define (tropical-matrix-power sr A k) (let ((n (matrix-rows A))) (cond ((= k 0) (tropical-matrix-identity sr n)) ((= k 1) A) ((even? k) (let ((half (tropical-matrix-power sr A (quotient k 2)))) (tropical-matrix-mul sr half half))) (else (tropical-matrix-mul sr A (tropical-matrix-power sr A (- k 1)))))))"))
(task-entry (id "algebra/group/verify-inverses") (skill algebra) (module group) (tier 0) (difficulty 316) (name verify-inverses) (type "(-> Group Boolean)") (description "Check that a ∘ a⁻¹ = a⁻¹ ∘ a = e for all elements") (notes ()) (section group-axiom-verification) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity)) (answer "(define (verify-inverses g) (let ((elems (group-elements g)) (op (group-op g)) (e (group-identity g)) (inv (group-inverse-fn g)) (eq? (group-equal-fn g))) (let loop ((es elems)) (if (null? es) #t (let* ((a (car es)) (a-inv (inv a))) (if (and (eq? (op a a-inv) e) (eq? (op a-inv a) e)) (loop (cdr es)) #f))))))"))
(task-entry (id "algebra/ring/ring-sum") (skill algebra) (module ring) (tier 0) (difficulty 316) (name ring-sum) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal? ring-power)) (answer "(define (ring-sum r elements) (if (null? elements) (ring-zero r) (let loop ((elems (cdr elements)) (acc (car elements))) (if (null? elems) acc (loop (cdr elems) (ring-add r acc (car elems)))))))"))
