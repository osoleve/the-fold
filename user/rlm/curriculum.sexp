(task-entry (id "fp/effect-category/algebra-to-handler") (skill fp) (module effect-category) (tier 1) (difficulty 10607) (name algebra-to-handler) (type "(-> Algebra Handler)") (description "Convert an algebra to a handler.\nThe 'pure operation becomes return-case, other operations become effect-cases.\nThis enables using algebraic structures to interpret effects.") (notes ()) (section handlers-as-algebras) (deps (\x27;free-algebra \x27;effects)) (available (effect-sig-to-signature sig-effect-state sig-effect-reader sig-effect-writer sig-effect-exception sig-effect-nondet handler-to-algebra)) (answer "(define (algebra-to-handler alg) (let* ((ops (algebra-ops alg)) (pure-entry (assq 'pure ops)) (pure-fn (if pure-entry (cdr pure-entry) identity)) (effect-cases (filter (lambda (entry) (not (eq? (car entry) 'pure))) ops))) (deep-handler pure-fn effect-cases)))"))
