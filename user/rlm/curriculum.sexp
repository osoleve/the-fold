(task-entry (id "dataset/jsonl/json->string") (skill dataset) (module jsonl) (tier 1) (difficulty 13412) (name json->string) (type "") (description "") (notes ()) (section serialization) (deps (core/base/prelude.ss lattice/optics/optics.ss lattice/dataset/sample.ss)) (available (make-json-object json-object? json-object-pairs make-json-array json-array? json-array-items sample->json json->sample value->json json->value sample-json-iso iso-roundtrip-check)) (answer "(define (json->string v) (cond ((json-object? v) (let ((pairs (json-object-pairs v))) (string-append \"{\" (join-strings (map (lambda (p) (string-append (json-string-escape (car p)) \":\" (json->string (cdr p)))) pairs) \",\") \"}\"))) ((json-array? v) (string-append \"[\" (join-strings (map json->string (json-array-items v)) \",\") \"]\")) ((string? v) (json-string-escape v)) ((number? v) (if (and (exact? v) (integer? v)) (number->string v) (number->string (exact->inexact v)))) ((boolean? v) (if v \"true\" \"false\")) ((eq? v 'null) \"null\") ((symbol? v) (json-string-escape (symbol->string v))) (else (json-string-escape (format \"~a\" v)))))"))
