(task-entry (id "geometry/voronoi/voronoi-diagram") (skill geometry) (module voronoi) (tier 1) (difficulty 12222) (name voronoi-diagram) (type "") (description "") (notes ()) (section construction) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell)) (answer "(define (voronoi-diagram points) (if (< (length points) 3) (make-voronoi (list->vector points) '#() '() (make-vector (length points) '()) (make-vector (length points) #t)) (let* ((sites (list->vector points)) (n (vector-length sites)) (del-tri (delaunay-triangulate points)) (del-tris (triangulation-triangles del-tri)) (triangles (list->vector del-tris)) (num-tris (vector-length triangles)) (circumcenters (let ((v (make-vector num-tris))) (do ((i 0 (+ i 1))) ((>= i num-tris) v) (vector-set! v i (tri2-circumcenter (vector-ref triangles i)))))) (edge-adj (build-edge-adjacency triangles)) (site-tris (build-site-triangles sites triangles)) (edges (build-voronoi-edges triangles edge-adj sites)) (unbounded (find-unbounded-sites edge-adj sites)) (cells (let ((v (make-vector n '()))) (do ((i 0 (+ i 1))) ((>= i n) v) (vector-set! v i (build-cell (vector-ref sites i) (vector-ref site-tris i) circumcenters)))))) (make-voronoi sites circumcenters edges cells unbounded))))"))
