(task-entry (id "dataset/distractor/approx-equal?") (skill dataset) (module distractor) (tier 1) (difficulty 13415) (name approx-equal?) (type "") (description "") (notes ()) (section generation) (deps (\x27;prelude \x27;prng \x27;parameter \x27;sort)) (available (make-distractor-strategy distractor-strategy? distractor-strategy-name distractor-strategy-generator distractor-nearby distractor-sign-flip distractor-off-by-one distractor-double-half distractor-wrong-sign-convention distractor-order-swap distractor-random-choice distractor-formula-variant apply-distractor generate-distractors member-approx?)) (answer "(define (approx-equal? a b) (cond ((and (number? a) (number? b)) (< (abs (- a b)) (* 0.01 (max (abs a) (abs b) 1)))) (else (equal? a b))))"))
(task-entry (id "dataset/difficulty/difficulty-tier") (skill dataset) (module difficulty) (tier 1) (difficulty 13415) (name difficulty-tier) (type "") (description "") (notes ()) (section tiers) (deps (\x27;prelude)) (available (make-difficulty-vector difficulty-vec? dv-inference-depth dv-object-count dv-temporal-steps dv-visual-precision dv-formula-complexity inference-direct inference-derivative inference-latent inference-system classify-inference-depth difficulty-weights difficulty-score difficulty-score-default)) (answer "(define (difficulty-tier score) (cond ((< score 2.0) 'trivial) ((< score 4.0) 'easy) ((< score 6.0) 'medium) ((< score 8.0) 'hard) (else 'expert)))"))
