(task-entry (id "info/statistical-measures/k-divergence") (skill info) (module statistical-measures) (tier 1) (difficulty 11113) (name k-divergence) (type "(-> (List Real) (List Real) Real)") (description "K-divergence: symmetric measure based on harmonic mean") (notes ()) (section k-divergence) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared jeffreys-divergence alpha-divergence squared-hellinger-distance triangular-discrimination pearson-divergence neyman-divergence)) (answer "(define (k-divergence p q) (if (or (null? p) (null? q)) 0 (fold-left + 0 (map (lambda (pi qi) (let ((sum-pq (+ pi qi))) (cond ((<= pi 0) 0) ((<= sum-pq 0) +inf.0) (else (* pi (log2 (/ (* 2 pi) sum-pq))))))) p q))))"))
(task-entry (id "info/channel-capacity/dmc-capacity-symmetric") (skill info) (module channel-capacity) (tier 1) (difficulty 11113) (name dmc-capacity-symmetric) (type "(-> (List (List Real)) Real)") (description "Capacity of symmetric DMC (uniform input is optimal)") (notes ()) (section discrete-memoryless-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity awgn-capacity-db awgn-capacity-bandwidth snr-for-capacity dmc-mutual-information dmc-output-distribution dmc-joint-distribution)) (answer "(define (dmc-capacity-symmetric transition) (let* ((n-inputs (length transition)) (uniform (make-uniform-dist n-inputs))) (dmc-mutual-information transition uniform)))"))
(task-entry (id "info/rate-distortion/gaussian-distortion-rate") (skill info) (module rate-distortion) (tier 1) (difficulty 11113) (name gaussian-distortion-rate) (type "(-> Real Real Real)") (description "Distortion-rate function for Gaussian source") (notes ()) (section rate-distortion-functions) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse snr snr-db psnr mean variance gaussian-rate-distortion)) (answer "(define (gaussian-distortion-rate variance rate) (if (<= rate 0) variance (* variance (expt 2 (* -2 rate)))))"))
(task-entry (id "info/coding/huffman-decode-helper") (skill info) (module coding) (tier 1) (difficulty 11113) (name huffman-decode-helper) (type "(-> String Node Node (List Symbol) (List Symbol))") (description "") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree huffman-build-loop sort-by-prob huffman-codes huffman-codes-helper huffman-encode huffman-decode)) (answer "(define (huffman-decode-helper bits root current acc) (cond ((and (string=? bits \"\") (huffman-leaf? current)) (reverse (cons (huffman-symbol current) acc))) ((string=? bits \"\") (if (eq? current root) (reverse acc) (error \"huffman-decode\" \"incomplete code\"))) ((huffman-leaf? current) (huffman-decode-helper bits root root (cons (huffman-symbol current) acc))) (else (let* ((bit (string-ref bits 0)) (rest (substring bits 1 (string-length bits))) (children (huffman-children current)) (next (if (char=? bit #\\0) (car children) (cdr children)))) (huffman-decode-helper rest root next acc)))))"))
