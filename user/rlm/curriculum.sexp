(task-entry (id "algebra/tropical/tropical->adjacency") (skill algebra) (module tropical) (tier 0) (difficulty 324) (name tropical->adjacency) (type "") (description "") (notes ()) (section conversion-utilities) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add tropical-matrix-power tropical-matrix-closure tropical-eigenvalue tropical-critical-edges tropical-poly-eval newton-polygon trim-hull tropical-poly-roots adjacency->tropical)) (answer "(define (tropical->adjacency dist) (let* ((n (matrix-rows dist)) (data (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let ((idx (+ (* i n) j)) (val (matrix-ref dist i j))) (if (and (number? val) (finite? val)) (vector-set! data idx val) (vector-set! data idx 0))))) (list 'matrix n n data)))"))
