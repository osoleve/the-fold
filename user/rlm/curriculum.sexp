(task-entry (id "random/distributions/rejection-sampler") (skill random) (module distributions) (tier 1) (difficulty 12902) (name rejection-sampler) (type "(-> (State RNG a) (a -> (Or b #f)) (State RNG b))") (description "Rejection sampling: draw from proposal until try-accept returns non-#f") (notes ()) (section helpers) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log)) (answer "(define (rejection-sampler proposal try-accept) (make-state (lambda (gen) (let loop ((g gen)) (let* ((result (run-state proposal g)) (candidate (car result)) (g2 (cdr result)) (accepted (try-accept candidate))) (if accepted (cons accepted g2) (loop g2)))))))"))
