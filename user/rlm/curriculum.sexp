(task-entry (id "data/heap/heap-insert") (skill data) (module heap) (tier 0) (difficulty 1310) (name heap-insert) (type "(-> α Heap Heap)") (description "Insert element into min-heap.") (notes ("O(log n)")) (section min-heap-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge)) (answer "(define (heap-insert elem heap) (heap-merge (heap-node 1 elem heap-empty heap-empty) heap))"))
