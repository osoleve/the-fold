(task-entry (id "sim/ode-system/pendulum") (skill sim) (module ode-system) (tier 2) (difficulty 23319) (name pendulum) (type "(-> Number Any)") (description "Simple pendulum (nonlinear): d²θ/dt² = -g/L sin(θ). State: [angle, angular velocity]. Normalized with g/L = 1") (notes ()) (section standard-ode-systems) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (ode-system? ode-vector-field ode-dimension ode-autonomous? make-ode-system make-autonomous-ode make-nonautonomous-ode eval-vector-field eval-vector-field-batch make-flow-function vector-field-norm make-phase-space-grid compute-vector-field-grid exponential-growth harmonic-oscillator damped-oscillator lotka-volterra lorenz-system van-der-pol)) (answer "(define (pendulum g-over-l) (make-autonomous-ode (lambda (state) (let ((theta (vector-ref state 0)) (omega (vector-ref state 1))) (vector omega (- (* g-over-l (sin theta)))))) 2))"))
(task-entry (id "sim/stability/analyze-stability") (skill sim) (module stability) (tier 2) (difficulty 23319) (name analyze-stability) (type "(-> Any Any Number (Pair Symbol (List Complex)))") (description "Analyze stability of an equilibrium point") (notes ()) (section eigenvalue-based-stability-classification) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd \x27;complex \x27;ode-system)) (available (find-fixed-point-newton find-fixed-point-robust find-fixed-point-levenberg-marquardt matrix-add-diagonal solve-linear-system augment-matrix gaussian-eliminate-with-pivot find-pivot-row swap-rows! back-substitute is-fixed-point? refine-fixed-point compute-jacobian linearize-at-equilibrium matrix-invert-simple matrix-eigenvalues-2d matrix-dominant-eigenvalue power-iteration classify-stability-2d)) (answer "(define (analyze-stability sys equilibrium step-size) (let* ((jac (linearize-at-equilibrium sys equilibrium step-size)) (eigenvalues (matrix-eigenvalues-2d jac))) (cons (classify-stability-2d eigenvalues) eigenvalues)))"))
(task-entry (id "sim/chaos/is-chaotic?") (skill sim) (module chaos) (tier 2) (difficulty 23319) (name is-chaotic?) (type "(-> ODE Vec Number Nat Nat Number Boolean)") (description "Test if system exhibits chaos (positive largest Lyapunov exponent)") (notes ()) (section chaos-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;ode-system \x27;sort)) (available (rk4-step integrate-rk4 integrate-rk4-transient rossler-system chen-system chua-circuit thomas-attractor aizawa-system *min-norm* *fd-relative-step* *fd-absolute-step* finite-diff-step make-tangent-vector compute-jacobian-at rk4-variational-step rk4-variational-step-multi gram-schmidt-orthonormalize lyapunov-exponents largest-lyapunov-exponent)) (answer "(define (is-chaotic? sys state0 dt n-steps n-transient threshold) (> (largest-lyapunov-exponent sys state0 dt n-steps n-transient) threshold))"))
(task-entry (id "sim/bifurcation/solve-for-tangent-direction") (skill sim) (module bifurcation) (tier 2) (difficulty 23319) (name solve-for-tangent-direction) (type "(-> Matrix Vec (Option Vec))") (description "Solve J_x * v = -J_p for tangent direction") (notes ()) (section arclength-continuation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian)) (answer "(define (solve-for-tangent-direction jac-x jac-p) (let ((neg-jac-p (vec-scale -1.0 jac-p))) (solve-linear-system jac-x neg-jac-p)))"))
(task-entry (id "sim/attractor-render/render-spinning-attractor") (skill sim) (module attractor-render) (tier 2) (difficulty 23319) (name render-spinning-attractor) (type "(-> (List Vec) Nat Nat Number Nat (List String))") (description "Render N frames of spinning attractor (monochrome)") (notes ()) (section animation) (deps (\x27;prelude \x27;vec \x27;geometry \x27;chaos)) (available (attractor-ascii-ramp intensity->attractor-char rotate-x rotate-y rotate-z rotate-point project-orthographic project-perspective make-frame-buffer fb-width fb-height fb-chars fb-depths fb-index fb-set! fb-set-with-intensity! fb-to-string render-attractor render-attractor-colored)) (answer "(define (render-spinning-attractor trajectory width height scale n-frames) (let ((pi 3.14159265358979)) (map (lambda (i) (let* ((angle (* 2 pi (/ i n-frames))) (tilt 0.3)) (render-attractor trajectory width height scale tilt angle 0))) (iota n-frames))))"))
