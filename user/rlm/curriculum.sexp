(task-entry (id "numeric/affine/affine-chebyshev-approx") (skill numeric) (module affine) (tier 0) (difficulty 2529) (name affine-chebyshev-approx) (type "") (description "") (notes ()) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval affine->interval affine-radius affine-neg merge-terms affine-add affine-sub affine-scale affine-add-constant affine-mul affine-sqr affine-recip affine-div affine-sqrt affine-sqrt-positive *deriv-h* *bisection-tol* *bisection-max-iter* numerical-derivative find-deriv-inverse-bisection)) (answer "(define (affine-chebyshev-approx af f deriv-inverse convexity . clamp-lo-opt) (let* ((iv (affine->interval af)) (a-raw (interval-lo iv)) (a (if (pair? clamp-lo-opt) (max (car clamp-lo-opt) a-raw) a-raw)) (b (interval-hi iv)) (x0 (affine-center af)) (r (affine-radius af))) (cond ((< r 1e-15) (affine-constant (f x0))) (else (let* ((fa (f a)) (fb (f b)) (beta (/ (- fb fa) (- b a))) (alpha-secant (- fa (* beta a))) (x-tangent-raw (if deriv-inverse (deriv-inverse beta) (find-deriv-inverse-bisection f a b beta convexity))) (x-tangent (max a (min b x-tangent-raw))) (alpha-tangent (- (f x-tangent) (* beta x-tangent))) (alpha (/ (+ alpha-tangent alpha-secant) 2)) (delta-raw (/ (abs (- alpha-secant alpha-tangent)) 2)) (delta (+ delta-raw (* 1e-14 (max (abs fa) (abs fb))))) (terms (affine-terms af)) (center (+ alpha (* beta x0))) (linear-terms (map (lambda (t) (cons (car t) (* beta (cdr t)))) terms)) (error-term (if (< delta 1e-15) '() (list (cons (affine-fresh-noise-id!) delta))))) (make-affine center (append linear-terms error-term)))))))"))
(task-entry (id "numeric/fem/vec-add") (skill numeric) (module fem) (tier 0) (difficulty 2529) (name vec-add) (type "") (description "") (notes ()) (section sparse-cg) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes apply-dirichlet-bc! apply-dirichlet-penalty! *fem-tolerance* *fem-max-iterations* sparse-cg sparse-cg-loop sparse-csr-diagonal vec-div-pointwise sparse-pcg sparse-pcg-loop vec-dot)) (answer "(define (vec-add v1 v2) (let* ((n (vector-length v1)) (result (make-vector n 0.0))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (+ (vector-ref v1 i) (vector-ref v2 i))))))"))
