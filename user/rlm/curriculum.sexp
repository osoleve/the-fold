(task-entry (id "fp/proof-tactics/search-dfs") (skill fp) (module proof-tactics) (tier 1) (difficulty 10643) (name search-dfs) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;engine \x27;rewrite/laws)) (available (make-proof-goal proof-goal? goal-lhs goal-rhs goal-context goal-trivial? tactic-success tactic-failure tactic-success? tactic-failure? tactic-subgoals tactic-builder tactic-error tactic-refl tactic-sym tactic-trans tactic-rewrite tactic-topdown tactic-bottomup tactic-try *tactic-repeat-fuel* tactic-repeat fold-proofs tactic-then build-combined-proof take-n drop-n tactic-orelse tactic-id tactic-fail *auto-laws-base* *auto-law-categories* *auto-laws-extra* register-auto-law! register-auto-category! unregister-auto-category! auto-laws auto-laws-by-category *auto-laws* tactic-auto *search-max-depth* expr->key tactic-search)) (answer "(define (search-dfs current target ctx depth visited) (cond ((equal? current target) (tactic-success '() (lambda () (quasiquote (refl (unquote current)))))) ((<= depth 0) (tactic-failure (quasiquote (search-depth-exhausted (unquote current) (unquote target))))) ((hashtable-ref visited (expr->key current) #f) (tactic-failure (quasiquote (cycle-detected (unquote current))))) (else (hashtable-set! visited (expr->key current) #t) (let try-laws ((laws (all-laws))) (if (null? laws) (tactic-failure (quasiquote (search-failed (unquote current) (unquote target)))) (let* ((law (car laws)) (result (apply-rule law current))) (if (not result) (try-laws (cdr laws)) (let ((rewritten (car result)) (bindings (cdr result))) (let ((sub-result (search-dfs rewritten target ctx (- depth 1) visited))) (if (tactic-success? sub-result) (tactic-success '() (lambda () (quasiquote (trans (rewrite (unquote (rule-name law)) (unquote bindings)) (unquote ((tactic-builder sub-result))))))) (try-laws (cdr laws))))))))))))"))
