(task-entry (id "fp/cost-analysis/estimate-hof-work") (skill fp) (module cost-analysis) (tier 1) (difficulty 10617) (name estimate-hof-work) (type "(-> Symbol (List Expr) Nat Nat)") (description "Estimate work for higher-order functions.\nConsiders: base cost + list-expr cost + (estimated iterations * body cost)\nHandles both 2-arg HOFs (map, filter) and 3-arg HOFs (fold-left, fold-right).") (notes ()) (section work-estimation-engine) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost *form-costs* form-cost *estimate-work-fuel* estimate-work estimate-work-with-fuel estimate-let-work estimate-branch-work estimate-cond-work)) (answer "(define (estimate-hof-work hof args fuel) (let* ((base-cost (operation-cost hof)) (is-fold (memq hof '(fold-left fold-right foldl foldr))) (fn-arg (if (pair? args) (car args) #f)) (list-arg (cond (is-fold (if (and (pair? args) (pair? (cdr args)) (pair? (cddr args))) (caddr args) #f)) (else (if (and (pair? args) (pair? (cdr args))) (cadr args) #f)))) (init-cost (if (and is-fold (pair? args) (pair? (cdr args))) (estimate-work-with-fuel (cadr args) (- fuel 1)) 0)) (fn-body-cost (if fn-arg (estimate-work-with-fuel fn-arg (- fuel 1)) 5)) (list-expr-cost (if list-arg (estimate-work-with-fuel list-arg (- fuel 1)) 0)) (list-size-estimate (estimate-list-size list-arg)) (iteration-cost (* list-size-estimate fn-body-cost))) (+ base-cost init-cost list-expr-cost iteration-cost)))"))
(task-entry (id "fp/engine/repeat") (skill fp) (module engine) (tier 1) (difficulty 10617) (name repeat) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;rule \x27;trace \x27;rewrite/sexp-zipper)) (available (check-constraint match-pattern match-metavar substitute-template apply-rule apply-rule-name expr-at expr-set-at apply-rule-at find-all-positions apply-rule-anywhere id-strategy fail-strategy seq choice try *max-rewrite-fuel*)) (answer "(define repeat (case-lambda ((s) (repeat s *max-rewrite-fuel*)) ((s fuel) (lambda (expr) (let loop ((current expr) (remaining fuel)) (if (<= remaining 0) current (let ((result (s current))) (if (and result (not (equal? result current))) (loop result (- remaining 1)) current))))))))"))
