(task-entry (id "info/entropy/count-occurrences") (skill info) (module entropy) (tier 1) (difficulty 11124) (name count-occurrences) (type "(-> (List α) (List (Pair α Nat)))") (description "Count frequency of each unique element") (notes ()) (section entropy-estimation) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy conditional-entropy-direct mutual-information mutual-information-from-joint compute-marginal-x compute-marginal-y cross-entropy kl-divergence symmetric-kl jensen-shannon-divergence gaussian-entropy uniform-entropy exponential-entropy laplace-entropy sample-entropy)) (answer "(define (count-occurrences lst) (let loop ((remaining lst) (counts '())) (if (null? remaining) counts (let* ((item (car remaining)) (existing (assoc-helper item counts))) (if existing (loop (cdr remaining) (update-count item counts)) (loop (cdr remaining) (cons (cons item 1) counts)))))))"))
