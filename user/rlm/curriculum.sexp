(task-entry (id "algebra/group/klein-four-group") (skill algebra) (module group) (tier 0) (difficulty 353) (name klein-four-group) (type "(-> Group)") (description "The Klein four-group V₄ = Z₂ × Z₂") (notes ()) (section common-groups) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity dihedral-op dihedral-inverse make-dihedral-group D is-subgroup? generate-subgroup make-homomorphism homomorphism? homomorphism-source homomorphism-target homomorphism-mapping homomorphism-apply verify-homomorphism is-isomorphism? kernel image cayley-table trivial-group)) (answer "(define (klein-four-group) (let ((elements '(e a b c)) (table '((e e a b c) (a a e c b) (b b c e a) (c c b a e)))) (make-group elements (lambda (x y) (let ((i (index-of x elements)) (j (index-of y elements))) (list-ref (list-ref table (+ i 1)) (+ j 1)))) 'e (lambda (x) x) eq?)))"))
