(task-entry (id "tiles/pathfinding/pqueue-pop") (skill tiles) (module pathfinding) (tier 1) (difficulty 12303) (name pqueue-pop) (type "") (description "Remove and return minimum priority element") (notes ()) (section priority-queue) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert)) (answer "(define (pqueue-pop pq) (if (null? pq) (values #f #f #f) (values (cdar pq) (caar pq) (cdr pq))))"))
(task-entry (id "tiles/visibility/board-fov") (skill tiles) (module visibility) (tier 1) (difficulty 12303) (name board-fov) (type "(-> Board Coord Integer (-> Coord (List Coord)) (-> Coord Coord (List Coord)) (List Coord))") (description "Calculate field of view using board's vision-blocking tile property") (notes ()) (section field-of-view) (deps (\x27;tiles/core)) (available (has-line-of-sight? board-has-los? calculate-fov)) (answer "(define (board-fov board origin max-radius neighbor-fn line-fn) (calculate-fov board origin max-radius neighbor-fn line-fn (lambda (coord) (let ((tile (board-get board coord))) (and tile (tile-get-prop tile 'blocks-vision #f))))))"))
