(task-entry (id "dsl/partial-eval/pe-apply-primitive") (skill dsl) (module partial-eval) (tier 1) (difficulty 11735) (name pe-apply-primitive) (type "") (description "") (notes ()) (section binding-time-representation) (deps (\x27;prelude \x27;staging \x27;combinators)) (available (bt-static bt-dynamic bt-bottom bt? bt-join bt-meet bt<=? make-bt-env bt-env-extend bt-env-lookup bt-env-extend-many pe-primitive? bta bta-annotate make-static-store static-store-extend static-store-lookup static-store-has? static-store-shadow make-pe-state pe-state-limit pe-state-depth pe-state-memo pe-state-residuals pe-state-counter pe-state-incr-depth pe-state-decr-depth pe-state-can-unfold? pe-state-fresh-var pe-state-add-memo pe-state-lookup-memo pe-state-add-residual pe-online pe-online-list pe-static-value?)) (answer "(define (pe-apply-primitive op args) (case op ((+) (apply + args)) ((-) (apply - args)) ((*) (apply * args)) ((/) (if (zero? (cadr args)) (quasiquote (/ (unquote-splicing args))) (apply / args))) ((=) (apply = args)) ((<) (apply < args)) ((>) (apply > args)) ((<=) (apply <= args)) ((>=) (apply >= args)) ((eq?) (eq? (pe-unquote (car args)) (pe-unquote (cadr args)))) ((null?) (null? (pe-unquote (car args)))) ((car) (let ((lst (pe-unquote (car args)))) (if (pair? lst) (let ((result (car lst))) (if (or (symbol? result) (pair? result)) (quasiquote '(unquote result)) result)) (quasiquote (car (unquote-splicing args)))))) ((cdr) (let ((lst (pe-unquote (car args)))) (if (pair? lst) (quasiquote '(unquote (cdr lst))) (quasiquote (cdr (unquote-splicing args)))))) ((cons) (quasiquote '(unquote (cons (pe-unquote (car args)) (pe-unquote (cadr args)))))) ((list) (quasiquote '(unquote (map pe-unquote args)))) ((not) (not (pe-unquote (car args)))) ((zero?) (zero? (car args))) ((positive?) (positive? (car args))) ((negative?) (negative? (car args))) ((even?) (even? (car args))) ((odd?) (odd? (car args))) ((abs) (abs (car args))) ((min) (apply min args)) ((max) (apply max args)) ((modulo) (modulo (car args) (cadr args))) ((quotient) (quotient (car args) (cadr args))) ((remainder) (remainder (car args) (cadr args))) (else (quasiquote ((unquote op) (unquote-splicing args))))))"))
