(task-entry (id "data/quadtree/quadtree-try-merge") (skill data) (module quadtree) (tier 0) (difficulty 1348) (name quadtree-try-merge) (type "(-> Quadtree Quadtree)") (description "If all children are leaves and total points <= capacity, merge into single leaf") (notes ()) (section deletion) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build quadtree-build-auto list->quadtree quadtree-insert quadtree-insert-at-depth quadtree-split quadtree-range quadtree-range-rect quadtree-radius quadtree-nearest quadtree-nearest-rec bounds-min-dist-sq sort-by-bounds-dist quadtree-knn-pair-greater? quadtree-knn quadtree-knn-heap->list quadtree-knn-rec quadtree-size quadtree-depth quadtree-fold quadtree->list quadtree-delete quadtree-delete-if delete-first-matching)) (answer "(define (quadtree-try-merge tree) (if (not (quadtree-node? tree)) tree (let ((ne (quadtree-ne tree)) (nw (quadtree-nw tree)) (se (quadtree-se tree)) (sw (quadtree-sw tree))) (if (and (quadtree-leaf? ne) (quadtree-leaf? nw) (quadtree-leaf? se) (quadtree-leaf? sw)) (let ((total-points (+ (length (quadtree-leaf-points ne)) (length (quadtree-leaf-points nw)) (length (quadtree-leaf-points se)) (length (quadtree-leaf-points sw))))) (if (<= total-points *quadtree-capacity*) (quadtree-leaf (quadtree-bounds tree) (append (quadtree-leaf-points ne) (quadtree-leaf-points nw) (quadtree-leaf-points se) (quadtree-leaf-points sw))) tree)) tree))))"))
