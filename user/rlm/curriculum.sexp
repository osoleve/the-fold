(task-entry (id "geometry/convex-hull/point-line-distance") (skill geometry) (module convex-hull) (tier 1) (difficulty 12209) (name point-line-distance) (type "") (description "") (notes ()) (section quickhull) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan)) (answer "(define (point-line-distance p a b) (let ((dx (- (point2-x b) (point2-x a))) (dy (- (point2-y b) (point2-y a))) (px (- (point2-x p) (point2-x a))) (py (- (point2-y p) (point2-y a)))) (/ (- (* dx py) (* dy px)) (sqrt (+ (* dx dx) (* dy dy))))))"))
