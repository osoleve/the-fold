(task-entry (id "geometry/voronoi/intersect-line-bisector") (skill geometry) (module voronoi) (tier 1) (difficulty 12243) (name intersect-line-bisector) (type "") (description "") (notes ()) (section bounded) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell voronoi-diagram find-unbounded-sites build-voronoi-edges edge-key->points find-site-index voronoi-cell-polygon voronoi-cell-centroid voronoi-neighbors voronoi-nearest-site point2-distance-sq clip-polygon-to-rect clip-to-halfplane intersect-vertical intersect-horizontal voronoi-bounded voronoi-bounded? voronoi-bounded-sites voronoi-bounded-cells voronoi-bounded-cell compute-bounded-cell clip-to-bisector)) (answer "(define (intersect-line-bisector p1 p2 site neighbor) (let* ((mx (/ (+ (point2-x site) (point2-x neighbor)) 2)) (my (/ (+ (point2-y site) (point2-y neighbor)) 2)) (nx (- (point2-y neighbor) (point2-y site))) (ny (- (point2-x site) (point2-x neighbor))) (dx (- (point2-x p2) (point2-x p1))) (dy (- (point2-y p2) (point2-y p1))) (snx (- (point2-x neighbor) (point2-x site))) (sny (- (point2-y neighbor) (point2-y site))) (denom (+ (* dx snx) (* dy sny)))) (if (< (abs denom) 1e-10) (make-point2 mx my) (let* ((num (+ (* (- mx (point2-x p1)) snx) (* (- my (point2-y p1)) sny))) (t (/ num denom))) (make-point2 (+ (point2-x p1) (* t dx)) (+ (point2-y p1) (* t dy)))))))"))
