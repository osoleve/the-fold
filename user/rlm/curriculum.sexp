(task-entry (id "algebra/group/is-isomorphism?") (skill algebra) (module group) (tier 0) (difficulty 348) (name is-isomorphism?) (type "(-> Homomorphism Boolean)") (description "Check if a homomorphism is an isomorphism (bijective)") (notes ()) (section group-homomorphisms) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity dihedral-op dihedral-inverse make-dihedral-group D is-subgroup? generate-subgroup make-homomorphism homomorphism? homomorphism-source homomorphism-target homomorphism-mapping homomorphism-apply verify-homomorphism)) (answer "(define (is-isomorphism? h) (and (verify-homomorphism h) (let* ((source (homomorphism-source h)) (target (homomorphism-target h)) (phi (homomorphism-mapping h)) (source-elems (group-elements source)) (target-elems (group-elements target)) (eq? (group-equal-fn target)) (images (map phi source-elems))) (and (= (length source-elems) (length target-elems)) (let loop ((imgs images)) (if (null? imgs) #t (if (ormap (lambda (x) (eq? x (car imgs))) (cdr imgs)) #f (loop (cdr imgs))))) (let loop ((targets target-elems)) (if (null? targets) #t (if (ormap (lambda (x) (eq? x (car targets))) images) (loop (cdr targets)) #f)))))))"))
