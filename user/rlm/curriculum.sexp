(task-entry (id "algebra/multivariate/mpoly-normalize") (skill algebra) (module multivariate) (tier 0) (difficulty 330) (name mpoly-normalize) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms)) (answer "(define (mpoly-normalize F ordering terms) (let* ((zero (field-zero F)) (eq-fn (field-equal-fn F)) (add (field-add-op F)) (combined (mpoly-combine-terms terms add eq-fn zero)) (nonzero (filter (lambda (t) (not (eq-fn (car t) zero))) combined)) (sorted (sort-by (lambda (t1 t2) (> (ordering (cdr t1) (cdr t2)) 0)) nonzero))) (if (null? sorted) (list (cons zero (mono-one))) sorted)))"))
