(task-entry (id "geometry/mesh-sdf/ensure-edge-midpoint-by-id!") (skill geometry) (module mesh-sdf) (tier 1) (difficulty 12212) (name ensure-edge-midpoint-by-id!) (type "") (description "") (notes ()) (section mesh-construction-helpers) (deps (\x27;prelude \x27;geometry \x27;bvh)) (available (make-mesh mesh? mesh-triangles mesh-bvh mesh-sdf mesh-sdf-gradient make-mesh-cube subdivide-icosphere-triangles subdivide-icosphere-once vec3-edge-key vec3-coords<? edge-id-key)) (answer "(define (ensure-edge-midpoint-by-id! table v0 v1 radius id0 id1) (let ((key (edge-id-key id0 id1))) (or (hashtable-ref table key #f) (let* ((mid (vec3-scale (vec3-add v0 v1) 0.5)) (mid-norm (vec3-scale (vec3-normalize mid) radius))) (hashtable-set! table key mid-norm) mid-norm))))"))
(task-entry (id "geometry/mesh-gen/location-bary") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12212) (name location-bary) (type "") (description "") (notes ()) (section triangulation) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location location? location-triangle)) (answer "(define (location-bary loc) (vector (vector-ref loc 2) (vector-ref loc 3) (vector-ref loc 4)))"))
(task-entry (id "geometry/mesh-topology/edge-key") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12212) (name edge-key) (type "") (description "") (notes ()) (section genus-computation) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex mesh-betti-numbers mesh-euler-characteristic mesh-f-vector mesh-connected-components mesh-genus mesh-edge-counts)) (answer "(define (edge-key i j) (if (< i j) (cons i j) (cons j i)))"))
(task-entry (id "geometry/convex-hull/find-furthest-from-line") (skill geometry) (module convex-hull) (tier 1) (difficulty 12212) (name find-furthest-from-line) (type "") (description "") (notes ()) (section quickhull) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line)) (answer "(define (find-furthest-from-line points a b) (let ((dx (- (point2-x b) (point2-x a))) (dy (- (point2-y b) (point2-y a)))) (fold-left (lambda (best p) (let ((cross-best (abs (- (* dx (- (point2-y best) (point2-y a))) (* dy (- (point2-x best) (point2-x a)))))) (cross-p (abs (- (* dx (- (point2-y p) (point2-y a))) (* dy (- (point2-x p) (point2-x a))))))) (if (> cross-p cross-best) p best))) (car points) (cdr points))))"))
