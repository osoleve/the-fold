(task-entry (id "fp/rule/make-rule") (skill fp) (module rule) (tier 1) (difficulty 10601) (name make-rule) (type "(-> Symbol Pattern Template Options Rule)") (description "Create a rewrite rule.\nOptions:\n  'category sym  - Rule category (default: 'custom)\n  'direction sym - Rule direction (default: 'forward)\n  'conditions ls - Side conditions (default: '())") (notes ()) (section rule-construction) (deps (\x27;prelude)) (available (get-opt)) (answer "(define (make-rule name lhs rhs . opts) (quasiquote ((name unquote name) (lhs unquote lhs) (rhs unquote rhs) (category unquote (get-opt opts 'category 'custom)) (direction unquote (get-opt opts 'direction 'forward)) (conditions unquote (get-opt opts 'conditions '())))))"))
(task-entry (id "fp/engine/match-pattern") (skill fp) (module engine) (tier 1) (difficulty 10601) (name match-pattern) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;rule \x27;trace \x27;rewrite/sexp-zipper)) (available (check-constraint)) (answer "(define (match-pattern pattern expr env) (cond ((metavar? pattern) (match-metavar pattern expr env)) ((and (pair? pattern) (pair? expr)) (let ((car-env (match-pattern (car pattern) (car expr) env))) (and car-env (match-pattern (cdr pattern) (cdr expr) car-env)))) ((and (null? pattern) (null? expr)) env) ((equal? pattern expr) env) (else #f)))"))
