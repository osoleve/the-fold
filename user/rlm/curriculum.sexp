(task-entry (id "autodiff/differentiable-signal/diff-convolution") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12713) (name diff-convolution) (type "(-> (Vector Number) (Vector Number) Symbol (-> (Vector Number) Number) (Values (Vector Number) (Vector Number)))") (description "Compute gradients w.r.t. both signal and kernel through convolution") (notes ()) (section high-level-operations) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real make-dft-re-local-grads make-dft-im-local-grads diff-dft)) (answer "(define (diff-convolution signal kernel mode loss-fn) (let* ((output (convolve signal kernel mode)) (m (vector-length output)) (kernel-len (vector-length kernel)) (eps 1e-7) (grad-output (make-vector m)) (loss-0 (loss-fn output))) (do ((i 0 (+ i 1))) ((= i m)) (let* ((output+ (vector-copy output)) (_ (vector-set! output+ i (+ (vector-ref output i) eps))) (loss+ (loss-fn output+)) (grad-i (/ (- loss+ loss-0) eps))) (vector-set! grad-output i grad-i))) (values (convolve-vjp-signal grad-output kernel mode) (convolve-vjp-kernel grad-output signal mode kernel-len))))"))
