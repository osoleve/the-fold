(task-entry (id "physics-problems/simulation/get-entity-radius") (skill physics-problems) (module simulation) (tier 2) (difficulty 23626) (name get-entity-radius) (type "") (description "") (notes ()) (section state-extraction) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static make-box make-ground setup-problem-world setup-no-gravity-world setup-gravity-world simulate-step simulate-n-steps simulate-frames make-problem-renderer render-world-frame render-frames capture-frames capture-frames-with-final get-entity-position get-entity-velocity)) (answer "(define (get-entity-radius world id) (let ((entity (world-get-entity world id))) (if entity (let ((shape (entity-shape entity))) (if (circle? shape) (circle-radius shape) (error 'get-entity-radius \"Entity is not a circle\" id))) (error 'get-entity-radius \"Entity not found\" id))))"))
