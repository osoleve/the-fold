(task-entry (id "numeric/affine/affine-recip") (skill numeric) (module affine) (tier 0) (difficulty 2520) (name affine-recip) (type "") (description "") (notes ()) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval affine->interval affine-radius affine-neg merge-terms affine-add affine-sub affine-scale affine-add-constant affine-mul affine-sqr)) (answer "(define (affine-recip af) (let* ((iv (affine->interval af)) (a (interval-lo iv)) (b (interval-hi iv))) (cond ((and (<= a 0) (>= b 0)) 'division-by-zero) (else (let* ((x0 (affine-center af)) (r (affine-radius af))) (cond ((< r 1e-15) (affine-constant (/ 1 x0))) (else (let* ((recip-a (/ 1 a)) (recip-b (/ 1 b)) (recip-x0 (/ 1 x0)) (deriv (/ -1 (* x0 x0))) (linear-lo (+ recip-x0 (* deriv (- a x0)))) (linear-hi (+ recip-x0 (* deriv (- b x0)))) (err-lo (- recip-a linear-lo)) (err-hi (- recip-b linear-hi)) (max-err (max (abs err-lo) (abs err-hi))) (terms (affine-terms af)) (linear-terms (map (lambda (t) (cons (car t) (* deriv (cdr t)))) terms)) (error-term (if (< max-err 1e-15) '() (list (cons (affine-fresh-noise-id!) max-err))))) (make-affine recip-x0 (append linear-terms error-term))))))))))"))
