(task-entry (id "autodiff/traced-optics/optic-gradient-list") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12707) (name optic-gradient-list) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value untrace-value lift-at-optic traversal-over-indexed optic-gradient extract-gradient zero-like)) (answer "(define (optic-gradient-list loss-fn trav s) (with-fresh-ad-scope (lambda () (let ((tape (make-reverse-tape))) (let-values (((s-traced traced-focuses) (lift-at-optic trav s tape))) (let ((loss (loss-fn s-traced))) (if (traced? loss) (let ((grads (backward tape (traced-id loss) 1))) (map (lambda (tf) (extract-gradient tf grads)) traced-focuses)) (map zero-like traced-focuses))))))))"))
(task-entry (id "autodiff/higher-order-diff/jvp") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12708) (name jvp) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp)) (answer "(define (jvp f args v) (let* ((dual-args (map (lambda (x dx) (dual x dx)) args v)) (outputs (apply f dual-args))) (if (or (dual? outputs) (not (list? outputs))) (list (dual-deriv outputs)) (map dual-deriv outputs))))"))
