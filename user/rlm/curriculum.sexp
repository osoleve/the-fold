(task-entry (id "data/set/set-union") (skill data) (module set) (tier 0) (difficulty 1305) (name set-union) (type "(-> Set Set Set)") (description "Union of two sets") (notes ()) (section none) (deps (\x27;prelude)) (available (set-empty set-empty? set-member? set-add set-remove)) (answer "(define (set-union set1 set2) (let loop ((remaining set1) (result set2)) (if (null? remaining) result (loop (cdr remaining) (set-add (car remaining) result)))))"))
(task-entry (id "data/dict/dict-dissoc") (skill data) (module dict) (tier 0) (difficulty 1305) (name dict-dissoc) (type "(-> κ Dict Dict)") (description "Remove key from dictionary") (notes ()) (section none) (deps (\x27;prelude)) (available (dict-empty dict-empty? dict-lookup dict-has-key? dict-assoc)) (answer "(define (dict-dissoc key dict) (let loop ((remaining dict) (acc '())) (cond ((null? remaining) (reverse acc)) ((equal? key (car (car remaining))) (append (reverse acc) (cdr remaining))) (else (loop (cdr remaining) (cons (car remaining) acc))))))"))
(task-entry (id "data/collection-utils/filter-collection") (skill data) (module collection-utils) (tier 0) (difficulty 1305) (name filter-collection) (type "(-> FSCap (-> Block Boolean) Block (List Block))") (description "Filter collection members by predicate. Returns list of blocks that match predicate") (notes ()) (section higher-order-collection-functions) (deps (\x27;block \x27;sha256)) (available (foldr collection-hashes collection-size collection-empty? map-collection)) (answer "(define (filter-collection fs predicate collection) (let ((hashes (collection-hashes collection))) (filter (lambda (b) b) (map (lambda (h) (let ((block (fs-fetch fs h))) (if (and block (predicate block)) block #f))) hashes))))"))
