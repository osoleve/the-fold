(task-entry (id "diffgeo/tangent/lie-bracket") (skill diffgeo) (module tangent) (tier 1) (difficulty 10756) (name lie-bracket) (type "") (description "") (notes ()) (section tangent-vector-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts)) (available (tangent-vector? tangent-vector-point tangent-vector-chart tangent-vector-components tangent-vector-dim make-tangent-vector tangent-zero tangent-basis-vector tangent-add tangent-sub tangent-scale tangent-negate tangent-change-chart cotangent-vector? cotangent-vector-point cotangent-vector-chart cotangent-vector-components cotangent-vector-dim make-cotangent-vector cotangent-zero cotangent-basis-form cotangent-add cotangent-sub cotangent-scale cotangent-negate covector-apply cotangent-change-chart pushforward pullback-at tangent-space? tangent-space-point tangent-space-chart tangent-space-dim make-tangent-space tangent-space-basis tangent-space-vector cotangent-space? cotangent-space-point cotangent-space-chart cotangent-space-dim make-cotangent-space cotangent-space-basis cotangent-space-form tangent-bundle? tangent-bundle-atlas make-tangent-bundle tangent-bundle-dim tangent-bundle-fiber tangent-bundle-section cotangent-bundle? cotangent-bundle-atlas make-cotangent-bundle cotangent-bundle-dim cotangent-bundle-fiber cotangent-bundle-section differential)) (answer "(define (lie-bracket X Y point chart . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *jacobian-epsilon* (car epsilon-arg))) (coords (chart-apply chart point)) (n (chart-dim chart)) (X-at-p (X point)) (Y-at-p (Y point)) (X-comps (tangent-vector-components (if (eq? (chart-name (tangent-vector-chart X-at-p)) (chart-name chart)) X-at-p (tangent-change-chart X-at-p chart)))) (Y-comps (tangent-vector-components (if (eq? (chart-name (tangent-vector-chart Y-at-p)) (chart-name chart)) Y-at-p (tangent-change-chart Y-at-p chart)))) (dX-matrix (make-vector n #f)) (dY-matrix (make-vector n #f)) (coords-plus (vec-copy coords)) (coords-minus (vec-copy coords)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((ci (vector-ref coords i))) (vector-set! coords-plus i (+ ci eps)) (vector-set! coords-minus i (- ci eps))) (let* ((p-plus (chart-apply-inverse chart coords-plus)) (p-minus (chart-apply-inverse chart coords-minus)) (X-plus (tangent-vector-components (X p-plus))) (X-minus (tangent-vector-components (X p-minus))) (Y-plus (tangent-vector-components (Y p-plus))) (Y-minus (tangent-vector-components (Y p-minus))) (inv-2eps (/ 1.0 (* 2 eps))) (dXi (make-vector n 0)) (dYi (make-vector n 0))) (do ((k 0 (+ k 1))) ((= k n)) (vector-set! dXi k (* inv-2eps (- (vector-ref X-plus k) (vector-ref X-minus k)))) (vector-set! dYi k (* inv-2eps (- (vector-ref Y-plus k) (vector-ref Y-minus k))))) (vector-set! dX-matrix i dXi) (vector-set! dY-matrix i dYi)) (let ((ci (vector-ref coords i))) (vector-set! coords-plus i ci) (vector-set! coords-minus i ci))) (do ((k 0 (+ k 1))) ((= k n)) (let ((bracket-k 0)) (do ((i 0 (+ i 1))) ((= i n)) (let ((Xi (vector-ref X-comps i)) (Yi (vector-ref Y-comps i)) (dYk-dxi (vector-ref (vector-ref dY-matrix i) k)) (dXk-dxi (vector-ref (vector-ref dX-matrix i) k))) (set! bracket-k (+ bracket-k (- (* Xi dYk-dxi) (* Yi dXk-dxi)))))) (vector-set! result k bracket-k))) (make-tangent-vector point chart result)))"))
(task-entry (id "diffgeo/lie-groups/se2-log") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10756) (name se2-log) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp so2-log so3? so3-matrix make-so3-from-matrix make-so3 so3-identity so3-compose so3-inverse so3-act so3-alg? so3-alg-vec make-so3-alg so3-hat so3-vee so3-alg-to-matrix so3-matrix-to-alg so3-exp so3-log so3-axis-angle se2? se2-rotation se2-translation make-se2 make-se2-from-angle se2-identity se2-to-matrix matrix-to-se2 se2-compose se2-inverse se2-act se2-alg? se2-alg-omega se2-alg-v make-se2-alg se2-alg-to-matrix se2-exp)) (answer "(define (se2-log g) (let* ((R (se2-rotation g)) (t (se2-translation g)) (theta (so2-angle R))) (if (< (abs theta) *lie-epsilon*) (make-se2-alg 0 t) (let* ((half-theta (/ theta 2)) (cot-half (/ (cos half-theta) (sin half-theta))) (factor (/ theta 2)) (Vi00 (* factor cot-half)) (Vi01 factor) (Vi10 (- factor)) (Vi11 (* factor cot-half)) (vx (+ (* Vi00 (vector-ref t 0)) (* Vi01 (vector-ref t 1)))) (vy (+ (* Vi10 (vector-ref t 0)) (* Vi11 (vector-ref t 1))))) (make-se2-alg theta (vector vx vy))))))"))
