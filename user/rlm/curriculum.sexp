(task-entry (id "geometry/mesh-gen/point-in-circumcircle?") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12227) (name point-in-circumcircle?) (type "") (description "") (notes ()) (section predicates) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location location? location-triangle location-bary point2-x point2-y vertex-key make-tri2 tri2? tri2-p1 tri2-p2 tri2-p3 tri2-points orient2d tri2-signed-area tri2-area tri2-circumcenter tri2-circumradius-sq)) (answer "(define (point-in-circumcircle? p tri) (let ((cc (tri2-circumcenter tri))) (if (not cc) #f (let* ((r2 (tri2-circumradius-sq tri)) (dx (- (point2-x p) (point2-x cc))) (dy (- (point2-y p) (point2-y cc))) (d2 (+ (* dx dx) (* dy dy)))) (< d2 r2)))))"))
(task-entry (id "geometry/mesh-topology/mesh-is-torus-topology?") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12227) (name mesh-is-torus-topology?) (type "") (description "") (notes ()) (section genus-computation) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex mesh-betti-numbers mesh-euler-characteristic mesh-f-vector mesh-connected-components mesh-genus mesh-edge-counts edge-key mesh-is-manifold? mesh-edges-are-manifold? mesh-vertices-are-manifold? vertex-link-edges list-member? unique-list count-components-uf build-index-map mesh-is-closed? mesh-boundary-edges mesh-non-manifold-edges mesh-topology-summary mesh-is-watertight? mesh-is-sphere-topology?)) (answer "(define (mesh-is-torus-topology? mesh) (let ((betti (mesh-betti-numbers mesh))) (and (= (length betti) 3) (= (car betti) 1) (= (cadr betti) 2) (= (caddr betti) 1) (= (mesh-euler-characteristic mesh) 0))))"))
(task-entry (id "geometry/convex-hull/build-polygon-from-edges") (skill geometry) (module convex-hull) (tier 1) (difficulty 12227) (name build-polygon-from-edges) (type "") (description "") (notes ()) (section minkowski) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line find-furthest-from-line quickhull-recurse quickhull convex-hull convex-hull-area convex-hull-perimeter point-in-convex-hull? convex-hull-centroid convex-hull-diameter extreme-point support-function minkowski-sum normalize-angle polygon-edges merge-edges-ccw)) (answer "(define (build-polygon-from-edges start edges) (let loop ((remaining edges) (current start) (result (list start))) (if (null? remaining) (reverse (cdr result)) (let* ((edge (car remaining)) (next (make-point2 (+ (point2-x current) (point2-x edge)) (+ (point2-y current) (point2-y edge))))) (loop (cdr remaining) next (cons next result))))))"))
(task-entry (id "geometry/voronoi/voronoi-cell-polygon") (skill geometry) (module voronoi) (tier 1) (difficulty 12227) (name voronoi-cell-polygon) (type "") (description "") (notes ()) (section queries) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell voronoi-diagram find-unbounded-sites build-voronoi-edges edge-key->points find-site-index)) (answer "(define (voronoi-cell-polygon vor site-idx) (if (voronoi-cell-unbounded? vor site-idx) '() (let* ((vertices (voronoi-vertices vor)) (cell (vector-ref (voronoi-cells vor) site-idx))) (if (or (null? cell) (exists (lambda (vi) (< vi 0)) cell)) '() (map (lambda (vi) (vector-ref vertices vi)) cell)))))"))
