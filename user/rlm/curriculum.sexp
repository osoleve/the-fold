(task-entry (id "linalg/matrix/matrix-map") (skill linalg) (module matrix) (tier 0) (difficulty 413) (name matrix-map) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose)) (answer "(define (matrix-map f m) (let* ((rows (matrix-rows m)) (cols (matrix-cols m)) (data (matrix-data m)) (n (* rows cols)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix rows cols result)) (vector-set! result i (f (vector-ref data i))))))"))
(task-entry (id "linalg/matrix-eigen/inverse-iteration") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 413) (name inverse-iteration) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift)) (answer "(define (inverse-iteration a lambda-approx . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (if (not (= n m)) (quasiquote (error not-square (unquote n) (unquote m))) (let* ((v0 (if (and (pair? opts) (vector? (car opts))) (car opts) (let ((v (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) (vec-normalize v)) (vector-set! v i (+ 1.0 (/ i (+ n 1.0)))))))) (rest1 (if (and (pair? opts) (vector? (car opts))) (cdr opts) opts)) (max-iter (if (and (pair? rest1) (integer? (car rest1))) (car rest1) 100)) (rest2 (if (and (pair? rest1) (integer? (car rest1))) (cdr rest1) rest1)) (tol (if (and (pair? rest2) (number? (car rest2))) (car rest2) *eigen-tolerance*)) (shifted (matrix-sub a (matrix-scale lambda-approx (matrix-identity n))))) (inverse-iteration-loop shifted v0 0 max-iter tol)))))"))
(task-entry (id "linalg/iterative-solvers/pcg-loop") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 413) (name pcg-loop) (type "") (description "") (notes ()) (section preconditioned-cg) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg)) (answer "(define (pcg-loop a b solve-precond x r z p rz iter max-iter tol n) (let ((r-norm (vec-norm r))) (cond ((< r-norm tol) (list x iter r-norm)) ((>= iter max-iter) (quasiquote (error no-convergence (unquote iter) (unquote r-norm)))) (else (let* ((ap (matrix-vec-mul a p)) (pap (vec-dot p ap))) (if (< (abs pap) *iterative-tolerance*) (quasiquote (error breakdown-pap-zero (unquote iter) (unquote pap))) (let* ((alpha (/ rz pap)) (x-new (vec-add x (vec-scale alpha p))) (r-new (vec-sub r (vec-scale alpha ap))) (z-new (solve-precond r-new)) (rz-new (vec-dot r-new z-new)) (beta (/ rz-new rz)) (p-new (vec-add z-new (vec-scale beta p)))) (pcg-loop a b solve-precond x-new r-new z-new p-new rz-new (+ iter 1) max-iter tol n))))))))"))
