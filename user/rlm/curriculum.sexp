(task-entry (id "linalg/matrix-eigen/symmetric-eigen-loop") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 417) (name symmetric-eigen-loop) (type "") (description "") (notes ()) (section symmetric-eigen) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop eigen-decomposition symmetric-eigen)) (answer "(define (symmetric-eigen-loop a q-accum iter max-iter tol) (if (>= iter max-iter) (cons (matrix-diagonal a) q-accum) (if (symmetric-converged? a tol) (cons (matrix-diagonal a) q-accum) (let ((qr-result (matrix-qr a))) (if (and (pair? qr-result) (eq? (car qr-result) 'error)) qr-result (let* ((q (car qr-result)) (r (cadr qr-result)) (a-new (matrix-mul r q)) (q-new (matrix-mul q-accum q))) (symmetric-eigen-loop a-new q-new (+ iter 1) max-iter tol)))))))"))
(task-entry (id "linalg/iterative-solvers/gmres-arnoldi-loop") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 417) (name gmres-arnoldi-loop) (type "") (description "") (notes ()) (section gmres) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres gmres-outer gmres-arnoldi)) (answer "(define (gmres-arnoldi-loop a h-data v-list g cs sn j k tol n x0 r0) (if (>= j k) (gmres-solve-update h-data v-list g j n x0) (let* ((vj (list-ref (reverse v-list) j)) (w (matrix-vec-mul a vj))) (let orth-loop ((i 0) (w-curr w)) (if (> i j) (let ((w-norm (vec-norm w-curr))) (let ((h-idx (+ (* (+ j 1) k) j))) (when (< h-idx (vector-length h-data)) (vector-set! h-data h-idx w-norm))) (if (< w-norm *iterative-tolerance*) (gmres-solve-update h-data v-list g (+ j 1) n x0) (let* ((vj+1 (vec-scale (/ 1.0 w-norm) w-curr)) (new-v-list (cons vj+1 v-list)) (_ (apply-givens-rotations h-data cs sn j k)) (h-jj-idx (+ (* j k) j)) (h-j1j-idx (+ (* (+ j 1) k) j)) (h-jj (vector-ref h-data h-jj-idx)) (h-j1j (vector-ref h-data h-j1j-idx)) (givens (compute-givens h-jj h-j1j)) (c (car givens)) (s (cdr givens)) (_ (vector-set! cs j c)) (_ (vector-set! sn j s)) (new-hjj (+ (* c h-jj) (* s h-j1j))) (_ (vector-set! h-data h-jj-idx new-hjj)) (_ (vector-set! h-data h-j1j-idx 0.0)) (g-j (vector-ref g j)) (g-j1 (vector-ref g (+ j 1))) (new-gj (+ (* c g-j) (* s g-j1))) (new-gj1 (+ (* (- s) g-j) (* c g-j1))) (_ (vector-set! g j new-gj)) (_ (vector-set! g (+ j 1) new-gj1)) (res (abs new-gj1))) (if (< res tol) (gmres-solve-update h-data new-v-list g (+ j 1) n x0) (gmres-arnoldi-loop a h-data new-v-list g cs sn (+ j 1) k tol n x0 r0))))) (let* ((vi (list-ref (reverse v-list) i)) (h-ij (vec-dot w-curr vi)) (h-idx (+ (* i k) j))) (when (< h-idx (vector-length h-data)) (vector-set! h-data h-idx h-ij)) (orth-loop (+ i 1) (vec-sub w-curr (vec-scale h-ij vi)))))))))"))
