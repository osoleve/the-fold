(task-entry (id "statistics/differencing/box-cox-inverse") (skill statistics) (module differencing) (tier 1) (difficulty 11213) (name box-cox-inverse) (type "") (description "") (notes ()) (section simple-differencing) (deps (\x27;prelude)) (available (vec-diff difference lag-diff seasonal-difference integrate integrate-from-last integrate-d is-stationary? vec-variance-simple subvec log-transform exp-transform box-cox)) (answer "(define (box-cox-inverse ys lambda) (let* ((n (vector-length ys)) (result (make-vector n))) (if (< (abs lambda) 1e-10) (exp-transform ys) (do ((i 0 (+ i 1))) ((= i n) result) (let ((y (vector-ref ys i))) (vector-set! result i (expt (+ 1 (* lambda y)) (/ 1 lambda))))))))"))
