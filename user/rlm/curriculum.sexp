(task-entry (id "optimization/optimize/suggest-method") (skill optimization) (module optimize) (tier 1) (difficulty 12809) (name suggest-method) (type "(-> Nat Boolean Boolean Symbol)") (description "Suggest optimization method based on problem characteristics") (notes ()) (section method-selection) (deps (\x27;prelude \x27;convergence \x27;line-search \x27;first-order \x27;newton \x27;lbfgs)) (available (minimize minimize-bounded find-learning-rate minimize-callback rosenbrock rosenbrock-traced sphere rastrigin beale)) (answer "(define (suggest-method n is-smooth is-convex) (cond ((and is-smooth is-convex (< n 100)) 'newton) ((and is-smooth (>= n 100)) 'lbfgs) (is-smooth 'lbfgs) (else 'adam)))"))
