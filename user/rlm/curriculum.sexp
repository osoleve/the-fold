(task-entry (id "autodiff/symbolic-diff/extract-coefficient") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12712) (name extract-coefficient) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms)) (answer "(define (extract-coefficient term) (cond ((num? term) (values (num-val term) (num 1))) ((and (product? term) (= (length (product-factors term)) 2) (num? (car (product-factors term)))) (values (num-val (car (product-factors term))) (cadr (product-factors term)))) ((and (difference? term) (not (diff-right term))) (let-values (((c b) (extract-coefficient (diff-left term)))) (values (- c) b))) (else (values 1 term))))"))
(task-entry (id "autodiff/interval-autodiff/make-interval-traced-var") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12712) (name make-interval-traced-var) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push!)) (answer "(define (make-interval-traced-var iv tape) (let ((id (interval-fresh-id))) (interval-traced iv id tape)))"))
(task-entry (id "autodiff/traced-optics/subtract-scaled") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12712) (name subtract-scaled) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value untrace-value lift-at-optic traversal-over-indexed optic-gradient extract-gradient zero-like optic-gradient-list optic-gradient-maybe grad-at optimize-at optimize-traversal)) (answer "(define (subtract-scaled value grad rate) (cond ((number? value) (- value (* rate grad))) ((vec2? value) (vec2 (- (vec2-x value) (* rate (vec2-x grad))) (- (vec2-y value) (* rate (vec2-y grad))))) ((list? value) (map (lambda (v g) (subtract-scaled v g rate)) value grad)) ((and (pair? value) (not (list? value))) (cons (subtract-scaled (car value) (car grad) rate) (subtract-scaled (cdr value) (cdr grad) rate))) (else value)))"))
