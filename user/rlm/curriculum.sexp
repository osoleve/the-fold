(task-entry (id "topology/homology/z2-matrix-zero") (skill topology) (module homology) (tier 1) (difficulty 11807) (name z2-matrix-zero) (type "(-> Integer Integer Z2Matrix)") (description "Create a zero matrix") (notes ()) (section z2-matrix-operations) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set!)) (answer "(define (z2-matrix-zero rows cols) (z2-matrix rows cols (make-vector (* rows cols) 0)))"))
(task-entry (id "topology/persistent/euclidean-distance") (skill topology) (module persistent) (tier 1) (difficulty 11807) (name euclidean-distance) (type "(-> Point Point Number)") (description "Euclidean distance between two points (represented as lists)") (notes ()) (section vietoris-rips) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size)) (answer "(define (euclidean-distance p1 p2) (sqrt (apply + (map (lambda (a b) (* (- a b) (- a b))) p1 p2))))"))
(task-entry (id "dsl/compose/verify-composition") (skill dsl) (module compose) (tier 1) (difficulty 11808) (name verify-composition) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap row-fmap-helper register-fmap make-functor-row functor-row? functor-row-functors functor-row-contains? functor-row-index functor-row-extend functor-row-union build-injection-path inject-by-index make-tagged-functor tagged-functor? tagged-functor-tag tagged-functor-value inject lit-f add-f neg-f arith-fmap get-f put-f state-f-fmap standard-fmap-registry lift-arith lift-state arith-state-row arith-state-fmap dsl-lit dsl-add dsl-get dsl-put free-arith-lit free-arith-add free-state-get free-state-put make-handler-stack handler-stack? handler-stack-handlers run-with-stack run-with-composed-stack push-handler pop-handler effect-row-handled effect-row-requires effect-row-satisfies eff-lift-row eff-restrict define-effect-handler combine-effect-handlers state+reader-handler state+writer-handler state+exception-handler empty-dict dict-singleton dict-from-list dict-concat make-interface interface? interface-name interface-operations dict-satisfies? assert-interface iface-expr iface-bool iface-cmp iface-cond iface-state interface-union make-interpreter interpreter? interpreter-name interpreter-make combine-interpreters make-transformer transformer? transformer-name transformer-apply chain-transformers with-logging-default logging-transformer memoizing-transformer extend-dsl restrict-dsl rename-dsl override-dsl tagless->free make-ast-dict expr-ast-dict tagless-program->free free->tagless make-term-interpreter term-interpret-with-handlers expr-interpret-handlers free-term->tagless interpret-arith-term run-tagless-with-effects make-effectful-dict with-logging-effects)) (answer "(define (verify-composition d interfaces) (let loop ((ifaces interfaces)) (or (null? ifaces) (and (dict-satisfies? d (car ifaces)) (loop (cdr ifaces))))))"))
(task-entry (id "topology/simplicial-complex/simplex-equal?") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11808) (name simplex-equal?) (type "(-> Simplex Simplex Boolean)") (description "Check if two simplices are equal (same vertices)") (notes ("Since vertices are sorted, we can use equal?")) (section simplex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty?)) (answer "(define (simplex-equal? s1 s2) (equal? (simplex-vertices s1) (simplex-vertices s2)))"))
(task-entry (id "topology/homology/z2-matrix-copy") (skill topology) (module homology) (tier 1) (difficulty 11808) (name z2-matrix-copy) (type "(-> Z2Matrix Z2Matrix)") (description "Create a copy of a matrix (for non-destructive operations)") (notes ()) (section z2-matrix-operations) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero)) (answer "(define (z2-matrix-copy m) (z2-matrix (z2-matrix-rows m) (z2-matrix-cols m) (vector-copy (z2-matrix-data m))))"))
(task-entry (id "topology/persistent/rips-filtration") (skill topology) (module persistent) (tier 1) (difficulty 11808) (name rips-filtration) (type "(-> (List Point) Integer Number (-> Point Point Number) Filtration)") (description "Build Vietoris-Rips filtration from point cloud") (notes ("Returns a filtration where each simplex has birth time = max pairwise distance" "Complexity: O(n^(d+1)) where n = #points, d = max-dim. Use max-dim ≤ 2 for large clouds")) (section vietoris-rips) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance)) (answer "(define (rips-filtration points max-dim max-epsilon distance-fn) (let* ((n (length points)) (point-vec (list->vector points)) (dist-matrix (build-distance-matrix point-vec n distance-fn)) (pairs (build-rips-pairs point-vec dist-matrix n max-dim max-epsilon))) (make-filtration pairs)))"))
(task-entry (id "dsl/compose/composition-report") (skill dsl) (module compose) (tier 1) (difficulty 11809) (name composition-report) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap row-fmap-helper register-fmap make-functor-row functor-row? functor-row-functors functor-row-contains? functor-row-index functor-row-extend functor-row-union build-injection-path inject-by-index make-tagged-functor tagged-functor? tagged-functor-tag tagged-functor-value inject lit-f add-f neg-f arith-fmap get-f put-f state-f-fmap standard-fmap-registry lift-arith lift-state arith-state-row arith-state-fmap dsl-lit dsl-add dsl-get dsl-put free-arith-lit free-arith-add free-state-get free-state-put make-handler-stack handler-stack? handler-stack-handlers run-with-stack run-with-composed-stack push-handler pop-handler effect-row-handled effect-row-requires effect-row-satisfies eff-lift-row eff-restrict define-effect-handler combine-effect-handlers state+reader-handler state+writer-handler state+exception-handler empty-dict dict-singleton dict-from-list dict-concat make-interface interface? interface-name interface-operations dict-satisfies? assert-interface iface-expr iface-bool iface-cmp iface-cond iface-state interface-union make-interpreter interpreter? interpreter-name interpreter-make combine-interpreters make-transformer transformer? transformer-name transformer-apply chain-transformers with-logging-default logging-transformer memoizing-transformer extend-dsl restrict-dsl rename-dsl override-dsl tagless->free make-ast-dict expr-ast-dict tagless-program->free free->tagless make-term-interpreter term-interpret-with-handlers expr-interpret-handlers free-term->tagless interpret-arith-term run-tagless-with-effects make-effectful-dict with-logging-effects verify-composition)) (answer "(define (composition-report d interfaces) (let ((results (map (lambda (iface) (list (interface-name iface) (dict-satisfies? d iface))) interfaces))) (apply string-append (map (lambda (r) (format \"~a: ~a\n\" (car r) (if (cadr r) \"satisfied\" \"MISSING\"))) results))))"))
(task-entry (id "topology/simplicial-complex/simplex-contains-vertex?") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11809) (name simplex-contains-vertex?) (type "(-> Simplex Vertex Boolean)") (description "Check if a simplex contains a specific vertex") (notes ()) (section simplex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal?)) (answer "(define (simplex-contains-vertex? s v) (set-member? v (simplex-vertices s)))"))
(task-entry (id "topology/homology/z2-matrix-swap-rows!") (skill topology) (module homology) (tier 1) (difficulty 11809) (name z2-matrix-swap-rows!) (type "(-> Z2Matrix Integer Integer Void)") (description "Swap two rows in place") (notes ()) (section z2-matrix-operations) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy)) (answer "(define (z2-matrix-swap-rows! m i j) (let ((cols (z2-matrix-cols m))) (do ((k 0 (+ k 1))) ((= k cols)) (let ((tmp (z2-matrix-ref m i k))) (z2-matrix-set! m i k (z2-matrix-ref m j k)) (z2-matrix-set! m j k tmp)))))"))
(task-entry (id "topology/persistent/build-distance-matrix") (skill topology) (module persistent) (tier 1) (difficulty 11809) (name build-distance-matrix) (type "(-> Vector Integer (-> α α Number) Vector)") (description "Build upper-triangular distance matrix") (notes ()) (section vietoris-rips) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration)) (answer "(define (build-distance-matrix points n distance-fn) (let ((matrix (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) matrix) (let ((row (make-vector n 0.0))) (do ((j (+ i 1) (+ j 1))) ((= j n)) (vector-set! row j (distance-fn (vector-ref points i) (vector-ref points j)))) (vector-set! matrix i row)))))"))
(task-entry (id "dsl/compose/arith-eval-interp") (skill dsl) (module compose) (tier 1) (difficulty 11810) (name arith-eval-interp) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap row-fmap-helper register-fmap make-functor-row functor-row? functor-row-functors functor-row-contains? functor-row-index functor-row-extend functor-row-union build-injection-path inject-by-index make-tagged-functor tagged-functor? tagged-functor-tag tagged-functor-value inject lit-f add-f neg-f arith-fmap get-f put-f state-f-fmap standard-fmap-registry lift-arith lift-state arith-state-row arith-state-fmap dsl-lit dsl-add dsl-get dsl-put free-arith-lit free-arith-add free-state-get free-state-put make-handler-stack handler-stack? handler-stack-handlers run-with-stack run-with-composed-stack push-handler pop-handler effect-row-handled effect-row-requires effect-row-satisfies eff-lift-row eff-restrict define-effect-handler combine-effect-handlers state+reader-handler state+writer-handler state+exception-handler empty-dict dict-singleton dict-from-list dict-concat make-interface interface? interface-name interface-operations dict-satisfies? assert-interface iface-expr iface-bool iface-cmp iface-cond iface-state interface-union make-interpreter interpreter? interpreter-name interpreter-make combine-interpreters make-transformer transformer? transformer-name transformer-apply chain-transformers with-logging-default logging-transformer memoizing-transformer extend-dsl restrict-dsl rename-dsl override-dsl tagless->free make-ast-dict expr-ast-dict tagless-program->free free->tagless make-term-interpreter term-interpret-with-handlers expr-interpret-handlers free-term->tagless interpret-arith-term run-tagless-with-effects make-effectful-dict with-logging-effects verify-composition composition-report)) (answer "(define arith-eval-interp (make-interpreter 'arith-eval (lambda () (make-expr-dict (lambda (n) n) (lambda (x y) (+ x y)) (lambda (x) (- x))))))"))
(task-entry (id "topology/simplicial-complex/simplex-face?") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11810) (name simplex-face?) (type "(-> Simplex Simplex Boolean)") (description "Check if s1 is a face of s2 (s1's vertices are a subset of s2's)") (notes ()) (section simplex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex?)) (answer "(define (simplex-face? s1 s2) (set-subset? (simplex-vertices s1) (simplex-vertices s2)))"))
(task-entry (id "topology/homology/z2-matrix-add-row!") (skill topology) (module homology) (tier 1) (difficulty 11810) (name z2-matrix-add-row!) (type "(-> Z2Matrix Integer Integer Void)") (description "Add row j to row i (mod 2), storing result in row i") (notes ()) (section z2-matrix-operations) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows!)) (answer "(define (z2-matrix-add-row! m i j) (let ((cols (z2-matrix-cols m))) (do ((k 0 (+ k 1))) ((= k cols)) (z2-matrix-set! m i k (+ (z2-matrix-ref m i k) (z2-matrix-ref m j k))))))"))
(task-entry (id "topology/persistent/dist-ref") (skill topology) (module persistent) (tier 1) (difficulty 11810) (name dist-ref) (type "(-> Vector Integer Integer Number)") (description "") (notes ()) (section vietoris-rips) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix)) (answer "(define (dist-ref matrix i j) (if (< i j) (vector-ref (vector-ref matrix i) j) (vector-ref (vector-ref matrix j) i)))"))
(task-entry (id "dsl/compose/arith-pretty-interp") (skill dsl) (module compose) (tier 1) (difficulty 11811) (name arith-pretty-interp) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap row-fmap-helper register-fmap make-functor-row functor-row? functor-row-functors functor-row-contains? functor-row-index functor-row-extend functor-row-union build-injection-path inject-by-index make-tagged-functor tagged-functor? tagged-functor-tag tagged-functor-value inject lit-f add-f neg-f arith-fmap get-f put-f state-f-fmap standard-fmap-registry lift-arith lift-state arith-state-row arith-state-fmap dsl-lit dsl-add dsl-get dsl-put free-arith-lit free-arith-add free-state-get free-state-put make-handler-stack handler-stack? handler-stack-handlers run-with-stack run-with-composed-stack push-handler pop-handler effect-row-handled effect-row-requires effect-row-satisfies eff-lift-row eff-restrict define-effect-handler combine-effect-handlers state+reader-handler state+writer-handler state+exception-handler empty-dict dict-singleton dict-from-list dict-concat make-interface interface? interface-name interface-operations dict-satisfies? assert-interface iface-expr iface-bool iface-cmp iface-cond iface-state interface-union make-interpreter interpreter? interpreter-name interpreter-make combine-interpreters make-transformer transformer? transformer-name transformer-apply chain-transformers with-logging-default logging-transformer memoizing-transformer extend-dsl restrict-dsl rename-dsl override-dsl tagless->free make-ast-dict expr-ast-dict tagless-program->free free->tagless make-term-interpreter term-interpret-with-handlers expr-interpret-handlers free-term->tagless interpret-arith-term run-tagless-with-effects make-effectful-dict with-logging-effects verify-composition composition-report arith-eval-interp)) (answer "(define arith-pretty-interp (make-interpreter 'arith-pretty (lambda () (make-expr-dict (lambda (n) (number->string n)) (lambda (x y) (string-append \"(\" x \" + \" y \")\")) (lambda (x) (string-append \"(-\" x \")\"))))))"))
(task-entry (id "topology/simplicial-complex/remove-at") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11811) (name remove-at) (type "(-> (List α) Integer (List α))") (description "Remove element at index i from list") (notes ()) (section face-enumeration) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face?)) (answer "(define (remove-at lst i) (let loop ((remaining lst) (idx 0) (acc '())) (cond ((null? remaining) (reverse acc)) ((= idx i) (loop (cdr remaining) (+ idx 1) acc)) (else (loop (cdr remaining) (+ idx 1) (cons (car remaining) acc))))))"))
(task-entry (id "topology/homology/z2-rank") (skill topology) (module homology) (tier 1) (difficulty 11811) (name z2-rank) (type "(-> Z2Matrix Integer)") (description "Compute the rank of a Z_2 matrix using Gaussian elimination") (notes ("This is the dimension of the image (column space)")) (section gaussian-elimination) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row!)) (answer "(define (z2-rank matrix) (let* ((m (z2-matrix-copy matrix)) (rows (z2-matrix-rows m)) (cols (z2-matrix-cols m))) (let loop ((pivot-row 0) (pivot-col 0)) (if (or (>= pivot-row rows) (>= pivot-col cols)) pivot-row (let find-pivot ((r pivot-row)) (cond ((>= r rows) (loop pivot-row (+ pivot-col 1))) ((= (z2-matrix-ref m r pivot-col) 1) (when (not (= r pivot-row)) (z2-matrix-swap-rows! m r pivot-row)) (do ((i 0 (+ i 1))) ((= i rows)) (when (and (not (= i pivot-row)) (= (z2-matrix-ref m i pivot-col) 1)) (z2-matrix-add-row! m i pivot-row))) (loop (+ pivot-row 1) (+ pivot-col 1))) (else (find-pivot (+ r 1)))))))))"))
(task-entry (id "topology/persistent/build-rips-pairs") (skill topology) (module persistent) (tier 1) (difficulty 11811) (name build-rips-pairs) (type "(-> Vector Vector Integer Integer Number (List (Pair Simplex Number)))") (description "Build all Rips simplices up to max-dim with birth times") (notes ("Uses recursive combination generation for arbitrary dimensions")) (section vietoris-rips) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref)) (answer "(define (build-rips-pairs points dist-matrix n max-dim max-epsilon) (let ((result '())) (do ((i 0 (+ i 1))) ((= i n)) (set! result (cons (cons (make-simplex (list i)) 0.0) result))) (do ((k 1 (+ k 1))) ((> k max-dim) result) (set! result (append result (rips-k-simplices dist-matrix n k max-epsilon))))))"))
(task-entry (id "dsl/compose/make-full-language-dict") (skill dsl) (module compose) (tier 1) (difficulty 11812) (name make-full-language-dict) (type "") (description "") (notes ()) (section functor-coproduct) (deps (\x27;prelude \x27;tagless \x27;free \x27;effects)) (available (inl inr inl? inr? from-inl from-inr coproduct-fmap make-coproduct-fmap make-row-fmap row-fmap-helper register-fmap make-functor-row functor-row? functor-row-functors functor-row-contains? functor-row-index functor-row-extend functor-row-union build-injection-path inject-by-index make-tagged-functor tagged-functor? tagged-functor-tag tagged-functor-value inject lit-f add-f neg-f arith-fmap get-f put-f state-f-fmap standard-fmap-registry lift-arith lift-state arith-state-row arith-state-fmap dsl-lit dsl-add dsl-get dsl-put free-arith-lit free-arith-add free-state-get free-state-put make-handler-stack handler-stack? handler-stack-handlers run-with-stack run-with-composed-stack push-handler pop-handler effect-row-handled effect-row-requires effect-row-satisfies eff-lift-row eff-restrict define-effect-handler combine-effect-handlers state+reader-handler state+writer-handler state+exception-handler empty-dict dict-singleton dict-from-list dict-concat make-interface interface? interface-name interface-operations dict-satisfies? assert-interface iface-expr iface-bool iface-cmp iface-cond iface-state interface-union make-interpreter interpreter? interpreter-name interpreter-make combine-interpreters make-transformer transformer? transformer-name transformer-apply chain-transformers with-logging-default logging-transformer memoizing-transformer extend-dsl restrict-dsl rename-dsl override-dsl tagless->free make-ast-dict expr-ast-dict tagless-program->free free->tagless make-term-interpreter term-interpret-with-handlers expr-interpret-handlers free-term->tagless interpret-arith-term run-tagless-with-effects make-effectful-dict with-logging-effects verify-composition composition-report arith-eval-interp arith-pretty-interp)) (answer "(define (make-full-language-dict mode) (case mode ((eval) (combine-interpreters (list arith-eval-interp))) ((pretty) (combine-interpreters (list arith-pretty-interp))) (else (error 'make-full-language-dict \"Unknown mode\" mode))))"))
(task-entry (id "topology/simplicial-complex/simplex-facets") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11812) (name simplex-facets) (type "(-> Simplex (List Simplex))") (description "Get all facets (codimension-1 faces) of a simplex") (notes ("Each facet is obtained by removing one vertex. Returns list of (dim-1)-simplices. A vertex (0-simplex) has no facets")) (section face-enumeration) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at)) (answer "(define (simplex-facets s) (let* ((verts (simplex-vertices s)) (n (length verts))) (if (<= n 1) '() (let loop ((i 0) (acc '())) (if (>= i n) (reverse acc) (loop (+ i 1) (cons (make-simplex (remove-at verts i)) acc)))))))"))
(task-entry (id "topology/homology/z2-nullity") (skill topology) (module homology) (tier 1) (difficulty 11812) (name z2-nullity) (type "(-> Z2Matrix Integer)") (description "Compute the nullity (dimension of kernel) of a Z_2 matrix") (notes ("nullity = cols - rank (by rank-nullity theorem)")) (section gaussian-elimination) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank)) (answer "(define (z2-nullity m) (- (z2-matrix-cols m) (z2-rank m)))"))
(task-entry (id "topology/persistent/rips-k-simplices") (skill topology) (module persistent) (tier 1) (difficulty 11812) (name rips-k-simplices) (type "(-> Vector Integer Integer Number (List (Pair Simplex Number)))") (description "Build all k-simplices (k+1 vertices) for Rips complex") (notes ()) (section vietoris-rips) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs)) (answer "(define (rips-k-simplices dist-matrix n k max-epsilon) (let ((result '())) (for-each-combination (iota n) (+ k 1) (lambda (vertices) (let ((max-d (max-pairwise-distance dist-matrix vertices))) (when (<= max-d max-epsilon) (set! result (cons (cons (make-simplex vertices) max-d) result)))))) result))"))
(task-entry (id "topology/simplicial-complex/simplex-faces-of-dim") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11813) (name simplex-faces-of-dim) (type "(-> Simplex Integer (List Simplex))") (description "Get all k-dimensional faces of a simplex") (notes ("A k-face has k+1 vertices")) (section face-enumeration) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets)) (answer "(define (simplex-faces-of-dim s k) (let ((verts (simplex-vertices s)) (needed (+ k 1))) (if (or (< k 0) (> needed (length verts))) '() (map make-simplex (combinations verts needed)))))"))
(task-entry (id "topology/homology/z2-rref") (skill topology) (module homology) (tier 1) (difficulty 11813) (name z2-rref) (type "(-> Z2Matrix (values Z2Matrix (List Integer)))") (description "Compute reduced row echelon form and return pivot columns") (notes ()) (section gaussian-elimination) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity)) (answer "(define (z2-rref matrix) (let* ((m (z2-matrix-copy matrix)) (rows (z2-matrix-rows m)) (cols (z2-matrix-cols m)) (pivots '())) (let loop ((pivot-row 0) (pivot-col 0)) (if (or (>= pivot-row rows) (>= pivot-col cols)) (values m (reverse pivots)) (let find-pivot ((r pivot-row)) (cond ((>= r rows) (loop pivot-row (+ pivot-col 1))) ((= (z2-matrix-ref m r pivot-col) 1) (when (not (= r pivot-row)) (z2-matrix-swap-rows! m r pivot-row)) (do ((i 0 (+ i 1))) ((= i rows)) (when (and (not (= i pivot-row)) (= (z2-matrix-ref m i pivot-col) 1)) (z2-matrix-add-row! m i pivot-row))) (set! pivots (cons pivot-col pivots)) (loop (+ pivot-row 1) (+ pivot-col 1))) (else (find-pivot (+ r 1)))))))))"))
(task-entry (id "topology/persistent/max-pairwise-distance") (skill topology) (module persistent) (tier 1) (difficulty 11813) (name max-pairwise-distance) (type "(-> Vector (List Integer) Number)") (description "Maximum pairwise distance among vertices (Rips diameter)") (notes ()) (section vietoris-rips) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices)) (answer "(define (max-pairwise-distance dist-matrix vertices) (let ((max-d 0.0)) (let loop-i ((vs vertices)) (unless (null? vs) (let ((i (car vs))) (let loop-j ((ws (cdr vs))) (unless (null? ws) (let ((j (car ws))) (set! max-d (max max-d (dist-ref dist-matrix i j))) (loop-j (cdr ws))))) (loop-i (cdr vs))))) max-d))"))
(task-entry (id "topology/simplicial-complex/combinations") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11814) (name combinations) (type "(-> (List α) Integer (List (List α)))") (description "Generate all k-combinations of elements from a list") (notes ()) (section face-enumeration) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim)) (answer "(define (combinations lst k) (cond ((= k 0) '(())) ((null? lst) '()) (else (append (map (lambda (c) (cons (car lst) c)) (combinations (cdr lst) (- k 1))) (combinations (cdr lst) k)))))"))
(task-entry (id "topology/homology/z2-null-space") (skill topology) (module homology) (tier 1) (difficulty 11814) (name z2-null-space) (type "(-> Z2Matrix (List (List Integer)))") (description "Compute a basis for the null space (kernel) of a Z_2 matrix") (notes ("Algorithm:\n  1. Reduce matrix to RREF, tracking pivot columns\n  2. Free columns (non-pivot) correspond to free variables\n  3. For each free column, construct a basis vector:\n     - Set free variable to 1, other free variables to 0\n     - Back-substitute to find pivot variable values from RREF" "For a 1-cycle in a graph, the null space basis vectors indicate which edges participate in the cycle")) (section gaussian-elimination) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref)) (answer "(define (z2-null-space matrix) (let-values (((rref pivots) (z2-rref matrix))) (let* ((cols (z2-matrix-cols matrix)) (pivot-set (list->hashtable-set pivots)) (free-cols (filter (lambda (c) (not (hashtable-set-member? pivot-set c))) (iota cols)))) (if (null? free-cols) '() (map (lambda (free-col) (z2-null-basis-vector rref pivots cols free-col)) free-cols)))))"))
(task-entry (id "topology/persistent/for-each-combination") (skill topology) (module persistent) (tier 1) (difficulty 11814) (name for-each-combination) (type "(-> (List α) Integer (-> (List α) Void) Void)") (description "Call proc on each k-combination of lst") (notes ()) (section vietoris-rips) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance)) (answer "(define (for-each-combination lst k proc) (when (>= (length lst) k) (if (= k 0) (proc '()) (if (= k (length lst)) (proc lst) (let ((first (car lst)) (rest (cdr lst))) (for-each-combination rest (- k 1) (lambda (combo) (proc (cons first combo)))) (for-each-combination rest k proc))))))"))
(task-entry (id "topology/simplicial-complex/simplex-all-faces") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11815) (name simplex-all-faces) (type "(-> Simplex (List Simplex))") (description "Get all faces of a simplex, including the simplex itself") (notes ("Ordered from dimension 0 up to the simplex's dimension")) (section face-enumeration) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations)) (answer "(define (simplex-all-faces s) (let ((d (simplex-dim s))) (append-map (lambda (k) (simplex-faces-of-dim s k)) (iota (+ d 1)))))"))
(task-entry (id "topology/homology/z2-null-basis-vector") (skill topology) (module homology) (tier 1) (difficulty 11815) (name z2-null-basis-vector) (type "(-> Z2Matrix (List Integer) Integer Integer (List Integer))") (description "Construct one null space basis vector for the given free column") (notes ("In RREF, for free column f, the basis vector has:\n  - v[f] = 1 (the free variable)\n  - v[p] = rref[row-of-p][f] for each pivot column p\n  - v[other-free] = 0")) (section gaussian-elimination) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space)) (answer "(define (z2-null-basis-vector rref pivots cols free-col) (let ((vec (make-vector cols 0))) (vector-set! vec free-col 1) (let loop ((ps pivots) (row 0)) (unless (null? ps) (let ((pivot-col (car ps))) (vector-set! vec pivot-col (z2-matrix-ref rref row free-col)) (loop (cdr ps) (+ row 1))))) (vector->list vec)))"))
(task-entry (id "topology/persistent/persistence-reduce") (skill topology) (module persistent) (tier 1) (difficulty 11815) (name persistence-reduce) (type "(-> Filtration PersistenceResult)") (description "Run the standard persistence algorithm") (notes ()) (section persistence-algorithm) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination)) (answer "(define (persistence-reduce filtration) (let* ((pairs (filtration-pairs filtration)) (n (length pairs)) (simplices (list->vector (map car pairs))) (birth-times (list->vector (map cdr pairs))) (simplex-to-idx (build-simplex-index simplices n)) (columns (build-boundary-columns simplices n simplex-to-idx)) (low (make-vector n -1)) (low-to-col (make-eqv-hashtable)) (paired (make-vector n #f)) (result-pairs '())) (do ((j 0 (+ j 1))) ((= j n)) (reduce-column! columns j low low-to-col) (let ((low-j (vector-ref low j))) (when (>= low-j 0) (vector-set! paired j #t) (vector-set! paired low-j #t) (set! result-pairs (cons (cons low-j j) result-pairs))))) (let ((essential (collect-essential simplices paired n))) (make-persistence-result (reverse result-pairs) essential birth-times simplices))))"))
(task-entry (id "topology/simplicial-complex/simplex-proper-faces") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11816) (name simplex-proper-faces) (type "(-> Simplex (List Simplex))") (description "Get all proper faces (faces excluding the simplex itself)") (notes ()) (section face-enumeration) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces)) (answer "(define (simplex-proper-faces s) (let ((d (simplex-dim s))) (if (< d 0) '() (append-map (lambda (k) (simplex-faces-of-dim s k)) (iota d)))))"))
(task-entry (id "topology/homology/list->hashtable-set") (skill topology) (module homology) (tier 1) (difficulty 11816) (name list->hashtable-set) (type "") (description "Helper: list->hashtable-set using hash table for O(1) membership") (notes ()) (section gaussian-elimination) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector)) (answer "(define (list->hashtable-set lst) (let ((ht (make-hashtable equal-hash equal?))) (for-each (lambda (x) (hashtable-set! ht x #t)) lst) ht))"))
(task-entry (id "topology/persistent/build-simplex-index") (skill topology) (module persistent) (tier 1) (difficulty 11816) (name build-simplex-index) (type "(-> Vector Integer HashTable)") (description "Map simplex vertices -> filtration index") (notes ()) (section persistence-algorithm) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce)) (answer "(define (build-simplex-index simplices n) (let ((table (make-hashtable equal-hash equal?))) (do ((i 0 (+ i 1))) ((= i n) table) (hashtable-set! table (simplex-vertices (vector-ref simplices i)) i))))"))
(task-entry (id "topology/simplicial-complex/sc-empty") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11817) (name sc-empty) (type "") (description "") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces)) (answer "(define sc-empty (list 'sc (vector) -1))"))
(task-entry (id "topology/homology/hashtable-set-member?") (skill topology) (module homology) (tier 1) (difficulty 11817) (name hashtable-set-member?) (type "") (description "Helper: hashtable-set-member?") (notes ()) (section gaussian-elimination) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set)) (answer "(define (hashtable-set-member? set x) (hashtable-ref set x #f))"))
(task-entry (id "topology/persistent/build-boundary-columns") (skill topology) (module persistent) (tier 1) (difficulty 11817) (name build-boundary-columns) (type "(-> Vector Integer HashTable Vector)") (description "Build boundary matrix as sparse columns (sorted index lists)") (notes ()) (section persistence-algorithm) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index)) (answer "(define (build-boundary-columns simplices n simplex-to-idx) (let ((columns (make-vector n '()))) (do ((j 0 (+ j 1))) ((= j n) columns) (let* ((s (vector-ref simplices j)) (facets (simplex-facets s)) (indices (filter-map (lambda (f) (hashtable-ref simplex-to-idx (simplex-vertices f) #f)) facets))) (vector-set! columns j (sort-by > indices))))))"))
(task-entry (id "topology/simplicial-complex/sc?") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11818) (name sc?) (type "(-> α Boolean)") (description "") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty)) (answer "(define (sc? x) (and (pair? x) (eq? (car x) 'sc)))"))
(task-entry (id "topology/homology/simplex-index") (skill topology) (module homology) (tier 1) (difficulty 11818) (name simplex-index) (type "(-> (List Simplex) Simplex (Or Integer #f))") (description "Find the index of a simplex in a list (for matrix indexing)") (notes ("O(n) linear scan - use build-simplex-index-table for bulk lookups")) (section boundary-matrices) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member?)) (answer "(define (simplex-index simplices s) (let loop ((remaining simplices) (idx 0)) (cond ((null? remaining) #f) ((simplex-equal? s (car remaining)) idx) (else (loop (cdr remaining) (+ idx 1))))))"))
(task-entry (id "topology/persistent/reduce-column!") (skill topology) (module persistent) (tier 1) (difficulty 11818) (name reduce-column!) (type "(-> Vector Integer Vector HashTable Void)") (description "Reduce column j until its low is unique or zero") (notes ()) (section persistence-algorithm) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns)) (answer "(define (reduce-column! columns j low low-to-col) (let loop () (let ((col-j (vector-ref columns j))) (if (null? col-j) (vector-set! low j -1) (let ((low-j (car col-j))) (let ((other (hashtable-ref low-to-col low-j #f))) (if other (begin (vector-set! columns j (symmetric-difference col-j (vector-ref columns other))) (loop)) (begin (vector-set! low j low-j) (hashtable-set! low-to-col low-j j)))))))))"))
(task-entry (id "topology/simplicial-complex/sc-simplices-by-dim") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11819) (name sc-simplices-by-dim) (type "(-> SC Vector)") (description "") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc?)) (answer "(define (sc-simplices-by-dim sc) (cadr sc))"))
(task-entry (id "topology/homology/build-simplex-index-table") (skill topology) (module homology) (tier 1) (difficulty 11819) (name build-simplex-index-table) (type "(-> (List Simplex) HashTable)") (description "Build a hash table mapping simplex vertices -> index for O(1) lookup") (notes ("Key is the sorted vertex list (canonical form)")) (section boundary-matrices) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index)) (answer "(define (build-simplex-index-table simplices) (let ((table (make-hashtable equal-hash equal?))) (let loop ((remaining simplices) (idx 0)) (unless (null? remaining) (hashtable-set! table (simplex-vertices (car remaining)) idx) (loop (cdr remaining) (+ idx 1)))) table))"))
(task-entry (id "topology/persistent/symmetric-difference") (skill topology) (module persistent) (tier 1) (difficulty 11819) (name symmetric-difference) (type "(-> (List Integer) (List Integer) (List Integer))") (description "XOR of two sorted descending lists (Z_2 addition)") (notes ()) (section persistence-algorithm) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column!)) (answer "(define (symmetric-difference lst1 lst2) (let loop ((l1 lst1) (l2 lst2) (acc '())) (cond ((null? l1) (append (reverse acc) l2)) ((null? l2) (append (reverse acc) l1)) ((= (car l1) (car l2)) (loop (cdr l1) (cdr l2) acc)) ((> (car l1) (car l2)) (loop (cdr l1) l2 (cons (car l1) acc))) (else (loop l1 (cdr l2) (cons (car l2) acc))))))"))
(task-entry (id "topology/simplicial-complex/sc-max-dim") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11820) (name sc-max-dim) (type "(-> SC Integer)") (description "") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim)) (answer "(define (sc-max-dim sc) (caddr sc))"))
(task-entry (id "topology/homology/simplex-index-fast") (skill topology) (module homology) (tier 1) (difficulty 11820) (name simplex-index-fast) (type "(-> HashTable Simplex (Or Integer #f))") (description "O(1) lookup using pre-built index table") (notes ()) (section boundary-matrices) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table)) (answer "(define (simplex-index-fast table s) (hashtable-ref table (simplex-vertices s) #f))"))
(task-entry (id "topology/persistent/collect-essential") (skill topology) (module persistent) (tier 1) (difficulty 11820) (name collect-essential) (type "(-> Vector Vector Integer (List (List Integer)))") (description "Collect unpaired simplices grouped by dimension") (notes ()) (section persistence-algorithm) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference)) (answer "(define (collect-essential simplices paired n) (let ((by-dim (make-eqv-hashtable))) (do ((i 0 (+ i 1))) ((= i n)) (unless (vector-ref paired i) (let* ((s (vector-ref simplices i)) (d (simplex-dim s)) (existing (hashtable-ref by-dim d '()))) (hashtable-set! by-dim d (cons i existing))))) (let ((dims (sort-by < (hashtable-keys-list by-dim)))) (map (lambda (d) (cons d (reverse (hashtable-ref by-dim d '())))) dims))))"))
(task-entry (id "topology/simplicial-complex/sc-ensure-dim") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11821) (name sc-ensure-dim) (type "(-> SC Integer SC)") (description "Ensure the complex has room for simplices of given dimension") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim)) (answer "(define (sc-ensure-dim sc dim) (let* ((vec (sc-simplices-by-dim sc)) (current-len (vector-length vec))) (if (< dim current-len) sc (let* ((new-len (+ dim 1)) (new-vec (make-vector new-len '()))) (let loop ((i 0)) (when (< i current-len) (vector-set! new-vec i (vector-ref vec i)) (loop (+ i 1)))) (list 'sc new-vec (max (sc-max-dim sc) dim))))))"))
(task-entry (id "topology/homology/sc-boundary-matrix") (skill topology) (module homology) (tier 1) (difficulty 11821) (name sc-boundary-matrix) (type "(-> SC Integer Z2Matrix)") (description "Build the k-th boundary matrix d_k : C_k -> C_{k-1}") (notes ("Rows = (k-1)-simplices (codomain basis)\nCols = k-simplices (domain basis)\nEntry (i,j) = 1 if sigma_i is a facet of tau_j\n\nFor Z_2 coefficients, we ignore signs (+/-1 = 1 mod 2)" "O(N * k) where N = number of k-simplices, k = simplex dimension. Uses hash table for O(1) facet index lookups")) (section boundary-matrices) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast)) (answer "(define (sc-boundary-matrix sc k) (let* ((domain (sc-simplices-dim sc k)) (codomain (sc-simplices-dim sc (- k 1))) (num-rows (length codomain)) (num-cols (length domain))) (if (or (= num-rows 0) (= num-cols 0)) (z2-matrix-zero num-rows num-cols) (let ((mat (z2-matrix-zero num-rows num-cols)) (codomain-index (build-simplex-index-table codomain))) (let col-loop ((dom domain) (j 0)) (if (null? dom) mat (let* ((tau (car dom)) (facets (simplex-facets tau))) (for-each (lambda (sigma) (let ((i (simplex-index-fast codomain-index sigma))) (when i (z2-matrix-set! mat i j 1)))) facets) (col-loop (cdr dom) (+ j 1)))))))))"))
(task-entry (id "topology/persistent/hashtable-keys-list") (skill topology) (module persistent) (tier 1) (difficulty 11821) (name hashtable-keys-list) (type "(-> HashTable (List α))") (description "") (notes ()) (section persistence-algorithm) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential)) (answer "(define (hashtable-keys-list ht) (let-values (((keys vals) (hashtable-entries ht))) (vector->list keys)))"))
(task-entry (id "topology/simplicial-complex/sc-add-simplex-only") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11822) (name sc-add-simplex-only) (type "(-> SC Simplex SC)") (description "Add a simplex WITHOUT adding its faces (internal use)") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim)) (answer "(define (sc-add-simplex-only sc s) (let* ((dim (simplex-dim s)) (sc2 (sc-ensure-dim sc dim)) (vec (sc-simplices-by-dim sc2)) (existing (vector-ref vec dim))) (if (simplex-in-list? s existing) sc2 (let ((new-vec (vector-copy vec))) (vector-set! new-vec dim (cons s existing)) (list 'sc new-vec (max (sc-max-dim sc2) dim))))))"))
(task-entry (id "topology/homology/sc-betti") (skill topology) (module homology) (tier 1) (difficulty 11822) (name sc-betti) (type "(-> SC Integer Integer)") (description "Compute the k-th Betti number of a simplicial complex") (notes ("B_k = dim(ker d_k) - dim(im d_{k+1}) = nullity(d_k) - rank(d_{k+1})" "Special cases: B_k = 0 for k > max-dim; B_0 counts connected components")) (section betti-numbers) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix)) (answer "(define (sc-betti sc k) (let ((max-d (sc-max-dim sc))) (cond ((< k 0) 0) ((> k max-d) 0) (else (let* ((bk (sc-boundary-matrix sc k)) (bk+1 (sc-boundary-matrix sc (+ k 1))) (ker-dim (z2-nullity bk)) (im-dim (z2-rank bk+1))) (- ker-dim im-dim))))))"))
(task-entry (id "topology/persistent/make-persistence-result") (skill topology) (module persistent) (tier 1) (difficulty 11822) (name make-persistence-result) (type "(-> (List (Pair Int Int)) (List (Pair Int (List Int))) Vector Vector PersistenceResult)") (description "") (notes ()) (section persistence-result) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list)) (answer "(define (make-persistence-result pairs essential birth-times simplices) (list 'persistence-result pairs essential birth-times simplices))"))
(task-entry (id "topology/simplicial-complex/simplex-in-list?") (skill topology) (module simplicial-complex) (tier 1) (difficulty 11823) (name simplex-in-list?) (type "(-> Simplex (List Simplex) Boolean)") (description "") (notes ()) (section simplicial-complex) (deps (\x27;set \x27;sort)) (available (generic<? bytevector<? type-order make-simplex simplex? simplex-vertices simplex-dim simplex-empty? simplex-equal? simplex-contains-vertex? simplex-face? remove-at simplex-facets simplex-faces-of-dim combinations simplex-all-faces simplex-proper-faces sc-empty sc? sc-simplices-by-dim sc-max-dim sc-ensure-dim sc-add-simplex-only)) (answer "(define (simplex-in-list? s lst) (cond ((null? lst) #f) ((simplex-equal? s (car lst)) #t) (else (simplex-in-list? s (cdr lst)))))"))
(task-entry (id "topology/homology/sc-betti-numbers") (skill topology) (module homology) (tier 1) (difficulty 11823) (name sc-betti-numbers) (type "(-> SC (List Integer))") (description "Compute all Betti numbers from dimension 0 to max-dim") (notes ()) (section betti-numbers) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti)) (answer "(define (sc-betti-numbers sc) (let ((max-d (sc-max-dim sc))) (if (< max-d 0) '() (map (lambda (k) (sc-betti sc k)) (iota (+ max-d 1))))))"))
