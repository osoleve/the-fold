(task-entry (id "diffgeo/lie-groups/se3-to-matrix") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10762) (name se3-to-matrix) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp so2-log so3? so3-matrix make-so3-from-matrix make-so3 so3-identity so3-compose so3-inverse so3-act so3-alg? so3-alg-vec make-so3-alg so3-hat so3-vee so3-alg-to-matrix so3-matrix-to-alg so3-exp so3-log so3-axis-angle se2? se2-rotation se2-translation make-se2 make-se2-from-angle se2-identity se2-to-matrix matrix-to-se2 se2-compose se2-inverse se2-act se2-alg? se2-alg-omega se2-alg-v make-se2-alg se2-alg-to-matrix se2-exp se2-log se3? se3-rotation se3-translation make-se3 se3-identity)) (answer "(define (se3-to-matrix g) (let* ((R (so3-matrix (se3-rotation g))) (t (se3-translation g)) (m (make-matrix 4 4 0))) (do ((i 0 (+ i 1))) ((= i 3)) (do ((j 0 (+ j 1))) ((= j 3)) (matrix-set! m i j (matrix-ref R i j)))) (do ((i 0 (+ i 1))) ((= i 3)) (matrix-set! m i 3 (vector-ref t i))) (matrix-set! m 3 3 1) m))"))
