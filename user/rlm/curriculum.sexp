(task-entry (id "random/monte-carlo/sample-variance") (skill random) (module monte-carlo) (tier 1) (difficulty 12901) (name sample-variance) (type "") (description "") (notes ()) (section statistical-summary-functions) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean)) (answer "(define (sample-variance samples) (let ((n (length samples))) (if (<= n 1) 0 (let* ((mu (sample-mean samples)) (sum-sq (fold-left + 0 (map (lambda (x) (* (- x mu) (- x mu))) samples)))) (/ sum-sq (- n 1))))))"))
