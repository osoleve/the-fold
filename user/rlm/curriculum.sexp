(task-entry (id "sim/bifurcation/kuznetsov-l1") (skill sim) (module bifurcation) (tier 2) (difficulty 23387) (name kuznetsov-l1) (type "(-> (List Number) Number Number)") (description "Compute l₁ using Kuznetsov's formula for 2D Hopf bifurcation") (notes ()) (section hopf-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy)) (answer "(define (kuznetsov-l1 derivs omega) (let* ((fxx (list-ref derivs 0)) (fxy (list-ref derivs 1)) (fyy (list-ref derivs 2)) (gxx (list-ref derivs 3)) (gxy (list-ref derivs 4)) (gyy (list-ref derivs 5)) (fxxx (list-ref derivs 6)) (fxxy (list-ref derivs 7)) (fxyy (list-ref derivs 8)) (fyyy (list-ref derivs 9)) (gxxx (list-ref derivs 10)) (gxxy (list-ref derivs 11)) (gxyy (list-ref derivs 12)) (gyyy (list-ref derivs 13)) (term1 (/ (+ fxxx fxyy gxxy gyyy) (* 16 omega))) (term2 (/ (+ (* fxy (+ fxx fyy)) (- (* gxy (+ gxx gyy))) (- (* fxx gxx)) (* fyy gyy)) (* 16 omega omega)))) (+ term1 term2)))"))
(task-entry (id "sim/bifurcation/detect-period-doubling") (skill sim) (module bifurcation) (tier 2) (difficulty 23388) (name detect-period-doubling) (type "(-> ParamODE Number Number Nat Vec Number Nat Nat Number (List (Pair Number Nat)))") (description "Detect period-doubling bifurcations by counting Poincare section returns") (notes ()) (section period-doubling) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1)) (answer "(define (detect-period-doubling psys param-min param-max param-steps initial-state dt n-transient plane-axis plane-value) (let ((step (/ (- param-max param-min) (max 1 (- param-steps 1))))) (map (lambda (i) (let* ((param (+ param-min (* i step))) (sys (instantiate-at psys param)) (section (poincare-section sys initial-state dt (+ n-transient 2000) n-transient plane-axis plane-value 'positive)) (period (estimate-period-from-section section 0.001))) (cons param period))) (iota param-steps))))"))
(task-entry (id "sim/bifurcation/estimate-period-from-section") (skill sim) (module bifurcation) (tier 2) (difficulty 23389) (name estimate-period-from-section) (type "(-> (List Vec) Number Nat)") (description "Estimate period from Poincare section by finding return time") (notes ()) (section period-doubling) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling)) (answer "(define (estimate-period-from-section section-points tolerance) (if (< (length section-points) 2) 1 (let* ((first-pt (car section-points)) (rest (cdr section-points))) (let loop ((pts rest) (count 1)) (cond ((null? pts) count) ((< (vec-norm (vec-sub (car pts) first-pt)) tolerance) count) ((> count 64) count) (else (loop (cdr pts) (+ count 1))))))))"))
(task-entry (id "sim/bifurcation/feigenbaum-delta") (skill sim) (module bifurcation) (tier 2) (difficulty 23390) (name feigenbaum-delta) (type "(-> (List Number) Number)") (description "Estimate Feigenbaum delta constant from period-doubling cascade") (notes ("Feigenbaum delta is approx 4.669... for maps with quadratic maximum")) (section period-doubling) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section)) (answer "(define (feigenbaum-delta cascade-params) (if (< (length cascade-params) 3) 0 (let loop ((params cascade-params) (deltas '())) (if (< (length params) 3) (if (null? deltas) 0 (/ (apply + deltas) (length deltas))) (let* ((r1 (car params)) (r2 (cadr params)) (r3 (caddr params)) (delta (/ (- r2 r1) (- r3 r2)))) (loop (cdr params) (cons delta deltas)))))))"))
(task-entry (id "sim/bifurcation/find-saddle-node-bifurcation") (skill sim) (module bifurcation) (tier 2) (difficulty 23391) (name find-saddle-node-bifurcation) (type "(-> ParamODE Number Number Vec Number (Option (List Number Vec)))") (description "Find parameter value where saddle-node (fold) bifurcation occurs") (notes ("At saddle-node, a real eigenvalue passes through zero")) (section saddle-node-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta)) (answer "(define (find-saddle-node-bifurcation psys param-min param-max fp-guess tolerance) (let loop ((lo param-min) (hi param-max) (iter 0)) (if (or (> iter 50) (< (- hi lo) tolerance)) (let* ((param (/ (+ lo hi) 2)) (sys (instantiate-at psys param)) (fp (find-fixed-point-solver sys fp-guess tolerance *continuation-step-size* *continuation-max-newton*))) (if fp (list param fp) #f)) (let* ((mid (/ (+ lo hi) 2)) (sys (instantiate-at psys mid)) (fp (find-fixed-point-solver sys fp-guess tolerance *continuation-step-size* *continuation-max-newton*))) (if (not fp) (loop lo mid (+ iter 1)) (let* ((jac (compute-jacobian sys fp *continuation-step-size*)) (det (matrix-determinant jac))) (if (> det 0) (loop mid hi (+ iter 1)) (loop lo mid (+ iter 1)))))))))"))
(task-entry (id "sim/bifurcation/matrix-determinant") (skill sim) (module bifurcation) (tier 2) (difficulty 23392) (name matrix-determinant) (type "(-> Matrix Number)") (description "Compute determinant of n×n matrix using LU decomposition") (notes ("Works for any dimension, not just 2×2")) (section saddle-node-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation)) (answer "(define (matrix-determinant m) (let ((n (matrix-rows m))) (cond ((= n 1) (matrix-ref m 0 0)) ((= n 2) (let ((a (matrix-ref m 0 0)) (b (matrix-ref m 0 1)) (c (matrix-ref m 1 0)) (d (matrix-ref m 1 1))) (- (* a d) (* b c)))) (else (matrix-determinant-lu m)))))"))
(task-entry (id "sim/bifurcation/matrix-determinant-lu") (skill sim) (module bifurcation) (tier 2) (difficulty 23393) (name matrix-determinant-lu) (type "(-> Matrix Number)") (description "Compute determinant via LU decomposition with partial pivoting") (notes ()) (section saddle-node-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant)) (answer "(define (matrix-determinant-lu m) (let* ((n (matrix-rows m)) (data (vector-copy (matrix-data m))) (sign 1)) (let elim-loop ((k 0)) (if (= k n) (let diag-loop ((i 0) (det sign)) (if (= i n) det (diag-loop (+ i 1) (* det (vector-ref data (+ (* i n) i)))))) (let* ((pivot-row (find-pivot-row-det data k n)) (pivot-val (vector-ref data (+ (* pivot-row n) k)))) (if (< (abs pivot-val) 1e-15) 0 (begin (unless (= pivot-row k) (swap-rows-det! data k pivot-row n) (set! sign (- sign))) (do ((i (+ k 1) (+ i 1))) ((= i n)) (let ((factor (/ (vector-ref data (+ (* i n) k)) pivot-val))) (do ((j k (+ j 1))) ((= j n)) (vector-set! data (+ (* i n) j) (- (vector-ref data (+ (* i n) j)) (* factor (vector-ref data (+ (* k n) j)))))))) (elim-loop (+ k 1)))))))))"))
(task-entry (id "sim/bifurcation/find-pivot-row-det") (skill sim) (module bifurcation) (tier 2) (difficulty 23394) (name find-pivot-row-det) (type "(-> Vector Nat Nat Nat)") (description "") (notes ()) (section saddle-node-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant matrix-determinant-lu)) (answer "(define (find-pivot-row-det data k n) (let loop ((i k) (best-row k) (best-val (abs (vector-ref data (+ (* k n) k))))) (if (= i n) best-row (let ((val (abs (vector-ref data (+ (* i n) k))))) (if (> val best-val) (loop (+ i 1) i val) (loop (+ i 1) best-row best-val))))))"))
(task-entry (id "sim/bifurcation/swap-rows-det!") (skill sim) (module bifurcation) (tier 2) (difficulty 23395) (name swap-rows-det!) (type "(-> Vector Nat Nat Nat Void)") (description "") (notes ()) (section saddle-node-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant matrix-determinant-lu find-pivot-row-det)) (answer "(define (swap-rows-det! data row1 row2 n) (unless (= row1 row2) (do ((j 0 (+ j 1))) ((= j n)) (let ((temp (vector-ref data (+ (* row1 n) j)))) (vector-set! data (+ (* row1 n) j) (vector-ref data (+ (* row2 n) j))) (vector-set! data (+ (* row2 n) j) temp)))))"))
(task-entry (id "sim/bifurcation/analyze-bifurcations") (skill sim) (module bifurcation) (tier 2) (difficulty 23396) (name analyze-bifurcations) (type "(-> ParamODE Number Number Nat Vec (List (Pair Number Number)) Nat (List (Pair Symbol Any)))") (description "Comprehensive bifurcation analysis of a parameterized system") (notes ()) (section bifurcation-summary) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives second-deriv-xx second-deriv-xy second-deriv-yy third-deriv-xxx third-deriv-xxy third-deriv-xyy third-deriv-yyy kuznetsov-l1 detect-period-doubling estimate-period-from-section feigenbaum-delta find-saddle-node-bifurcation matrix-determinant matrix-determinant-lu find-pivot-row-det swap-rows-det!)) (answer "(define (analyze-bifurcations psys param-min param-max param-steps fp-guess search-region grid-density) (let* ((tolerance 1e-6) (sys0 (instantiate-at psys param-min)) (fp0 (or (find-fixed-point-solver sys0 fp-guess tolerance *continuation-step-size* *continuation-max-newton*) fp-guess)) (step (/ (- param-max param-min) param-steps)) (continuation (continue-fixed-point psys param-min fp0 param-max step)) (bifurcations (detect-bifurcations continuation)) (eq-diagram (bifurcation-diagram-equilibria psys param-min param-max param-steps search-region grid-density tolerance))) (list (cons 'parameter-range (cons param-min param-max)) (cons 'continuation-points (length continuation)) (cons 'bifurcations bifurcations) (cons 'bifurcation-count (length bifurcations)) (cons 'equilibria-found (length eq-diagram)) (cons 'stability-changes (count-stability-changes continuation)))))"))
