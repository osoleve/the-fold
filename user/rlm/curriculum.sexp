(task-entry (id "data/graph-matrix/adjacency-matrix-add-edge!") (skill data) (module graph-matrix) (tier 0) (difficulty 1310) (name adjacency-matrix-add-edge!) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix)) (answer "(define (adjacency-matrix-add-edge! m i j . weight-opt) (let ((w (if (null? weight-opt) 1 (car weight-opt))) (n (matrix-cols m)) (data (matrix-data m))) (vector-set! data (+ (* i n) j) w)))"))
(task-entry (id "data/centrality/katz-centrality-from-edges") (skill data) (module centrality) (tier 0) (difficulty 1310) (name katz-centrality-from-edges) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series)) (answer "(define (katz-centrality-from-edges edges . opts) (let* ((n (if (and (pair? opts) (integer? (car opts))) (car opts) (infer-node-count edges))) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (adj (edges->adjacency-matrix edges n))) (apply katz-centrality (cons adj rest1))))"))
(task-entry (id "data/graph-community/mst-weight") (skill data) (module graph-community) (tier 0) (difficulty 1310) (name mst-weight) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min)) (answer "(define (mst-weight edges) (fold-left (lambda (sum edge) (+ sum (caddr edge))) 0 edges))"))
