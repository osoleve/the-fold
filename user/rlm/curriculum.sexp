(task-entry (id "random/distributions/log-gamma") (skill random) (module distributions) (tier 1) (difficulty 12903) (name log-gamma) (type "(-> Number Number)") (description "Log of the gamma function via Stirling's approximation") (notes ()) (section math-helpers) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler)) (answer "(define (log-gamma x) (if (<= x 0) (error 'log-gamma \"x must be positive\" x) (if (< x 7) (- (log-gamma (+ x 1)) (log-num x)) (let* ((log-x (log-num x)) (series (+ (/ 1 (* 12 x)) (/ -1 (* 360 x x x)) (/ 1 (* 1260 x x x x x))))) (+ (* (- x 0.5) log-x) (- x) (* 0.5 (log-num (* 2 (pi-value)))) series)))))"))
