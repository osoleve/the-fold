(task-entry (id "numeric/convolution/convolve-circular") (skill numeric) (module convolution) (tier 0) (difficulty 2513) (name convolve-circular) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;vec)) (available (convolve-direct-full convolve-direct-same convolve-direct-valid convolve-fft convolve correlate-direct correlate autocorrelate matched-filter find-peaks vector-reverse normalize-signal convolve-2d)) (answer "(define (convolve-circular signal kernel) (let* ((n (vector-length signal)) (m (vector-length kernel))) (if (not (= n m)) (error 'convolve-circular \"signal and kernel must have same length\" (list n m)) (let* ((signal-complex (real->complex-vec signal)) (kernel-complex (real->complex-vec kernel)) (fft-size (if (power-of-2? n) n (next-power-of-2 n))) (signal-padded (if (= n fft-size) signal-complex (zero-pad signal-complex fft-size))) (kernel-padded (if (= m fft-size) kernel-complex (zero-pad kernel-complex fft-size))) (signal-fft (fft-radix2 signal-padded)) (kernel-fft (fft-radix2 kernel-padded)) (product (make-vector fft-size)) (result-complex #f) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i fft-size)) (vector-set! product i (complex-mul (vector-ref signal-fft i) (vector-ref kernel-fft i)))) (set! result-complex (ifft-radix2 product)) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (complex-real (vector-ref result-complex i))))))))"))
(task-entry (id "numeric/wavelet/idwt") (skill numeric) (module wavelet) (tier 0) (difficulty 2513) (name idwt) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (haar-scaling-filter haar-wavelet-filter daubechies-4-scaling-filter qmf-wavelet-from-scaling daubechies-4-wavelet-filter daubechies-6-scaling-filter daubechies-6-wavelet-filter reverse-filter convolve-downsample upsample-convolve dwt-step dwt idwt-step)) (answer "(define (idwt coeffs target-len h g) (if (null? coeffs) (make-vector 0) (let loop ((approx (car coeffs)) (details (cdr coeffs)) (current-len target-len)) (if (null? details) (if (> (vector-length approx) target-len) (let ((result (make-vector target-len))) (do ((i 0 (+ i 1))) ((= i target-len) result) (vector-set! result i (vector-ref approx i)))) approx) (let* ((detail (car details)) (rest (cdr details)) (reconstructed (idwt-step approx detail h g current-len))) (loop reconstructed rest current-len))))))"))
