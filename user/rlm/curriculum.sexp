(task-entry (id "crypto/hmac/make-hmac") (skill crypto) (module hmac) (tier 1) (difficulty 10500) (name make-hmac) (type "(-> (-> Bytevector Bytevector) Integer Integer (-> Bytevector Bytevector Bytevector))") (description "Create an HMAC function for a given hash, block size, and output size") (notes ()) (section hmac-core) (deps (\x27;sha256 \x27;sha512)) (available ()) (answer "(define (make-hmac hash-fn block-size output-size) (lambda (key message) (let* ((key-len (bytevector-length key)) (key-prime (cond ((> key-len block-size) (let ((hashed (hash-fn key)) (padded (make-bytevector block-size 0))) (bytevector-copy! hashed 0 padded 0 (bytevector-length hashed)) padded)) ((< key-len block-size) (let ((padded (make-bytevector block-size 0))) (bytevector-copy! key 0 padded 0 key-len) padded)) (else key))) (ipad-key (make-bytevector block-size)) (opad-key (make-bytevector block-size))) (do ((i 0 (+ i 1))) ((= i block-size)) (bytevector-u8-set! ipad-key i (bitwise-xor (bytevector-u8-ref key-prime i) 54)) (bytevector-u8-set! opad-key i (bitwise-xor (bytevector-u8-ref key-prime i) 92))) (let* ((inner-input (bytevector-append ipad-key message)) (inner-hash (hash-fn inner-input)) (outer-input (bytevector-append opad-key inner-hash))) (hash-fn outer-input)))))"))
