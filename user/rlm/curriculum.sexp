(task-entry (id "linalg/dep-linalg/vec-zip-typed") (skill linalg) (module dep-linalg) (tier 0) (difficulty 402) (name vec-zip-typed) (type "Π n A B. Vec n A → Vec n B → Vec n (× A B)") (description "Zips two same-length vectors into pairs.") (notes ()) (section vector-operations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (dep-linalg-types vec-append-typed)) (answer "(define (vec-zip-typed n A B v1 v2) (vec-zip-with (lambda (x y) (cons x y)) v1 v2))"))
