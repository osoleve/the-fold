(task-entry (id "clp/global-constraints/sum-fd-narrow-vars") (skill clp) (module global-constraints) (tier 1) (difficulty 10812) (name sum-fd-narrow-vars) (type "(-> CStore (List LVar) (Or LVar Int) (Maybe CStore))") (description "Narrow each variable based on sum constraint") (notes ()) (section sum-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global post-all-different element element-propagate post-element sum-fd sum-fd-propagate)) (answer "(define (sum-fd-narrow-vars cs vars result) (let ((result-bounds (fd-bounds cs result))) (if (not result-bounds) cs (let ((res-lo (car result-bounds)) (res-hi (cdr result-bounds)) (all-vars vars)) (let loop ((remaining vars) (cs cs)) (if (null? remaining) cs (let* ((var (car remaining)) (others (filter (lambda (v) (not (eq? v var))) all-vars)) (var-bounds (fd-bounds cs var)) (other-bounds (map (lambda (v) (fd-bounds cs v)) others))) (if (or (not var-bounds) (any not other-bounds)) (loop (cdr remaining) cs) (let* ((others-lo (apply + (map car other-bounds))) (others-hi (apply + (map cdr other-bounds))) (new-lo (max (car var-bounds) (- res-lo others-hi))) (new-hi (min (cdr var-bounds) (- res-hi others-lo)))) (if (> new-lo new-hi) #f (let ((cs1 (fd-narrow-bounds cs var new-lo new-hi))) (if cs1 (loop (cdr remaining) cs1) #f))))))))))))"))
(task-entry (id "clp/propagate/post-+fd") (skill clp) (module propagate) (tier 1) (difficulty 10812) (name post-+fd) (type "(-> CStore (Or LVar Int) (Or LVar Int) (Or LVar Int) (Maybe CStore))") (description "Post addition constraint and propagate") (notes ()) (section high-level-constraint-posting) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range post-=fd post-<fd post-<=fd post->fd post->=fd post-=/=fd)) (answer "(define (post-+fd cs x y z) (let ((vars (filter lvar? (list x y z)))) (if (null? vars) ((+fd x y z) cs) (post-constraint cs '+fd vars (+fd x y z)))))"))
