(task-entry (id "data/graph-homology/edges-from-z2-null-vector") (skill data) (module graph-homology) (tier 0) (difficulty 1305) (name edges-from-z2-null-vector) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;homology)) (available (graph->simplicial-complex graph-adjacency->simplicial-complex graph-betti-numbers graph-betti-numbers-from-adjacency cycle-basis-homology)) (answer "(define (edges-from-z2-null-vector coeffs edge-simplices) (let loop ((cs coeffs) (edges edge-simplices) (result '())) (if (or (null? cs) (null? edges)) (reverse result) (let ((coeff (car cs)) (edge (car edges))) (if (= coeff 1) (let* ((vs (simplex-vertices edge)) (v0 (car vs)) (v1 (cadr vs))) (loop (cdr cs) (cdr edges) (cons (cons v0 v1) result))) (loop (cdr cs) (cdr edges) result))))))"))
(task-entry (id "data/pagerank/matrix-col-sum") (skill data) (module pagerank) (tier 0) (difficulty 1305) (name matrix-col-sum) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations* adjacency->transition matrix-row-sum)) (answer "(define (matrix-col-sum m j) (let ((n (matrix-rows m))) (let loop ((i 0) (sum 0)) (if (>= i n) sum (loop (+ i 1) (+ sum (matrix-ref m i j)))))))"))
(task-entry (id "data/graph-matrix/infer-node-count") (skill data) (module graph-matrix) (tier 0) (difficulty 1305) (name infer-node-count) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight)) (answer "(define (infer-node-count edges) (if (null? edges) 0 (+ 1 (fold-left (lambda (acc edge) (max acc (edge-from edge) (edge-to edge))) 0 edges))))"))
(task-entry (id "data/centrality/eigenvector-average-oscillation") (skill data) (module centrality) (tier 0) (difficulty 1305) (name eigenvector-average-oscillation) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance)) (answer "(define (eigenvector-average-oscillation v1 v2) (let* ((n (vector-length v1)) (avg (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! avg i (/ (+ (vector-ref v1 i) (vector-ref v2 i)) 2.0))) (let ((norm (vec-norm avg))) (if (< norm 1e-15) avg (vec-scale (/ 1.0 norm) avg)))))"))
(task-entry (id "data/graph-community/modularity") (skill data) (module graph-community) (tier 0) (difficulty 1305) (name modularity) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities)) (answer "(define (modularity adj labels) (let* ((n (matrix-rows adj)) (two-m (matrix-sum adj)) (m (/ two-m 2.0)) (degrees (make-vector n 0))) (if (= m 0) 0 (begin (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (when (> (matrix-ref adj i j) 0) (vector-set! degrees i (+ (vector-ref degrees i) (matrix-ref adj i j)))))) (let ((sum 0)) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (when (= (vector-ref labels i) (vector-ref labels j)) (let* ((a-ij (matrix-ref adj i j)) (ki (vector-ref degrees i)) (kj (vector-ref degrees j)) (expected (/ (* ki kj) two-m))) (set! sum (+ sum (- a-ij expected))))))) (/ sum two-m))))))"))
