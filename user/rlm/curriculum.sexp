(task-entry (id "random/monte-carlo/sample-sem") (skill random) (module monte-carlo) (tier 1) (difficulty 12903) (name sample-sem) (type "") (description "") (notes ()) (section statistical-summary-functions) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std)) (answer "(define (sample-sem samples) (let ((n (length samples))) (if (<= n 0) 0 (/ (sample-std samples) (sqrt n)))))"))
