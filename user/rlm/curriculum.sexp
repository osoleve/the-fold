(task-entry (id "data/collection-utils/collection-group-by") (skill data) (module collection-utils) (tier 0) (difficulty 1314) (name collection-group-by) (type "(-> FSCap (-> Block A) Block (List (Pair A (List Block))))") (description "Group collection members by key function. Returns association list: ((key1 . [blocks...]) (key2 . [blocks...]) ...). Uses hash table internally for O(N) complexity instead of O(N*G)") (notes ()) (section collection-transformation) (deps (\x27;block \x27;sha256)) (available (foldr collection-hashes collection-size collection-empty? map-collection filter-collection fold-collection foldr-collection for-each-collection collection-find collection-any? collection-all? collection-count-matching collection-partition)) (answer "(define (collection-group-by fs key-fn collection) (let ((groups (make-hashtable equal-hash equal?))) (fold-collection fs (lambda (acc block) (let* ((key (key-fn block)) (existing (hashtable-ref groups key '()))) (hashtable-set! groups key (cons block existing))) acc) '() collection) (let-values (((keys vals) (hashtable-entries groups))) (map cons (vector->list keys) (vector->list vals)))))"))
