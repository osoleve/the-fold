(task-entry (id "data/quadtree/bounds-min-dist-sq") (skill data) (module quadtree) (tier 0) (difficulty 1335) (name bounds-min-dist-sq) (type "(-> Bounds Num Num Num)") (description "Minimum squared distance from point to bounding box") (notes ()) (section nearest-neighbor) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build quadtree-build-auto list->quadtree quadtree-insert quadtree-insert-at-depth quadtree-split quadtree-range quadtree-range-rect quadtree-radius quadtree-nearest quadtree-nearest-rec)) (answer "(define (bounds-min-dist-sq bounds qx qy) (let* ((cx (bounds-cx bounds)) (cy (bounds-cy bounds)) (hw (bounds-hw bounds)) (hh (bounds-hh bounds)) (x-dist (max 0 (- (abs (- qx cx)) hw))) (y-dist (max 0 (- (abs (- qy cy)) hh)))) (+ (* x-dist x-dist) (* y-dist y-dist))))"))
