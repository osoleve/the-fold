(task-entry (id "diffgeo/lie-groups/so2-compose") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10711) (name so2-compose) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle)) (answer "(define (so2-compose g1 g2) (list 'so2 (matrix-mul (so2-matrix g1) (so2-matrix g2))))"))
(task-entry (id "diffgeo/curvature/make-cylindrical-metric") (skill diffgeo) (module curvature) (tier 1) (difficulty 10711) (name make-cylindrical-metric) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric)) (answer "(define (make-cylindrical-metric chart) (make-metric chart (lambda (coords) (let ((rho (vector-ref coords 0))) (matrix-from-lists (list (list 1 0 0) (list 0 (* rho rho) 0) (list 0 0 1)))))))"))
(task-entry (id "diffgeo/geodesics/dp-a") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10711) (name dp-a) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c)) (answer "(define dp-a '#(#() #(1/5) #(3/40 9/40) #(44/45 -56/15 32/9) #(19372/6561 -25360/2187 64448/6561 -212/729) #(9017/3168 -355/33 46732/5247 49/176 -5103/18656) #(35/384 0 500/1113 125/192 -2187/6784 11/84)))"))
(task-entry (id "diffgeo/forms/merge-indices") (skill diffgeo) (module forms) (tier 1) (difficulty 10711) (name merge-indices) (type "") (description "") (notes ()) (section permutation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap?)) (answer "(define (merge-indices idx1 idx2) (let loop ((lst1 idx1) (lst2 idx2) (acc '())) (cond ((null? lst1) (append (reverse acc) lst2)) ((null? lst2) (append (reverse acc) lst1)) ((<= (car lst1) (car lst2)) (loop (cdr lst1) lst2 (cons (car lst1) acc))) (else (loop lst1 (cdr lst2) (cons (car lst2) acc))))))"))
(task-entry (id "diffgeo/symbolic-metrics/christoffel-symbols-exact") (skill diffgeo) (module symbolic-metrics) (tier 1) (difficulty 10711) (name christoffel-symbols-exact) (type "(-> MetricSymbolic Vec ChristoffelTensor)") (description "Compute Christoffel symbols using exact symbolic derivatives") (notes ("No numerical error from finite differences")) (section metric-derivative-protocol) (deps (\x27;curvature)) (available (metric-symbolic? make-metric-symbolic metric-symbolic-deriv-fn metric-chart* metric-fn* metric-dim* metric-at* make-polar-metric-exact make-spherical-metric-exact make-cylindrical-metric-exact make-euclidean-metric-exact)) (answer "(define (christoffel-symbols-exact m coords) (let* ((n (metric-dim* m)) (g (metric-at* m coords)) (g-inv (matrix-inverse g)) (dg ((metric-symbolic-deriv-fn m) coords)) (gamma (make-vector n #f))) (do ((k 0 (+ k 1))) ((= k n) gamma) (let ((gamma-k (make-vector n #f))) (do ((i 0 (+ i 1))) ((= i n)) (let ((gamma-ki (make-vector n 0)) (dg-i (vector-ref dg i))) (do ((j 0 (+ j 1))) ((= j n)) (let ((sum 0) (dg-j (vector-ref dg j))) (do ((l 0 (+ l 1))) ((= l n)) (let* ((g-kl (matrix-ref g-inv k l)) (dg-l (vector-ref dg l)) (term1 (matrix-ref dg-i j l)) (term2 (matrix-ref dg-j i l)) (term3 (matrix-ref dg-l i j))) (set! sum (+ sum (* g-kl (- (+ term1 term2) term3)))))) (vector-set! gamma-ki j (* 0.5 sum)))) (vector-set! gamma-k i gamma-ki))) (vector-set! gamma k gamma-k)))))"))
