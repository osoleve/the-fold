(task-entry (id "dataset/distractor/generate-filler-distractors") (skill dataset) (module distractor) (tier 1) (difficulty 13416) (name generate-filler-distractors) (type "") (description "") (notes ()) (section generation) (deps (\x27;prelude \x27;prng \x27;parameter \x27;sort)) (available (make-distractor-strategy distractor-strategy? distractor-strategy-name distractor-strategy-generator distractor-nearby distractor-sign-flip distractor-off-by-one distractor-double-half distractor-wrong-sign-convention distractor-order-swap distractor-random-choice distractor-formula-variant apply-distractor generate-distractors member-approx? approx-equal?)) (answer "(define (generate-filler-distractors correct n rng existing) (let loop ((remaining n) (results '()) (attempts 0)) (cond ((<= remaining 0) results) ((>= attempts (* n 20)) results) (else (let ((val (if (number? correct) (* correct (+ 0.5 (* 1.5 (prng-next-float rng)))) correct))) (if (or (equal? val correct) (member-approx? val existing) (member-approx? val results)) (loop remaining results (+ attempts 1)) (loop (- remaining 1) (cons val results) 0)))))))"))
(task-entry (id "dataset/difficulty/tier-order") (skill dataset) (module difficulty) (tier 1) (difficulty 13416) (name tier-order) (type "") (description "") (notes ()) (section tiers) (deps (\x27;prelude)) (available (make-difficulty-vector difficulty-vec? dv-inference-depth dv-object-count dv-temporal-steps dv-visual-precision dv-formula-complexity inference-direct inference-derivative inference-latent inference-system classify-inference-depth difficulty-weights difficulty-score difficulty-score-default difficulty-tier)) (answer "(define (tier-order tier) (case tier ((trivial) 0) ((easy) 1) ((medium) 2) ((hard) 3) ((expert) 4) (else 2)))"))
