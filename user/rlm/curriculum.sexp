(task-entry (id "game-theory/voting-games/map-indexed") (skill game-theory) (module voting-games) (tier 1) (difficulty 13218) (name map-indexed) (type "") (description "") (notes ()) (section strategic-implications) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison power-concentration power-gini decisive-for-candidate)) (answer "(define (map-indexed f lst) (let loop ((lst lst) (i 0) (acc '())) (if (null? lst) (reverse acc) (loop (cdr lst) (+ i 1) (cons (f (car lst) i) acc)))))"))
(task-entry (id "game-theory/multi-winner/approval-scores") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13218) (name approval-scores) (type "") (description "") (notes ()) (section approval-voting) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count)) (answer "(define (approval-scores profile) (let ((candidates (approval-profile-candidates profile))) (map (lambda (c) (cons c (approval-count c profile))) candidates)))"))
(task-entry (id "game-theory/fair-division/envy-free?") (skill game-theory) (module fair-division) (tier 1) (difficulty 13218) (name envy-free?) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional?)) (answer "(define (envy-free? c div) (let ((n (cake-players c))) (let outer ((i 0)) (if (>= i n) #t (let ((my-value (piece-value c i (division-piece div i)))) (let inner ((j 0)) (if (>= j n) (outer (+ i 1)) (if (= i j) (inner (+ j 1)) (let ((other-value (piece-value c i (division-piece div j)))) (and (<= other-value (+ my-value 1e-10)) (inner (+ j 1))))))))))))"))
(task-entry (id "game-theory/mechanism/bidder-utility") (skill game-theory) (module mechanism) (tier 1) (difficulty 13218) (name bidder-utility) (type "(-> AuctionOutcome Nat Number Number)") (description "Compute utility for bidder i with given valuation") (notes ()) (section bidder-utility) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve)) (answer "(define (bidder-utility outcome i valuation) (let ((winner (auction-outcome-winner outcome)) (payment (auction-outcome-payment outcome))) (cond ((vector? payment) (let ((my-payment (vector-ref payment i)) (won? (cond ((number? winner) (= i winner)) ((list? winner) (and (member i winner) #t)) (else #f)))) (- (if won? valuation 0) my-payment))) ((number? winner) (if (= i winner) (- valuation payment) 0)) ((and (list? winner) (member i winner)) (/ (- valuation payment) (length winner))) (else 0))))"))
(task-entry (id "game-theory/evolutionary/pure-population") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13218) (name pure-population) (type "") (description "") (notes ()) (section population-state) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population)) (answer "(define (pure-population n i) (make-population (map (lambda (j) (if (= j i) 1 0)) (iota n))))"))
(task-entry (id "game-theory/mcdm/dominates?") (skill game-theory) (module mcdm) (tier 1) (difficulty 13218) (name dominates?) (type "(-> DecisionProblem Alternative Alternative Boolean)") (description "Does a Pareto-dominate b? (a >= b on all criteria, a > b on at least one)") (notes ()) (section pareto-analysis) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner)) (answer "(define (dominates? dp a b) (let ((criteria (dp-criteria dp))) (and (for-all? (lambda (c) (>= (dp-score dp a c) (dp-score dp b c))) criteria) (any? (lambda (c) (> (dp-score dp a c) (dp-score dp b c))) criteria))))"))
(task-entry (id "game-theory/normal-form/iesds") (skill game-theory) (module normal-form) (tier 1) (difficulty 13219) (name iesds) (type "") (description "") (notes ()) (section iesds) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2)) (answer "(define (iesds game fuel) (if (<= fuel 0) game (let ((dominated (find-dominated-strategies game))) (cond ((not (null? (car dominated))) (iesds (eliminate-strategy-p1 game (car (car dominated))) (- fuel 1))) ((not (null? (cdr dominated))) (iesds (eliminate-strategy-p2 game (car (cdr dominated))) (- fuel 1))) (else game)))))"))
(task-entry (id "game-theory/extensive-form/game-info-sets") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13219) (name game-info-sets) (type "(-> ExtensiveGame (List InfoSet))") (description "") (notes ()) (section game-construction) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root)) (answer "(define (game-info-sets game) (cadddr game))"))
(task-entry (id "game-theory/coop-games/coop-game-value?") (skill game-theory) (module coop-games) (tier 1) (difficulty 13219) (name coop-game-value?) (type "(-> CoopGame Boolean)") (description "Is this a value game?") (notes ()) (section cooperative-game-record-type) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost?)) (answer "(define (coop-game-value? g) (eq? ':value (coop-game-type g)))"))
(task-entry (id "game-theory/matching/matching-stable?") (skill game-theory) (module matching) (tier 1) (difficulty 13219) (name matching-stable?) (type "(-> Market (List (Id . Id)) Boolean)") (description "Verify that a matching is stable (no blocking pairs). A blocking pair (p, r) exists if: p prefers r to current match (or p is unmatched), r prefers p to current match (or r is unmatched)") (notes ()) (section stability-verification) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching)) (answer "(define (matching-stable? market matching) (let* ((proposers (market-proposers market)) (receivers (market-receivers market)) (prop-to-recv (build-match-table-p matching)) (recv-to-prop (build-match-table-r matching))) (not (find-blocking-pair market proposers receivers prop-to-recv recv-to-prop))))"))
(task-entry (id "game-theory/voting/plurality-winner") (skill game-theory) (module voting) (tier 1) (difficulty 13219) (name plurality-winner) (type "") (description "") (notes ()) (section positional-rules) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking)) (answer "(define (plurality-winner profile) (positional-winner profile (plurality-scores (profile-num-candidates profile))))"))
(task-entry (id "game-theory/voting-games/blocking-for-candidate") (skill game-theory) (module voting-games) (tier 1) (difficulty 13219) (name blocking-for-candidate) (type "") (description "") (notes ()) (section strategic-implications) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison power-concentration power-gini decisive-for-candidate map-indexed)) (answer "(define (blocking-for-candidate profile voting-rule candidate) (let* ((n (profile-voters profile)) (candidates (profile-candidates profile)) (others (remove candidate candidates)) (blocking-vote (append others (list candidate))) (grand (- (expt 2 n) 1))) (filter (lambda (S) (if (= S 0) #f (let* ((members (coalition->list S)) (non-members (filter (lambda (i) (not (member i members))) (iota n))) (c-first-vote (cons candidate (remove candidate candidates))) (modified (map-indexed (lambda (ranking i) (cond ((member i members) blocking-vote) ((member i non-members) c-first-vote) (else ranking))) profile)) (winner (voting-rule modified))) (not (eq? winner candidate))))) (map (lambda (i) i) (iota (+ grand 1))))))"))
(task-entry (id "game-theory/multi-winner/approval-winners") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13219) (name approval-winners) (type "") (description "") (notes ()) (section approval-voting) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores)) (answer "(define (approval-winners profile num-seats) (let* ((scores (approval-scores profile)) (sorted (sort-by (lambda (a b) (> (cdr a) (cdr b))) scores))) (take num-seats (map car sorted))))"))
(task-entry (id "game-theory/fair-division/equitable?") (skill game-theory) (module fair-division) (tier 1) (difficulty 13219) (name equitable?) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free?)) (answer "(define (equitable? c div tolerance) (let* ((n (cake-players c)) (shares (let loop ((i 0) (acc '())) (if (>= i n) acc (let* ((total (cake-total-value c i)) (received (piece-value c i (division-piece div i))) (share (if (= total 0) 0 (/ received total)))) (loop (+ i 1) (cons share acc))))))) (if (null? shares) #t (let ((min-share (apply min shares)) (max-share (apply max shares))) (<= (- max-share min-share) tolerance)))))"))
(task-entry (id "game-theory/mechanism/is-dsic-deviation-profitable?") (skill game-theory) (module mechanism) (tier 1) (difficulty 13219) (name is-dsic-deviation-profitable?) (type "(-> (-> (Vector Number) AuctionOutcome) (Vector Number) Nat Number Boolean)") (description "Would bidder i profit by bidding deviation instead of their true valuation?") (notes ()) (section incentive-compatibility) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility)) (answer "(define (is-dsic-deviation-profitable? auction valuations i deviation) (let* ((n (vector-length valuations)) (true-bids (vector-copy valuations)) (deviated-bids (let ((v (vector-copy valuations))) (vector-set! v i deviation) v)) (true-outcome (auction true-bids)) (deviated-outcome (auction deviated-bids)) (true-utility (bidder-utility true-outcome i (vector-ref valuations i))) (deviated-utility (bidder-utility deviated-outcome i (vector-ref valuations i)))) (> deviated-utility true-utility)))"))
(task-entry (id "game-theory/evolutionary/strategy-fitness") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13219) (name strategy-fitness) (type "(-> SymmetricGame Population Nat Number)") (description "") (notes ()) (section fitness) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population)) (answer "(define (strategy-fitness game pop i) (let ((n (sg-num-strategies game))) (let loop ((j 0) (sum 0)) (if (>= j n) sum (loop (+ j 1) (+ sum (* (sg-payoff game i j) (pop-freq pop j))))))))"))
(task-entry (id "game-theory/mcdm/pareto-frontier") (skill game-theory) (module mcdm) (tier 1) (difficulty 13219) (name pareto-frontier) (type "(-> DecisionProblem (List Alternative))") (description "Find Pareto frontier: alternatives not dominated by any other. If choosing within frontier, need additional criteria or preferences") (notes ("Connection to voting: Smith set is the 'Condorcet-Pareto' frontier - minimal set where every member beats every non-member pairwise")) (section pareto-analysis) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates?)) (answer "(define (pareto-frontier dp) (let ((alts (dp-alternatives dp))) (filter (lambda (a) (not (any? (lambda (b) (and (not (eq? a b)) (dominates? dp b a))) alts))) alts)))"))
(task-entry (id "game-theory/normal-form/is-pure-nash?") (skill game-theory) (module normal-form) (tier 1) (difficulty 13220) (name is-pure-nash?) (type "(-> Game Nat Nat Boolean)") (description "Is (i, j) a pure strategy Nash equilibrium? True iff i is a best response to j AND j is a best response to i") (notes ()) (section pure-nash) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds)) (answer "(define (is-pure-nash? game i j) (and (member i (best-response-p1 game j)) (member j (best-response-p2 game i)) #t))"))
(task-entry (id "game-theory/extensive-form/tree-depth") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13220) (name tree-depth) (type "(-> Node Nat)") (description "Compute the depth of the game tree") (notes ()) (section tree-utilities) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets)) (answer "(define (tree-depth node) (cond ((terminal? node) 0) ((decision? node) (+ 1 (apply max (cons 0 (map tree-depth (decision-children node)))))) ((chance? node) (+ 1 (apply max (cons 0 (map tree-depth (chance-children node)))))) (else (error 'tree-depth \"unknown node type\" node))))"))
(task-entry (id "game-theory/coop-games/allocation-total") (skill game-theory) (module coop-games) (tier 1) (difficulty 13220) (name allocation-total) (type "(-> (Vector Real) Real)") (description "Sum of all payoffs in allocation") (notes ()) (section allocations) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value?)) (answer "(define (allocation-total x) (let loop ((i 0) (sum 0)) (if (>= i (vector-length x)) sum (loop (+ i 1) (+ sum (vector-ref x i))))))"))
(task-entry (id "game-theory/matching/build-match-table-p") (skill game-theory) (module matching) (tier 1) (difficulty 13220) (name build-match-table-p) (type "") (description "") (notes ()) (section stability-verification) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable?)) (answer "(define (build-match-table-p matching) (map (lambda (pair) (cons (car pair) (cdr pair))) matching))"))
(task-entry (id "game-theory/voting/borda-winner") (skill game-theory) (module voting) (tier 1) (difficulty 13220) (name borda-winner) (type "") (description "") (notes ()) (section positional-rules) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner)) (answer "(define (borda-winner profile) (positional-winner profile (borda-scores (profile-num-candidates profile))))"))
(task-entry (id "game-theory/voting-games/make-electoral-college-game") (skill game-theory) (module voting-games) (tier 1) (difficulty 13220) (name make-electoral-college-game) (type "") (description "") (notes ()) (section electoral-college) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison power-concentration power-gini decisive-for-candidate map-indexed blocking-for-candidate)) (answer "(define (make-electoral-college-game state-votes) (let* ((weights (map cdr state-votes)) (total (apply + weights)) (quota (+ (quotient total 2) 1))) (make-weighted-voting-game weights quota)))"))
(task-entry (id "game-theory/multi-winner/pav-score") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13220) (name pav-score) (type "") (description "") (notes ()) (section pav) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners)) (answer "(define (pav-score candidate profile elected) (apply + (map (lambda (approvals) (if (member candidate approvals) (let ((already-satisfied (count-if (lambda (e) (member e approvals)) elected))) (/ 1 (+ already-satisfied 1))) 0)) profile)))"))
(task-entry (id "game-theory/fair-division/pareto-optimal?") (skill game-theory) (module fair-division) (tier 1) (difficulty 13220) (name pareto-optimal?) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable?)) (answer "(define (pareto-optimal? c div) (let* ((intervals (flatten (division->list div))) (total-length (fold-left + 0 (map (lambda (i) (- (cdr i) (car i))) intervals)))) (>= total-length (- 1 1e-10))))"))
(task-entry (id "game-theory/mechanism/check-dsic") (skill game-theory) (module mechanism) (tier 1) (difficulty 13220) (name check-dsic) (type "(-> (-> (Vector Number) AuctionOutcome) (Vector Number) (List Number) (List (Nat Number Number Number)))") (description "Check DSIC by testing deviations. Returns list of profitable deviations: (bidder deviation gain utility-diff)") (notes ()) (section incentive-compatibility) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable?)) (answer "(define (check-dsic auction valuations deviations) (let* ((n (vector-length valuations)) (profitable '())) (do ((i 0 (+ i 1))) ((= i n) (reverse profitable)) (let ((vi (vector-ref valuations i))) (for-each (lambda (deviation) (when (is-dsic-deviation-profitable? auction valuations i deviation) (let* ((true-bids (vector-copy valuations)) (deviated-bids (let ((v (vector-copy valuations))) (vector-set! v i deviation) v)) (true-outcome (auction true-bids)) (deviated-outcome (auction deviated-bids)) (true-utility (bidder-utility true-outcome i vi)) (deviated-utility (bidder-utility deviated-outcome i vi))) (set! profitable (cons (list i deviation (- deviated-utility true-utility) deviated-utility) profitable))))) deviations)))))"))
(task-entry (id "game-theory/evolutionary/all-fitnesses") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13220) (name all-fitnesses) (type "") (description "") (notes ()) (section fitness) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness)) (answer "(define (all-fitnesses game pop) (let ((n (sg-num-strategies game))) (map (lambda (i) (strategy-fitness game pop i)) (iota n))))"))
(task-entry (id "game-theory/mcdm/pareto-dominated") (skill game-theory) (module mcdm) (tier 1) (difficulty 13220) (name pareto-dominated) (type "(-> DecisionProblem (List Alternative))") (description "Find alternatives that are Pareto-dominated. Safe to eliminate from consideration") (notes ()) (section pareto-analysis) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier)) (answer "(define (pareto-dominated dp) (let* ((alts (dp-alternatives dp)) (frontier (pareto-frontier dp))) (filter (lambda (a) (not (member a frontier))) alts)))"))
(task-entry (id "game-theory/normal-form/find-pure-nash") (skill game-theory) (module normal-form) (tier 1) (difficulty 13221) (name find-pure-nash) (type "") (description "") (notes ()) (section pure-nash) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds is-pure-nash?)) (answer "(define (find-pure-nash game) (let ((n1 (game-num-strategies game 0)) (n2 (game-num-strategies game 1))) (filter (lambda (profile) (is-pure-nash? game (car profile) (cdr profile))) (append-map (lambda (i) (map (lambda (j) (cons i j)) (iota n2))) (iota n1)))))"))
(task-entry (id "game-theory/extensive-form/tree-size") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13221) (name tree-size) (type "(-> Node Nat)") (description "Count total number of nodes in the game tree") (notes ()) (section tree-utilities) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth)) (answer "(define (tree-size node) (cond ((terminal? node) 1) ((decision? node) (+ 1 (fold-right + 0 (map tree-size (decision-children node))))) ((chance? node) (+ 1 (fold-right + 0 (map tree-size (chance-children node))))) (else (error 'tree-size \"unknown node type\" node))))"))
(task-entry (id "game-theory/coop-games/allocation-coalition-total") (skill game-theory) (module coop-games) (tier 1) (difficulty 13221) (name allocation-coalition-total) (type "(-> (Vector Real) Coalition Real)") (description "Sum of payoffs for players in coalition S") (notes ()) (section allocations) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total)) (answer "(define (allocation-coalition-total x S) (let loop ((S S) (i 0) (sum 0)) (if (= S 0) sum (loop (bitwise-arithmetic-shift-right S 1) (+ i 1) (if (= 1 (bitwise-and S 1)) (+ sum (vector-ref x i)) sum)))))"))
(task-entry (id "game-theory/matching/build-match-table-r") (skill game-theory) (module matching) (tier 1) (difficulty 13221) (name build-match-table-r) (type "") (description "") (notes ()) (section stability-verification) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p)) (answer "(define (build-match-table-r matching) (map (lambda (pair) (cons (cdr pair) (car pair))) matching))"))
(task-entry (id "game-theory/voting/antiplurality-winner") (skill game-theory) (module voting) (tier 1) (difficulty 13221) (name antiplurality-winner) (type "") (description "") (notes ()) (section positional-rules) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner)) (answer "(define (antiplurality-winner profile) (positional-winner profile (antiplurality-scores (profile-num-candidates profile))))"))
(task-entry (id "game-theory/voting-games/electoral-college-power") (skill game-theory) (module voting-games) (tier 1) (difficulty 13221) (name electoral-college-power) (type "") (description "") (notes ()) (section electoral-college) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison power-concentration power-gini decisive-for-candidate map-indexed blocking-for-candidate make-electoral-college-game)) (answer "(define (electoral-college-power state-votes) (let* ((game (make-electoral-college-game state-votes)) (n (length state-votes)) (fuel (* n (expt 2 n))) (power (banzhaf-index game fuel))) (map (lambda (state-info i) (cons (car state-info) (vector-ref power i))) state-votes (iota n))))"))
(task-entry (id "game-theory/multi-winner/pav-winners") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13221) (name pav-winners) (type "") (description "") (notes ()) (section pav) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score)) (answer "(define (pav-winners profile num-seats) (let ((candidates (approval-profile-candidates profile))) (pav-loop profile candidates '() num-seats)))"))
(task-entry (id "game-theory/fair-division/find-cut-point") (skill game-theory) (module fair-division) (tier 1) (difficulty 13221) (name find-cut-point) (type "(-> Cake Nat Real Real)") (description "") (notes ()) (section cut-and-choose) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal?)) (answer "(define (find-cut-point c i target fuel) (let* ((total (cake-total-value c i))) (if (<= target 0) 0 (if (>= target total) 1 (binary-search-cut c i target 0 1 fuel)))))"))
(task-entry (id "game-theory/mechanism/verify-dsic") (skill game-theory) (module mechanism) (tier 1) (difficulty 13221) (name verify-dsic) (type "(-> (-> (Vector Number) AuctionOutcome) (List (Vector Number)) (List Number) Boolean)") (description "Verify DSIC property across multiple valuation profiles. Returns #t if no profitable deviations found.") (notes ()) (section incentive-compatibility) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic)) (answer "(define (verify-dsic auction test-valuations test-deviations) (let loop ((profiles test-valuations)) (if (null? profiles) #t (let ((deviations (check-dsic auction (car profiles) test-deviations))) (if (null? deviations) (loop (cdr profiles)) #f)))))"))
(task-entry (id "game-theory/evolutionary/average-fitness") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13221) (name average-fitness) (type "(-> SymmetricGame Population Number)") (description "") (notes ()) (section fitness) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses)) (answer "(define (average-fitness game pop) (average-fitness-from-list (all-fitnesses game pop) pop))"))
(task-entry (id "game-theory/mcdm/is-pareto-optimal?") (skill game-theory) (module mcdm) (tier 1) (difficulty 13221) (name is-pareto-optimal?) (type "") (description "") (notes ()) (section pareto-analysis) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated)) (answer "(define (is-pareto-optimal? dp alt) (member alt (pareto-frontier dp)))"))
(task-entry (id "game-theory/normal-form/make-mixed-strategy") (skill game-theory) (module normal-form) (tier 1) (difficulty 13222) (name make-mixed-strategy) (type "") (description "") (notes ()) (section mixed-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds is-pure-nash? find-pure-nash)) (answer "(define (make-mixed-strategy probs) (list->vector probs))"))
(task-entry (id "game-theory/extensive-form/terminal-nodes") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13222) (name terminal-nodes) (type "(-> Node (List TerminalNode))") (description "Collect all terminal nodes in the tree") (notes ()) (section tree-utilities) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size)) (answer "(define (terminal-nodes node) (cond ((terminal? node) (list node)) ((decision? node) (apply append (map terminal-nodes (decision-children node)))) ((chance? node) (apply append (map terminal-nodes (chance-children node))))))"))
(task-entry (id "game-theory/coop-games/imputation?") (skill game-theory) (module coop-games) (tier 1) (difficulty 13222) (name imputation?) (type "(-> CoopGame (Vector Real) Boolean)") (description "Is x an imputation for game g?") (notes ("Value games: x_i >= v({i}). Cost games: x_i <= c({i}).")) (section imputations) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total)) (answer "(define (imputation? g x) (let ((n (coop-game-players g)) (grand (coop-game-grand-coalition g)) (is-cost (coop-game-cost? g))) (and (= (allocation-total x) (coop-game-value g grand)) (let loop ((i 0)) (if (>= i n) #t (let ((x-i (vector-ref x i)) (v-i (coop-game-value g (coalition-singleton i)))) (and (if is-cost (<= x-i v-i) (>= x-i v-i)) (loop (+ i 1)))))))))"))
(task-entry (id "game-theory/matching/find-blocking-pair") (skill game-theory) (module matching) (tier 1) (difficulty 13222) (name find-blocking-pair) (type "") (description "") (notes ()) (section stability-verification) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r)) (answer "(define (find-blocking-pair market proposers receivers prop-to-recv recv-to-prop) (let ((n-prop (vector-length proposers))) (let p-loop ((i 0)) (if (= i n-prop) #f (let* ((p-id (vector-ref proposers i)) (p-match (assoc-ref prop-to-recv p-id)) (p-prefs (market-proposer-prefs market p-id))) (or (let r-loop ((prefs p-prefs)) (cond ((null? prefs) #f) ((equal? (car prefs) p-match) #f) (else (let* ((r-id (car prefs)) (r-match (assoc-ref recv-to-prop r-id)) (r-prefs (market-receiver-prefs market r-id))) (if (prefers-to? r-prefs p-id r-match) (cons p-id r-id) (r-loop (cdr prefs))))))) (p-loop (+ i 1))))))))"))
(task-entry (id "game-theory/voting/plurality-scores-all") (skill game-theory) (module voting) (tier 1) (difficulty 13222) (name plurality-scores-all) (type "") (description "") (notes ()) (section positional-rules) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner)) (answer "(define (plurality-scores-all profile) (let ((candidates (profile-candidates profile)) (scores (plurality-scores (profile-num-candidates profile)))) (map (lambda (c) (cons c (positional-score c profile scores))) candidates)))"))
(task-entry (id "game-theory/voting-games/power-per-capita") (skill game-theory) (module voting-games) (tier 1) (difficulty 13222) (name power-per-capita) (type "") (description "") (notes ()) (section electoral-college) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison power-concentration power-gini decisive-for-candidate map-indexed blocking-for-candidate make-electoral-college-game electoral-college-power)) (answer "(define (power-per-capita state-votes state-pops) (let* ((power (electoral-college-power state-votes)) (pop-lookup (lambda (name) (let ((found (assoc name state-pops))) (if found (cdr found) 1))))) (map (lambda (state-power) (let* ((name (car state-power)) (pwr (cdr state-power)) (pop (pop-lookup name))) (cons name (/ pwr pop)))) power)))"))
(task-entry (id "game-theory/multi-winner/pav-loop") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13222) (name pav-loop) (type "") (description "") (notes ()) (section pav) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners)) (answer "(define (pav-loop profile remaining elected seats-left) (if (or (= seats-left 0) (null? remaining)) (reverse elected) (let* ((scores (map (lambda (c) (cons c (pav-score c profile elected))) remaining)) (sorted (sort-by (lambda (a b) (> (cdr a) (cdr b))) scores)) (winner (caar sorted))) (pav-loop profile (remove winner remaining) (cons winner elected) (- seats-left 1)))))"))
(task-entry (id "game-theory/fair-division/binary-search-cut") (skill game-theory) (module fair-division) (tier 1) (difficulty 13222) (name binary-search-cut) (type "") (description "") (notes ()) (section cut-and-choose) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point)) (answer "(define (binary-search-cut c i target lo hi fuel) (if (<= fuel 0) (/ (+ lo hi) 2) (let* ((mid (/ (+ lo hi) 2)) (val (cake-valuation c i 0 mid))) (cond ((< (abs (- val target)) 1e-10) mid) ((< val target) (binary-search-cut c i target mid hi (- fuel 1))) (else (binary-search-cut c i target lo mid (- fuel 1)))))))"))
(task-entry (id "game-theory/mechanism/expected-revenue-uniform") (skill game-theory) (module mechanism) (tier 1) (difficulty 13222) (name expected-revenue-uniform) (type "(-> (-> (Vector Number) AuctionOutcome) Nat Nat Number)") (description "Estimate expected revenue with n bidders, valuations uniform on [0,1], via Monte Carlo") (notes ()) (section revenue-equivalence) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic)) (answer "(define (expected-revenue-uniform auction n num-samples) (let loop ((samples 0) (total 0.0)) (if (>= samples num-samples) (/ total num-samples) (let* ((valuations (make-vector n 0)) (_ (do ((i 0 (+ i 1))) ((= i n)) (vector-set! valuations i (random 1.0)))) (outcome (auction valuations)) (revenue (auction-outcome-revenue outcome))) (loop (+ samples 1) (+ total revenue))))))"))
(task-entry (id "game-theory/evolutionary/average-fitness-from-list") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13222) (name average-fitness-from-list) (type "") (description "") (notes ()) (section fitness) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness)) (answer "(define (average-fitness-from-list fitnesses pop) (let ((n (length fitnesses))) (let loop ((i 0) (sum 0)) (if (>= i n) sum (loop (+ i 1) (+ sum (* (pop-freq pop i) (list-ref fitnesses i))))))))"))
(task-entry (id "game-theory/mcdm/sensitivity-to-criterion") (skill game-theory) (module mcdm) (tier 1) (difficulty 13222) (name sensitivity-to-criterion) (type "(-> DecisionProblem Criterion (List Real) Real)") (description "Compute sensitivity of winner to criterion weight. Returns smallest delta (in either direction) before winner changes. Larger value = more robust") (notes ()) (section sensitivity-analysis) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal?)) (answer "(define (sensitivity-to-criterion dp criterion base-weights) (let* ((criteria (dp-criteria dp)) (idx (criterion-index criterion criteria)) (current-weight (list-ref base-weights idx)) (current-winner (weighted-borda-winner dp base-weights)) (step 0.1) (max-delta 10.0)) (if (not idx) (error 'sensitivity-to-criterion \"Unknown criterion\" criterion) (let ((find-break (lambda (direction) (let search ((delta step)) (if (> delta max-delta) max-delta (let* ((new-weight (+ current-weight (* direction delta))) (clamped-weight (max 0.001 new-weight)) (new-weights (list-update base-weights idx clamped-weight)) (new-winner (weighted-borda-winner dp new-weights))) (if (not (eq? new-winner current-winner)) delta (search (* delta 2))))))))) (let ((up-delta (find-break 1)) (down-delta (find-break -1))) (min up-delta down-delta))))))"))
(task-entry (id "game-theory/normal-form/pure-strategy") (skill game-theory) (module normal-form) (tier 1) (difficulty 13223) (name pure-strategy) (type "") (description "") (notes ()) (section mixed-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds is-pure-nash? find-pure-nash make-mixed-strategy)) (answer "(define (pure-strategy i n) (let ((v (make-vector n 0))) (vector-set! v i 1) v))"))
(task-entry (id "game-theory/extensive-form/backward-induction") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13223) (name backward-induction) (type "(-> Node (Values (List Number) (List (Pair Nat Symbol))))") (description "Solve by backward induction. Returns (payoffs, strategy-profile)") (notes ()) (section backward-induction) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes)) (answer "(define (backward-induction node) (backward-induction-helper node '()))"))
(task-entry (id "game-theory/coop-games/make-factorial-cache") (skill game-theory) (module coop-games) (tier 1) (difficulty 13223) (name make-factorial-cache) (type "(-> Nat (Vector Nat))") (description "Compute n! (memoized via vector cache)") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation?)) (answer "(define (make-factorial-cache max-n) (let ((cache (make-vector (+ max-n 1) 1))) (let loop ((i 1)) (when (<= i max-n) (vector-set! cache i (* i (vector-ref cache (- i 1)))) (loop (+ i 1)))) cache))"))
(task-entry (id "game-theory/matching/prefers-to?") (skill game-theory) (module matching) (tier 1) (difficulty 13223) (name prefers-to?) (type "") (description "") (notes ()) (section stability-verification) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair)) (answer "(define (prefers-to? prefs id1 id2) (if (not id2) (member id1 prefs) (let loop ((prefs prefs)) (cond ((null? prefs) #f) ((equal? (car prefs) id1) #t) ((equal? (car prefs) id2) #f) (else (loop (cdr prefs)))))))"))
(task-entry (id "game-theory/voting/borda-scores-all") (skill game-theory) (module voting) (tier 1) (difficulty 13223) (name borda-scores-all) (type "") (description "") (notes ()) (section positional-rules) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all)) (answer "(define (borda-scores-all profile) (let ((candidates (profile-candidates profile)) (scores (borda-scores (profile-num-candidates profile)))) (map (lambda (c) (cons c (positional-score c profile scores))) candidates)))"))
(task-entry (id "game-theory/voting-games/us-electoral-college-2020") (skill game-theory) (module voting-games) (tier 1) (difficulty 13223) (name us-electoral-college-2020) (type "") (description "") (notes ()) (section electoral-college) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison power-concentration power-gini decisive-for-candidate map-indexed blocking-for-candidate make-electoral-college-game electoral-college-power power-per-capita)) (answer "(define (us-electoral-college-2020) '((CA . 55) (TX . 38) (FL . 29) (NY . 29) (PA . 20) (IL . 20) (OH . 18) (GA . 16) (MI . 16) (NC . 15)))"))
(task-entry (id "game-theory/multi-winner/sav-score") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13223) (name sav-score) (type "") (description "") (notes ()) (section pav) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop)) (answer "(define (sav-score candidate profile) (apply + (map (lambda (approvals) (if (and (member candidate approvals) (> (length approvals) 0)) (/ 1 (length approvals)) 0)) profile)))"))
(task-entry (id "game-theory/fair-division/cut-and-choose") (skill game-theory) (module fair-division) (tier 1) (difficulty 13223) (name cut-and-choose) (type "") (description "") (notes ()) (section cut-and-choose) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut)) (answer "(define (cut-and-choose c fuel) (if (not (= 2 (cake-players c))) (error 'cut-and-choose \"requires exactly 2 players\") (let* ((cutter 0) (chooser 1) (cutter-total (cake-total-value c cutter)) (half-value (/ cutter-total 2)) (cut-point (find-cut-point c cutter half-value fuel)) (piece-left (piece-singleton 0 cut-point)) (piece-right (piece-singleton cut-point 1)) (chooser-left (piece-value c chooser piece-left)) (chooser-right (piece-value c chooser piece-right)) (div (make-division 2))) (if (>= chooser-left chooser-right) (begin (division-assign! div chooser piece-left) (division-assign! div cutter piece-right) div) (begin (division-assign! div chooser piece-right) (division-assign! div cutter piece-left) div)))))"))
(task-entry (id "game-theory/mechanism/vcg-combinatorial") (skill game-theory) (module mechanism) (tier 1) (difficulty 13223) (name vcg-combinatorial) (type "(-> (Vector (Vector Number)) Nat (Pair (Vector Nat) (Vector Number)))") (description "VCG mechanism for combinatorial auction with m items") (notes ("Items are allocated efficiently (maximize total value), payments = externality imposed on others. Complexity: O(n × 2^m) - exponential in items.")) (section vcg-mechanism) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform)) (answer "(define (vcg-combinatorial valuations m) (let* ((n (vector-length valuations)) (num-bundles (expt 2 m))) (let-values (((best-allocation best-welfare) (vcg-find-efficient-allocation valuations n m))) (let ((payments (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (let-values (((alloc-without-i welfare-without-i) (vcg-find-efficient-allocation-without valuations n m i))) (let ((others-welfare-with-i (- best-welfare (vector-ref (vector-ref valuations i) (vector-ref best-allocation i))))) (vector-set! payments i (- welfare-without-i others-welfare-with-i))))) (cons best-allocation payments)))))"))
(task-entry (id "game-theory/evolutionary/replicator-derivative") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13223) (name replicator-derivative) (type "(-> SymmetricGame Population (List Number))") (description "") (notes ()) (section replicator-dynamics) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list)) (answer "(define (replicator-derivative game pop) (let* ((n (sg-num-strategies game)) (fitnesses (all-fitnesses game pop)) (avg-fit (average-fitness-from-list fitnesses pop))) (map (lambda (i) (let ((xi (pop-freq pop i)) (fi (list-ref fitnesses i))) (* xi (- fi avg-fit)))) (iota n))))"))
(task-entry (id "game-theory/mcdm/criterion-index") (skill game-theory) (module mcdm) (tier 1) (difficulty 13223) (name criterion-index) (type "") (description "") (notes ()) (section sensitivity-analysis) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion)) (answer "(define (criterion-index c criteria) (let loop ((cs criteria) (i 0)) (cond ((null? cs) #f) ((eq? (car cs) c) i) (else (loop (cdr cs) (+ i 1))))))"))
(task-entry (id "game-theory/normal-form/uniform-strategy") (skill game-theory) (module normal-form) (tier 1) (difficulty 13224) (name uniform-strategy) (type "") (description "") (notes ()) (section mixed-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds is-pure-nash? find-pure-nash make-mixed-strategy pure-strategy)) (answer "(define (uniform-strategy n) (make-vector n (/ 1 n)))"))
(task-entry (id "game-theory/extensive-form/backward-induction-helper") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13224) (name backward-induction-helper) (type "") (description "") (notes ()) (section backward-induction) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction)) (answer "(define (backward-induction-helper node path) (cond ((terminal? node) (values (terminal-payoffs node) '())) ((decision? node) (let* ((player (decision-player node)) (actions (decision-actions node)) (children (decision-children node)) (results (map (lambda (child action) (let-values (((payoffs strat) (backward-induction-helper child (cons (cons player action) path)))) (list payoffs strat action))) children actions)) (best (fold-right (lambda (r best) (if (or (not best) (> (list-ref (car r) player) (list-ref (car best) player))) r best)) #f results))) (values (car best) (cons (cons player (caddr best)) (cadr best))))) ((chance? node) (let* ((outcomes (chance-outcomes node)) (probs (chance-probs node)) (children (chance-children node)) (results (map (lambda (child) (let-values (((payoffs strat) (backward-induction-helper child path))) payoffs)) children)) (n-players (length (car results))) (expected (let loop ((i 0) (acc '())) (if (>= i n-players) (reverse acc) (let ((exp-i (fold-right + 0 (map (lambda (p payoff-vec) (* p (list-ref payoff-vec i))) probs results)))) (loop (+ i 1) (cons exp-i acc))))))) (values expected '()))) (else (error 'backward-induction \"unknown node type\" node))))"))
(task-entry (id "game-theory/coop-games/shapley-weight") (skill game-theory) (module coop-games) (tier 1) (difficulty 13224) (name shapley-weight) (type "(-> Nat Nat (Vector Nat) Real)") (description "Weight for coalition of size s in game with n players: s!(n-s-1)!/n!") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache)) (answer "(define (shapley-weight s n fact-cache) (/ (* (vector-ref fact-cache s) (vector-ref fact-cache (- n s 1))) (vector-ref fact-cache n)))"))
(task-entry (id "game-theory/matching/make-assignment-game") (skill game-theory) (module matching) (tier 1) (difficulty 13224) (name make-assignment-game) (type "(-> Nat Nat (Nat Nat -> Real) CoopGame)") (description "Create assignment game from bipartite valuations. n = number of proposers (players 0 to n-1), m = number of receivers (players n to n+m-1), valuation(i, j) = value of matching proposer i with receiver j-n") (notes ()) (section assignment-games) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to?)) (answer "(define (make-assignment-game n m valuation) (let ((total-players (+ n m))) (make-coop-game total-players (lambda (S) (assignment-game-value n m valuation S)))))"))
(task-entry (id "game-theory/voting/pairwise-margin") (skill game-theory) (module voting) (tier 1) (difficulty 13224) (name pairwise-margin) (type "(-> Candidate Candidate PreferenceProfile Int)") (description "Number of voters preferring a over b, minus those preferring b over a. Positive = a beats b, negative = b beats a, zero = tie") (notes ()) (section condorcet-methods) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all)) (answer "(define (pairwise-margin a b profile) (let ((a-over-b (count-if (lambda (ranking) (let ((pa (position-of a ranking)) (pb (position-of b ranking))) (and pa pb (< pa pb)))) profile)) (b-over-a (count-if (lambda (ranking) (let ((pa (position-of a ranking)) (pb (position-of b ranking))) (and pa pb (< pb pa)))) profile))) (- a-over-b b-over-a)))"))
(task-entry (id "game-theory/voting-games/un-security-council") (skill game-theory) (module voting-games) (tier 1) (difficulty 13224) (name un-security-council) (type "") (description "") (notes ()) (section electoral-college) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison power-concentration power-gini decisive-for-candidate map-indexed blocking-for-candidate make-electoral-college-game electoral-college-power power-per-capita us-electoral-college-2020)) (answer "(define (un-security-council) (make-coop-game 15 (lambda (S) (let* ((p5-in? (lambda (i) (coalition-member? i S))) (all-p5-present? (and (p5-in? 0) (p5-in? 1) (p5-in? 2) (p5-in? 3) (p5-in? 4))) (size (coalition-size S))) (if (and all-p5-present? (>= size 9)) 1 0)))))"))
(task-entry (id "game-theory/multi-winner/sav-winners") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13224) (name sav-winners) (type "") (description "") (notes ()) (section pav) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score)) (answer "(define (sav-winners profile num-seats) (let* ((candidates (approval-profile-candidates profile)) (scores (map (lambda (c) (cons c (sav-score c profile))) candidates)) (sorted (sort-by (lambda (a b) (> (cdr a) (cdr b))) scores))) (take num-seats (map car sorted))))"))
(task-entry (id "game-theory/fair-division/dubins-spanier") (skill game-theory) (module fair-division) (tier 1) (difficulty 13224) (name dubins-spanier) (type "(-> Cake Nat Division)") (description "") (notes ()) (section dubins-spanier) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose)) (answer "(define (dubins-spanier c fuel) (let* ((n (cake-players c)) (div (make-division n))) (dubins-spanier-recurse c div (iota n) 0 1 n fuel) div))"))
(task-entry (id "game-theory/mechanism/vcg-find-efficient-allocation") (skill game-theory) (module mechanism) (tier 1) (difficulty 13224) (name vcg-find-efficient-allocation) (type "(-> (Vector (Vector Number)) Nat Nat (Values (Vector Nat) Number))") (description "Find welfare-maximizing allocation (brute force for small m)") (notes ()) (section vcg-mechanism) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial)) (answer "(define (vcg-find-efficient-allocation valuations n m) (let ((best-alloc (make-vector n 0)) (best-welfare -inf.0)) (vcg-enumerate-allocations n m (lambda (allocation) (let ((welfare (vcg-total-welfare valuations allocation))) (when (> welfare best-welfare) (set! best-welfare welfare) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! best-alloc i (vector-ref allocation i))))))) (values best-alloc best-welfare)))"))
(task-entry (id "game-theory/evolutionary/replicator-step") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13224) (name replicator-step) (type "(-> SymmetricGame Population Number Population)") (description "") (notes ()) (section replicator-dynamics) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population? pop-vec pop-size pop-freq pop->list uniform-population pure-population strategy-fitness all-fitnesses average-fitness average-fitness-from-list replicator-derivative)) (answer "(define (replicator-step game pop dt) (let* ((derivs (replicator-derivative game pop)) (new-freqs (map (lambda (i) (max 0 (+ (pop-freq pop i) (* dt (list-ref derivs i))))) (iota (pop-size pop))))) (make-population new-freqs)))"))
(task-entry (id "game-theory/mcdm/list-update") (skill game-theory) (module mcdm) (tier 1) (difficulty 13224) (name list-update) (type "") (description "") (notes ()) (section sensitivity-analysis) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze mcdm-copeland mcdm-condorcet mcdm-ranking weighted-borda-scores weighted-borda-winner dominates? pareto-frontier pareto-dominated is-pareto-optimal? sensitivity-to-criterion criterion-index)) (answer "(define (list-update lst idx val) (if (= idx 0) (cons val (cdr lst)) (cons (car lst) (list-update (cdr lst) (- idx 1) val))))"))
(task-entry (id "game-theory/normal-form/expected-payoff-p1") (skill game-theory) (module normal-form) (tier 1) (difficulty 13225) (name expected-payoff-p1) (type "") (description "") (notes ()) (section mixed-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2? is-strictly-dominated-p1? is-strictly-dominated-p2? find-dominated-strategies eliminate-strategy-p1 eliminate-strategy-p2 iesds is-pure-nash? find-pure-nash make-mixed-strategy pure-strategy uniform-strategy)) (answer "(define (expected-payoff-p1 game sigma1 sigma2) (let ((n1 (vector-length sigma1)) (n2 (vector-length sigma2))) (apply + (map (lambda (i) (apply + (map (lambda (j) (* (vector-ref sigma1 i) (vector-ref sigma2 j) (game-payoff-p1 game i j))) (iota n2)))) (iota n1)))))"))
(task-entry (id "game-theory/extensive-form/solve-spe") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13225) (name solve-spe) (type "(-> ExtensiveGame SPEResult)") (description "Find the subgame perfect equilibrium via backward induction") (notes ("For perfect information games, SPE is unique (generically)")) (section subgame-perfect-equilibrium) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff make-decision decision? decision-player decision-actions decision-children decision-child make-chance chance? chance-outcomes chance-probs chance-children make-extensive-game extensive-game? game-num-players game-root game-info-sets tree-depth tree-size terminal-nodes backward-induction backward-induction-helper)) (answer "(define (solve-spe game) (let-values (((payoffs strategy) (backward-induction (game-root game)))) (list 'spe-result payoffs strategy)))"))
(task-entry (id "game-theory/coop-games/shapley-value") (skill game-theory) (module coop-games) (tier 1) (difficulty 13225) (name shapley-value) (type "(-> CoopGame Nat (Vector Real))") (description "Compute Shapley value for all players") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight)) (answer "(define (shapley-value g fuel) (let* ((n (coop-game-players g)) (fact-cache (make-factorial-cache n)) (result (make-vector n 0))) (let player-loop ((i 0) (fuel fuel)) (if (or (>= i n) (<= fuel 0)) result (begin (let* ((player-bit (coalition-singleton i)) (phi-i (let coalition-loop ((S 0) (sum 0) (fuel fuel)) (if (or (>= S (bitwise-arithmetic-shift-left 1 n)) (<= fuel 0)) sum (if (coalition-member? i S) (coalition-loop (+ S 1) sum fuel) (let* ((s (coalition-size S)) (S-with-i (coalition-union S player-bit)) (marginal (- (coop-game-value g S-with-i) (coop-game-value g S))) (weight (shapley-weight s n fact-cache))) (coalition-loop (+ S 1) (+ sum (* weight marginal)) (- fuel 1)))))))) (vector-set! result i phi-i) (player-loop (+ i 1) fuel)))))))"))
(task-entry (id "game-theory/matching/assignment-game-value") (skill game-theory) (module matching) (tier 1) (difficulty 13225) (name assignment-game-value) (type "") (description "") (notes ()) (section assignment-games) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game)) (answer "(define (assignment-game-value n m valuation S) (let* ((props-in-S (filter (lambda (i) (coalition-member? i S)) (iota n))) (recvs-in-S (filter (lambda (j) (coalition-member? j S)) (map (lambda (k) (+ n k)) (iota m)))) (num-props (length props-in-S)) (num-recvs (length recvs-in-S))) (if (or (= num-props 0) (= num-recvs 0)) 0 (optimal-assignment-subset props-in-S recvs-in-S n valuation))))"))
(task-entry (id "game-theory/voting/pairwise-beats?") (skill game-theory) (module voting) (tier 1) (difficulty 13225) (name pairwise-beats?) (type "") (description "") (notes ()) (section condorcet-methods) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin)) (answer "(define (pairwise-beats? a b profile) (> (pairwise-margin a b profile) 0))"))
