(task-entry (id "dataset/distractor/distractor-random-choice") (skill dataset) (module distractor) (tier 1) (difficulty 13410) (name distractor-random-choice) (type "") (description "") (notes ()) (section builtin) (deps (\x27;prelude \x27;prng \x27;parameter \x27;sort)) (available (make-distractor-strategy distractor-strategy? distractor-strategy-name distractor-strategy-generator distractor-nearby distractor-sign-flip distractor-off-by-one distractor-double-half distractor-wrong-sign-convention distractor-order-swap)) (answer "(define (distractor-random-choice choices) (make-distractor-strategy 'random-choice (lambda (correct rng) (let ((others (filter (lambda (c) (not (equal? c correct))) choices))) (if (null? others) correct (list-ref others (prng-next-int rng (length others))))))))"))
