(task-entry (id "tiles/turns/calculate-initiative-order") (skill tiles) (module turns) (tier 1) (difficulty 12314) (name calculate-initiative-order) (type "(-> (List Unit) (List UnitId))") (description "Calculate turn order based on unit initiative. Higher initiative goes first, ties broken by ID.") (notes ()) (section initiative) (deps (\x27;sort)) (available (make-turn-state make-turn-state-from-game turn-current-unit turn-current-phase turn-number turn-actions-remaining turn-can-act? turn-spend-action turn-log-action turn-next-phase turn-next-unit turn-end-turn turn-history turn-recent-actions)) (answer "(define (calculate-initiative-order units) (let ((sorted (sort-by (lambda (u1 u2) (let ((init1 (unit-get-prop u1 'initiative 0)) (init2 (unit-get-prop u2 'initiative 0))) (if (= init1 init2) (string<? (symbol->string (unit%-id u1)) (symbol->string (unit%-id u2))) (> init1 init2)))) units))) (map unit%-id sorted)))"))
