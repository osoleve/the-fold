(task-entry (id "fp/solve/solve-quadratic") (skill fp) (module solve) (tier 1) (difficulty 10618) (name solve-quadratic) (type "(-> Expr Symbol (Maybe (List Expr)))") (description "Solve quadratic equation ax² + bx + c = 0 using quadratic formula") (notes ("Returns list of solutions, may include symbolic sqrt")) (section quadratic-solving) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms solve-linear)) (answer "(define (solve-quadratic expr var-sym) (let ((coeffs (extract-poly-coefficients expr var-sym))) (if (or (not coeffs) (not (= (length coeffs) 3))) #f (let* ((c (list-ref coeffs 0)) (b (list-ref coeffs 1)) (a (list-ref coeffs 2)) (disc (simplify (difference (power b (num 2)) (product (num 4) (product a c))))) (neg-b-over-2a (simplify (division (make-neg b) (product (num 2) a)))) (sqrt-disc-over-2a (simplify (division (sym-sqrt disc) (product (num 2) a))))) (list (simplify (sum neg-b-over-2a sqrt-disc-over-2a)) (simplify (difference neg-b-over-2a sqrt-disc-over-2a)))))))"))
