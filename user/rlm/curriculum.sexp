(task-entry (id "algebra/multivariate/mono-div-helper") (skill algebra) (module multivariate) (tier 0) (difficulty 313) (name mono-div-helper) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div)) (answer "(define (mono-div-helper m1 m2) (cond ((null? m2) m1) ((null? m1) '()) (else (let ((v1 (caar m1)) (e1 (cdar m1)) (v2 (caar m2)) (e2 (cdar m2))) (cond ((symbol<? v1 v2) (cons (car m1) (mono-div-helper (cdr m1) m2))) ((symbol<? v2 v1) (mono-div-helper m1 (cdr m2))) (else (let ((diff (- e1 e2))) (if (<= diff 0) (mono-div-helper (cdr m1) (cdr m2)) (cons (cons v1 diff) (mono-div-helper (cdr m1) (cdr m2)))))))))))"))
(task-entry (id "algebra/groebner/any") (skill algebra) (module groebner) (tier 0) (difficulty 313) (name any) (type "") (description "") (notes ()) (section s-polynomial) (deps (\x27;prelude \x27;multivariate)) (available (s-polynomial reduce-poly reduce-poly-full buchberger buchberger-loop buchberger-criterion-1? all-pairs reduce-basis mpoly-make-monic minimize-basis any-divides-lm? interreduce remove-equal)) (answer "(define (any pred lst) (cond ((null? lst) #f) ((pred (car lst)) #t) (else (any pred (cdr lst)))))"))
