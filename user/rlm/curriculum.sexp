(task-entry (id "physics/diff/diff-constraints/traced-constraint-step") (skill physics/diff) (module diff-constraints) (tier 2) (difficulty 23135) (name traced-constraint-step) (type "") (description "") (notes ()) (section spring-constraint) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body)) (available (traced-spring-force traced-spring-force-damped make-spring-constraint spring-constraint-body-a spring-constraint-anchor-a spring-constraint-body-b spring-constraint-anchor-b spring-constraint-rest-length spring-constraint-stiffness spring-constraint-damping *distance-constraint-stiffness* *distance-constraint-damping* make-distance-constraint make-anchor-constraint anchor-constraint-body anchor-constraint-local-anchor anchor-constraint-world-target anchor-constraint-stiffness anchor-constraint-damping traced-anchor-force make-revolute-joint revolute-joint-body-a revolute-joint-anchor-a revolute-joint-body-b revolute-joint-anchor-b revolute-joint-stiffness revolute-joint-damping traced-revolute-forces traced-angular-spring-torque constraint-type traced-apply-spring-constraint traced-apply-anchor-constraint traced-apply-revolute-joint traced-apply-constraint traced-apply-all-constraints)) (answer "(define (traced-constraint-step bodies constraints gravity dt iterations) (let loop ((current bodies) (i 0)) (if (>= i iterations) current (let* ((with-gravity (vector-map (lambda (body) (if (traced-body-static? body) body (traced-euler-step body gravity 0 dt))) current)) (with-constraints (traced-apply-all-constraints with-gravity constraints dt))) (loop with-constraints (+ i 1))))))"))
