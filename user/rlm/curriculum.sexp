(task-entry (id "numeric/interpolate/interp-linear") (skill numeric) (module interpolate) (tier 0) (difficulty 2504) (name interp-linear) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;numeric/polynomial)) (available (binary-search-segment binary-search-segment-vec lerp lerp-inverse)) (answer "(define (interp-linear points x) (cond ((null? points) 0) ((null? (cdr points)) (cdar points)) (else (let* ((xs (map car points)) (n (length xs)) (i (binary-search-segment xs x))) (cond ((<= x (car xs)) (cdar points)) ((>= x (list-ref xs (- n 1))) (cdr (list-ref points (- n 1)))) (else (let ((p0 (list-ref points i)) (p1 (list-ref points (+ i 1)))) (let ((x0 (car p0)) (y0 (cdr p0)) (x1 (car p1)) (y1 (cdr p1))) (lerp y0 y1 (lerp-inverse x0 x1 x))))))))))"))
