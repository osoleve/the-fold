(task-entry (id "optics/bidirectional/migration-flip") (skill optics) (module bidirectional) (tier 1) (difficulty 11011) (name migration-flip) (type "(-> Migration Migration)") (description "Reverse a migration: swap forward/backward and from/to versions.") (notes ()) (section reversal) (deps (\x27;profunctor-optics)) (available (make-migration migration? migration-name migration-from migration-to migration-iso migrate rollback migration-apply migration-compose migration-chain)) (answer "(define (migration-flip m) (let* ((iso (migration-iso m)) (flipped-iso (make-p-iso (p-iso-backward iso) (p-iso-forward iso))) (flipped-name (string->symbol (format \"~a-reversed\" (migration-name m))))) (make-migration flipped-name (migration-to m) (migration-from m) flipped-iso)))"))
