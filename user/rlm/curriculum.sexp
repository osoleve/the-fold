(task-entry (id "physics/classical3d/collision-detection3d/aabb3d-aabb3d?") (skill physics/classical3d) (module collision-detection3d) (tier 2) (difficulty 22408) (name aabb3d-aabb3d?) (type "") (description "") (notes ()) (section point-in-shape-tests) (deps (\x27;prelude \x27;vec3 \x27;shapes3d)) (available (point-in-aabb3d? point-in-sphere3d? point-in-box3d? closest-point-on-segment-3d closest-point-on-aabb3d closest-point-on-box3d sphere-sphere? sphere-sphere-manifold)) (answer "(define (aabb3d-aabb3d? a b) (let ((a-min (aabb3d-min a)) (a-max (aabb3d-max a)) (b-min (aabb3d-min b)) (b-max (aabb3d-max b))) (and (<= (vec3-x a-min) (vec3-x b-max)) (>= (vec3-x a-max) (vec3-x b-min)) (<= (vec3-y a-min) (vec3-y b-max)) (>= (vec3-y a-max) (vec3-y b-min)) (<= (vec3-z a-min) (vec3-z b-max)) (>= (vec3-z a-max) (vec3-z b-min)))))"))
