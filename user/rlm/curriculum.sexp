(task-entry (id "fp/poly-canonical/polynomial-expr?") (skill fp) (module poly-canonical) (tier 1) (difficulty 10602) (name polynomial-expr?) (type "") (description "") (notes ()) (section conversion) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial)) (answer "(define (polynomial-expr? expr var-sym) (cond ((num? expr) #t) ((var? expr) #t) ((sum? expr) (for-all (lambda (t) (polynomial-expr? t var-sym)) (sum-terms expr))) ((product? expr) (for-all (lambda (f) (polynomial-expr? f var-sym)) (product-factors expr))) ((difference? expr) (and (polynomial-expr? (diff-left expr) var-sym) (or (not (diff-right expr)) (polynomial-expr? (diff-right expr) var-sym)))) ((power? expr) (and (num? (pow-exp expr)) (integer? (num-val (pow-exp expr))) (>= (num-val (pow-exp expr)) 0) (or (and (var? (pow-base expr)) (eq? (var-name (pow-base expr)) var-sym)) (polynomial-expr? (pow-base expr) var-sym)))) (else #f)))"))
