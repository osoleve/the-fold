(task-entry (id "autodiff/differentiable-signal/traced-convolve-1d") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12714) (name traced-convolve-1d) (type "(-> (Vector Traced) (Vector Number) Symbol (Vector Traced))") (description "Traced convolution integrated with autodiff") (notes ()) (section traced-convolution) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real make-dft-re-local-grads make-dft-im-local-grads diff-dft diff-convolution)) (answer "(define (traced-convolve-1d signal kernel mode) (let* ((tape (vec-extract-tape signal)) (n (vector-length signal)) (m (vector-length kernel)) (signal-vals (vec-extract-values signal)) (output (convolve signal-vals kernel mode)) (output-len (vector-length output))) (if (not tape) output (let ((result (make-vector output-len)) (input-ids (let ((ids (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) ids) (vector-set! ids i (traced-id (vector-ref signal i))))))) (do ((i 0 (+ i 1))) ((= i output-len) result) (let* ((out-val (vector-ref output i)) (out-id (fresh-id)) (local-grads (make-conv-local-grads i n m kernel mode))) (reverse-tape-push! tape (list out-id 'conv1d (vector->list input-ids) local-grads)) (vector-set! result i (traced out-val out-id tape))))))))"))
