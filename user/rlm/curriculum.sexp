(task-entry (id "linalg/vec/vec-equal?") (skill linalg) (module vec) (tier 0) (difficulty 430) (name vec-equal?) (type "(-> (Vec a) (Vec a) Bool)") (description "Exact equality (short-circuits on first mismatch)") (notes ()) (section vector-comparisons) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop vec-slice vec-add vec-sub vec-mul vec-div vec-scale vec-negate vec-dot vec-norm-squared vec-norm vec-norm-l1 vec-norm-linf vec-normalize vec-distance)) (answer "(define (vec-equal? v1 v2) (and (= (vector-length v1) (vector-length v2)) (let ((n (vector-length v1))) (do ((i 0 (+ i 1)) (eq #t (and eq (equal? (vector-ref v1 i) (vector-ref v2 i))))) ((or (= i n) (not eq)) eq)))))"))
