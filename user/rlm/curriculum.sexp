(task-entry (id "info/entropy/sample-entropy") (skill info) (module entropy) (tier 1) (difficulty 11123) (name sample-entropy) (type "(-> (List α) Number)") (description "Estimate entropy from empirical frequency counts") (notes ()) (section entropy-estimation) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio binary-entropy joint-entropy conditional-entropy conditional-entropy-direct mutual-information mutual-information-from-joint compute-marginal-x compute-marginal-y cross-entropy kl-divergence symmetric-kl jensen-shannon-divergence gaussian-entropy uniform-entropy exponential-entropy laplace-entropy)) (answer "(define (sample-entropy samples) (if (null? samples) 0 (let* ((counts (count-occurrences samples)) (total (length samples)) (probs (map (lambda (c) (/ c total)) (map cdr counts)))) (entropy probs))))"))
