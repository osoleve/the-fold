(task-entry (id "physics/diff/diff-constraints/make-pendulum-system") (skill physics/diff) (module diff-constraints) (tier 2) (difficulty 23137) (name make-pendulum-system) (type "") (description "") (notes ()) (section spring-constraint) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body)) (available (traced-spring-force traced-spring-force-damped make-spring-constraint spring-constraint-body-a spring-constraint-anchor-a spring-constraint-body-b spring-constraint-anchor-b spring-constraint-rest-length spring-constraint-stiffness spring-constraint-damping *distance-constraint-stiffness* *distance-constraint-damping* make-distance-constraint make-anchor-constraint anchor-constraint-body anchor-constraint-local-anchor anchor-constraint-world-target anchor-constraint-stiffness anchor-constraint-damping traced-anchor-force make-revolute-joint revolute-joint-body-a revolute-joint-anchor-a revolute-joint-body-b revolute-joint-anchor-b revolute-joint-stiffness revolute-joint-damping traced-revolute-forces traced-angular-spring-torque constraint-type traced-apply-spring-constraint traced-apply-anchor-constraint traced-apply-revolute-joint traced-apply-constraint traced-apply-all-constraints traced-constraint-step vector-map)) (answer "(define (make-pendulum-system pivot length mass radius tape) (let* ((bob-pos (lift-vec2 (vec2 (vec2-x pivot) (- (vec2-y pivot) length)) tape)) (bob-vel (lift-vec2 (vec2-zero) tape)) (bob-angle (make-traced-var 0 tape)) (bob-omega (make-traced-var 0 tape)) (inertia (circle-inertia mass radius)) (bob (make-traced-body bob-pos bob-vel bob-angle bob-omega mass inertia)) (constraint (make-anchor-constraint 0 (lift-vec2-const (vec2-zero)) (lift-vec2-const pivot) *distance-constraint-stiffness* *distance-constraint-damping*))) (values bob constraint)))"))
