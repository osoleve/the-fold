(task-entry (id "fp/simplify/collect-like-terms") (skill fp) (module simplify) (tier 1) (difficulty 10605) (name collect-like-terms) (type "(-> (List Expr) (List Expr))") (description "Collect like terms: x + x → 2*x") (notes ()) (section sum-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums)) (answer "(define (collect-like-terms terms) (let ((table (make-hashtable equal-hash equal?))) (for-each (lambda (term) (let-values (((coef base) (extract-coefficient term))) (let ((current (hashtable-ref table base 0))) (hashtable-set! table base (+ current coef))))) terms) (let* ((keys (vector->list (hashtable-keys table))) (sorted-keys (sort-by (lambda (a b) (< (expr-complexity a) (expr-complexity b))) keys))) (filter-map (lambda (key) (let ((coef (hashtable-ref table key 0))) (cond ((= coef 0) #f) ((= coef 1) key) (else (product (num coef) key))))) sorted-keys))))"))
(task-entry (id "fp/integrate/integrate-basic") (skill fp) (module integrate) (tier 1) (difficulty 10605) (name integrate-basic) (type "(-> Expr Symbol Nat (Maybe Expr))") (description "Apply basic integration rules: sum, product with constants, difference, power") (notes ()) (section basic-integration-rules) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand?)) (answer "(define (integrate-basic expr var-sym depth) (cond ((sum? expr) (let ((integrated-terms (map (lambda (t) (integrate-internal t var-sym (+ depth 1))) (sum-terms expr)))) (if (for-all identity integrated-terms) (fold-left sum (car integrated-terms) (cdr integrated-terms)) #f))) ((product? expr) (integrate-product expr var-sym depth)) ((difference? expr) (if (diff-right expr) (let ((left-int (integrate-internal (diff-left expr) var-sym (+ depth 1))) (right-int (integrate-internal (diff-right expr) var-sym (+ depth 1)))) (if (and left-int right-int) (difference left-int right-int) #f)) (let ((int-inner (integrate-internal (diff-left expr) var-sym (+ depth 1)))) (if int-inner (make-neg int-inner) #f)))) ((power? expr) (integrate-power expr var-sym depth)) ((quotient? expr) (integrate-quotient expr var-sym depth)) (else #f)))"))
