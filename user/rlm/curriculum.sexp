(task-entry (id "numeric/interpolate/polyfit") (skill numeric) (module interpolate) (tier 0) (difficulty 2521) (name polyfit) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;numeric/polynomial)) (available (binary-search-segment binary-search-segment-vec lerp lerp-inverse interp-linear lagrange-basis interp-lagrange divided-differences interp-newton interp-hermite hermite-tangent-estimate thomas-algorithm cubic-spline-natural matrix-set! spline-eval interp-cubic-spline bezier-linear bezier-quadratic bezier-cubic bezier-general bezier-derivative)) (answer "(define (polyfit xs ys degree) (let* ((n (length xs)) (m (+ degree 1)) (A (make-matrix n m 0)) (b (make-matrix n 1 0))) (do ((i 0 (+ i 1)) (xs xs (cdr xs)) (ys ys (cdr ys))) ((= i n)) (let ((xi (car xs)) (yi (car ys))) (matrix-set! b i 0 yi) (let loop ((j 0) (xij 1)) (when (< j m) (matrix-set! A i (- m j 1) xij) (loop (+ j 1) (* xij xi)))))) (let* ((AT (matrix-transpose A)) (ATA (matrix-mul AT A)) (ATb (matrix-mul AT b)) (ATb-vec (matrix-col ATb 0)) (coeffs (matrix-solve ATA ATb-vec))) (make-poly coeffs))))"))
