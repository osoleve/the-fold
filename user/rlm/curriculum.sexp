(task-entry (id "dataset/sexp/join-strings") (skill dataset) (module sexp) (tier 1) (difficulty 13409) (name join-strings) (type "") (description "") (notes ()) (section pretty) (deps (core/base/prelude.ss lattice/dataset/sample.ss lattice/data/sort.ss)) (available (sample->canonical-sexp sort-alist canonical-sexp->sample dataset->sexp sexp->dataset sexp->string sexp->pretty-string pp-sexp sexp-length)) (answer "(define (join-strings strs sep) (if (null? strs) \"\" (let loop ((rest (cdr strs)) (acc (car strs))) (if (null? rest) acc (loop (cdr rest) (string-append acc sep (car rest)))))))"))
(task-entry (id "dataset/jsonl/json->value") (skill dataset) (module jsonl) (tier 1) (difficulty 13409) (name json->value) (type "") (description "") (notes ()) (section conversion) (deps (core/base/prelude.ss lattice/optics/optics.ss lattice/dataset/sample.ss)) (available (make-json-object json-object? json-object-pairs make-json-array json-array? json-array-items sample->json json->sample value->json)) (answer "(define (json->value v) (cond ((json-array? v) (map json->value (json-array-items v))) ((json-object? v) (map (lambda (p) (cons (string->symbol (car p)) (json->value (cdr p)))) (json-object-pairs v))) (else v)))"))
