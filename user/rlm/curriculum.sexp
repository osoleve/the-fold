(task-entry (id "fp/regex/regex-compile") (skill fp) (module regex) (tier 1) (difficulty 10661) (name regex-compile) (type "(-> RegexAST (List Char) FSM)") (description "Compile regex AST to NFA using Thompson's construction") (notes ()) (section thompson-construction) (deps (\x27;prelude \x27;parser \x27;fsm)) (available (*default-universe* regex-lit regex-lit? regex-lit-char regex-dot regex-dot? regex-class regex-class? regex-class-chars regex-class-negated? regex-seq regex-seq? regex-seq-exprs regex-alt regex-alt? regex-alt-exprs regex-star regex-star? regex-star-expr regex-plus regex-plus? regex-plus-expr regex-opt regex-opt? regex-opt-expr regex-group regex-group? regex-group-expr regex-empty regex-empty? regex-repeat regex-repeat? regex-repeat-expr regex-repeat-min regex-repeat-max regex-anchor regex-anchor? regex-anchor-type regex-lookahead regex-lookahead? regex-lookahead-expr regex-lookahead-positive? parse-escape parse-literal parse-dot parse-class parse-class-item parse-class-char parse-class-range parse-group parse-lookahead parse-anchor parse-interval parse-atom parse-postfix-op apply-postfix-op parse-postfix parse-seq parse-alt parse-regex regex-parse)) (answer "(define (regex-compile ast universe) (cond ((regex-empty? ast) (fsm-epsilon-lang)) ((regex-lit? ast) (fsm-char (regex-lit-char ast))) ((regex-dot? ast) (fsm-any-of universe)) ((regex-class? ast) (let ((chars (regex-class-chars ast)) (negated? (regex-class-negated? ast))) (if negated? (fsm-any-of (filter (lambda (c) (not (member c chars))) universe)) (fsm-any-of chars)))) ((regex-seq? ast) (let ((exprs (regex-seq-exprs ast))) (if (null? exprs) (fsm-epsilon-lang) (fold-left fsm-concat (regex-compile (car exprs) universe) (map (lambda (e) (regex-compile e universe)) (cdr exprs)))))) ((regex-alt? ast) (let ((exprs (regex-alt-exprs ast))) (cond ((null? exprs) (make-fsm '(dead) '() '() 'dead '())) ((and (pair? exprs) (for-all regex-lit? exprs)) (fsm-any-of (map regex-lit-char exprs))) (else (fold-left fsm-union (regex-compile (car exprs) universe) (map (lambda (e) (regex-compile e universe)) (cdr exprs))))))) ((regex-star? ast) (fsm-star (regex-compile (regex-star-expr ast) universe))) ((regex-plus? ast) (fsm-plus (regex-compile (regex-plus-expr ast) universe))) ((regex-opt? ast) (fsm-optional (regex-compile (regex-opt-expr ast) universe))) ((regex-group? ast) (regex-compile (regex-group-expr ast) universe)) ((regex-repeat? ast) (compile-repeat (regex-repeat-expr ast) (regex-repeat-min ast) (regex-repeat-max ast) universe)) ((regex-anchor? ast) (compile-anchor (regex-anchor-type ast))) ((regex-lookahead? ast) (compile-lookahead (regex-lookahead-expr ast) (regex-lookahead-positive? ast) universe)) (else (error 'regex-compile (format \"Unknown AST node: ~a\" ast)))))"))
(task-entry (id "fp/combinators/group-by") (skill fp) (module combinators) (tier 1) (difficulty 10661) (name group-by) (type "(-> (-> a b) (List a) (List (List a)))") (description "Group consecutive elements with same key") (notes ()) (section list-utilities) (deps (\x27;prelude \x27;sort)) (available (id identity const flip apply-fn compose2 compose pipe2 pipe >>> <<< curry2 uncurry2 curry3 uncurry3 partial partial2 rpartial on both pair-first pair-second bimap complement conjoin disjoin fst snd swap dup pair nothing just just? nothing? from-just maybe maybe-fmap maybe-bind filter-maybe cat-maybes sequence-maybe left right left? right? from-left from-right either either-fmap either-fmap-left either-bind from-either rights lefts partition-eithers head tail cons-if intersperse intercalate)) (answer "(define (group-by key xs) (if (null? xs) '() (let loop ((xs (cdr xs)) (current-key (key (car xs))) (current-group (list (car xs))) (groups '())) (if (null? xs) (reverse (cons (reverse current-group) groups)) (let ((k (key (car xs)))) (if (equal? k current-key) (loop (cdr xs) current-key (cons (car xs) current-group) groups) (loop (cdr xs) k (list (car xs)) (cons (reverse current-group) groups))))))))"))
