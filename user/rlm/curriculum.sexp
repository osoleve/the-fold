(task-entry (id "algebra/polynomial/poly-scalar-mul-int") (skill algebra) (module polynomial) (tier 0) (difficulty 335) (name poly-scalar-mul-int) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm poly-eval poly-derivative)) (answer "(define (poly-scalar-mul-int F c n) (let ((add (field-add-op F)) (zero (field-zero F))) (if (= n 0) zero (let loop ((i 1) (acc c)) (if (= i n) acc (loop (+ i 1) (add acc c)))))))"))
(task-entry (id "algebra/multivariate/mpoly-one") (skill algebra) (module multivariate) (tier 0) (difficulty 335) (name mpoly-one) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms assoc-mono update-assoc-mono mpoly-zero)) (answer "(define (mpoly-one F vars ordering) (make-mpoly F vars ordering (list (cons (field-one F) (mono-one)))))"))
