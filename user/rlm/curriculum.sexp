(task-entry (id "fp/solve/subst") (skill fp) (module solve) (tier 1) (difficulty 10633) (name subst) (type "") (description "") (notes ()) (section linear-systems) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms solve-linear solve-quadratic solve-cubic solve-polynomial diff-to-sum solve solve-for solve-linear-system build-coefficient-matrix augment-with-constants gaussian-eliminate-symbolic find-nonzero-pivot is-zero-expr? swap-rows eliminate-below back-substitute-symbolic)) (answer "(define (subst expr var-sym val) (cond ((num? expr) expr) ((var? expr) (if (eq? (var-name expr) var-sym) val expr)) ((sum? expr) (make-sum (map (lambda (t) (subst t var-sym val)) (sum-terms expr)))) ((product? expr) (make-product (map (lambda (f) (subst f var-sym val)) (product-factors expr)))) ((difference? expr) (if (diff-right expr) (difference (subst (diff-left expr) var-sym val) (subst (diff-right expr) var-sym val)) (make-neg (subst (diff-left expr) var-sym val)))) ((quotient? expr) (division (subst (quot-numer expr) var-sym val) (subst (quot-denom expr) var-sym val))) ((power? expr) (power (subst (pow-base expr) var-sym val) (subst (pow-exp expr) var-sym val))) ((app? expr) (make-app (app-fn expr) (subst (app-arg expr) var-sym val))) (else expr)))"))
(task-entry (id "fp/units/qty-sqrt") (skill fp) (module units) (tier 1) (difficulty 10633) (name qty-sqrt) (type "(-> Quantity (Maybe Quantity))") (description "Square root (dimension exponents must be even).") (notes ()) (section quantity-arithmetic) (deps (\x27;prelude)) (available (make-dim dim-length dim-time dim-mass dim-current dim-temperature dim-amount dim-luminosity dim? dim=? dim-one dim-length-base dim-time-base dim-mass-base dim-current-base dim-temperature-base dim-amount-base dim-luminosity-base dim* dim/ dim-pow dim-sqrt dim-inv make-qty qty-value qty-dim qty? qty+ qty- qty* qty/ qty-scale qty-pow)) (answer "(define (qty-sqrt q) (let ((new-dim (dim-sqrt (qty-dim q)))) (if new-dim (make-qty (sqrt (qty-value q)) new-dim) #f)))"))
(task-entry (id "fp/cost-analysis/collect-costs") (skill fp) (module cost-analysis) (tier 1) (difficulty 10633) (name collect-costs) (type "(-> Expr Position Nat (List (Position Cost Expr)))") (description "Collect costs of all subexpressions with their positions.") (notes ()) (section hotspot-detection) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost *form-costs* form-cost *estimate-work-fuel* estimate-work estimate-work-with-fuel estimate-let-work estimate-branch-work estimate-cond-work estimate-hof-work estimate-list-size parallel-beneficial? parallel-beneficial-n? suggested-parallelism work-analysis work-analysis? analysis-total-cost analysis-complexity-class analysis-hotspots analysis-parallelizable? analysis-suggested-splits expr-complexity-class classify-complexity combine-complexity find-hotspots)) (answer "(define (collect-costs expr pos fuel) (if (<= fuel 0) '() (let ((cost (estimate-work expr))) (if (pair? expr) (let* ((this (list pos cost expr)) (children (let loop ((items (cdr expr)) (i 1) (acc '())) (if (or (null? items) (not (pair? items))) acc (let ((child-costs (collect-costs (car items) (append pos (list i)) (- fuel 1)))) (loop (cdr items) (+ i 1) (append acc child-costs))))))) (cons this children)) (list (list pos cost expr))))))"))
