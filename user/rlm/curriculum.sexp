(task-entry (id "game-theory/fair-division/cake-valuation") (skill game-theory) (module fair-division) (tier 1) (difficulty 13204) (name cake-valuation) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation!)) (answer "(define (cake-valuation c i a b) (let* ((a (max 0 (min 1 a))) (b (max 0 (min 1 b)))) (if (>= a b) 0 (let ((density (vector-ref (cake%-valuations c) i))) (if (not density) (- b a) (integrate-density density a b 100))))))"))
