then-val) ((eq? test-val #f) else-val) (else (quasiquote (if (unquote test-val) (unquote then-val) (unquote else-val))))))) ((and (eq? (car expr) 'let) (null? (cadr expr))) (simplify (caddr expr))) ((and (pair? (car expr)) (eq? (caar expr) 'lambda) (= (length (cadar expr)) 1) (= (length expr) 2) (pe-static-value? (cadr expr))) (simplify (subst-expr (caddar expr) (caadar expr) (cadr expr)))) ((pair? expr) (map simplify expr)) (else expr)))"))
