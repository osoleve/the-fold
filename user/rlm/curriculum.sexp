(task-entry (id "data/set/set-member?") (skill data) (module set) (tier 0) (difficulty 1302) (name set-member?) (type "(-> α Set Boolean)") (description "Check if element is in set") (notes ()) (section none) (deps (\x27;prelude)) (available (set-empty set-empty?)) (answer "(define (set-member? elem set) (cond ((null? set) #f) ((equal? elem (car set)) #t) (else (set-member? elem (cdr set)))))"))
