(task-entry (id "autodiff/typed-gradients/safe-gradient") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12711) (name safe-gradient) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn)) (answer "(define (safe-gradient spec args) (if (not (gradient-spec? spec)) (list 'error 'invalid-gradient-spec spec) (let ((expected-input-dim (gradient-spec-input-dim spec)) (expected-output-dim (gradient-spec-output-dim spec)) (f (gradient-spec-fn spec)) (actual-input-dim (length args))) (cond ((not (= expected-input-dim actual-input-dim)) (list 'error 'input-dimension-mismatch (list 'expected expected-input-dim) (list 'got actual-input-dim))) ((not (= expected-output-dim 1)) (list 'error 'not-a-scalar-function (list 'output-dim expected-output-dim) (list 'hint \"Use safe-jacobian for vector-valued functions\"))) (else (let ((raw-gradient (gradient f args))) (dim-gradient expected-input-dim raw-gradient)))))))"))
(task-entry (id "autodiff/profiling/time-gradient") (skill autodiff) (module profiling) (tier 1) (difficulty 12711) (name time-gradient) (type "") (description "") (notes ()) (section tape-statistics) (deps (\x27;prelude \x27;comp-graph \x27;reverse-diff \x27;sort)) (available (tape-stats tape-size tape-op-count graph-stats graph-edge-count graph-depth extract-input-ids find-node-id tally-ops current-microseconds time-thunk)) (answer "(define (time-gradient f args) (with-fresh-ad-scope (lambda () (let* ((tape (make-reverse-tape)) (traced-args (map (lambda (x) (make-traced-var x tape)) args)) (forward-start (current-microseconds)) (result (apply f traced-args)) (forward-end (current-microseconds)) (forward-time (- forward-end forward-start))) (if (traced? result) (let* ((val (traced-value result)) (result-id (traced-id result)) (arg-ids (map traced-id traced-args)) (backward-start (current-microseconds)) (grads-table (backward tape result-id 1)) (backward-end (current-microseconds)) (backward-time (- backward-end backward-start)) (grads (map (lambda (id) (if (= id result-id) 1 (hashtable-ref grads-table id 0))) arg-ids))) (list (cons 'value val) (cons 'gradient grads) (cons 'forward-us forward-time) (cons 'backward-us backward-time) (cons 'total-us (+ forward-time backward-time)) (cons 'tape-size (tape-size tape)))) (list (cons 'value result) (cons 'gradient (map (lambda (_) 0) args)) (cons 'forward-us forward-time) (cons 'backward-us 0) (cons 'total-us forward-time) (cons 'tape-size 0)))))))"))
(task-entry (id "autodiff/symbolic-diff/collect-like-terms") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12711) (name collect-like-terms) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric)) (answer "(define (collect-like-terms terms) (let ((table (make-hashtable equal-hash equal?))) (for-each (lambda (term) (let-values (((coef base) (extract-coefficient term))) (let ((current (hashtable-ref table base 0))) (hashtable-set! table base (+ current coef))))) terms) (let ((keys (hashtable-keys table))) (filter-map (lambda (key) (let ((coef (hashtable-ref table key 0))) (cond ((= coef 0) #f) ((= coef 1) key) (else (product (num coef) key))))) (vector->list keys)))))"))
(task-entry (id "autodiff/interval-autodiff/interval-tape-push!") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12711) (name interval-tape-push!) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries)) (answer "(define (interval-tape-push! tape entry) (set-box! (cadr tape) (cons entry (unbox (cadr tape)))))"))
(task-entry (id "autodiff/traced-optics/optimize-traversal") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12711) (name optimize-traversal) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value untrace-value lift-at-optic traversal-over-indexed optic-gradient extract-gradient zero-like optic-gradient-list optic-gradient-maybe grad-at optimize-at)) (answer "(define (optimize-traversal trav s loss-fn rate) (let* ((grads (optic-gradient-list loss-fn trav s)) (focuses (traversal-to-list trav s)) (new-vals (map (lambda (v g) (subtract-scaled v g rate)) focuses grads))) (cond ((and (list? s) (eq? trav traversal-each)) new-vals) (else (let ((queue new-vals)) (traversal-over trav (lambda (_) (if (null? queue) (error 'optimize-traversal \"Queue exhausted\") (let ((v (car queue))) (set! queue (cdr queue)) v))) s))))))"))
