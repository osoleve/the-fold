(task-entry (id "egraph/union-find/uf-size") (skill egraph) (module union-find) (tier 1) (difficulty 10008) (name uf-size) (type "(-> UnionFind Nat)") (description "Total number of elements in the union-find.") (notes ()) (section structure) (deps (\x27;prelude)) (available (uf-tag make-uf uf? uf-parent uf-rank uf-count-box uf-next-id-box uf-count)) (answer "(define (uf-size uf) (unbox (uf-next-id-box uf)))"))
(task-entry (id "egraph/eclass/enode-hash") (skill egraph) (module eclass) (tier 1) (difficulty 10008) (name enode-hash) (type "(-> ENode Fixnum)") (description "Compute hash of an e-node for hashconsing.") (notes ()) (section canonical) (deps (\x27;prelude \x27;egraph/union-find)) (available (enode-tag make-enode enode? enode-op enode-children enode-arity enode-canonicalize enode-equal?)) (answer "(define (enode-hash enode) (let* ((op (enode-op enode)) (children (enode-children enode)) (op-hash (cond ((symbol? op) (fxand (symbol-hash op) 16777215)) ((number? op) (modulo (abs (exact (truncate op))) 16777216)) ((string? op) (fxand (string-hash op) 16777215)) ((boolean? op) (if op 1 0)) ((char? op) (fxand (char->integer op) 16777215)) (else (fxand (equal-hash op) 16777215))))) (do ((i 0 (+ i 1)) (acc op-hash (fxand (+ (* acc 31) (vector-ref children i)) 16777215))) ((>= i (vector-length children)) acc))))"))
(task-entry (id "egraph/egraph/egraph-stat-adds") (skill egraph) (module egraph) (tier 1) (difficulty 10008) (name egraph-stat-adds) (type "") (description "") (notes ()) (section structure) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats)) (answer "(define (egraph-stat-adds eg) (vector-ref (egraph-stats eg) 0))"))
(task-entry (id "egraph/match/ematch-pattern") (skill egraph) (module match) (tier 1) (difficulty 10008) (name ematch-pattern) (type "(-> EGraph Pattern EClassId Substitution (List Substitution))") (description "Match pattern against e-class, return all valid substitutions.") (notes ()) (section matching) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge)) (answer "(define (ematch-pattern eg pattern class-id subst) (let ((root (egraph-find eg class-id))) (cond ((pattern-var? pattern) (let ((new-subst (subst-try-extend subst pattern root))) (if new-subst (list new-subst) '()))) ((or (symbol? pattern) (number? pattern)) (let ((nodes (egraph-class-nodes eg root))) (if (exists (lambda (node) (and (eqv? (enode-op node) pattern) (zero? (enode-arity node)))) nodes) (list subst) '()))) ((pair? pattern) (let ((op (car pattern)) (arg-patterns (cdr pattern)) (nodes (egraph-class-nodes eg root))) (let ((matching-nodes (filter (lambda (node) (and (eqv? (enode-op node) op) (= (enode-arity node) (length arg-patterns)))) nodes))) (append-map (lambda (node) (ematch-children eg arg-patterns (vector->list (enode-children node)) subst)) matching-nodes)))) (else '()))))"))
(task-entry (id "egraph/saturation/make-saturation-result") (skill egraph) (module saturation) (tier 1) (difficulty 10008) (name make-saturation-result) (type "(-> Symbol Nat Nat Nat Nat SaturationResult)") (description "Create saturation result.") (notes ()) (section result) (deps (\x27;prelude \x27;egraph/match)) (available (saturation-config-tag make-saturation-config saturation-config? config-fuel config-node-limit config-iter-limit default-saturation-config saturation-result-tag)) (answer "(define (make-saturation-result status iterations rules-applied final-classes final-nodes) (vector saturation-result-tag status iterations rules-applied final-classes final-nodes))"))
(task-entry (id "egraph/cost/ast-size-cost") (skill egraph) (module cost) (tier 1) (difficulty 10008) (name ast-size-cost) (type "") (description "") (notes ()) (section basic-models) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs compute-node-cost class-cost)) (answer "(define ast-size-cost (make-cost-model 'ast-size (lambda (node child-cost) (let ((children (enode-children node))) (+ 1 (fold-left (lambda (acc i) (+ acc (child-cost (vector-ref children i)))) 0 (iota (vector-length children))))))))"))
(task-entry (id "egraph/extract/extract-all") (skill egraph) (module extract) (tier 1) (difficulty 10008) (name extract-all) (type "(-> ExtractionState (List (Pair ClassId Term)))") (description "Extract optimal terms for all root e-classes.") (notes ()) (section extract) (deps (\x27;prelude \x27;egraph/cost \x27;egraph/saturation)) (available (extraction-state-tag make-extraction-state extraction-state? state-egraph state-costs state-best-nodes extract extract-term)) (answer "(define (extract-all state) (let* ((eg (state-egraph state)) (uf (egraph-uf eg))) (map (lambda (root) (cons root (extract state root))) (uf-roots uf))))"))
