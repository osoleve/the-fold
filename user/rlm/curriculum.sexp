(task-entry (id "optimization/newton/newton-cg-full") (skill optimization) (module newton) (tier 1) (difficulty 12807) (name newton-cg-full) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton make-positive-definite newton-cg)) (answer "(define (newton-cg-full f x0 criteria max-cg-iters cg-tol) (let* ((init-grad (gradient f x0)) (init-f (apply f x0)) (init-state (initial-convergence-state init-f init-grad))) (let loop ((x x0) (state init-state)) (let ((reason (converged? criteria state))) (if reason (make-opt-result x (cs-f-val state) (gradient f x) (cs-iter state) reason) (let* ((grad (gradient f x)) (n (length x)) (direction (cg-newton-direction f x grad max-cg-iters cg-tol)) (ls-result (armijo-backtrack f x grad direction)) (x-new (car ls-result)) (f-new (apply f x-new)) (grad-new (gradient f x-new)) (new-state (update-convergence-state state f-new grad-new x x-new))) (loop x-new new-state)))))))"))
(task-entry (id "optimization/lbfgs/lbfgs-history-push") (skill optimization) (module lbfgs) (tier 1) (difficulty 12807) (name lbfgs-history-push) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list)) (answer "(define (lbfgs-history-push h s y) (let* ((ys (dot-product y s)) (_ (if (<= ys 1e-10) h #f))) (if (and _ (<= ys 1e-10)) h (let* ((rho (/ 1.0 ys)) (max-size (lh-max-size h)) (old-size (lh-size h)) (new-size (min (+ old-size 1) max-size)) (s-list (take-n (cons s (lh-s-list h)) max-size)) (y-list (take-n (cons y (lh-y-list h)) max-size)) (rho-list (take-n (cons rho (lh-rho-list h)) max-size))) (list 'lbfgs-history max-size new-size s-list y-list rho-list)))))"))
(task-entry (id "optimization/optimize/rastrigin") (skill optimization) (module optimize) (tier 1) (difficulty 12807) (name rastrigin) (type "") (description "") (notes ()) (section test-functions) (deps (\x27;prelude \x27;convergence \x27;line-search \x27;first-order \x27;newton \x27;lbfgs)) (available (minimize minimize-bounded find-learning-rate minimize-callback rosenbrock rosenbrock-traced sphere)) (answer "(define (rastrigin args) (let ((n (length args)) (pi 3.141592653589793)) (+ (* 10 n) (fold-left + 0 (map (lambda (x) (- (* x x) (* 10 (cos (* 2 pi x))))) args)))))"))
