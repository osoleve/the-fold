(task-entry (id "numeric/dft/idft-naive") (skill numeric) (module dft) (tier 0) (difficulty 2505) (name idft-naive) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;vec)) (available (power-of-2? log2-int bit-reverse bit-reverse-copy dft-naive)) (answer "(define (idft-naive X) (let* ((n (vector-length X)) (result (make-vector n)) (two-pi (* 2 (pi-value)))) (do ((m 0 (+ m 1))) ((= m n) result) (let ((sum (complex-zero))) (do ((k 0 (+ k 1))) ((= k n) (vector-set! result m (complex-scale (/ 1.0 n) sum))) (let* ((angle (/ (* two-pi k m) n)) (twiddle (make-polar 1 angle)) (term (complex-mul (vector-ref X k) twiddle))) (set! sum (complex-add sum term))))))))"))
(task-entry (id "numeric/window-functions/bessel-i0") (skill numeric) (module window-functions) (tier 0) (difficulty 2505) (name bessel-i0) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (rectangular-window hann-window hamming-window blackman-window bartlett-window)) (answer "(define (bessel-i0 x) (let ((half-x (/ x 2))) (let loop ((k 0) (term 1.0) (sum 1.0)) (if (> k 100) sum (let* ((k+1 (+ k 1)) (new-term (* term (/ (* half-x half-x) (* k+1 k+1))))) (if (< new-term 1e-10) sum (loop k+1 new-term (+ sum new-term))))))))"))
(task-entry (id "numeric/digital-filters/bessel-i0") (skill numeric) (module digital-filters) (tier 0) (difficulty 2505) (name bessel-i0) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window)) (answer "(define (bessel-i0 x) (let ((ax (abs x))) (if (< ax 3.75) (let* ((y (/ (* x x) 14.0625)) (t (* y y))) (+ 1.0 (* y (+ 3.5156229 (* t (+ 3.0899424 (* t (+ 1.2067492 (* t (+ 0.2659732 (* t (+ 0.0360768 (* t 0.0045813))))))))))))) (let* ((y (/ 3.75 ax)) (t (* y y))) (* (/ (exp ax) (sqrt ax)) (+ 0.39894228 (* t (+ 0.01328592 (* t (+ 0.00225319 (* t (+ -0.00157565 (* t (+ 0.00916281 (* t (+ -0.02057706 (* t (+ 0.02635537 (* t (+ -0.01647633 (* t 0.00392377)))))))))))))))))))))"))
(task-entry (id "numeric/convolution/correlate-direct") (skill numeric) (module convolution) (tier 0) (difficulty 2505) (name correlate-direct) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;vec)) (available (convolve-direct-full convolve-direct-same convolve-direct-valid convolve-fft convolve)) (answer "(define (correlate-direct signal kernel mode) (let* ((n (vector-length signal)) (m (vector-length kernel))) (case mode ((full) (let* ((output-len (+ n m -1)) (result (make-vector output-len 0))) (do ((i 0 (+ i 1))) ((= i output-len) result) (let ((sum 0)) (do ((j 0 (+ j 1))) ((= j m) (vector-set! result i sum)) (let ((k (- i (- m 1) (- j)))) (when (and (>= k 0) (< k n)) (set! sum (+ sum (* (vector-ref signal k) (vector-ref kernel j))))))))))) ((same) (let* ((result (make-vector n 0)) (offset (quotient m 2))) (do ((i 0 (+ i 1))) ((= i n) result) (let ((sum 0)) (do ((j 0 (+ j 1))) ((= j m) (vector-set! result i sum)) (let ((k (+ i j (- offset)))) (when (and (>= k 0) (< k n)) (set! sum (+ sum (* (vector-ref signal k) (vector-ref kernel j))))))))))) ((valid) (let* ((output-len (max 0 (+ (- n m) 1))) (result (make-vector output-len 0))) (do ((i 0 (+ i 1))) ((= i output-len) result) (let ((sum 0)) (do ((j 0 (+ j 1))) ((= j m) (vector-set! result i sum)) (set! sum (+ sum (* (vector-ref signal (+ i j)) (vector-ref kernel j))))))) result)) (else (error 'correlate-direct \"invalid mode\" mode)))))"))
