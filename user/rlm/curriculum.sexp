(task-entry (id "numeric/fem/sparse-pcg") (skill numeric) (module fem) (tier 0) (difficulty 2526) (name sparse-pcg) (type "") (description "") (notes ()) (section sparse-cg) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients element-stiffness element-mass element-load assemble-stiffness assemble-mass assemble-load find-boundary-nodes apply-dirichlet-bc! apply-dirichlet-penalty! *fem-tolerance* *fem-max-iterations* sparse-cg sparse-cg-loop sparse-csr-diagonal vec-div-pointwise)) (answer "(define (sparse-pcg A b x0) (let* ((n (sparse-csr-rows A)) (tol *fem-tolerance*) (max-iter (min *fem-max-iterations* (* 2 n))) (M (sparse-csr-diagonal A)) (Ax0 (sparse-csr-vec-mul A x0)) (r (vec-sub b Ax0)) (z (vec-div-pointwise r M)) (p (vector-copy z)) (rz (vec-dot r z))) (if (< (sqrt (vec-dot r r)) tol) (list x0 (sqrt (vec-dot r r)) 0) (sparse-pcg-loop A b (vector-copy x0) r z p rz M 0 max-iter tol n))))"))
(task-entry (id "numeric/pde-time/sparse-csr-diagonal-vec") (skill numeric) (module pde-time) (tier 0) (difficulty 2526) (name sparse-csr-diagonal-vec) (type "") (description "") (notes ()) (section factory) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step mol-rk4-step cfl-parabolic cfl-hyperbolic estimate-mesh-spacing adaptive-euler-step integrate-adaptive sparse-csr-identity sparse-cg-solve cg-loop make-time-stepper)) (answer "(define (sparse-csr-diagonal-vec A) (let* ((n (sparse-csr-rows A)) (row-ptrs (sparse-csr-row-ptrs A)) (col-indices (sparse-csr-col-indices A)) (vals (sparse-csr-values A)) (diag (make-vector n 0.0))) (do ((i 0 (+ i 1))) ((= i n) diag) (let ((start (vector-ref row-ptrs i)) (end (vector-ref row-ptrs (+ i 1)))) (do ((k start (+ k 1))) ((= k end)) (when (= (vector-ref col-indices k) i) (vector-set! diag i (vector-ref vals k))))))))"))
