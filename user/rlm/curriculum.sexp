(task-entry (id "fp/free/run-kv") (skill fp) (module free) (tier 1) (difficulty 10626) (name run-kv) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators)) (available (pure-free free pure-free? free-suspended? from-pure-free from-free free-map make-free-queue free-queue? free-queue-base free-queue-fmap free-queue-conts free-bind free-normalize free-apply-queue free-apply-queue-step free-then free-ap lift-free fold-free iter-free run-free kv-get kv-put kv-delete kv-fmap)) (answer "(define (run-kv program) (lambda (store) (cond ((pure-free? program) (cons (from-pure-free program) store)) ((free-queue? program) ((run-kv (free-normalize kv-fmap program)) store)) (else (let* ((cmd (from-free program)) (tag (car cmd))) (cond ((eq? tag 'get) (let* ((key (cadr cmd)) (k (caddr cmd)) (pair (assoc key store)) (value (if pair (just (cdr pair)) nothing)) (next (k value))) ((run-kv next) store))) ((eq? tag 'put) (let* ((key (cadr cmd)) (val (caddr cmd)) (next (cadddr cmd)) (new-store (cons (cons key val) (filter (lambda (p) (not (equal? (car p) key))) store)))) ((run-kv next) new-store))) ((eq? tag 'delete) (let* ((key (cadr cmd)) (next (caddr cmd)) (new-store (filter (lambda (p) (not (equal? (car p) key))) store))) ((run-kv next) new-store))) (else (error 'run-kv \"Unknown command\"))))))))"))
