(task-entry (id "linalg/graph-laplacian/spectral-clustering") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 422) (name spectral-clustering) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue is-bipartite-spectral? effective-resistance total-effective-resistance laplacian-summary)) (answer "(define (spectral-clustering adj k) (let* ((n (adjacency-matrix-node-count adj)) (L-sym (laplacian-normalized adj)) (result (symmetric-eigen L-sym))) (if (and (pair? result) (eq? (car result) 'error)) result (let* ((eigenvalues (car result)) (eigenvectors (cdr result)) (k-indices (k-smallest-indices eigenvalues k)) (embedding (spectral-embedding eigenvectors k-indices n))) (kmeans-cluster embedding k)))))"))
(task-entry (id "linalg/svd/sort-vector-descending") (skill linalg) (module svd) (tier 0) (difficulty 422) (name sort-vector-descending) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin matrix-slice-cols matrix-slice pseudoinverse build-sigma-pseudoinverse low-rank-approx matrix-rank matrix-condition-number singular-values)) (answer "(define (sort-vector-descending v) (let* ((n (vector-length v)) (result (make-vector n 0)) (_ (do ((i 0 (+ i 1))) ((= i n)) (vector-set! result i (vector-ref v i))))) (do ((i 0 (+ i 1))) ((= i n) result) (do ((j (+ i 1) (+ j 1))) ((= j n)) (when (< (vector-ref result i) (vector-ref result j)) (let ((temp (vector-ref result i))) (vector-set! result i (vector-ref result j)) (vector-set! result j temp)))))))"))
