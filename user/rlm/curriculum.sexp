(task-entry (id "optimization/interval-contract/contract-linear-var") (skill optimization) (module interval-contract) (tier 1) (difficulty 12808) (name contract-linear-var) (type "") (description "") (notes ()) (section linear-contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract)) (answer "(define (contract-linear-var iv coef rhs other-lo other-hi) (let ((lo (interval-lo iv)) (hi (interval-hi iv))) (cond ((> coef 0) (let* ((upper-bound (/ (- rhs other-lo) coef)) (new-hi (min hi upper-bound))) (if (> lo new-hi) 'empty (interval lo new-hi)))) ((< coef 0) (let* ((lower-bound (/ (- rhs other-lo) coef)) (new-lo (max lo lower-bound))) (if (> new-lo hi) 'empty (interval new-lo hi)))) (else iv))))"))
(task-entry (id "optimization/interval-newton/interval-newton-step-rigorous") (skill optimization) (module interval-newton) (tier 1) (difficulty 12808) (name interval-newton-step-rigorous) (type "(-> (-> Interval Interval) (-> Interval Interval) Interval NewtonStepResult)") (description "") (notes ()) (section newton-operator) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step)) (answer "(define (interval-newton-step-rigorous f-iv f-deriv-iv X) (let* ((m (interval-mid X)) (m-iv (interval-singleton m)) (fm-iv (f-iv m-iv)) (F-prime-X (f-deriv-iv X))) (cond ((interval-contains-zero? F-prime-X) (cons 'division-by-zero X)) (else (let ((quotient (interval-div-rigorous fm-iv F-prime-X))) (if (error? quotient) (cons 'division-by-zero X) (let* ((newton-iv (interval-sub-rigorous m-iv quotient)) (intersection (interval-intersection newton-iv X))) (cond ((error? intersection) (cons 'no-root #f)) ((interval-subset? newton-iv X) (cons 'unique intersection)) ((< (interval-width intersection) (interval-width X)) (cons 'contracted intersection)) (else (cons 'no-improvement X))))))))))"))
