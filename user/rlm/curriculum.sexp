(task-entry (id "data/pagerank/pagerank-from-matrix") (skill data) (module pagerank) (tier 0) (difficulty 1307) (name pagerank-from-matrix) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations* adjacency->transition matrix-row-sum matrix-col-sum make-google-matrix)) (answer "(define (pagerank-from-matrix adj . opts) (let* ((damping (if (and (pair? opts) (number? (car opts))) (car opts) *default-damping-factor*)) (rest1 (if (and (pair? opts) (number? (car opts))) (cdr opts) opts)) (max-iter (if (and (pair? rest1) (integer? (car rest1))) (car rest1) *pagerank-max-iterations*)) (rest2 (if (and (pair? rest1) (integer? (car rest1))) (cdr rest1) rest1)) (tol (if (and (pair? rest2) (number? (car rest2))) (car rest2) *pagerank-tolerance*))) (let ((trans (adjacency->transition adj))) (if (and (pair? trans) (eq? (car trans) 'error)) trans (let* ((google (make-google-matrix trans damping)) (n (matrix-rows google)) (v0 (make-vec n (/ 1.0 n)))) (pagerank-power-iteration google v0 max-iter tol))))))"))
(task-entry (id "data/graph-matrix/edges->adjacency-matrix") (skill data) (module graph-matrix) (tier 0) (difficulty 1307) (name edges->adjacency-matrix) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes*)) (answer "(define (edges->adjacency-matrix edges . opts) (let* ((n (if (and (not (null? opts)) (car opts)) (car opts) (infer-node-count edges))) (undirected (if (and (not (null? opts)) (not (null? (cdr opts)))) (cadr opts) #f)) (_ (when (> n *dense-adjacency-max-nodes*) (error 'edges->adjacency-matrix (format \"node count ~a exceeds dense matrix limit ~a; use edges->sparse-adjacency instead\" n *dense-adjacency-max-nodes*)))) (data (make-vector (* n n) 0))) (for-each (lambda (edge) (let ((i (edge-from edge)) (j (edge-to edge)) (w (edge-weight edge))) (vector-set! data (+ (* i n) j) w) (when undirected (vector-set! data (+ (* j n) i) w)))) edges) (list 'matrix n n data)))"))
(task-entry (id "data/centrality/eigenvector-centrality-from-edges") (skill data) (module centrality) (tier 0) (difficulty 1307) (name eigenvector-centrality-from-edges) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize)) (answer "(define (eigenvector-centrality-from-edges edges . opts) (let* ((n (if (and (pair? opts) (integer? (car opts))) (car opts) (infer-node-count edges))) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (adj (edges->adjacency-matrix edges n #t))) (apply eigenvector-centrality (cons adj rest1))))"))
(task-entry (id "data/graph-community/prim-mst") (skill data) (module graph-community) (tier 0) (difficulty 1307) (name prim-mst) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum)) (answer "(define (prim-mst adj . opts) (let* ((n (adjacency-matrix-node-count adj)) (start (if (pair? opts) (car opts) 0)) (in-mst (make-vector n #f)) (min-weight (make-vector n +inf.0)) (parent (make-vector n -1)) (weight-cmp (lambda (a b) (<= (car a) (car b))))) (vector-set! min-weight start 0) (let loop ((heap (heap-insert-by weight-cmp (list 0 start -1) heap-empty)) (mst-edges '())) (if (heap-empty? heap) (reverse mst-edges) (let* ((top (heap-value heap)) (heap-rest (heap-delete-top-by weight-cmp heap)) (w (car top)) (u (cadr top)) (from (caddr top))) (if (vector-ref in-mst u) (loop heap-rest mst-edges) (begin (vector-set! in-mst u #t) (let ((new-edges (if (>= from 0) (cons (list from u w) mst-edges) mst-edges))) (let add-neighbors ((neighbors (adjacency-neighbors-with-weights adj u)) (h heap-rest)) (if (null? neighbors) (loop h new-edges) (let* ((edge (car neighbors)) (v (car edge)) (edge-w (cdr edge))) (if (and (not (vector-ref in-mst v)) (< edge-w (vector-ref min-weight v))) (begin (vector-set! min-weight v edge-w) (vector-set! parent v u) (add-neighbors (cdr neighbors) (heap-insert-by weight-cmp (list edge-w v u) h))) (add-neighbors (cdr neighbors) h)))))))))))))"))
