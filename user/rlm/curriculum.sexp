(task-entry (id "geometry/mesh-topology/mesh-betti-numbers") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12206) (name mesh-betti-numbers) (type "(-> Mesh (List Integer))") (description "Compute Betti numbers (B_0, B_1, B_2) for a mesh") (notes ("Interpretation: B_0 = connected components, B_1 = tunnels/handles (genus-related), B_2 = enclosed voids")) (section topological-invariants) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex)) (answer "(define (mesh-betti-numbers mesh) (sc-betti-numbers (mesh->simplicial-complex mesh)))"))
(task-entry (id "geometry/convex-hull/sort-by-polar-angle") (skill geometry) (module convex-hull) (tier 1) (difficulty 12206) (name sort-by-polar-angle) (type "") (description "") (notes ()) (section graham-scan) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle)) (answer "(define (sort-by-polar-angle origin points) (let* ((others (filter (lambda (p) (not (and (= (point2-x p) (point2-x origin)) (= (point2-y p) (point2-y origin))))) points)) (sorted (sort-by (lambda (a b) (let ((angle-a (polar-angle origin a)) (angle-b (polar-angle origin b))) (if (< (abs (- angle-a angle-b)) 1e-10) (> (point2-distance-sq origin a) (point2-distance-sq origin b)) (< angle-a angle-b)))) others))) (remove-collinear-except-furthest origin sorted)))"))
