(task-entry (id "algebra/galois/gf-ext-inv") (skill algebra) (module galois) (tier 0) (difficulty 316) (name gf-ext-inv) (type "") (description "") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul)) (answer "(define (gf-ext-inv a base-field n modulus) (let* ((ca (gf-ext-coeffs a)) (pa (make-polynomial base-field ca)) (result (poly-extended-gcd pa modulus)) (gcd (car result)) (s (cadr result)) (inv-coeffs (poly-coeffs s))) (make-gf-ext-element (gf-ext-normalize inv-coeffs n base-field) modulus base-field)))"))
(task-entry (id "algebra/tropical/tropical-matrix-closure") (skill algebra) (module tropical) (tier 0) (difficulty 316) (name tropical-matrix-closure) (type "") (description "") (notes ()) (section matrix-operations) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul tropical-matrix-add tropical-matrix-power)) (answer "(define (tropical-matrix-closure sr A) (let* ((n (matrix-rows A)) (⊕ (semiring-add sr)) (⊗ (semiring-mul sr)) (zero (semiring-zero sr)) (one (semiring-one sr)) (data (make-vector (* n n) zero))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let ((idx (+ (* i n) j)) (a-ij (matrix-ref A i j))) (if (= i j) (vector-set! data idx (⊕ one a-ij)) (vector-set! data idx a-ij))))) (do ((k 0 (+ k 1))) ((= k n)) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let* ((ij (+ (* i n) j)) (d-ij (vector-ref data ij)) (d-ik (vector-ref data (+ (* i n) k))) (d-kj (vector-ref data (+ (* k n) j))) (via-k (⊗ d-ik d-kj))) (vector-set! data ij (⊕ d-ij via-k)))))) (list 'matrix n n data)))"))
