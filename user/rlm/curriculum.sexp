(task-entry (id "linalg/matrix-decomp/matrix-column") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 403) (name matrix-column) (type "") (description "Extract column j as a vector.") (notes ()) (section helper-functions) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance* matrix-copy matrix-set!)) (answer "(define (matrix-column m j) (let* ((rows (matrix-rows m)) (result (make-vector rows 0))) (do ((i 0 (+ i 1))) ((= i rows) result) (vector-set! result i (matrix-ref m i j)))))"))
(task-entry (id "linalg/matrix-solvers/matrix-inverse") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 403) (name matrix-inverse) (type "") (description "") (notes ()) (section lu-solvers) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute matrix-back-substitute matrix-solve)) (answer "(define (matrix-inverse a) (let* ((n (matrix-rows a)) (lu (matrix-lu a))) (if (and (pair? lu) (eq? (car lu) 'error)) lu (let* ((inv-data (make-vector (* n n) 0)) (e (make-vector n 0))) (do ((j 0 (+ j 1))) ((= j n) (list 'matrix n n inv-data)) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! e i 0)) (vector-set! e j 1) (let ((xj (matrix-lu-solve lu e))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! inv-data (+ (* i n) j) (vector-ref xj i)))))))))"))
(task-entry (id "linalg/matrix-eigen/power-iteration-loop") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 403) (name power-iteration-loop) (type "") (description "") (notes ()) (section power-iteration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration)) (answer "(define (power-iteration-loop a v iter max-iter tol prev-lambda) (if (>= iter max-iter) (quasiquote (error no-convergence (unquote iter) (unquote prev-lambda))) (let* ((av (matrix-vec-mul a v)) (av-norm (vec-norm av))) (if (< av-norm tol) (cons 0 v) (let* ((v-new (vec-scale (/ 1.0 av-norm) av)) (av-new (matrix-vec-mul a v-new)) (lambda-new (vec-dot v-new av-new)) (change (abs (- lambda-new prev-lambda)))) (if (< change tol) (cons lambda-new v-new) (power-iteration-loop a v-new (+ iter 1) max-iter tol lambda-new)))))))"))
(task-entry (id "linalg/iterative-solvers/converged?") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 403) (name converged?) (type "") (description "") (notes ()) (section convergence-checking) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual)) (answer "(define (converged? res tol) (< res tol))"))
(task-entry (id "linalg/sparse/sparse-coo-rows") (skill linalg) (module sparse) (tier 0) (difficulty 403) (name sparse-coo-rows) (type "") (description "") (notes ()) (section coo-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo)) (answer "(define (sparse-coo-rows m) (list-ref m 1))"))
(task-entry (id "linalg/graph-laplacian/laplacian-random-walk") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 403) (name laplacian-random-walk) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized)) (answer "(define (laplacian-random-walk adj) (let* ((n (adjacency-matrix-node-count adj)) (a (if (sparse-csr? adj) (sparse-csr->dense adj) adj)) (result (make-matrix n n 0))) (let ((d-inv (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((deg (adjacency-out-degree adj i))) (vector-set! d-inv i (if (= deg 0) 0 (/ 1.0 deg))))) (do ((i 0 (+ i 1))) ((= i n) result) (let ((di (vector-ref d-inv i))) (do ((j 0 (+ j 1))) ((= j n)) (let* ((a-ij (matrix-ref a i j)) (term (if (= i j) (if (= di 0) 0.0 (- 1 (* di a-ij))) (- (* di a-ij))))) (matrix-set! result i j term))))))))"))
(task-entry (id "linalg/svd/svd-via-ata") (skill linalg) (module svd) (tier 0) (difficulty 403) (name svd-via-ata) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd)) (answer "(define (svd-via-ata a m n max-iter tol) (let* ((at (matrix-transpose a)) (ata (matrix-mul at a)) (eigen-result (symmetric-eigen ata max-iter tol))) (if (and (pair? eigen-result) (eq? (car eigen-result) 'error)) eigen-result (let* ((eigenvalues (car eigen-result)) (v (cdr eigen-result)) (sorted (sort-singular-data eigenvalues v n)) (sorted-eigenvalues (car sorted)) (sorted-v (cdr sorted)) (singular-values (eigenvalues->singular-values sorted-eigenvalues tol)) (sigma (build-sigma-matrix m n singular-values)) (u (compute-u-from-av a sorted-v singular-values m n tol))) (list u sigma sorted-v)))))"))
