(task-entry (id "clp/fd-constraints/<fd-var-var") (skill clp) (module fd-constraints) (tier 1) (difficulty 10806) (name <fd-var-var) (type "(-> CStore LVar LVar (Maybe CStore))") (description "Propagate x < y constraint for two variables") (notes ()) (section comparison-constraints) (deps (\x27;store)) (available (in-range in-domain =fd =fd-var-const =fd-var-var <fd)) (answer "(define (<fd-var-var cs x y) (let ((dom-x (cstore-get-domain cs x)) (dom-y (cstore-get-domain cs y))) (cond ((and dom-x dom-y) (let* ((cs1 (cstore-narrow-domain cs x (domain-restrict-max dom-x (- (domain-max dom-y) 1)))) (cs2 (and cs1 (cstore-narrow-domain cs1 y (domain-restrict-min (cstore-get-domain cs1 y) (+ (domain-min (cstore-get-domain cs1 x)) 1)))))) cs2)) (else cs))))"))
(task-entry (id "clp/global-constraints/post-all-different") (skill clp) (module global-constraints) (tier 1) (difficulty 10806) (name post-all-different) (type "(-> CStore (List LVar) (Maybe CStore))") (description "Post all-different constraint and propagate") (notes ()) (section all-different-constraint) (deps (\x27;propagate)) (available (all-different all-different-propagate remove-singletons remove-value-from-all check-singleton-conflict list-uniq-global)) (answer "(define (post-all-different cs vars) (if (< (length vars) 2) cs (post-constraint cs 'all-different vars (all-different vars))))"))
(task-entry (id "clp/propagate/post-=fd") (skill clp) (module propagate) (tier 1) (difficulty 10806) (name post-=fd) (type "(-> CStore (Or LVar Int) (Or LVar Int) (Maybe CStore))") (description "Post equality constraint and propagate") (notes ()) (section high-level-constraint-posting) (deps (\x27;fd-constraints)) (available (propagate propagate-with-fuel filter-constraints-by-var-id propagate-constraints post-constraint post-in-range)) (answer "(define (post-=fd cs x y) (let ((vars (filter lvar? (list x y)))) (if (null? vars) ((=fd x y) cs) (post-constraint cs '=fd vars (=fd x y)))))"))
(task-entry (id "clp/label/mid-value") (skill clp) (module label) (tier 1) (difficulty 10806) (name mid-value) (type "(-> Domain Int)") (description "Select middle value from domain") (notes ()) (section value-selection-strategies) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value)) (answer "(define (mid-value dom) (let* ((lo (domain-min dom)) (hi (domain-max dom)) (mid (quotient (+ lo hi) 2))) (if (domain-contains? dom mid) mid (let loop ((offset 1)) (cond ((domain-contains? dom (+ mid offset)) (+ mid offset)) ((domain-contains? dom (- mid offset)) (- mid offset)) (else (loop (+ offset 1))))))))"))
