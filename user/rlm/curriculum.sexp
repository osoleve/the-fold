(task-entry (id "linalg/matrix/matrix-transpose") (skill linalg) (module matrix) (tier 0) (difficulty 412) (name matrix-transpose) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal)) (answer "(define (matrix-transpose m) (let* ((rows (matrix-rows m)) (cols (matrix-cols m)) (data (matrix-data m)) (result (make-vector (* rows cols) 0))) (do ((i 0 (+ i 1))) ((= i rows)) (do ((j 0 (+ j 1))) ((= j cols)) (vector-set! result (+ (* j rows) i) (vector-ref data (+ (* i cols) j))))) (list 'matrix cols rows result)))"))
(task-entry (id "linalg/matrix-eigen/wilkinson-shift") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 412) (name wilkinson-shift) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check)) (answer "(define (wilkinson-shift a active-size) (if (< active-size 2) 0 (let* ((i (- active-size 1)) (j (- active-size 2)) (a-jj (matrix-ref a j j)) (a-ii (matrix-ref a i i)) (a-ji (matrix-ref a i j)) (a-ij (matrix-ref a j i)) (d (/ (- a-jj a-ii) 2)) (sign-d (if (>= d 0) 1 -1)) (discriminant (+ (* d d) (* a-ji a-ij))) (denom (if (< discriminant 0) (abs d) (+ (abs d) (sqrt discriminant))))) (if (< denom *eigen-tolerance*) a-ii (- a-ii (/ (* sign-d a-ji a-ij) denom))))))"))
(task-entry (id "linalg/iterative-solvers/pcg") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 412) (name pcg) (type "") (description "") (notes ()) (section preconditioned-cg) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop)) (answer "(define (pcg a b solve-precond . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (cond ((not (= n m)) (quasiquote (error not-square (unquote n) (unquote m)))) ((not (= n (vector-length b))) (quasiquote (error dimension-mismatch (unquote n) (unquote (vector-length b))))) (else (let* ((x0 (if (and (pair? opts) (vector? (car opts))) (car opts) (make-vector n 0.0))) (rest1 (if (and (pair? opts) (vector? (car opts))) (cdr opts) opts)) (max-iter (if (and (pair? rest1) (integer? (car rest1))) (car rest1) n)) (rest2 (if (and (pair? rest1) (integer? (car rest1))) (cdr rest1) rest1)) (tol (if (and (pair? rest2) (number? (car rest2))) (car rest2) *iterative-tolerance*)) (ax0 (matrix-vec-mul a x0)) (r0 (vec-sub b ax0)) (z0 (solve-precond r0)) (p0 (vector-copy z0)) (rz0 (vec-dot r0 z0)) (r0-norm (vec-norm r0))) (if (< r0-norm tol) (list x0 0 r0-norm) (pcg-loop a b solve-precond (vector-copy x0) r0 z0 p0 rz0 0 max-iter tol n)))))))"))
(task-entry (id "linalg/sparse/make-sparse-csr") (skill linalg) (module sparse) (tier 0) (difficulty 412) (name make-sparse-csr) (type "") (description "") (notes ()) (section csr-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr?)) (answer "(define (make-sparse-csr rows cols row-ptrs col-indices values) (list 'sparse-csr rows cols row-ptrs col-indices values))"))
(task-entry (id "linalg/graph-laplacian/subgraph-partition") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 412) (name subgraph-partition) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k)) (answer "(define (subgraph-partition adj nodes k) (cond ((<= k 1) (list nodes)) ((<= (length nodes) 1) (list nodes)) ((<= (length nodes) k) (map list nodes)) (else (let* ((subgraph (extract-induced-subgraph adj nodes)) (result (spectral-partition subgraph))) (if (and (pair? result) (eq? (car result) 'error)) (let* ((mid (quotient (length nodes) 2)) (part-a (take mid nodes)) (part-b (drop mid nodes))) (append (subgraph-partition adj part-a (quotient k 2)) (subgraph-partition adj part-b (- k (quotient k 2))))) (let* ((local-a (car result)) (local-b (cdr result)) (orig-a (remap-partition local-a nodes)) (orig-b (remap-partition local-b nodes)) (k-a (quotient k 2)) (k-b (- k k-a))) (append (subgraph-partition adj orig-a k-a) (subgraph-partition adj orig-b k-b))))))))"))
(task-entry (id "linalg/svd/sort-singular-data") (skill linalg) (module svd) (tier 0) (difficulty 412) (name sort-singular-data) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values)) (answer "(define (sort-singular-data eigenvalues mat n) (let* ((indices (make-vector n 0)) (_ (do ((i 0 (+ i 1))) ((= i n)) (vector-set! indices i i))) (_ (do ((i 0 (+ i 1))) ((= i n)) (do ((j (+ i 1) (+ j 1))) ((= j n)) (when (< (vector-ref eigenvalues (vector-ref indices i)) (vector-ref eigenvalues (vector-ref indices j))) (let ((temp (vector-ref indices i))) (vector-set! indices i (vector-ref indices j)) (vector-set! indices j temp)))))) (sorted-ev (make-vector n 0)) (rows (matrix-rows mat)) (sorted-mat (make-matrix rows n 0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((idx (vector-ref indices i))) (vector-set! sorted-ev i (vector-ref eigenvalues idx)) (do ((r 0 (+ r 1))) ((= r rows)) (matrix-set! sorted-mat r i (matrix-ref mat r idx))))) (cons sorted-ev sorted-mat)))"))
