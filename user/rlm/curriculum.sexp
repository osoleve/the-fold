(task-entry (id "tiles/topology-analysis/coords-adjacent?") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12308) (name coords-adjacent?) (type "") (description "Check if two coordinates are adjacent according to neighbor-fn") (notes ()) (section board-to-complex) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<? collect-square-faces)) (answer "(define (coords-adjacent? c1 c2 neighbor-fn) (memp (lambda (n) (coord-equal? n c2)) (neighbor-fn c1)))"))
(task-entry (id "tiles/core/tile-cost") (skill tiles) (module core) (tier 1) (difficulty 12309) (name tile-cost) (type "(-> Tile Number)") (description "Default cost function - can be overridden by games") (notes ()) (section tile-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data tile-walkable?)) (answer "(define (tile-cost tile) (let ((data (tile-data tile))) (if (and (pair? data) (assq 'cost data)) (cdr (assq 'cost data)) 1)))"))
