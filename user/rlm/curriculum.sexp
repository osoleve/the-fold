(task-entry (id "data/sort/max-by") (skill data) (module sort) (tier 0) (difficulty 1328) (name max-by) (type "(-> (-> α β) (List α) α)") (description "Find element with maximum key value") (notes ()) (section utilities) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort insert-sorted insertion-sort-by insertion-sort sort-by-key sort-by-key-desc sort-desc quicksort-desc sorted? sorted-by? sorted-desc? unique-sorted sort-unique nth-smallest median min-element max-element min-by)) (answer "(define (max-by key-fn lst) (if (null? lst) (error 'max-by \"Cannot find max of empty list\") (car (fold-left (lambda (best x) (let ((k (key-fn x))) (if (> k (cdr best)) (cons x k) best))) (cons (car lst) (key-fn (car lst))) (cdr lst)))))"))
