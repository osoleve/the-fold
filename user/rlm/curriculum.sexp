(task-entry (id "geometry/mesh-gen/tri2-circumcenter") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12225) (name tri2-circumcenter) (type "") (description "") (notes ()) (section predicates) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location location? location-triangle location-bary point2-x point2-y vertex-key make-tri2 tri2? tri2-p1 tri2-p2 tri2-p3 tri2-points orient2d tri2-signed-area tri2-area)) (answer "(define (tri2-circumcenter tri) (let* ((p1 (tri2-p1 tri)) (p2 (tri2-p2 tri)) (p3 (tri2-p3 tri)) (ax (point2-x p1)) (ay (point2-y p1)) (bx (point2-x p2)) (by (point2-y p2)) (cx (point2-x p3)) (cy (point2-y p3)) (d (* 2.0 (+ (* ax (- by cy)) (* bx (- cy ay)) (* cx (- ay by)))))) (if (< (abs d) 1e-15) #f (let* ((a2 (+ (* ax ax) (* ay ay))) (b2 (+ (* bx bx) (* by by))) (c2 (+ (* cx cx) (* cy cy))) (ux (/ (+ (* a2 (- by cy)) (* b2 (- cy ay)) (* c2 (- ay by))) d)) (uy (/ (+ (* a2 (- cx bx)) (* b2 (- ax cx)) (* c2 (- bx ax))) d))) (make-point2 ux uy)))))"))
(task-entry (id "geometry/mesh-topology/mesh-is-watertight?") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12225) (name mesh-is-watertight?) (type "") (description "") (notes ()) (section genus-computation) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex mesh-betti-numbers mesh-euler-characteristic mesh-f-vector mesh-connected-components mesh-genus mesh-edge-counts edge-key mesh-is-manifold? mesh-edges-are-manifold? mesh-vertices-are-manifold? vertex-link-edges list-member? unique-list count-components-uf build-index-map mesh-is-closed? mesh-boundary-edges mesh-non-manifold-edges mesh-topology-summary)) (answer "(define (mesh-is-watertight? mesh) (and (mesh-is-manifold? mesh) (mesh-is-closed? mesh) (let ((betti (mesh-betti-numbers mesh))) (and (= (length betti) 3) (= (car betti) 1) (= (caddr betti) 1)))))"))
(task-entry (id "geometry/convex-hull/polygon-edges") (skill geometry) (module convex-hull) (tier 1) (difficulty 12225) (name polygon-edges) (type "") (description "") (notes ()) (section minkowski) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line find-furthest-from-line quickhull-recurse quickhull convex-hull convex-hull-area convex-hull-perimeter point-in-convex-hull? convex-hull-centroid convex-hull-diameter extreme-point support-function minkowski-sum normalize-angle)) (answer "(define (polygon-edges hull) (if (null? hull) '() (let ((n (length hull))) (let loop ((i 0) (result '())) (if (>= i n) (reverse result) (let* ((p1 (list-ref hull i)) (p2 (list-ref hull (modulo (+ i 1) n))) (dx (- (point2-x p2) (point2-x p1))) (dy (- (point2-y p2) (point2-y p1)))) (if (and (< (abs dx) 1e-10) (< (abs dy) 1e-10)) (loop (+ i 1) result) (let* ((edge (make-point2 dx dy)) (angle (normalize-angle (atan dy dx)))) (loop (+ i 1) (cons (cons edge angle) result))))))))))"))
(task-entry (id "geometry/voronoi/edge-key->points") (skill geometry) (module voronoi) (tier 1) (difficulty 12225) (name edge-key->points) (type "") (description "") (notes ()) (section construction) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell voronoi-diagram find-unbounded-sites build-voronoi-edges)) (answer "(define (edge-key->points key) (cons (make-point2 (list-ref key 0) (list-ref key 1)) (make-point2 (list-ref key 2) (list-ref key 3))))"))
(task-entry (id "geometry/geometry-optics/aabb-corners-each") (skill geometry) (module geometry-optics) (tier 1) (difficulty 12225) (name aabb-corners-each) (type "") (description "") (notes ()) (section aabb-lenses) (deps (\x27;prelude \x27;optics \x27;geometry)) (available (vec3-x-lens vec3-y-lens vec3-z-lens line3-origin-lens line3-direction-lens ray3-origin-lens ray3-direction-lens ray3-origin-x-lens ray3-origin-y-lens ray3-origin-z-lens plane3-normal-lens plane3-d-lens triangle3-p1-lens triangle3-p2-lens triangle3-p3-lens triangle3-vertices-each circle-center-lens circle-radius-lens sphere-center-lens sphere-radius-lens sphere-center-x-lens sphere-center-y-lens sphere-center-z-lens aabb-min-lens aabb-max-lens)) (answer "(define aabb-corners-each (make-traversal (lambda (f b) (aabb (f (aabb-min b)) (f (aabb-max b)))) (lambda (b) (list (aabb-min b) (aabb-max b)))))"))
