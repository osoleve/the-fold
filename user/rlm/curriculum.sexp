(task-entry (id "game-theory/coop-games/find-tight-coalitions") (skill game-theory) (module coop-games) (tier 1) (difficulty 13232) (name find-tight-coalitions) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp)) (answer "(define (find-tight-coalitions g alloc epsilon coalition-vec) (let ((tolerance 1e-8)) (filter (lambda (S) (let ((excess (core-excess g alloc S))) (< (abs (- excess epsilon)) tolerance))) (vector->list coalition-vec))))"))
(task-entry (id "game-theory/matching/preference-rank") (skill game-theory) (module matching) (tier 1) (difficulty 13232) (name preference-rank) (type "") (description "") (notes ()) (section optimal-assignment) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences)) (answer "(define (preference-rank prefs item) (let loop ((prefs prefs) (rank 0)) (cond ((null? prefs) #f) ((equal? (car prefs) item) rank) (else (loop (cdr prefs) (+ rank 1))))))"))
(task-entry (id "game-theory/voting/minimax-score") (skill game-theory) (module voting) (tier 1) (difficulty 13232) (name minimax-score) (type "(-> Candidate PreferenceProfile Int)") (description "Compute minimax score: the worst (most negative) pairwise margin against this candidate. Higher is better (less bad worst loss). A positive score means undefeated.") (notes ()) (section minimax-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking)) (answer "(define (minimax-score candidate profile) (let ((others (remove candidate (profile-candidates profile)))) (if (null? others) 0 (apply min (map (lambda (other) (pairwise-margin candidate other profile)) others)))))"))
(task-entry (id "game-theory/multi-winner/cc-marginal-score") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13232) (name cc-marginal-score) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction cc-greedy cc-loop)) (answer "(define (cc-marginal-score candidate profile elected num-candidates) (apply + (map (lambda (ranking) (let ((new-sat (voter-satisfaction ranking candidate num-candidates)) (old-sat (best-satisfaction ranking elected num-candidates))) (max 0 (- new-sat old-sat)))) profile)))"))
(task-entry (id "game-theory/fair-division/selfridge-conway-with-trim") (skill game-theory) (module fair-division) (tier 1) (difficulty 13232) (name selfridge-conway-with-trim) (type "") (description "") (notes ()) (section selfridge-conway) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim)) (answer "(define (selfridge-conway-with-trim c div pieces vals-1 trim-idx fuel) (let* ((sorted-vals (sort-by > (vector->list vals-1))) (second-max (cadr sorted-vals)) (trim-piece (vector-ref pieces trim-idx)) (trim-start (car trim-piece)) (trim-end (cdr trim-piece)) (new-end (find-value-endpoint c 1 trim-start second-max fuel)) (trimmed-piece (cons trim-start new-end)) (trimming (cons new-end trim-end)) (_ (vector-set! pieces trim-idx trimmed-piece)) (vals-2 (vector (cake-valuation c 2 (car (vector-ref pieces 0)) (cdr (vector-ref pieces 0))) (cake-valuation c 2 (car (vector-ref pieces 1)) (cdr (vector-ref pieces 1))) (cake-valuation c 2 (car (vector-ref pieces 2)) (cdr (vector-ref pieces 2))))) (c-choice (argmax (vector->list vals-2))) (b-choice (if (= c-choice trim-idx) (let ((remaining (filter (lambda (i) (not (= i c-choice))) '(0 1 2)))) (car (sort-by (lambda (i j) (> (vector-ref vals-1 i) (vector-ref vals-1 j))) remaining))) trim-idx)) (a-choice (car (filter (lambda (i) (and (not (= i c-choice)) (not (= i b-choice)))) '(0 1 2)))) (trimming-handler (if (= c-choice trim-idx) 2 (if (= b-choice trim-idx) 1 0)))) (division-assign! div 2 (piece-singleton (car (vector-ref pieces c-choice)) (cdr (vector-ref pieces c-choice)))) (division-assign! div 1 (piece-singleton (car (vector-ref pieces b-choice)) (cdr (vector-ref pieces b-choice)))) (division-assign! div 0 (piece-singleton (car (vector-ref pieces a-choice)) (cdr (vector-ref pieces a-choice)))) (let ((trimming-piece (piece-singleton (car trimming) (cdr trimming)))) (cond ((= trimming-handler 2) (division-assign! div 1 (piece-merge (division-piece div 1) trimming-piece))) ((= trimming-handler 1) (division-assign! div 0 (piece-merge (division-piece div 0) trimming-piece))) (else (division-assign! div 1 (piece-merge (division-piece div 1) trimming-piece))))) div))"))
(task-entry (id "game-theory/mechanism/optimal-reserve-uniform") (skill game-theory) (module mechanism) (tier 1) (difficulty 13232) (name optimal-reserve-uniform) (type "(-> Nat Number)") (description "Optimal reserve price for uniform[0,1] valuations: always 1/2") (notes ("This is a classic result: regardless of n, reserve = 1/2 maximizes revenue for uniform[0,1]")) (section myerson-optimal) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue first-price-auction second-price-auction all-pay-auction third-price-auction with-reserve bidder-utility is-dsic-deviation-profitable? check-dsic verify-dsic expected-revenue-uniform vcg-combinatorial vcg-find-efficient-allocation vcg-find-efficient-allocation-without vcg-total-welfare vcg-total-welfare-without vcg-enumerate-allocations vcg-enumerate-helper pivot-mechanism myerson-virtual-value)) (answer "(define (optimal-reserve-uniform n) 0.5)"))
