(task-entry (id "physics/classical/constraint-solver/correct-revolute-position") (skill physics/classical) (module constraint-solver) (tier 2) (difficulty 23507) (name correct-revolute-position) (type "") (description "") (notes ()) (section revolute) (deps (\x27;prelude \x27;vec2 \x27;rigid-body \x27;constraints)) (available (*baumgarte-factor* *position-slop* *angular-slop* apply-constraint-impulse! solve-distance-velocity correct-distance-position solve-revolute-velocity)) (answer "(define (correct-revolute-position world constraint) (let* ((entity-a-id (constraint-entity-a constraint)) (entity-b-id (constraint-entity-b constraint)) (entity-a (world-get-entity world entity-a-id)) (entity-b (and entity-b-id (world-get-entity world entity-b-id)))) (when entity-a (let* ((body-a (entity-body entity-a)) (body-b (and entity-b (entity-body entity-b))) (pos-a (constraint-anchor-world-a world constraint)) (pos-b (constraint-anchor-world-b world constraint)) (C (vec2-sub pos-b pos-a)) (error-mag (vec2-magnitude C))) (when (> error-mag *position-slop*) (let* ((inv-mass-a (if (rigid-body? body-a) (rigid-body-inv-mass body-a) (body-inv-mass body-a))) (inv-mass-b (if body-b (if (rigid-body? body-b) (rigid-body-inv-mass body-b) (body-inv-mass body-b)) 0)) (total-inv-mass (+ inv-mass-a inv-mass-b)) (correction (vec2-scale C *baumgarte-factor*))) (unless (or (entity-static? entity-a) (< total-inv-mass 1e-4)) (let* ((pos (if (rigid-body? body-a) (rigid-body-pos body-a) (body-pos body-a))) (new-pos (vec2-add pos (vec2-scale correction (/ inv-mass-a total-inv-mass)))) (new-body (if (rigid-body? body-a) (rigid-body-with-pos body-a new-pos) (body-with-pos body-a new-pos)))) (world-update-entity! world entity-a-id (lambda (e) (entity-with-body e new-body))))) (when (and entity-b (not (entity-static? entity-b))) (let* ((pos (if (rigid-body? body-b) (rigid-body-pos body-b) (body-pos body-b))) (new-pos (vec2-sub pos (vec2-scale correction (/ inv-mass-b total-inv-mass)))) (new-body (if (rigid-body? body-b) (rigid-body-with-pos body-b new-pos) (body-with-pos body-b new-pos)))) (world-update-entity! world entity-b-id (lambda (e) (entity-with-body e new-body)))))))))))"))
