(task-entry (id "info/entropy/entropy-normalized") (skill info) (module entropy) (tier 1) (difficulty 11104) (name entropy-normalized) (type "(-> (List Number) Number)") (description "Shannon entropy with automatic normalization") (notes ()) (section shannon-entropy) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy)) (answer "(define (entropy-normalized weights) (let* ((total (fold-left + 0 weights)) (probs (if (= total 0) weights (map (lambda (w) (/ w total)) weights)))) (entropy probs)))"))
(task-entry (id "info/statistical-measures/total-variation-distance") (skill info) (module statistical-measures) (tier 1) (difficulty 11104) (name total-variation-distance) (type "(-> (List Real) (List Real) Real)") (description "Total variation distance TV(P,Q) = 1/2 * sum(|p_i - q_i|), range [0, 1]") (notes ()) (section total-variation-distance) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc)) (answer "(define (total-variation-distance p q) (if (or (null? p) (null? q)) 1 (* 0.5 (fold-left + 0 (map (lambda (pi qi) (abs (- pi qi))) p q)))))"))
(task-entry (id "info/channel-capacity/z-channel-capacity") (skill info) (module channel-capacity) (tier 1) (difficulty 11104) (name z-channel-capacity) (type "(-> Real Real)") (description "Channel capacity of Z-channel with crossover probability p") (notes ()) (section z-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity)) (answer "(define (z-channel-capacity p) (cond ((<= p 0) 1.0) ((>= p 1) 0.0) (else (let* ((exponent (/ p (- 1 p))) (term (expt p exponent))) (log2 (+ 1 (* (- 1 p) term)))))))"))
(task-entry (id "info/rate-distortion/mae") (skill info) (module rate-distortion) (tier 1) (difficulty 11104) (name mae) (type "(-> (List Real) (List Real) Real)") (description "Mean absolute error: (1/n) * sum(|xi - yi|)") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse)) (answer "(define (mae xs ys) (if (null? xs) 0 (/ (fold-left + 0 (map absolute-error xs ys)) (length xs))))"))
(task-entry (id "info/coding/huffman-children") (skill info) (module coding) (tier 1) (difficulty 11104) (name huffman-children) (type "(-> Node (Pair Node Node))") (description "") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol)) (answer "(define (huffman-children node) (cadr node))"))
(task-entry (id "info/model-selection-info/aicc") (skill info) (module model-selection-info) (tier 1) (difficulty 11104) (name aicc) (type "(-> Number Nat Nat Number)") (description "Corrected AIC for small samples: AICc = AIC + 2k(k+1)/(n-k-1).\n   Reduces to AIC as n -> infinity. Use when n/k < 40.") (notes ()) (section information-criteria) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (log-likelihood-gaussian log-likelihood-gaussian-vec aic bic)) (answer "(define (aicc log-lik k n) (let ((base (aic log-lik k))) (if (<= (- n k 1) 0) +inf.0 (+ base (/ (* 2 k (+ k 1)) (- n k 1))))))"))
(task-entry (id "info/empirical-info/build-joint-counts") (skill info) (module empirical-info) (tier 1) (difficulty 11104) (name build-joint-counts) (type "(-> (List Nat) (List Nat) Nat (List (List Nat)))") (description "Build num-bins x num-bins joint frequency matrix from bin assignments") (notes ()) (section empirical-mutual-information) (deps (\x27;prelude \x27;entropy)) (available (discretize-uniform default-num-bins entropy-empirical mutual-information-empirical)) (answer "(define (build-joint-counts bx by num-bins) (let ((counts (make-vector (* num-bins num-bins) 0))) (let loop ((xs bx) (ys by)) (if (or (null? xs) (null? ys)) (let row-loop ((i 0) (rows '())) (if (= i num-bins) (reverse rows) (let col-loop ((j 0) (cols '())) (if (= j num-bins) (row-loop (+ i 1) (cons (reverse cols) rows)) (col-loop (+ j 1) (cons (vector-ref counts (+ (* i num-bins) j)) cols)))))) (begin (let ((idx (+ (* (car xs) num-bins) (car ys)))) (vector-set! counts idx (+ 1 (vector-ref counts idx)))) (loop (cdr xs) (cdr ys)))))))"))
(task-entry (id "info/partition-info/partition-mi") (skill info) (module partition-info) (tier 1) (difficulty 11104) (name partition-mi) (type "(-> Vector Vector Number)") (description "Mutual information I(A;B) between two partitions.\n   Measures how much knowing one partition tells you about the other.\n   I(A;B) = H(A) + H(B) - H(A,B).") (notes ()) (section partition-mutual-information) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy partition-sizes sort-labels insert-sorted)) (answer "(define (partition-mi labels-a labels-b) (let* ((n (vector-length labels-a)) (joint (build-contingency-table labels-a labels-b)) (joint-probs (map (lambda (row) (map (lambda (c) (/ c n)) row)) joint)) (marginal-a (map (lambda (row) (fold-left + 0 row)) joint-probs)) (num-cols (if (null? joint-probs) 0 (length (car joint-probs)))) (marginal-b (if (= num-cols 0) '() (map (lambda (j) (fold-left + 0 (map (lambda (row) (list-ref row j)) joint-probs))) (iota num-cols))))) (mutual-information joint-probs marginal-a marginal-b)))"))
(task-entry (id "optics/optics/grate-set") (skill optics) (module optics) (tier 1) (difficulty 11105) (name grate-set) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate? grate-cotraverse-fn grate-review grate-over)) (answer "(define (grate-set grate b _s) (grate-review grate b))"))
(task-entry (id "optics/profunctor-optics/p-lens->p-traversal") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11105) (name p-lens->p-traversal) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong? strong-profunctor strong-first strong-second pfirst psecond make-choice swap-either choice? choice-profunctor choice-left choice-right pleft pright make-closed closed-profunctor? closed-profunctor closed-fn pclosed make-wander wander? wander-strong wander-choice wander-wander pwander profunctor-fn strong-fn choice-fn closed-fn-instance wander-fn make-forget forget? run-forget profunctor-forget strong-forget make-tagged tagged? run-tagged profunctor-tagged choice-tagged make-star star? star-functor run-star profunctor-star make-p-iso p-iso? p-iso-forward p-iso-backward run-p-iso p-iso-compose make-p-lens p-lens? p-lens-getter p-lens-setter run-p-lens p-lens-compose make-p-prism p-prism? p-prism-match p-prism-build run-p-prism p-prism-compose make-p-affine p-affine? p-affine-preview p-affine-set run-p-affine p-affine-compose make-p-traversal p-traversal? p-traversal-traverse p-traversal-fold-fn run-p-traversal p-traversal-to-list p-traversal-over p-traversal-set p-traversal-compose p-traversal-each p-traversal-both p-traversal-filtered make-p-fold p-fold? p-fold-fn p-fold-to-list p-fold-preview p-fold-has p-fold-length p-fold-all p-fold-any p-fold-compose p-fold-each p-fold-filtered p-fold-taking traversal->p-traversal p-traversal->traversal)) (answer "(define (p-lens->p-traversal plens) (make-p-traversal (lambda (f s) (((p-lens-setter plens) s) (f ((p-lens-getter plens) s)))) (lambda (s) (list ((p-lens-getter plens) s)))))"))
(task-entry (id "info/entropy/max-entropy") (skill info) (module entropy) (tier 1) (difficulty 11105) (name max-entropy) (type "(-> Nat Number)") (description "Maximum entropy for n equally likely outcomes: H_max = log2(n)") (notes ()) (section shannon-entropy) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized)) (answer "(define (max-entropy n) (if (<= n 0) 0 (log2 n)))"))
(task-entry (id "info/statistical-measures/chi-squared-divergence") (skill info) (module statistical-measures) (tier 1) (difficulty 11105) (name chi-squared-divergence) (type "(-> (List Real) (List Real) Real)") (description "Chi-squared divergence χ²(P||Q) = sum((p_i - q_i)^2 / q_i)") (notes ()) (section chi-squared-divergence) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance)) (answer "(define (chi-squared-divergence p q) (if (or (null? p) (null? q)) 0 (fold-left + 0 (map (lambda (pi qi) (cond ((<= qi 0) (if (> pi 0) +inf.0 0)) (else (let ((diff (- pi qi))) (/ (* diff diff) qi))))) p q))))"))
(task-entry (id "info/channel-capacity/z-channel-transition-matrix") (skill info) (module channel-capacity) (tier 1) (difficulty 11105) (name z-channel-transition-matrix) (type "(-> Real (List (List Real)))") (description "Transition probability matrix P(Y|X) for Z-channel") (notes ()) (section z-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity)) (answer "(define (z-channel-transition-matrix p) (list (list 1 0) (list p (- 1 p))))"))
(task-entry (id "info/rate-distortion/rmse") (skill info) (module rate-distortion) (tier 1) (difficulty 11105) (name rmse) (type "(-> (List Real) (List Real) Real)") (description "Root mean squared error: sqrt(MSE)") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae)) (answer "(define (rmse xs ys) (sqrt (mse xs ys)))"))
(task-entry (id "info/coding/huffman-prob") (skill info) (module coding) (tier 1) (difficulty 11105) (name huffman-prob) (type "(-> Node Real)") (description "") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children)) (answer "(define (huffman-prob node) (caddr node))"))
(task-entry (id "info/model-selection-info/aic-weights") (skill info) (module model-selection-info) (tier 1) (difficulty 11105) (name aic-weights) (type "(-> (List Number) (List Number))") (description "Akaike weights from a list of AIC values.\n   w_i = exp(-0.5 * delta_i) / sum(exp(-0.5 * delta_j))\n   where delta_i = AIC_i - AIC_min. Weights sum to 1.") (notes ()) (section model-comparison) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (log-likelihood-gaussian log-likelihood-gaussian-vec aic bic aicc)) (answer "(define (aic-weights aic-values) (if (null? aic-values) '() (let* ((aic-min (apply min aic-values)) (deltas (map (lambda (a) (- a aic-min)) aic-values)) (raw-weights (map (lambda (d) (exp-num (* -0.5 d))) deltas)) (total (fold-left + 0 raw-weights))) (if (<= total 0) (map (lambda (_) (/ 1.0 (length aic-values))) aic-values) (map (lambda (w) (/ w total)) raw-weights)))))"))
(task-entry (id "info/empirical-info/compute-column-sums") (skill info) (module empirical-info) (tier 1) (difficulty 11105) (name compute-column-sums) (type "(-> (List (List Number)) Nat (List Number))") (description "Sum each column of a list-of-lists matrix") (notes ()) (section empirical-mutual-information) (deps (\x27;prelude \x27;entropy)) (available (discretize-uniform default-num-bins entropy-empirical mutual-information-empirical build-joint-counts)) (answer "(define (compute-column-sums matrix num-cols) (map (lambda (j) (fold-left + 0 (map (lambda (row) (list-ref row j)) matrix))) (iota num-cols)))"))
(task-entry (id "info/partition-info/build-contingency-table") (skill info) (module partition-info) (tier 1) (difficulty 11105) (name build-contingency-table) (type "(-> Vector Vector (List (List Nat)))") (description "Build contingency table from two label vectors.\n   Rows correspond to communities in A, columns to communities in B.") (notes ()) (section partition-mutual-information) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy partition-sizes sort-labels insert-sorted partition-mi)) (answer "(define (build-contingency-table labels-a labels-b) (let* ((n (vector-length labels-a)) (labels-a-unique (unique-labels labels-a)) (labels-b-unique (unique-labels labels-b)) (na (length labels-a-unique)) (nb (length labels-b-unique)) (a-index (label-index-map labels-a-unique)) (b-index (label-index-map labels-b-unique)) (counts (make-vector (* na nb) 0))) (let loop ((i 0)) (if (= i n) (let row-loop ((r 0) (rows '())) (if (= r na) (reverse rows) (let col-loop ((c 0) (cols '())) (if (= c nb) (row-loop (+ r 1) (cons (reverse cols) rows)) (col-loop (+ c 1) (cons (vector-ref counts (+ (* r nb) c)) cols)))))) (let ((ai (hashtable-ref a-index (vector-ref labels-a i) 0)) (bi (hashtable-ref b-index (vector-ref labels-b i) 0))) (let ((idx (+ (* ai nb) bi))) (vector-set! counts idx (+ 1 (vector-ref counts idx)))) (loop (+ i 1)))))))"))
(task-entry (id "optics/optics/grate-zipWith") (skill optics) (module optics) (tier 1) (difficulty 11106) (name grate-zipWith) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate? grate-cotraverse-fn grate-review grate-over grate-set)) (answer "(define (grate-zipWith grate f s1 s2) ((grate-cotraverse-fn grate) (lambda (sa) (f (sa s1) (sa s2)))))"))
(task-entry (id "optics/profunctor-optics/p-prism->p-traversal") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11106) (name p-prism->p-traversal) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong? strong-profunctor strong-first strong-second pfirst psecond make-choice swap-either choice? choice-profunctor choice-left choice-right pleft pright make-closed closed-profunctor? closed-profunctor closed-fn pclosed make-wander wander? wander-strong wander-choice wander-wander pwander profunctor-fn strong-fn choice-fn closed-fn-instance wander-fn make-forget forget? run-forget profunctor-forget strong-forget make-tagged tagged? run-tagged profunctor-tagged choice-tagged make-star star? star-functor run-star profunctor-star make-p-iso p-iso? p-iso-forward p-iso-backward run-p-iso p-iso-compose make-p-lens p-lens? p-lens-getter p-lens-setter run-p-lens p-lens-compose make-p-prism p-prism? p-prism-match p-prism-build run-p-prism p-prism-compose make-p-affine p-affine? p-affine-preview p-affine-set run-p-affine p-affine-compose make-p-traversal p-traversal? p-traversal-traverse p-traversal-fold-fn run-p-traversal p-traversal-to-list p-traversal-over p-traversal-set p-traversal-compose p-traversal-each p-traversal-both p-traversal-filtered make-p-fold p-fold? p-fold-fn p-fold-to-list p-fold-preview p-fold-has p-fold-length p-fold-all p-fold-any p-fold-compose p-fold-each p-fold-filtered p-fold-taking traversal->p-traversal p-traversal->traversal p-lens->p-traversal)) (answer "(define (p-prism->p-traversal pprism) (make-p-traversal (lambda (f s) (let ((e ((p-prism-match pprism) s))) (if (left? e) (from-left e) ((p-prism-build pprism) (f (from-right e)))))) (lambda (s) (let ((e ((p-prism-match pprism) s))) (if (left? e) '() (list (from-right e)))))))"))
(task-entry (id "info/entropy/entropy-ratio") (skill info) (module entropy) (tier 1) (difficulty 11106) (name entropy-ratio) (type "(-> (List Number) Number)") (description "Normalized entropy H(X)/H_max, between 0 and 1") (notes ()) (section shannon-entropy) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy)) (answer "(define (entropy-ratio probs) (let ((n (length probs)) (h (entropy probs))) (if (<= n 1) 0 (/ h (max-entropy n)))))"))
(task-entry (id "info/statistical-measures/symmetric-chi-squared") (skill info) (module statistical-measures) (tier 1) (difficulty 11106) (name symmetric-chi-squared) (type "(-> (List Real) (List Real) Real)") (description "Symmetric chi-squared divergence: (χ²(P||Q) + χ²(Q||P)) / 2") (notes ()) (section chi-squared-divergence) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence)) (answer "(define (symmetric-chi-squared p q) (let ((pq (chi-squared-divergence p q)) (qp (chi-squared-divergence q p))) (if (or (= pq +inf.0) (= qp +inf.0)) +inf.0 (/ (+ pq qp) 2))))"))
(task-entry (id "info/channel-capacity/awgn-capacity") (skill info) (module channel-capacity) (tier 1) (difficulty 11106) (name awgn-capacity) (type "(-> Real Real)") (description "AWGN channel capacity with signal-to-noise ratio (linear)") (notes ()) (section awgn-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix)) (answer "(define (awgn-capacity snr) (cond ((<= snr 0) 0.0) (else (* 0.5 (log2 (+ 1 snr))))))"))
(task-entry (id "info/rate-distortion/normalized-mse") (skill info) (module rate-distortion) (tier 1) (difficulty 11106) (name normalized-mse) (type "(-> (List Real) (List Real) Real)") (description "Normalized MSE: MSE / variance(original)") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse)) (answer "(define (normalized-mse original reconstructed) (let ((m (mse original reconstructed)) (v (variance original))) (if (<= v 0) 0 (/ m v))))"))
(task-entry (id "info/coding/build-huffman-tree") (skill info) (module coding) (tier 1) (difficulty 11106) (name build-huffman-tree) (type "(-> (List (Pair Symbol Real)) Node)") (description "Build Huffman tree from symbol-probability pairs") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob)) (answer "(define (build-huffman-tree symbol-probs) (if (null? symbol-probs) (make-huffman-leaf 'empty 0) (if (null? (cdr symbol-probs)) (make-huffman-leaf (caar symbol-probs) (cdar symbol-probs)) (let ((leaves (map (lambda (sp) (make-huffman-leaf (car sp) (cdr sp))) symbol-probs))) (huffman-build-loop (sort-by-prob leaves))))))"))
(task-entry (id "info/model-selection-info/evidence-ratio") (skill info) (module model-selection-info) (tier 1) (difficulty 11106) (name evidence-ratio) (type "(-> Number Number Number)") (description "Evidence ratio between two models: w_i / w_j.\n   An evidence ratio of 10 means model i is 10x more likely than model j.") (notes ()) (section model-comparison) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (log-likelihood-gaussian log-likelihood-gaussian-vec aic bic aicc aic-weights)) (answer "(define (evidence-ratio w-i w-j) (if (<= w-j 0) +inf.0 (/ w-i w-j)))"))
(task-entry (id "info/empirical-info/conditional-entropy-empirical") (skill info) (module empirical-info) (tier 1) (difficulty 11106) (name conditional-entropy-empirical) (type "(-> (List Number) (List Number) (Nat) Number)") (description "Estimate conditional entropy H(X|Y) from sample vectors.\n   H(X|Y) = H(X,Y) - H(Y) = H(X) - I(X;Y).") (notes ()) (section conditional-entropy-empirical) (deps (\x27;prelude \x27;entropy)) (available (discretize-uniform default-num-bins entropy-empirical mutual-information-empirical build-joint-counts compute-column-sums)) (answer "(define (conditional-entropy-empirical xs ys . opts) (let* ((hx (apply entropy-empirical xs opts)) (mi (apply mutual-information-empirical xs ys opts))) (max 0 (- hx mi))))"))
(task-entry (id "info/partition-info/unique-labels") (skill info) (module partition-info) (tier 1) (difficulty 11106) (name unique-labels) (type "") (description "") (notes ()) (section partition-mutual-information) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy partition-sizes sort-labels insert-sorted partition-mi build-contingency-table)) (answer "(define (unique-labels labels) (let ((seen (make-hashtable equal-hash equal?)) (result '())) (let loop ((i 0)) (if (= i (vector-length labels)) (sort-labels result) (let ((lbl (vector-ref labels i))) (unless (hashtable-ref seen lbl #f) (hashtable-set! seen lbl #t) (set! result (cons lbl result))) (loop (+ i 1)))))))"))
(task-entry (id "optics/optics/grate-zipWith3") (skill optics) (module optics) (tier 1) (difficulty 11107) (name grate-zipWith3) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate? grate-cotraverse-fn grate-review grate-over grate-set grate-zipWith)) (answer "(define (grate-zipWith3 grate f s1 s2 s3) ((grate-cotraverse-fn grate) (lambda (sa) (f (sa s1) (sa s2) (sa s3)))))"))
(task-entry (id "optics/profunctor-optics/p-affine->p-traversal") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11107) (name p-affine->p-traversal) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong? strong-profunctor strong-first strong-second pfirst psecond make-choice swap-either choice? choice-profunctor choice-left choice-right pleft pright make-closed closed-profunctor? closed-profunctor closed-fn pclosed make-wander wander? wander-strong wander-choice wander-wander pwander profunctor-fn strong-fn choice-fn closed-fn-instance wander-fn make-forget forget? run-forget profunctor-forget strong-forget make-tagged tagged? run-tagged profunctor-tagged choice-tagged make-star star? star-functor run-star profunctor-star make-p-iso p-iso? p-iso-forward p-iso-backward run-p-iso p-iso-compose make-p-lens p-lens? p-lens-getter p-lens-setter run-p-lens p-lens-compose make-p-prism p-prism? p-prism-match p-prism-build run-p-prism p-prism-compose make-p-affine p-affine? p-affine-preview p-affine-set run-p-affine p-affine-compose make-p-traversal p-traversal? p-traversal-traverse p-traversal-fold-fn run-p-traversal p-traversal-to-list p-traversal-over p-traversal-set p-traversal-compose p-traversal-each p-traversal-both p-traversal-filtered make-p-fold p-fold? p-fold-fn p-fold-to-list p-fold-preview p-fold-has p-fold-length p-fold-all p-fold-any p-fold-compose p-fold-each p-fold-filtered p-fold-taking traversal->p-traversal p-traversal->traversal p-lens->p-traversal p-prism->p-traversal)) (answer "(define (p-affine->p-traversal paffine) (make-p-traversal (lambda (f s) (let ((e ((p-affine-preview paffine) s))) (if (left? e) (from-left e) (((p-affine-set paffine) s) (f (from-right e)))))) (lambda (s) (let ((e ((p-affine-preview paffine) s))) (if (left? e) '() (list (from-right e)))))))"))
(task-entry (id "info/entropy/binary-entropy") (skill info) (module entropy) (tier 1) (difficulty 11107) (name binary-entropy) (type "(-> Number Number)") (description "Binary entropy function H(p) = -p*log2(p) - (1-p)*log2(1-p)") (notes ()) (section binary-entropy) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2 plogp entropy entropy-normalized max-entropy entropy-ratio)) (answer "(define (binary-entropy p) (cond ((<= p 0) 0) ((>= p 1) 0) (else (- (+ (plogp p) (plogp (- 1 p)))))))"))
(task-entry (id "info/statistical-measures/jeffreys-divergence") (skill info) (module statistical-measures) (tier 1) (difficulty 11107) (name jeffreys-divergence) (type "(-> (List Real) (List Real) Real)") (description "Jeffreys divergence J(P,Q) = D_KL(P||Q) + D_KL(Q||P), symmetric KL") (notes ()) (section jeffreys-divergence) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance hellinger-distance hellinger-distance-from-bc total-variation-distance chi-squared-divergence symmetric-chi-squared)) (answer "(define (jeffreys-divergence p q) (let ((kl-pq (kl-divergence p q)) (kl-qp (kl-divergence q p))) (+ kl-pq kl-qp)))"))
(task-entry (id "info/channel-capacity/awgn-capacity-db") (skill info) (module channel-capacity) (tier 1) (difficulty 11107) (name awgn-capacity-db) (type "(-> Real Real)") (description "AWGN channel capacity with SNR in decibels") (notes ()) (section awgn-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix bsc-mutual-information bec-capacity z-channel-capacity z-channel-transition-matrix awgn-capacity)) (answer "(define (awgn-capacity-db snr-db) (awgn-capacity (db-to-linear snr-db)))"))
(task-entry (id "info/rate-distortion/snr") (skill info) (module rate-distortion) (tier 1) (difficulty 11107) (name snr) (type "(-> (List Real) (List Real) Real)") (description "Signal-to-noise ratio (linear): var(signal) / MSE") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error hamming-distortion mse mae rmse normalized-mse)) (answer "(define (snr original reconstructed) (let ((v (variance original)) (m (mse original reconstructed))) (if (<= m 0) +inf.0 (/ v m))))"))
(task-entry (id "info/coding/huffman-build-loop") (skill info) (module coding) (tier 1) (difficulty 11107) (name huffman-build-loop) (type "(-> (List Node) Node)") (description "Main Huffman algorithm loop: combine two lowest-prob nodes") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal huffman-leaf? huffman-symbol huffman-children huffman-prob build-huffman-tree)) (answer "(define (huffman-build-loop nodes) (if (null? (cdr nodes)) (car nodes) (let* ((sorted (sort-by-prob nodes)) (n1 (car sorted)) (n2 (cadr sorted)) (rest (cddr sorted)) (combined (make-huffman-internal n1 n2))) (huffman-build-loop (cons combined rest)))))"))
(task-entry (id "info/model-selection-info/residual-entropy-bits") (skill info) (module model-selection-info) (tier 1) (difficulty 11107) (name residual-entropy-bits) (type "(-> (List Number) Number)") (description "Differential entropy of residuals assuming Gaussian distribution.\n   h = 0.5 * log2(2*pi*e*sigma^2) bits. Connects model diagnostics to\n   info-theoretic channel capacity: a model with lower residual entropy\n   captures more information from the data.") (notes ()) (section entropy-rate-connection) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (log-likelihood-gaussian log-likelihood-gaussian-vec aic bic aicc aic-weights evidence-ratio)) (answer "(define (residual-entropy-bits residuals) (let* ((n (length residuals)) (ss (fold-left + 0 (map (lambda (r) (* r r)) residuals))) (sigma2 (/ ss n))) (if (<= sigma2 0) -inf.0 (gaussian-entropy (sqrt sigma2)))))"))
(task-entry (id "info/empirical-info/nmi-empirical") (skill info) (module empirical-info) (tier 1) (difficulty 11107) (name nmi-empirical) (type "(-> (List Number) (List Number) (Nat) Number)") (description "Normalized mutual information from sample vectors.\n   NMI = I(X;Y) / sqrt(H(X) * H(Y)), in [0, 1].") (notes ()) (section normalized-mutual-information-empirical) (deps (\x27;prelude \x27;entropy)) (available (discretize-uniform default-num-bins entropy-empirical mutual-information-empirical build-joint-counts compute-column-sums conditional-entropy-empirical)) (answer "(define (nmi-empirical xs ys . opts) (let* ((hx (apply entropy-empirical xs opts)) (hy (apply entropy-empirical ys opts)) (mi (apply mutual-information-empirical xs ys opts))) (if (or (<= hx 0) (<= hy 0)) 0 (/ mi (sqrt (* hx hy))))))"))
(task-entry (id "info/partition-info/label-index-map") (skill info) (module partition-info) (tier 1) (difficulty 11107) (name label-index-map) (type "") (description "") (notes ()) (section partition-mutual-information) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy partition-sizes sort-labels insert-sorted partition-mi build-contingency-table unique-labels)) (answer "(define (label-index-map labels-list) (let ((ht (make-hashtable equal-hash equal?))) (let loop ((ls labels-list) (i 0)) (if (null? ls) ht (begin (hashtable-set! ht (car ls) i) (loop (cdr ls) (+ i 1)))))))"))
