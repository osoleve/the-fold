(task-entry (id "fp/zipper/zipper-modify") (skill fp) (module zipper) (tier 1) (difficulty 10625) (name zipper-modify) (type "(-> (ListZipper α) (-> α α) (ListZipper α))") (description "Modify the focused element. Error if no focus") (notes ()) (section focus-operations) (deps (\x27;prelude \x27;combinators)) (available (zipper-tag make-zipper zipper? zipper-left zipper-focus-maybe zipper-right zipper-empty zipper-empty? zipper-singleton list->zipper zipper->list zipper-from-position zipper-has-focus? zipper-can-go-left? zipper-can-go-right? zipper-left! zipper-right! zipper-start zipper-end zipper-goto zipper-position zipper-length zipper-focus zipper-focus-or zipper-set)) (answer "(define (zipper-modify z f) (if (not (zipper-has-focus? z)) (error 'zipper-modify \"no focused element to modify\") (make-zipper (zipper-left z) (just (f (from-just (zipper-focus-maybe z)))) (zipper-right z))))"))
