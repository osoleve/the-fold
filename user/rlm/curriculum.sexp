(task-entry (id "optics/bidirectional/make-migration") (skill optics) (module bidirectional) (tier 1) (difficulty 11000) (name make-migration) (type "(-> Symbol Version Version PIso Migration)") (description "Create a named migration between two versions.\nThe iso's forward transforms from-version to to-version,\nand the backward transforms to-version back to from-version.") (notes ()) (section migration-type) (deps (\x27;profunctor-optics)) (available ()) (answer "(define (make-migration name from-version to-version iso) (list 'migration name from-version to-version iso))"))
(task-entry (id "optics/format-iso/iso-utf8") (skill optics) (module format-iso) (tier 1) (difficulty 11000) (name iso-utf8) (type "") (description "") (notes ()) (section string-bytevector) (deps (\x27;sort \x27;profunctor-optics)) (available ()) (answer "(define iso-utf8 (make-p-iso string->utf8 utf8->string))"))
(task-entry (id "optics/schema/field-rename-iso") (skill optics) (module schema) (tier 1) (difficulty 11000) (name field-rename-iso) (type "(-> Symbol Symbol (PIso Alist Alist))") (description "Create an iso that renames a field. Forward: old-name -> new-name, Backward: new-name -> old-name") (notes ()) (section field-rename) (deps (\x27;profunctor-optics)) (available ()) (answer "(define (field-rename-iso old-name new-name) (make-p-iso (lambda (alist) (map (lambda (pair) (if (eq? (car pair) old-name) (cons new-name (cdr pair)) pair)) alist)) (lambda (alist) (map (lambda (pair) (if (eq? (car pair) new-name) (cons old-name (cdr pair)) pair)) alist))))"))
