(task-entry (id "statistics/design-matrix/column-std") (skill statistics) (module design-matrix) (tier 1) (difficulty 11203) (name column-std) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean)) (answer "(define (column-std X j) (let* ((m (matrix-rows X)) (mu (column-mean X j)) (ss (let loop ((i 0) (s 0)) (if (= i m) s (loop (+ i 1) (+ s (expt (- (matrix-ref X i j) mu) 2))))))) (if (<= m 1) 0 (sqrt (/ ss (- m 1))))))"))
