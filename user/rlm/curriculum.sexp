(task-entry (id "random/bayesian/log-marginal-likelihood-normal-normal") (skill random) (module bayesian) (tier 1) (difficulty 12940) (name log-marginal-likelihood-normal-normal) (type "") (description "") (notes ()) (section bayesian-model-selection) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode log-beta-pdf log-beta log-normal-pdf log-gamma-pdf log-poisson-pmf log-factorial kl-divergence-normal kl-divergence-beta digamma log-marginal-likelihood-beta-binomial log-binomial-coeff)) (answer "(define (log-marginal-likelihood-normal-normal prior observations known-variance) (if (null? observations) 0 (let* ((n (length observations)) (sigma2 known-variance) (tau02 (normal-prior-variance prior)) (mu0 (normal-prior-mean prior)) (xbar (/ (apply + observations) n)) (ss (apply + (map (lambda (x) (let ((d (- x xbar))) (* d d))) observations))) (term1 (* -0.5 n (log (* 2 3.141592653589793 sigma2)))) (term2 (/ (- ss) (* 2 sigma2))) (term3 (* -0.5 (log (+ 1 (/ (* n tau02) sigma2))))) (term4 (/ (- (* n (let ((d (- xbar mu0))) (* d d)))) (* 2 (+ sigma2 (* n tau02)))))) (+ term1 term2 term3 term4))))"))
