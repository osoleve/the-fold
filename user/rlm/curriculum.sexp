(task-entry (id "fp/protocol-bundle/dedupe-slots") (skill fp) (module protocol-bundle) (tier 1) (difficulty 10625) (name dedupe-slots) (type "") (description "") (notes ()) (section none) (deps (\x27;protocol)) (available (make-protocol-bundle bundle? bundle-name bundle-slots make-bundle-slot slot? slot-getter slot-setter slot-label *bundle-registry* register-bundle! get-bundle list-bundles build-getter-name build-setter-name derive-bundle-runtime! find-override implement-bundle-runtime! find-impl-spec find-slot-by-label bundle-types bundle-protocols bundle-slot-count implements-bundle? compose-bundles)) (answer "(define (dedupe-slots slots) (let loop ((remaining slots) (seen '()) (result '())) (cond ((null? remaining) (reverse result)) ((member (slot-label (car remaining)) seen) (loop (cdr remaining) seen result)) (else (loop (cdr remaining) (cons (slot-label (car remaining)) seen) (cons (car remaining) result))))))"))
