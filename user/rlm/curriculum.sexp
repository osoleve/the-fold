(task-entry (id "fp/units/qty->string") (skill fp) (module units) (tier 1) (difficulty 10713) (name qty->string) (type "(-> Quantity String)") (description "Display quantity with units.") (notes ()) (section dimension-display) (deps (\x27;prelude)) (available (make-dim dim-length dim-time dim-mass dim-current dim-temperature dim-amount dim-luminosity dim? dim=? dim-one dim-length-base dim-time-base dim-mass-base dim-current-base dim-temperature-base dim-amount-base dim-luminosity-base dim* dim/ dim-pow dim-sqrt dim-inv make-qty qty-value qty-dim qty? qty+ qty- qty* qty/ qty-scale qty-pow qty-sqrt qty-neg qty-abs qty=? qty<? qty>? qty<=? qty>=? meter second kilogram ampere kelvin mole candela dim-velocity dim-acceleration dim-force dim-energy dim-power dim-pressure dim-frequency dim-charge dim-voltage dim-resistance dim-area dim-volume newton joule watt pascal hertz coulomb volt ohm yotta zetta exa peta tera giga mega kilo hecto deca deci centi milli micro nano pico femto atto zepto yocto kilometer centimeter millimeter micrometer nanometer millisecond microsecond nanosecond gram milligram kilowatt megawatt gigawatt kilojoule megajoule milliampere microampere kilohertz megahertz gigahertz kilovolt millivolt kiloohm megaohm dim->string)) (answer "(define (qty->string q) (string-append (number->string (qty-value q)) \" \" (dim->string (qty-dim q))))"))
(task-entry (id "diffgeo/charts/jacobian-numerical") (skill diffgeo) (module charts) (tier 1) (difficulty 10713) (name jacobian-numerical) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp)) (available (chart? chart-name chart-dim chart-domain-pred chart-coord-map chart-inverse-map make-chart chart-contains? chart-apply chart-apply-inverse make-transition transition-apply *jacobian-epsilon*)) (answer "(define (jacobian-numerical f coords . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *jacobian-epsilon* (car epsilon-arg))) (n (vector-length coords)) (f0 (f coords)) (m (vector-length f0)) (result (make-matrix m n 0))) (do ((j 0 (+ j 1))) ((= j n) result) (let ((coords-plus (vec-copy coords)) (coords-minus (vec-copy coords))) (vector-set! coords-plus j (+ (vector-ref coords j) eps)) (vector-set! coords-minus j (- (vector-ref coords j) eps)) (let ((f-plus (f coords-plus)) (f-minus (f coords-minus))) (do ((i 0 (+ i 1))) ((= i m)) (let ((deriv (/ (- (vector-ref f-plus i) (vector-ref f-minus i)) (* 2 eps)))) (vector-set! (matrix-data result) (+ (* i n) j) deriv))))))))"))
(task-entry (id "diffgeo/tangent/cotangent-vector?") (skill diffgeo) (module tangent) (tier 1) (difficulty 10713) (name cotangent-vector?) (type "") (description "") (notes ()) (section tangent-vector-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts)) (available (tangent-vector? tangent-vector-point tangent-vector-chart tangent-vector-components tangent-vector-dim make-tangent-vector tangent-zero tangent-basis-vector tangent-add tangent-sub tangent-scale tangent-negate tangent-change-chart)) (answer "(define (cotangent-vector? x) (and (pair? x) (eq? (car x) 'cotangent-vector) (= (length x) 4) (chart? (cotangent-vector-chart x)) (vector? (cotangent-vector-components x))))"))
