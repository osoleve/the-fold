(task-entry (id "crypto/elliptic-curve/ec-jacobian-double") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10527) (name ec-jacobian-double) (type "(-> Curve JacobianPoint JacobianPoint)") (description "Point doubling 2P in Jacobian coordinates") (notes ()) (section jacobian-coordinates) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian)) (answer "(define (ec-jacobian-double curve jpt) (if (ec-jacobian-infinity? jpt) ec-jacobian-infinity (let* ((p (ec-p curve)) (a (ec-a curve)) (X1 (modulo (ec-jacobian-X jpt) p)) (Y1 (modulo (ec-jacobian-Y jpt) p)) (Z1 (modulo (ec-jacobian-Z jpt) p))) (if (= Y1 0) ec-jacobian-infinity (let* ((Y1-sq (mod* Y1 Y1 p)) (S (mod* 4 (mod* X1 Y1-sq p) p)) (X1-sq (mod* X1 X1 p)) (Z1-sq (mod* Z1 Z1 p)) (Z1-4 (mod* Z1-sq Z1-sq p)) (M (mod+ (mod* 3 X1-sq p) (mod* a Z1-4 p) p)) (M-sq (mod* M M p)) (X3 (mod- M-sq (mod* 2 S p) p)) (Y1-4 (mod* Y1-sq Y1-sq p)) (Y3 (mod- (mod* M (mod- S X3 p) p) (mod* 8 Y1-4 p) p)) (Z3 (mod* 2 (mod* Y1 Z1 p) p))) (make-ec-jacobian X3 Y3 Z3))))))"))
(task-entry (id "crypto/elliptic-curve/ec-jacobian-add") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10528) (name ec-jacobian-add) (type "(-> Curve JacobianPoint JacobianPoint JacobianPoint)") (description "Point addition P + Q in Jacobian coordinates") (notes ()) (section jacobian-coordinates) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double)) (answer "(define (ec-jacobian-add curve P Q) (cond ((ec-jacobian-infinity? P) Q) ((ec-jacobian-infinity? Q) P) (else (let* ((p (ec-p curve)) (X1 (modulo (ec-jacobian-X P) p)) (Y1 (modulo (ec-jacobian-Y P) p)) (Z1 (modulo (ec-jacobian-Z P) p)) (X2 (modulo (ec-jacobian-X Q) p)) (Y2 (modulo (ec-jacobian-Y Q) p)) (Z2 (modulo (ec-jacobian-Z Q) p)) (Z1-sq (mod* Z1 Z1 p)) (Z2-sq (mod* Z2 Z2 p)) (U1 (mod* X1 Z2-sq p)) (U2 (mod* X2 Z1-sq p)) (Z1-cu (mod* Z1-sq Z1 p)) (Z2-cu (mod* Z2-sq Z2 p)) (S1 (mod* Y1 Z2-cu p)) (S2 (mod* Y2 Z1-cu p))) (cond ((= U1 U2) (if (= S1 S2) (ec-jacobian-double curve P) ec-jacobian-infinity)) (else (let* ((H (mod- U2 U1 p)) (R (mod- S2 S1 p)) (H-sq (mod* H H p)) (H-cu (mod* H-sq H p)) (X3 (mod- (mod- (mod* R R p) H-cu p) (mod* 2 (mod* U1 H-sq p) p) p)) (Y3 (mod- (mod* R (mod- (mod* U1 H-sq p) X3 p) p) (mod* S1 H-cu p) p)) (Z3 (mod* H (mod* Z1 Z2 p) p))) (make-ec-jacobian X3 Y3 Z3))))))))"))
(task-entry (id "crypto/elliptic-curve/ec-jacobian-add-mixed") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10529) (name ec-jacobian-add-mixed) (type "(-> Curve JacobianPoint Point JacobianPoint)") (description "Mixed addition: Jacobian + affine point") (notes ()) (section jacobian-coordinates) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add)) (answer "(define (ec-jacobian-add-mixed curve jP aQ) (cond ((ec-jacobian-infinity? jP) (ec-to-jacobian aQ)) ((ec-infinity? aQ) jP) (else (let* ((p (ec-p curve)) (X1 (modulo (ec-jacobian-X jP) p)) (Y1 (modulo (ec-jacobian-Y jP) p)) (Z1 (modulo (ec-jacobian-Z jP) p)) (x2 (ec-point-x aQ)) (y2 (ec-point-y aQ)) (Z1-sq (mod* Z1 Z1 p)) (Z1-cu (mod* Z1-sq Z1 p)) (U2 (mod* x2 Z1-sq p)) (S2 (mod* y2 Z1-cu p))) (cond ((= X1 U2) (if (= Y1 S2) (ec-jacobian-double curve jP) ec-jacobian-infinity)) (else (let* ((H (mod- U2 X1 p)) (R (mod- S2 Y1 p)) (H-sq (mod* H H p)) (H-cu (mod* H-sq H p)) (X3 (mod- (mod- (mod* R R p) H-cu p) (mod* 2 (mod* X1 H-sq p) p) p)) (Y3 (mod- (mod* R (mod- (mod* X1 H-sq p) X3 p) p) (mod* Y1 H-cu p) p)) (Z3 (mod* H Z1 p))) (make-ec-jacobian X3 Y3 Z3))))))))"))
(task-entry (id "crypto/elliptic-curve/ec-mul") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10530) (name ec-mul) (type "(-> Curve Int Point Point)") (description "Scalar multiplication k*P using double-and-add") (notes ("O(log k) point operations" "WARNING: Not constant-time - vulnerable to timing attacks with secret scalars")) (section scalar-multiplication) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add ec-jacobian-add-mixed)) (answer "(define (ec-mul curve k P) (cond ((= k 0) ec-infinity) ((ec-infinity? P) ec-infinity) ((< k 0) (ec-mul curve (- k) (ec-negate curve P))) (else (let ((jP (ec-to-jacobian P))) (ec-from-jacobian curve (let loop ((n k) (R ec-jacobian-infinity) (Q jP)) (cond ((= n 0) R) ((odd? n) (loop (quotient n 2) (ec-jacobian-add curve R Q) (ec-jacobian-double curve Q))) (else (loop (quotient n 2) R (ec-jacobian-double curve Q))))))))))"))
(task-entry (id "crypto/elliptic-curve/ec-mul-affine") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10531) (name ec-mul-affine) (type "(-> Curve Int Point Point)") (description "Scalar multiplication in affine coordinates (reference implementation)") (notes ()) (section scalar-multiplication) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add ec-jacobian-add-mixed ec-mul)) (answer "(define (ec-mul-affine curve k P) (cond ((= k 0) ec-infinity) ((ec-infinity? P) ec-infinity) ((< k 0) (ec-mul-affine curve (- k) (ec-negate curve P))) (else (let loop ((n k) (R ec-infinity) (Q P)) (cond ((= n 0) R) ((odd? n) (loop (quotient n 2) (ec-add curve R Q) (ec-double curve Q))) (else (loop (quotient n 2) R (ec-double curve Q))))))))"))
(task-entry (id "crypto/elliptic-curve/bit-length") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10532) (name bit-length) (type "") (description "") (notes ()) (section scalar-multiplication) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add ec-jacobian-add-mixed ec-mul ec-mul-affine)) (answer "(define (bit-length n) (if (<= n 0) 0 (let loop ((x n) (count 0)) (if (= x 0) count (loop (quotient x 2) (+ count 1))))))"))
(task-entry (id "crypto/elliptic-curve/bit-ref") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10533) (name bit-ref) (type "") (description "") (notes ()) (section scalar-multiplication) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add ec-jacobian-add-mixed ec-mul ec-mul-affine bit-length)) (answer "(define (bit-ref n i) (bitwise-and (bitwise-arithmetic-shift-right n i) 1))"))
(task-entry (id "crypto/elliptic-curve/ec-cswap") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10534) (name ec-cswap) (type "") (description "") (notes ()) (section scalar-multiplication) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add ec-jacobian-add-mixed ec-mul ec-mul-affine bit-length bit-ref)) (answer "(define (ec-cswap bit R0 R1) (if (= bit 1) (values R1 R0) (values R0 R1)))"))
(task-entry (id "crypto/elliptic-curve/ec-mul-montgomery") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10535) (name ec-mul-montgomery) (type "(-> Curve Int Point Point)") (description "Scalar multiplication using Montgomery Ladder (constant-time algorithm)") (notes ("Follows constant-time algorithm pattern; see source for caveats on interpreter-level timing" "O(log n) point operations where n is the curve order")) (section scalar-multiplication) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add ec-jacobian-add-mixed ec-mul ec-mul-affine bit-length bit-ref ec-cswap)) (answer "(define (ec-mul-montgomery curve k P) (cond ((= k 0) ec-infinity) ((ec-infinity? P) ec-infinity) ((< k 0) (ec-mul-montgomery curve (- k) (ec-negate curve P))) (else (let* ((n (ec-n curve)) (k-reduced (if (>= k n) (modulo k n) k))) (if (= k-reduced 0) ec-infinity (let ((jP (ec-to-jacobian P)) (nbits (bit-length n))) (ec-from-jacobian curve (let loop ((i (- nbits 1)) (R0 ec-jacobian-infinity) (R1 jP)) (if (< i 0) R0 (let* ((bi (bit-ref k-reduced i))) (let-values (((R0* R1*) (ec-cswap bi R0 R1))) (let ((R1** (ec-jacobian-add curve R0* R1*)) (R0** (ec-jacobian-double curve R0*))) (let-values (((R0*** R1***) (ec-cswap bi R0** R1**))) (loop (- i 1) R0*** R1***))))))))))))))"))
(task-entry (id "crypto/elliptic-curve/ec-mul-secure") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10536) (name ec-mul-secure) (type "(-> Curve Int Point Point)") (description "Scalar multiplication using constant-time algorithm (see caveats)") (notes ("Algorithm-level timing resistance; see ec-mul-montgomery for full caveats")) (section scalar-multiplication) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add ec-jacobian-add-mixed ec-mul ec-mul-affine bit-length bit-ref ec-cswap ec-mul-montgomery)) (answer "(define (ec-mul-secure curve k P) (ec-mul-montgomery curve k P))"))
(task-entry (id "crypto/elliptic-curve/ec-compress") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10537) (name ec-compress) (type "(-> Curve Point (Union (List Symbol Int) Symbol))") (description "Compress point to x-coordinate and y-parity") (notes ()) (section point-compression) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add ec-jacobian-add-mixed ec-mul ec-mul-affine bit-length bit-ref ec-cswap ec-mul-montgomery ec-mul-secure)) (answer "(define (ec-compress curve pt) (if (ec-infinity? pt) 'infinity (let* ((y (ec-point-y pt)) (parity (if (even? y) 'even 'odd))) (list parity (ec-point-x pt)))))"))
(task-entry (id "crypto/elliptic-curve/ec-decompress") (skill crypto) (module elliptic-curve) (tier 1) (difficulty 10538) (name ec-decompress) (type "(-> Curve (Union (List Symbol Int) Symbol) Point)") (description "Decompress point from x-coordinate and y-parity") (notes ()) (section point-compression) (deps (\x27;prelude \x27;modular)) (available (make-ec-curve ec-curve? ec-p ec-a ec-b ec-n ec-G make-ec-point ec-point? ec-point-x ec-point-y ec-infinity ec-infinity? ec-on-curve? ec-valid-point? ec-negate ec-add ec-double make-ec-jacobian ec-jacobian? ec-jacobian-X ec-jacobian-Y ec-jacobian-Z ec-jacobian-infinity ec-jacobian-infinity? ec-to-jacobian ec-from-jacobian ec-jacobian-double ec-jacobian-add ec-jacobian-add-mixed ec-mul ec-mul-affine bit-length bit-ref ec-cswap ec-mul-montgomery ec-mul-secure ec-compress)) (answer "(define (ec-decompress curve compressed) (if (eq? compressed 'infinity) ec-infinity (let* ((parity (car compressed)) (x (cadr compressed)) (p (ec-p curve)) (a (ec-a curve)) (b (ec-b curve)) (x2 (mod* x x p)) (x3 (mod* x2 x p)) (y-sq (mod+ x3 (mod+ (mod* a x p) b p) p)) (y (mod-sqrt y-sq p))) (if (not y) (error 'ec-decompress \"invalid compressed point: no square root\") (let ((y-final (if (eq? (if (even? y) 'even 'odd) parity) y (- p y)))) (make-ec-point x y-final))))))"))
