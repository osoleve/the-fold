(task-entry (id "clp/domain/interval->string") (skill clp) (module domain) (tier 1) (difficulty 10828) (name interval->string) (type "(-> Interval String)") (description "Convert interval to string") (notes ()) (section domain-display) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals interval<? domain-subtract-value domain-subtract domain-restrict-min domain-restrict-max domain->list domain-for-each domain-fold domain=? domain-subset? domain->string)) (answer "(define (interval->string interval) (let ((lo (car interval)) (hi (cdr interval))) (if (= lo hi) (number->string lo) (string-append (number->string lo) \"..\" (number->string hi)))))"))
(task-entry (id "clp/store/cstore-constraints-for-var") (skill clp) (module store) (tier 1) (difficulty 10828) (name cstore-constraints-for-var) (type "(-> CStore LVar (List Constraint))") (description "Get all constraints involving a variable") (notes ()) (section constraint-management) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint)) (answer "(define (cstore-constraints-for-var cs var) (let ((id (lvar-id var))) (filter (lambda (c) (any (lambda (v) (= (lvar-id v) id)) (constraint-vars c))) (cstore-constraints cs))))"))
(task-entry (id "clp/clp/stream-count") (skill clp) (module clp) (tier 1) (difficulty 10828) (name stream-count) (type "(-> Stream Nat Nat)") (description "Count stream elements up to limit") (notes ()) (section convenience-api) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count)) (answer "(define (stream-count stream limit) (let loop ((s stream) (n 0)) (if (or (>= n limit) (stream-nil? s)) n (loop (stream-tail s) (+ n 1)))))"))
(task-entry (id "clp/domain/list-intersperse") (skill clp) (module domain) (tier 1) (difficulty 10829) (name list-intersperse) (type "(-> (List α) α (List α))") (description "Intersperse separator between list elements") (notes ()) (section domain-display) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals interval<? domain-subtract-value domain-subtract domain-restrict-min domain-restrict-max domain->list domain-for-each domain-fold domain=? domain-subset? domain->string interval->string)) (answer "(define (list-intersperse lst sep) (cond ((null? lst) '()) ((null? (cdr lst)) lst) (else (cons (car lst) (cons sep (list-intersperse (cdr lst) sep))))))"))
(task-entry (id "clp/store/any") (skill clp) (module store) (tier 1) (difficulty 10829) (name any) (type "(-> (-> α Bool) (List α) Bool)") (description "Check if predicate is true for any element") (notes ()) (section constraint-management) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var)) (answer "(define (any pred lst) (cond ((null? lst) #f) ((pred (car lst)) #t) (else (any pred (cdr lst)))))"))
(task-entry (id "clp/clp/n-queens") (skill clp) (module clp) (tier 1) (difficulty 10829) (name n-queens) (type "(-> Nat (Values Goal (List LVar)))") (description "Set up N-Queens problem as a CLP goal. Returns (values goal queens-vars) so callers can extract solution values via run-clp.") (notes ()) (section examples-n-queens) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count)) (answer "(define (n-queens n) (let ((queens (map (lambda (i) (make-lvar 'q)) (range 0 n)))) (values (clp-conj* (append (map (lambda (q) (goal-in-range q 1 n)) queens) (list (goal-all-different queens)) (clp-queens-diagonal-constraints queens 0) (list (goal-label queens)))) queens)))"))
(task-entry (id "clp/store/cstore-add-pending") (skill clp) (module store) (tier 1) (difficulty 10830) (name cstore-add-pending) (type "(-> CStore LVar CStore)") (description "Add variable to propagation queue") (notes ()) (section propagation-queue) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any)) (answer "(define (cstore-add-pending cs var) (let* ((id (lvar-id var)) (pending (cstore-pending cs))) (if (member id pending) cs (cstore-set-pending cs (cons id pending)))))"))
(task-entry (id "clp/clp/clp-queens-diagonal-constraints") (skill clp) (module clp) (tier 1) (difficulty 10830) (name clp-queens-diagonal-constraints) (type "(-> (List LVar) Nat (List Goal))") (description "Generate diagonal constraints for N-Queens") (notes ()) (section examples-n-queens) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens)) (answer "(define (clp-queens-diagonal-constraints queens row) (if (null? queens) '() (append (queens-diagonal-with-rest (car queens) (cdr queens) row (+ row 1)) (clp-queens-diagonal-constraints (cdr queens) (+ row 1)))))"))
(task-entry (id "clp/store/cstore-pop-pending") (skill clp) (module store) (tier 1) (difficulty 10831) (name cstore-pop-pending) (type "(-> CStore (Maybe (Pair LVarId CStore)))") (description "Pop a variable from propagation queue") (notes ()) (section propagation-queue) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending)) (answer "(define (cstore-pop-pending cs) (let ((pending (cstore-pending cs))) (if (null? pending) #f (cons (car pending) (cstore-set-pending cs (cdr pending))))))"))
(task-entry (id "clp/clp/queens-diagonal-with-rest") (skill clp) (module clp) (tier 1) (difficulty 10831) (name queens-diagonal-with-rest) (type "(-> LVar (List LVar) Nat Nat (List Goal))") (description "Generates constraints: |q1 - q2| ≠ diff for each q2 in rest") (notes ("Checks (q1 - q2) ≠ diff AND (q1 - q2) ≠ -diff, equivalent to q1 ≠ q2 + diff AND q1 ≠ q2 - diff")) (section examples-n-queens) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens clp-queens-diagonal-constraints)) (answer "(define (queens-diagonal-with-rest q1 rest row1 row2) (if (null? rest) '() (let* ((q2 (car rest)) (diff (- row2 row1))) (cons (make-diagonal-constraint q1 q2 diff) (queens-diagonal-with-rest q1 (cdr rest) row1 (+ row2 1))))))"))
(task-entry (id "clp/store/cstore-clear-pending") (skill clp) (module store) (tier 1) (difficulty 10832) (name cstore-clear-pending) (type "(-> CStore CStore)") (description "Clear the propagation queue") (notes ()) (section propagation-queue) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending)) (answer "(define (cstore-clear-pending cs) (cstore-set-pending cs '()))"))
(task-entry (id "clp/clp/=/=fd-diagonal") (skill clp) (module clp) (tier 1) (difficulty 10832) (name =/=fd-diagonal) (type "(-> LVar LVar Int (-> CStore (Maybe CStore)))") (description "Constrain q1 such that |q1 - q2| ≠ diff") (notes ("Uses domain narrowing when one is ground")) (section examples-n-queens) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens clp-queens-diagonal-constraints queens-diagonal-with-rest)) (answer "(define (=/=fd-diagonal q1 q2 diff) (lambda (cs) (let ((q1-val (cstore-get-value cs q1)) (q2-val (cstore-get-value cs q2))) (cond ((and q1-val q2-val) (if (= (abs (- q1-val q2-val)) diff) #f cs)) (q2-val (let* ((forbidden1 (+ q2-val diff)) (forbidden2 (- q2-val diff)) (cs1 (cstore-remove-value cs q1 forbidden1))) (and cs1 (cstore-remove-value cs1 q1 forbidden2)))) (q1-val (let* ((forbidden1 (- q1-val diff)) (forbidden2 (+ q1-val diff)) (cs1 (cstore-remove-value cs q2 forbidden1))) (and cs1 (cstore-remove-value cs1 q2 forbidden2)))) (else cs)))))"))
(task-entry (id "clp/store/cstore-ground?") (skill clp) (module store) (tier 1) (difficulty 10833) (name cstore-ground?) (type "(-> CStore LVar Bool)") (description "Check if variable is bound to a ground (non-variable) value") (notes ()) (section ground-singleton-detection) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending)) (answer "(define (cstore-ground? cs var) (let ((val (walk var (cstore-subst cs)))) (not (lvar? val))))"))
(task-entry (id "clp/clp/make-diagonal-constraint") (skill clp) (module clp) (tier 1) (difficulty 10833) (name make-diagonal-constraint) (type "(-> LVar LVar Int Goal)") (description "Create constraint: |q1 - q2| ≠ diff") (notes ("Registers the constraint for re-propagation during labeling")) (section examples-n-queens) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens clp-queens-diagonal-constraints queens-diagonal-with-rest =/=fd-diagonal)) (answer "(define (make-diagonal-constraint q1 q2 diff) (lambda (cs) (let ((cs1 (post-constraint cs 'diagonal (list q1 q2) (=/=fd-diagonal q1 q2 diff)))) (if cs1 (clp-succeed cs1) (clp-fail cs)))))"))
(task-entry (id "clp/store/cstore-singleton?") (skill clp) (module store) (tier 1) (difficulty 10834) (name cstore-singleton?) (type "(-> CStore LVar Bool)") (description "Check if variable has a singleton domain") (notes ()) (section ground-singleton-detection) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground?)) (answer "(define (cstore-singleton? cs var) (let ((dom (cstore-get-domain cs var))) (and dom (domain-singleton? dom))))"))
(task-entry (id "clp/clp/send-more-money") (skill clp) (module clp) (tier 1) (difficulty 10834) (name send-more-money) (type "(-> (Values Goal (List LVar) (List Symbol)))") (description "Classic cryptarithmetic puzzle: SEND + MORE = MONEY. Returns (values goal vars names) so callers can extract named solution values.") (notes ()) (section examples-send-more-money) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens clp-queens-diagonal-constraints queens-diagonal-with-rest =/=fd-diagonal make-diagonal-constraint)) (answer "(define (send-more-money) (let ((s (make-lvar 's)) (e (make-lvar 'e)) (n (make-lvar 'n)) (d (make-lvar 'd)) (m (make-lvar 'm)) (o (make-lvar 'o)) (r (make-lvar 'r)) (y (make-lvar 'y))) (let ((vars (list s e n d m o r y)) (names '(s e n d m o r y))) (values (clp-conj* (append (map (lambda (v) (goal-in-range v 0 9)) vars) (list (goal-all-different vars)) (list (goal->fd s 0)) (list (goal->fd m 0)) (list (goal-send-more-money-eq s e n d m o r y)) (list (goal-label vars)))) vars names))))"))
(task-entry (id "clp/store/cstore-get-value") (skill clp) (module store) (tier 1) (difficulty 10835) (name cstore-get-value) (type "(-> CStore LVar (Maybe Int))") (description "Get the value of a ground variable") (notes ()) (section ground-singleton-detection) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground? cstore-singleton?)) (answer "(define (cstore-get-value cs var) (let ((val (walk var (cstore-subst cs)))) (if (integer? val) val (let ((dom (cstore-get-domain cs var))) (and dom (domain-singleton? dom) (domain-min dom))))))"))
(task-entry (id "clp/clp/goal-send-more-money-eq") (skill clp) (module clp) (tier 1) (difficulty 10835) (name goal-send-more-money-eq) (type "(-> LVar LVar LVar LVar LVar LVar LVar LVar Goal)") (description "The arithmetic constraint for SEND + MORE = MONEY") (notes ("Registered as persistent constraint so it's re-checked during labeling")) (section examples-send-more-money) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens clp-queens-diagonal-constraints queens-diagonal-with-rest =/=fd-diagonal make-diagonal-constraint send-more-money)) (answer "(define (goal-send-more-money-eq s e n d m o r y) (lambda (cs) (let ((cs1 (post-constraint cs 'smm-eq (list s e n d m o r y) (smm-eq-check s e n d m o r y)))) (if cs1 (clp-succeed cs1) (clp-fail cs)))))"))
(task-entry (id "clp/store/cstore-walk") (skill clp) (module store) (tier 1) (difficulty 10836) (name cstore-walk) (type "(-> CStore Term Term)") (description "Walk a term through the store's substitution") (notes ()) (section reification) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground? cstore-singleton? cstore-get-value)) (answer "(define (cstore-walk cs term) (walk term (cstore-subst cs)))"))
(task-entry (id "clp/clp/smm-eq-check") (skill clp) (module clp) (tier 1) (difficulty 10836) (name smm-eq-check) (type "(-> LVar ... (-> CStore (Maybe CStore)))") (description "Propagator for SEND+MORE=MONEY: validates when all ground, passes when partial") (notes ()) (section examples-send-more-money) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens clp-queens-diagonal-constraints queens-diagonal-with-rest =/=fd-diagonal make-diagonal-constraint send-more-money goal-send-more-money-eq)) (answer "(define (smm-eq-check s e n d m o r y) (lambda (cs) (let ((sv (cstore-get-value cs s)) (ev (cstore-get-value cs e)) (nv (cstore-get-value cs n)) (dv (cstore-get-value cs d)) (mv (cstore-get-value cs m)) (ov (cstore-get-value cs o)) (rv (cstore-get-value cs r)) (yv (cstore-get-value cs y))) (if (and sv ev nv dv mv ov rv yv) (let ((send (+ (* 1000 sv) (* 100 ev) (* 10 nv) dv)) (more (+ (* 1000 mv) (* 100 ov) (* 10 rv) ev)) (money (+ (* 10000 mv) (* 1000 ov) (* 100 nv) (* 10 ev) yv))) (if (= (+ send more) money) cs #f)) cs))))"))
(task-entry (id "clp/store/cstore-walk*") (skill clp) (module store) (tier 1) (difficulty 10837) (name cstore-walk*) (type "(-> CStore Term Term)") (description "Deep walk a term through the store's substitution") (notes ()) (section reification) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground? cstore-singleton? cstore-get-value cstore-walk)) (answer "(define (cstore-walk* cs term) (walk* term (cstore-subst cs)))"))
(task-entry (id "clp/clp/solve-n-queens") (skill clp) (module clp) (tier 1) (difficulty 10837) (name solve-n-queens) (type "(-> Nat (List (List Int)))") (description "Solve N-Queens puzzle. Returns solutions as lists of column positions (1-indexed). Optional second argument specifies max solutions (default: 1).") (notes ()) (section convenience-solvers) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens clp-queens-diagonal-constraints queens-diagonal-with-rest =/=fd-diagonal make-diagonal-constraint send-more-money goal-send-more-money-eq smm-eq-check)) (answer "(define (solve-n-queens n . args) (let ((count (if (null? args) 1 (car args)))) (call-with-values (lambda () (n-queens n)) (lambda (goal vars) (run-clp count (lambda () goal) vars)))))"))
(task-entry (id "clp/store/cstore-reify") (skill clp) (module store) (tier 1) (difficulty 10838) (name cstore-reify) (type "(-> CStore Term Term)") (description "Reify a term, replacing unbound variables with readable names") (notes ()) (section reification) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground? cstore-singleton? cstore-get-value cstore-walk cstore-walk*)) (answer "(define (cstore-reify cs term) (let ((walked (cstore-walk* cs term))) (reify walked)))"))
(task-entry (id "clp/clp/solve-send-more-money") (skill clp) (module clp) (tier 1) (difficulty 10838) (name solve-send-more-money) (type "(-> (Maybe (List (Pair Symbol Int))))") (description "Solve SEND+MORE=MONEY. Returns alist of letter→digit assignments, e.g. ((s . 9) (e . 5) ...), or #f if no solution.") (notes ()) (section convenience-solvers) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens clp-queens-diagonal-constraints queens-diagonal-with-rest =/=fd-diagonal make-diagonal-constraint send-more-money goal-send-more-money-eq smm-eq-check solve-n-queens)) (answer "(define (solve-send-more-money) (call-with-values (lambda () (send-more-money)) (lambda (goal vars names) (let ((solutions (run-clp 1 (lambda () goal) vars))) (if (null? solutions) #f (map cons names (car solutions)))))))"))
(task-entry (id "clp/store/cstore->string") (skill clp) (module store) (tier 1) (difficulty 10839) (name cstore->string) (type "(-> CStore String)") (description "Convert store to readable string for debugging") (notes ()) (section store-display) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground? cstore-singleton? cstore-get-value cstore-walk cstore-walk* cstore-reify)) (answer "(define (cstore->string cs) (string-append \"(cstore\n\" \"  subst: \" (format-subst (cstore-subst cs)) \"\n\" \"  domains: \" (format-domains (cstore-domains cs)) \"\n\" \"  constraints: \" (number->string (length (cstore-constraints cs))) \" active\n\" \"  pending: \" (format-pending (cstore-pending cs)) \")\"))"))
(task-entry (id "clp/clp/clp-help") (skill clp) (module clp) (tier 1) (difficulty 10839) (name clp-help) (type "(-> Void)") (description "Print CLP(FD) help message with available constraints and operations") (notes ()) (section help) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain goal-=fd goal-<fd goal-<=fd goal->fd goal->=fd goal-=/=fd goal-+fd goal--fd goal-*fd goal-all-different goal-sum-fd goal-label goal-label-with run-clp take-solutions run-clp* clp-solve clp-all clp-count stream-count n-queens clp-queens-diagonal-constraints queens-diagonal-with-rest =/=fd-diagonal make-diagonal-constraint send-more-money goal-send-more-money-eq smm-eq-check solve-n-queens solve-send-more-money)) (answer "(define (clp-help) (display \"CLP(FD) - Constraint Logic Programming over Finite Domains\n\n\") (display \"Domain Constraints:\n\") (display \"  (goal-in-range var lo hi)    Constrain var to [lo, hi]\n\") (display \"  (goal-in-domain var vals)    Constrain var to list of values\n\n\") (display \"Arithmetic Constraints:\n\") (display \"  (goal-=fd x y)               x = y\n\") (display \"  (goal-<fd x y)               x < y\n\") (display \"  (goal-<=fd x y)              x <= y\n\") (display \"  (goal->fd x y)               x > y\n\") (display \"  (goal->=fd x y)              x >= y\n\") (display \"  (goal-=/=fd x y)             x ≠ y\n\") (display \"  (goal-+fd x y z)             x + y = z\n\") (display \"  (goal--fd x y z)             x - y = z\n\") (display \"  (goal-*fd x y z)             x * y = z\n\n\") (display \"Global Constraints:\n\") (display \"  (goal-all-different vars)    All vars have distinct values\n\") (display \"  (goal-sum-fd vars result)    Sum of vars = result\n\n\") (display \"Search:\n\") (display \"  (goal-label vars)            Label vars (first-fail, min)\n\") (display \"  (goal-label-with vo vs vars) Custom variable/value ordering\n\n\") (display \"Running:\n\") (display \"  (clp-solve vars goal)        First solution or #f\n\") (display \"  (clp-all vars goal)          All solutions\n\") (display \"  (clp-count goal)             Count solutions\n\n\") (display \"Convenience Solvers:\n\") (display \"  (solve-n-queens 8)           First solution as column list\n\") (display \"  (solve-n-queens 8 92)        All 92 solutions\n\") (display \"  (solve-send-more-money)      Named digit assignments\n\n\") (display \"Composable Problem Setup:\n\") (display \"  (n-queens n)                 Returns (values goal vars)\n\") (display \"  (send-more-money)            Returns (values goal vars names)\n\"))"))
(task-entry (id "clp/store/format-subst") (skill clp) (module store) (tier 1) (difficulty 10840) (name format-subst) (type "") (description "") (notes ()) (section store-display) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground? cstore-singleton? cstore-get-value cstore-walk cstore-walk* cstore-reify cstore->string)) (answer "(define (format-subst subst) (if (null? subst) \"{}\" (string-append \"{\" (apply string-append (list-intersperse (map (lambda (binding) (string-append (lvar-name (car binding)) \"=\" (format-term (cdr binding)))) subst) \", \")) \"}\")))"))
(task-entry (id "clp/store/format-term") (skill clp) (module store) (tier 1) (difficulty 10841) (name format-term) (type "") (description "") (notes ()) (section store-display) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground? cstore-singleton? cstore-get-value cstore-walk cstore-walk* cstore-reify cstore->string format-subst)) (answer "(define (format-term term) (cond ((lvar? term) (string-append \"_\" (number->string (lvar-id term)))) ((pair? term) (string-append \"(\" (format-term (car term)) \" . \" (format-term (cdr term)) \")\")) ((number? term) (number->string term)) ((symbol? term) (symbol->string term)) (else \"?\")))"))
(task-entry (id "clp/store/format-domains") (skill clp) (module store) (tier 1) (difficulty 10842) (name format-domains) (type "") (description "") (notes ()) (section store-display) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground? cstore-singleton? cstore-get-value cstore-walk cstore-walk* cstore-reify cstore->string format-subst format-term)) (answer "(define (format-domains domains) (if (null? domains) \"{}\" (string-append \"{\" (apply string-append (list-intersperse (map (lambda (binding) (string-append \"_\" (number->string (car binding)) \":\" (domain->string (cdr binding)))) domains) \", \")) \"}\")))"))
(task-entry (id "clp/store/format-pending") (skill clp) (module store) (tier 1) (difficulty 10843) (name format-pending) (type "") (description "") (notes ()) (section store-display) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator cstore-add-constraint cstore-constraints-for-var any cstore-add-pending cstore-pop-pending cstore-clear-pending cstore-ground? cstore-singleton? cstore-get-value cstore-walk cstore-walk* cstore-reify cstore->string format-subst format-term format-domains)) (answer "(define (format-pending pending) (if (null? pending) \"[]\" (string-append \"[\" (apply string-append (list-intersperse (map (lambda (id) (string-append \"_\" (number->string id))) pending) \", \")) \"]\")))"))
(task-entry (id "sat/literal/make-lit") (skill sat) (module literal) (tier 1) (difficulty 10900) (name make-lit) (type "(-> VarId Bool Literal)") (description "Create a literal from variable id and polarity") (notes ()) (section literal-constructors) (deps (\x27;prelude)) (available ()) (answer "(define (make-lit var positive?) (if positive? var (- var)))"))
(task-entry (id "sat/clause/make-clause") (skill sat) (module clause) (tier 1) (difficulty 10900) (name make-clause) (type "(-> Literal ... Clause)") (description "Create a clause from literals") (notes ()) (section clause-constructors) (deps (\x27;literal \x27;sort)) (available ()) (answer "(define (make-clause . lits) (clause-normalize lits))"))
(task-entry (id "sat/cnf/make-cnf") (skill sat) (module cnf) (tier 1) (difficulty 10900) (name make-cnf) (type "(-> (List Clause) CNF)") (description "Create CNF from list of clauses") (notes ("Filters out tautological clauses")) (section cnf-constructors) (deps (\x27;clause \x27;sort)) (available ()) (answer "(define (make-cnf clauses) (list 'cnf (filter (lambda (c) (not (clause-tautology-marker? c))) clauses)))"))
(task-entry (id "sat/assignment/make-assignment") (skill sat) (module assignment) (tier 1) (difficulty 10900) (name make-assignment) (type "(-> Nat Assignment)") (description "Create empty assignment for nvars variables") (notes ()) (section assignment-structure) (deps (\x27;literal)) (available ()) (answer "(define (make-assignment nvars) (list 'assignment '() (make-vector (+ nvars 1) 0) (make-vector (+ nvars 1) #f)))"))
(task-entry (id "sat/watches/lit->watch-index") (skill sat) (module watches) (tier 1) (difficulty 10900) (name lit->watch-index) (type "(-> Literal Nat)") (description "") (notes ()) (section watch-structure) (deps (\x27;literal)) (available ()) (answer "(define (lit->watch-index lit) (if (lit-positive? lit) (* 2 (lit-var lit)) (+ (* 2 (lit-var lit)) 1)))"))
(task-entry (id "sat/solver/make-solver-state") (skill sat) (module solver) (tier 1) (difficulty 10900) (name make-solver-state) (type "(-> CNF SolverState)") (description "Create initial solver state from CNF") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available ()) (answer "(define (make-solver-state cnf) (let* ((nvars (cnf-num-vars cnf)) (assignment (make-assignment nvars)) (scores (make-vector (+ nvars 1) 0.0)) (watches (make-watches nvars))) (for-each (lambda (clause) (for-each (lambda (lit) (let ((var (lit-var lit))) (vector-set! scores var (+ (vector-ref scores var) 1.0)))) clause)) (cnf-clauses cnf)) (watches-init-all! watches (cnf-clauses cnf)) (list 'solver-state cnf assignment '() scores 0 watches)))"))
(task-entry (id "sat/sat/sat-solve") (skill sat) (module sat) (tier 1) (difficulty 10900) (name sat-solve) (type "(-> (List (List Literal)) (Or 'sat 'unsat 'unknown))") (description "Solve SAT from list of clause lists") (notes ("((1 2) (-1 3)) means (x1 OR x2) AND (NOT x1 OR x3)" "Returns 'unknown if solver times out (increase *sat-fuel-limit* for harder problems)")) (section high-level-api) (deps (\x27;solver)) (available ()) (answer "(define (sat-solve clauses) (solve (cnf-from-lists clauses)))"))
(task-entry (id "sat/maxsat/make-maxsat") (skill sat) (module maxsat) (tier 1) (difficulty 10900) (name make-maxsat) (type "(-> (List Clause) (List Clause) MaxSATInstance)") (description "Create MaxSAT instance with hard and soft clauses") (notes ()) (section maxsat-problem) (deps (\x27;sat)) (available ()) (answer "(define (make-maxsat hard-clauses soft-clauses) (list 'maxsat hard-clauses soft-clauses))"))
(task-entry (id "sat/literal/pos-lit") (skill sat) (module literal) (tier 1) (difficulty 10901) (name pos-lit) (type "(-> VarId Literal)") (description "Create positive literal x") (notes ()) (section literal-constructors) (deps (\x27;prelude)) (available (make-lit)) (answer "(define (pos-lit var) var)"))
(task-entry (id "sat/clause/clause-from-list") (skill sat) (module clause) (tier 1) (difficulty 10901) (name clause-from-list) (type "(-> (List Literal) Clause)") (description "Create a clause from a list of literals") (notes ()) (section clause-constructors) (deps (\x27;literal \x27;sort)) (available (make-clause)) (answer "(define (clause-from-list lits) (clause-normalize lits))"))
(task-entry (id "sat/cnf/cnf-from-lists") (skill sat) (module cnf) (tier 1) (difficulty 10901) (name cnf-from-lists) (type "(-> (List (List Literal)) CNF)") (description "Create CNF from lists of literal lists") (notes ()) (section cnf-constructors) (deps (\x27;clause \x27;sort)) (available (make-cnf)) (answer "(define (cnf-from-lists clause-lists) (make-cnf (map clause-from-list clause-lists)))"))
(task-entry (id "sat/assignment/assignment-copy") (skill sat) (module assignment) (tier 1) (difficulty 10901) (name assignment-copy) (type "(-> Assignment Assignment)") (description "Create a deep copy of an assignment") (notes ()) (section assignment-structure) (deps (\x27;literal)) (available (make-assignment)) (answer "(define (assignment-copy a) (list 'assignment (assignment-trail a) (vector-copy (assignment-levels-vec a)) (vector-copy (assignment-reasons-vec a))))"))
(task-entry (id "sat/watches/watch-index->lit") (skill sat) (module watches) (tier 1) (difficulty 10901) (name watch-index->lit) (type "(-> Nat Literal)") (description "") (notes ()) (section watch-structure) (deps (\x27;literal)) (available (lit->watch-index)) (answer "(define (watch-index->lit idx) (let ((var (quotient idx 2))) (if (even? idx) (pos-lit var) (neg-lit var))))"))
(task-entry (id "sat/solver/state-cnf") (skill sat) (module solver) (tier 1) (difficulty 10901) (name state-cnf) (type "") (description "") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state)) (answer "(define (state-cnf s) (list-ref s 1))"))
(task-entry (id "sat/sat/sat-satisfiable?") (skill sat) (module sat) (tier 1) (difficulty 10901) (name sat-satisfiable?) (type "(-> (List (List Literal)) Bool)") (description "Check if clause set is satisfiable") (notes ()) (section high-level-api) (deps (\x27;solver)) (available (sat-solve)) (answer "(define (sat-satisfiable? clauses) (eq? (sat-solve clauses) 'sat))"))
(task-entry (id "sat/maxsat/maxsat-hard") (skill sat) (module maxsat) (tier 1) (difficulty 10901) (name maxsat-hard) (type "") (description "") (notes ()) (section maxsat-problem) (deps (\x27;sat)) (available (make-maxsat)) (answer "(define (maxsat-hard m) (cadr m))"))
(task-entry (id "sat/literal/neg-lit") (skill sat) (module literal) (tier 1) (difficulty 10902) (name neg-lit) (type "(-> VarId Literal)") (description "Create negative literal ~x") (notes ()) (section literal-constructors) (deps (\x27;prelude)) (available (make-lit pos-lit)) (answer "(define (neg-lit var) (- var))"))
(task-entry (id "sat/clause/clause-normalize") (skill sat) (module clause) (tier 1) (difficulty 10902) (name clause-normalize) (type "(-> (List Literal) Clause)") (description "Normalize clause: remove duplicates, sort, detect tautology") (notes ()) (section clause-constructors) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list)) (answer "(define (clause-normalize lits) (let* ((sorted (sort-by < lits)) (deduped (clause-dedup sorted))) (if (clause-tautology? deduped) 'tautology deduped)))"))
(task-entry (id "sat/cnf/cnf-empty") (skill sat) (module cnf) (tier 1) (difficulty 10902) (name cnf-empty) (type "") (description "") (notes ()) (section cnf-constructors) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists)) (answer "(define cnf-empty (make-cnf '()))"))
(task-entry (id "sat/assignment/assignment-trail") (skill sat) (module assignment) (tier 1) (difficulty 10902) (name assignment-trail) (type "(-> Assignment (List (Pair VarId Bool)))") (description "Get assignment trail (most recent first)") (notes ()) (section assignment-accessors) (deps (\x27;literal)) (available (make-assignment assignment-copy)) (answer "(define (assignment-trail a) (cadr a))"))
(task-entry (id "sat/watches/make-watches") (skill sat) (module watches) (tier 1) (difficulty 10902) (name make-watches) (type "(-> Nat Watches)") (description "Create empty watch lists for nvars variables") (notes ()) (section watch-structure) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit)) (answer "(define (make-watches nvars) (make-vector (* 2 (+ nvars 1)) '()))"))
(task-entry (id "sat/solver/state-assignment") (skill sat) (module solver) (tier 1) (difficulty 10902) (name state-assignment) (type "") (description "") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf)) (answer "(define (state-assignment s) (list-ref s 2))"))
(task-entry (id "sat/sat/sat-model") (skill sat) (module sat) (tier 1) (difficulty 10902) (name sat-model) (type "(-> (List (List Literal)) (Or (List (Pair VarId Bool)) 'timeout #f))") (description "Get satisfying assignment if exists, 'timeout if timed out, #f if unsat") (notes ()) (section high-level-api) (deps (\x27;solver)) (available (sat-solve sat-satisfiable?)) (answer "(define (sat-model clauses) (let ((result (solve-with-model (cnf-from-lists clauses)))) (cond ((eq? result 'timeout) 'timeout) (result (assignment-to-model result)) (else #f))))"))
(task-entry (id "sat/maxsat/maxsat-soft") (skill sat) (module maxsat) (tier 1) (difficulty 10902) (name maxsat-soft) (type "") (description "") (notes ()) (section maxsat-problem) (deps (\x27;sat)) (available (make-maxsat maxsat-hard)) (answer "(define (maxsat-soft m) (caddr m))"))
(task-entry (id "sat/literal/lit-var") (skill sat) (module literal) (tier 1) (difficulty 10903) (name lit-var) (type "(-> Literal VarId)") (description "Get the variable id from a literal") (notes ()) (section literal-accessors) (deps (\x27;prelude)) (available (make-lit pos-lit neg-lit)) (answer "(define (lit-var lit) (abs lit))"))
(task-entry (id "sat/clause/clause-dedup") (skill sat) (module clause) (tier 1) (difficulty 10903) (name clause-dedup) (type "(-> (List Literal) (List Literal))") (description "Remove duplicate literals from sorted list") (notes ()) (section clause-constructors) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize)) (answer "(define (clause-dedup sorted-lits) (cond ((null? sorted-lits) '()) ((null? (cdr sorted-lits)) sorted-lits) ((= (car sorted-lits) (cadr sorted-lits)) (clause-dedup (cdr sorted-lits))) (else (cons (car sorted-lits) (clause-dedup (cdr sorted-lits))))))"))
(task-entry (id "sat/cnf/cnf?") (skill sat) (module cnf) (tier 1) (difficulty 10903) (name cnf?) (type "(-> Any Bool)") (description "Check if value is a CNF formula") (notes ()) (section cnf-predicates) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty)) (answer "(define (cnf? x) (and (pair? x) (eq? (car x) 'cnf) (list? (cadr x))))"))
(task-entry (id "sat/assignment/assignment-levels-vec") (skill sat) (module assignment) (tier 1) (difficulty 10903) (name assignment-levels-vec) (type "(-> Assignment (Vector Nat))") (description "") (notes ()) (section assignment-accessors) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail)) (answer "(define (assignment-levels-vec a) (caddr a))"))
(task-entry (id "sat/watches/watches-get") (skill sat) (module watches) (tier 1) (difficulty 10903) (name watches-get) (type "(-> Watches Literal (List WatchEntry))") (description "") (notes ()) (section watch-structure) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit make-watches)) (answer "(define (watches-get watches lit) (vector-ref watches (lit->watch-index lit)))"))
(task-entry (id "sat/solver/state-learned") (skill sat) (module solver) (tier 1) (difficulty 10903) (name state-learned) (type "") (description "") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment)) (answer "(define (state-learned s) (list-ref s 3))"))
(task-entry (id "sat/sat/assignment-to-model") (skill sat) (module sat) (tier 1) (difficulty 10903) (name assignment-to-model) (type "(-> Assignment (List (Pair VarId Bool)))") (description "Convert assignment to list of (var . bool) pairs") (notes ()) (section high-level-api) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model)) (answer "(define (assignment-to-model a) (map (lambda (entry) (cons (car entry) (eq? (cdr entry) 'true))) (reverse (assignment-trail a))))"))
(task-entry (id "sat/maxsat/maxsat-num-soft") (skill sat) (module maxsat) (tier 1) (difficulty 10903) (name maxsat-num-soft) (type "") (description "") (notes ()) (section maxsat-problem) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft)) (answer "(define (maxsat-num-soft m) (length (maxsat-soft m)))"))
(task-entry (id "sat/literal/lit-positive?") (skill sat) (module literal) (tier 1) (difficulty 10904) (name lit-positive?) (type "(-> Literal Bool)") (description "Check if literal is positive (unnegated)") (notes ()) (section literal-accessors) (deps (\x27;prelude)) (available (make-lit pos-lit neg-lit lit-var)) (answer "(define (lit-positive? lit) (> lit 0))"))
(task-entry (id "sat/clause/clause-tautology?") (skill sat) (module clause) (tier 1) (difficulty 10904) (name clause-tautology?) (type "(-> (List Literal) Bool)") (description "Check if clause contains both x and ~x") (notes ()) (section clause-constructors) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup)) (answer "(define (clause-tautology? lits) (let loop ((lits lits)) (cond ((null? lits) #f) ((null? (cdr lits)) #f) ((= (car lits) (- (cadr lits))) #t) (else (loop (cdr lits))))))"))
(task-entry (id "sat/cnf/cnf-trivially-unsat?") (skill sat) (module cnf) (tier 1) (difficulty 10904) (name cnf-trivially-unsat?) (type "(-> CNF Bool)") (description "Check if CNF contains empty clause (immediately unsatisfiable)") (notes ()) (section cnf-predicates) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf?)) (answer "(define (cnf-trivially-unsat? cnf) (any clause-empty? (cnf-clauses cnf)))"))
(task-entry (id "sat/assignment/assignment-reasons-vec") (skill sat) (module assignment) (tier 1) (difficulty 10904) (name assignment-reasons-vec) (type "(-> Assignment (Vector (Or Clause 'decision #f)))") (description "") (notes ()) (section assignment-accessors) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec)) (answer "(define (assignment-reasons-vec a) (cadddr a))"))
(task-entry (id "sat/watches/watches-set!") (skill sat) (module watches) (tier 1) (difficulty 10904) (name watches-set!) (type "(-> Watches Literal (List WatchEntry) Void)") (description "") (notes ()) (section watch-structure) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit make-watches watches-get)) (answer "(define (watches-set! watches lit entries) (vector-set! watches (lit->watch-index lit) entries))"))
(task-entry (id "sat/solver/state-scores") (skill sat) (module solver) (tier 1) (difficulty 10904) (name state-scores) (type "") (description "") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned)) (answer "(define (state-scores s) (list-ref s 4))"))
(task-entry (id "sat/sat/var") (skill sat) (module sat) (tier 1) (difficulty 10904) (name var) (type "(-> Nat Literal)") (description "Create positive literal for variable n") (notes ("Variables are numbered starting from 1")) (section cnf-building-helpers) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model)) (answer "(define (var n) (pos-lit n))"))
(task-entry (id "sat/maxsat/make-maxsat-result") (skill sat) (module maxsat) (tier 1) (difficulty 10904) (name make-maxsat-result) (type "") (description "") (notes ()) (section maxsat-result) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft)) (answer "(define (make-maxsat-result cost model) (list 'maxsat-result cost model))"))
(task-entry (id "sat/literal/lit-negative?") (skill sat) (module literal) (tier 1) (difficulty 10905) (name lit-negative?) (type "(-> Literal Bool)") (description "Check if literal is negative (negated)") (notes ()) (section literal-accessors) (deps (\x27;prelude)) (available (make-lit pos-lit neg-lit lit-var lit-positive?)) (answer "(define (lit-negative? lit) (< lit 0))"))
(task-entry (id "sat/clause/clause?") (skill sat) (module clause) (tier 1) (difficulty 10905) (name clause?) (type "(-> Any Bool)") (description "Check if value is a valid clause") (notes ()) (section clause-predicates) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology?)) (answer "(define (clause? x) (or (eq? x 'tautology) (and (list? x) (all integer? x))))"))
(task-entry (id "sat/cnf/cnf-trivially-sat?") (skill sat) (module cnf) (tier 1) (difficulty 10905) (name cnf-trivially-sat?) (type "(-> CNF Bool)") (description "Check if CNF has no clauses (trivially satisfiable)") (notes ()) (section cnf-predicates) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat?)) (answer "(define (cnf-trivially-sat? cnf) (null? (cnf-clauses cnf)))"))
(task-entry (id "sat/assignment/assignment-get") (skill sat) (module assignment) (tier 1) (difficulty 10905) (name assignment-get) (type "(-> Assignment VarId (Maybe (Or 'true 'false)))") (description "Get assigned value for variable, or #f if unassigned") (notes ()) (section assignment-accessors) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec)) (answer "(define (assignment-get a var) (let loop ((trail (assignment-trail a))) (cond ((null? trail) #f) ((= (caar trail) var) (cdar trail)) (else (loop (cdr trail))))))"))
(task-entry (id "sat/watches/watches-add!") (skill sat) (module watches) (tier 1) (difficulty 10905) (name watches-add!) (type "(-> Watches Literal Clause Literal Void)") (description "Add clause to watch list of lit, with other-lit as the other watched literal") (notes ()) (section watch-structure) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit make-watches watches-get watches-set!)) (answer "(define (watches-add! watches lit clause other-lit) (let ((idx (lit->watch-index lit))) (vector-set! watches idx (cons (cons clause other-lit) (vector-ref watches idx)))))"))
(task-entry (id "sat/solver/state-conflicts") (skill sat) (module solver) (tier 1) (difficulty 10905) (name state-conflicts) (type "") (description "") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores)) (answer "(define (state-conflicts s) (list-ref s 5))"))
(task-entry (id "sat/sat/neg") (skill sat) (module sat) (tier 1) (difficulty 10905) (name neg) (type "(-> Nat Literal)") (description "Create negative literal for variable n") (notes ()) (section cnf-building-helpers) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var)) (answer "(define (neg n) (neg-lit n))"))
(task-entry (id "sat/maxsat/maxsat-result?") (skill sat) (module maxsat) (tier 1) (difficulty 10905) (name maxsat-result?) (type "") (description "") (notes ()) (section maxsat-result) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result)) (answer "(define (maxsat-result? r) (and (pair? r) (eq? (car r) 'maxsat-result)))"))
(task-entry (id "sat/literal/lit-negate") (skill sat) (module literal) (tier 1) (difficulty 10906) (name lit-negate) (type "(-> Literal Literal)") (description "Negate a literal: x -> ~x, ~x -> x") (notes ()) (section literal-accessors) (deps (\x27;prelude)) (available (make-lit pos-lit neg-lit lit-var lit-positive? lit-negative?)) (answer "(define (lit-negate lit) (- lit))"))
(task-entry (id "sat/clause/clause-empty?") (skill sat) (module clause) (tier 1) (difficulty 10906) (name clause-empty?) (type "(-> Clause Bool)") (description "Check if clause is empty (represents FALSE)") (notes ()) (section clause-predicates) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause?)) (answer "(define (clause-empty? clause) (and (list? clause) (null? clause)))"))
(task-entry (id "sat/cnf/cnf-clauses") (skill sat) (module cnf) (tier 1) (difficulty 10906) (name cnf-clauses) (type "(-> CNF (List Clause))") (description "Get list of clauses in CNF") (notes ()) (section cnf-accessors) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat?)) (answer "(define (cnf-clauses cnf) (cadr cnf))"))
(task-entry (id "sat/assignment/assignment-level") (skill sat) (module assignment) (tier 1) (difficulty 10906) (name assignment-level) (type "(-> Assignment VarId Nat)") (description "Get decision level of variable (0 if unassigned)") (notes ()) (section assignment-accessors) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get)) (answer "(define (assignment-level a var) (vector-ref (assignment-levels-vec a) var))"))
(task-entry (id "sat/watches/watches-init-clause!") (skill sat) (module watches) (tier 1) (difficulty 10906) (name watches-init-clause!) (type "(-> Watches Clause Void)") (description "Initialize watches for a clause (pick first two literals)") (notes ()) (section watch-initialization) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit make-watches watches-get watches-set! watches-add!)) (answer "(define (watches-init-clause! watches clause) (cond ((null? clause) (void)) ((null? (cdr clause)) (watches-add! watches (car clause) clause (car clause))) (else (let ((lit1 (car clause)) (lit2 (cadr clause))) (watches-add! watches lit1 clause lit2) (watches-add! watches lit2 clause lit1)))))"))
(task-entry (id "sat/solver/state-watches") (skill sat) (module solver) (tier 1) (difficulty 10906) (name state-watches) (type "") (description "") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts)) (answer "(define (state-watches s) (list-ref s 6))"))
(task-entry (id "sat/sat/implies") (skill sat) (module sat) (tier 1) (difficulty 10906) (name implies) (type "(-> Literal Literal (List Literal))") (description "a => b as clause: (~a OR b)") (notes ()) (section cnf-building-helpers) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg)) (answer "(define (implies a b) (list (lit-negate a) b))"))
(task-entry (id "sat/maxsat/maxsat-result-cost") (skill sat) (module maxsat) (tier 1) (difficulty 10906) (name maxsat-result-cost) (type "") (description "") (notes ()) (section maxsat-result) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result?)) (answer "(define (maxsat-result-cost r) (cadr r))"))
(task-entry (id "sat/literal/lit=?") (skill sat) (module literal) (tier 1) (difficulty 10907) (name lit=?) (type "(-> Literal Literal Bool)") (description "Check if two literals are equal") (notes ()) (section literal-comparison) (deps (\x27;prelude)) (available (make-lit pos-lit neg-lit lit-var lit-positive? lit-negative? lit-negate)) (answer "(define (lit=? l1 l2) (= l1 l2))"))
(task-entry (id "sat/clause/clause-unit?") (skill sat) (module clause) (tier 1) (difficulty 10907) (name clause-unit?) (type "(-> Clause Bool)") (description "Check if clause is a unit clause (single literal)") (notes ()) (section clause-predicates) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty?)) (answer "(define (clause-unit? clause) (and (list? clause) (pair? clause) (null? (cdr clause))))"))
(task-entry (id "sat/cnf/cnf-num-clauses") (skill sat) (module cnf) (tier 1) (difficulty 10907) (name cnf-num-clauses) (type "(-> CNF Nat)") (description "Number of clauses in CNF") (notes ()) (section cnf-accessors) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses)) (answer "(define (cnf-num-clauses cnf) (length (cnf-clauses cnf)))"))
(task-entry (id "sat/assignment/assignment-reason") (skill sat) (module assignment) (tier 1) (difficulty 10907) (name assignment-reason) (type "(-> Assignment VarId (Or Clause 'decision #f))") (description "Get antecedent clause for variable, 'decision if branched, #f if unassigned") (notes ()) (section assignment-accessors) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level)) (answer "(define (assignment-reason a var) (vector-ref (assignment-reasons-vec a) var))"))
(task-entry (id "sat/watches/watches-init-all!") (skill sat) (module watches) (tier 1) (difficulty 10907) (name watches-init-all!) (type "(-> Watches (List Clause) Void)") (description "Initialize watches for all clauses") (notes ()) (section watch-initialization) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit make-watches watches-get watches-set! watches-add! watches-init-clause!)) (answer "(define (watches-init-all! watches clauses) (for-each (lambda (c) (watches-init-clause! watches c)) clauses))"))
(task-entry (id "sat/solver/state-set-assignment") (skill sat) (module solver) (tier 1) (difficulty 10907) (name state-set-assignment) (type "") (description "") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches)) (answer "(define (state-set-assignment s a) (list 'solver-state (state-cnf s) a (state-learned s) (state-scores s) (state-conflicts s) (state-watches s)))"))
(task-entry (id "sat/sat/iff") (skill sat) (module sat) (tier 1) (difficulty 10907) (name iff) (type "(-> Literal Literal (List (List Literal)))") (description "a <=> b as clauses: (a => b) AND (b => a)") (notes ()) (section cnf-building-helpers) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies)) (answer "(define (iff a b) (list (implies a b) (implies b a)))"))
(task-entry (id "sat/maxsat/maxsat-result-model") (skill sat) (module maxsat) (tier 1) (difficulty 10907) (name maxsat-result-model) (type "") (description "") (notes ()) (section maxsat-result) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost)) (answer "(define (maxsat-result-model r) (caddr r))"))
(task-entry (id "sat/literal/lit-complement?") (skill sat) (module literal) (tier 1) (difficulty 10908) (name lit-complement?) (type "(-> Literal Literal Bool)") (description "Check if literals are complements (x and ~x)") (notes ()) (section literal-comparison) (deps (\x27;prelude)) (available (make-lit pos-lit neg-lit lit-var lit-positive? lit-negative? lit-negate lit=?)) (answer "(define (lit-complement? l1 l2) (= l1 (- l2)))"))
(task-entry (id "sat/clause/clause-tautology-marker?") (skill sat) (module clause) (tier 1) (difficulty 10908) (name clause-tautology-marker?) (type "(-> Clause Bool)") (description "Check if clause is marked as a tautology") (notes ()) (section clause-predicates) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit?)) (answer "(define (clause-tautology-marker? clause) (eq? clause 'tautology))"))
(task-entry (id "sat/cnf/cnf-num-vars") (skill sat) (module cnf) (tier 1) (difficulty 10908) (name cnf-num-vars) (type "(-> CNF Nat)") (description "Number of distinct variables in CNF") (notes ()) (section cnf-accessors) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses)) (answer "(define (cnf-num-vars cnf) (length (cnf-vars cnf)))"))
(task-entry (id "sat/assignment/assignment-decision-level") (skill sat) (module assignment) (tier 1) (difficulty 10908) (name assignment-decision-level) (type "(-> Assignment Nat)") (description "Get current decision level") (notes ()) (section assignment-accessors) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason)) (answer "(define (assignment-decision-level a) (let loop ((trail (assignment-trail a)) (max-level 0)) (if (null? trail) max-level (let ((var (caar trail))) (loop (cdr trail) (max max-level (assignment-level a var)))))))"))
(task-entry (id "sat/watches/watches-propagate!") (skill sat) (module watches) (tier 1) (difficulty 10908) (name watches-propagate!) (type "(-> Watches Assignment Literal (Or 'ok (List 'unit Literal Clause) (List 'conflict Clause)))") (description "Process a literal becoming false. Returns units to propagate or conflict.") (notes ("Modifies watches in place. Collects all unit implications.")) (section watch-propagation) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit make-watches watches-get watches-set! watches-add! watches-init-clause! watches-init-all!)) (answer "(define (watches-propagate! watches assignment false-lit) (let ((watch-list (watches-get watches false-lit)) (units '())) (let loop ((entries watch-list) (new-entries '())) (cond ((null? entries) (watches-set! watches false-lit new-entries) (if (null? units) 'ok (cons 'units (reverse units)))) (else (let* ((entry (car entries)) (clause (car entry)) (other-lit (cdr entry)) (other-val (assignment-eval-lit assignment other-lit))) (cond ((eq? other-val 'true) (loop (cdr entries) (cons entry new-entries))) (else (let ((new-watch (find-new-watch clause false-lit other-lit assignment))) (cond (new-watch (watches-add! watches new-watch clause other-lit) (loop (cdr entries) new-entries)) ((eq? other-val 'unknown) (set! units (cons (cons other-lit clause) units)) (loop (cdr entries) (cons entry new-entries))) (else (watches-set! watches false-lit (append new-entries entries)) (list 'conflict clause))))))))))))"))
(task-entry (id "sat/solver/state-add-learned") (skill sat) (module solver) (tier 1) (difficulty 10908) (name state-add-learned) (type "") (description "") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment)) (answer "(define (state-add-learned s clause) (watches-init-clause! (state-watches s) clause) (list 'solver-state (state-cnf s) (state-assignment s) (cons clause (state-learned s)) (state-scores s) (state-conflicts s) (state-watches s)))"))
(task-entry (id "sat/sat/at-most-one") (skill sat) (module sat) (tier 1) (difficulty 10908) (name at-most-one) (type "(-> (List Literal) (List (List Literal)))") (description "At most one of vars is true - pairwise encoding") (notes ("For each pair (xi, xj), add clause (~xi OR ~xj)")) (section cnf-building-helpers) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff)) (answer "(define (at-most-one vars) (let loop ((vs vars) (clauses '())) (if (null? vs) clauses (let inner ((rest (cdr vs)) (clauses clauses)) (if (null? rest) (loop (cdr vs) clauses) (inner (cdr rest) (cons (list (lit-negate (car vs)) (lit-negate (car rest))) clauses)))))))"))
(task-entry (id "sat/maxsat/maxsat-solve-linear") (skill sat) (module maxsat) (tier 1) (difficulty 10908) (name maxsat-solve-linear) (type "(-> MaxSATInstance (Or MaxSATResult #f))") (description "Solve MaxSAT using linear search over cost") (notes ("Returns result with minimum cost, or #f if hard clauses unsatisfiable")) (section linear-search) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model)) (answer "(define (maxsat-solve-linear maxsat) (let* ((hard (maxsat-hard maxsat)) (soft (maxsat-soft maxsat)) (n (length soft))) (if (and (not (null? hard)) (eq? (sat-solve hard) 'unsat)) #f (let loop ((k 0)) (if (> k n) #f (let ((result (maxsat-try-cost hard soft k))) (if result (make-maxsat-result k result) (loop (+ k 1)))))))))"))
(task-entry (id "sat/literal/lit->string") (skill sat) (module literal) (tier 1) (difficulty 10909) (name lit->string) (type "(-> Literal String)") (description "Convert literal to string representation") (notes ()) (section literal-display) (deps (\x27;prelude)) (available (make-lit pos-lit neg-lit lit-var lit-positive? lit-negative? lit-negate lit=? lit-complement?)) (answer "(define (lit->string lit) (if (lit-positive? lit) (string-append \"x\" (number->string lit)) (string-append \"~x\" (number->string (- lit)))))"))
(task-entry (id "sat/clause/clause-size") (skill sat) (module clause) (tier 1) (difficulty 10909) (name clause-size) (type "(-> Clause Nat)") (description "Number of literals in clause") (notes ()) (section clause-accessors) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker?)) (answer "(define (clause-size clause) (if (clause-tautology-marker? clause) 0 (length clause)))"))
(task-entry (id "sat/cnf/cnf-vars") (skill sat) (module cnf) (tier 1) (difficulty 10909) (name cnf-vars) (type "(-> CNF (List VarId))") (description "Get sorted list of all variable ids in CNF") (notes ()) (section cnf-accessors) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars)) (answer "(define (cnf-vars cnf) (sort-by < (list-unique (append-map clause-vars (cnf-clauses cnf)))))"))
(task-entry (id "sat/assignment/assignment-assigned?") (skill sat) (module assignment) (tier 1) (difficulty 10909) (name assignment-assigned?) (type "(-> Assignment VarId Bool)") (description "Check if variable is assigned") (notes ()) (section assignment-accessors) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level)) (answer "(define (assignment-assigned? a var) (not (not (assignment-get a var))))"))
(task-entry (id "sat/watches/find-new-watch") (skill sat) (module watches) (tier 1) (difficulty 10909) (name find-new-watch) (type "(-> Clause Literal Literal Assignment (Maybe Literal))") (description "Find a literal in clause that is not false and not already watched") (notes ()) (section watch-propagation) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit make-watches watches-get watches-set! watches-add! watches-init-clause! watches-init-all! watches-propagate!)) (answer "(define (find-new-watch clause false-lit other-lit assignment) (let loop ((lits clause)) (cond ((null? lits) #f) (else (let ((lit (car lits))) (cond ((lit-equal? lit false-lit) (loop (cdr lits))) ((lit-equal? lit other-lit) (loop (cdr lits))) ((not (eq? (assignment-eval-lit assignment lit) 'false)) lit) (else (loop (cdr lits)))))))))"))
(task-entry (id "sat/solver/state-inc-conflicts") (skill sat) (module solver) (tier 1) (difficulty 10909) (name state-inc-conflicts) (type "") (description "") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned)) (answer "(define (state-inc-conflicts s) (list 'solver-state (state-cnf s) (state-assignment s) (state-learned s) (state-scores s) (+ 1 (state-conflicts s)) (state-watches s)))"))
(task-entry (id "sat/sat/at-least-one") (skill sat) (module sat) (tier 1) (difficulty 10909) (name at-least-one) (type "(-> (List Literal) (List Literal))") (description "At least one of vars is true - single clause") (notes ()) (section cnf-building-helpers) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one)) (answer "(define (at-least-one vars) vars)"))
(task-entry (id "sat/maxsat/maxsat-try-cost") (skill sat) (module maxsat) (tier 1) (difficulty 10909) (name maxsat-try-cost) (type "(-> (List Clause) (List Clause) Nat (Or Model #f))") (description "Check if there's a model with at most k unsatisfied soft clauses") (notes ()) (section linear-search) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear)) (answer "(define (maxsat-try-cost hard soft k) (let* ((n (length soft)) (base-var (+ 1 (max-var-in-clauses (append hard soft)))) (relax-vars (map (lambda (i) (+ base-var i)) (iota n))) (relaxed-soft (map (lambda (clause relax-var) (cons relax-var clause)) soft relax-vars)) (counter-base (+ base-var n)) (atmost-k (sequential-at-most-k (map var relax-vars) k counter-base)) (all-clauses (append hard relaxed-soft atmost-k)) (result (sat-model all-clauses))) (if (or (not result) (eq? result 'timeout)) #f (filter (lambda (entry) (< (car entry) base-var)) result))))"))
(task-entry (id "sat/literal/lit->symbol-string") (skill sat) (module literal) (tier 1) (difficulty 10910) (name lit->symbol-string) (type "(-> Literal (Vector String) String)") (description "Convert literal to string using variable names") (notes ()) (section literal-display) (deps (\x27;prelude)) (available (make-lit pos-lit neg-lit lit-var lit-positive? lit-negative? lit-negate lit=? lit-complement? lit->string)) (answer "(define (lit->symbol-string lit var-names) (let* ((var (lit-var lit)) (name (if (and var-names (< var (vector-length var-names))) (vector-ref var-names var) (string-append \"x\" (number->string var))))) (if (lit-positive? lit) name (string-append \"~\" name))))"))
(task-entry (id "sat/clause/clause-literals") (skill sat) (module clause) (tier 1) (difficulty 10910) (name clause-literals) (type "(-> Clause (List Literal))") (description "Get list of literals in clause") (notes ()) (section clause-accessors) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker? clause-size)) (answer "(define (clause-literals clause) (if (clause-tautology-marker? clause) '() clause))"))
(task-entry (id "sat/cnf/cnf-unit-clauses") (skill sat) (module cnf) (tier 1) (difficulty 10910) (name cnf-unit-clauses) (type "(-> CNF (List Clause))") (description "Get all unit clauses in CNF") (notes ()) (section cnf-accessors) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars)) (answer "(define (cnf-unit-clauses cnf) (filter clause-unit? (cnf-clauses cnf)))"))
(task-entry (id "sat/assignment/assignment-size") (skill sat) (module assignment) (tier 1) (difficulty 10910) (name assignment-size) (type "(-> Assignment Nat)") (description "Number of assigned variables") (notes ()) (section assignment-accessors) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned?)) (answer "(define (assignment-size a) (length (assignment-trail a)))"))
(task-entry (id "sat/watches/lit-equal?") (skill sat) (module watches) (tier 1) (difficulty 10910) (name lit-equal?) (type "") (description "") (notes ()) (section watch-propagation) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit make-watches watches-get watches-set! watches-add! watches-init-clause! watches-init-all! watches-propagate! find-new-watch)) (answer "(define (lit-equal? a b) (= a b))"))
(task-entry (id "sat/solver/state-all-clauses") (skill sat) (module solver) (tier 1) (difficulty 10910) (name state-all-clauses) (type "(-> SolverState (List Clause))") (description "Get all clauses including learned ones") (notes ()) (section solver-state) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts)) (answer "(define (state-all-clauses s) (append (cnf-clauses (state-cnf s)) (state-learned s)))"))
(task-entry (id "sat/sat/exactly-one") (skill sat) (module sat) (tier 1) (difficulty 10910) (name exactly-one) (type "(-> (List Literal) (List (List Literal)))") (description "Exactly one of vars is true") (notes ()) (section cnf-building-helpers) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one)) (answer "(define (exactly-one vars) (cons (at-least-one vars) (at-most-one vars)))"))
(task-entry (id "sat/maxsat/max-var-in-clauses") (skill sat) (module maxsat) (tier 1) (difficulty 10910) (name max-var-in-clauses) (type "") (description "") (notes ()) (section linear-search) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost)) (answer "(define (max-var-in-clauses clauses) (if (null? clauses) 0 (apply max (map (lambda (clause) (if (null? clause) 0 (apply max (map lit-var clause)))) clauses))))"))
(task-entry (id "sat/clause/clause-unit-lit") (skill sat) (module clause) (tier 1) (difficulty 10911) (name clause-unit-lit) (type "(-> Clause (Maybe Literal))") (description "Get the literal if clause is unit, else #f") (notes ()) (section clause-accessors) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker? clause-size clause-literals)) (answer "(define (clause-unit-lit clause) (if (clause-unit? clause) (car clause) #f))"))
(task-entry (id "sat/cnf/cnf-add-clause") (skill sat) (module cnf) (tier 1) (difficulty 10911) (name cnf-add-clause) (type "(-> CNF Clause CNF)") (description "Add a clause to CNF") (notes ()) (section cnf-operations) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses)) (answer "(define (cnf-add-clause cnf clause) (if (clause-tautology-marker? clause) cnf (make-cnf (cons clause (cnf-clauses cnf)))))"))
(task-entry (id "sat/assignment/assignment-assign") (skill sat) (module assignment) (tier 1) (difficulty 10911) (name assignment-assign) (type "(-> Assignment VarId (Or 'true 'false) Nat (Or Clause 'decision) Assignment)") (description "Add assignment to trail") (notes ()) (section assignment-operations) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size)) (answer "(define (assignment-assign a var val level reason) (let ((levels (assignment-levels-vec a)) (reasons (assignment-reasons-vec a)) (trail (assignment-trail a))) (vector-set! levels var level) (vector-set! reasons var reason) (list 'assignment (cons (cons var val) trail) levels reasons)))"))
(task-entry (id "sat/watches/watches-help") (skill sat) (module watches) (tier 1) (difficulty 10911) (name watches-help) (type "") (description "") (notes ()) (section help) (deps (\x27;literal)) (available (lit->watch-index watch-index->lit make-watches watches-get watches-set! watches-add! watches-init-clause! watches-init-all! watches-propagate! find-new-watch lit-equal?)) (answer "(define (watches-help) (display \"Two-Watched Literals (2WL) for SAT Solving\n\n\") (display \"Core idea: Each clause watches exactly 2 literals.\n\") (display \"When a literal becomes false, only visit clauses watching it.\n\n\") (display \"Functions:\n\") (display \"  (make-watches nvars)              Create watch structure\n\") (display \"  (watches-init-clause! w clause)   Initialize watches for clause\n\") (display \"  (watches-init-all! w clauses)     Initialize all clauses\n\") (display \"  (watches-propagate! w a lit)      Propagate lit becoming false\n\"))"))
(task-entry (id "sat/solver/unit-propagate") (skill sat) (module solver) (tier 1) (difficulty 10911) (name unit-propagate) (type "(-> SolverState Nat (Values SolverState (Or #f Clause)))") (description "Boolean Constraint Propagation using 2WL - propagate until fixpoint or conflict") (notes ()) (section unit-propagation) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses)) (answer "(define (unit-propagate state level) (let ((initial-units (find-initial-units state))) (unit-propagate-loop state level initial-units)))"))
(task-entry (id "sat/sat/at-most-k") (skill sat) (module sat) (tier 1) (difficulty 10911) (name at-most-k) (type "(-> (List Literal) Nat (List (List Literal)))") (description "At most k of vars are true - binomial encoding") (notes ("Generates all (n choose k+1) clauses")) (section cardinality-constraints) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one)) (answer "(define (at-most-k vars k) (if (>= k (length vars)) '() (map (lambda (subset) (map lit-negate subset)) (combinations vars (+ k 1)))))"))
(task-entry (id "sat/maxsat/maxsat-solve-binary") (skill sat) (module maxsat) (tier 1) (difficulty 10911) (name maxsat-solve-binary) (type "(-> MaxSATInstance (Or MaxSATResult #f))") (description "Solve MaxSAT using binary search over cost") (notes ("More efficient than linear for problems with many soft clauses")) (section binary-search) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses)) (answer "(define (maxsat-solve-binary maxsat) (let* ((hard (maxsat-hard maxsat)) (soft (maxsat-soft maxsat)) (n (length soft))) (if (and (not (null? hard)) (eq? (sat-solve hard) 'unsat)) #f (let ((result (binary-search-cost hard soft 0 n #f))) (if result (make-maxsat-result (car result) (cdr result)) #f)))))"))
(task-entry (id "sat/clause/clause-contains?") (skill sat) (module clause) (tier 1) (difficulty 10912) (name clause-contains?) (type "(-> Clause Literal Bool)") (description "Check if clause contains a specific literal") (notes ()) (section clause-accessors) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker? clause-size clause-literals clause-unit-lit)) (answer "(define (clause-contains? clause lit) (and (list? clause) (member lit clause) #t))"))
(task-entry (id "sat/cnf/cnf-add-clauses") (skill sat) (module cnf) (tier 1) (difficulty 10912) (name cnf-add-clauses) (type "(-> CNF (List Clause) CNF)") (description "Add multiple clauses to CNF") (notes ()) (section cnf-operations) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause)) (answer "(define (cnf-add-clauses cnf clauses) (fold-left cnf-add-clause cnf clauses))"))
(task-entry (id "sat/assignment/assignment-decide") (skill sat) (module assignment) (tier 1) (difficulty 10912) (name assignment-decide) (type "(-> Assignment VarId (Or 'true 'false) Nat Assignment)") (description "Make a decision assignment (branch)") (notes ()) (section assignment-operations) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign)) (answer "(define (assignment-decide a var val level) (assignment-assign a var val level 'decision))"))
(task-entry (id "sat/solver/unit-propagate-loop") (skill sat) (module solver) (tier 1) (difficulty 10912) (name unit-propagate-loop) (type "(-> SolverState Nat (List (Pair Literal Clause)) (Values SolverState (Or #f Clause)))") (description "Process pending unit propagations using 2WL") (notes ()) (section unit-propagation) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate)) (answer "(define (unit-propagate-loop state level pending-units) (if (null? pending-units) (values state #f) (let* ((unit (car pending-units)) (lit (car unit)) (clause (cdr unit)) (a (state-assignment state))) (if (assignment-assigned? a (lit-var lit)) (if (assignment-satisfies-lit? a lit) (unit-propagate-loop state level (cdr pending-units)) (values state clause)) (let* ((var (lit-var lit)) (val (if (lit-positive? lit) 'true 'false)) (new-a (assignment-propagate a var val level clause)) (new-state (state-set-assignment state new-a)) (false-lit (lit-negate lit)) (prop-result (watches-propagate! (state-watches new-state) new-a false-lit))) (cond ((and (pair? prop-result) (eq? (car prop-result) 'conflict)) (values new-state (cadr prop-result))) ((and (pair? prop-result) (eq? (car prop-result) 'units)) (unit-propagate-loop new-state level (append (cdr prop-result) (cdr pending-units)))) (else (unit-propagate-loop new-state level (cdr pending-units)))))))))"))
(task-entry (id "sat/sat/at-least-k") (skill sat) (module sat) (tier 1) (difficulty 10912) (name at-least-k) (type "(-> (List Literal) Nat (List (List Literal)))") (description "At least k of vars are true") (notes ("Equivalent to: at most (n-k) negations are true")) (section cardinality-constraints) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k)) (answer "(define (at-least-k vars k) (if (<= k 0) '() (at-most-k (map lit-negate vars) (- (length vars) k))))"))
(task-entry (id "sat/maxsat/binary-search-cost") (skill sat) (module maxsat) (tier 1) (difficulty 10912) (name binary-search-cost) (type "(-> (List Clause) (List Clause) Nat Nat (Or (Pair Nat Model) #f) (Or (Pair Nat Model) #f))") (description "Binary search for minimum cost in [lo, hi]") (notes ()) (section binary-search) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary)) (answer "(define (binary-search-cost hard soft lo hi best) (if (> lo hi) best (let* ((mid (quotient (+ lo hi) 2)) (result (maxsat-try-cost hard soft mid))) (if result (binary-search-cost hard soft lo (- mid 1) (cons mid result)) (binary-search-cost hard soft (+ mid 1) hi best)))))"))
(task-entry (id "sat/clause/clause-vars") (skill sat) (module clause) (tier 1) (difficulty 10913) (name clause-vars) (type "(-> Clause (List VarId))") (description "Get list of variable ids in clause") (notes ()) (section clause-accessors) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker? clause-size clause-literals clause-unit-lit clause-contains?)) (answer "(define (clause-vars clause) (if (clause-tautology-marker? clause) '() (map lit-var clause)))"))
(task-entry (id "sat/cnf/cnf-simplify") (skill sat) (module cnf) (tier 1) (difficulty 10913) (name cnf-simplify) (type "(-> CNF Assignment CNF)") (description "Simplify CNF under partial assignment") (notes ("Removes satisfied clauses, shrinks unsatisfied ones")) (section cnf-operations) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses)) (answer "(define (cnf-simplify cnf assignment) (make-cnf (filter-map (lambda (clause) (clause-simplify clause assignment)) (cnf-clauses cnf))))"))
(task-entry (id "sat/assignment/assignment-propagate") (skill sat) (module assignment) (tier 1) (difficulty 10913) (name assignment-propagate) (type "(-> Assignment VarId (Or 'true 'false) Nat Clause Assignment)") (description "Make a propagated assignment (unit propagation)") (notes ()) (section assignment-operations) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign assignment-decide)) (answer "(define (assignment-propagate a var val level clause) (assignment-assign a var val level clause))"))
(task-entry (id "sat/solver/find-initial-units") (skill sat) (module solver) (tier 1) (difficulty 10913) (name find-initial-units) (type "(-> SolverState (List (Pair Literal Clause)))") (description "Find unit clauses in initial state (before any propagation)") (notes ()) (section unit-propagation) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop)) (answer "(define (find-initial-units state) (let ((a (state-assignment state))) (let loop ((clauses (state-all-clauses state)) (units '())) (cond ((null? clauses) units) (else (let ((lit (assignment-unit-lit a (car clauses)))) (if lit (loop (cdr clauses) (cons (cons lit (car clauses)) units)) (loop (cdr clauses) units))))))))"))
(task-entry (id "sat/sat/exactly-k") (skill sat) (module sat) (tier 1) (difficulty 10913) (name exactly-k) (type "(-> (List Literal) Nat (List (List Literal)))") (description "Exactly k of vars are true") (notes ()) (section cardinality-constraints) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k at-least-k)) (answer "(define (exactly-k vars k) (append (at-least-k vars k) (at-most-k vars k)))"))
(task-entry (id "sat/maxsat/maxsat-solve") (skill sat) (module maxsat) (tier 1) (difficulty 10913) (name maxsat-solve) (type "(-> MaxSATInstance (Or MaxSATResult #f))") (description "Solve MaxSAT using best available algorithm") (notes ("Uses binary search by default; pass 'linear for linear search")) (section unified-interface) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost)) (answer "(define (maxsat-solve maxsat . options) (let ((algorithm (if (and (pair? options) (eq? (car options) 'linear)) 'linear 'binary))) (case algorithm ((linear) (maxsat-solve-linear maxsat)) ((binary) (maxsat-solve-binary maxsat)) (else (maxsat-solve-binary maxsat)))))"))
(task-entry (id "sat/clause/clause-remove-lit") (skill sat) (module clause) (tier 1) (difficulty 10914) (name clause-remove-lit) (type "(-> Clause Literal Clause)") (description "Remove a literal from clause") (notes ()) (section clause-operations) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker? clause-size clause-literals clause-unit-lit clause-contains? clause-vars)) (answer "(define (clause-remove-lit clause lit) (if (clause-tautology-marker? clause) clause (clause-from-list (filter (lambda (l) (not (= l lit))) clause))))"))
(task-entry (id "sat/cnf/clause-simplify") (skill sat) (module cnf) (tier 1) (difficulty 10914) (name clause-simplify) (type "(-> Clause Assignment (Maybe Clause))") (description "Simplify clause under assignment. Returns #f if satisfied.") (notes ()) (section cnf-operations) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify)) (answer "(define (clause-simplify clause assignment) (let loop ((lits (clause-literals clause)) (remaining '())) (cond ((null? lits) (if (null? remaining) '() (reverse remaining))) (else (let* ((lit (car lits)) (var (lit-var lit)) (val (assignment-get assignment var))) (cond ((not val) (loop (cdr lits) (cons lit remaining))) ((and (eq? val 'true) (lit-positive? lit)) #f) ((and (eq? val 'false) (lit-negative? lit)) #f) (else (loop (cdr lits) remaining))))))))"))
(task-entry (id "sat/assignment/assignment-backtrack-to") (skill sat) (module assignment) (tier 1) (difficulty 10914) (name assignment-backtrack-to) (type "(-> Assignment Nat Assignment)") (description "Backtrack to given decision level, undoing later assignments") (notes ()) (section assignment-operations) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign assignment-decide assignment-propagate)) (answer "(define (assignment-backtrack-to a level) (let ((levels (assignment-levels-vec a)) (reasons (assignment-reasons-vec a))) (let loop ((trail (assignment-trail a)) (new-trail '())) (cond ((null? trail) (list 'assignment (reverse new-trail) levels reasons)) (else (let* ((entry (car trail)) (var (car entry)) (var-level (vector-ref levels var))) (if (> var-level level) (begin (vector-set! levels var 0) (vector-set! reasons var #f) (loop (cdr trail) new-trail)) (loop (cdr trail) (cons entry new-trail)))))))))"))
(task-entry (id "sat/solver/find-unit-clause") (skill sat) (module solver) (tier 1) (difficulty 10914) (name find-unit-clause) (type "(-> SolverState (Maybe (Pair Clause Literal)))") (description "Find a unit clause and its unassigned literal (legacy, O(n) scan)") (notes ()) (section unit-propagation) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units)) (answer "(define (find-unit-clause state) (let ((a (state-assignment state))) (let loop ((clauses (state-all-clauses state))) (cond ((null? clauses) #f) (else (let ((lit (assignment-unit-lit a (car clauses)))) (if lit (cons (car clauses) lit) (loop (cdr clauses)))))))))"))
(task-entry (id "sat/sat/combinations") (skill sat) (module sat) (tier 1) (difficulty 10914) (name combinations) (type "(-> (List a) Nat (List (List a)))") (description "Generate all k-combinations of list") (notes ()) (section cardinality-constraints) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k at-least-k exactly-k)) (answer "(define (combinations lst k) (cond ((= k 0) '(())) ((null? lst) '()) (else (append (map (lambda (rest) (cons (car lst) rest)) (combinations (cdr lst) (- k 1))) (combinations (cdr lst) k)))))"))
(task-entry (id "sat/maxsat/partial-maxsat") (skill sat) (module maxsat) (tier 1) (difficulty 10914) (name partial-maxsat) (type "(-> (List Clause) MaxSATInstance)") (description "Create partial MaxSAT - maximize satisfied clauses (no hard constraints)") (notes ()) (section convenience-constructors) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve)) (answer "(define (partial-maxsat clauses) (make-maxsat '() clauses))"))
(task-entry (id "sat/clause/clause-resolve") (skill sat) (module clause) (tier 1) (difficulty 10915) (name clause-resolve) (type "(-> Clause Clause VarId (Maybe Clause))") (description "Resolution: combine two clauses on a variable") (notes ("Resolves (A OR x) with (B OR ~x) to get (A OR B)")) (section clause-operations) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker? clause-size clause-literals clause-unit-lit clause-contains? clause-vars clause-remove-lit)) (answer "(define (clause-resolve c1 c2 var) (let ((pos-lit (pos-lit var)) (neg-lit (neg-lit var))) (cond ((and (clause-contains? c1 pos-lit) (clause-contains? c2 neg-lit)) (clause-from-list (append (filter (lambda (l) (not (= l pos-lit))) c1) (filter (lambda (l) (not (= l neg-lit))) c2)))) ((and (clause-contains? c1 neg-lit) (clause-contains? c2 pos-lit)) (clause-from-list (append (filter (lambda (l) (not (= l neg-lit))) c1) (filter (lambda (l) (not (= l pos-lit))) c2)))) (else #f))))"))
(task-entry (id "sat/cnf/cnf->string") (skill sat) (module cnf) (tier 1) (difficulty 10915) (name cnf->string) (type "(-> CNF String)") (description "Convert CNF to string representation") (notes ()) (section cnf-display) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify)) (answer "(define (cnf->string cnf) (let ((clauses (cnf-clauses cnf))) (if (null? clauses) \"TRUE\" (apply string-append (list-intersperse (map clause->string clauses) \" & \")))))"))
(task-entry (id "sat/assignment/assignment-eval-lit") (skill sat) (module assignment) (tier 1) (difficulty 10915) (name assignment-eval-lit) (type "(-> Assignment Literal (Or 'true 'false 'unknown))") (description "Evaluate a literal under assignment") (notes ()) (section assignment-literal-evaluation) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign assignment-decide assignment-propagate assignment-backtrack-to)) (answer "(define (assignment-eval-lit a lit) (let* ((var (lit-var lit)) (val (assignment-get a var))) (cond ((not val) 'unknown) ((and (eq? val 'true) (lit-positive? lit)) 'true) ((and (eq? val 'false) (lit-negative? lit)) 'true) (else 'false))))"))
(task-entry (id "sat/solver/check-conflict") (skill sat) (module solver) (tier 1) (difficulty 10915) (name check-conflict) (type "(-> SolverState (Maybe Clause))") (description "Check if any clause is falsified (legacy, O(n) scan)") (notes ()) (section unit-propagation) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause)) (answer "(define (check-conflict state) (let ((a (state-assignment state))) (let loop ((clauses (state-all-clauses state))) (cond ((null? clauses) #f) ((eq? (assignment-eval-clause a (car clauses)) 'conflict) (car clauses)) (else (loop (cdr clauses)))))))"))
(task-entry (id "sat/sat/sequential-at-most-k") (skill sat) (module sat) (tier 1) (difficulty 10915) (name sequential-at-most-k) (type "(-> (List Literal) Nat Nat (List (List Literal)))") (description "At most k of vars are true - Sinz sequential counter encoding") (notes ("Uses O(n*k) auxiliary variables and O(n*k) clauses" "More scalable than binomial encoding for large n")) (section sequential-counter) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k at-least-k exactly-k combinations)) (answer "(define (sequential-at-most-k vars k base-var) (let ((n (length vars))) (cond ((>= k n) '()) ((= k 0) (map (lambda (v) (list (lit-negate v))) vars)) ((= n 1) '()) (else (let* ((x (list->vector vars)) (r-var (lambda (i j) (+ base-var (* (- i 1) k) (- j 1)))) (clauses '())) (define (add! c) (set! clauses (cons c clauses))) (let loop-i ((i 1)) (when (<= i n) (let ((xi (vector-ref x (- i 1)))) (add! (list (lit-negate xi) (var (r-var i 1)))) (when (> i 1) (let loop-j ((j 1)) (when (<= j k) (add! (list (lit-negate (var (r-var (- i 1) j))) (var (r-var i j)))) (loop-j (+ j 1)))) (let loop-j ((j 1)) (when (< j k) (add! (list (lit-negate xi) (lit-negate (var (r-var (- i 1) j))) (var (r-var i (+ j 1))))) (loop-j (+ j 1)))) (add! (list (lit-negate xi) (lit-negate (var (r-var (- i 1) k))))))) (loop-i (+ i 1)))) clauses)))))"))
(task-entry (id "sat/maxsat/maxsat-from-soft") (skill sat) (module maxsat) (tier 1) (difficulty 10915) (name maxsat-from-soft) (type "(-> (List Clause) MaxSATInstance)") (description "Create MaxSAT with only soft clauses") (notes ()) (section convenience-constructors) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve partial-maxsat)) (answer "(define (maxsat-from-soft soft-clauses) (make-maxsat '() soft-clauses))"))
(task-entry (id "sat/clause/clause->string") (skill sat) (module clause) (tier 1) (difficulty 10916) (name clause->string) (type "(-> Clause String)") (description "Convert clause to string representation") (notes ()) (section clause-display) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker? clause-size clause-literals clause-unit-lit clause-contains? clause-vars clause-remove-lit clause-resolve)) (answer "(define (clause->string clause) (cond ((clause-tautology-marker? clause) \"TRUE\") ((clause-empty? clause) \"FALSE\") (else (string-append \"(\" (apply string-append (list-intersperse (map lit->string clause) \" | \")) \")\"))))"))
(task-entry (id "sat/cnf/cnf->dimacs") (skill sat) (module cnf) (tier 1) (difficulty 10916) (name cnf->dimacs) (type "(-> CNF String)") (description "Convert CNF to DIMACS format") (notes ()) (section cnf-display) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify cnf->string)) (answer "(define (cnf->dimacs cnf) (let* ((clauses (cnf-clauses cnf)) (nvars (cnf-num-vars cnf)) (nclauses (length clauses)) (header (string-append \"p cnf \" (number->string nvars) \" \" (number->string nclauses) \"\n\")) (clause-strs (map clause->dimacs clauses))) (apply string-append (cons header clause-strs))))"))
(task-entry (id "sat/assignment/assignment-satisfies-lit?") (skill sat) (module assignment) (tier 1) (difficulty 10916) (name assignment-satisfies-lit?) (type "(-> Assignment Literal Bool)") (description "Check if assignment satisfies a literal") (notes ()) (section assignment-literal-evaluation) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign assignment-decide assignment-propagate assignment-backtrack-to assignment-eval-lit)) (answer "(define (assignment-satisfies-lit? a lit) (eq? (assignment-eval-lit a lit) 'true))"))
(task-entry (id "sat/solver/analyze-conflict") (skill sat) (module solver) (tier 1) (difficulty 10916) (name analyze-conflict) (type "(-> SolverState Clause Nat (Values Clause Nat))") (description "Analyze conflict and compute learned clause via 1-UIP") (notes ()) (section conflict-analysis) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict)) (answer "(define (analyze-conflict state conflict-clause level) (let ((a (state-assignment state))) (if (<= level 0) (values '() -1) (let loop ((clause conflict-clause) (trail (assignment-trail a))) (let ((count-at-level (count-lits-at-level clause a level))) (if (= count-at-level 1) (values clause (compute-backtrack-level clause a level)) (let ((resolve-result (find-resolve-var clause trail a level))) (if (not resolve-result) (values clause (max 0 (- level 1))) (let* ((var (car resolve-result)) (reason (cdr resolve-result)) (new-clause (clause-resolve clause reason var))) (if new-clause (loop new-clause (cdr trail)) (values clause (max 0 (- level 1)))))))))))))"))
(task-entry (id "sat/sat/graph-coloring") (skill sat) (module sat) (tier 1) (difficulty 10916) (name graph-coloring) (type "(-> (List (Pair Nat Nat)) Nat Nat (List (List Literal)))") (description "Encode graph coloring as SAT") (notes ("Variable (node * num-colors + color + 1) represents node has color")) (section common-patterns) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k at-least-k exactly-k combinations sequential-at-most-k)) (answer "(define (graph-coloring edges num-nodes num-colors) (let ((var (lambda (n c) (+ (* n num-colors) c 1)))) (append (append-map (lambda (node) (exactly-one (map (lambda (c) (var node c)) (range 0 num-colors)))) (range 0 num-nodes)) (append-map (lambda (edge) (let ((u (car edge)) (v (cdr edge))) (map (lambda (c) (list (neg (var u c)) (neg (var v c)))) (range 0 num-colors)))) edges))))"))
(task-entry (id "sat/maxsat/maxsat-add-hard") (skill sat) (module maxsat) (tier 1) (difficulty 10916) (name maxsat-add-hard) (type "(-> MaxSATInstance (List Clause) MaxSATInstance)") (description "Add hard constraints to MaxSAT instance") (notes ()) (section convenience-constructors) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve partial-maxsat maxsat-from-soft)) (answer "(define (maxsat-add-hard maxsat clauses) (make-maxsat (append (maxsat-hard maxsat) clauses) (maxsat-soft maxsat)))"))
(task-entry (id "sat/clause/list-intersperse") (skill sat) (module clause) (tier 1) (difficulty 10917) (name list-intersperse) (type "(-> (List a) a (List a))") (description "") (notes ()) (section clause-display) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker? clause-size clause-literals clause-unit-lit clause-contains? clause-vars clause-remove-lit clause-resolve clause->string)) (answer "(define (list-intersperse lst sep) (cond ((null? lst) '()) ((null? (cdr lst)) lst) (else (cons (car lst) (cons sep (list-intersperse (cdr lst) sep))))))"))
(task-entry (id "sat/cnf/clause->dimacs") (skill sat) (module cnf) (tier 1) (difficulty 10917) (name clause->dimacs) (type "(-> Clause String)") (description "Convert clause to DIMACS line") (notes ()) (section cnf-display) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify cnf->string cnf->dimacs)) (answer "(define (clause->dimacs clause) (string-append (apply string-append (list-intersperse (map number->string clause) \" \")) \" 0\n\"))"))
(task-entry (id "sat/assignment/assignment-falsifies-lit?") (skill sat) (module assignment) (tier 1) (difficulty 10917) (name assignment-falsifies-lit?) (type "(-> Assignment Literal Bool)") (description "Check if assignment falsifies a literal") (notes ()) (section assignment-literal-evaluation) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign assignment-decide assignment-propagate assignment-backtrack-to assignment-eval-lit assignment-satisfies-lit?)) (answer "(define (assignment-falsifies-lit? a lit) (eq? (assignment-eval-lit a lit) 'false))"))
(task-entry (id "sat/solver/count-lits-at-level") (skill sat) (module solver) (tier 1) (difficulty 10917) (name count-lits-at-level) (type "(-> Clause Assignment Nat Nat)") (description "Count literals in clause at given decision level") (notes ()) (section conflict-analysis) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict)) (answer "(define (count-lits-at-level clause a level) (let loop ((lits clause) (count 0)) (cond ((null? lits) count) (else (let* ((var (lit-var (car lits))) (var-level (assignment-level a var))) (loop (cdr lits) (if (= var-level level) (+ count 1) count)))))))"))
(task-entry (id "sat/sat/n-queens-clauses") (skill sat) (module sat) (tier 1) (difficulty 10917) (name n-queens-clauses) (type "(-> Nat (List (List Literal)))") (description "Encode N-Queens as SAT clauses (CNF). Use with sat-solve or sat-model.") (notes ("Variable (row * n + col + 1) represents queen at (row, col)")) (section common-patterns) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k at-least-k exactly-k combinations sequential-at-most-k graph-coloring)) (answer "(define (n-queens-clauses n) (let ((var (lambda (r c) (+ (* r n) c 1)))) (append (append-map (lambda (r) (exactly-one (map (lambda (c) (var r c)) (range 0 n)))) (range 0 n)) (append-map (lambda (c) (at-most-one (map (lambda (r) (var r c)) (range 0 n)))) (range 0 n)) (sat-queens-diagonal-constraints n var))))"))
(task-entry (id "sat/maxsat/maxsat-add-soft") (skill sat) (module maxsat) (tier 1) (difficulty 10917) (name maxsat-add-soft) (type "(-> MaxSATInstance (List Clause) MaxSATInstance)") (description "Add soft constraints to MaxSAT instance") (notes ()) (section convenience-constructors) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve partial-maxsat maxsat-from-soft maxsat-add-hard)) (answer "(define (maxsat-add-soft maxsat clauses) (make-maxsat (maxsat-hard maxsat) (append (maxsat-soft maxsat) clauses)))"))
(task-entry (id "sat/clause/all") (skill sat) (module clause) (tier 1) (difficulty 10918) (name all) (type "") (description "") (notes ()) (section clause-display) (deps (\x27;literal \x27;sort)) (available (make-clause clause-from-list clause-normalize clause-dedup clause-tautology? clause? clause-empty? clause-unit? clause-tautology-marker? clause-size clause-literals clause-unit-lit clause-contains? clause-vars clause-remove-lit clause-resolve clause->string list-intersperse)) (answer "(define (all pred lst) (cond ((null? lst) #t) ((not (pred (car lst))) #f) (else (all pred (cdr lst)))))"))
(task-entry (id "sat/cnf/dimacs-parse") (skill sat) (module cnf) (tier 1) (difficulty 10918) (name dimacs-parse) (type "(-> (List String) CNF)") (description "Parse DIMACS format into CNF") (notes ()) (section cnf-from-dimacs) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify cnf->string cnf->dimacs clause->dimacs)) (answer "(define (dimacs-parse lines) (let loop ((lines lines) (clauses '())) (cond ((null? lines) (make-cnf (reverse clauses))) (else (let ((line (string-trim (car lines)))) (cond ((or (string=? line \"\") (char=? (string-ref line 0) #\\c)) (loop (cdr lines) clauses)) ((char=? (string-ref line 0) #\\p) (loop (cdr lines) clauses)) (else (let ((clause (dimacs-parse-clause line))) (loop (cdr lines) (cons clause clauses))))))))))"))
(task-entry (id "sat/assignment/assignment-eval-clause") (skill sat) (module assignment) (tier 1) (difficulty 10918) (name assignment-eval-clause) (type "(-> Assignment Clause (Or 'satisfied 'conflict 'unit 'unresolved))") (description "Evaluate clause status under assignment") (notes ()) (section assignment-clause-evaluation) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign assignment-decide assignment-propagate assignment-backtrack-to assignment-eval-lit assignment-satisfies-lit? assignment-falsifies-lit?)) (answer "(define (assignment-eval-clause a clause) (let loop ((lits clause) (unknown-count 0) (last-unknown #f)) (cond ((null? lits) (cond ((= unknown-count 0) 'conflict) ((= unknown-count 1) 'unit) (else 'unresolved))) (else (let ((eval (assignment-eval-lit a (car lits)))) (cond ((eq? eval 'true) 'satisfied) ((eq? eval 'unknown) (loop (cdr lits) (+ unknown-count 1) (car lits))) (else (loop (cdr lits) unknown-count last-unknown))))))))"))
(task-entry (id "sat/solver/find-resolve-var") (skill sat) (module solver) (tier 1) (difficulty 10918) (name find-resolve-var) (type "(-> Clause Trail Assignment Nat (Maybe (Pair VarId Clause)))") (description "Find most recent variable at level with non-decision reason") (notes ()) (section conflict-analysis) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level)) (answer "(define (find-resolve-var clause trail a level) (let loop ((trail trail)) (cond ((null? trail) #f) (else (let* ((var (caar trail)) (var-level (assignment-level a var)) (reason (assignment-reason a var)) (lit-pos (pos-lit var)) (lit-neg (neg-lit var)) (in-clause (or (member lit-pos clause) (member lit-neg clause)))) (if (and (= var-level level) in-clause (list? reason)) (cons var reason) (loop (cdr trail))))))))"))
(task-entry (id "sat/sat/sat-queens-diagonal-constraints") (skill sat) (module sat) (tier 1) (difficulty 10918) (name sat-queens-diagonal-constraints) (type "(-> Nat (-> Nat Nat Literal) (List (List Literal)))") (description "") (notes ()) (section common-patterns) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k at-least-k exactly-k combinations sequential-at-most-k graph-coloring n-queens-clauses)) (answer "(define (sat-queens-diagonal-constraints n var) (flatten (append (map (lambda (d) (at-most-one (filter-map (lambda (r) (let ((c (- r d))) (and (>= c 0) (< c n) (var r c)))) (range 0 n)))) (range (- 1 n) n)) (map (lambda (s) (at-most-one (filter-map (lambda (r) (let ((c (- s r))) (and (>= c 0) (< c n) (var r c)))) (range 0 n)))) (range 0 (- (* 2 n) 1))))))"))
(task-entry (id "sat/maxsat/min-vertex-cover") (skill sat) (module maxsat) (tier 1) (difficulty 10918) (name min-vertex-cover) (type "(-> (List (Pair Nat Nat)) Nat MaxSATInstance)") (description "Encode minimum vertex cover as MaxSAT") (notes ("Variable i means node i is in the cover" "Hard: each edge has at least one endpoint in cover" "Soft: prefer not including each node (minimize cover size)")) (section applications) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve partial-maxsat maxsat-from-soft maxsat-add-hard maxsat-add-soft)) (answer "(define (min-vertex-cover edges num-nodes) (let* ((hard (map (lambda (edge) (list (+ 1 (car edge)) (+ 1 (cdr edge)))) edges)) (soft (map (lambda (node) (list (neg (+ 1 node)))) (iota num-nodes)))) (make-maxsat hard soft)))"))
(task-entry (id "sat/cnf/dimacs-parse-clause") (skill sat) (module cnf) (tier 1) (difficulty 10919) (name dimacs-parse-clause) (type "(-> String Clause)") (description "Parse a DIMACS clause line") (notes ()) (section cnf-from-dimacs) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify cnf->string cnf->dimacs clause->dimacs dimacs-parse)) (answer "(define (dimacs-parse-clause line) (let* ((nums (filter (lambda (n) (not (= n 0))) (map string->number (string-split line #\\ ))))) (clause-from-list nums)))"))
(task-entry (id "sat/assignment/assignment-unit-lit") (skill sat) (module assignment) (tier 1) (difficulty 10919) (name assignment-unit-lit) (type "(-> Assignment Clause (Maybe Literal))") (description "If clause is unit, return the unassigned literal") (notes ()) (section assignment-clause-evaluation) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign assignment-decide assignment-propagate assignment-backtrack-to assignment-eval-lit assignment-satisfies-lit? assignment-falsifies-lit? assignment-eval-clause)) (answer "(define (assignment-unit-lit a clause) (let loop ((lits clause) (unknown #f)) (cond ((null? lits) unknown) (else (let ((eval (assignment-eval-lit a (car lits)))) (cond ((eq? eval 'true) #f) ((eq? eval 'unknown) (if unknown #f (loop (cdr lits) (car lits)))) (else (loop (cdr lits) unknown))))))))"))
(task-entry (id "sat/solver/compute-backtrack-level") (skill sat) (module solver) (tier 1) (difficulty 10919) (name compute-backtrack-level) (type "(-> Clause Assignment Nat Nat)") (description "Compute backtrack level (second highest level in clause)") (notes ()) (section conflict-analysis) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var)) (answer "(define (compute-backtrack-level clause a current-level) (let ((levels (map (lambda (lit) (assignment-level a (lit-var lit))) clause))) (let ((sorted (sort-by > levels))) (if (or (null? sorted) (null? (cdr sorted))) 0 (cadr sorted)))))"))
(task-entry (id "sat/sat/n-queens-solve") (skill sat) (module sat) (tier 1) (difficulty 10919) (name n-queens-solve) (type "(-> Nat (Maybe (List (Pair VarId Bool))))") (description "Solve N-Queens and return satisfying assignment, or #f if unsatisfiable.") (notes ()) (section convenience-solvers) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k at-least-k exactly-k combinations sequential-at-most-k graph-coloring n-queens-clauses sat-queens-diagonal-constraints)) (answer "(define (n-queens-solve n) (sat-model (n-queens-clauses n)))"))
(task-entry (id "sat/maxsat/max-independent-set") (skill sat) (module maxsat) (tier 1) (difficulty 10919) (name max-independent-set) (type "(-> (List (Pair Nat Nat)) Nat MaxSATInstance)") (description "Encode maximum independent set as MaxSAT") (notes ("Variable i means node i is in the independent set" "Hard: no two adjacent nodes both in set" "Soft: prefer including each node (maximize set size)")) (section applications) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve partial-maxsat maxsat-from-soft maxsat-add-hard maxsat-add-soft min-vertex-cover)) (answer "(define (max-independent-set edges num-nodes) (let* ((hard (map (lambda (edge) (list (neg (+ 1 (car edge))) (neg (+ 1 (cdr edge))))) edges)) (soft (map (lambda (node) (list (+ 1 node))) (iota num-nodes)))) (make-maxsat hard soft)))"))
(task-entry (id "sat/cnf/string-trim") (skill sat) (module cnf) (tier 1) (difficulty 10920) (name string-trim) (type "(-> String String)") (description "") (notes ()) (section cnf-from-dimacs) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify cnf->string cnf->dimacs clause->dimacs dimacs-parse dimacs-parse-clause)) (answer "(define (string-trim s) (list->string (let loop ((chars (string->list s))) (cond ((null? chars) '()) ((char-whitespace? (car chars)) (loop (cdr chars))) (else (reverse (let loop2 ((chars (reverse chars))) (cond ((null? chars) '()) ((char-whitespace? (car chars)) (loop2 (cdr chars))) (else chars)))))))))"))
(task-entry (id "sat/assignment/assignment->string") (skill sat) (module assignment) (tier 1) (difficulty 10920) (name assignment->string) (type "(-> Assignment String)") (description "Convert assignment to string representation") (notes ()) (section assignment-display) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign assignment-decide assignment-propagate assignment-backtrack-to assignment-eval-lit assignment-satisfies-lit? assignment-falsifies-lit? assignment-eval-clause assignment-unit-lit)) (answer "(define (assignment->string a) (let ((trail (reverse (assignment-trail a)))) (if (null? trail) \"{}\" (string-append \"{\" (apply string-append (list-intersperse (map (lambda (entry) (string-append \"x\" (number->string (car entry)) \"=\" (if (eq? (cdr entry) 'true) \"T\" \"F\"))) trail) \", \")) \"}\"))))"))
(task-entry (id "sat/solver/pick-branching-var") (skill sat) (module solver) (tier 1) (difficulty 10920) (name pick-branching-var) (type "(-> SolverState (Maybe VarId))") (description "Select unassigned variable using VSIDS heuristic") (notes ()) (section variable-selection) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var compute-backtrack-level)) (answer "(define (pick-branching-var state) (let* ((a (state-assignment state)) (scores (state-scores state)) (vars (cnf-vars (state-cnf state)))) (let loop ((vars vars) (best-var #f) (best-score -1.0)) (cond ((null? vars) best-var) (else (let ((var (car vars))) (if (assignment-assigned? a var) (loop (cdr vars) best-var best-score) (let ((score (vector-ref scores var))) (if (> score best-score) (loop (cdr vars) var score) (loop (cdr vars) best-var best-score))))))))))"))
(task-entry (id "sat/sat/graph-coloring-solve") (skill sat) (module sat) (tier 1) (difficulty 10920) (name graph-coloring-solve) (type "(-> (List (Pair Nat Nat)) Nat Nat (Maybe (List (Pair VarId Bool))))") (description "Solve graph coloring and return satisfying assignment, or #f if unsatisfiable.") (notes ()) (section convenience-solvers) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k at-least-k exactly-k combinations sequential-at-most-k graph-coloring n-queens-clauses sat-queens-diagonal-constraints n-queens-solve)) (answer "(define (graph-coloring-solve edges num-nodes num-colors) (sat-model (graph-coloring edges num-nodes num-colors)))"))
(task-entry (id "sat/maxsat/min-correction-set") (skill sat) (module maxsat) (tier 1) (difficulty 10920) (name min-correction-set) (type "(-> (List Clause) MaxSATInstance)") (description "Find minimum set of clauses to remove to make formula satisfiable") (notes ("Useful for diagnosis: which constraints are causing inconsistency?")) (section applications) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve partial-maxsat maxsat-from-soft maxsat-add-hard maxsat-add-soft min-vertex-cover max-independent-set)) (answer "(define (min-correction-set clauses) (partial-maxsat clauses))"))
(task-entry (id "sat/cnf/string-split") (skill sat) (module cnf) (tier 1) (difficulty 10921) (name string-split) (type "(-> String Char (List String))") (description "") (notes ()) (section cnf-from-dimacs) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify cnf->string cnf->dimacs clause->dimacs dimacs-parse dimacs-parse-clause string-trim)) (answer "(define (string-split str delim) (let loop ((chars (string->list str)) (current '()) (result '())) (cond ((null? chars) (reverse (if (null? current) result (cons (list->string (reverse current)) result)))) ((char=? (car chars) delim) (if (null? current) (loop (cdr chars) '() result) (loop (cdr chars) '() (cons (list->string (reverse current)) result)))) (else (loop (cdr chars) (cons (car chars) current) result)))))"))
(task-entry (id "sat/assignment/list-intersperse") (skill sat) (module assignment) (tier 1) (difficulty 10921) (name list-intersperse) (type "") (description "") (notes ()) (section assignment-display) (deps (\x27;literal)) (available (make-assignment assignment-copy assignment-trail assignment-levels-vec assignment-reasons-vec assignment-get assignment-level assignment-reason assignment-decision-level assignment-assigned? assignment-size assignment-assign assignment-decide assignment-propagate assignment-backtrack-to assignment-eval-lit assignment-satisfies-lit? assignment-falsifies-lit? assignment-eval-clause assignment-unit-lit assignment->string)) (answer "(define (list-intersperse lst sep) (cond ((null? lst) '()) ((null? (cdr lst)) lst) (else (cons (car lst) (cons sep (list-intersperse (cdr lst) sep))))))"))
(task-entry (id "sat/solver/bump-vsids-scores") (skill sat) (module solver) (tier 1) (difficulty 10921) (name bump-vsids-scores) (type "(-> SolverState Clause SolverState)") (description "Bump VSIDS scores for variables in conflict clause") (notes ()) (section variable-selection) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var compute-backtrack-level pick-branching-var)) (answer "(define (bump-vsids-scores state clause) (let ((scores (state-scores state))) (for-each (lambda (lit) (let ((var (lit-var lit))) (vector-set! scores var (+ (vector-ref scores var) 1.0)))) clause) state))"))
(task-entry (id "sat/sat/sat-help") (skill sat) (module sat) (tier 1) (difficulty 10921) (name sat-help) (type "(-> Void)") (description "Print SAT solver help") (notes ()) (section utility) (deps (\x27;solver)) (available (sat-solve sat-satisfiable? sat-model assignment-to-model var neg implies iff at-most-one at-least-one exactly-one at-most-k at-least-k exactly-k combinations sequential-at-most-k graph-coloring n-queens-clauses sat-queens-diagonal-constraints n-queens-solve graph-coloring-solve)) (answer "(define (sat-help) (display \"SAT Solver - Boolean Satisfiability with CDCL\n\n\") (display \"Basic Usage:\n\") (display \"  (sat-solve '((1 2) (-1 3)))     ; Check satisfiability\n\") (display \"  (sat-satisfiable? clauses)      ; Returns #t or #f\n\") (display \"  (sat-model clauses)             ; Returns assignment or #f\n\n\") (display \"Building Clauses:\n\") (display \"  (var n)                         ; Positive literal xn\n\") (display \"  (neg n)                         ; Negative literal ~xn\n\") (display \"  (implies a b)                   ; a => b as clause\n\") (display \"  (iff a b)                       ; a <=> b as clauses\n\n\") (display \"Cardinality:\n\") (display \"  (at-most-one vars)              ; At most one true\n\") (display \"  (at-least-one vars)             ; At least one true\n\") (display \"  (exactly-one vars)              ; Exactly one true\n\") (display \"  (at-most-k vars k)              ; At most k true\n\") (display \"  (exactly-k vars k)              ; Exactly k true\n\n\") (display \"Problems:\n\") (display \"  (graph-coloring edges nodes colors)  ; Graph coloring\n\") (display \"  (n-queens-solve n)                   ; N-Queens puzzle\n\"))"))
(task-entry (id "sat/maxsat/maxsat-unsatisfied-soft") (skill sat) (module maxsat) (tier 1) (difficulty 10921) (name maxsat-unsatisfied-soft) (type "(-> MaxSATResult (List Clause) Model (List Clause))") (description "Get the soft clauses that are unsatisfied in the solution") (notes ()) (section result-analysis) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve partial-maxsat maxsat-from-soft maxsat-add-hard maxsat-add-soft min-vertex-cover max-independent-set min-correction-set)) (answer "(define (maxsat-unsatisfied-soft result soft-clauses model) (filter (lambda (clause) (not (clause-satisfied? clause model))) soft-clauses))"))
(task-entry (id "sat/cnf/any") (skill sat) (module cnf) (tier 1) (difficulty 10922) (name any) (type "") (description "") (notes ()) (section cnf-from-dimacs) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify cnf->string cnf->dimacs clause->dimacs dimacs-parse dimacs-parse-clause string-trim string-split)) (answer "(define (any pred lst) (cond ((null? lst) #f) ((pred (car lst)) #t) (else (any pred (cdr lst)))))"))
(task-entry (id "sat/solver/decay-vsids-scores") (skill sat) (module solver) (tier 1) (difficulty 10922) (name decay-vsids-scores) (type "(-> SolverState SolverState)") (description "Decay all VSIDS scores") (notes ()) (section variable-selection) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var compute-backtrack-level pick-branching-var bump-vsids-scores)) (answer "(define (decay-vsids-scores state) (let ((scores (state-scores state)) (nvars (cnf-num-vars (state-cnf state)))) (let loop ((i 1)) (when (<= i nvars) (vector-set! scores i (* 0.95 (vector-ref scores i))) (loop (+ i 1)))) state))"))
(task-entry (id "sat/maxsat/clause-satisfied?") (skill sat) (module maxsat) (tier 1) (difficulty 10922) (name clause-satisfied?) (type "(-> Clause Model Bool)") (description "Check if clause is satisfied by model") (notes ()) (section result-analysis) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve partial-maxsat maxsat-from-soft maxsat-add-hard maxsat-add-soft min-vertex-cover max-independent-set min-correction-set maxsat-unsatisfied-soft)) (answer "(define (clause-satisfied? clause model) (let loop ((lits clause)) (cond ((null? lits) #f) (else (let* ((lit (car lits)) (var (lit-var lit)) (entry (assoc var model))) (if entry (let ((val (cdr entry))) (if (if (lit-positive? lit) val (not val)) #t (loop (cdr lits)))) (loop (cdr lits))))))))"))
(task-entry (id "sat/cnf/list-unique") (skill sat) (module cnf) (tier 1) (difficulty 10923) (name list-unique) (type "") (description "") (notes ()) (section cnf-from-dimacs) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify cnf->string cnf->dimacs clause->dimacs dimacs-parse dimacs-parse-clause string-trim string-split any)) (answer "(define (list-unique lst) (let loop ((lst lst) (seen '()) (acc '())) (cond ((null? lst) (reverse acc)) ((member (car lst) seen) (loop (cdr lst) seen acc)) (else (loop (cdr lst) (cons (car lst) seen) (cons (car lst) acc))))))"))
(task-entry (id "sat/solver/solve") (skill sat) (module solver) (tier 1) (difficulty 10923) (name solve) (type "(-> CNF (Or 'sat 'unsat 'unknown))") (description "Solve SAT instance, returning 'sat, 'unsat, or 'unknown (timeout)") (notes ()) (section main-solver) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var compute-backtrack-level pick-branching-var bump-vsids-scores decay-vsids-scores)) (answer "(define (solve cnf) (let ((result (solve-with-model cnf))) (cond ((eq? result 'timeout) 'unknown) (result 'sat) (else 'unsat))))"))
(task-entry (id "sat/maxsat/maxsat-help") (skill sat) (module maxsat) (tier 1) (difficulty 10923) (name maxsat-help) (type "") (description "") (notes ()) (section help) (deps (\x27;sat)) (available (make-maxsat maxsat-hard maxsat-soft maxsat-num-soft make-maxsat-result maxsat-result? maxsat-result-cost maxsat-result-model maxsat-solve-linear maxsat-try-cost max-var-in-clauses maxsat-solve-binary binary-search-cost maxsat-solve partial-maxsat maxsat-from-soft maxsat-add-hard maxsat-add-soft min-vertex-cover max-independent-set min-correction-set maxsat-unsatisfied-soft clause-satisfied?)) (answer "(define (maxsat-help) (display \"MaxSAT - Optimization Extension to SAT\n\n\") (display \"Create MaxSAT instances:\n\") (display \"  (make-maxsat hard soft)       Hard + soft clauses\n\") (display \"  (partial-maxsat clauses)      All clauses soft\n\") (display \"  (maxsat-add-hard m clauses)   Add hard constraints\n\") (display \"  (maxsat-add-soft m clauses)   Add soft constraints\n\n\") (display \"Solve:\n\") (display \"  (maxsat-solve m)              Binary search (default)\n\") (display \"  (maxsat-solve m 'linear)      Linear search\n\n\") (display \"Results:\n\") (display \"  (maxsat-result-cost r)        Number of unsatisfied soft\n\") (display \"  (maxsat-result-model r)       Satisfying assignment\n\n\") (display \"Applications:\n\") (display \"  (min-vertex-cover edges n)    Minimum vertex cover\n\") (display \"  (max-independent-set edges n) Maximum independent set\n\") (display \"  (min-correction-set clauses)  Diagnosis/repair\n\"))"))
(task-entry (id "sat/cnf/assignment-get") (skill sat) (module cnf) (tier 1) (difficulty 10924) (name assignment-get) (type "(-> Assignment VarId (Maybe (Or 'true 'false)))") (description "") (notes ()) (section cnf-from-dimacs) (deps (\x27;clause \x27;sort)) (available (make-cnf cnf-from-lists cnf-empty cnf? cnf-trivially-unsat? cnf-trivially-sat? cnf-clauses cnf-num-clauses cnf-num-vars cnf-vars cnf-unit-clauses cnf-add-clause cnf-add-clauses cnf-simplify clause-simplify cnf->string cnf->dimacs clause->dimacs dimacs-parse dimacs-parse-clause string-trim string-split any list-unique)) (answer "(define (assignment-get assignment var) (let ((entry (assv var assignment))) (and entry (cdr entry))))"))
(task-entry (id "sat/solver/*sat-fuel-limit*") (skill sat) (module solver) (tier 1) (difficulty 10924) (name *sat-fuel-limit*) (type "") (description "Maximum iterations before timeout (can be increased)") (notes ()) (section main-solver) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var compute-backtrack-level pick-branching-var bump-vsids-scores decay-vsids-scores solve)) (answer "(define *sat-fuel-limit* 10000)"))
(task-entry (id "sat/solver/solve-with-model") (skill sat) (module solver) (tier 1) (difficulty 10925) (name solve-with-model) (type "(-> CNF (Or Assignment 'timeout #f))") (description "Solve SAT instance, returning assignment, 'timeout, or #f (unsat)") (notes ()) (section main-solver) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var compute-backtrack-level pick-branching-var bump-vsids-scores decay-vsids-scores solve *sat-fuel-limit*)) (answer "(define (solve-with-model cnf) (cond ((cnf-trivially-unsat? cnf) #f) ((cnf-trivially-sat? cnf) (make-assignment 0)) (else (cdcl-solve (make-solver-state cnf)))))"))
(task-entry (id "sat/solver/cdcl-solve") (skill sat) (module solver) (tier 1) (difficulty 10926) (name cdcl-solve) (type "(-> SolverState (Or Assignment 'timeout #f))") (description "Main CDCL solving loop") (notes ()) (section main-solver) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var compute-backtrack-level pick-branching-var bump-vsids-scores decay-vsids-scores solve *sat-fuel-limit* solve-with-model)) (answer "(define (cdcl-solve state) (cdcl-loop state 0 *sat-fuel-limit*))"))
(task-entry (id "sat/solver/cdcl-loop") (skill sat) (module solver) (tier 1) (difficulty 10927) (name cdcl-loop) (type "(-> SolverState Nat Nat (Or Assignment 'timeout #f))") (description "") (notes ()) (section main-solver) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var compute-backtrack-level pick-branching-var bump-vsids-scores decay-vsids-scores solve *sat-fuel-limit* solve-with-model cdcl-solve)) (answer "(define (cdcl-loop state level fuel) (if (<= fuel 0) 'timeout (let-values (((state conflict) (unit-propagate state level))) (if conflict (if (= level 0) #f (let-values (((learned-clause bt-level) (analyze-conflict state conflict level))) (if (< bt-level 0) #f (let* ((state (state-inc-conflicts state)) (state (bump-vsids-scores state learned-clause)) (state (if (= 0 (modulo (state-conflicts state) 100)) (decay-vsids-scores state) state)) (state (state-add-learned state learned-clause)) (a (assignment-backtrack-to (state-assignment state) bt-level)) (state (state-set-assignment state a))) (cdcl-loop state bt-level (- fuel 1)))))) (let ((var (pick-branching-var state))) (if (not var) (state-assignment state) (let* ((new-level (+ level 1)) (a (assignment-decide (state-assignment state) var 'true new-level)) (state (state-set-assignment state a))) (cdcl-loop state new-level (- fuel 1)))))))))"))
(task-entry (id "sat/solver/solver-stats") (skill sat) (module solver) (tier 1) (difficulty 10928) (name solver-stats) (type "(-> SolverState (List (Pair Symbol Any)))") (description "Get solver statistics") (notes ()) (section solver-statistics) (deps (\x27;cnf \x27;assignment \x27;watches \x27;sort)) (available (make-solver-state state-cnf state-assignment state-learned state-scores state-conflicts state-watches state-set-assignment state-add-learned state-inc-conflicts state-all-clauses unit-propagate unit-propagate-loop find-initial-units find-unit-clause check-conflict analyze-conflict count-lits-at-level find-resolve-var compute-backtrack-level pick-branching-var bump-vsids-scores decay-vsids-scores solve *sat-fuel-limit* solve-with-model cdcl-solve cdcl-loop)) (answer "(define (solver-stats state) (list (cons 'conflicts (state-conflicts state)) (cons 'learned-clauses (length (state-learned state))) (cons 'variables (cnf-num-vars (state-cnf state))) (cons 'original-clauses (cnf-num-clauses (state-cnf state)))))"))
