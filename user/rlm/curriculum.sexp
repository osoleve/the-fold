(task-entry (id "diffgeo/lie-groups/so2-alg-to-matrix") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10717) (name so2-alg-to-matrix) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg)) (answer "(define (so2-alg-to-matrix xi) (let ((omega (so2-alg-omega xi)) (m (make-matrix 2 2 0))) (matrix-set! m 0 1 (- omega)) (matrix-set! m 1 0 omega) m))"))
(task-entry (id "diffgeo/curvature/compute-metric-derivatives") (skill diffgeo) (module curvature) (tier 1) (difficulty 10717) (name compute-metric-derivatives) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols)) (answer "(define (compute-metric-derivatives m coords eps n) (let ((dg (make-vector n #f)) (coords-plus (vec-copy coords)) (coords-minus (vec-copy coords))) (do ((l 0 (+ l 1))) ((= l n) dg) (let ((cl (vector-ref coords l))) (vector-set! coords-plus l (+ cl eps)) (vector-set! coords-minus l (- cl eps)) (let* ((g-plus (metric-at m coords-plus)) (g-minus (metric-at m coords-minus)) (dg-l (matrix-scale (/ 1.0 (* 2 eps)) (matrix-sub g-plus g-minus)))) (vector-set! dg l dg-l)) (vector-set! coords-plus l cl) (vector-set! coords-minus l cl)))))"))
(task-entry (id "diffgeo/geodesics/dp-geodesic-step") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10717) (name dp-geodesic-step) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale*)) (answer "(define (dp-geodesic-step metric state dt . k1-cache) (let* ((x0 (geodesic-state-coords state)) (v0 (geodesic-state-velocity state)) (n (vector-length x0)) (kx (make-vector 7 #f)) (kv (make-vector 7 #f))) (if (and (not (null? k1-cache)) (car k1-cache)) (let ((cached (car k1-cache))) (vector-set! kx 0 (car cached)) (vector-set! kv 0 (cdr cached))) (let ((d1 (geodesic-derivative metric state))) (vector-set! kx 0 (car d1)) (vector-set! kv 0 (cdr d1)))) (do ((i 1 (+ i 1))) ((= i 7)) (let* ((ai (vector-ref dp-a i)) (xi (vec-copy x0)) (vi (vec-copy v0))) (do ((j 0 (+ j 1))) ((= j i)) (let ((aij (vector-ref ai j))) (when (not (= aij 0)) (set! xi (vec-add xi (vec-scale (* dt aij) (vector-ref kx j)))) (set! vi (vec-add vi (vec-scale (* dt aij) (vector-ref kv j))))))) (let ((di (geodesic-derivative metric (make-geodesic-state xi vi)))) (vector-set! kx i (car di)) (vector-set! kv i (cdr di))))) (let ((x5 (vec-copy x0)) (v5 (vec-copy v0))) (do ((i 0 (+ i 1))) ((= i 7)) (let ((bi (vector-ref dp-b5 i))) (when (not (= bi 0)) (set! x5 (vec-add x5 (vec-scale (* dt bi) (vector-ref kx i)))) (set! v5 (vec-add v5 (vec-scale (* dt bi) (vector-ref kv i))))))) (let ((x4 (vec-copy x0)) (v4 (vec-copy v0))) (do ((i 0 (+ i 1))) ((= i 7)) (let ((bi (vector-ref dp-b4 i))) (when (not (= bi 0)) (set! x4 (vec-add x4 (vec-scale (* dt bi) (vector-ref kx i)))) (set! v4 (vec-add v4 (vec-scale (* dt bi) (vector-ref kv i))))))) (let* ((err-x (vec-sub x5 x4)) (err-v (vec-sub v5 v4)) (err-norm (max (vec-norm err-x) (vec-norm err-v))) (k7 (cons (vector-ref kx 6) (vector-ref kv 6)))) (list (make-geodesic-state x5 v5) (make-geodesic-state x4 v4) err-norm k7))))))"))
