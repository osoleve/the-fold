(task-entry (id "diffgeo/forms/integrate-2-form-surface") (skill diffgeo) (module forms) (tier 1) (difficulty 10745) (name integrate-2-form-surface) (type "") (description "") (notes ()) (section integration) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices count-inversions-to-sort k-form? k-form-point k-form-chart k-form-degree k-form-components k-form-dim make-k-form k-form-zero k-form-basis cotangent->1-form \x31;-form->cotangent k-form-add k-form-sub k-form-scale k-form-negate k-form-change-chart wedge wedge* interior-product remove-at exterior-derivative insert-sorted insertion-sign d-scalar k-form-apply matrix-det-small pullback-k-form hodge-star-euclidean complement-index levi-civita-sign volume-form integrate-1-form-line)) (answer "(define (integrate-2-form-surface omega-field sigma u0 u1 v0 v1 u-steps v-steps . epsilon-arg) (let* ((du (/ (- u1 u0) u-steps)) (dv (/ (- v1 v0) v-steps)) (eps (if (null? epsilon-arg) *jacobian-epsilon* (car epsilon-arg))) (result 0)) (do ((i 0 (+ i 1))) ((= i u-steps) result) (do ((j 0 (+ j 1))) ((= j v-steps)) (let* ((u (+ u0 (* i du) (/ du 2))) (v (+ v0 (* j dv) (/ dv 2))) (p (sigma u v)) (omega (omega-field p)) (chart (k-form-chart omega)) (p-u+ (sigma (+ u eps) v)) (p-u- (sigma (- u eps) v)) (p-v+ (sigma u (+ v eps))) (p-v- (sigma u (- v eps))) (c-u+ (chart-apply chart p-u+)) (c-u- (chart-apply chart p-u-)) (c-v+ (chart-apply chart p-v+)) (c-v- (chart-apply chart p-v-)) (du-vec (vec-scale (/ 1.0 (* 2 eps)) (vec-sub c-u+ c-u-))) (dv-vec (vec-scale (/ 1.0 (* 2 eps)) (vec-sub c-v+ c-v-))) (tangent-u (make-tangent-vector p chart du-vec)) (tangent-v (make-tangent-vector p chart dv-vec)) (integrand (k-form-apply omega (list tangent-u tangent-v)))) (set! result (+ result (* integrand du dv))))))))"))
