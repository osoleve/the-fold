(task-entry (id "physics/classical/ode-integrators/total-energy") (skill physics/classical) (module ode-integrators) (tier 2) (difficulty 23518) (name total-energy) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (state-add state-sub state-scale state-madd euler-step midpoint-step heun-step rk4-step symplectic-euler-step symplectic-euler-step-b verlet-step velocity-verlet-step leapfrog-step integrate integrate-symplectic rk45-step integrate-adaptive kinetic-energy)) (answer "(define (total-energy pos vel mass potential-fn) (+ (kinetic-energy vel mass) (potential-fn pos)))"))
(task-entry (id "physics/classical/integrators/integrate-body-rk4") (skill physics/classical) (module integrators) (tier 2) (difficulty 23518) (name integrate-body-rk4) (type "") (description "") (notes ()) (section \x32;d) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet)) (answer "(define (integrate-body-rk4 body force-fn t dt) (if (body-static? body) body (let* ((inv-m (body-inv-mass body)) (pos-state (vec2->state (body-pos body))) (vel-state (vec2->state (body-vel body))) (full-state (append pos-state vel-state)) (deriv-fn (lambda (time state) (let* ((pos (state->vec2 (take state 2))) (vel (state->vec2 (drop state 2))) (temp-body (make-body-2d pos vel (body-mass body))) (force (force-fn temp-body time)) (accel (vec2-scale force inv-m))) (append vel-state (vec2->state accel))))) (new-state (rk4-step deriv-fn t full-state dt)) (new-pos (state->vec2 (take new-state 2))) (new-vel (state->vec2 (drop new-state 2)))) (body-with-state body new-pos new-vel))))"))
