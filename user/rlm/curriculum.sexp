 (x) (let ((result (eval-vector-field sys 0 (vector x)))) (vector-ref result 0)))) (fpp (/ (+ (f (+ x0 h)) (f (- x0 h)) (* -2 (f x0))) (* h h))) (fppp (/ (+ (f (+ x0 (* 2 h))) (* -2 (f (+ x0 h))) (* 2 (f (- x0 h))) (- (f (- x0 (* 2 h))))) (* 2 h h h)))) (list fpp fppp)))"))
(task-entry (id "sim/bifurcation/normal-form-is-pitchfork?") (skill sim) (module bifurcation) (tier 2) (difficulty 23364) (name normal-form-is-pitchfork?) (type "(-> ODE Vec Number Boolean)") (description "Determine if bifurcation has pitchfork normal form (Z₂ symmetry)") (notes ("Only valid for 1D systems at real eigenvalue zero-crossing")) (section normal-form-classification) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives)) (answer "(define (normal-form-is-pitchfork? sys fp h) (let ((dim (ode-dimension sys))) (if (not (= dim 1)) #f (let* ((derivs (compute-1d-derivatives sys fp h)) (fpp (car derivs))) (< (abs fpp) *normal-form-tolerance*)))))"))
(task-entry (id "sim/bifurcation/classify-codim1-bifurcation") (skill sim) (module bifurcation) (tier 2) (difficulty 23365) (name classify-codim1-bifurcation) (type "(-> ODE Vec Number Symbol)") (description "Classify a codimension-1 bifurcation using normal form analysis") (notes ()) (section normal-form-classification) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork?)) (answer "(define (classify-codim1-bifurcation sys fp h) (let ((dim (ode-dimension sys))) (cond ((not (= dim 1)) 'unknown) (else (let* ((derivs (compute-1d-derivatives sys fp h)) (fpp (car derivs)) (fppp (cadr derivs))) (cond ((and (< (abs fpp) *normal-form-tolerance*) (> (abs fppp) *normal-form-tolerance*)) 'pitchfork) ((> (abs fpp) *normal-form-tolerance*) 'transcritical) (else 'unknown)))))))"))
(task-entry (id "sim/bifurcation/compute-critical-eigenvectors-svd") (skill sim) (module bifurcation) (tier 2) (difficulty 23366) (name compute-critical-eigenvectors-svd) (type "(-> Matrix (Option (List Vec Vec)))") (description "Compute both left and right critical eigenvectors using SVD") (notes ()) (section nd-normal-form-classification) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation)) (answer "(define (compute-critical-eigenvectors-svd jac) (let* ((n (matrix-rows jac)) (svd-result (svd jac))) (if (and (pair? svd-result) (eq? (car svd-result) 'error)) #f (let* ((u (car svd-result)) (sigma (cadr svd-result)) (v (caddr svd-result)) (min-idx (find-min-singular-value-index sigma n)) (min-val (matrix-ref sigma min-idx min-idx))) (if (> min-val 1e-6) #f (let ((right-vec (make-vector n 0)) (left-vec (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! right-vec i (matrix-ref v i min-idx)) (vector-set! left-vec i (matrix-ref u i min-idx))) (list right-vec left-vec)))))))"))
(task-entry (id "sim/bifurcation/normalize-eigenvector-pair") (skill sim) (module bifurcation) (tier 2) (difficulty 23367) (name normalize-eigenvector-pair) (type "(-> Vec Vec (List Vec Vec))") (description "Normalize eigenvector pair so that wᵀv = 1") (notes ()) (section nd-normal-form-classification) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd)) (answer "(define (normalize-eigenvector-pair right-vec left-vec) (let ((dot (vec-dot left-vec right-vec))) (if (< (abs dot) 1e-10) (list right-vec left-vec) (list right-vec (vec-scale (/ 1.0 dot) left-vec)))))"))
(task-entry (id "sim/bifurcation/compute-nd-directional-derivatives") (skill sim) (module bifurcation) (tier 2) (difficulty 23368) (name compute-nd-directional-derivatives) (type "(-> ODE Vec Vec Vec Number (List Number Number))") (description "Compute 2nd and 3rd directional derivatives along center manifold") (notes ()) (section nd-normal-form-classification) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair)) (answer "(define (compute-nd-directional-derivatives sys fp right-vec left-vec h) (let* ((g (lambda (xi) (let* ((x (vec-add fp (vec-scale xi right-vec))) (fx (eval-vector-field sys 0 x))) (vec-dot left-vec fx)))) (g0 (g 0)) (gpp (/ (+ (g h) (g (- h)) (* -2 g0)) (* h h))) (gppp (/ (+ (g (* 2 h)) (* -2 (g h)) (* 2 (g (- h))) (- (g (* -2 h)))) (* 2 h h h)))) (list gpp gppp)))"))
(task-entry (id "sim/bifurcation/compute-projected-parameter-derivative") (skill sim) (module bifurcation) (tier 2) (difficulty 23369) (name compute-projected-parameter-derivative) (type "(-> ParamODE Number Vec Vec Number Number)") (description "Compute wᵀ(∂f/∂p)|_{x*} - parameter derivative projected onto center manifold") (notes ("At saddle-node: this is non-zero (fold is transverse).\nAt transcritical: this is zero (fixed point tracks parameter).")) (section nd-normal-form-classification) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives)) (answer "(define (compute-projected-parameter-derivative psys param fp left-vec h) (let ((jac-p (compute-parameter-jacobian psys param fp h))) (vec-dot left-vec jac-p)))"))
(task-entry (id "sim/bifurcation/classify-codim1-bifurcation-nd") (skill sim) (module bifurcation) (tier 2) (difficulty 23370) (name classify-codim1-bifurcation-nd) (type "(-> ParamODE Number Vec Number Symbol)") (description "Classify a codimension-1 bifurcation for n-dimensional systems") (notes ("Uses center manifold reduction via SVD to handle arbitrary dimensions.\nDistinguishes saddle-node by checking wᵀ(∂f/∂p) (transversality condition).")) (section nd-normal-form-classification) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative)) (answer "(define (classify-codim1-bifurcation-nd psys param fp h) (let* ((sys (instantiate-at psys param)) (n (ode-dimension sys))) (cond ((= n 1) (classify-codim1-bifurcation sys fp h)) (else (let* ((jac (compute-jacobian sys fp *continuation-step-size*)) (eigenpair (compute-critical-eigenvectors-svd jac))) (if (not eigenpair) 'unknown (let* ((right-vec (car eigenpair)) (left-vec (cadr eigenpair)) (normalized (normalize-eigenvector-pair right-vec left-vec)) (norm-right (car normalized)) (norm-left (cadr normalized)) (derivs (compute-nd-directional-derivatives sys fp norm-right norm-left h)) (gpp (car derivs)) (gppp (cadr derivs)) (param-deriv (compute-projected-parameter-derivative psys param fp norm-left h))) (cond ((and (< (abs gpp) *normal-form-tolerance*) (> (abs gppp) *normal-form-tolerance*)) 'pitchfork) ((> (abs param-deriv) *normal-form-tolerance*) 'saddle-node) ((and (> (abs gpp) *normal-form-tolerance*) (< (abs param-deriv) *normal-form-tolerance*)) 'transcritical) (else 'unknown)))))))))"))
(task-entry (id "sim/bifurcation/bifurcation-diagram-equilibria") (skill sim) (module bifurcation) (tier 2) (difficulty 23371) (name bifurcation-diagram-equilibria) (type "(-> ParamODE Number Number Nat (List (Pair Number Number)) Nat Number (List (List Number Vec Symbol)))") (description "Generate bifurcation diagram data showing equilibria vs parameter") (notes ()) (section bifurcation-diagrams) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd)) (answer "(define (bifurcation-diagram-equilibria psys param-min param-max param-steps search-region grid-density tolerance) (let ((step (/ (- param-max param-min) (max 1 (- param-steps 1))))) (append-map (lambda (i) (let* ((param (+ param-min (* i step))) (sys (instantiate-at psys param)) (fps (find-all-fixed-points sys search-region grid-density tolerance))) (map (lambda (fp) (let* ((analysis (analyze-stability-general sys fp *continuation-step-size*)) (stability (car analysis))) (list param fp stability))) fps))) (iota param-steps))))"))
(task-entry (id "sim/bifurcation/bifurcation-diagram-amplitude") (skill sim) (module bifurcation) (tier 2) (difficulty 23372) (name bifurcation-diagram-amplitude) (type "(-> ParamODE Number Number Nat Vec Number Nat Nat (List (Pair Number Number)))") (description "Generate bifurcation diagram showing attractor amplitude vs parameter") (notes ("For limit cycles, this shows the oscillation amplitude. For chaos, it shows the spread")) (section bifurcation-diagrams) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria)) (answer "(define (bifurcation-diagram-amplitude psys param-min param-max param-steps initial-state dt n-transient n-sample) (let ((step (/ (- param-max param-min) (max 1 (- param-steps 1))))) (append-map (lambda (i) (let* ((param (+ param-min (* i step))) (sys (instantiate-at psys param)) (settled (let loop ((t 0) (state initial-state) (k 0)) (if (>= k n-transient) state (loop (+ t dt) (rk4-step sys t state dt) (+ k 1))))) (samples (let loop ((t 0) (state settled) (k 0) (acc '())) (if (>= k n-sample) (reverse acc) (loop (+ t dt) (rk4-step sys t state dt) (+ k 1) (cons state acc)))))) (map (lambda (s) (cons param (vector-ref s 0))) samples))) (iota param-steps))))"))
(task-entry (id "sim/bifurcation/bifurcation-diagram-poincare") (skill sim) (module bifurcation) (tier 2) (difficulty 23373) (name bifurcation-diagram-poincare) (type "(-> ParamODE Number Number Nat Vec Number Nat Nat Nat Number Symbol (List (Pair Number Number)))") (description "Generate bifurcation diagram using Poincare section crossings") (notes ("Shows period-doubling bifurcations clearly for limit cycles")) (section bifurcation-diagrams) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude)) (answer "(define (bifurcation-diagram-poincare psys param-min param-max param-steps initial-state dt n-transient n-crossings plane-axis plane-value direction) (let ((step (/ (- param-max param-min) (max 1 (- param-steps 1))))) (append-map (lambda (i) (let* ((param (+ param-min (* i step))) (sys (instantiate-at psys param)) (section (poincare-section sys initial-state dt (+ n-transient (* n-crossings 100)) n-transient plane-axis plane-value direction)) (coord-idx (if (= plane-axis 0) 1 0))) (map (lambda (pt) (cons param (vector-ref pt coord-idx))) (take n-crossings section)))) (iota param-steps))))"))
(task-entry (id "sim/bifurcation/find-hopf-bifurcation") (skill sim) (module bifurcation) (tier 2) (difficulty 23374) (name find-hopf-bifurcation) (type "(-> ParamODE Number Number Vec Number (Option (List Number Vec Number)))") (description "Find the parameter value where a Hopf bifurcation occurs") (notes ()) (section hopf-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare)) (answer "(define (find-hopf-bifurcation psys param-min param-max fp-guess tolerance) (let loop ((lo param-min) (hi param-max) (iter 0)) (if (or (> iter 50) (< (- hi lo) tolerance)) (let* ((param (/ (+ lo hi) 2)) (sys (instantiate-at psys param)) (fp (find-fixed-point-solver sys fp-guess tolerance *continuation-step-size* *continuation-max-newton*))) (if fp (let* ((analysis (analyze-stability-general sys fp *continuation-step-size*)) (eigs (cdr analysis)) (freq (hopf-frequency eigs))) (list param fp freq)) #f)) (let* ((mid (/ (+ lo hi) 2)) (sys (instantiate-at psys mid)) (fp (find-fixed-point-solver sys fp-guess tolerance *continuation-step-size* *continuation-max-newton*))) (if (not fp) #f (let* ((analysis (analyze-stability-general sys fp *continuation-step-size*)) (stab (car analysis)) (eigs (cdr analysis)) (has-complex (any (lambda (e) (> (abs (complex-imag e)) 1e-6)) eigs)) (max-real (apply max (map complex-real eigs)))) (cond ((and has-complex (> max-real 0)) (loop lo mid (+ iter 1))) ((and has-complex (< max-real 0)) (loop mid hi (+ iter 1))) (else #f))))))))"))
(task-entry (id "sim/bifurcation/hopf-frequency") (skill sim) (module bifurcation) (tier 2) (difficulty 23375) (name hopf-frequency) (type "(-> (List Complex) Number)") (description "Extract the frequency at Hopf bifurcation from eigenvalues") (notes ()) (section hopf-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation)) (answer "(define (hopf-frequency eigenvalues) (let ((complex-eigs (filter (lambda (e) (> (abs (complex-imag e)) 1e-6)) eigenvalues))) (if (null? complex-eigs) 0 (abs (complex-imag (car complex-eigs))))))"))
(task-entry (id "sim/bifurcation/hopf-criticality") (skill sim) (module bifurcation) (tier 2) (difficulty 23376) (name hopf-criticality) (type "(-> ParamODE Number Vec Number Symbol)") (description "Determine if Hopf bifurcation is supercritical or subcritical") (notes ("Supercritical (l₁ < 0): stable limit cycle emerges. Subcritical (l₁ > 0): unstable limit cycle")) (section hopf-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency)) (answer "(define (hopf-criticality psys param fp h) (let ((l1 (first-lyapunov-coefficient psys param fp h))) (cond ((not l1) 'unknown) ((< l1 0) 'supercritical) ((> l1 0) 'subcritical) (else 'degenerate))))"))
(task-entry (id "sim/bifurcation/first-lyapunov-coefficient") (skill sim) (module bifurcation) (tier 2) (difficulty 23377) (name first-lyapunov-coefficient) (type "(-> ParamODE Number Vec Number (Option Number))") (description "Compute the First Lyapunov Coefficient at a Hopf bifurcation") (notes ("Uses Kuznetsov's formula with numerical derivatives. Returns #f if not at a Hopf point.")) (section hopf-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality)) (answer "(define (first-lyapunov-coefficient psys param fp h) (if (not (= (vector-length fp) 2)) #f (let* ((sys (instantiate-at psys param)) (analysis (analyze-stability-general sys fp h)) (eigs (cdr analysis))) (if (not (hopf-point? eigs)) #f (let* ((omega (abs (complex-imag (car eigs)))) (derivs (compute-hopf-derivatives sys fp h)) (l1 (kuznetsov-l1 derivs omega))) l1)))))"))
(task-entry (id "sim/bifurcation/hopf-point?") (skill sim) (module bifurcation) (tier 2) (difficulty 23378) (name hopf-point?) (type "(-> (List Complex) Boolean)") (description "Check if eigenvalues indicate a Hopf bifurcation point") (notes ()) (section hopf-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient)) (answer "(define (hopf-point? eigenvalues) (and (>= (length eigenvalues) 2) (let ((e1 (car eigenvalues)) (e2 (cadr eigenvalues))) (and (> (abs (complex-imag e1)) 0.001) (< (abs (complex-real e1)) 0.1) (< (abs (+ (complex-imag e1) (complex-imag e2))) 0.001)))))"))
(task-entry (id "sim/bifurcation/compute-hopf-derivatives") (skill sim) (module bifurcation) (tier 2) (difficulty 23379) (name compute-hopf-derivatives) (type "(-> ODE Vec Number (List Number))") (description "Compute 2nd and 3rd order partial derivatives for Hopf normal form") (notes ()) (section hopf-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point?)) (answer "(define (compute-hopf-derivatives sys fp h) (let* ((x0 (vector-ref fp 0)) (y0 (vector-ref fp 1)) (f (lambda (x y) (let ((result (eval-vector-field sys 0 (vector x y)))) (vector-ref result 0)))) (g (lambda (x y) (let ((result (eval-vector-field sys 0 (vector x y)))) (vector-ref result 1)))) (fxx (second-deriv-xx f x0 y0 h)) (fxy (second-deriv-xy f x0 y0 h)) (fyy (second-deriv-yy f x0 y0 h)) (gxx (second-deriv-xx g x0 y0 h)) (gxy (second-deriv-xy g x0 y0 h)) (gyy (second-deriv-yy g x0 y0 h)) (fxxx (third-deriv-xxx f x0 y0 h)) (fxxy (third-deriv-xxy f x0 y0 h)) (fxyy (third-deriv-xyy f x0 y0 h)) (fyyy (third-deriv-yyy f x0 y0 h)) (gxxx (third-deriv-xxx g x0 y0 h)) (gxxy (third-deriv-xxy g x0 y0 h)) (gxyy (third-deriv-xyy g x0 y0 h)) (gyyy (third-deriv-yyy g x0 y0 h))) (list fxx fxy fyy gxx gxy gyy fxxx fxxy fxyy fyyy gxxx gxxy gxyy gyyy)))"))
(task-entry (id "sim/bifurcation/second-deriv-xx") (skill sim) (module bifurcation) (tier 2) (difficulty 23380) (name second-deriv-xx) (type "(-> (-> Number Number Number) Number Number Number Number)") (description "") (notes ()) (section hopf-bifurcation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations detect-bifurcation-type saddle-node-condition? hopf-condition? stability-changed? real-eigenvalue-zero-crossing? *normal-form-tolerance* *normal-form-h* compute-1d-derivatives normal-form-is-pitchfork? classify-codim1-bifurcation compute-critical-eigenvectors-svd normalize-eigenvector-pair compute-nd-directional-derivatives compute-projected-parameter-derivative classify-codim1-bifurcation-nd bifurcation-diagram-equilibria bifurcation-diagram-amplitude bifurcation-diagram-poincare find-hopf-bifurcation hopf-frequency hopf-criticality first-lyapunov-coefficient hopf-point? compute-hopf-derivatives)) (answer "(define (second-deriv-xx f x y h) (/ (+ (f (+ x h) y) (f (- x h) y) (* -2 (f x y))) (* h h)))"))
