(task-entry (id "statistics/acf-pacf/durbin-levinson") (skill statistics) (module acf-pacf) (tier 1) (difficulty 11205) (name durbin-levinson) (type "") (description "") (notes ()) (section autocovariance-and-autocorrelation) (deps (\x27;prelude \x27;summary-stats \x27;stat/distributions)) (available (autocovariance acf acf-standard-error acf-confidence-bounds pacf)) (answer "(define (durbin-levinson acf-vals pacf-vals max-lag) (let ((phi (make-vector max-lag 0))) (vector-set! phi 0 (vector-ref acf-vals 1)) (do ((k 2 (+ k 1))) ((> k max-lag)) (let* ((num (- (vector-ref acf-vals k) (let loop ((j 1) (s 0)) (if (>= j k) s (loop (+ j 1) (+ s (* (vector-ref phi (- j 1)) (vector-ref acf-vals (- k j))))))))) (den (- 1 (let loop ((j 1) (s 0)) (if (>= j k) s (loop (+ j 1) (+ s (* (vector-ref phi (- j 1)) (vector-ref acf-vals j)))))))) (phi-kk (if (= den 0) 0 (/ num den)))) (vector-set! pacf-vals k phi-kk) (let ((phi-new (make-vector max-lag))) (do ((j 1 (+ j 1))) ((>= j k)) (vector-set! phi-new (- j 1) (- (vector-ref phi (- j 1)) (* phi-kk (vector-ref phi (- k j 1)))))) (vector-set! phi-new (- k 1) phi-kk) (do ((j 0 (+ j 1))) ((= j k)) (vector-set! phi j (vector-ref phi-new j))))))))"))
(task-entry (id "statistics/ar/ar-forecast") (skill statistics) (module ar) (tier 1) (difficulty 11205) (name ar-forecast) (type "") (description "") (notes ()) (section ar-model-fitting) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (ar-fit center-series make-toeplitz-matrix ar-compute-diagnostics ar-predict-one)) (answer "(define (ar-forecast model xs h) (let* ((phi (ar-coefficients model)) (mean (ar-intercept model)) (sigma (ar-sigma model)) (p (ar-order model)) (n (vector-length xs)) (centered (center-series xs mean)) (extended (make-vector (+ n h) 0)) (_ (do ((i 0 (+ i 1))) ((= i n)) (vector-set! extended i (vector-ref centered i)))) (forecasts (make-vector h)) (_ (do ((t 0 (+ t 1))) ((= t h)) (let ((pred (let loop ((k 0) (s 0)) (if (= k p) s (loop (+ k 1) (+ s (* (vector-ref phi k) (vector-ref extended (- (+ n t) k 1))))))))) (vector-set! extended (+ n t) pred) (vector-set! forecasts t (+ mean pred))))) (forecast-se (ar-forecast-se phi sigma h)) (z (standard-normal-quantile 0.975)) (lower (make-vector h)) (upper (make-vector h))) (do ((t 0 (+ t 1))) ((= t h)) (let ((fc (vector-ref forecasts t)) (se (vector-ref forecast-se t))) (vector-set! lower t (- fc (* z se))) (vector-set! upper t (+ fc (* z se))))) (make-forecast-result forecasts lower upper 0.95)))"))
