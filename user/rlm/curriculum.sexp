(task-entry (id "control-systems/z-transform/dtf-from-lists") (skill control-systems) (module z-transform) (tier 2) (difficulty 22603) (name dtf-from-lists) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs)) (answer "(define (dtf-from-lists num-list den-list Ts) (make-dtf (poly-from-list num-list) (poly-from-list den-list) Ts))"))
(task-entry (id "control-systems/tf-convert/compute-tf-numerator") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22603) (name compute-tf-numerator) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier faddeev-leverrier)) (answer "(define (compute-tf-numerator c-row adj-matrices b-col d-val char-coeffs n) (let* ((num-len (+ n 1)) (result (make-vector num-len 0))) (do ((i 0 (+ i 1))) ((= i num-len)) (vector-set! result i (* d-val (vector-ref char-coeffs i)))) (let loop ((k 0) (mats adj-matrices)) (if (null? mats) result (let* ((M (car mats)) (CB (dot-product-cv c-row (matrix-vec-mul M b-col))) (coeff-idx (+ 1 k))) (if (< coeff-idx num-len) (vector-set! result coeff-idx (+ (vector-ref result coeff-idx) CB))) (loop (+ k 1) (cdr mats)))))))"))
