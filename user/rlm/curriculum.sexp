(task-entry (id "physics/classical3d/collision-detection3d/aabb3d-aabb3d-manifold") (skill physics/classical3d) (module collision-detection3d) (tier 2) (difficulty 22409) (name aabb3d-aabb3d-manifold) (type "") (description "") (notes ()) (section point-in-shape-tests) (deps (\x27;prelude \x27;vec3 \x27;shapes3d)) (available (point-in-aabb3d? point-in-sphere3d? point-in-box3d? closest-point-on-segment-3d closest-point-on-aabb3d closest-point-on-box3d sphere-sphere? sphere-sphere-manifold aabb3d-aabb3d?)) (answer "(define (aabb3d-aabb3d-manifold a b) (if (not (aabb3d-aabb3d? a b)) #f (let* ((a-center (aabb3d-center a)) (b-center (aabb3d-center b)) (a-half (aabb3d-half-extents a)) (b-half (aabb3d-half-extents b)) (diff (vec3-sub b-center a-center)) (overlap-x (- (+ (vec3-x a-half) (vec3-x b-half)) (abs (vec3-x diff)))) (overlap-y (- (+ (vec3-y a-half) (vec3-y b-half)) (abs (vec3-y diff)))) (overlap-z (- (+ (vec3-z a-half) (vec3-z b-half)) (abs (vec3-z diff)))) (min-overlap (min overlap-x (min overlap-y overlap-z)))) (cond ((= min-overlap overlap-x) (let* ((sign-x (if (< (vec3-x diff) 0) -1 1)) (normal (vec3 sign-x 0 0)) (contact (vec3 (+ (vec3-x a-center) (* (vec3-x a-half) sign-x)) (vec3-y b-center) (vec3-z b-center)))) (list normal overlap-x contact))) ((= min-overlap overlap-y) (let* ((sign-y (if (< (vec3-y diff) 0) -1 1)) (normal (vec3 0 sign-y 0)) (contact (vec3 (vec3-x b-center) (+ (vec3-y a-center) (* (vec3-y a-half) sign-y)) (vec3-z b-center)))) (list normal overlap-y contact))) (else (let* ((sign-z (if (< (vec3-z diff) 0) -1 1)) (normal (vec3 0 0 sign-z)) (contact (vec3 (vec3-x b-center) (vec3-y b-center) (+ (vec3-z a-center) (* (vec3-z a-half) sign-z))))) (list normal overlap-z contact)))))))"))
