(task-entry (id "optimization/lp/run-phase1") (skill optimization) (module lp) (tier 1) (difficulty 12829) (name run-phase1) (type "") (description "") (notes ()) (section constants) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers)) (available (*lp-tolerance* *lp-max-iterations* lp? make-lp lp-c lp-A lp-b lp-dims make-lp-optimal make-lp-infeasible make-lp-unbounded lp-optimal? lp-infeasible? lp-unbounded? lp-result-x lp-result-z lp-result-basis lp-result-direction lp-from-inequality lp-maximize extract-basis-matrix extract-basis-costs compute-reduced-costs find-entering-variable vec-contains? compute-direction find-leaving-variable update-basis create-phase1-lp)) (answer "(define (run-phase1 A b) (let* ((phase1-data (create-phase1-lp A b)) (phase1-lp (car phase1-data)) (init-basis (cdr phase1-data)) (result (simplex-core phase1-lp init-basis))) (cond ((lp-infeasible? result) 'infeasible) ((lp-unbounded? result) 'infeasible) (else (let ((z (lp-result-z result)) (basis (lp-result-basis result)) (n (matrix-cols A))) (if (> z *lp-tolerance*) 'infeasible (let ((has-artificial (let loop ((i 0)) (if (= i (vector-length basis)) #f (if (>= (vector-ref basis i) n) #t (loop (+ i 1))))))) (if has-artificial (pivot-out-artificials A b basis n) basis))))))))"))
(task-entry (id "optimization/ilp/add-bound-constraints") (skill optimization) (module ilp) (tier 1) (difficulty 12829) (name add-bound-constraints) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp make-binary-ilp make-ilp-optimal make-ilp-infeasible make-ilp-unbounded ilp-optimal? ilp-infeasible? ilp-unbounded? ilp-result-x ilp-result-z is-integer? solution-is-integer? find-fractional-var round-solution make-bb-node bb-node-lp bb-node-lb bb-node-ub)) (answer "(define (add-bound-constraints lp lb ub) (let* ((c (lp-c lp)) (A (lp-A lp)) (b (lp-b lp)) (m (matrix-rows A)) (n (vector-length c)) (bound-rows '()) (bound-rhs '()) (slack-count 0)) (do ((i 0 (+ i 1))) ((= i n)) (let ((li (vector-ref lb i)) (ui (vector-ref ub i))) (when (> li -inf.0) (let ((row (make-vector n 0))) (vector-set! row i 1) (set! bound-rows (cons (cons row -1) bound-rows)) (set! bound-rhs (cons li bound-rhs)) (set! slack-count (+ slack-count 1)))) (when (< ui +inf.0) (let ((row (make-vector n 0))) (vector-set! row i 1) (set! bound-rows (cons (cons row 1) bound-rows)) (set! bound-rhs (cons ui bound-rhs)) (set! slack-count (+ slack-count 1)))))) (if (= slack-count 0) lp (let* ((num-bounds (length bound-rows)) (new-m (+ m num-bounds)) (new-n (+ n slack-count)) (new-A (make-matrix new-m new-n 0)) (new-b (make-vector new-m 0)) (new-c (vec-append c (vec-zeros slack-count)))) (do ((i 0 (+ i 1))) ((= i m)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! new-A i j (matrix-ref A i j))) (vector-set! new-b i (vector-ref b i))) (let loop ((rows (reverse bound-rows)) (rhs (reverse bound-rhs)) (row-idx m) (slack-idx n)) (when (not (null? rows)) (let* ((row-data (car rows)) (row (car row-data)) (slack-sign (cdr row-data))) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! new-A row-idx j (vector-ref row j))) (matrix-set! new-A row-idx slack-idx slack-sign) (vector-set! new-b row-idx (car rhs)) (loop (cdr rows) (cdr rhs) (+ row-idx 1) (+ slack-idx 1))))) (make-lp new-c new-A new-b)))))"))
