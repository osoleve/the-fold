(task-entry (id "game-theory/coop-games/coalition->list") (skill game-theory) (module coop-games) (tier 1) (difficulty 13208) (name coalition->list) (type "(-> Coalition (List Nat))") (description "Convert coalition to list of player indices") (notes ()) (section coalition-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size)) (answer "(define (coalition->list S) (let loop ((S S) (i 0) (acc '())) (if (= S 0) (reverse acc) (loop (bitwise-arithmetic-shift-right S 1) (+ i 1) (if (= 1 (bitwise-and S 1)) (cons i acc) acc)))))"))
