(task-entry (id "fp/simplify/find-and-remove") (skill fp) (module simplify) (tier 1) (difficulty 10617) (name find-and-remove) (type "(-> Expr (List Expr) (Maybe (List Expr)))") (description "Find expr in list and return list with it removed") (notes ()) (section quotient-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors)) (answer "(define (find-and-remove expr lst) (let loop ((rest lst) (acc '())) (cond ((null? rest) #f) ((expr=? (car rest) expr) (append (reverse acc) (cdr rest))) (else (loop (cdr rest) (cons (car rest) acc))))))"))
(task-entry (id "fp/integrate/integrate-by-parts") (skill fp) (module integrate) (tier 1) (difficulty 10617) (name integrate-by-parts) (type "(-> Expr Symbol Nat (Maybe Expr))") (description "Try integration by parts: ∫u dv = uv - ∫v du") (notes ()) (section integration-by-parts) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic integrate-product integrate-power integrate-quotient integrate-by-substitution try-substitution-pattern find-antiderivative-match find-u-candidates substitute-u can-express-in-u? replace-with-u try-trig-substitution)) (answer "(define (integrate-by-parts expr var-sym depth) (if (not (product? expr)) #f (let ((factors (product-factors expr))) (if (< (length factors) 2) #f (let* ((sorted-factors (sort-by-liate factors)) (u (car sorted-factors)) (dv (fold-left product (num 1) (cdr sorted-factors)))) (try-parts u dv var-sym depth))))))"))
(task-entry (id "fp/solve/solve-linear") (skill fp) (module solve) (tier 1) (difficulty 10617) (name solve-linear) (type "(-> Expr Symbol (Maybe Expr))") (description "Solve linear equation ax + b = 0 for x") (notes ("Returns x = -b/a, or #f if not solvable")) (section linear-solving) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree extract-coeff-impl extract-product-coeff make-sum-from-terms make-product-from-terms)) (answer "(define (solve-linear expr var-sym) (let-values (((a b) (collect-linear-coeffs expr var-sym))) (cond ((and (num? a) (= (num-val a) 0)) (if (and (num? b) (= (num-val b) 0)) 'infinite #f)) (else (simplify (division (make-neg b) a))))))"))
(task-entry (id "fp/poly-canonical/expr-poly-lcm") (skill fp) (module poly-canonical) (tier 1) (difficulty 10617) (name expr-poly-lcm) (type "") (description "") (notes ()) (section partial-fractions) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial polynomial-expr? expr-degree extract-poly-coeffs extract-coeff-at extract-coeff-expanded extract-coeff-product expr-eval-at-zero polynomial->expr make-term simplify-rational partial-fractions partial-fractions-linear poly-divide-expr to-polynomial-form expr-poly-gcd)) (answer "(define (expr-poly-lcm expr1 expr2 var-sym) (let* ((poly1 (expr->polynomial expr1 var-sym Q-field-sym)) (poly2 (expr->polynomial expr2 var-sym Q-field-sym))) (if (or (not poly1) (not poly2)) (product expr1 expr2) (polynomial->expr (poly-lcm poly1 poly2) var-sym))))"))
