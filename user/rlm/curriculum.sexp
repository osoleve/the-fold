(task-entry (id "data/graph-layout/layout-from-adjacency") (skill data) (module graph-layout) (tier 0) (difficulty 1335) (name layout-from-adjacency) (type "") (description "") (notes ()) (section constructors) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens graph-nodes-each graph-all-positions graph-all-velocities *repulsion-constant* *attraction-constant* *gravity-constant* *damping* *min-distance* *max-displacement* calculate-repulsion calculate-attraction layout-step node-index run-layout layout-bounds normalize-layout hierarchical-layout)) (answer "(define (layout-from-adjacency adj-list) (let* ((node-ids (map car adj-list)) (edges (append-map (lambda (entry) (let ((from (car entry)) (tos (cdr entry))) (map (lambda (to) (cons from to)) tos))) adj-list))) (make-layout-graph node-ids edges)))"))
