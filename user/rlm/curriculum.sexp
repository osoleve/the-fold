(task-entry (id "diffgeo/forms/pullback-k-form") (skill diffgeo) (module forms) (tier 1) (difficulty 10739) (name pullback-k-form) (type "") (description "") (notes ()) (section pullback-forms) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices count-inversions-to-sort k-form? k-form-point k-form-chart k-form-degree k-form-components k-form-dim make-k-form k-form-zero k-form-basis cotangent->1-form \x31;-form->cotangent k-form-add k-form-sub k-form-scale k-form-negate k-form-change-chart wedge wedge* interior-product remove-at exterior-derivative insert-sorted insertion-sign d-scalar k-form-apply matrix-det-small)) (answer "(define (pullback-k-form f kf source-point source-chart target-chart . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *jacobian-epsilon* (car epsilon-arg))) (k (k-form-degree kf))) (if (= k 0) (make-k-form source-point source-chart 0 (k-form-components kf)) (let* ((n-source (chart-dim source-chart)) (n-target (chart-dim target-chart)) (source-coords (chart-apply source-chart source-point)) (J (jacobian-numerical f source-coords eps)) (kf-comps (k-form-components kf))) (if (> k n-source) (k-form-zero source-point source-chart k) (let* ((indices-k-source (generate-multi-indices n-source k)) (indices-k-target (generate-multi-indices n-target k)) (num-source (binomial n-source k)) (result (make-vector num-source 0))) (for-each (lambda (idx-I) (let ((offset-I (multi-index->offset n-source idx-I)) (sum 0)) (for-each (lambda (idx-J) (let ((omega-J (vector-ref kf-comps (multi-index->offset n-target idx-J)))) (when (not (= omega-J 0)) (let ((submat (make-matrix k k 0))) (do ((row 0 (+ row 1))) ((= row k)) (let ((j (list-ref idx-J row))) (do ((col 0 (+ col 1))) ((= col k)) (let ((i (list-ref idx-I col))) (matrix-set! submat row col (matrix-ref J j i)))))) (let ((det (matrix-det-small submat))) (set! sum (+ sum (* omega-J det)))))))) indices-k-target) (vector-set! result offset-I sum))) indices-k-source) (make-k-form source-point source-chart k result)))))))"))
