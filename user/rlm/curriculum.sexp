(task-entry (id "control-systems/stability/ss-marginally-stable?") (skill control-systems) (module stability) (tier 2) (difficulty 22603) (name ss-marginally-stable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable?)) (answer "(define (ss-marginally-stable? sys) (let ((poles (ss-poles sys))) (and (all? (lambda (p) (<= (complex-real p) 0)) poles) (any? (lambda (p) (< (abs (complex-real p)) 1e-10)) poles))))"))
(task-entry (id "control-systems/controller-design/pid-design-imc") (skill control-systems) (module controller-design) (tier 2) (difficulty 22603) (name pid-design-imc) (type "TF × Number → (Kp Ki Kd)") (description "Internal Model Control (IMC) based PID tuning. Works for first-order plus dead time (FOPDT) models") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop)) (answer "(define (pid-design-imc plant lambda) (let* ((poles (tf-poles plant)) (zeros (tf-zeros plant)) (K (tf-dc-gain plant)) (tau (if (null? poles) 1.0 (- (/ 1 (complex-real (car poles))))))) (if (eq? K 'infinite) '(error integrating-process) (let* ((Kp (/ tau (* K lambda))) (Ki (/ Kp tau)) (Kd 0)) (list Kp Ki Kd)))))"))
