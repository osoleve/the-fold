(task-entry (id "autodiff/interval-autodiff/iv-traced-sub") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12715) (name iv-traced-sub) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add)) (answer "(define (iv-traced-sub a b) (let* ((av (interval-traced-value a)) (bv (interval-traced-value b)) (result (interval-sub av bv)) (tape (or (and (interval-traced? a) (interval-traced-tape a)) (and (interval-traced? b) (interval-traced-tape b))))) (if tape (interval-traced-op 'sub result (list a b) (list (interval-singleton 1) (interval-singleton -1)) tape) result)))"))
