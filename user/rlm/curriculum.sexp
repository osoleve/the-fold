(task-entry (id "autodiff/differentiable-signal/dft-vjp-real") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12704) (name dft-vjp-real) (type "(-> (Vector Number) (Vector Number))") (description "") (notes ()) (section dft-vjp) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp)) (answer "(define (dft-vjp-real output-grad) (let* ((grad (dft-vjp output-grad)) (n (vector-length grad)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (complex-real (vector-ref grad i))))))"))
