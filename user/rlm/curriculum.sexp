(task-entry (id "game-theory/voting-games/decisive-for-candidate") (skill game-theory) (module voting-games) (tier 1) (difficulty 13217) (name decisive-for-candidate) (type "(-> PreferenceProfile (Profile -> Candidate) Candidate (List Coalition))") (description "Find coalitions that can guarantee candidate c wins by voting strategically") (notes ()) (section strategic-implications) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate? shapley-shubik-index shapley-shubik-weighted banzhaf-voting-power banzhaf-weighted voter-is-dictator? voter-is-dummy? voter-has-veto? minimal-winning-coalitions is-minimal-winning? voting-power-comparison power-concentration power-gini)) (answer "(define (decisive-for-candidate profile voting-rule candidate) (let* ((n (profile-voters profile)) (candidates (profile-candidates profile)) (others (remove candidate candidates)) (strategic-vote (cons candidate others)) (grand (- (expt 2 n) 1))) (filter (lambda (S) (let* ((members (coalition->list S)) (modified (map-indexed (lambda (ranking i) (if (member i members) strategic-vote ranking)) profile)) (winner (voting-rule modified))) (eq? winner candidate))) (map (lambda (i) i) (iota (+ grand 1))))))"))
