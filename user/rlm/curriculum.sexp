(task-entry (id "fp/cost-analysis/parallel-beneficial-n?") (skill fp) (module cost-analysis) (tier 1) (difficulty 10620) (name parallel-beneficial-n?) (type "(-> (List Expr) Bool)") (description "Determine if parallelizing a list of expressions is worthwhile.") (notes ()) (section parallelization-decision) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost *form-costs* form-cost *estimate-work-fuel* estimate-work estimate-work-with-fuel estimate-let-work estimate-branch-work estimate-cond-work estimate-hof-work estimate-list-size parallel-beneficial?)) (answer "(define (parallel-beneficial-n? exprs) (let* ((works (map estimate-work exprs)) (total-work (fold-left + 0 works)) (n (length exprs)) (overhead (* n *parallel-overhead*)) (min-per-task (quotient *min-parallel-work* 2))) (and (> total-work *min-parallel-work*) (>= n 2) (andmap (lambda (w) (> w min-per-task)) works))))"))
(task-entry (id "fp/engine/all-children") (skill fp) (module engine) (tier 1) (difficulty 10620) (name all-children) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;rule \x27;trace \x27;rewrite/sexp-zipper)) (available (check-constraint match-pattern match-metavar substitute-template apply-rule apply-rule-name expr-at expr-set-at apply-rule-at find-all-positions apply-rule-anywhere id-strategy fail-strategy seq choice try *max-rewrite-fuel* repeat repeat-n map-children)) (answer "(define (all-children s expr) (if (pair? expr) (let loop ((lst expr) (acc '())) (if (null? lst) (reverse acc) (let ((result (s (car lst)))) (if result (loop (cdr lst) (cons result acc)) #f)))) expr))"))
