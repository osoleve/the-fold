(task-entry (id "data/avl-tree/rotate-left") (skill data) (module avl-tree) (tier 0) (difficulty 1311) (name rotate-left) (type "(-> AVL AVL)") (description "Left rotation for right-heavy trees") (notes ()) (section smart-constructor-and-rotations) (deps (\x27;prelude)) (available (avl-empty avl-empty? avl-node avl-node? avl-height avl-key avl-value avl-left avl-right avl-balance-factor make-avl-node)) (answer "(define (rotate-left tree) (let ((x-key (avl-key tree)) (x-val (avl-value tree)) (a (avl-left tree)) (y (avl-right tree))) (let ((y-key (avl-key y)) (y-val (avl-value y)) (b (avl-left y)) (c (avl-right y))) (make-avl-node y-key y-val (make-avl-node x-key x-val a b) c))))"))
(task-entry (id "data/sort/insert-sorted") (skill data) (module sort) (tier 0) (difficulty 1311) (name insert-sorted) (type "(-> (-> α α Boolean) α (List α) (List α))") (description "Insert element into sorted list maintaining order") (notes ()) (section insertion-sort) (deps (\x27;prelude)) (available (merge split-at merge-sort-by merge-sort sort sort-by stable-sort stable-sort-by partition quicksort-by quicksort)) (answer "(define (insert-sorted cmp x sorted) (cond ((null? sorted) (list x)) ((cmp x (car sorted)) (cons x sorted)) (else (cons (car sorted) (insert-sorted cmp x (cdr sorted))))))"))
(task-entry (id "data/heap/heap-min") (skill data) (module heap) (tier 0) (difficulty 1311) (name heap-min) (type "(-> Heap α)") (description "Get minimum element without removing. Error if heap is empty.") (notes ("O(1)")) (section min-heap-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge heap-insert)) (answer "(define (heap-min heap) (if (heap-empty? heap) (error 'heap-min \"Cannot get min of empty heap\") (heap-value heap)))"))
(task-entry (id "data/set/list->set") (skill data) (module set) (tier 0) (difficulty 1311) (name list->set) (type "(-> (List α) Set)") (description "Convert list to set (removes duplicates)") (notes ()) (section none) (deps (\x27;prelude)) (available (set-empty set-empty? set-member? set-add set-remove set-union set-intersection set-difference set-subset? set-size set->list)) (answer "(define (list->set lst) (let loop ((remaining lst) (acc set-empty)) (if (null? remaining) acc (loop (cdr remaining) (set-add (car remaining) acc)))))"))
(task-entry (id "data/dict/dict-filter") (skill data) (module dict) (tier 0) (difficulty 1311) (name dict-filter) (type "(-> (-> κ ν Boolean) Dict Dict)") (description "Filter dictionary by predicate on key-value pairs") (notes ()) (section none) (deps (\x27;prelude)) (available (dict-empty dict-empty? dict-lookup dict-has-key? dict-assoc dict-dissoc dict-keys dict-values dict-entries dict-merge dict-map-values)) (answer "(define (dict-filter pred dict) (let loop ((remaining dict) (acc '())) (cond ((null? remaining) (reverse acc)) ((pred (car (car remaining)) (cdr (car remaining))) (loop (cdr remaining) (cons (car remaining) acc))) (else (loop (cdr remaining) acc)))))"))
(task-entry (id "data/collection-utils/collection-all?") (skill data) (module collection-utils) (tier 0) (difficulty 1311) (name collection-all?) (type "(-> FSCap (-> Block Boolean) Block Boolean)") (description "Check if all members satisfy predicate. Missing blocks are skipped for consistency with other collection functions") (notes ()) (section collection-queries) (deps (\x27;block \x27;sha256)) (available (foldr collection-hashes collection-size collection-empty? map-collection filter-collection fold-collection foldr-collection for-each-collection collection-find collection-any?)) (answer "(define (collection-all? fs predicate collection) (let ((hashes (collection-hashes collection))) (let loop ((hashes hashes)) (if (null? hashes) #t (let ((block (fs-fetch fs (car hashes)))) (if block (if (predicate block) (loop (cdr hashes)) #f) (loop (cdr hashes))))))))"))
