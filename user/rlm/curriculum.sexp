(task-entry (id "numeric/affine/affine-radius") (skill numeric) (module affine) (tier 0) (difficulty 2511) (name affine-radius) (type "") (description "") (notes ()) (section affine-type) (deps (\x27;prelude \x27;sort \x27;interval)) (available (*affine-next-noise-id* affine-fresh-noise-id! affine-reset-noise-counter! make-affine affine? affine-center affine-terms affine-constant affine-noise affine-from-interval affine->interval)) (answer "(define (affine-radius af) (fold-left + 0 (map (lambda (t) (abs (cdr t))) (affine-terms af))))"))
(task-entry (id "numeric/fem/element-stiffness") (skill numeric) (module fem) (tier 0) (difficulty 2511) (name element-stiffness) (type "") (description "") (notes ()) (section element-matrices) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers \x27;mesh-gen)) (available (make-fem-mesh fem-mesh? fem-mesh-nodes fem-mesh-elements fem-mesh-num-nodes fem-mesh-num-elements fem-mesh-node fem-mesh-element fem-mesh-element-nodes element-area basis-gradients)) (answer "(define (element-stiffness p1 p2 p3) (let* ((area (abs (element-area p1 p2 p3))) (grads (basis-gradients p1 p2 p3)) (g1 (list-ref grads 0)) (g2 (list-ref grads 1)) (g3 (list-ref grads 2))) (define (dot g-a g-b) (+ (* (vector-ref g-a 0) (vector-ref g-b 0)) (* (vector-ref g-a 1) (vector-ref g-b 1)))) (matrix-from-lists (list (list (* area (dot g1 g1)) (* area (dot g1 g2)) (* area (dot g1 g3))) (list (* area (dot g2 g1)) (* area (dot g2 g2)) (* area (dot g2 g3))) (list (* area (dot g3 g1)) (* area (dot g3 g2)) (* area (dot g3 g3)))))))"))
(task-entry (id "numeric/pde-time/backward-euler-identity-step") (skill numeric) (module pde-time) (tier 0) (difficulty 2511) (name backward-euler-identity-step) (type "") (description "") (notes ()) (section backward-euler) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step)) (answer "(define (backward-euler-identity-step A u b dt tol max-iter) (let* ((n (sparse-csr-rows A)) (LHS (sparse-csr-add (sparse-csr-identity n) (sparse-csr-scale (- dt) A))) (RHS (pde-vec-madd u dt b)) (result (sparse-cg-solve LHS RHS u tol max-iter))) (values (car result) (cadr result) (caddr result))))"))
