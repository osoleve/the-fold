ion-list dsl-program-depth dsl-uses-tag? dsl-tag-histogram dsl-optimize-dead-code dsl-fuse dsl-fix dsl-lazy make-bounce make-done bounce? done? bounce-thunk done-value run-trampoline run-dsl-trampolined run-dsl-trampoline-helper make-mock-interpreter dsl-test-case dsl-test-error dsl-programs-equiv? dsl-interpreter-equiv? make-recording-interpreter verify-instruction-sequence calc-push! calc-add! calc-sub! calc-mul! calc-div! calc-dup! calc-swap! calc-pop!)) (answer "(define (make-calc-interpreter) (let ((stack '())) (make-interpreter (lambda (tag payload) (case tag ((calc-push) (set! stack (cons payload stack)) '()) ((calc-add) (let ((a (car stack)) (b (cadr stack))) (set! stack (cons (+ b a) (cddr stack))) '())) ((calc-sub) (let ((a (car stack)) (b (cadr stack))) (set! stack (cons (- b a) (cddr stack))) '())) ((calc-mul) (let ((a (car stack)) (b (cadr stack))) (set! stack (cons (* b a) (cddr stack))) '())) ((calc-div) (let ((a (car stack)) (b (cadr stack))) (set! stack (cons (/ b a) (cddr stack))) '())) ((calc-dup) (set! stack (cons (car stack) stack)) '()) ((calc-swap) (let ((a (car stack)) (b (cadr stack))) (set! stack (cons b (cons a (cddr stack)))) '())) ((calc-pop) (let ((top (car stack))) (set! stack (cdr stack)) top)) (else (error 'calc-interpreter \"Unknown instruction\" tag)))))))"))
(task-entry (id "diffgeo/lie-groups/matrix-to-se3") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10763) (name matrix-to-se3) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp so2-log so3? so3-matrix make-so3-from-matrix make-so3 so3-identity so3-compose so3-inverse so3-act so3-alg? so3-alg-vec make-so3-alg so3-hat so3-vee so3-alg-to-matrix so3-matrix-to-alg so3-exp so3-log so3-axis-angle se2? se2-rotation se2-translation make-se2 make-se2-from-angle se2-identity se2-to-matrix matrix-to-se2 se2-compose se2-inverse se2-act se2-alg? se2-alg-omega se2-alg-v make-se2-alg se2-alg-to-matrix se2-exp se2-log se3? se3-rotation se3-translation make-se3 se3-identity se3-to-matrix)) (answer "(define (matrix-to-se3 m) (if (not (and (= (matrix-rows m) 4) (= (matrix-cols m) 4))) (quasiquote (error invalid-dimension)) (let* ((R (make-matrix 3 3 0)) (t (make-vector 3 0))) (do ((i 0 (+ i 1))) ((= i 3)) (do ((j 0 (+ j 1))) ((= j 3)) (matrix-set! R i j (matrix-ref m i j)))) (do ((i 0 (+ i 1))) ((= i 3)) (vector-set! t i (matrix-ref m i 3))) (make-se3 (list 'so3 R) t))))"))
