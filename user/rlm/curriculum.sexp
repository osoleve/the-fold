(task-entry (id "autodiff/typed-gradients/dim-jacobian?") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12714) (name dim-jacobian?) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian)) (answer "(define (dim-jacobian? x) (and (pair? x) (eq? (car x) 'dim-jacobian)))"))
