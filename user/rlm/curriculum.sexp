(task-entry (id "data/centrality/betweenness-centrality") (skill data) (module centrality) (tier 0) (difficulty 1316) (name betweenness-centrality) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality standard-closeness-node harmonic-closeness-node closeness-centrality-from-adj closeness-centrality-from-edges)) (answer "(define (betweenness-centrality adj) (let* ((n (matrix-rows adj)) (cb (make-vector n 0.0))) (do ((s 0 (+ s 1))) ((= s n)) (betweenness-from-source adj s cb n)) (let ((norm (if (> n 2) (* 2.0 (- n 1) (- n 2)) 1.0))) (do ((i 0 (+ i 1))) ((= i n) cb) (vector-set! cb i (/ (vector-ref cb i) norm))))))"))
