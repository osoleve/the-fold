(task-entry (id "optics/format-iso/string->sexpr") (skill optics) (module format-iso) (tier 1) (difficulty 11003) (name string->sexpr) (type "(-> String Any)") (description "Parse string as S-expression.") (notes ()) (section sexpr) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt)) (answer "(define (string->sexpr str) (let* ((port (open-input-string str)) (result (read port))) (if (eof-object? (read port)) result (error 'string->sexpr \"Trailing data in input\"))))"))
(task-entry (id "optics/schema/field-transform-iso") (skill optics) (module schema) (tier 1) (difficulty 11003) (name field-transform-iso) (type "(-> Symbol PIso (PIso Alist Alist))") (description "Create an iso that transforms a specific field's value. The value-iso transforms the field value bidirectionally") (notes ("Errors if field is not present. Use field-transform-if-present-iso for optional fields")) (section field-transform) (deps (\x27;profunctor-optics)) (available (field-rename-iso field-add-iso field-remove-iso)) (answer "(define (field-transform-iso field value-iso) (make-p-iso (lambda (alist) (unless (assq field alist) (error 'field-transform-iso \"field not found\" field)) (map (lambda (pair) (if (eq? (car pair) field) (cons field ((p-iso-forward value-iso) (cdr pair))) pair)) alist)) (lambda (alist) (unless (assq field alist) (error 'field-transform-iso \"field not found\" field)) (map (lambda (pair) (if (eq? (car pair) field) (cons field ((p-iso-backward value-iso) (cdr pair))) pair)) alist))))"))
(task-entry (id "optics/block-migration/block-migration-to-tag") (skill optics) (module block-migration) (tier 1) (difficulty 11003) (name block-migration-to-tag) (type "(-> BlockMigration Symbol)") (description "") (notes ()) (section block-migration-type) (deps (\x27;block \x27;bidirectional \x27;format-iso)) (available (make-block-migration block-migration? block-migration-from-tag)) (answer "(define (block-migration-to-tag bm) (caddr bm))"))
(task-entry (id "optics/optics/iso-view") (skill optics) (module optics) (tier 1) (difficulty 11004) (name iso-view) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward)) (answer "(define (iso-view iso s) ((iso-forward iso) s))"))
(task-entry (id "optics/block-optics/block-refs-each") (skill optics) (module block-optics) (tier 1) (difficulty 11004) (name block-refs-each) (type "") (description "") (notes ()) (section ref-access) (deps (\x27;block \x27;optics)) (available (block-tag-lens block-payload-lens block-refs-lens block-ref-at)) (answer "(define block-refs-each (make-traversal (lambda (f blk) (let* ((refs (block-refs blk)) (len (vector-length refs)) (new-refs (make-vector len))) (do ((i 0 (+ i 1))) ((= i len)) (vector-set! new-refs i (f (vector-ref refs i)))) (make-block (block-tag blk) (block-payload blk) new-refs))) (lambda (blk) (vector->list (block-refs blk)))))"))
