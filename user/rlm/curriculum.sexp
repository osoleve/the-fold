(task-entry (id "linalg/quaternion/quat-identity?") (skill linalg) (module quaternion) (tier 0) (difficulty 409) (name quat-identity?) (type "") (description "") (notes ()) (section quaternion-construction) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at quat?)) (answer "(define (quat-identity? q) (and (< (abs (- (quat-w q) 1.0)) 1e-10) (< (abs (quat-x q)) 1e-10) (< (abs (quat-y q)) 1e-10) (< (abs (quat-z q)) 1e-10)))"))
(task-entry (id "linalg/matrix/matrix-row") (skill linalg) (module matrix) (tier 0) (difficulty 409) (name matrix-row) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref)) (answer "(define (matrix-row m i) (let ((rows (matrix-rows m)) (cols (matrix-cols m)) (data (matrix-data m))) (if (and (>= i 0) (< i rows)) (let ((result (make-vector cols 0)) (start (* i cols))) (do ((j 0 (+ j 1))) ((= j cols) result) (vector-set! result j (vector-ref data (+ start j))))) (quasiquote (error out-of-bounds (unquote i) (unquote rows))))))"))
(task-entry (id "linalg/matrix-decomp/matrix-cholesky") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 409) (name matrix-cholesky) (type "") (description "Cholesky decomposition. Returns (list L) where A = L x L^T for positive-definite A.") (notes ()) (section cholesky-decomposition) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance* matrix-copy matrix-set! matrix-column matrix-lu matrix-lu-solve qr-find-orthogonal-basis qr-orthogonalize-remaining! matrix-qr)) (answer "(define (matrix-cholesky a) (let ((n (matrix-rows a))) (if (not (= n (matrix-cols a))) (quasiquote (error not-square (unquote (matrix-rows a)) (unquote (matrix-cols a)))) (let ((l (make-matrix n n 0))) (let row-loop ((i 0)) (if (= i n) (list l) (let col-loop ((j 0)) (if (> j i) (row-loop (+ i 1)) (let ((sum (let k-loop ((k 0) (s 0)) (if (= k j) s (k-loop (+ k 1) (+ s (* (matrix-ref l i k) (matrix-ref l j k)))))))) (cond ((= i j) (let ((val (- (matrix-ref a i i) sum))) (if (<= val 0) (quasiquote (error not-positive-definite (unquote i) (unquote val))) (begin (matrix-set! l i i (sqrt val)) (col-loop (+ j 1)))))) (else (matrix-set! l i j (/ (- (matrix-ref a i j) sum) (matrix-ref l j j))) (col-loop (+ j 1)))))))))))))"))
(task-entry (id "linalg/matrix-solvers/matrix-condition-number") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 409) (name matrix-condition-number) (type "") (description "") (notes ()) (section least-squares) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute matrix-back-substitute matrix-solve matrix-inverse permutation-parity matrix-determinant matrix-least-squares matrix-gauss-elim matrix-rank)) (answer "(define (matrix-condition-number a) (let ((inv (matrix-inverse a))) (if (and (pair? inv) (eq? (car inv) 'error)) inv (* (frobenius-norm a) (frobenius-norm inv)))))"))
(task-entry (id "linalg/matrix-eigen/qr-iterate-once") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 409) (name qr-iterate-once) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop)) (answer "(define (qr-iterate-once a active-size iter max-iter tol full-n) (let* ((shift (wilkinson-shift a active-size)) (a-shifted (matrix-sub a (matrix-scale shift (matrix-identity full-n)))) (qr-result (matrix-qr a-shifted))) (if (and (pair? qr-result) (eq? (car qr-result) 'error)) (qr-algorithm-loop a iter max-iter tol) (let* ((q (car qr-result)) (r (cadr qr-result)) (rq (matrix-mul r q)) (a-new (matrix-add rq (matrix-scale shift (matrix-identity full-n))))) (qr-algorithm-shifted-loop a-new active-size (+ iter 1) max-iter tol)))))"))
(task-entry (id "linalg/iterative-solvers/sor-loop") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 409) (name sor-loop) (type "") (description "") (notes ()) (section sor) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor)) (answer "(define (sor-loop a b omega x iter max-iter tol n) (let ((res (residual a x b))) (cond ((converged? res tol) (list x iter res)) ((>= iter max-iter) (quasiquote (error no-convergence (unquote iter) (unquote res)))) (else (do ((i 0 (+ i 1))) ((= i n)) (let ((a-ii (matrix-ref a i i))) (when (>= (abs a-ii) *iterative-tolerance*) (let* ((x-old (vector-ref x i)) (sum (let loop ((j 0) (s 0.0)) (if (= j n) s (if (= j i) (loop (+ j 1) s) (loop (+ j 1) (+ s (* (matrix-ref a i j) (vector-ref x j)))))))) (x-gs (/ (- (vector-ref b i) sum) a-ii)) (x-new (+ (* (- 1 omega) x-old) (* omega x-gs)))) (vector-set! x i x-new))))) (sor-loop a b omega x (+ iter 1) max-iter tol n)))))"))
(task-entry (id "linalg/sparse/sparse-coo-from-triplets") (skill linalg) (module sparse) (tier 0) (difficulty 409) (name sparse-coo-from-triplets) (type "") (description "") (notes ()) (section coo-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz)) (answer "(define (sparse-coo-from-triplets rows cols triplets) (let* ((n (length triplets)) (row-idx (make-vector n 0)) (col-idx (make-vector n 0)) (vals (make-vector n 0))) (do ((i 0 (+ i 1)) (ts triplets (cdr ts))) ((= i n) (make-sparse-coo rows cols row-idx col-idx vals)) (let ((t (car ts))) (vector-set! row-idx i (car t)) (vector-set! col-idx i (cadr t)) (vector-set! vals i (caddr t))))))"))
(task-entry (id "linalg/graph-laplacian/extract-induced-subgraph") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 409) (name extract-induced-subgraph) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition)) (answer "(define (extract-induced-subgraph adj nodes) (let* ((n (length nodes)) (node-vec (list->vector nodes)) (result (make-matrix n n 0))) (do ((new-i 0 (+ new-i 1))) ((= new-i n) result) (let ((orig-i (vector-ref node-vec new-i))) (do ((new-j 0 (+ new-j 1))) ((= new-j n)) (let ((orig-j (vector-ref node-vec new-j))) (matrix-set! result new-i new-j (matrix-ref adj orig-i orig-j))))))))"))
(task-entry (id "linalg/svd/complete-orthogonal-basis!") (skill linalg) (module svd) (tier 0) (difficulty 409) (name complete-orthogonal-basis!) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu)) (answer "(define (complete-orthogonal-basis! mat filled n) (let loop ((col filled)) (when (< col n) (let ((new-col (find-orthogonal-vector mat col n))) (when new-col (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! mat i col (vector-ref new-col i))))) (loop (+ col 1)))))"))
