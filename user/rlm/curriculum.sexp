(task-entry (id "tiles/core/make-tile") (skill tiles) (module core) (tier 1) (difficulty 12305) (name make-tile) (type "(-> Symbol Alist Tile)") (description "Default tile implementation: just a symbol or data structure") (notes ()) (section tile-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash)) (answer "(define (make-tile type data) (cons type data))"))
(task-entry (id "tiles/square/square-neighbors-diag") (skill tiles) (module square) (tier 1) (difficulty 12305) (name square-neighbors-diag) (type "(-> Coord (List Coord))") (description "Get 4 diagonal neighbors (bishop moves in chess)") (notes ()) (section neighbor-calculations) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho)) (answer "(define (square-neighbors-diag coord) (map (lambda (dir) (square-neighbor coord dir)) '(ne se sw nw)))"))
(task-entry (id "tiles/hex/axial->offset") (skill tiles) (module hex) (tier 1) (difficulty 12305) (name axial->offset) (type "(-> AxialCoord OffsetCoord)") (description "odd-r offset") (notes ()) (section coordinate-conversions) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial)) (answer "(define (axial->offset ac) (let* ((q (coord-x ac)) (r (coord-y ac)) (col (+ q (quotient (+ r (bitwise-and r 1)) 2))) (row r)) (offset-coord col row)))"))
(task-entry (id "tiles/triangle/triangle-coord-hash") (skill tiles) (module triangle) (tier 1) (difficulty 12305) (name triangle-coord-hash) (type "") (description "") (notes ()) (section coordinates) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal?)) (answer "(define (triangle-coord-hash t) (+ (* (triangle-row t) 1000000) (* (triangle-col t) 1000) (if (eq? (triangle-orientation t) 'up) 0 1)))"))
(task-entry (id "tiles/pathfinding/bfs-path") (skill tiles) (module pathfinding) (tier 1) (difficulty 12305) (name bfs-path) (type "(-> Coord Coord (-> Coord (List Coord)) (-> Coord Bool) (Maybe (List Coord)))") (description "Find shortest path using BFS (unweighted)") (notes ()) (section bfs) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert pqueue-pop reconstruct-path)) (answer "(define (bfs-path start goal neighbor-fn walkable-fn) (let ((queue (list start)) (visited (make-hashtable equal-hash equal?)) (came-from (make-hashtable equal-hash equal?))) (hashtable-set! visited start #t) (let loop ((q queue)) (if (null? q) #f (let ((current (car q)) (rest-q (cdr q))) (if (equal? current goal) (reconstruct-path came-from start goal) (let* ((neighbors (neighbor-fn current)) (valid-neighbors (filter (lambda (n) (and (walkable-fn n) (not (hashtable-ref visited n #f)))) neighbors))) (for-each (lambda (n) (hashtable-set! visited n #t) (hashtable-set! came-from n current)) valid-neighbors) (loop (append rest-q valid-neighbors)))))))))"))
(task-entry (id "tiles/visibility/visible-enemies") (skill tiles) (module visibility) (tier 1) (difficulty 12305) (name visible-enemies) (type "(-> Board Coord Integer (-> Coord (List Coord)) (-> Coord Coord (List Coord)) (-> Coord Bool) (List Coord))") (description "Get all enemy positions visible from origin") (notes ()) (section utilities) (deps (\x27;tiles/core)) (available (has-line-of-sight? board-has-los? calculate-fov board-fov shadowcast-fov)) (answer "(define (visible-enemies board origin max-radius neighbor-fn line-fn is-enemy-fn) (let ((visible-tiles (board-fov board origin max-radius neighbor-fn line-fn))) (filter is-enemy-fn visible-tiles)))"))
(task-entry (id "tiles/units/game-place-unit") (skill tiles) (module units) (tier 1) (difficulty 12305) (name game-place-unit) (type "(-> GameState Unit Coord GameState)") (description "Place unit at coordinate. Removes unit from old position if it exists.") (notes ()) (section game-state) (deps (\x27;tiles/core)) (available (make-unit unit-get-prop unit-set-prop make-game-state game-board)) (answer "(define (game-place-unit gs unit coord) (let ((c->u (hashtable-copy (game-state%-coord->unit gs) #t)) (u->c (hashtable-copy (game-state%-unit->coord gs) #t))) (let ((old-coord (hashtable-ref u->c (unit%-id unit) #f))) (when old-coord (hashtable-delete! c->u old-coord))) (hashtable-set! c->u coord unit) (hashtable-set! u->c (unit%-id unit) coord) (make-game-state% (game-state%-board gs) c->u u->c)))"))
(task-entry (id "tiles/turns/turn-actions-remaining") (skill tiles) (module turns) (tier 1) (difficulty 12305) (name turn-actions-remaining) (type "") (description "") (notes ()) (section queries) (deps (\x27;sort)) (available (make-turn-state make-turn-state-from-game turn-current-unit turn-current-phase turn-number)) (answer "(define (turn-actions-remaining ts unit-id) (hashtable-ref (turn-state%-action-points ts) unit-id 0))"))
(task-entry (id "tiles/render/render-board") (skill tiles) (module render) (tier 1) (difficulty 12305) (name render-board) (type "(-> Board (-> Tile String) String)") (description "Render board using default style. Dispatches to shape-specific renderer.") (notes ()) (section high-level) (deps (\x27;tiles/core)) (available (default-tile-char render-square-board render-square-board-with-overlay render-hex-board render-hex-board-with-overlay)) (answer "(define (render-board board style-fn) (let ((shape (board%-shape board)) (meta (board%-meta board))) (case shape ((square) (render-square-board board meta style-fn)) ((hex hexagonal) (render-hex-board board meta style-fn)) (else (error 'render-board \"Unsupported shape\" shape)))))"))
(task-entry (id "tiles/topology-analysis/collect-edges") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12305) (name collect-edges) (type "") (description "Collect all edges between adjacent walkable tiles") (notes ()) (section board-to-complex) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord)) (answer "(define (collect-edges coords walkable-set neighbor-fn) (let ((edges '()) (seen (make-hashtable equal-hash equal?))) (for-each (lambda (c) (let ((v1 (coord->vertex-id c))) (for-each (lambda (n) (when (coord-in-set? walkable-set n) (let* ((v2 (coord->vertex-id n)) (edge-key (if (vertex<? v1 v2) (cons v1 v2) (cons v2 v1)))) (unless (hashtable-ref seen edge-key #f) (hashtable-set! seen edge-key #t) (set! edges (cons (make-simplex (list v1 v2)) edges)))))) (neighbor-fn c)))) coords) edges))"))
(task-entry (id "tiles/core/tile-type") (skill tiles) (module core) (tier 1) (difficulty 12306) (name tile-type) (type "(-> Tile Symbol)") (description "") (notes ()) (section tile-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile)) (answer "(define (tile-type tile) (car tile))"))
(task-entry (id "tiles/square/square-neighbors-all") (skill tiles) (module square) (tier 1) (difficulty 12306) (name square-neighbors-all) (type "(-> Coord (List Coord))") (description "Get all 8 neighbors (king moves in chess)") (notes ()) (section neighbor-calculations) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho square-neighbors-diag)) (answer "(define (square-neighbors-all coord) (map (lambda (dir) (square-neighbor coord (car dir))) square-offset-8))"))
(task-entry (id "tiles/hex/offset->axial") (skill tiles) (module hex) (tier 1) (difficulty 12306) (name offset->axial) (type "(-> OffsetCoord AxialCoord)") (description "odd-r offset") (notes ()) (section coordinate-conversions) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset)) (answer "(define (offset->axial oc) (let* ((col (coord-x oc)) (row (coord-y oc)) (q (- col (quotient (+ row (bitwise-and row 1)) 2))) (r row)) (axial-coord q r)))"))
(task-entry (id "tiles/triangle/triangle-default-orientation") (skill tiles) (module triangle) (tier 1) (difficulty 12306) (name triangle-default-orientation) (type "(-> Integer Integer Symbol)") (description "Get default orientation for a position based on parity") (notes ()) (section orientation) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash)) (answer "(define (triangle-default-orientation row col) (if (even? (+ row col)) 'up 'down))"))
(task-entry (id "tiles/pathfinding/dijkstra-path") (skill tiles) (module pathfinding) (tier 1) (difficulty 12306) (name dijkstra-path) (type "(-> Coord Coord (-> Coord (List Coord)) (-> Coord Number) (-> Coord Bool) (Maybe (List Coord)))") (description "Find shortest weighted path using Dijkstra's algorithm") (notes ()) (section dijkstra) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert pqueue-pop reconstruct-path bfs-path)) (answer "(define (dijkstra-path start goal neighbor-fn cost-fn walkable-fn) (let ((pq (pqueue-insert (make-pqueue) 0 start)) (cost-so-far (make-hashtable equal-hash equal?)) (came-from (make-hashtable equal-hash equal?))) (hashtable-set! cost-so-far start 0) (let loop ((queue pq)) (if (pqueue-empty? queue) #f (let-values (((current priority new-queue) (pqueue-pop queue))) (if (equal? current goal) (reconstruct-path came-from start goal) (let* ((current-cost (hashtable-ref cost-so-far current 0)) (neighbors (neighbor-fn current)) (valid-neighbors (filter walkable-fn neighbors))) (let process-neighbors ((ns valid-neighbors) (q new-queue)) (if (null? ns) (loop q) (let* ((next (car ns)) (new-cost (+ current-cost (cost-fn next))) (old-cost (hashtable-ref cost-so-far next #f))) (if (or (not old-cost) (< new-cost old-cost)) (begin (hashtable-set! cost-so-far next new-cost) (hashtable-set! came-from next current) (process-neighbors (cdr ns) (pqueue-insert q new-cost next))) (process-neighbors (cdr ns) q))))))))))))"))
(task-entry (id "tiles/visibility/tiles-in-sight") (skill tiles) (module visibility) (tier 1) (difficulty 12306) (name tiles-in-sight) (type "(-> Board Coord Coord (-> Coord Coord (List Coord)) (List Coord))") (description "Get all tiles along line of sight from origin to target") (notes ()) (section utilities) (deps (\x27;tiles/core)) (available (has-line-of-sight? board-has-los? calculate-fov board-fov shadowcast-fov visible-enemies)) (answer "(define (tiles-in-sight board origin target line-fn) (cons origin (line-fn origin target)))"))
(task-entry (id "tiles/units/game-remove-unit") (skill tiles) (module units) (tier 1) (difficulty 12306) (name game-remove-unit) (type "") (description "") (notes ()) (section game-state) (deps (\x27;tiles/core)) (available (make-unit unit-get-prop unit-set-prop make-game-state game-board game-place-unit)) (answer "(define (game-remove-unit gs unit-id) (let ((c->u (hashtable-copy (game-state%-coord->unit gs) #t)) (u->c (hashtable-copy (game-state%-unit->coord gs) #t)) (coord (hashtable-ref (game-state%-unit->coord gs) unit-id #f))) (when coord (hashtable-delete! c->u coord) (hashtable-delete! u->c unit-id)) (make-game-state% (game-state%-board gs) c->u u->c)))"))
(task-entry (id "tiles/turns/turn-can-act?") (skill tiles) (module turns) (tier 1) (difficulty 12306) (name turn-can-act?) (type "") (description "") (notes ()) (section queries) (deps (\x27;sort)) (available (make-turn-state make-turn-state-from-game turn-current-unit turn-current-phase turn-number turn-actions-remaining)) (answer "(define (turn-can-act? ts unit-id) (and (eq? (turn-current-unit ts) unit-id) (> (turn-actions-remaining ts unit-id) 0)))"))
(task-entry (id "tiles/render/render-board-with-overlay") (skill tiles) (module render) (tier 1) (difficulty 12306) (name render-board-with-overlay) (type "(-> Board (-> Tile String) (List Coord) String String)") (description "Render board with overlay. Dispatches to shape-specific renderer.") (notes ()) (section high-level) (deps (\x27;tiles/core)) (available (default-tile-char render-square-board render-square-board-with-overlay render-hex-board render-hex-board-with-overlay render-board)) (answer "(define (render-board-with-overlay board style-fn overlay overlay-char) (let ((shape (board%-shape board)) (meta (board%-meta board))) (case shape ((square) (render-square-board-with-overlay board meta style-fn overlay overlay-char)) ((hex hexagonal) (render-hex-board-with-overlay board meta style-fn overlay overlay-char)) (else (error 'render-board-with-overlay \"Unsupported shape\" shape)))))"))
(task-entry (id "tiles/topology-analysis/vertex<?") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12306) (name vertex<?) (type "") (description "Ordering on vertex IDs for canonical edge representation") (notes ()) (section board-to-complex) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges)) (answer "(define (vertex<? v1 v2) (or (< (car v1) (car v2)) (and (= (car v1) (car v2)) (< (cadr v1) (cadr v2)))))"))
(task-entry (id "tiles/core/tile-data") (skill tiles) (module core) (tier 1) (difficulty 12307) (name tile-data) (type "(-> Tile Alist)") (description "") (notes ()) (section tile-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type)) (answer "(define (tile-data tile) (cdr tile))"))
(task-entry (id "tiles/square/square-neighbors") (skill tiles) (module square) (tier 1) (difficulty 12307) (name square-neighbors) (type "(-> Coord Symbol (List Coord))") (description "Generic neighbor function with movement type: 'ortho (4 orthogonal), 'diag (4 diagonal), 'all (all 8)") (notes ()) (section neighbor-calculations) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho square-neighbors-diag square-neighbors-all)) (answer "(define (square-neighbors coord mode) (case mode ((ortho) (square-neighbors-ortho coord)) ((diag) (square-neighbors-diag coord)) ((all) (square-neighbors-all coord)) (else (error 'square-neighbors \"Invalid mode\" mode))))"))
(task-entry (id "tiles/hex/hex-axial-directions") (skill tiles) (module hex) (tier 1) (difficulty 12307) (name hex-axial-directions) (type "") (description "") (notes ()) (section neighbors) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial)) (answer "(define hex-axial-directions '((e 1 . 0) (se 0 . 1) (sw -1 . 1) (w -1 . 0) (nw 0 . -1) (ne 1 . -1)))"))
(task-entry (id "tiles/triangle/triangle-flip") (skill tiles) (module triangle) (tier 1) (difficulty 12307) (name triangle-flip) (type "(-> TriangleCoord TriangleCoord)") (description "Flip triangle to opposite orientation at same position") (notes ()) (section orientation) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation)) (answer "(define (triangle-flip t) (triangle-coord (triangle-row t) (triangle-col t) (if (eq? (triangle-orientation t) 'up) 'down 'up)))"))
(task-entry (id "tiles/pathfinding/astar-path") (skill tiles) (module pathfinding) (tier 1) (difficulty 12307) (name astar-path) (type "(-> Coord Coord (-> Coord (List Coord)) (-> Coord Number) (-> Coord Coord Number) (-> Coord Bool) (Maybe (List Coord)))") (description "Find shortest path using A* with heuristic. Heuristic must be admissible.") (notes ("Heuristic must be admissible (never overestimate) for A* to be optimal")) (section astar) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert pqueue-pop reconstruct-path bfs-path dijkstra-path)) (answer "(define (astar-path start goal neighbor-fn cost-fn heuristic-fn walkable-fn) (let ((pq (pqueue-insert (make-pqueue) 0 start)) (cost-so-far (make-hashtable equal-hash equal?)) (came-from (make-hashtable equal-hash equal?))) (hashtable-set! cost-so-far start 0) (let loop ((queue pq)) (if (pqueue-empty? queue) #f (let-values (((current priority new-queue) (pqueue-pop queue))) (if (equal? current goal) (reconstruct-path came-from start goal) (let* ((current-cost (hashtable-ref cost-so-far current 0)) (neighbors (neighbor-fn current)) (valid-neighbors (filter walkable-fn neighbors))) (let process-neighbors ((ns valid-neighbors) (q new-queue)) (if (null? ns) (loop q) (let* ((next (car ns)) (new-cost (+ current-cost (cost-fn next))) (old-cost (hashtable-ref cost-so-far next #f))) (if (or (not old-cost) (< new-cost old-cost)) (let ((f-score (+ new-cost (heuristic-fn next goal)))) (hashtable-set! cost-so-far next new-cost) (hashtable-set! came-from next current) (process-neighbors (cdr ns) (pqueue-insert q f-score next))) (process-neighbors (cdr ns) q))))))))))))"))
(task-entry (id "tiles/units/game-get-unit-at") (skill tiles) (module units) (tier 1) (difficulty 12307) (name game-get-unit-at) (type "") (description "") (notes ()) (section game-state) (deps (\x27;tiles/core)) (available (make-unit unit-get-prop unit-set-prop make-game-state game-board game-place-unit game-remove-unit)) (answer "(define (game-get-unit-at gs coord) (hashtable-ref (game-state%-coord->unit gs) coord #f))"))
(task-entry (id "tiles/turns/turn-spend-action") (skill tiles) (module turns) (tier 1) (difficulty 12307) (name turn-spend-action) (type "(-> TurnState UnitId Integer TurnState)") (description "Spend action points") (notes ()) (section actions) (deps (\x27;sort)) (available (make-turn-state make-turn-state-from-game turn-current-unit turn-current-phase turn-number turn-actions-remaining turn-can-act?)) (answer "(define (turn-spend-action ts unit-id cost) (let ((ap-table (hashtable-copy (turn-state%-action-points ts) #t)) (current (hashtable-ref (turn-state%-action-points ts) unit-id 0))) (hashtable-set! ap-table unit-id (max 0 (- current cost))) (make-turn-state% (turn-state%-turn-number ts) (turn-state%-active-unit ts) (turn-state%-turn-order ts) ap-table (turn-state%-phase ts) (turn-state%-history ts))))"))
(task-entry (id "tiles/render/display-board") (skill tiles) (module render) (tier 1) (difficulty 12307) (name display-board) (type "(-> Board (-> Tile String) Void)") (description "Display board to stdout") (notes ()) (section high-level) (deps (\x27;tiles/core)) (available (default-tile-char render-square-board render-square-board-with-overlay render-hex-board render-hex-board-with-overlay render-board render-board-with-overlay)) (answer "(define (display-board board style-fn) (display (render-board board style-fn)))"))
(task-entry (id "tiles/topology-analysis/collect-square-faces") (skill tiles) (module topology-analysis) (tier 1) (difficulty 12307) (name collect-square-faces) (type "") (description "Collect 2-simplices (triangular faces) for filled 2×2 squares.\nFor each coordinate (x,y), check if (x,y), (x+1,y), (x,y+1), (x+1,y+1) are all walkable\nAND mutually adjacent. If so, triangulate the square into 2 triangles.\nThis 'fills in' solid walkable regions so β₁ counts terrain holes, not graph cycles.") (notes ()) (section board-to-complex) (deps (\x27;tiles/core)) (available (board->simplicial-complex coords->set coord-in-set? coord->vertex-id vertex-id->coord collect-edges vertex<?)) (answer "(define (collect-square-faces coords walkable-set neighbor-fn) (let ((faces '()) (seen (make-hashtable equal-hash equal?))) (for-each (lambda (c) (let* ((x (coord-x c)) (y (coord-y c)) (c00 c) (c10 (coord (+ x 1) y)) (c01 (coord x (+ y 1))) (c11 (coord (+ x 1) (+ y 1)))) (when (and (coord-in-set? walkable-set c00) (coord-in-set? walkable-set c10) (coord-in-set? walkable-set c01) (coord-in-set? walkable-set c11)) (when (and (coords-adjacent? c00 c10 neighbor-fn) (coords-adjacent? c00 c01 neighbor-fn) (coords-adjacent? c10 c11 neighbor-fn) (coords-adjacent? c01 c11 neighbor-fn)) (let ((square-key (list x y))) (unless (hashtable-ref seen square-key #f) (hashtable-set! seen square-key #t) (let ((v00 (coord->vertex-id c00)) (v10 (coord->vertex-id c10)) (v01 (coord->vertex-id c01)) (v11 (coord->vertex-id c11))) (set! faces (cons (make-simplex (list v00 v10 v11)) faces)) (set! faces (cons (make-simplex (list v00 v01 v11)) faces))))))))) coords) faces))"))
(task-entry (id "tiles/core/tile-walkable?") (skill tiles) (module core) (tier 1) (difficulty 12308) (name tile-walkable?) (type "(-> Tile Boolean)") (description "Default walkable predicate - can be overridden by games") (notes ()) (section tile-protocol) (deps (\x27;prelude)) (available (coord coord-x coord-y coord-equal? coord-hash make-tile tile-type tile-data)) (answer "(define (tile-walkable? tile) (not (eq? (tile-type tile) 'wall)))"))
