(task-entry (id "optimization/first-order/nesterov") (skill optimization) (module first-order) (tier 1) (difficulty 12810) (name nesterov) (type "(-> (-> (List TracedValue) TracedValue) (List Number) Number Number ConvergenceCriteria OptResult)") (description "Nesterov accelerated gradient descent") (notes ()) (section nesterov) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum adam adam-full rmsprop rmsprop-full adagrad adagrad-full gradient-descent-ls)) (answer "(define (nesterov f x0 lr beta criteria) (let* ((n (length x0)) (init-v (make-list n 0)) (init-grad (gradient f x0)) (init-f (apply f x0)) (init-state (initial-convergence-state init-f init-grad))) (let loop ((x x0) (v init-v) (state init-state)) (let ((reason (converged? criteria state))) (if reason (make-opt-result x (cs-f-val state) (gradient f x) (cs-iter state) reason) (let* ((x-lookahead (map (lambda (xi vi) (- xi (* lr beta vi))) x v)) (grad (gradient f x-lookahead)) (v-new (map (lambda (vi gi) (+ (* beta vi) gi)) v grad)) (x-new (map (lambda (xi vi) (- xi (* lr vi))) x v-new)) (f-new (apply f x-new)) (grad-new (gradient f x-new)) (new-state (update-convergence-state state f-new grad-new x x-new))) (loop x-new v-new new-state)))))))"))
(task-entry (id "optimization/newton/gauss-newton") (skill optimization) (module newton) (tier 1) (difficulty 12810) (name gauss-newton) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton make-positive-definite newton-cg newton-cg-full cg-newton-direction hessian-vector-product)) (answer "(define (gauss-newton r x0 criteria) (let* ((n (length x0)) (f (lambda args (let ((residuals (apply r args))) (* 0.5 (fold-left + 0 (map (lambda (ri) (* ri ri)) residuals)))))) (init-f (f x0)) (init-grad (gradient-ls r x0)) (init-state (initial-convergence-state init-f init-grad))) (let loop ((x x0) (state init-state)) (let ((reason (converged? criteria state))) (if reason (make-opt-result x (cs-f-val state) (gradient-ls r x) (cs-iter state) reason) (let* ((residuals (apply r x)) (jac (jacobian-numerical r x)) (jtj (matrix-mul (matrix-transpose jac) jac)) (jtr (matrix-vec-mul (matrix-transpose jac) (list->vector residuals))) (neg-jtr (vector-map - jtr)) (jtj-reg (matrix-add-diagonal jtj 1e-8)) (d-result (matrix-solve jtj-reg neg-jtr)) (direction (if (and (pair? d-result) (eq? (car d-result) 'error)) (map - (gradient-ls r x)) (vector->list d-result))) (f-ls (lambda args (let ((res (apply r args))) (* 0.5 (fold-left + 0 (map (lambda (ri) (* ri ri)) res)))))) (grad (gradient-ls r x)) (ls-result (armijo-backtrack f-ls x grad direction)) (x-new (car ls-result)) (f-new (f-ls x-new)) (grad-new (gradient-ls r x-new)) (new-state (update-convergence-state state f-new grad-new x x-new))) (loop x-new new-state)))))))"))
(task-entry (id "optimization/lbfgs/lbfgs-two-loop") (skill optimization) (module lbfgs) (tier 1) (difficulty 12810) (name lbfgs-two-loop) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list lbfgs-history-push take-n lbfgs-direction)) (answer "(define (lbfgs-two-loop h q) (let* ((s-list (lh-s-list h)) (y-list (lh-y-list h)) (rho-list (lh-rho-list h)) (m (lh-size h))) (let loop1 ((i 0) (q q) (alphas '()) (ss s-list) (ys y-list) (rhos rho-list)) (if (or (= i m) (null? ss)) (let* ((gamma (initial-hessian-scale h)) (r (map (lambda (x) (* gamma x)) q))) (let loop2 ((j (- m 1)) (r r) (alphas-rev (reverse alphas)) (ss-rev (reverse s-list)) (ys-rev (reverse y-list)) (rhos-rev (reverse rho-list))) (if (or (< j 0) (null? ss-rev)) r (let* ((s (car ss-rev)) (y (car ys-rev)) (rho (car rhos-rev)) (alpha (car alphas-rev)) (beta (* rho (dot-product y r))) (r-new (vec-add-scaled r s (- alpha beta)))) (loop2 (- j 1) r-new (cdr alphas-rev) (cdr ss-rev) (cdr ys-rev) (cdr rhos-rev)))))) (let* ((s (car ss)) (y (car ys)) (rho (car rhos)) (alpha (* rho (dot-product s q))) (q-new (vec-add-scaled q y (- alpha)))) (loop1 (+ i 1) q-new (cons alpha alphas) (cdr ss) (cdr ys) (cdr rhos)))))))"))
