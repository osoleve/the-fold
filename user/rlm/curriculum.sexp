(task-entry (id "statistics/summary-stats/vec-sum") (skill statistics) (module summary-stats) (tier 1) (difficulty 11213) (name vec-sum) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation)) (answer "(define (vec-sum v) (let ((n (vector-length v))) (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (+ s (vector-ref v i)))))))"))
(task-entry (id "statistics/design-matrix/legendre-p") (skill statistics) (module design-matrix) (tier 1) (difficulty 11213) (name legendre-p) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind)) (answer "(define (legendre-p n x) (cond ((= n 0) 1) ((= n 1) x) (else (let loop ((k 2) (p-2 1) (p-1 x)) (if (> k n) p-1 (let ((p-k (/ (- (* (- (* 2 k) 1) x p-1) (* (- k 1) p-2)) k))) (loop (+ k 1) p-1 p-k)))))))"))
(task-entry (id "statistics/linear/linear-model-predict-interval") (skill statistics) (module linear) (tier 1) (difficulty 11213) (name linear-model-predict-interval) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit linear-model-compute-diagnostics compute-coefficient-se compute-t-values compute-p-values compute-r-squared compute-adj-r-squared weighted-linear-fit weight-matrix weight-vector weighted-diagnostics compute-weighted-se linear-model-predict)) (answer "(define (linear-model-predict-interval model X-new confidence) (let* ((n-new (matrix-rows X-new)) (p (matrix-cols X-new)) (beta (linear-model-coefficients model)) (mse (linear-model-mse model)) (sigma (sqrt mse)) (n-orig (linear-model-n model)) (df (- n-orig p)) (t-crit (t-quantile (+ 0.5 (/ confidence 2)) (max df 1))) (predictions (matrix-vec-mul X-new beta)) (lower (make-vector n-new)) (upper (make-vector n-new)) (XtX-inv (compute-XtX-inverse X-new))) (if (and (pair? XtX-inv) (eq? (car XtX-inv) 'error)) (let* ((avg-leverage (/ p n-orig)) (se-pred (* sigma (sqrt (+ 1 avg-leverage)))) (margin (* t-crit se-pred))) (do ((i 0 (+ i 1))) ((= i n-new)) (let ((pred (vector-ref predictions i))) (vector-set! lower i (- pred margin)) (vector-set! upper i (+ pred margin)))) (list predictions lower upper)) (begin (do ((i 0 (+ i 1))) ((= i n-new)) (let* ((xi (extract-row X-new i)) (leverage (compute-leverage-single xi XtX-inv p)) (se-pred (* sigma (sqrt (+ 1 leverage)))) (margin (* t-crit se-pred)) (pred (vector-ref predictions i))) (vector-set! lower i (- pred margin)) (vector-set! upper i (+ pred margin)))) (list predictions lower upper)))))"))
(task-entry (id "statistics/regularized/cv-error-for-lambda") (skill statistics) (module regularized) (tier 1) (difficulty 11213) (name cv-error-for-lambda) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics compute-r-squared-ridge lasso-fit lasso-coordinate-descent lasso-partial-residual soft-threshold lasso-finalize count-nonzero elastic-net-fit elastic-net-coordinate-descent elastic-net-update cross-validate-lambda)) (answer "(define (cv-error-for-lambda X y lambda k method alpha n) (let* ((fold-size (quotient n k)) (total-error 0)) (do ((fold 0 (+ fold 1))) ((= fold k) (/ total-error n)) (let* ((start (* fold fold-size)) (end (if (= fold (- k 1)) n (+ start fold-size))) (train-test (split-fold X y start end n)) (X-train (car train-test)) (y-train (cadr train-test)) (X-test (caddr train-test)) (y-test (cadddr train-test)) (model (case method ((ridge) (ridge-fit X-train y-train lambda)) ((lasso) (lasso-fit X-train y-train lambda)) ((elastic-net) (elastic-net-fit X-train y-train lambda alpha)) (else (ridge-fit X-train y-train lambda)))) (fold-error (if (and (pair? model) (eq? (car model) 'error)) 1e10 (compute-mse-test X-test y-test (linear-model-coefficients model))))) (set! total-error (+ total-error (* fold-error (- end start))))))))"))
(task-entry (id "statistics/glm/probit-fit") (skill statistics) (module glm) (tier 1) (difficulty 11213) (name probit-fit) (type "") (description "") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available (glm-fit irls-loop irls-step weighted-least-squares irls-converged? irls-finalize compute-glm-se compute-z-values compute-z-pvalues compute-deviance-residuals logistic-fit poisson-fit gamma-fit)) (answer "(define (probit-fit X y . opts) (apply glm-fit binomial-family probit-link X y opts))"))
(task-entry (id "statistics/families/quasi-binomial-family") (skill statistics) (module families) (tier 1) (difficulty 11213) (name quasi-binomial-family) (type "") (description "") (notes ()) (section family-structure) (deps (\x27;prelude \x27;transcendental)) (available (make-glm-family glm-family? family-name family-variance family-deviance-contrib family-valid-mu? family-initialize gaussian-family binomial-family poisson-family gamma-family inverse-gaussian-family quasi-poisson-family)) (answer "(define quasi-binomial-family (make-glm-family 'quasi-binomial (lambda (mu) (* mu (- 1 mu))) (lambda (y mu) (let* ((mu-safe (max (min mu (- 1 1e-10)) 1e-10)) (y-safe (max (min y (- 1 1e-10)) 1e-10)) (term1 (if (> y 0) (* y (log (/ y-safe mu-safe))) 0)) (term2 (if (< y 1) (* (- 1 y) (log (/ (- 1 y-safe) (- 1 mu-safe)))) 0))) (* 2 (+ term1 term2)))) (lambda (mu) (and (> mu 0) (< mu 1))) (lambda (y) (/ (+ y 0.5) 2))))"))
(task-entry (id "statistics/link-functions/inverse-link") (skill statistics) (module link-functions) (tier 1) (difficulty 11213) (name inverse-link) (type "") (description "") (notes ()) (section link-function-structure) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available (make-link-function link-function? link-name link-g link-inverse link-derivative identity-link logit-link log-link probit-link probit-quantile probit-cdf probit-pdf)) (answer "(define inverse-link (make-link-function 'inverse (lambda (mu) (/ 1 (if (= mu 0) 1e-10 mu))) (lambda (eta) (/ 1 (if (= eta 0) 1e-10 eta))) (lambda (mu) (/ -1 (expt (if (= mu 0) 1e-10 mu) 2)))))"))
