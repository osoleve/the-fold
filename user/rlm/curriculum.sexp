(task-entry (id "physics/classical/constraint-graph/cg-find-sccs") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23515) (name cg-find-sccs) (type "") (description "") (notes ()) (section sccs) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count)) (answer "(define (cg-find-sccs graph) (let ((entities (cg-entities graph)) (index-counter 0) (indices (make-hashtable equal-hash equal?)) (lowlinks (make-hashtable equal-hash equal?)) (on-stack (make-hashtable equal-hash equal?)) (stack '()) (sccs '())) (define (strongconnect entity) (hashtable-set! indices entity index-counter) (hashtable-set! lowlinks entity index-counter) (set! index-counter (+ index-counter 1)) (set! stack (cons entity stack)) (hashtable-set! on-stack entity #t) (for-each (lambda (neighbor) (cond ((not (hashtable-contains? indices neighbor)) (strongconnect neighbor) (hashtable-set! lowlinks entity (min (hashtable-ref lowlinks entity 0) (hashtable-ref lowlinks neighbor 0)))) ((hashtable-ref on-stack neighbor #f) (hashtable-set! lowlinks entity (min (hashtable-ref lowlinks entity 0) (hashtable-ref indices neighbor 0)))))) (cg-neighbors graph entity)) (when (= (hashtable-ref lowlinks entity 0) (hashtable-ref indices entity 0)) (let loop ((scc-entities '())) (let ((w (car stack))) (set! stack (cdr stack)) (hashtable-set! on-stack w #f) (if (equal? w entity) (set! sccs (cons (cons entity scc-entities) sccs)) (loop (cons w scc-entities))))))) (for-each (lambda (entity) (unless (hashtable-contains? indices entity) (strongconnect entity))) entities) (map (lambda (entity-list) (make-scc entity-list (scc-internal-constraints graph entity-list))) (reverse sccs))))"))
