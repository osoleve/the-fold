(task-entry (id "autodiff/differentiable-signal/power-spectrum-grad") (skill autodiff) (module differentiable-signal) (tier 1) (difficulty 12716) (name power-spectrum-grad) (type "(-> (Vector Complex) (Vector Number) (Vector Complex))") (description "Gradient of power spectrum: d(|X[k]|^2)/dX[k] = 2*conj(X[k])") (notes ()) (section power-spectrum) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;reverse-diff)) (available (traced-vec? vec-extract-values vec-extract-tape dft-vjp dft-vjp-real idft-vjp idft-vjp-real convolve-vjp-signal convolve-vjp-kernel traced-dft-real make-dft-re-local-grads make-dft-im-local-grads diff-dft diff-convolution traced-convolve-1d make-conv-local-grads)) (answer "(define (power-spectrum-grad X output-grad) (let* ((n (vector-length X)) (result (make-vector n))) (do ((k 0 (+ k 1))) ((= k n) result) (let* ((x-k (vector-ref X k)) (g-k (if (< k (vector-length output-grad)) (vector-ref output-grad k) 0)) (grad (complex-scale (* 2 g-k) (complex-conjugate x-k)))) (vector-set! result k grad)))))"))
