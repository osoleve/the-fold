(task-entry (id "dataset/presentation/textbox-label") (skill dataset) (module presentation) (tier 1) (difficulty 13413) (name textbox-label) (type "") (description "") (notes ()) (section elements) (deps (\x27;prelude \x27;layout)) (available (make-text-block text-block? text-block-content text-block-width text-block-alignment make-frame-block frame-block? frame-block-content frame-block-width frame-block-height frame-block-border? make-textbox textbox?)) (answer "(define (textbox-label tb) (list-ref tb 1))"))
(task-entry (id "dataset/distractor/generate-distractors") (skill dataset) (module distractor) (tier 1) (difficulty 13413) (name generate-distractors) (type "") (description "Generate n distinct wrong answers using given strategies") (notes ()) (section generation) (deps (\x27;prelude \x27;prng \x27;parameter \x27;sort)) (available (make-distractor-strategy distractor-strategy? distractor-strategy-name distractor-strategy-generator distractor-nearby distractor-sign-flip distractor-off-by-one distractor-double-half distractor-wrong-sign-convention distractor-order-swap distractor-random-choice distractor-formula-variant apply-distractor)) (answer "(define (generate-distractors correct strategies n rng) (let loop ((remaining n) (used-strategies strategies) (results '()) (attempts 0)) (cond ((<= remaining 0) (reverse results)) ((>= attempts (* n 10)) (let ((filler (generate-filler-distractors correct remaining rng results))) (reverse (append (reverse filler) results)))) ((null? used-strategies) (loop remaining strategies results attempts)) (else (let* ((strategy (car used-strategies)) (distractor (apply-distractor strategy correct rng))) (if (or (equal? distractor correct) (member-approx? distractor results)) (loop remaining (cdr used-strategies) results (+ attempts 1)) (loop (- remaining 1) (cdr used-strategies) (cons distractor results) 0)))))))"))
(task-entry (id "dataset/difficulty/difficulty-score") (skill dataset) (module difficulty) (tier 1) (difficulty 13413) (name difficulty-score) (type "") (description "") (notes ()) (section scoring) (deps (\x27;prelude)) (available (make-difficulty-vector difficulty-vec? dv-inference-depth dv-object-count dv-temporal-steps dv-visual-precision dv-formula-complexity inference-direct inference-derivative inference-latent inference-system classify-inference-depth difficulty-weights)) (answer "(define (difficulty-score dv weights) (let ((w-inf (cdr (or (assq 'inference-depth weights) '(_ . 2.0)))) (w-obj (cdr (or (assq 'object-count weights) '(_ . 0.5)))) (w-tmp (cdr (or (assq 'temporal-steps weights) '(_ . 0.3)))) (w-vis (cdr (or (assq 'visual-precision weights) '(_ . 1.0)))) (w-frm (cdr (or (assq 'formula-complexity weights) '(_ . 1.5))))) (+ (* w-inf (dv-inference-depth dv)) (* w-obj (log (+ 1 (dv-object-count dv)))) (* w-tmp (log (+ 1 (dv-temporal-steps dv)))) (* w-vis (dv-visual-precision dv)) (* w-frm (dv-formula-complexity dv)))))"))
(task-entry (id "dataset/sexp/from-ok") (skill dataset) (module sexp) (tier 1) (difficulty 13413) (name from-ok) (type "") (description "") (notes ()) (section validation) (deps (core/base/prelude.ss lattice/dataset/sample.ss lattice/data/sort.ss)) (available (sample->canonical-sexp sort-alist canonical-sexp->sample dataset->sexp sexp->dataset sexp->string sexp->pretty-string pp-sexp sexp-length join-strings validate-sample-sexp ok ok?)) (answer "(define (from-ok x) (cadr x))"))
(task-entry (id "dataset/jsonl/json-string-escape") (skill dataset) (module jsonl) (tier 1) (difficulty 13413) (name json-string-escape) (type "") (description "") (notes ()) (section serialization) (deps (core/base/prelude.ss lattice/optics/optics.ss lattice/dataset/sample.ss)) (available (make-json-object json-object? json-object-pairs make-json-array json-array? json-array-items sample->json json->sample value->json json->value sample-json-iso iso-roundtrip-check json->string)) (answer "(define (json-string-escape s) (string-append \"\"\" (list->string (append-map (lambda (c) (cond ((char=? c #\\\") '(#\\\\ #\\\")) ((char=? c #\\\\) '(#\\\\ #\\\\)) ((char=? c #\\\n) '(#\\\\ #\\n)) ((char=? c #\\\r) '(#\\\\ #\\r)) ((char=? c #\\\t) '(#\\\\ #\\t)) (else (list c)))) (string->list s))) \"\"\"))"))
