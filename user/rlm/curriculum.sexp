(task-entry (id "physics/classical3d/world3d/spatial-hash-3d-query") (skill physics/classical3d) (module world3d) (tier 2) (difficulty 22431) (name spatial-hash-3d-query) (type "") (description "") (notes ()) (section physics-entity) (deps (\x27;prelude \x27;vec3 \x27;quaternion \x27;rigid-body3d \x27;shapes3d \x27;collision-detection3d \x27;constraint-solver3d)) (available (make-entity-3d entity-3d? entity-3d-id entity-3d-body entity-3d-shape entity-3d-material entity-3d-user-data entity-3d-with-body entity-3d-pos entity-3d-vel entity-3d-static? make-material material? material-restitution material-friction *default-material* *bouncy-material* *sticky-material* make-time-acc-3d time-acc-3d-fixed-dt time-acc-3d-max-substeps time-acc-3d-accumulated time-acc-3d-add time-acc-3d-consume make-spatial-hash-3d spatial-hash-3d-cell-size spatial-hash-3d-table spatial-hash-3d-key spatial-hash-3d-aabb-keys spatial-hash-3d-clear! spatial-hash-3d-insert!)) (answer "(define (spatial-hash-3d-query hash aabb) (let* ((table (spatial-hash-3d-table hash)) (keys (spatial-hash-3d-aabb-keys hash aabb)) (seen (make-hashtable equal-hash equal?)) (results '())) (for-each (lambda (key) (let ((ids (hashtable-ref table key '()))) (for-each (lambda (id) (unless (hashtable-ref seen id #f) (hashtable-set! seen id #t) (set! results (cons id results)))) ids))) keys) results))"))
