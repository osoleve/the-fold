(task-entry (id "physics-problems/physics-problem/format-answer") (skill physics-problems) (module physics-problem) (tier 2) (difficulty 23614) (name format-answer) (type "") (description "") (notes ()) (section options) (deps (\x27;prelude \x27;vec2 \x27;sample \x27;parameter \x27;presentation \x27;distractor \x27;difficulty \x27;simulation)) (available (make-physics-problem physics-problem? problem-name problem-category problem-params problem-world-setup problem-question-gen problem-answer-compute problem-difficulty generate-problem-instance generate-problem-id generate-problem-options find-correct-label string-contains-approx?)) (answer "(define (format-answer val) (cond ((number? val) (format-numeric-option val)) ((symbol? val) (symbol->string val)) ((string? val) val) (else (format \"~a\" val))))"))
