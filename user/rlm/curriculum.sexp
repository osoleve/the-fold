(task-entry (id "geometry/obj-loader/load-obj-from-string") (skill geometry) (module obj-loader) (tier 1) (difficulty 12204) (name load-obj-from-string) (type "(-> String (List Triangle3))") (description "Parse OBJ content and return list of triangles") (notes ()) (section obj-loading) (deps (\x27;prelude \x27;geometry)) (available (parse-obj-line parse-vertex parse-face string-split)) (answer "(define (load-obj-from-string content) (let* ((lines (string-split content #\\\n)) (parsed (filter identity (map parse-obj-line lines))) (vertices (list->vector (map cdr (filter (lambda (p) (eq? (car p) 'vertex)) parsed)))) (faces (map cdr (filter (lambda (p) (eq? (car p) 'face)) parsed)))) (faces->triangles vertices faces)))"))
(task-entry (id "geometry/ascii-render/ansi-fg") (skill geometry) (module ascii-render) (tier 1) (difficulty 12204) (name ansi-fg) (type "(-> Number String)") (description "Generate ANSI escape for 256-color foreground") (notes ()) (section ansi-color-codes) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (ascii-ramp ascii-ramp-len intensity->char rgb->ansi256)) (answer "(define (ansi-fg color-code) (string-append \"\x1B;[38;5;\" (number->string color-code) \"m\"))"))
(task-entry (id "geometry/mesh-sdf/mesh-sdf") (skill geometry) (module mesh-sdf) (tier 1) (difficulty 12204) (name mesh-sdf) (type "(-> Mesh Point3 Number)") (description "Compute signed distance from point to mesh surface; uses BVH for acceleration") (notes ()) (section mesh-sdf-computation) (deps (\x27;prelude \x27;geometry \x27;bvh)) (available (make-mesh mesh? mesh-triangles mesh-bvh)) (answer "(define (mesh-sdf mesh point) (let* ((bvh (mesh-bvh mesh)) (result (bvh-closest-point bvh point))) (if result (let* ((closest-point (car result)) (distance (cadr result)) (triangle (caddr result)) (normal (triangle-normal triangle)) (to-point (vec3-sub point closest-point)) (dot (vec3-dot normal to-point))) (if (>= dot 0) (- distance) distance)) 1e10)))"))
(task-entry (id "geometry/marching-cubes/compute-cube-index") (skill geometry) (module marching-cubes) (tier 1) (difficulty 12204) (name compute-cube-index) (type "(-> (List Number) Number)") (description "Compute configuration index (0-255) based on which corners are inside") (notes ()) (section grid-and-cube-utilities) (deps (\x27;prelude \x27;geometry)) (available (edge-table tri-table marching-cubes-grid marching-cubes-cube)) (answer "(define (compute-cube-index values) (let loop ((vals values) (i 0) (index 0)) (if (null? vals) index (loop (cdr vals) (+ i 1) (if (< (car vals) 0) (bitwise-ior index (bitwise-arithmetic-shift-left 1 i)) index)))))"))
(task-entry (id "geometry/mesh-gen/triangulation-triangles") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12204) (name triangulation-triangles) (type "") (description "") (notes ()) (section triangulation) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points)) (answer "(define (triangulation-triangles tri) (vector-ref tri 2))"))
(task-entry (id "geometry/mesh-topology/mesh->simplicial-complex") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12204) (name mesh->simplicial-complex) (type "(-> Mesh SC)") (description "Convert a triangle mesh to a 2-dimensional simplicial complex") (notes ("Conversion: each unique vertex position → 0-simplex, each edge → 1-simplex, each triangle → 2-simplex; simplicial complex automatically includes all faces due to closure property")) (section mesh-to-simplicial-complex-conversion) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map)) (answer "(define (mesh->simplicial-complex mesh) (triangles->simplicial-complex (mesh-triangles mesh)))"))
(task-entry (id "geometry/convex-hull/find-lowest-point") (skill geometry) (module convex-hull) (tier 1) (difficulty 12204) (name find-lowest-point) (type "") (description "") (notes ()) (section graham-scan) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq)) (answer "(define (find-lowest-point points) (fold-left (lambda (best p) (cond ((< (point2-y p) (point2-y best)) p) ((and (= (point2-y p) (point2-y best)) (< (point2-x p) (point2-x best))) p) (else best))) (car points) (cdr points)))"))
(task-entry (id "geometry/voronoi/voronoi-edges") (skill geometry) (module voronoi) (tier 1) (difficulty 12204) (name voronoi-edges) (type "") (description "") (notes ()) (section structures) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices)) (answer "(define (voronoi-edges v) (list-ref v 3))"))
(task-entry (id "geometry/geometry-optics/line3-direction-lens") (skill geometry) (module geometry-optics) (tier 1) (difficulty 12204) (name line3-direction-lens) (type "") (description "") (notes ()) (section line3-lenses) (deps (\x27;prelude \x27;optics \x27;geometry)) (available (vec3-x-lens vec3-y-lens vec3-z-lens line3-origin-lens)) (answer "(define line3-direction-lens (make-lens line3-direction (lambda (new-dir l) (line3 (line3-origin l) new-dir))))"))
(task-entry (id "geometry/shape-protocol/closest-shape") (skill geometry) (module shape-protocol) (tier 1) (difficulty 12204) (name closest-shape) (type "(-> (List Shape) Point3 (Or (Pair Shape Number) #f))") (description "Find shape closest to point, returns (shape . distance)") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;vec3 \x27;geometry)) (available (distance-to-segment scene-intersect-ray scene-aabb shapes-containing-point)) (answer "(define (closest-shape shapes point) (if (null? shapes) #f (let loop ((shapes (cdr shapes)) (best-shape (car shapes)) (best-dist (abs (shape-distance-point (car shapes) point)))) (if (null? shapes) (cons best-shape best-dist) (let* ((shape (car shapes)) (dist (abs (shape-distance-point shape point)))) (if (< dist best-dist) (loop (cdr shapes) shape dist) (loop (cdr shapes) best-shape best-dist)))))))"))
(task-entry (id "geometry/geometry/ray3") (skill geometry) (module geometry) (tier 1) (difficulty 12205) (name ray3) (type "(-> Vec3 Vec3 Ray3)") (description "Half-infinite ray starting at origin going in direction") (notes ()) (section primitives) (deps (\x27;prelude \x27;vec3 \x27;matrix \x27;quaternion)) (available (point3 line3 line3? line3-origin line3-direction)) (answer "(define (ray3 origin direction) (list 'ray3 origin direction))"))
(task-entry (id "geometry/raymarch/raymarch") (skill geometry) (module raymarch) (tier 1) (difficulty 12205) (name raymarch) (type "(-> (-> Vec3 Real) Ray3 RaymarchParams (Or (List Vec3 Real Nat) #f))") (description "Sphere trace along a ray until surface hit or max distance") (notes ()) (section raymarch-algorithm) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (raymarch-params raymarch-params-max-steps raymarch-params-max-distance raymarch-params-hit-threshold default-raymarch-params)) (answer "(define (raymarch sdf-fn ray params) (let ((max-steps (raymarch-params-max-steps params)) (max-dist (raymarch-params-max-distance params)) (threshold (raymarch-params-hit-threshold params)) (origin (ray3-origin ray)) (direction (ray3-direction ray))) (define (march t steps) (cond ((>= steps max-steps) #f) ((>= t max-dist) #f) (else (let* ((point (ray3-point-at ray t)) (dist (sdf-fn point))) (cond ((< dist threshold) (list point t steps)) (else (march (+ t (abs dist)) (+ steps 1)))))))) (march 0.0 0)))"))
