urrent u v w))) (else (let ((neighbors (hashtable-ref adj current #f))) (if (>= tri-orient 0) (cond ((< o12 0) (loop (vector-ref neighbors 0) (+ steps 1))) ((< o23 0) (loop (vector-ref neighbors 1) (+ steps 1))) (else (loop (vector-ref neighbors 2) (+ steps 1)))) (cond ((> o12 0) (loop (vector-ref neighbors 0) (+ steps 1))) ((> o23 0) (loop (vector-ref neighbors 1) (+ steps 1))) (else (loop (vector-ref neighbors 2) (+ steps 1))))))))))))))))"))
(task-entry (id "geometry/geometry/intersect-ray-aabb") (skill geometry) (module geometry) (tier 1) (difficulty 12256) (name intersect-ray-aabb) (type "(-> Ray3 AABB (Or (List Number Number) #f))") (description "") (notes ()) (section intersection-tests) (deps (\x27;prelude \x27;vec3 \x27;matrix \x27;quaternion)) (available (point3 line3 line3? line3-origin line3-direction ray3 ray3? ray3-origin ray3-direction ray3-point-at plane3 plane3? plane3-normal plane3-d plane3-from-point-normal plane3-from-points triangle3 triangle3? triangle3-p1 triangle3-p2 triangle3-p3 circle circle? circle-center circle-radius sphere sphere? sphere-center sphere-radius aabb aabb? aabb-min aabb-max aabb-center aabb-extents obb obb? obb-center obb-axes obb-extents transform-identity transform-translation transform-scale transform-rotation-x transform-rotation-y transform-rotation-z transform-rotation-axis transform-from-quaternion transform-point transform-vector distance-point-point distance-point-plane distance-point-line distance-point-sphere intersect-ray-plane intersect-ray-sphere)) (answer "(define (intersect-ray-aabb ray box) (let* ((origin (ray3-origin ray)) (dir (ray3-direction ray)) (bmin (aabb-min box)) (bmax (aabb-max box))) (define (slab-t dir-comp origin-comp box-min box-max) (if (< (abs dir-comp) 1e-10) (if (and (>= origin-comp box-min) (<= origin-comp box-max)) (list -1e10 1e10) (list 1 -1)) (let* ((inv-dir (/ 1.0 dir-comp)) (t1 (* (- box-min origin-comp) inv-dir)) (t2 (* (- box-max origin-comp) inv-dir))) (if (< t1 t2) (list t1 t2) (list t2 t1))))) (let* ((x-range (slab-t (vec3-x dir) (vec3-x origin) (vec3-x bmin) (vec3-x bmax))) (y-range (slab-t (vec3-y dir) (vec3-y origin) (vec3-y bmin) (vec3-y bmax))) (z-range (slab-t (vec3-z dir) (vec3-z origin) (vec3-z bmin) (vec3-z bmax))) (tmin (max (car x-range) (car y-range) (car z-range))) (tmax (min (cadr x-range) (cadr y-range) (cadr z-range)))) (if (and (<= tmin tmax) (>= tmax 0)) (list tmin tmax) #f))))"))
(task-entry (id "geometry/mesh-gen/interpolate-at") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12256) (name interpolate-at) (type "") (description "") (notes ()) (section interpolation) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location location? location-triangle location-bary point2-x point2-y vertex-key make-tri2 tri2? tri2-p1 tri2-p2 tri2-p3 tri2-points orient2d tri2-signed-area tri2-area tri2-circumcenter tri2-circumradius-sq point-in-circumcircle? make-edge edge-p1 edge-p2 points-equal? edges-equal? tri2-edges edge-in-list? count-edge edge-key find-boundary-edges-hash segments-properly-intersect? edge-properly-intersects-edge? triangle-crosses-edge? triangle-crosses-any-constraint? make-super-triangle triangle-uses-point? triangle-uses-super-vertex? delaunay-insert-point delaunay-insert-point-diff point2-key key<? canonical-edge-key build-adjacency find-boundary-edges triangle-neighbors delaunay-triangulate barycentric-coords locate-point)) (answer "(define (interpolate-at tri-data point values) (let ((loc (locate-point tri-data point))) (if (not loc) #f (let* ((tri (location-triangle loc)) (bary (location-bary loc)) (u (vector-ref bary 0)) (v (vector-ref bary 1)) (w (vector-ref bary 2)) (point-index (triangulation-point-index tri-data)) (p1 (tri2-p1 tri)) (p2 (tri2-p2 tri)) (p3 (tri2-p3 tri)) (find-idx (lambda (p) (hashtable-ref point-index (vertex-key p) #f))) (i1 (find-idx p1)) (i2 (find-idx p2)) (i3 (find-idx p3))) (if (and i1 i2 i3) (+ (* u (vector-ref values i1)) (* v (vector-ref values i2)) (* w (vector-ref values i3))) #f)))))"))
