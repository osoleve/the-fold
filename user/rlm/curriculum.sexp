(task-entry (id "physics/classical/ascii-renderer/get-entity-shape-world") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23548) (name get-entity-shape-world) (type "") (description "") (notes ()) (section entity) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line! draw-filled-circle! polygon-scanline-intersections fill-between-pairs! draw-filled-polygon! draw-filled-aabb! draw-aabb-outline! fmod angle->arrow-char draw-velocity-vector! draw-contact! draw-constraint!)) (answer "(define (get-entity-shape-world entity) (let* ((shape (entity-shape entity)) (body (entity-body entity)) (pos (if (rigid-body? body) (rigid-body-pos body) (body-pos body)))) (cond ((circle? shape) (make-circle pos (circle-radius shape))) ((aabb? shape) (let ((half-w (/ (- (vec2-x (aabb-max shape)) (vec2-x (aabb-min shape))) 2)) (half-h (/ (- (vec2-y (aabb-max shape)) (vec2-y (aabb-min shape))) 2))) (make-aabb (vec2 (- (vec2-x pos) half-w) (- (vec2-y pos) half-h)) (vec2 (+ (vec2-x pos) half-w) (+ (vec2-y pos) half-h))))) ((polygon? shape) (make-polygon (map (lambda (v) (vec2-add v pos)) (polygon-vertices shape)))) (else shape))))"))
(task-entry (id "physics/classical/collision-detection/shapes-manifold") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23549) (name shapes-manifold) (type "") (description "") (notes ()) (section generic) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle? circle-circle-manifold circle-aabb? circle-aabb-manifold circle-polygon? closest-point-on-segment circle-polygon-manifold project-polygon project-circle intervals-overlap polygon-polygon? polygon-polygon-manifold shape-type shape-aabb shapes-collide? aabb-to-polygon)) (answer "(define (shapes-manifold a b) (let ((type-a (shape-type a)) (type-b (shape-type b))) (cond ((and (eq? type-a 'aabb) (eq? type-b 'aabb)) (aabb-aabb-manifold a b)) ((and (eq? type-a 'circle) (eq? type-b 'circle)) (circle-circle-manifold a b)) ((and (eq? type-a 'circle) (eq? type-b 'aabb)) (circle-aabb-manifold a b)) ((and (eq? type-a 'aabb) (eq? type-b 'circle)) (let ((m (circle-aabb-manifold b a))) (if m (list (vec2-neg (car m)) (cadr m) (caddr m)) #f))) ((and (eq? type-a 'circle) (eq? type-b 'polygon)) (circle-polygon-manifold a b)) ((and (eq? type-a 'polygon) (eq? type-b 'circle)) (let ((m (circle-polygon-manifold b a))) (if m (list (vec2-neg (car m)) (cadr m) (caddr m)) #f))) ((and (eq? type-a 'polygon) (eq? type-b 'polygon)) (polygon-polygon-manifold a b)) ((and (eq? type-a 'aabb) (eq? type-b 'polygon)) (polygon-polygon-manifold (aabb-to-polygon a) b)) ((and (eq? type-a 'polygon) (eq? type-b 'aabb)) (polygon-polygon-manifold a (aabb-to-polygon b))) (else #f))))"))
(task-entry (id "physics/classical/world/world-detect-collisions") (skill physics/classical) (module world) (tier 2) (difficulty 23549) (name world-detect-collisions) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2 \x27;integrators \x27;collision-detection \x27;collision-response \x27;raycasting \x27;constraints \x27;constraint-solver \x27;sort)) (available (make-entity entity? entity-id entity-body entity-shape entity-material entity-user-data entity-with-body entity-pos entity-vel entity-static? transform-shape entity-world-shape make-world-config config-fixed-dt config-max-substeps config-solver-iterations config-cell-size make-world world? world-entities world-gravity world-spatial-hash world-config world-time-acc world-constraints world-with-time-acc world-add-entity! world-remove-entity! world-get-entity world-entity-list world-update-entity! world-add-constraint! world-remove-constraint! world-get-constraint world-constraint-list world-update-constraint! make-force-acc force-acc-add! force-acc-get force-acc-clear! world-step! world-fixed-step! world-resolve-collision-velocities! world-correct-collision-positions! world-solve-constraint-velocities! world-correct-constraint-positions! world-integrate-velocities! world-integrate-positions!)) (answer "(define (world-detect-collisions world) (let* ((hash (world-spatial-hash world)) (entities (world-entity-list world))) (spatial-hash-clear! hash) (for-each (lambda (e) (spatial-hash-insert! hash (entity-id e) (shape-aabb (entity-world-shape e)))) entities) (let ((checked (make-hashtable equal-hash equal?)) (collisions '())) (for-each (lambda (e) (let* ((id-a (entity-id e)) (shape-a (entity-world-shape e)) (candidates (spatial-hash-query hash (shape-aabb shape-a)))) (for-each (lambda (id-b) (when (and (not (eq? id-a id-b)) (not (hashtable-ref checked (make-pair-key id-a id-b) #f))) (hashtable-set! checked (make-pair-key id-a id-b) #t) (let* ((ent-b (world-get-entity world id-b)) (shape-b (entity-world-shape ent-b)) (manifold (shapes-manifold shape-a shape-b))) (when manifold (set! collisions (cons (list e ent-b manifold) collisions)))))) candidates))) entities) collisions)))"))
