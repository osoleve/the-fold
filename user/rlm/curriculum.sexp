(task-entry (id "game-theory/matching/find-proposer-idx") (skill game-theory) (module matching) (tier 1) (difficulty 13217) (name find-proposer-idx) (type "") (description "") (notes ()) (section gale-shapley) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx)) (answer "(define (find-proposer-idx proposers p-id) (let ((n (vector-length proposers))) (let loop ((i 0)) (cond ((= i n) #f) ((equal? (vector-ref proposers i) p-id) i) (else (loop (+ i 1)))))))"))
