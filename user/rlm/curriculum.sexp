(task-entry (id "fp/templates/verify-monoid-laws") (skill fp) (module templates) (tier 1) (difficulty 10617) (name verify-monoid-laws) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators)) (available (make-monoid monoid? monoid-mempty monoid-mappend monoid-sum monoid-product monoid-list monoid-string monoid-all monoid-any monoid-first monoid-last monoid-max monoid-min monoid-endo mconcat mtimes)) (answer "(define (verify-monoid-laws m test-values) (let ((e (monoid-mempty m)) (op (monoid-mappend m))) (and (andmap (lambda (x) (equal? (op e x) x)) test-values) (andmap (lambda (x) (equal? (op x e) x)) test-values) (let check-assoc ((vs test-values)) (if (< (length vs) 3) #t (let ((x (car vs)) (y (cadr vs)) (z (caddr vs))) (and (equal? (op (op x y) z) (op x (op y z))) (check-assoc (cdr vs)))))))))"))
