(task-entry (id "fp/cost-analysis/estimate-work-with-fuel") (skill fp) (module cost-analysis) (tier 1) (difficulty 10613) (name estimate-work-with-fuel) (type "(-> Expr Nat Nat)") (description "Core work estimator with fuel for termination guarantee.") (notes ()) (section work-estimation-engine) (deps (\x27;prelude \x27;sort)) (available (*parallel-overhead* *min-parallel-work* min-parallel-threshold set-parallel-threshold! get-parallel-overhead set-parallel-overhead! *primitive-costs* *hof-costs* operation-cost *form-costs* form-cost *estimate-work-fuel* estimate-work)) (answer "(define (estimate-work-with-fuel expr fuel) (if (<= fuel 0) 0 (cond ((or (number? expr) (string? expr) (boolean? expr) (char? expr)) 1) ((symbol? expr) 1) ((null? expr) 1) ((pair? expr) (let ((head (car expr)) (args (if (pair? (cdr expr)) (cdr expr) '()))) (cond ((eq? head 'quote) 1) ((memq head '(lambda fn)) (+ (form-cost head) (estimate-work-with-fuel (last expr) (- fuel 1)))) ((memq head '(let let* letrec)) (estimate-let-work expr fuel)) ((eq? head 'if) (+ (form-cost 'if) (estimate-work-with-fuel (cadr expr) (- fuel 1)) (estimate-branch-work (cddr expr) (- fuel 1)))) ((eq? head 'cond) (+ (form-cost 'cond) (estimate-cond-work (cdr expr) (- fuel 1)))) ((eq? head 'begin) (+ (form-cost 'begin) (fold-left + 0 (map (lambda (e) (estimate-work-with-fuel e (- fuel 1))) args)))) ((assq head *hof-costs*) (estimate-hof-work head args fuel)) ((assq head *primitive-costs*) (+ (operation-cost head) (fold-left + 0 (map (lambda (e) (estimate-work-with-fuel e (- fuel 1))) args)))) (else (+ 10 (estimate-work-with-fuel head (- fuel 1)) (fold-left + 0 (map (lambda (e) (estimate-work-with-fuel e (- fuel 1))) args))))))) (else 1))))"))
(task-entry (id "fp/rule/pattern-vars-unique") (skill fp) (module rule) (tier 1) (difficulty 10613) (name pattern-vars-unique) (type "(-> Pattern (List Symbol))") (description "Collect unique metavariable names from a pattern.") (notes ()) (section pattern-utilities) (deps (\x27;prelude)) (available (get-opt make-rule rule? rule-name rule-lhs rule-rhs rule-category rule-direction rule-conditions metavar? metavar-name metavar-constraint pattern-vars)) (answer "(define (pattern-vars-unique pattern) (let ((vars (pattern-vars pattern))) (let loop ((vs vars) (seen '()) (acc '())) (cond ((null? vs) (reverse acc)) ((memq (car vs) seen) (loop (cdr vs) seen acc)) (else (loop (cdr vs) (cons (car vs) seen) (cons (car vs) acc)))))))"))
