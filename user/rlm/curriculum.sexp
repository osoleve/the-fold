(task-entry (id "physics/classical/integrators/integrate-rigid-body-verlet") (skill physics/classical) (module integrators) (tier 2) (difficulty 23541) (name integrate-rigid-body-verlet) (type "") (description "") (notes ()) (section rigid) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic integrate-body-verlet integrate-body-rk4 make-time-acc time-acc? time-acc-remaining time-acc-fixed-dt time-acc-max-steps time-acc-add time-acc-consume time-acc-alpha substep-body integrate-with-substeps interpolate-body gravity-force spring-force drag-force constant-force combine-forces body-kinetic-energy body-potential-energy body-spring-energy body-total-energy integrate-rigid-body-symplectic integrate-rigid-body-euler)) (answer "(define (integrate-rigid-body-verlet body force-fn torque-fn dt) (if (rigid-body-static? body) body (let* ((pos (rigid-body-pos body)) (vel (rigid-body-vel body)) (angle (rigid-body-angle body)) (omega (rigid-body-angular-vel body)) (inv-m (rigid-body-inv-mass body)) (inv-i (rigid-body-inv-inertia body)) (accel (vec2-scale (force-fn body) inv-m)) (alpha (* (torque-fn body) inv-i)) (half-dt (/ dt 2)) (new-pos (vec2-add (vec2-add pos (vec2-scale vel dt)) (vec2-scale accel (* 0.5 dt dt)))) (new-angle (+ angle (* omega dt) (* 0.5 alpha dt dt))) (temp-body (rigid-body-with-state body new-pos vel new-angle omega)) (accel-new (vec2-scale (force-fn temp-body) inv-m)) (alpha-new (* (torque-fn temp-body) inv-i)) (new-vel (vec2-add vel (vec2-scale (vec2-add accel accel-new) half-dt))) (new-omega (+ omega (* 0.5 (+ alpha alpha-new) dt)))) (rigid-body-with-state body new-pos new-vel new-angle new-omega))))"))
