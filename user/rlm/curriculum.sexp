(task-entry (id "topology/persistent/diagram-bottleneck") (skill topology) (module persistent) (tier 1) (difficulty 11838) (name diagram-bottleneck) (type "(-> PersistenceDiagram PersistenceDiagram Integer Number)") (description "Compute bottleneck distance between diagrams in dimension dim") (notes ("Uses a simple O(n³) algorithm. For large diagrams, use Hungarian method")) (section distance-metrics) (deps (\x27;homology)) (available (make-filtration filtration? filtration-pairs filtration-order lex<? filtration-simplices filtration-size euclidean-distance rips-filtration build-distance-matrix dist-ref build-rips-pairs rips-k-simplices max-pairwise-distance for-each-combination persistence-reduce build-simplex-index build-boundary-columns reduce-column! symmetric-difference collect-essential hashtable-keys-list make-persistence-result persistence-result? persistence-pairs persistence-essential persistence-birth-times persistence-simplices make-persistence-diagram persistence-diagram? diagram-points diagram-points-dim diagram-betti diagram->barcode car< barcode? barcode-intervals barcode-print)) (answer "(define (diagram-bottleneck d1 d2 dim) (let* ((pts1 (filter-finite (diagram-points-dim d1 dim))) (pts2 (filter-finite (diagram-points-dim d2 dim))) (n1 (length pts1)) (n2 (length pts2))) (if (and (= n1 0) (= n2 0)) 0.0 (bottleneck-greedy pts1 pts2))))"))
