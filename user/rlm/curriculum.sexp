(task-entry (id "linalg/dep-linalg/vec-map-typed") (skill linalg) (module dep-linalg) (tier 0) (difficulty 405) (name vec-map-typed) (type "Π n A B. (A → B) → Vec n A → Vec n B") (description "Maps a function over a vector, preserving length.") (notes ()) (section vector-operations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (dep-linalg-types vec-append-typed vec-zip-typed vec-head-typed vec-tail-typed)) (answer "(define (vec-map-typed n A B f v) (vec-map f v))"))
