(task-entry (id "fp/verify/free-vars-helper") (skill fp) (module verify) (tier 1) (difficulty 10623) (name free-vars-helper) (type "") (description "") (notes ()) (section free-variable-analysis) (deps (\x27;prelude \x27;normalize \x27;trace)) (available (alpha-equiv? alpha-normalize struct-equiv? equiv-ok equiv-error equiv-ok? equiv-error? equiv-result equiv-reason verify-equivalence quick-equiv? full-equiv? verify-trace verify-trace-steps trace-all-valid? make-certificate current-time date->seconds equiv-certificate find-difference find-diff-helper diff-description free-vars)) (answer "(define (free-vars-helper expr bound) (cond ((symbol? expr) (if (memq expr bound) '() (list expr))) ((not (pair? expr)) '()) ((and (eq? (car expr) 'fn) (pair? (cdr expr)) (pair? (cadr expr)) (symbol? (caadr expr))) (let ((param (caadr expr)) (body (caddr expr))) (free-vars-helper body (cons param bound)))) ((and (eq? (car expr) 'let) (pair? (cdr expr)) (pair? (cadr expr)) (pair? (caadr expr))) (let* ((binding (caadr expr)) (var (car binding)) (val (cadr binding)) (body (caddr expr))) (append (free-vars-helper val bound) (free-vars-helper body (cons var bound))))) (else (append (free-vars-helper (car expr) bound) (free-vars-helper (cdr expr) bound)))))"))
