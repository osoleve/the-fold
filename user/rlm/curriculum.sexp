(task-entry (id "fp/expr/power") (skill fp) (module expr) (tier 1) (difficulty 10613) (name power) (type "(-> Expr Expr Expr)") (description "Create power with basic simplifications") (notes ("0^0 returns 1 following CAS convention")) (section smart-constructors) (deps (\x27;prelude)) (available (num var make-sum make-product make-diff make-neg make-div make-pow make-app sum product difference division)) (answer "(define (power base exp) (cond ((and (num? exp) (= (num-val exp) 0)) (num 1)) ((and (num? exp) (= (num-val exp) 1)) base) ((and (num? base) (= (num-val base) 0) (num? exp)) (cond ((> (num-val exp) 0) (num 0)) ((< (num-val exp) 0) (list '^ base exp)) (else (num 1)))) ((and (num? base) (= (num-val base) 1)) (num 1)) ((and (num? base) (num? exp) (integer? (num-val exp)) (<= (abs (num-val exp)) 10)) (num (expt (num-val base) (num-val exp)))) (else (list '^ base exp))))"))
(task-entry (id "fp/simplify/simplify-diff") (skill fp) (module simplify) (tier 1) (difficulty 10613) (name simplify-diff) (type "(-> Expr Expr Expr)") (description "Simplify difference expression") (notes ()) (section difference-and-negation) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list)) (answer "(define (simplify-diff left right) (cond ((and (num? right) (= (num-val right) 0)) left) ((and (num? left) (= (num-val left) 0)) (simplify-neg right)) ((and (num? left) (num? right)) (num (- (num-val left) (num-val right)))) ((expr=? left right) (num 0)) ((and (difference? right) (not (diff-right right))) (sum left (diff-left right))) (else (difference left right))))"))
