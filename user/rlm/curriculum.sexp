(task-entry (id "random/monte-carlo/rejection-sample-bounded") (skill random) (module monte-carlo) (tier 1) (difficulty 12915) (name rejection-sample-bounded) (type "") (description "") (notes ()) (section rejection-sampling) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n)) (answer "(define (rejection-sample-bounded f a b M) (make-state (lambda (gen) (let loop ((g gen)) (let* ((result1 (run-state (random-float-range a b) g)) (x (car result1)) (g1 (cdr result1)) (result2 (run-state random-float g1)) (u (car result2)) (g2 (cdr result2))) (if (< (* u M) (f x)) (cons x g2) (loop g2)))))))"))
