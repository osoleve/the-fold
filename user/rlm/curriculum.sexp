(task-entry (id "control-systems/stability/matrix-swap-rows!") (skill control-systems) (module stability) (tier 2) (difficulty 22643) (name matrix-swap-rows!) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes nyquist-plot-points nyquist-count-encirclements winding-number angle-difference nyquist-stable? gain-margin phase-margin stability-margins find-crossover find-crossover-value bibo-stable? bibo-stable-discrete? controllability-matrix build-controllability-cols matrix-hcat-list controllable? observability-matrix build-observability-rows matrix-vcat-list observable? stability-matrix-rank matrix-copy)) (answer "(define (matrix-swap-rows! M i j) (let ((n (matrix-cols M))) (do ((k 0 (+ k 1))) ((= k n)) (let ((tmp (matrix-ref M i k))) (matrix-set! M i k (matrix-ref M j k)) (matrix-set! M j k tmp)))))"))
(task-entry (id "control-systems/controller-design/sensitivity-tf") (skill control-systems) (module controller-design) (tier 2) (difficulty 22643) (name sensitivity-tf) (type "TF × TF → TF") (description "Compute sensitivity transfer function S(s) = 1/(1 + G(s)C(s))") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub vector->row-matrix bass-gura-W observer-design-ackermann observer-design-place lqr solve-care kronecker-product matrix-vec matrix-unvec lyapunov-solve matrix-solve-lu forward-sub back-sub lyapunov-solve-iterative matrix-frobenius-norm-local dlqr solve-dare lqg hinf-norm vector-max hinf-bounded? closed-loop-tf)) (answer "(define (sensitivity-tf plant controller) (let* ((GC (tf-series plant controller)) (num-GC (tf-num GC)) (den-GC (tf-den GC)) (new-den (poly-add den-GC num-GC))) (make-tf den-GC new-den)))"))
