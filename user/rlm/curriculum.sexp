(task-entry (id "physics/classical/collision-detection/make-aabb-from-points") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23509) (name make-aabb-from-points) (type "") (description "") (notes ()) (section shape) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center)) (answer "(define (make-aabb-from-points points) (if (null? points) (make-aabb (vec2 0 0) (vec2 0 0)) (let loop ((pts (cdr points)) (min-p (car points)) (max-p (car points))) (if (null? pts) (make-aabb min-p max-p) (loop (cdr pts) (vec2-min min-p (car pts)) (vec2-max max-p (car pts)))))))"))
