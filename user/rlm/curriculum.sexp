(task-entry (id "egraph/egraph/egraph-lookup") (skill egraph) (module egraph) (tier 1) (difficulty 10018) (name egraph-lookup) (type "(-> EGraph ENode (Or EClassId #f))") (description "Look up e-node in hashcons, return canonical e-class ID or #f.") (notes ()) (section operations) (deps (\x27;prelude \x27;egraph/union-find \x27;egraph/eclass)) (available (egraph-tag make-egraph egraph? egraph-uf egraph-classes egraph-hashcons egraph-dirty-set egraph-stats egraph-stat-adds egraph-stat-merges egraph-stat-rebuilds egraph-stat-hits egraph-inc-stat! egraph-dirty egraph-mark-dirty! egraph-clear-dirty! egraph-pop-dirty! egraph-find)) (answer "(define (egraph-lookup eg enode) (let* ((uf (egraph-uf eg)) (canonical (enode-canonicalize enode uf)) (hashcons (egraph-hashcons eg)) (found (hashtable-ref hashcons canonical #f))) (and found (uf-find uf found))))"))
(task-entry (id "egraph/match/rule-lhs") (skill egraph) (module match) (tier 1) (difficulty 10018) (name rule-lhs) (type "") (description "") (notes ()) (section rules) (deps (\x27;prelude \x27;egraph/egraph)) (available (pattern-var? pattern-var-name empty-subst subst-lookup subst-extend subst-compatible? subst-try-extend subst-merge ematch-pattern ematch-children ematch ematch-all eclass-ref-tag make-eclass-ref eclass-ref? eclass-ref-id pattern-apply make-rule)) (answer "(define (rule-lhs rule) (car rule))"))
