(task-entry (id "linalg/numeric-instances/matrix/") (skill linalg) (module numeric-instances) (tier 0) (difficulty 433) (name matrix/) (type "") (description "") (notes ()) (section matrix-num-instance) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (vec+ vec- vec* vec-abs vec-signum vec-from-integer vec/ vec-recip vec-pi vec-exp vec-log vec-sqrt vec-pow vec-sin vec-cos vec-tan vec-asin vec-acos vec-atan vec-sinh vec-cosh vec-tanh vec-asinh vec-acosh vec-atanh matrix+ matrix- matrix-hadamard matrix* matrix-negate matrix-abs matrix-signum matrix-from-integer)) (answer "(define (matrix/ m1 m2) (let ((r1 (matrix-rows m1)) (c1 (matrix-cols m1)) (r2 (matrix-rows m2)) (c2 (matrix-cols m2))) (if (or (not (= r1 r2)) (not (= c1 c2))) (quasiquote (error dimension-mismatch ((unquote r1) (unquote c1)) ((unquote r2) (unquote c2)))) (let ((data1 (matrix-data m1)) (data2 (matrix-data m2)) (result (make-vector (* r1 c1) 0))) (do ((i 0 (+ i 1))) ((= i (* r1 c1))) (vector-set! result i (/ (vector-ref data1 i) (vector-ref data2 i)))) (list 'matrix r1 c1 result)))))"))
