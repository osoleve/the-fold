(task-entry (id "dataset/difficulty/stage-categories") (skill dataset) (module difficulty) (tier 1) (difficulty 13432) (name stage-categories) (type "") (description "") (notes ()) (section curriculum) (deps (\x27;prelude)) (available (make-difficulty-vector difficulty-vec? dv-inference-depth dv-object-count dv-temporal-steps dv-visual-precision dv-formula-complexity inference-direct inference-derivative inference-latent inference-system classify-inference-depth difficulty-weights difficulty-score difficulty-score-default difficulty-tier tier-order tier-compare make-solvability-check solvability-check? solvability-constraints check-temporal-resolution check-visual-distinctness check-discretization spatial-difficulty kinematic-difficulty dynamic-difficulty constraint-difficulty adjust-for-objects adjust-for-frames adjust-for-precision curriculum-stages)) (answer "(define (stage-categories stage) (case stage ((object-permanence) '(count size position distance)) ((linear-motion) '(velocity direction speed)) ((gravity) '(velocity trajectory position)) ((collisions) '(velocity momentum restitution mass)) ((multi-step) '(trajectory collision velocity)) ((constraints) '(period frequency amplitude)) (else '())))"))
(task-entry (id "dataset/sample/sexp->sample") (skill dataset) (module sample) (tier 1) (difficulty 13433) (name sexp->sample) (type "") (description "") (notes ()) (section rendering) (deps (\x27;prelude \x27;optics \x27;parameter)) (available (make-sample sample? sample-id sample-frames sample-question sample-options sample-answer sample-metadata sample-id-lens sample-frames-lens sample-question-lens sample-options-lens sample-answer-lens sample-metadata-lens sample-category sample-difficulty sample-params sample-with-meta make-qa-lens qa-lens? qa-lens-question qa-lens-answer qa-extract-question qa-extract-answer make-option option-label option-text make-options option-by-label fisher-yates-shuffle shuffle-options sample->prompt sample->sexp)) (answer "(define (sexp->sample sexp) (if (and (pair? sexp) (eq? (car sexp) 'sample)) (let* ((fields (cdr sexp)) (get (lambda (key) (cdr (assq key fields)))) (id (car (get 'id))) (frames (get 'frames)) (question (car (get 'question))) (opts-raw (get 'options)) (options (map (lambda (o) (cons (car o) (cadr o))) opts-raw)) (answer (car (get 'answer))) (metadata (get 'metadata))) (make-sample id frames question options answer metadata)) (error 'sexp->sample \"Invalid sample S-expression\")))"))
(task-entry (id "dataset/parameter/params-perturb-one") (skill dataset) (module parameter) (tier 1) (difficulty 13433) (name params-perturb-one) (type "") (description "") (notes ()) (section perturbation) (deps (\x27;prelude \x27;prng \x27;distributions)) (available (make-prng prng-next-float prng-next-int make-param-range param-range? param-range-name param-range-min param-range-max param-range-strategy param-range-constraint uniform-range range-int range-normal range-choice param-range-choice? param-range-choice-name param-range-choice-values param-range-choice-constraint range-with-constraint param-sample-raw sample-normal param-sample param-sample-default make-param-set param-set? param-set-ranges param-set-joint-constraint param-set-sample-raw param-set-sample param-get param-interpolate params-interpolate param-perturb)) (answer "(define (params-perturb-one ps params name epsilon rng) (map (lambda (r) (let ((rname (cond ((param-range? r) (param-range-name r)) ((param-range-choice? r) (param-range-choice-name r)) (else 'unnamed)))) (if (eq? rname name) (cons rname (param-perturb r (param-get params name) epsilon rng)) (cons rname (param-get params rname))))) (param-set-ranges ps)))"))
(task-entry (id "dataset/presentation/element-height") (skill dataset) (module presentation) (tier 1) (difficulty 13433) (name element-height) (type "") (description "") (notes ()) (section dimensions) (deps (\x27;prelude \x27;layout)) (available (make-text-block text-block? text-block-content text-block-width text-block-alignment make-frame-block frame-block? frame-block-content frame-block-width frame-block-height frame-block-border? make-textbox textbox? textbox-label textbox-pairs textbox-width textbox-style make-spacer spacer? spacer-height make-divider divider? divider-width divider-char layout-vstack layout-vstack? layout-vstack-elements layout-hstack layout-hstack? layout-hstack-elements layout-hstack-gap layout-beside layout-above)) (answer "(define (element-height elem) (cond ((text-block? elem) (length (wrap-text (text-block-content elem) (text-block-width elem)))) ((frame-block? elem) (+ (frame-block-height elem) (if (frame-block-border? elem) 2 0))) ((textbox? elem) (+ 2 (length (textbox-pairs elem)))) ((spacer? elem) (spacer-height elem)) ((divider? elem) 1) ((layout-vstack? elem) (apply + (map element-height (layout-vstack-elements elem)))) ((layout-hstack? elem) (apply max (cons 0 (map element-height (layout-hstack-elements elem))))) (else 1)))"))
(task-entry (id "dataset/difficulty/stage-max-difficulty") (skill dataset) (module difficulty) (tier 1) (difficulty 13433) (name stage-max-difficulty) (type "") (description "") (notes ()) (section curriculum) (deps (\x27;prelude)) (available (make-difficulty-vector difficulty-vec? dv-inference-depth dv-object-count dv-temporal-steps dv-visual-precision dv-formula-complexity inference-direct inference-derivative inference-latent inference-system classify-inference-depth difficulty-weights difficulty-score difficulty-score-default difficulty-tier tier-order tier-compare make-solvability-check solvability-check? solvability-constraints check-temporal-resolution check-visual-distinctness check-discretization spatial-difficulty kinematic-difficulty dynamic-difficulty constraint-difficulty adjust-for-objects adjust-for-frames adjust-for-precision curriculum-stages stage-categories)) (answer "(define (stage-max-difficulty stage) (case stage ((object-permanence) 2.0) ((linear-motion) 4.0) ((gravity) 5.0) ((collisions) 6.5) ((multi-step) 7.5) ((constraints) 9.0) (else 5.0)))"))
(task-entry (id "dataset/sample/sample-valid?") (skill dataset) (module sample) (tier 1) (difficulty 13434) (name sample-valid?) (type "") (description "") (notes ()) (section validation) (deps (\x27;prelude \x27;optics \x27;parameter)) (available (make-sample sample? sample-id sample-frames sample-question sample-options sample-answer sample-metadata sample-id-lens sample-frames-lens sample-question-lens sample-options-lens sample-answer-lens sample-metadata-lens sample-category sample-difficulty sample-params sample-with-meta make-qa-lens qa-lens? qa-lens-question qa-lens-answer qa-extract-question qa-extract-answer make-option option-label option-text make-options option-by-label fisher-yates-shuffle shuffle-options sample->prompt sample->sexp sexp->sample)) (answer "(define (sample-valid? s) (and (sample? s) (string? (sample-id s)) (list? (sample-frames s)) (andmap string? (sample-frames s)) (string? (sample-question s)) (list? (sample-options s)) (= (length (sample-options s)) 4) (memq (sample-answer s) '(A B C D)) (list? (sample-metadata s))))"))
(task-entry (id "dataset/parameter/interpolate-text") (skill dataset) (module parameter) (tier 1) (difficulty 13434) (name interpolate-text) (type "") (description "Replace ${name} placeholders with parameter values from alist") (notes ()) (section text-interpolation) (deps (\x27;prelude \x27;prng \x27;distributions)) (available (make-prng prng-next-float prng-next-int make-param-range param-range? param-range-name param-range-min param-range-max param-range-strategy param-range-constraint uniform-range range-int range-normal range-choice param-range-choice? param-range-choice-name param-range-choice-values param-range-choice-constraint range-with-constraint param-sample-raw sample-normal param-sample param-sample-default make-param-set param-set? param-set-ranges param-set-joint-constraint param-set-sample-raw param-set-sample param-get param-interpolate params-interpolate param-perturb params-perturb-one)) (answer "(define (interpolate-text template params) (let loop ((chars (string->list template)) (result '()) (in-var #f) (var-chars '())) (cond ((null? chars) (if in-var (list->string (reverse (append var-chars (cons #\\{ (cons #\\$ result))))) (list->string (reverse result)))) ((and (not in-var) (char=? (car chars) #\\$) (pair? (cdr chars)) (char=? (cadr chars) #\\{)) (loop (cddr chars) result #t '())) ((and in-var (char=? (car chars) #\\})) (let* ((var-name (string->symbol (list->string (reverse var-chars)))) (pair (assq var-name params)) (val-str (if pair (format-param-value (cdr pair)) (string-append \"${\" (symbol->string var-name) \"}\")))) (loop (cdr chars) (append (reverse (string->list val-str)) result) #f '()))) (in-var (loop (cdr chars) result #t (cons (car chars) var-chars))) (else (loop (cdr chars) (cons (car chars) result) #f '())))))"))
