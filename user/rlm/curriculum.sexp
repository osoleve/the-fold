(task-entry (id "control-systems/tf-convert/tf->ss") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22604) (name tf->ss) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier faddeev-leverrier compute-tf-numerator)) (answer "(define (tf->ss tf) (let* ((num (tf-num tf)) (den (tf-den tf)) (n (poly-degree den)) (m (poly-degree num))) (cond ((= n 0) (let ((gain (/ (poly-leading num) (poly-leading den)))) (make-ss (make-matrix 0 0 0) (make-matrix 0 1 0) (make-matrix 1 0 0) (make-matrix 1 1 gain)))) (else (tf->ss-controllable num den n m)))))"))
