(task-entry (id "diffgeo/lie-groups/so3-log") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10737) (name so3-log) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp so2-log so3? so3-matrix make-so3-from-matrix make-so3 so3-identity so3-compose so3-inverse so3-act so3-alg? so3-alg-vec make-so3-alg so3-hat so3-vee so3-alg-to-matrix so3-matrix-to-alg so3-exp)) (answer "(define (so3-log g) (let* ((R (so3-matrix g)) (tr (matrix-trace R)) (cos-theta (/ (- tr 1) 2))) (cond ((> cos-theta (- 1 *lie-epsilon*)) (let* ((R-Rt (matrix-sub R (matrix-transpose R))) (omega-hat (matrix-scale 0.5 R-Rt))) (make-so3-alg (so3-vee omega-hat)))) ((< cos-theta (- -1 (- *lie-epsilon*))) (let* ((theta *pi*) (R-Rt (matrix-sub R (matrix-transpose R))) (omega-hat (matrix-scale (/ 1.0 2) R-Rt)) (omega (so3-vee omega-hat)) (n (vec-norm omega))) (if (< n *lie-epsilon*) (let* ((d0 (+ 1 (matrix-ref R 0 0))) (d1 (+ 1 (matrix-ref R 1 1))) (d2 (+ 1 (matrix-ref R 2 2))) (max-d (max d0 (max d1 d2)))) (cond ((= max-d d0) (make-so3-alg (vec-scale (/ theta (sqrt (* 2 d0))) (vector d0 (matrix-ref R 0 1) (matrix-ref R 0 2))))) ((= max-d d1) (make-so3-alg (vec-scale (/ theta (sqrt (* 2 d1))) (vector (matrix-ref R 1 0) d1 (matrix-ref R 1 2))))) (else (make-so3-alg (vec-scale (/ theta (sqrt (* 2 d2))) (vector (matrix-ref R 2 0) (matrix-ref R 2 1) d2)))))) (make-so3-alg (vec-scale (/ theta n) omega))))) (else (let* ((theta (acos cos-theta)) (R-Rt (matrix-sub R (matrix-transpose R))) (factor (/ theta (* 2 (sin theta)))) (omega-hat (matrix-scale factor R-Rt))) (make-so3-alg (so3-vee omega-hat)))))))"))
(task-entry (id "diffgeo/curvature/surface-partial-u") (skill diffgeo) (module curvature) (tier 1) (difficulty 10737) (name surface-partial-u) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols compute-metric-derivatives christoffel-ref riemann-tensor compute-christoffel-derivatives make-4d-array array-4d-ref array-4d-set! dgamma-ref riemann-ref ricci-tensor scalar-curvature surface? surface-param make-surface surface-at first-fundamental-form second-fundamental-form gaussian-curvature mean-curvature principal-curvatures)) (answer "(define (surface-partial-u surf u v eps) (let ((r-plus (surface-at surf (+ u eps) v)) (r-minus (surface-at surf (- u eps) v))) (vec-scale (/ 1.0 (* 2 eps)) (vec-sub r-plus r-minus))))"))
(task-entry (id "diffgeo/geodesics/parallel-transport-step") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10737) (name parallel-transport-step) (type "") (description "") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size adaptive-geodesic-step trace-geodesic-adaptive trace-geodesic-adaptive-final trace-geodesic-adaptive-at-times exp-map-adaptive exp-map-adaptive-t log-map-adaptive vec-finite? compute-exp-jacobian-adaptive geodesic-distance-adaptive trace-geodesic trace-geodesic-final exp-map exp-map-t log-map compute-exp-jacobian solve-linear-system parallel-transport-derivative)) (answer "(define (parallel-transport-step metric state V dt) (let* ((x0 (geodesic-state-coords state)) (v0 (geodesic-state-velocity state)) (n (vector-length x0)) (d1 (geodesic-derivative metric state)) (dx1 (car d1)) (dv1 (cdr d1)) (dV1 (parallel-transport-derivative metric x0 v0 V)) (x2 (vec-add x0 (vec-scale (* 0.5 dt) dx1))) (v2 (vec-add v0 (vec-scale (* 0.5 dt) dv1))) (V2 (vec-add V (vec-scale (* 0.5 dt) dV1))) (d2 (geodesic-derivative metric (make-geodesic-state x2 v2))) (dx2 (car d2)) (dv2 (cdr d2)) (dV2 (parallel-transport-derivative metric x2 v2 V2)) (x3 (vec-add x0 (vec-scale (* 0.5 dt) dx2))) (v3 (vec-add v0 (vec-scale (* 0.5 dt) dv2))) (V3 (vec-add V (vec-scale (* 0.5 dt) dV2))) (d3 (geodesic-derivative metric (make-geodesic-state x3 v3))) (dx3 (car d3)) (dv3 (cdr d3)) (dV3 (parallel-transport-derivative metric x3 v3 V3)) (x4 (vec-add x0 (vec-scale dt dx3))) (v4 (vec-add v0 (vec-scale dt dv3))) (V4 (vec-add V (vec-scale dt dV3))) (d4 (geodesic-derivative metric (make-geodesic-state x4 v4))) (dx4 (car d4)) (dv4 (cdr d4)) (dV4 (parallel-transport-derivative metric x4 v4 V4)) (x-new (vec-add x0 (vec-scale (/ dt 6.0) (vec-add dx1 (vec-add (vec-scale 2 dx2) (vec-add (vec-scale 2 dx3) dx4)))))) (v-new (vec-add v0 (vec-scale (/ dt 6.0) (vec-add dv1 (vec-add (vec-scale 2 dv2) (vec-add (vec-scale 2 dv3) dv4)))))) (V-new (vec-add V (vec-scale (/ dt 6.0) (vec-add dV1 (vec-add (vec-scale 2 dV2) (vec-add (vec-scale 2 dV3) dV4))))))) (cons (make-geodesic-state x-new v-new) V-new)))"))
(task-entry (id "diffgeo/forms/k-form-apply") (skill diffgeo) (module forms) (tier 1) (difficulty 10737) (name k-form-apply) (type "") (description "") (notes ()) (section evaluation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices count-inversions-to-sort k-form? k-form-point k-form-chart k-form-degree k-form-components k-form-dim make-k-form k-form-zero k-form-basis cotangent->1-form \x31;-form->cotangent k-form-add k-form-sub k-form-scale k-form-negate k-form-change-chart wedge wedge* interior-product remove-at exterior-derivative insert-sorted insertion-sign d-scalar)) (answer "(define (k-form-apply kf vectors) (let ((k (k-form-degree kf)) (num-vecs (length vectors))) (cond ((not (= k num-vecs)) (quasiquote (error wrong-number-of-vectors expected (unquote k) got (unquote num-vecs)))) ((= k 0) (vector-ref (k-form-components kf) 0)) (else (let* ((point (k-form-point kf)) (chart (k-form-chart kf)) (n (chart-dim chart)) (comps (k-form-components kf)) (indices (generate-multi-indices n k)) (vec-comps (map (lambda (tv) (tangent-vector-components (if (eq? (chart-name (tangent-vector-chart tv)) (chart-name chart)) tv (tangent-change-chart tv chart)))) vectors)) (result 0)) (for-each (lambda (idx) (let ((omega-I (vector-ref comps (multi-index->offset n idx)))) (when (not (= omega-I 0)) (let ((submat (make-matrix k k 0))) (do ((j 0 (+ j 1))) ((= j k)) (let ((vj (list-ref vec-comps j))) (do ((col 0 (+ col 1))) ((= col k)) (let ((row-idx (list-ref idx col))) (matrix-set! submat j col (vector-ref vj row-idx)))))) (let ((det (matrix-det-small submat))) (set! result (+ result (* omega-I det)))))))) indices) result)))))"))
