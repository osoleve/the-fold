(task-entry (id "physics/classical/ode-integrators/kinetic-energy") (skill physics/classical) (module ode-integrators) (tier 2) (difficulty 23517) (name kinetic-energy) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (state-add state-sub state-scale state-madd euler-step midpoint-step heun-step rk4-step symplectic-euler-step symplectic-euler-step-b verlet-step velocity-verlet-step leapfrog-step integrate integrate-symplectic rk45-step integrate-adaptive)) (answer "(define (kinetic-energy vel mass) (* 0.5 mass (apply + (map (lambda (v) (* v v)) vel))))"))
(task-entry (id "physics/classical/integrators/integrate-body-verlet") (skill physics/classical) (module integrators) (tier 2) (difficulty 23517) (name integrate-body-verlet) (type "") (description "") (notes ()) (section \x32;d) (deps (\x27;prelude \x27;vec2 \x27;ode-integrators)) (available (make-body-2d body-2d? body-pos body-vel body-mass body-inv-mass body-static? body-with-pos body-with-vel body-with-state make-static-body vec2->state state->vec2 body->state state->body integrate-body-euler integrate-body-symplectic)) (answer "(define (integrate-body-verlet body force-fn dt) (if (body-static? body) body (let* ((pos (body-pos body)) (vel (body-vel body)) (inv-m (body-inv-mass body)) (accel (vec2-scale (force-fn body) inv-m)) (half-dt (/ dt 2)) (new-pos (vec2-add (vec2-add pos (vec2-scale vel dt)) (vec2-scale accel (* 0.5 dt dt)))) (new-body-temp (body-with-pos body new-pos)) (accel-new (vec2-scale (force-fn new-body-temp) inv-m)) (new-vel (vec2-add vel (vec2-scale (vec2-add accel accel-new) half-dt)))) (body-with-state body new-pos new-vel))))"))
