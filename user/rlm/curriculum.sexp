(task-entry (id "egraph/cost/compute-node-cost") (skill egraph) (module cost) (tier 1) (difficulty 10006) (name compute-node-cost) (type "(-> ENode (Hashtable ClassId Nat) NodeCostFn Nat)") (description "Compute cost of an e-node using child costs.") (notes ()) (section computation) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn compute-costs)) (answer "(define (compute-node-cost node costs node-cost-fn) (let ((child-cost-fn (lambda (class-id) (hashtable-ref costs class-id +inf.0)))) (node-cost-fn node child-cost-fn)))"))
(task-entry (id "egraph/extract/extract") (skill egraph) (module extract) (tier 1) (difficulty 10006) (name extract) (type "(-> ExtractionState ClassId Term)") (description "Extract minimum-cost term from e-class.") (notes ()) (section extract) (deps (\x27;prelude \x27;egraph/cost \x27;egraph/saturation)) (available (extraction-state-tag make-extraction-state extraction-state? state-egraph state-costs state-best-nodes)) (answer "(define (extract state class-id) (let* ((eg (state-egraph state)) (root (egraph-find eg class-id)) (best-nodes (state-best-nodes state)) (best-node (hashtable-ref best-nodes root #f))) (if (not best-node) (error 'extract \"no best node for class\" root) (let ((op (enode-op best-node)) (children (enode-children best-node))) (if (zero? (vector-length children)) op (cons op (map (lambda (i) (extract state (vector-ref children i))) (iota (vector-length children)))))))))"))
