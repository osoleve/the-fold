(task-entry (id "physics/diff/diff-constraints/traced-apply-spring-constraint") (skill physics/diff) (module diff-constraints) (tier 2) (difficulty 23130) (name traced-apply-spring-constraint) (type "") (description "") (notes ()) (section spring-constraint) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body)) (available (traced-spring-force traced-spring-force-damped make-spring-constraint spring-constraint-body-a spring-constraint-anchor-a spring-constraint-body-b spring-constraint-anchor-b spring-constraint-rest-length spring-constraint-stiffness spring-constraint-damping *distance-constraint-stiffness* *distance-constraint-damping* make-distance-constraint make-anchor-constraint anchor-constraint-body anchor-constraint-local-anchor anchor-constraint-world-target anchor-constraint-stiffness anchor-constraint-damping traced-anchor-force make-revolute-joint revolute-joint-body-a revolute-joint-anchor-a revolute-joint-body-b revolute-joint-anchor-b revolute-joint-stiffness revolute-joint-damping traced-revolute-forces traced-angular-spring-torque constraint-type)) (answer "(define (traced-apply-spring-constraint bodies spring dt) (let* ((idx-a (spring-constraint-body-a spring)) (anchor-a (spring-constraint-anchor-a spring)) (idx-b (spring-constraint-body-b spring)) (anchor-b (spring-constraint-anchor-b spring)) (rest-len (spring-constraint-rest-length spring)) (stiffness (spring-constraint-stiffness spring)) (damping (spring-constraint-damping spring)) (body-a (vector-ref bodies idx-a)) (body-b (vector-ref bodies idx-b)) (world-a (traced-local-to-world body-a anchor-a)) (world-b (traced-local-to-world body-b anchor-b)) (vel-a (traced-body-velocity-at body-a world-a)) (vel-b (traced-body-velocity-at body-b world-b)) (force-a (traced-spring-force-damped world-a world-b vel-a vel-b rest-len stiffness damping)) (force-b (traced-vec2-neg force-a)) (r-a (traced-vec2-sub world-a (traced-body-pos body-a))) (r-b (traced-vec2-sub world-b (traced-body-pos body-b))) (torque-a (traced-vec2-cross r-a force-a)) (torque-b (traced-vec2-cross r-b force-b)) (new-a (traced-apply-central-force (traced-apply-torque body-a torque-a dt) force-a dt)) (new-b (traced-apply-central-force (traced-apply-torque body-b torque-b dt) force-b dt)) (result (vector-copy bodies))) (vector-set! result idx-a new-a) (vector-set! result idx-b new-b) result))"))
