(task-entry (id "egraph/union-find/ensure-capacity!") (skill egraph) (module union-find) (tier 1) (difficulty 10009) (name ensure-capacity!) (type "") (description "") (notes ()) (section internal) (deps (\x27;prelude)) (available (uf-tag make-uf uf? uf-parent uf-rank uf-count-box uf-next-id-box uf-count uf-size)) (answer "(define (ensure-capacity! uf id) (let ((parent (uf-parent uf)) (rank (uf-rank uf))) (when (>= id (vector-length parent)) (let* ((old-len (vector-length parent)) (new-len (max (* 2 old-len) (+ id 1))) (new-parent (make-vector new-len #f)) (new-rank (make-vector new-len 0))) (do ((i 0 (+ i 1))) ((>= i old-len)) (vector-set! new-parent i (vector-ref parent i)) (vector-set! new-rank i (vector-ref rank i))) (vector-set! uf 1 new-parent) (vector-set! uf 2 new-rank)))))"))
