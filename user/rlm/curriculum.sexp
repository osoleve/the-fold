(task-entry (id "linalg/matrix-eigen/symmetric-eigen") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 416) (name symmetric-eigen) (type "") (description "") (notes ()) (section symmetric-eigen) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop eigen-decomposition)) (answer "(define (symmetric-eigen a . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (cond ((not (= n m)) (quasiquote (error not-square (unquote n) (unquote m)))) ((not (matrix-symmetric? a)) (quasiquote (error not-symmetric))) (else (let* ((max-iter (if (and (pair? opts) (integer? (car opts))) (car opts) *eigen-max-iterations*)) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (tol (if (and (pair? rest1) (number? (car rest1))) (car rest1) *eigen-tolerance*))) (symmetric-eigen-loop a (matrix-identity n) 0 max-iter tol))))))"))
(task-entry (id "linalg/iterative-solvers/gmres-arnoldi") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 416) (name gmres-arnoldi) (type "") (description "") (notes ()) (section gmres) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres gmres-outer)) (answer "(define (gmres-arnoldi a b x0 r0 beta restart tol n) (let* ((k restart) (v-list '()) (h-data (make-vector (* (+ k 1) k) 0.0)) (v1 (vec-scale (/ 1.0 beta) r0)) (_ (set! v-list (list v1))) (g (make-vector (+ k 1) 0.0)) (_ (vector-set! g 0 beta)) (cs (make-vector k 0.0)) (sn (make-vector k 0.0))) (gmres-arnoldi-loop a h-data v-list g cs sn 0 k tol n x0 r0)))"))
