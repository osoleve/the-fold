(task-entry (id "geometry/geometry-optics/ray3-origin-lens") (skill geometry) (module geometry-optics) (tier 1) (difficulty 12205) (name ray3-origin-lens) (type "") (description "") (notes ()) (section ray3-lenses) (deps (\x27;prelude \x27;optics \x27;geometry)) (available (vec3-x-lens vec3-y-lens vec3-z-lens line3-origin-lens line3-direction-lens)) (answer "(define ray3-origin-lens (make-lens ray3-origin (lambda (new-origin r) (ray3 new-origin (ray3-direction r)))))"))
(task-entry (id "geometry/shape-protocol/scene-sdf") (skill geometry) (module shape-protocol) (tier 1) (difficulty 12205) (name scene-sdf) (type "(-> (List Shape) Point3 Number)") (description "SDF for scene - minimum distance to any shape") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;vec3 \x27;geometry)) (available (distance-to-segment scene-intersect-ray scene-aabb shapes-containing-point closest-shape)) (answer "(define (scene-sdf shapes point) (if (null? shapes) +inf.0 (let loop ((shapes (cdr shapes)) (min-d (shape-distance-point (car shapes) point))) (if (null? shapes) min-d (loop (cdr shapes) (min min-d (shape-distance-point (car shapes) point)))))))"))
