(task-entry (id "algebra/galois/gf-ext-to-poly") (skill algebra) (module galois) (tier 0) (difficulty 349) (name gf-ext-to-poly) (type "") (description "") (notes ()) (section conversions) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add gf-ext-neg gf-ext-mul gf-ext-inv gf-ext-div gf-ext-equal? list-ref-or make-gf2n-element gf2n-element? gf2n-value gf2n-degree gf2n-irred make-gf2n make-gf2n-large gf2n-mul-raw gf2n-inv-raw gf2n-bit-length gf2n-from-int gf2n-to-int poly-power-mod unique-prime-divisors poly-frobenius-power rabin-irreducible? poly-irreducible? poly-has-factor-up-to-degree? poly-has-root? poly-has-monic-factor-of-degree? gf2-8-aes-irred make-gf2-8-aes gf2-4-irred make-gf2-4 gf2-16-irred make-gf2-16 gf2-32-irred make-gf2-32 make-gf-p2)) (answer "(define (gf-ext-to-poly element) (if (gf-ext-element? element) (make-polynomial (gf-ext-base-field element) (gf-ext-coeffs element)) (error 'gf-ext-to-poly \"not a GF(p^n) element\")))"))
(task-entry (id "algebra/group/image") (skill algebra) (module group) (tier 0) (difficulty 350) (name image) (type "(-> Homomorphism (List Element))") (description "Compute the image: elements in target that are hit") (notes ()) (section group-homomorphisms) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity verify-identity verify-inverses verify-group-axioms make-cyclic-group Z cyclic-generator permutation-apply permutation-compose permutation-inverse list-set permutation-identity permutation-equal? all-permutations permute-list remove make-symmetric-group S cycle-to-permutation transposition permutation-parity dihedral-op dihedral-inverse make-dihedral-group D is-subgroup? generate-subgroup make-homomorphism homomorphism? homomorphism-source homomorphism-target homomorphism-mapping homomorphism-apply verify-homomorphism is-isomorphism? kernel)) (answer "(define (image h) (let* ((source (homomorphism-source h)) (target (homomorphism-target h)) (phi (homomorphism-mapping h)) (eq? (group-equal-fn target))) (fold-left (lambda (acc x) (let ((img (phi x))) (if (ormap (lambda (y) (eq? y img)) acc) acc (cons img acc)))) '() (group-elements source))))"))
(task-entry (id "algebra/multivariate/mpoly-mul") (skill algebra) (module multivariate) (tier 0) (difficulty 350) (name mpoly-mul) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex mono-compare-grevlex make-ordering make-mpoly mpoly? mpoly-field mpoly-ring mpoly-vars mpoly-ordering mpoly-terms mpoly-normalize mpoly-combine-terms assoc-mono update-assoc-mono mpoly-zero mpoly-one mpoly-constant mpoly-var mpoly-from-terms mpoly-zero? mpoly-degree mpoly-degree-in mpoly-leading-term mpoly-leading-coeff mpoly-leading-mono mpoly-add mpoly-neg mpoly-sub mpoly-scale mpoly-mul-term)) (answer "(define (mpoly-mul p1 p2) (let ((F (mpoly-field p1)) (vars (mpoly-vars p1)) (ordering (mpoly-ordering p1))) (let loop ((terms1 (mpoly-terms p1)) (acc (mpoly-zero F vars ordering))) (if (null? terms1) acc (loop (cdr terms1) (mpoly-add acc (mpoly-mul-term p2 (car terms1))))))))"))
