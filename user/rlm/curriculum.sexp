(task-entry (id "geometry/mesh-topology/mesh-topology-summary") (skill geometry) (module mesh-topology) (tier 1) (difficulty 12224) (name mesh-topology-summary) (type "") (description "") (notes ()) (section genus-computation) (deps (\x27;homology \x27;mesh-sdf)) (available (mesh-topology-epsilon quantize vec3-key build-vertex-map mesh->simplicial-complex triangles->simplicial-complex mesh-betti-numbers mesh-euler-characteristic mesh-f-vector mesh-connected-components mesh-genus mesh-edge-counts edge-key mesh-is-manifold? mesh-edges-are-manifold? mesh-vertices-are-manifold? vertex-link-edges list-member? unique-list count-components-uf build-index-map mesh-is-closed? mesh-boundary-edges mesh-non-manifold-edges)) (answer "(define (mesh-topology-summary mesh) (let* ((sc (mesh->simplicial-complex mesh)) (f-vec (sc-f-vector sc)) (betti (sc-betti-numbers sc)) (euler (sc-euler sc)) (genus (mesh-genus mesh)) (manifold? (mesh-is-manifold? mesh)) (closed? (mesh-is-closed? mesh)) (boundary (mesh-boundary-edges mesh)) (non-manifold (mesh-non-manifold-edges mesh))) (printf \"~n=== Mesh Topology Summary ===~n\") (printf \"Triangle count:     ~a~n\" (mesh-triangle-count mesh)) (printf \"f-vector (V,E,F):   ~a~n\" f-vec) (printf \"Betti numbers:      ~a~n\" betti) (printf \"Euler characteristic: ~a~n\" euler) (printf \"Genus:              ~a~n\" genus) (printf \"Is manifold?        ~a~n\" manifold?) (printf \"Is closed?          ~a~n\" closed?) (when (not (null? boundary)) (printf \"Boundary edges:     ~a~n\" (length boundary))) (when (not (null? non-manifold)) (printf \"Non-manifold edges: ~a~n\" non-manifold)) (printf \"==============================~n\")))"))
(task-entry (id "geometry/convex-hull/normalize-angle") (skill geometry) (module convex-hull) (tier 1) (difficulty 12224) (name normalize-angle) (type "") (description "") (notes ()) (section minkowski) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line find-furthest-from-line quickhull-recurse quickhull convex-hull convex-hull-area convex-hull-perimeter point-in-convex-hull? convex-hull-centroid convex-hull-diameter extreme-point support-function minkowski-sum)) (answer "(define (normalize-angle a) (let ((two-pi (* 2 3.141592653589793))) (let loop ((angle a)) (cond ((< angle 0) (loop (+ angle two-pi))) ((>= angle two-pi) (loop (- angle two-pi))) (else angle)))))"))
(task-entry (id "geometry/voronoi/build-voronoi-edges") (skill geometry) (module voronoi) (tier 1) (difficulty 12224) (name build-voronoi-edges) (type "") (description "") (notes ()) (section construction) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell voronoi-diagram find-unbounded-sites)) (answer "(define (build-voronoi-edges triangles edge-adj sites) (let-values (((keys vals) (hashtable-entries edge-adj))) (let loop ((i 0) (edges '())) (if (>= i (vector-length keys)) edges (let* ((ek (vector-ref keys i)) (tri-list (vector-ref vals i)) (edge-pts (edge-key->points ek)) (s1 (find-site-index sites (car edge-pts))) (s2 (find-site-index sites (cdr edge-pts)))) (cond ((= (length tri-list) 2) (let ((t1 (car tri-list)) (t2 (cadr tri-list))) (loop (+ i 1) (cons (make-voronoi-edge t1 t2 s1 s2) edges)))) ((= (length tri-list) 1) (let ((t1 (car tri-list))) (loop (+ i 1) (cons (make-voronoi-edge t1 -1 s1 s2) edges)))) (else (loop (+ i 1) edges))))))))"))
(task-entry (id "geometry/geometry-optics/aabb-max-lens") (skill geometry) (module geometry-optics) (tier 1) (difficulty 12224) (name aabb-max-lens) (type "") (description "") (notes ()) (section aabb-lenses) (deps (\x27;prelude \x27;optics \x27;geometry)) (available (vec3-x-lens vec3-y-lens vec3-z-lens line3-origin-lens line3-direction-lens ray3-origin-lens ray3-direction-lens ray3-origin-x-lens ray3-origin-y-lens ray3-origin-z-lens plane3-normal-lens plane3-d-lens triangle3-p1-lens triangle3-p2-lens triangle3-p3-lens triangle3-vertices-each circle-center-lens circle-radius-lens sphere-center-lens sphere-radius-lens sphere-center-x-lens sphere-center-y-lens sphere-center-z-lens aabb-min-lens)) (answer "(define aabb-max-lens (make-lens aabb-max (lambda (new-max b) (aabb (aabb-min b) new-max))))"))
