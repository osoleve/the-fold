make-work-item box1 f1)) (item2 (make-work-item box2 f2)) (new-heap (heap-insert-by work-item-cmp item1 (heap-insert-by work-item-cmp item2 rest-heap)))) (bb-loop f-interval f-scalar new-heap new-best candidates (+ iter 2) width-tol max-iter gap-tol)))))))))"))
