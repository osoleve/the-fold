(task-entry (id "random/bayesian/gamma-posterior-mode") (skill random) (module bayesian) (tier 1) (difficulty 12922) (name gamma-posterior-mode) (type "") (description "") (notes ()) (section conjugate-prior-gamma-poisson) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance)) (answer "(define (gamma-posterior-mode prior) (let ((alpha (gamma-prior-shape prior)) (beta (gamma-prior-rate prior))) (if (>= alpha 1) (/ (- alpha 1) beta) (gamma-posterior-mean prior))))"))
(task-entry (id "random/monte-carlo/multivariate-random-walk-proposal") (skill random) (module monte-carlo) (tier 1) (difficulty 12922) (name multivariate-random-walk-proposal) (type "") (description "") (notes ()) (section metropolis-hastings-mcmc) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal)) (answer "(define (multivariate-random-walk-proposal step-sizes) (lambda (current) (state-bind (random-list (length current) random-normal-standard) (lambda (zs) (state-pure (map (lambda (x s z) (+ x (* s z))) current step-sizes zs))))))"))
(task-entry (id "random/variational-inference/full-gaussian-log-prob") (skill random) (module variational-inference) (tier 1) (difficulty 12922) (name full-gaussian-log-prob) (type "") (description "") (notes ()) (section full-covariance-gaussian) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian)) (answer "(define (full-gaussian-log-prob vfamily z) (let* ((means (full-gaussian-means vfamily)) (flat (full-gaussian-chol vfamily)) (n (length means)) (L (chol-flat-to-matrix flat n)) (diag (map (lambda (i row) (list-ref row i)) (iota-vi n) L)) (log-det (* 2 (fold-left + 0 (map log diag)))) (diff (map - z means)) (y (forward-solve L diff)) (mahal (fold-left + 0 (map (lambda (yi) (* yi yi)) y)))) (- (- (* 0.5 n (log (* 2 3.141592653589793)))) (* 0.5 log-det) (* 0.5 mahal))))"))
(task-entry (id "random/prng/xorshift128-next") (skill random) (module prng) (tier 1) (difficulty 12923) (name xorshift128-next) (type "") (description "") (notes ()) (section xorshift128+-generator) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1)) (answer "(define (xorshift128-next xs) (let* ((s0 (xorshift128-s0 xs)) (s1 (xorshift128-s1 xs)) (result (u64 (+ s0 s1))) (s1-new (bitwise-xor s0 s1)) (new-s0 (u64 (bitwise-xor (bitwise-xor (rotl64 s0 24) s1-new) (ash s1-new 16)))) (new-s1 (rotl64 s1-new 37))) (cons result (list 'xorshift128 new-s0 new-s1))))"))
(task-entry (id "random/distributions/exponential-cdf") (skill random) (module distributions) (tier 1) (difficulty 12923) (name exponential-cdf) (type "(-> Number Number Number)") (description "Exponential cumulative distribution at x") (notes ()) (section exponential-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf)) (answer "(define (exponential-cdf x rate) (if (< x 0) 0 (- 1 (exp-num (* (- rate) x)))))"))
(task-entry (id "random/probability/prob-geometric") (skill random) (module probability) (tier 1) (difficulty 12923) (name prob-geometric) (type "") (description "") (notes ()) (section sampling-from-distributions) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson)) (answer "(define (prob-geometric p) (sample (random-geometric p)))"))
(task-entry (id "random/bayesian/make-dirichlet-prior") (skill random) (module bayesian) (tier 1) (difficulty 12923) (name make-dirichlet-prior) (type "") (description "") (notes ()) (section conjugate-prior-dirichlet-multinomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode)) (answer "(define (make-dirichlet-prior alphas) (quasiquote (dirichlet-prior (unquote alphas))))"))
(task-entry (id "random/monte-carlo/gibbs-step") (skill random) (module monte-carlo) (tier 1) (difficulty 12923) (name gibbs-step) (type "") (description "") (notes ()) (section gibbs-sampling) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal)) (answer "(define (gibbs-step conditionals current) (let loop ((conds conditionals) (state current)) (if (null? conds) (state-pure state) (let ((idx (caar conds)) (sampler (cdar conds))) (state-bind (sampler state) (lambda (new-val) (loop (cdr conds) (list-update state idx new-val))))))))"))
(task-entry (id "random/variational-inference/forward-solve") (skill random) (module variational-inference) (tier 1) (difficulty 12923) (name forward-solve) (type "") (description "") (notes ()) (section full-covariance-gaussian) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob)) (answer "(define (forward-solve L b) (let loop ((rows L) (b-remaining b) (y-acc '())) (if (null? rows) (reverse y-acc) (let* ((row (car rows)) (bi (car b-remaining)) (sum (fold-left + 0 (map * (butlast row) (reverse y-acc)))) (L-ii (last row)) (yi (/ (- bi sum) L-ii))) (loop (cdr rows) (cdr b-remaining) (cons yi y-acc))))))"))
(task-entry (id "random/prng/xorshift128-random") (skill random) (module prng) (tier 1) (difficulty 12924) (name xorshift128-random) (type "") (description "") (notes ()) (section xorshift128+-generator) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next)) (answer "(define xorshift128-random (make-state xorshift128-next))"))
(task-entry (id "random/distributions/exponential-quantile") (skill random) (module distributions) (tier 1) (difficulty 12924) (name exponential-quantile) (type "(-> Number Number Number)") (description "Exponential quantile at probability p") (notes ()) (section exponential-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf)) (answer "(define (exponential-quantile p rate) (if (or (< p 0) (> p 1)) (error 'exponential-quantile \"p must be in [0,1]\" p) (if (= p 1) +inf.0 (/ (- (log-num (- 1 p))) rate))))"))
(task-entry (id "random/probability/prob-binomial") (skill random) (module probability) (tier 1) (difficulty 12924) (name prob-binomial) (type "") (description "") (notes ()) (section sampling-from-distributions) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric)) (answer "(define (prob-binomial n p) (sample (random-binomial n p)))"))
(task-entry (id "random/bayesian/dirichlet-prior?") (skill random) (module bayesian) (tier 1) (difficulty 12924) (name dirichlet-prior?) (type "") (description "") (notes ()) (section conjugate-prior-dirichlet-multinomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior)) (answer "(define (dirichlet-prior? p) (and (pair? p) (eq? (car p) 'dirichlet-prior)))"))
(task-entry (id "random/monte-carlo/list-update") (skill random) (module monte-carlo) (tier 1) (difficulty 12924) (name list-update) (type "") (description "") (notes ()) (section gibbs-sampling) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step)) (answer "(define (list-update lst idx val) (if (= idx 0) (cons val (cdr lst)) (cons (car lst) (list-update (cdr lst) (- idx 1) val))))"))
(task-entry (id "random/variational-inference/butlast") (skill random) (module variational-inference) (tier 1) (difficulty 12924) (name butlast) (type "") (description "") (notes ()) (section full-covariance-gaussian) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve)) (answer "(define (butlast lst) (if (or (null? lst) (null? (cdr lst))) '() (cons (car lst) (butlast (cdr lst)))))"))
(task-entry (id "random/prng/random-u32-from") (skill random) (module prng) (tier 1) (difficulty 12925) (name random-u32-from) (type "") (description "Get State monad for u32 generation (truncates 64-bit generators)") (notes ()) (section uniform-random-number-generation) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random)) (answer "(define (random-u32-from gen-state) (let ((bits (prng-output-bits gen-state)) (rng (prng-random gen-state))) (if (= bits 32) rng (state-map u32 rng))))"))
(task-entry (id "random/distributions/random-exponential") (skill random) (module distributions) (tier 1) (difficulty 12925) (name random-exponential) (type "(-> Number (State RNG Number))") (description "State monad sampler for exponential distribution") (notes ()) (section exponential-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile)) (answer "(define (random-exponential rate) (if (<= rate 0) (error 'random-exponential \"rate must be positive\" rate) (state-map (lambda (u) (/ (- (safe-log u)) rate)) random-float)))"))
(task-entry (id "random/probability/prob-gamma") (skill random) (module probability) (tier 1) (difficulty 12925) (name prob-gamma) (type "") (description "") (notes ()) (section sampling-from-distributions) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial)) (answer "(define (prob-gamma shape rate) (sample (random-gamma shape rate)))"))
(task-entry (id "random/bayesian/dirichlet-prior-alphas") (skill random) (module bayesian) (tier 1) (difficulty 12925) (name dirichlet-prior-alphas) (type "") (description "") (notes ()) (section conjugate-prior-dirichlet-multinomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior?)) (answer "(define (dirichlet-prior-alphas p) (cadr p))"))
(task-entry (id "random/monte-carlo/gibbs-chain") (skill random) (module monte-carlo) (tier 1) (difficulty 12925) (name gibbs-chain) (type "") (description "") (notes ()) (section gibbs-sampling) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update)) (answer "(define (gibbs-chain conditionals initial n) (let loop ((i 0) (current initial) (acc '())) (if (>= i n) (state-pure (reverse acc)) (state-bind (gibbs-step conditionals current) (lambda (next) (loop (+ i 1) next (cons next acc)))))))"))
(task-entry (id "random/variational-inference/full-gaussian-entropy") (skill random) (module variational-inference) (tier 1) (difficulty 12925) (name full-gaussian-entropy) (type "") (description "") (notes ()) (section full-covariance-gaussian) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast)) (answer "(define (full-gaussian-entropy vfamily) (let* ((n (full-gaussian-dim vfamily)) (flat (full-gaussian-chol vfamily)) (L (chol-flat-to-matrix flat n)) (diag (map (lambda (i row) (list-ref row i)) (iota-vi n) L)) (log-diag-sum (fold-left + 0 (map log diag)))) (+ (* 0.5 n (+ 1 (log (* 2 3.141592653589793)))) log-diag-sum)))"))
(task-entry (id "random/prng/random-u64-from") (skill random) (module prng) (tier 1) (difficulty 12926) (name random-u64-from) (type "") (description "Get State monad for u64 generation (combines two calls for 32-bit generators)") (notes ()) (section uniform-random-number-generation) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from)) (answer "(define (random-u64-from gen-state) (let ((bits (prng-output-bits gen-state)) (rng (prng-random gen-state))) (if (= bits 64) rng (state-bind rng (lambda (hi) (state-bind rng (lambda (lo) (state-pure (u64 (bitwise-ior (ash hi 32) lo))))))))))"))
(task-entry (id "random/distributions/uniform") (skill random) (module distributions) (tier 1) (difficulty 12926) (name uniform) (type "(-> Number Number Distribution)") (description "Create a uniform distribution on [a, b]") (notes ()) (section uniform-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential)) (answer "(define (uniform a b) (list 'uniform a b))"))
(task-entry (id "random/probability/prob-beta") (skill random) (module probability) (tier 1) (difficulty 12926) (name prob-beta) (type "") (description "") (notes ()) (section sampling-from-distributions) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma)) (answer "(define (prob-beta a b) (sample (random-beta a b)))"))
(task-entry (id "random/bayesian/dirichlet-multinomial-posterior") (skill random) (module bayesian) (tier 1) (difficulty 12926) (name dirichlet-multinomial-posterior) (type "") (description "") (notes ()) (section conjugate-prior-dirichlet-multinomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas)) (answer "(define (dirichlet-multinomial-posterior prior counts) (let ((alphas (dirichlet-prior-alphas prior))) (make-dirichlet-prior (map + alphas counts))))"))
(task-entry (id "random/monte-carlo/gibbs-sample") (skill random) (module monte-carlo) (tier 1) (difficulty 12926) (name gibbs-sample) (type "") (description "") (notes ()) (section gibbs-sampling) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain)) (answer "(define (gibbs-sample conditionals initial n-samples burn-in) (state-bind (gibbs-chain conditionals initial burn-in) (lambda (burn-samples) (let ((last-burn (if (null? burn-samples) initial (car (reverse burn-samples))))) (gibbs-chain conditionals last-burn n-samples)))))"))
(task-entry (id "random/variational-inference/vfamily-dim") (skill random) (module variational-inference) (tier 1) (difficulty 12926) (name vfamily-dim) (type "") (description "") (notes ()) (section generic-variational-family-interface) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy)) (answer "(define (vfamily-dim v) (cond ((mf-gaussian? v) (mf-gaussian-dim v)) ((full-gaussian? v) (full-gaussian-dim v)) (else (error 'vfamily-dim \"Unknown variational family\" v))))"))
(task-entry (id "random/prng/random-float") (skill random) (module prng) (tier 1) (difficulty 12927) (name random-float) (type "") (description "") (notes ()) (section uniform-random-number-generation) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from)) (answer "(define random-float (make-state (lambda (gen) (let* ((bits (prng-output-bits gen)) (result (prng-next gen)) (val (car result)) (new-gen (cdr result))) (if (= bits 32) (cons (/ val (expt 2.0 32)) new-gen) (cons (/ (ash val -11) (expt 2.0 53)) new-gen))))))"))
(task-entry (id "random/distributions/uniform-pdf") (skill random) (module distributions) (tier 1) (difficulty 12927) (name uniform-pdf) (type "(-> Number Number Number Number)") (description "Uniform probability density at x") (notes ()) (section uniform-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform)) (answer "(define (uniform-pdf x a b) (if (or (< x a) (> x b)) 0 (/ 1 (- b a))))"))
(task-entry (id "random/probability/prob-categorical") (skill random) (module probability) (tier 1) (difficulty 12927) (name prob-categorical) (type "") (description "") (notes ()) (section sampling-from-distributions) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta)) (answer "(define (prob-categorical weights) (sample (random-categorical weights)))"))
(task-entry (id "random/bayesian/dirichlet-posterior-mean") (skill random) (module bayesian) (tier 1) (difficulty 12927) (name dirichlet-posterior-mean) (type "") (description "") (notes ()) (section conjugate-prior-dirichlet-multinomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior)) (answer "(define (dirichlet-posterior-mean prior) (let* ((alphas (dirichlet-prior-alphas prior)) (sum (apply + alphas))) (map (lambda (a) (/ a sum)) alphas)))"))
(task-entry (id "random/monte-carlo/antithetic-estimate") (skill random) (module monte-carlo) (tier 1) (difficulty 12927) (name antithetic-estimate) (type "") (description "") (notes ()) (section variance-reduction-antithetic-variates) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample)) (answer "(define (antithetic-estimate f n) (let ((half-n (quotient n 2))) (state-bind (random-list half-n random-float) (lambda (us) (let* ((f-us (map f us)) (f-antithetic (map (lambda (u) (f (- 1 u))) us)) (paired-means (map (lambda (a b) (/ (+ a b) 2)) f-us f-antithetic)) (mu (sample-mean paired-means)) (se (sample-sem paired-means))) (state-pure (cons mu se)))))))"))
(task-entry (id "random/variational-inference/vfamily-sample") (skill random) (module variational-inference) (tier 1) (difficulty 12927) (name vfamily-sample) (type "") (description "") (notes ()) (section generic-variational-family-interface) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim)) (answer "(define (vfamily-sample v prng) (cond ((mf-gaussian? v) (sample-mf-gaussian v prng)) ((full-gaussian? v) (sample-full-gaussian v prng)) (else (error 'vfamily-sample \"Unknown variational family\" v))))"))
(task-entry (id "random/prng/random-float-range") (skill random) (module prng) (tier 1) (difficulty 12928) (name random-float-range) (type "") (description "") (notes ()) (section uniform-random-number-generation) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float)) (answer "(define (random-float-range lo hi) (state-map (lambda (u) (+ lo (* u (- hi lo)))) random-float))"))
(task-entry (id "random/distributions/uniform-cdf") (skill random) (module distributions) (tier 1) (difficulty 12928) (name uniform-cdf) (type "(-> Number Number Number Number)") (description "Uniform cumulative distribution at x") (notes ()) (section uniform-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf)) (answer "(define (uniform-cdf x a b) (cond ((< x a) 0) ((> x b) 1) (else (/ (- x a) (- b a)))))"))
(task-entry (id "random/probability/factor") (skill random) (module probability) (tier 1) (difficulty 12928) (name factor) (type "") (description "") (notes ()) (section conditioning) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical)) (answer "(define (factor log-prob) (make-prob (prob-add-weight log-prob)))"))
(task-entry (id "random/bayesian/dirichlet-posterior-mode") (skill random) (module bayesian) (tier 1) (difficulty 12928) (name dirichlet-posterior-mode) (type "") (description "") (notes ()) (section conjugate-prior-dirichlet-multinomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean)) (answer "(define (dirichlet-posterior-mode prior) (let* ((alphas (dirichlet-prior-alphas prior)) (K (length alphas)) (sum (apply + alphas)) (denom (- sum K))) (if (> denom 0) (map (lambda (a) (/ (- a 1) denom)) alphas) (dirichlet-posterior-mean prior))))"))
(task-entry (id "random/monte-carlo/antithetic-integrate") (skill random) (module monte-carlo) (tier 1) (difficulty 12928) (name antithetic-integrate) (type "") (description "") (notes ()) (section variance-reduction-antithetic-variates) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate)) (answer "(define (antithetic-integrate f a b n) (let ((width (- b a)) (half-n (quotient n 2))) (state-bind (random-list half-n random-float) (lambda (us) (let* ((xs (map (lambda (u) (+ a (* u width))) us)) (xs-anti (map (lambda (u) (+ a (* (- 1 u) width))) us)) (f-xs (map f xs)) (f-anti (map f xs-anti)) (paired-means (map (lambda (a b) (/ (+ a b) 2)) f-xs f-anti)) (estimate (* width (sample-mean paired-means))) (se (* width (sample-sem paired-means)))) (state-pure (cons estimate se)))))))"))
(task-entry (id "random/variational-inference/vfamily-log-prob") (skill random) (module variational-inference) (tier 1) (difficulty 12928) (name vfamily-log-prob) (type "") (description "") (notes ()) (section generic-variational-family-interface) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample)) (answer "(define (vfamily-log-prob v z) (cond ((mf-gaussian? v) (mf-gaussian-log-prob v z)) ((full-gaussian? v) (full-gaussian-log-prob v z)) (else (error 'vfamily-log-prob \"Unknown variational family\" v))))"))
(task-entry (id "random/prng/random-int-range") (skill random) (module prng) (tier 1) (difficulty 12929) (name random-int-range) (type "") (description "Generate uniform integer in [lo, hi] using rejection sampling") (notes ()) (section uniform-random-number-generation) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float random-float-range)) (answer "(define (random-int-range lo hi) (if (> lo hi) (error 'random-int-range \"lo must be <= hi\" lo hi) (let* ((range (+ (- hi lo) 1)) (threshold (modulo (- (expt 2 64)) range))) (make-state (lambda (gen) (let loop ((g gen)) (let* ((bits-per-call (prng-output-bits g)) (result (if (= bits-per-call 64) (prng-next g) (let* ((r1 (prng-next g)) (r2 (prng-next (cdr r1)))) (cons (bitwise-ior (ash (car r1) 32) (car r2)) (cdr r2))))) (bits (car result)) (new-gen (cdr result))) (if (>= bits threshold) (cons (+ lo (modulo bits range)) new-gen) (loop new-gen)))))))))"))
(task-entry (id "random/distributions/uniform-quantile") (skill random) (module distributions) (tier 1) (difficulty 12929) (name uniform-quantile) (type "(-> Number Number Number Number)") (description "Uniform quantile at probability p") (notes ()) (section uniform-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf)) (answer "(define (uniform-quantile p a b) (if (or (< p 0) (> p 1)) (error 'uniform-quantile \"p must be in [0,1]\" p) (+ a (* p (- b a)))))"))
(task-entry (id "random/probability/score") (skill random) (module probability) (tier 1) (difficulty 12929) (name score) (type "") (description "") (notes ()) (section conditioning) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor)) (answer "(define (score likelihood) (if (<= likelihood 0) (factor -inf.0) (factor (log-num likelihood))))"))
(task-entry (id "random/bayesian/log-beta-pdf") (skill random) (module bayesian) (tier 1) (difficulty 12929) (name log-beta-pdf) (type "") (description "") (notes ()) (section log-probability-functions-for-mcmc/vi) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode)) (answer "(define (log-beta-pdf x alpha beta) (cond ((or (< x 0) (> x 1)) -inf.0) ((= x 0) (if (>= alpha 1) -inf.0 +inf.0)) ((= x 1) (if (>= beta 1) -inf.0 +inf.0)) (else (let ((term1 (if (= alpha 1) 0 (* (- alpha 1) (log x)))) (term2 (if (= beta 1) 0 (* (- beta 1) (log (- 1 x)))))) (+ term1 term2 (- (log-beta alpha beta)))))))"))
(task-entry (id "random/monte-carlo/control-variate-estimate") (skill random) (module monte-carlo) (tier 1) (difficulty 12929) (name control-variate-estimate) (type "") (description "") (notes ()) (section variance-reduction-control-variates) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate antithetic-integrate)) (answer "(define (control-variate-estimate f g g-mean sampler n) (state-bind (random-list n sampler) (lambda (samples) (let* ((f-vals (map f samples)) (g-vals (map g samples)) (f-mean (sample-mean f-vals)) (g-sample-mean (sample-mean g-vals)) (g-centered (map (lambda (gv) (- gv g-sample-mean)) g-vals)) (f-centered (map (lambda (fv) (- fv f-mean)) f-vals)) (cov-fg (/ (fold-left + 0 (map * f-centered g-centered)) (- n 1))) (var-g (/ (fold-left + 0 (map (lambda (x) (* x x)) g-centered)) (- n 1))) (c (if (> var-g 0) (/ cov-fg var-g) 0)) (adjusted-vals (map (lambda (fv gv) (- fv (* c (- gv g-mean)))) f-vals g-vals)) (estimate (sample-mean adjusted-vals)) (se (sample-sem adjusted-vals))) (state-pure (cons estimate se))))))"))
(task-entry (id "random/variational-inference/vfamily-entropy") (skill random) (module variational-inference) (tier 1) (difficulty 12929) (name vfamily-entropy) (type "") (description "") (notes ()) (section generic-variational-family-interface) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob)) (answer "(define (vfamily-entropy v) (cond ((mf-gaussian? v) (mf-gaussian-entropy v)) ((full-gaussian? v) (full-gaussian-entropy v)) (else (error 'vfamily-entropy \"Unknown variational family\" v))))"))
(task-entry (id "random/prng/random-bool") (skill random) (module prng) (tier 1) (difficulty 12930) (name random-bool) (type "") (description "") (notes ()) (section uniform-random-number-generation) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float random-float-range random-int-range)) (answer "(define random-bool (state-map (lambda (n) (odd? n)) (make-state prng-next)))"))
