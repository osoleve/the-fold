(task-entry (id "control-systems/state-space/ss-from-lists") (skill control-systems) (module state-space) (tier 2) (difficulty 22609) (name ss-from-lists) (type "(-> (List (List Number)) (List (List Number)) (List (List Number)) (List (List Number)) SS)") (description "Create state space from nested lists") (notes ()) (section construction) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss)) (answer "(define (ss-from-lists A-lists B-lists C-lists D-lists) (make-ss (matrix-from-lists A-lists) (matrix-from-lists B-lists) (matrix-from-lists C-lists) (matrix-from-lists D-lists)))"))
(task-entry (id "control-systems/transfer-function/tf-strictly-proper?") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22609) (name tf-strictly-proper?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper?)) (answer "(define (tf-strictly-proper? tf) (> (tf-relative-degree tf) 0))"))
(task-entry (id "control-systems/z-transform/dtf-proper?") (skill control-systems) (module z-transform) (tier 2) (difficulty 22609) (name dtf-proper?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree)) (answer "(define (dtf-proper? dtf) (>= (dtf-relative-degree dtf) 0))"))
(task-entry (id "control-systems/tf-convert/matrix-vec-mul") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22609) (name matrix-vec-mul) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier faddeev-leverrier compute-tf-numerator tf->ss tf->ss-controllable pad-poly-coeffs matrix-column matrix-row)) (answer "(define (matrix-vec-mul M v) (let* ((rows (matrix-rows M)) (cols (matrix-cols M)) (result (make-vector rows 0))) (do ((i 0 (+ i 1))) ((= i rows) result) (let loop ((j 0) (sum 0)) (if (= j cols) (vector-set! result i sum) (loop (+ j 1) (+ sum (* (matrix-ref M i j) (vector-ref v j)))))))))"))
(task-entry (id "control-systems/kalman/kalman-gain") (skill control-systems) (module kalman) (tier 2) (difficulty 22609) (name kalman-gain) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate)) (answer "(define (kalman-gain kf) (let ((var (kalman-variance kf)) (R (kalman-R kf))) (if (zero? (+ var R)) 0 (/ var (+ var R)))))"))
(task-entry (id "control-systems/stability/routh-hurwitz-count-rhp") (skill control-systems) (module stability) (tier 2) (difficulty 22609) (name routh-hurwitz-count-rhp) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes?)) (answer "(define (routh-hurwitz-count-rhp poly) (let* ((array (routh-array poly)) (first-col (map (lambda (row) (vector-ref row 0)) array))) (count-sign-changes first-col)))"))
(task-entry (id "control-systems/controller-design/pole-placement") (skill control-systems) (module controller-design) (tier 2) (difficulty 22609) (name pole-placement) (type "SS × (List Complex) → Matrix | Error") (description "General pole placement for both SISO and MIMO systems.\nFor SISO: delegates to Ackermann's formula.\nFor MIMO: uses eigenvector assignment method.\nState feedback: u = -K*x places eigenvalues of (A - B*K) at desired locations.\nSupports complex conjugate pole pairs.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura)) (answer "(define (pole-placement sys desired-poles) (let* ((A (ss-A sys)) (B (ss-B sys)) (n (ss-order sys)) (m (matrix-cols B))) (cond ((not (= (length desired-poles) n)) '(error pole-count-mismatch)) ((= m 1) (pole-placement-ackermann sys desired-poles)) (else (pole-placement-mimo sys desired-poles)))))"))
(task-entry (id "control-systems/digital-pid/pid-prev-error") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22609) (name pid-prev-error) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral)) (answer "(define (pid-prev-error state) (caddr state))"))
(task-entry (id "control-systems/discrete-control/c2d-zoh") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22609) (name c2d-zoh) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result?)) (answer "(define (c2d-zoh sys Ts) (let* ((A (ss-A sys)) (B (ss-B sys)) (C (ss-C sys)) (D (ss-D sys)) (n (ss-order sys)) (m (ss-inputs sys))) (if (= n 0) (make-dss A B C D Ts) (let* ((block-size (+ n m)) (block (make-matrix block-size block-size 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! block i j (matrix-ref A i j)))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j m)) (matrix-set! block i (+ n j) (matrix-ref B i j)))) (let* ((scaled-block (matrix-scale Ts block)) (exp-block (matrix-exp scaled-block))) (let ((Ad (make-matrix n n 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! Ad i j (matrix-ref exp-block i j)))) (let ((Bd (make-matrix n m 0))) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j m)) (matrix-set! Bd i j (matrix-ref exp-block i (+ n j))))) (make-dss Ad Bd C D Ts))))))))"))
(task-entry (id "control-systems/hinf-synthesis/gp-D21") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22609) (name gp-D21) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12)) (answer "(define (gp-D21 gp) (list-ref gp 8))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-one-over") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22609) (name alg-poly-one-over) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over)) (answer "(define (alg-poly-one-over field) (alg-make-polynomial field (list (field-one field))))"))
(task-entry (id "control-systems/state-space/ss-state-equation") (skill control-systems) (module state-space) (tier 2) (difficulty 22610) (name ss-state-equation) (type "(-> SS Vec Vec Vec)") (description "Compute x' = A*x + B*u") (notes ()) (section operations) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists)) (answer "(define (ss-state-equation sys x u) (vec-add (matrix-vec-mul (ss-A sys) x) (matrix-vec-mul (ss-B sys) u)))"))
(task-entry (id "control-systems/transfer-function/tf-poles") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22610) (name tf-poles) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper?)) (answer "(define (tf-poles tf) (poly-roots (tf-den tf)))"))
(task-entry (id "control-systems/z-transform/dtf-poles") (skill control-systems) (module z-transform) (tier 2) (difficulty 22610) (name dtf-poles) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper?)) (answer "(define (dtf-poles dtf) (poly-roots (dtf-den dtf)))"))
(task-entry (id "control-systems/tf-convert/dot-product-cv") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22610) (name dot-product-cv) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier faddeev-leverrier compute-tf-numerator tf->ss tf->ss-controllable pad-poly-coeffs matrix-column matrix-row matrix-vec-mul)) (answer "(define (dot-product-cv v1 v2) (let ((n (vector-length v1))) (let loop ((i 0) (sum 0)) (if (= i n) sum (loop (+ i 1) (+ sum (* (vector-ref v1 i) (vector-ref v2 i))))))))"))
(task-entry (id "control-systems/kalman/kalman-batch") (skill control-systems) (module kalman) (tier 2) (difficulty 22610) (name kalman-batch) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain)) (answer "(define (kalman-batch kf observations) (fold-left kalman-estimate kf observations))"))
(task-entry (id "control-systems/stability/count-sign-changes") (skill control-systems) (module stability) (tier 2) (difficulty 22610) (name count-sign-changes) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp)) (answer "(define (count-sign-changes nums) (cond ((null? nums) 0) ((null? (cdr nums)) 0) (else (let* ((a (car nums)) (b (cadr nums)) (change (if (< (* a b) 0) 1 0))) (+ change (count-sign-changes (cdr nums)))))))"))
(task-entry (id "control-systems/controller-design/pole-placement-mimo") (skill control-systems) (module controller-design) (tier 2) (difficulty 22610) (name pole-placement-mimo) (type "SS × (List Complex) → Matrix | Error") (description "MIMO pole placement via eigenvector assignment.\nAlgorithm:\n1. For each pole λᵢ, compute feasible subspace Sᵢ = (λᵢI - A)⁻¹B\n2. Choose eigenvector vᵢ from Sᵢ (cycling through input columns)\n3. Build V = [v₁ ... vₙ] and U = [u₁ ... uₙ] where uᵢ are input directions\n4. Compute K = U V⁻¹ so that K vᵢ = uᵢ for each i\n\nSupports complex poles - the underlying matrix operations handle complex arithmetic.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement)) (answer "(define (pole-placement-mimo sys desired-poles) (let* ((A (ss-A sys)) (B (ss-B sys)) (n (ss-order sys)) (m (matrix-cols B))) (let ((C-mat (controllability-matrix sys))) (if (not (= (stability-matrix-rank C-mat) n)) '(error system-not-controllable) (eigenvector-assignment A B desired-poles n m)))))"))
(task-entry (id "control-systems/digital-pid/pid-prev-output") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22610) (name pid-prev-output) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error)) (answer "(define (pid-prev-output state) (cadddr state))"))
(task-entry (id "control-systems/discrete-control/c2d-tustin") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22610) (name c2d-tustin) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh)) (answer "(define (c2d-tustin sys Ts) (let* ((A (ss-A sys)) (B (ss-B sys)) (C (ss-C sys)) (D (ss-D sys)) (n (ss-order sys))) (if (= n 0) (make-dss A B C D Ts) (let* ((I (matrix-identity n)) (half-Ts (/ Ts 2)) (I-ATs2 (matrix-sub I (matrix-scale half-Ts A))) (I+ATs2 (matrix-add I (matrix-scale half-Ts A))) (inv (matrix-inverse I-ATs2))) (if (error-result? inv) (quasiquote (error tustin-singular-matrix (unquote inv))) (let* ((Ad (matrix-mul inv I+ATs2)) (Bd (matrix-mul (matrix-scale Ts inv) B)) (Cd C) (invB (matrix-mul inv B)) (CinvB (matrix-mul C invB)) (Dd (matrix-add D (matrix-scale half-Ts CinvB)))) (make-dss Ad Bd Cd Dd Ts)))))))"))
(task-entry (id "control-systems/hinf-synthesis/gp-D22") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22610) (name gp-D22) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21)) (answer "(define (gp-D22 gp) (list-ref gp 9))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-add") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22610) (name alg-poly-add) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over)) (answer "(define (alg-poly-add p1 p2) (let* ((F (alg-poly-field p1)) (c1 (alg-poly-coeffs p1)) (c2 (alg-poly-coeffs p2)) (add (field-add-op F))) (alg-make-polynomial F (alg-add-coeffs add c1 c2 (field-zero F)))))"))
(task-entry (id "control-systems/state-space/ss-output-equation") (skill control-systems) (module state-space) (tier 2) (difficulty 22611) (name ss-output-equation) (type "(-> SS Vec Vec Vec)") (description "Compute y = C*x + D*u") (notes ()) (section operations) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation)) (answer "(define (ss-output-equation sys x u) (vec-add (matrix-vec-mul (ss-C sys) x) (matrix-vec-mul (ss-D sys) u)))"))
(task-entry (id "control-systems/transfer-function/tf-zeros") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22611) (name tf-zeros) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles)) (answer "(define (tf-zeros tf) (poly-roots (tf-num tf)))"))
(task-entry (id "control-systems/z-transform/dtf-zeros") (skill control-systems) (module z-transform) (tier 2) (difficulty 22611) (name dtf-zeros) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles)) (answer "(define (dtf-zeros dtf) (poly-roots (dtf-num dtf)))"))
(task-entry (id "control-systems/tf-convert/matrix-trace") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22611) (name matrix-trace) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier faddeev-leverrier compute-tf-numerator tf->ss tf->ss-controllable pad-poly-coeffs matrix-column matrix-row matrix-vec-mul dot-product-cv)) (answer "(define (matrix-trace M) (let ((n (min (matrix-rows M) (matrix-cols M)))) (let loop ((i 0) (sum 0)) (if (= i n) sum (loop (+ i 1) (+ sum (matrix-ref M i i)))))))"))
(task-entry (id "control-systems/kalman/kalman-residual") (skill control-systems) (module kalman) (tier 2) (difficulty 22611) (name kalman-residual) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch)) (answer "(define (kalman-residual kf observation) (- observation (kalman-mean kf)))"))
(task-entry (id "control-systems/stability/lyapunov-solve-continuous") (skill control-systems) (module stability) (tier 2) (difficulty 22611) (name lyapunov-solve-continuous) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes)) (answer "(define (lyapunov-solve-continuous A Q) (let ((n (matrix-rows A))) (if (= n 1) (let ((a (matrix-ref A 0 0)) (q (matrix-ref Q 0 0))) (if (>= a 0) '(error unstable-system) (make-matrix 1 1 (/ (- q) (* 2 a))))) (lyapunov-iterate-continuous A Q 100))))"))
(task-entry (id "control-systems/controller-design/extract-pole-value") (skill control-systems) (module controller-design) (tier 2) (difficulty 22611) (name extract-pole-value) (type "Complex | Number → Number | Error") (description "Extract numeric value from pole specification.\nFor custom complex type: extracts real part (errors if imaginary part non-zero).\nFor native numbers: returns as-is.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo)) (answer "(define (extract-pole-value lambda-i) (cond ((and (pair? lambda-i) (eq? (car lambda-i) 'complex)) (let ((real-part (cadr lambda-i)) (imag-part (caddr lambda-i))) (if (and (number? imag-part) (not (zero? imag-part))) '(error complex-poles-not-yet-supported) real-part))) ((number? lambda-i) lambda-i) (else '(error invalid-pole-type))))"))
(task-entry (id "control-systems/digital-pid/pid-step") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22611) (name pid-step) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output)) (answer "(define (pid-step pid state error) (let* ((Kp (pid-Kp pid)) (Ki (pid-Ki pid)) (Kd (pid-Kd pid)) (Ts (pid-Ts pid)) (integral-prev (pid-integral state)) (error-prev (pid-prev-error state)) (P (* Kp error)) (integral-new (+ integral-prev (* error Ts))) (I (* Ki integral-new)) (D (* Kd (/ (- error error-prev) Ts))) (output (+ P I D)) (new-state (list 'pid-state integral-new error output))) (cons output new-state)))"))
(task-entry (id "control-systems/discrete-control/c2d-tustin-prewarp") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22611) (name c2d-tustin-prewarp) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin)) (answer "(define (c2d-tustin-prewarp sys Ts wc) (let* ((Ts-mod (* (/ 2 wc) (tan (* wc Ts 0.5))))) (c2d-tustin sys Ts-mod)))"))
(task-entry (id "control-systems/hinf-synthesis/gp-order") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22611) (name gp-order) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22)) (answer "(define (gp-order gp) (matrix-rows (gp-A gp)))"))
(task-entry (id "control-systems/poly-algebra/alg-add-coeffs") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22611) (name alg-add-coeffs) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add)) (answer "(define (alg-add-coeffs add c1 c2 zero) (cond ((null? c1) c2) ((null? c2) c1) (else (cons (add (car c1) (car c2)) (alg-add-coeffs add (cdr c1) (cdr c2) zero)))))"))
(task-entry (id "control-systems/state-space/*pade-coeffs-6*") (skill control-systems) (module state-space) (tier 2) (difficulty 22612) (name *pade-coeffs-6*) (type "") (description "") (notes ()) (section matrix-exponential) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation)) (answer "(define *pade-coeffs-6* (list 1 1/2 1/10 1/120 1/1680 1/30240 1/665280))"))
(task-entry (id "control-systems/transfer-function/tf-from-poles-zeros") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22612) (name tf-from-poles-zeros) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros)) (answer "(define (tf-from-poles-zeros poles zeros gain) (make-tf (poly-from-roots zeros gain) (poly-from-roots poles 1)))"))
(task-entry (id "control-systems/z-transform/dtf-gain") (skill control-systems) (module z-transform) (tier 2) (difficulty 22612) (name dtf-gain) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros)) (answer "(define (dtf-gain dtf) (let ((den-at-1 (poly-eval (dtf-den dtf) 1))) (if (< (abs den-at-1) 1e-15) 'infinite (/ (poly-eval (dtf-num dtf) 1) den-at-1))))"))
(task-entry (id "control-systems/kalman/kalman-mahalanobis") (skill control-systems) (module kalman) (tier 2) (difficulty 22612) (name kalman-mahalanobis) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual)) (answer "(define (kalman-mahalanobis kf observation) (let ((residual (kalman-residual kf observation)) (var (kalman-variance kf)) (R (kalman-R kf))) (if (zero? (+ var R)) 0 (abs (/ residual (sqrt (+ var R)))))))"))
(task-entry (id "control-systems/stability/lyapunov-iterate-continuous") (skill control-systems) (module stability) (tier 2) (difficulty 22612) (name lyapunov-iterate-continuous) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous)) (answer "(define (lyapunov-iterate-continuous A Q max-iter) (let* ((n (matrix-rows A)) (P Q) (At (matrix-transpose A)) (dt 0.01)) (let loop ((P P) (iter 0)) (if (>= iter max-iter) P (let* ((AtP (matrix-mul At P)) (PA (matrix-mul P A)) (residual (matrix-add (matrix-add AtP PA) Q)) (P-new (matrix-add P (matrix-scale dt residual))) (diff (matrix-frobenius-norm (matrix-sub P-new P)))) (if (< diff 1e-10) P-new (loop P-new (+ iter 1))))))))"))
(task-entry (id "control-systems/controller-design/compute-eigenvector-pair") (skill control-systems) (module controller-design) (tier 2) (difficulty 22612) (name compute-eigenvector-pair) (type "Matrix × Matrix × Complex × Nat × Nat × Nat → (Vector . Vector) | 'singular | Error") (description "Compute eigenvector v and input direction u for a single pole.\nReturns (v . u) pair, 'singular if (λI - A) not invertible, or error for complex poles.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value)) (answer "(define (compute-eigenvector-pair A B lambda-i i m n) (let ((li (extract-pole-value lambda-i))) (if (and (pair? li) (eq? (car li) 'error)) li (let* ((lambda-I (matrix-scale li (matrix-identity n))) (M (matrix-sub lambda-I A)) (M-inv (matrix-inverse M))) (if (and (pair? M-inv) (eq? (car M-inv) 'error)) 'singular (let* ((S (matrix-mul M-inv B)) (j (modulo i m)) (u-vec (make-vector m 0)) (v-vec (vec-scale -1.0 (matrix-col-vec S j)))) (vector-set! u-vec j 1.0) (cons v-vec u-vec)))))))"))
(task-entry (id "control-systems/digital-pid/pid-step-antiwindup") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22612) (name pid-step-antiwindup) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step)) (answer "(define (pid-step-antiwindup pid state error out-min out-max) (let* ((Kp (pid-Kp pid)) (Ki (pid-Ki pid)) (Kd (pid-Kd pid)) (Ts (pid-Ts pid)) (integral-prev (pid-integral state)) (error-prev (pid-prev-error state)) (P (* Kp error)) (D (* Kd (/ (- error error-prev) Ts))) (integral-unclamped (+ integral-prev (* error Ts))) (I-unclamped (* Ki integral-unclamped)) (output-unclamped (+ P I-unclamped D)) (output-clamped (clamp output-unclamped out-min out-max)) (saturated? (not (= output-unclamped output-clamped))) (integral-new (if saturated? integral-prev integral-unclamped)) (new-state (list 'pid-state integral-new error output-clamped))) (cons output-clamped new-state)))"))
(task-entry (id "control-systems/discrete-control/d2c-tustin") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22612) (name d2c-tustin) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp)) (answer "(define (d2c-tustin dsys Ts) (let* ((Ad (dss-A dsys)) (Bd (dss-B dsys)) (Cd (dss-C dsys)) (Dd (dss-D dsys)) (n (dss-order dsys))) (if (= n 0) (make-ss Ad Bd Cd Dd) (let* ((I (matrix-identity n)) (Ad-I (matrix-sub Ad I)) (Ad+I (matrix-add Ad I)) (inv (matrix-inverse Ad+I))) (if (error-result? inv) (quasiquote (error d2c-singular-matrix (unquote inv))) (let* ((A (matrix-scale (/ 2 Ts) (matrix-mul Ad-I inv))) (B (matrix-mul (matrix-scale (/ 2 Ts) inv) Bd)) (C Cd) (invBd (matrix-mul inv Bd)) (CinvBd (matrix-mul Cd invBd)) (D (matrix-sub Dd (matrix-scale (/ Ts 2) CinvBd)))) (make-ss A B C D)))))))"))
(task-entry (id "control-systems/hinf-synthesis/gp-nw") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22612) (name gp-nw) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order)) (answer "(define (gp-nw gp) (matrix-cols (gp-B1 gp)))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-neg") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22612) (name alg-poly-neg) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs)) (answer "(define (alg-poly-neg p) (let* ((F (alg-poly-field p)) (neg (field-neg-fn F))) (alg-make-polynomial F (map neg (alg-poly-coeffs p)))))"))
(task-entry (id "control-systems/state-space/matrix-1norm") (skill control-systems) (module state-space) (tier 2) (difficulty 22613) (name matrix-1norm) (type "(-> Matrix Real)") (description "Compute 1-norm (max column sum of absolute values)") (notes ()) (section matrix-exponential) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6*)) (answer "(define (matrix-1norm m) (let ((rows (matrix-rows m)) (cols (matrix-cols m))) (let col-loop ((j 0) (max-sum 0)) (if (>= j cols) max-sum (let row-loop ((i 0) (col-sum 0)) (if (>= i rows) (col-loop (+ j 1) (max max-sum col-sum)) (row-loop (+ i 1) (+ col-sum (abs (matrix-ref m i j))))))))))"))
(task-entry (id "control-systems/transfer-function/tf-gain") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22613) (name tf-gain) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros)) (answer "(define (tf-gain tf) (/ (poly-leading (tf-num tf)) (poly-leading (tf-den tf))))"))
(task-entry (id "control-systems/z-transform/dtf-from-poles-zeros") (skill control-systems) (module z-transform) (tier 2) (difficulty 22613) (name dtf-from-poles-zeros) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain)) (answer "(define (dtf-from-poles-zeros poles zeros gain Ts) (make-dtf (poly-from-roots zeros gain) (poly-from-roots poles 1) Ts))"))
(task-entry (id "control-systems/kalman/make-log-kalman-filter") (skill control-systems) (module kalman) (tier 2) (difficulty 22613) (name make-log-kalman-filter) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis)) (answer "(define (make-log-kalman-filter initial-mean initial-variance Q R) (make-kalman-filter (log (max 1 initial-mean)) initial-variance Q R))"))
(task-entry (id "control-systems/stability/lyapunov-solve-discrete") (skill control-systems) (module stability) (tier 2) (difficulty 22613) (name lyapunov-solve-discrete) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous)) (answer "(define (lyapunov-solve-discrete A Q) (let ((n (matrix-rows A))) (if (= n 1) (let* ((a (matrix-ref A 0 0)) (q (matrix-ref Q 0 0)) (denom (- 1 (* a a)))) (if (<= (abs denom) 1e-15) '(error marginally-stable) (make-matrix 1 1 (/ q denom)))) (lyapunov-iterate-discrete A Q 1000))))"))
(task-entry (id "control-systems/controller-design/store-eigenpair!") (skill control-systems) (module controller-design) (tier 2) (difficulty 22613) (name store-eigenpair!) (type "Matrix × Matrix × Nat × (Vector . Vector) → Void") (description "Store eigenvector/input pair into matrices V and U at column i") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair)) (answer "(define (store-eigenpair! V U i pair) (matrix-set-col-from-vec! V i (car pair)) (matrix-set-col-from-vec! U i (cdr pair)))"))
(task-entry (id "control-systems/digital-pid/clamp") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22613) (name clamp) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup)) (answer "(define (clamp x min-val max-val) (cond ((< x min-val) min-val) ((> x max-val) max-val) (else x)))"))
(task-entry (id "control-systems/discrete-control/dss-step") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22613) (name dss-step) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin)) (answer "(define (dss-step sys x u) (let ((A (dss-A sys)) (B (dss-B sys))) (vec-add (matrix-vec-mul-v A x) (matrix-vec-mul-v B u))))"))
(task-entry (id "control-systems/hinf-synthesis/gp-nu") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22613) (name gp-nu) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw)) (answer "(define (gp-nu gp) (matrix-cols (gp-B2 gp)))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-sub") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22613) (name alg-poly-sub) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg)) (answer "(define (alg-poly-sub p1 p2) (alg-poly-add p1 (alg-poly-neg p2)))"))
(task-entry (id "control-systems/state-space/matrix-pade-6") (skill control-systems) (module state-space) (tier 2) (difficulty 22614) (name matrix-pade-6) (type "(-> Matrix (Pair Matrix Matrix))") (description "Compute [6,6] Padé numerator N and denominator D matrices. Returns (N . D) where e^A ≈ D^(-1) * N") (notes ()) (section matrix-exponential) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm)) (answer "(define (matrix-pade-6 A) (let* ((n (matrix-rows A)) (I (matrix-identity n)) (A2 (matrix-mul A A)) (A4 (matrix-mul A2 A2)) (A6 (matrix-mul A4 A2)) (b (list-ref *pade-coeffs-6* 0)) (b1 (list-ref *pade-coeffs-6* 1)) (b2 (list-ref *pade-coeffs-6* 2)) (b3 (list-ref *pade-coeffs-6* 3)) (b4 (list-ref *pade-coeffs-6* 4)) (b5 (list-ref *pade-coeffs-6* 5)) (b6 (list-ref *pade-coeffs-6* 6)) (A3 (matrix-mul A2 A)) (A5 (matrix-mul A4 A)) (even-terms (matrix-add I (matrix-add (matrix-scale b2 A2) (matrix-add (matrix-scale b4 A4) (matrix-scale b6 A6))))) (odd-terms (matrix-add (matrix-scale b1 A) (matrix-add (matrix-scale b3 A3) (matrix-scale b5 A5)))) (N (matrix-add even-terms odd-terms)) (D (matrix-sub even-terms odd-terms))) (cons N D)))"))
(task-entry (id "control-systems/transfer-function/tf-eval") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22614) (name tf-eval) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain)) (answer "(define (tf-eval tf s) (let ((num-val (poly-eval-complex (tf-num tf) s)) (den-val (poly-eval-complex (tf-den tf) s))) (complex-div num-val den-val)))"))
(task-entry (id "control-systems/z-transform/dtf-eval") (skill control-systems) (module z-transform) (tier 2) (difficulty 22614) (name dtf-eval) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros)) (answer "(define (dtf-eval dtf z) (let ((num-val (poly-eval-complex (dtf-num dtf) z)) (den-val (poly-eval-complex (dtf-den dtf) z))) (complex-div num-val den-val)))"))
(task-entry (id "control-systems/kalman/log-kalman-update") (skill control-systems) (module kalman) (tier 2) (difficulty 22614) (name log-kalman-update) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis make-log-kalman-filter)) (answer "(define (log-kalman-update kf observed-cost) (kalman-update kf (log (max 1 observed-cost))))"))
(task-entry (id "control-systems/stability/lyapunov-iterate-discrete") (skill control-systems) (module stability) (tier 2) (difficulty 22614) (name lyapunov-iterate-discrete) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete)) (answer "(define (lyapunov-iterate-discrete A Q max-iter) (let* ((At (matrix-transpose A)) (P Q)) (let loop ((P P) (iter 0)) (if (>= iter max-iter) P (let* ((P-new (matrix-add (matrix-mul At (matrix-mul P A)) Q)) (diff (matrix-frobenius-norm (matrix-sub P-new P)))) (if (< diff 1e-10) P-new (loop P-new (+ iter 1))))))))"))
(task-entry (id "control-systems/controller-design/eigenvector-assignment") (skill control-systems) (module controller-design) (tier 2) (difficulty 22614) (name eigenvector-assignment) (type "Matrix × Matrix × List × Nat × Nat → Matrix | Error") (description "Core eigenvector assignment algorithm for MIMO pole placement.\nHandles open-loop eigenvalue collisions via perturbation.\nNote: Complex poles with non-zero imaginary parts not yet supported.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair!)) (answer "(define (eigenvector-assignment A B desired-poles n m) (let ((V (make-matrix n n 0)) (U (make-matrix m n 0)) (eps 1e-6)) (let loop ((i 0)) (if (= i n) (let ((V-inv (matrix-inverse V))) (if (and (pair? V-inv) (eq? (car V-inv) 'error)) '(error eigenvector-matrix-singular) (matrix-mul U V-inv))) (let* ((lambda-i (list-ref desired-poles i)) (result (compute-eigenvector-pair A B lambda-i i m n))) (cond ((and (pair? result) (eq? (car result) 'error)) result) ((eq? result 'singular) (let* ((li (extract-pole-value lambda-i)) (result-pert (compute-eigenvector-pair A B (+ li eps) i m n))) (cond ((and (pair? result-pert) (eq? (car result-pert) 'error)) result-pert) ((eq? result-pert 'singular) '(error cannot-place-pole-at-open-loop-eigenvalue)) (else (store-eigenpair! V U i result-pert) (loop (+ i 1)))))) (else (store-eigenpair! V U i result) (loop (+ i 1)))))))))"))
(task-entry (id "control-systems/digital-pid/make-filtered-pid-state") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22614) (name make-filtered-pid-state) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp)) (answer "(define (make-filtered-pid-state) (list 'filtered-pid-state 0 0 0))"))
(task-entry (id "control-systems/discrete-control/dss-output") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22614) (name dss-output) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step)) (answer "(define (dss-output sys x u) (let ((C (dss-C sys)) (D (dss-D sys))) (vec-add (matrix-vec-mul-v C x) (matrix-vec-mul-v D u))))"))
(task-entry (id "control-systems/hinf-synthesis/gp-nz") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22614) (name gp-nz) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu)) (answer "(define (gp-nz gp) (matrix-rows (gp-C1 gp)))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-scale") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22614) (name alg-poly-scale) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub)) (answer "(define (alg-poly-scale p c) (let* ((F (alg-poly-field p)) (mul (field-mul-op F))) (alg-make-polynomial F (map (lambda (x) (mul c x)) (alg-poly-coeffs p)))))"))
(task-entry (id "control-systems/state-space/matrix-exp") (skill control-systems) (module state-space) (tier 2) (difficulty 22615) (name matrix-exp) (type "(-> Matrix Matrix)") (description "Compute matrix exponential using Scaling and Squaring with [6,6] Padé. Numerically robust for a wide range of matrices.") (notes ()) (section matrix-exponential) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6)) (answer "(define (matrix-exp A) (let* ((n (matrix-rows A)) (norm-A (matrix-1norm A)) (s (if (<= norm-A 0.5) 0 (+ 1 (exact (floor (log (inexact norm-A) 2)))))) (scale-factor (expt 2 s)) (A-scaled (matrix-scale (/ 1 scale-factor) A)) (pade-result (matrix-pade-6 A-scaled)) (N (car pade-result)) (D (cdr pade-result)) (exp-scaled (matrix-solve-system D N))) (let square ((k 0) (result exp-scaled)) (if (>= k s) result (square (+ k 1) (matrix-mul result result))))))"))
(task-entry (id "control-systems/transfer-function/tf-eval-real") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22615) (name tf-eval-real) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval)) (answer "(define (tf-eval-real tf s) (/ (poly-eval (tf-num tf) s) (poly-eval (tf-den tf) s)))"))
(task-entry (id "control-systems/z-transform/dtf-eval-real") (skill control-systems) (module z-transform) (tier 2) (difficulty 22615) (name dtf-eval-real) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval)) (answer "(define (dtf-eval-real dtf z) (/ (poly-eval (dtf-num dtf) z) (poly-eval (dtf-den dtf) z)))"))
(task-entry (id "control-systems/kalman/log-kalman-estimate") (skill control-systems) (module kalman) (tier 2) (difficulty 22615) (name log-kalman-estimate) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis make-log-kalman-filter log-kalman-update)) (answer "(define (log-kalman-estimate kf observed-cost) (kalman-estimate kf (log (max 1 observed-cost))))"))
(task-entry (id "control-systems/stability/lyapunov-stable?") (skill control-systems) (module stability) (tier 2) (difficulty 22615) (name lyapunov-stable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete)) (answer "(define (lyapunov-stable? sys) (let* ((A (ss-A sys)) (n (matrix-rows A)) (Q (matrix-identity n)) (P (lyapunov-solve-continuous A Q))) (if (and (pair? P) (eq? (car P) 'error)) #f (matrix-positive-definite? P))))"))
(task-entry (id "control-systems/controller-design/matrix-col-vec") (skill control-systems) (module controller-design) (tier 2) (difficulty 22615) (name matrix-col-vec) (type "Matrix × Nat → Vector") (description "Extract column j of matrix M as a vector") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment)) (answer "(define (matrix-col-vec M j) (let* ((n (matrix-rows M)) (v (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) v) (vector-set! v i (matrix-ref M i j)))))"))
(task-entry (id "control-systems/digital-pid/filtered-pid-state?") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22615) (name filtered-pid-state?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state)) (answer "(define (filtered-pid-state? x) (and (pair? x) (eq? (car x) 'filtered-pid-state) (= (length x) 4)))"))
(task-entry (id "control-systems/discrete-control/dss-simulate") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22615) (name dss-simulate) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output)) (answer "(define (dss-simulate sys x0 inputs) (let loop ((x x0) (us inputs) (states (list x0)) (outputs '())) (if (null? us) (cons (reverse states) (reverse outputs)) (let* ((u (car us)) (y (dss-output sys x u)) (x-next (dss-step sys x u))) (loop x-next (cdr us) (cons x-next states) (cons y outputs))))))"))
(task-entry (id "control-systems/hinf-synthesis/gp-ny") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22615) (name gp-ny) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz)) (answer "(define (gp-ny gp) (matrix-rows (gp-C2 gp)))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-mul") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22615) (name alg-poly-mul) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale)) (answer "(define (alg-poly-mul p1 p2) (let* ((F (alg-poly-field p1)) (c1 (alg-poly-coeffs p1)) (c2 (alg-poly-coeffs p2)) (n1 (length c1)) (n2 (length c2)) (result-len (- (+ n1 n2) 1)) (mul (field-mul-op F)) (add (field-add-op F)) (zero (field-zero F))) (if (or (= n1 0) (= n2 0)) (alg-poly-zero-over F) (let ((result (make-list result-len zero))) (let outer ((i 0) (res result)) (if (>= i n1) (alg-make-polynomial F res) (let inner ((j 0) (r res)) (if (>= j n2) (outer (+ i 1) r) (let* ((idx (+ i j)) (old (list-ref r idx)) (new (add old (mul (list-ref c1 i) (list-ref c2 j))))) (inner (+ j 1) (list-set r idx new)))))))))))"))
(task-entry (id "control-systems/state-space/apply-permutation-to-matrix") (skill control-systems) (module state-space) (tier 2) (difficulty 22616) (name apply-permutation-to-matrix) (type "(-> Vector Matrix Matrix)") (description "Apply permutation vector to matrix rows: result[i,:] = B[perm[i],:]") (notes ()) (section matrix-exponential) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp)) (answer "(define (apply-permutation-to-matrix perm-vec B) (let* ((n (vector-length perm-vec)) (m (matrix-cols B)) (result (make-matrix n m 0))) (do ((i 0 (+ i 1))) ((= i n) result) (do ((j 0 (+ j 1))) ((= j m)) (matrix-set! result i j (matrix-ref B (vector-ref perm-vec i) j))))))"))
(task-entry (id "control-systems/transfer-function/tf-dc-gain") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22616) (name tf-dc-gain) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real)) (answer "(define (tf-dc-gain tf) (let ((den-at-zero (poly-eval (tf-den tf) 0))) (if (< (abs den-at-zero) 1e-15) 'infinite (/ (poly-eval (tf-num tf) 0) den-at-zero))))"))
(task-entry (id "control-systems/z-transform/dtf-freq-response") (skill control-systems) (module z-transform) (tier 2) (difficulty 22616) (name dtf-freq-response) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real)) (answer "(define (dtf-freq-response dtf frequencies) (let* ((Ts (dtf-Ts dtf)) (n (vector-length frequencies)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (let* ((w (vector-ref frequencies i)) (wTs (* w Ts)) (z (make-complex (cos wTs) (sin wTs)))) (vector-set! result i (dtf-eval dtf z))))))"))
(task-entry (id "control-systems/kalman/log-kalman-mean") (skill control-systems) (module kalman) (tier 2) (difficulty 22616) (name log-kalman-mean) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis make-log-kalman-filter log-kalman-update log-kalman-estimate)) (answer "(define (log-kalman-mean kf) (exp (kalman-mean kf)))"))
(task-entry (id "control-systems/stability/matrix-positive-definite?") (skill control-systems) (module stability) (tier 2) (difficulty 22616) (name matrix-positive-definite?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable?)) (answer "(define (matrix-positive-definite? M) (let* ((n (matrix-rows M)) (eigenvalues (if (= n 1) (list (matrix-ref M 0 0)) (map complex-real (qr-algorithm-shifted M 50 1e-10))))) (all? (lambda (ev) (> ev 0)) eigenvalues)))"))
(task-entry (id "control-systems/controller-design/matrix-set-col-from-vec!") (skill control-systems) (module controller-design) (tier 2) (difficulty 22616) (name matrix-set-col-from-vec!) (type "Matrix × Nat × Vector → Void") (description "Set column j of matrix M from vector v (mutating)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec)) (answer "(define (matrix-set-col-from-vec! M j v) (let ((n (vector-length v))) (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! M i j (vector-ref v i)))))"))
(task-entry (id "control-systems/digital-pid/fpid-integral") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22616) (name fpid-integral) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state?)) (answer "(define (fpid-integral state) (cadr state))"))
(task-entry (id "control-systems/discrete-control/dss-impulse-response") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22616) (name dss-impulse-response) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output dss-simulate)) (answer "(define (dss-impulse-response sys n) (let* ((m (matrix-cols (dss-B sys))) (n-states (dss-order sys)) (x0 (make-vector n-states 0)) (impulse (make-vector m 0)) (zero-input (make-vector m 0))) (vector-set! impulse 0 1) (let ((inputs (cons impulse (make-list (- n 1) zero-input)))) (cdr (dss-simulate sys x0 inputs)))))"))
(task-entry (id "control-systems/hinf-synthesis/hinf-mixed-sensitivity-plant") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22616) (name hinf-mixed-sensitivity-plant) (type "SS × SS × SS → GeneralizedPlant | Error") (description "Construct generalized plant for mixed-sensitivity H-infinity.\n  Stacks [W1*S; W3*T] for minimization.\n  G: plant (state-space), W1: sensitivity weight, W3: comp-sensitivity weight.\n\n  The resulting plant has:\n    w = [r; d] reference and disturbance\n    z = [W1*e; W3*u] weighted error and control\n    u = control input\n    y = measured output (error e = r - y)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny)) (answer "(define (hinf-mixed-sensitivity-plant G W1 W3) (let* ((nG (ss-order G)) (nW1 (ss-order W1)) (nW3 (ss-order W3)) (n (+ nG nW1 nW3)) (Ag (ss-A G)) (Bg (ss-B G)) (Cg (ss-C G)) (Dg (ss-D G)) (A1 (ss-A W1)) (B1 (ss-B W1)) (C1 (ss-C W1)) (D1 (ss-D W1)) (A3 (ss-A W3)) (B3 (ss-B W3)) (C3 (ss-C W3)) (D3 (ss-D W3))) (if (not (and (= (ss-inputs G) 1) (= (ss-outputs G) 1) (= (ss-inputs W1) 1) (= (ss-outputs W1) 1) (= (ss-inputs W3) 1) (= (ss-outputs W3) 1))) '(error siso-only-for-mixed-sensitivity) (let* ((A (make-matrix n n 0)) (_ (matrix-copy-block! A 0 0 Ag)) (_ (matrix-copy-block! A nG nG A1)) (coupling-1G (matrix-scale -1 (matrix-mul B1 Cg))) (_ (matrix-copy-block! A nG 0 coupling-1G)) (_ (matrix-copy-block! A (+ nG nW1) (+ nG nW1) A3)) (B1-aug (make-matrix n 1 0)) (_ (matrix-copy-block! B1-aug nG 0 B1)) (B2-aug (make-matrix n 1 0)) (_ (matrix-copy-block! B2-aug 0 0 Bg)) (neg-B1Dg (matrix-scale -1 (matrix-mul B1 Dg))) (_ (matrix-copy-block! B2-aug nG 0 neg-B1Dg)) (_ (matrix-copy-block! B2-aug (+ nG nW1) 0 B3)) (nz1 (ss-outputs W1)) (nz3 (ss-outputs W3)) (nz (+ nz1 nz3)) (C1-aug (make-matrix nz n 0)) (neg-D1Cg (matrix-scale -1 (matrix-mul D1 Cg))) (_ (matrix-copy-block! C1-aug 0 0 neg-D1Cg)) (_ (matrix-copy-block! C1-aug 0 nG C1)) (_ (matrix-copy-block! C1-aug nz1 (+ nG nW1) C3)) (C2-aug (make-matrix 1 n 0)) (_ (matrix-copy-block! C2-aug 0 0 Cg)) (D11-aug (make-matrix nz 1 0)) (_ (matrix-copy-block! D11-aug 0 0 D1)) (D12-aug (make-matrix nz 1 0)) (neg-D1Dg (matrix-scale -1 (matrix-mul D1 Dg))) (_ (matrix-copy-block! D12-aug 0 0 neg-D1Dg)) (_ (matrix-copy-block! D12-aug nz1 0 D3)) (D21-aug (make-matrix 1 1 -1)) (D22-aug Dg)) (make-generalized-plant A B1-aug B2-aug C1-aug C2-aug D11-aug D12-aug D21-aug D22-aug)))))"))
(task-entry (id "control-systems/poly-algebra/list-set") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22616) (name list-set) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul)) (answer "(define (list-set lst idx val) (if (= idx 0) (cons val (cdr lst)) (cons (car lst) (list-set (cdr lst) (- idx 1) val))))"))
(task-entry (id "control-systems/state-space/matrix-solve-system") (skill control-systems) (module state-space) (tier 2) (difficulty 22617) (name matrix-solve-system) (type "(-> Matrix Matrix Matrix)") (description "Solve A * X = B for X using LU decomposition. Returns X = A^(-1) * B") (notes ()) (section matrix-exponential) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix)) (answer "(define (matrix-solve-system A B) (let* ((n (matrix-rows A)) (m (matrix-cols B)) (lu-result (matrix-lu A))) (if (and (pair? lu-result) (eq? (car lu-result) 'error)) (matrix-mul (matrix-inverse A) B) (let* ((L (car lu-result)) (U (cadr lu-result)) (perm-vec (caddr lu-result)) (Pb (apply-permutation-to-matrix perm-vec B))) (let ((Y (forward-substitute L Pb))) (back-substitute U Y))))))"))
(task-entry (id "control-systems/transfer-function/tf-freq-response") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22617) (name tf-freq-response) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain)) (answer "(define (tf-freq-response tf frequencies) (let* ((n (vector-length frequencies)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (let* ((w (vector-ref frequencies i)) (jw (make-complex 0 w))) (vector-set! result i (tf-eval tf jw))))))"))
(task-entry (id "control-systems/z-transform/dtf-magnitude") (skill control-systems) (module z-transform) (tier 2) (difficulty 22617) (name dtf-magnitude) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response)) (answer "(define (dtf-magnitude dtf frequencies) (let* ((resp (dtf-freq-response dtf frequencies)) (n (vector-length resp)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (complex-magnitude (vector-ref resp i))))))"))
(task-entry (id "control-systems/kalman/log-kalman-predict-cost") (skill control-systems) (module kalman) (tier 2) (difficulty 22617) (name log-kalman-predict-cost) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis make-log-kalman-filter log-kalman-update log-kalman-estimate log-kalman-mean)) (answer "(define (log-kalman-predict-cost kf confidence-sigmas) (let* ((log-mean (kalman-mean kf)) (log-var (kalman-variance kf)) (log-sigma (sqrt (max 1e-4 log-var)))) (exp (+ log-mean (* confidence-sigmas log-sigma)))))"))
(task-entry (id "control-systems/stability/matrix-frobenius-norm") (skill control-systems) (module stability) (tier 2) (difficulty 22617) (name matrix-frobenius-norm) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite?)) (answer "(define (matrix-frobenius-norm M) (let* ((rows (matrix-rows M)) (cols (matrix-cols M))) (sqrt (let loop ((i 0) (sum 0)) (if (>= i rows) sum (loop (+ i 1) (+ sum (let inner ((j 0) (row-sum 0)) (if (>= j cols) row-sum (inner (+ j 1) (+ row-sum (expt (matrix-ref M i j) 2))))))))))))"))
(task-entry (id "control-systems/controller-design/characteristic-polynomial") (skill control-systems) (module controller-design) (tier 2) (difficulty 22617) (name characteristic-polynomial) (type "Matrix → Poly") (description "Compute characteristic polynomial det(sI - A). Uses Faddeev-LeVerrier method") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec!)) (answer "(define (characteristic-polynomial A) (let* ((n (matrix-rows A)) (coeffs (make-vector (+ n 1) 0)) (M (matrix-identity n))) (vector-set! coeffs 0 1) (let loop ((k 1) (M M)) (if (> k n) (make-poly coeffs) (let* ((AM (matrix-mul A M)) (trace-AM (matrix-trace AM)) (c-k (/ (- trace-AM) k)) (M-new (if (= k n) M (matrix-add AM (matrix-scale c-k (matrix-identity n)))))) (vector-set! coeffs k c-k) (loop (+ k 1) M-new))))))"))
(task-entry (id "control-systems/digital-pid/fpid-prev-error") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22617) (name fpid-prev-error) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral)) (answer "(define (fpid-prev-error state) (caddr state))"))
(task-entry (id "control-systems/discrete-control/dss-step-response") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22617) (name dss-step-response) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output dss-simulate dss-impulse-response)) (answer "(define (dss-step-response sys n) (let* ((m (matrix-cols (dss-B sys))) (n-states (dss-order sys)) (x0 (make-vector n-states 0)) (step-input (make-vector m 0))) (vector-set! step-input 0 1) (let ((inputs (make-list n step-input))) (cdr (dss-simulate sys x0 inputs)))))"))
(task-entry (id "control-systems/hinf-synthesis/matrix-copy-block!") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22617) (name matrix-copy-block!) (type "Matrix × Nat × Nat × Matrix → Void") (description "Copy src matrix into dest starting at (row, col)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant)) (answer "(define (matrix-copy-block! dest row col src) (let ((m (matrix-rows src)) (n (matrix-cols src))) (do ((i 0 (+ i 1))) ((= i m)) (do ((j 0 (+ j 1))) ((= j n)) (matrix-set! dest (+ row i) (+ col j) (matrix-ref src i j))))))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-divmod") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22617) (name alg-poly-divmod) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set)) (answer "(define (alg-poly-divmod p1 p2) (let* ((F (alg-poly-field p1)) (zero (field-zero F)) (div (field-div-fn F))) (if (alg-poly-zero? p2) (error 'alg-poly-divmod \"division by zero polynomial\") (let loop ((rem p1) (quot (alg-poly-zero-over F))) (if (or (alg-poly-zero? rem) (< (alg-poly-degree rem) (alg-poly-degree p2))) (cons quot rem) (let* ((lc-rem (alg-poly-leading-coeff rem)) (lc-div (alg-poly-leading-coeff p2)) (coeff (div lc-rem lc-div)) (deg-diff (- (alg-poly-degree rem) (alg-poly-degree p2))) (term (alg-poly-monomial F coeff deg-diff)) (new-quot (alg-poly-add quot term)) (new-rem (alg-poly-sub rem (alg-poly-mul term p2)))) (loop new-rem new-quot)))))))"))
(task-entry (id "control-systems/state-space/forward-substitute") (skill control-systems) (module state-space) (tier 2) (difficulty 22618) (name forward-substitute) (type "(-> Matrix Matrix Matrix)") (description "Solve L * Y = B where L is lower triangular") (notes ()) (section matrix-exponential) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system)) (answer "(define (forward-substitute L B) (let* ((n (matrix-rows L)) (m (matrix-cols B)) (Y (make-matrix n m 0))) (do ((j 0 (+ j 1))) ((= j m) Y) (do ((i 0 (+ i 1))) ((= i n)) (let ((sum (let loop ((k 0) (acc 0)) (if (>= k i) acc (loop (+ k 1) (+ acc (* (matrix-ref L i k) (matrix-ref Y k j)))))))) (matrix-set! Y i j (/ (- (matrix-ref B i j) sum) (matrix-ref L i i))))))))"))
(task-entry (id "control-systems/transfer-function/tf-magnitude") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22618) (name tf-magnitude) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response)) (answer "(define (tf-magnitude tf frequencies) (let* ((resp (tf-freq-response tf frequencies)) (n (vector-length resp)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (complex-magnitude (vector-ref resp i))))))"))
(task-entry (id "control-systems/z-transform/dtf-magnitude-db") (skill control-systems) (module z-transform) (tier 2) (difficulty 22618) (name dtf-magnitude-db) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude)) (answer "(define (dtf-magnitude-db dtf frequencies) (let* ((mag (dtf-magnitude dtf frequencies)) (n (vector-length mag)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (let ((m (vector-ref mag i))) (vector-set! result i (if (> m 0) (* 20 (log10 m)) -200))))))"))
(task-entry (id "control-systems/kalman/log-kalman-confidence-interval") (skill control-systems) (module kalman) (tier 2) (difficulty 22618) (name log-kalman-confidence-interval) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis make-log-kalman-filter log-kalman-update log-kalman-estimate log-kalman-mean log-kalman-predict-cost)) (answer "(define (log-kalman-confidence-interval kf confidence-sigmas) (let* ((log-mean (kalman-mean kf)) (log-var (kalman-variance kf)) (log-sigma (sqrt (max 1e-4 log-var))) (lower (exp (- log-mean (* confidence-sigmas log-sigma)))) (upper (exp (+ log-mean (* confidence-sigmas log-sigma))))) (cons lower upper)))"))
(task-entry (id "control-systems/stability/root-locus-points") (skill control-systems) (module stability) (tier 2) (difficulty 22618) (name root-locus-points) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm)) (answer "(define (root-locus-points tf gains) (let ((num (tf-num tf)) (den (tf-den tf))) (map (lambda (K) (let ((cl-poly (poly-add den (poly-scale num K)))) (poly-roots cl-poly))) gains)))"))
(task-entry (id "control-systems/controller-design/matrix-trace") (skill control-systems) (module controller-design) (tier 2) (difficulty 22618) (name matrix-trace) (type "Matrix → Number") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial)) (answer "(define (matrix-trace M) (let ((n (min (matrix-rows M) (matrix-cols M)))) (let loop ((i 0) (sum 0)) (if (>= i n) sum (loop (+ i 1) (+ sum (matrix-ref M i i)))))))"))
(task-entry (id "control-systems/digital-pid/fpid-prev-derivative") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22618) (name fpid-prev-derivative) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error)) (answer "(define (fpid-prev-derivative state) (cadddr state))"))
(task-entry (id "control-systems/discrete-control/dss-stable?") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22618) (name dss-stable?) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output dss-simulate dss-impulse-response dss-step-response)) (answer "(define (dss-stable? sys) (let* ((A (dss-A sys)) (eigs (qr-algorithm-shifted A))) (cond ((vector? eigs) (let ((n (vector-length eigs))) (let loop ((i 0)) (if (= i n) #t (and (< (abs (vector-ref eigs i)) 1) (loop (+ i 1))))))) ((and (pair? eigs) (eq? (car eigs) 'complex-eigenvalues)) (let* ((eig-vec (cadr eigs)) (complex-info (caddr eigs)) (n (vector-length eig-vec))) (let check-all ((i 0) (info complex-info)) (if (= i n) #t (let ((complex-pair (find-complex-at-index i info))) (if complex-pair (let ((a (car complex-pair)) (b (cdr complex-pair))) (and (< (sqrt (+ (* a a) (* b b))) 1) (check-all (+ i 1) info))) (and (< (abs (vector-ref eig-vec i)) 1) (check-all (+ i 1) info)))))))) (else #f))))"))
(task-entry (id "control-systems/hinf-synthesis/hinf-gamma-iteration") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22618) (name hinf-gamma-iteration) (type "GeneralizedPlant × Number × Number × Number × Nat → (γ K) | Error") (description "Find minimum achievable γ via bisection.\n  Returns (optimal-gamma controller-K) or error if infeasible.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block!)) (answer "(define (hinf-gamma-iteration gp gamma-min gamma-max tolerance max-iter) (let loop ((lo gamma-min) (hi gamma-max) (iter 0) (last-feasible-K #f) (last-feasible-gamma #f)) (if (>= iter max-iter) (if last-feasible-K (list last-feasible-gamma last-feasible-K) '(error no-feasible-controller-found)) (let* ((gamma (/ (+ lo hi) 2)) (result (hinf-check-gamma gp gamma))) (cond ((< (- hi lo) tolerance) (if last-feasible-K (list last-feasible-gamma last-feasible-K) (let ((final (hinf-check-gamma gp hi))) (if (and (pair? final) (not (eq? (car final) 'error))) (list hi (cadr final)) '(error no-feasible-controller-found))))) ((and (pair? result) (not (eq? (car result) 'error))) (loop lo gamma (+ iter 1) (cadr result) gamma)) (else (loop gamma hi (+ iter 1) last-feasible-K last-feasible-gamma)))))))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-monomial") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22618) (name alg-poly-monomial) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod)) (answer "(define (alg-poly-monomial field coeff degree) (let ((zero (field-zero field))) (if ((field-equal-fn field) coeff zero) (alg-poly-zero-over field) (alg-make-polynomial field (append (make-list degree zero) (list coeff))))))"))
(task-entry (id "control-systems/state-space/back-substitute") (skill control-systems) (module state-space) (tier 2) (difficulty 22619) (name back-substitute) (type "(-> Matrix Matrix Matrix)") (description "Solve U * X = Y where U is upper triangular") (notes ()) (section matrix-exponential) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute)) (answer "(define (back-substitute U Y) (let* ((n (matrix-rows U)) (m (matrix-cols Y)) (X (make-matrix n m 0))) (do ((j 0 (+ j 1))) ((= j m) X) (do ((i (- n 1) (- i 1))) ((< i 0)) (let ((sum (let loop ((k (+ i 1)) (acc 0)) (if (>= k n) acc (loop (+ k 1) (+ acc (* (matrix-ref U i k) (matrix-ref X k j)))))))) (matrix-set! X i j (/ (- (matrix-ref Y i j) sum) (matrix-ref U i i))))))))"))
(task-entry (id "control-systems/transfer-function/tf-magnitude-db") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22619) (name tf-magnitude-db) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude)) (answer "(define (tf-magnitude-db tf frequencies) (let* ((mag (tf-magnitude tf frequencies)) (n (vector-length mag)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (let ((m (vector-ref mag i))) (vector-set! result i (if (> m 0) (* 20 (log10 m)) -200))))))"))
(task-entry (id "control-systems/z-transform/dtf-phase") (skill control-systems) (module z-transform) (tier 2) (difficulty 22619) (name dtf-phase) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db)) (answer "(define (dtf-phase dtf frequencies) (let* ((resp (dtf-freq-response dtf frequencies)) (n (vector-length resp)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (complex-angle (vector-ref resp i))))))"))
(task-entry (id "control-systems/kalman/kalman-with-Q") (skill control-systems) (module kalman) (tier 2) (difficulty 22619) (name kalman-with-Q) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis make-log-kalman-filter log-kalman-update log-kalman-estimate log-kalman-mean log-kalman-predict-cost log-kalman-confidence-interval)) (answer "(define (kalman-with-Q kf new-Q) (make-kalman-filter (kalman-mean kf) (kalman-variance kf) new-Q (kalman-R kf)))"))
(task-entry (id "control-systems/stability/root-locus-breakaway") (skill control-systems) (module stability) (tier 2) (difficulty 22619) (name root-locus-breakaway) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points)) (answer "(define (root-locus-breakaway tf) (let* ((N (tf-num tf)) (D (tf-den tf)) (N-prime (poly-derivative N)) (D-prime (poly-derivative D)) (char-poly (poly-sub (poly-mul N D-prime) (poly-mul N-prime D))) (candidates (poly-roots char-poly))) (filter (lambda (c) (and (< (abs (complex-imag c)) 1e-6) (let* ((s (complex-real c)) (Ns (poly-eval N s)) (Ds (poly-eval D s))) (and (not (< (abs Ns) 1e-10)) (> (/ (- Ds) Ns) 0))))) candidates)))"))
(task-entry (id "control-systems/controller-design/poly-coeffs-vector") (skill control-systems) (module controller-design) (tier 2) (difficulty 22619) (name poly-coeffs-vector) (type "Poly × Nat → Vector") (description "Extract coefficient vector of length n (padded with zeros)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace)) (answer "(define (poly-coeffs-vector poly n) (let* ((coeffs (poly-coeffs poly)) (len (vector-length coeffs)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((or (>= i n) (>= i len))) (let ((src-idx (- len 1 i)) (dst-idx (- n 1 i))) (when (and (>= src-idx 0) (>= dst-idx 0)) (vector-set! result dst-idx (vector-ref coeffs src-idx))))) result))"))
(task-entry (id "control-systems/digital-pid/pid-step-filtered") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22619) (name pid-step-filtered) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative)) (answer "(define (pid-step-filtered pid state error N) (let* ((Kp (pid-Kp pid)) (Ki (pid-Ki pid)) (Kd (pid-Kd pid)) (Ts (pid-Ts pid)) (integral-prev (fpid-integral state)) (error-prev (fpid-prev-error state)) (D-prev (fpid-prev-derivative state)) (P (* Kp error)) (integral-new (+ integral-prev (* error Ts))) (I (* Ki integral-new)) (a (/ (* N Ts) (+ 1 (* N Ts)))) (D-raw (* (/ Kd Ts) (- error error-prev))) (D-new (+ (* (- 1 a) D-prev) (* a D-raw))) (output (+ P I D-new)) (new-state (list 'filtered-pid-state integral-new error D-new))) (cons output new-state)))"))
(task-entry (id "control-systems/discrete-control/find-complex-at-index") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22619) (name find-complex-at-index) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output dss-simulate dss-impulse-response dss-step-response dss-stable?)) (answer "(define (find-complex-at-index i info) (cond ((null? info) #f) ((= i (caar info)) (cons (cadar info) (caddar info))) ((= i (+ 1 (caar info))) (cons (cadar info) (- (caddar info)))) (else (find-complex-at-index i (cdr info)))))"))
(task-entry (id "control-systems/hinf-synthesis/hinf-check-gamma") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22619) (name hinf-check-gamma) (type "GeneralizedPlant × Number → (ok K) | (error ...)") (description "Check if γ is achievable and compute controller if so.\n  Uses the two-Riccati approach (Glover-Doyle).\n\n  IMPORTANT: This implementation assumes D22 = 0 (no direct feedthrough from\n  control input to measurement output). Plants with D22 ≠ 0 require loop-shifting\n  transformations that are not yet implemented.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration)) (answer "(define (hinf-check-gamma gp gamma) (let* ((A (gp-A gp)) (B1 (gp-B1 gp)) (B2 (gp-B2 gp)) (C1 (gp-C1 gp)) (C2 (gp-C2 gp)) (D12 (gp-D12 gp)) (D21 (gp-D21 gp)) (D22 (gp-D22 gp)) (n (gp-order gp)) (gamma2 (* gamma gamma)) (gamma2-inv (/ 1 gamma2))) (if (not (matrix-near-zero? D22 1e-10)) '(error d22-nonzero-not-supported \"Plant has direct feedthrough (D22 ≠ 0). This implementation \" \"requires D22 = 0. Loop-shifting transformation not yet implemented.\") (let* ((B1B1t (matrix-mul B1 (matrix-transpose B1))) (B2B2t (matrix-mul B2 (matrix-transpose B2))) (R-X (matrix-sub (matrix-scale gamma2-inv B1B1t) B2B2t)) (C1tC1 (matrix-mul (matrix-transpose C1) C1)) (X-result (solve-hinf-riccati A R-X C1tC1 1000))) (if (and (pair? X-result) (eq? (car X-result) 'error)) X-result (let* ((X X-result) (C2tC2 (matrix-mul (matrix-transpose C2) C2)) (R-Y (matrix-sub (matrix-scale gamma2-inv C1tC1) C2tC2)) (Y-result (solve-hinf-riccati-dual A R-Y B1B1t 1000))) (if (and (pair? Y-result) (eq? (car Y-result) 'error)) Y-result (let* ((Y Y-result) (XY (matrix-mul X Y)) (rho (spectral-radius XY))) (if (>= rho gamma2) '(error spectral-radius-too-large) (hinf-construct-controller A B1 B2 C1 C2 X Y gamma))))))))))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-mod") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22619) (name alg-poly-mod) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial)) (answer "(define (alg-poly-mod p1 p2) (cdr (alg-poly-divmod p1 p2)))"))
(task-entry (id "control-systems/state-space/ss-transition-matrix") (skill control-systems) (module state-space) (tier 2) (difficulty 22620) (name ss-transition-matrix) (type "(-> SS Num Matrix)") (description "Compute the state transition matrix Φ(t) = e^(A*t) using numerically robust Scaling and Squaring with Padé") (notes ()) (section matrix-exponential) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute)) (answer "(define (ss-transition-matrix sys t) (matrix-exp (matrix-scale t (ss-A sys))))"))
(task-entry (id "control-systems/transfer-function/tf-phase") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22620) (name tf-phase) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db)) (answer "(define (tf-phase tf frequencies) (let* ((resp (tf-freq-response tf frequencies)) (n (vector-length resp)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (complex-angle (vector-ref resp i))))))"))
(task-entry (id "control-systems/z-transform/dtf-phase-deg") (skill control-systems) (module z-transform) (tier 2) (difficulty 22620) (name dtf-phase-deg) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase)) (answer "(define (dtf-phase-deg dtf frequencies) (let* ((phase-rad (dtf-phase dtf frequencies)) (n (vector-length phase-rad)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (* (vector-ref phase-rad i) (/ 180 pi))))))"))
(task-entry (id "control-systems/kalman/kalman-boost-Q") (skill control-systems) (module kalman) (tier 2) (difficulty 22620) (name kalman-boost-Q) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis make-log-kalman-filter log-kalman-update log-kalman-estimate log-kalman-mean log-kalman-predict-cost log-kalman-confidence-interval kalman-with-Q)) (answer "(define (kalman-boost-Q kf factor) (kalman-with-Q kf (* (kalman-Q kf) factor)))"))
(task-entry (id "control-systems/stability/root-locus-asymptotes") (skill control-systems) (module stability) (tier 2) (difficulty 22620) (name root-locus-asymptotes) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway)) (answer "(define (root-locus-asymptotes tf) (let* ((poles (tf-poles tf)) (zeros (tf-zeros tf)) (n (length poles)) (m (length zeros)) (diff (- n m))) (if (<= diff 0) (list '() 0) (let* ((pole-sum (apply + (map complex-real poles))) (zero-sum (apply + (map complex-real zeros))) (centroid (/ (- pole-sum zero-sum) diff)) (angles (map (lambda (k) (* (/ (+ (* 2 k) 1) diff) pi)) (iota diff)))) (list angles centroid)))))"))
(task-entry (id "control-systems/controller-design/vector-sub") (skill control-systems) (module controller-design) (tier 2) (difficulty 22620) (name vector-sub) (type "Vector × Vector → Vector") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector)) (answer "(define (vector-sub v1 v2) (let* ((n (vector-length v1)) (result (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (- (vector-ref v1 i) (vector-ref v2 i))))))"))
(task-entry (id "control-systems/digital-pid/pid-reset") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22620) (name pid-reset) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state pid-state? pid-integral pid-prev-error pid-prev-output pid-step pid-step-antiwindup clamp make-filtered-pid-state filtered-pid-state? fpid-integral fpid-prev-error fpid-prev-derivative pid-step-filtered)) (answer "(define (pid-reset state) (make-pid-state))"))
(task-entry (id "control-systems/discrete-control/recommend-sample-rate") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22620) (name recommend-sample-rate) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D dss-order error-result? c2d-zoh c2d-tustin c2d-tustin-prewarp d2c-tustin dss-step dss-output dss-simulate dss-impulse-response dss-step-response dss-stable? find-complex-at-index)) (answer "(define (recommend-sample-rate sys) (let* ((A (ss-A sys)) (eigs (qr-algorithm-shifted A))) (cond ((vector? eigs) (let ((max-rate (apply max (map abs (vector->list eigs))))) (/ 1 (* 10 max-rate)))) ((and (pair? eigs) (eq? (car eigs) 'complex-eigenvalues)) (let* ((eig-vec (cadr eigs)) (complex-info (caddr eigs)) (rates '())) (do ((i 0 (+ i 1))) ((= i (vector-length eig-vec))) (let ((cp (find-complex-at-index i complex-info))) (if cp (let ((omega (sqrt (+ (* (car cp) (car cp)) (* (cdr cp) (cdr cp)))))) (set! rates (cons omega rates))) (set! rates (cons (abs (vector-ref eig-vec i)) rates))))) (if (null? rates) 0.1 (/ 1 (* 10 (apply max rates)))))) (else 0.1))))"))
(task-entry (id "control-systems/hinf-synthesis/solve-hinf-riccati") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22620) (name solve-hinf-riccati) (type "Matrix × Matrix × Matrix × Nat → Matrix | Error") (description "Solve H-infinity Riccati: A'X + XA + Q + X*R*X = 0\n  This is a generalization of CARE with indefinite R.\n  Uses Newton iteration with stabilization.") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2 gp-D11 gp-D12 gp-D21 gp-D22 gp-order gp-nw gp-nu gp-nz gp-ny hinf-mixed-sensitivity-plant matrix-copy-block! hinf-gamma-iteration hinf-check-gamma)) (answer "(define (solve-hinf-riccati A R Q max-iter) (let* ((n (matrix-rows A)) (At (matrix-transpose A)) (X (make-matrix n n 0))) (let loop ((X X) (iter 0)) (if (>= iter max-iter) (let ((res-norm (hinf-riccati-residual A R Q X))) (if (< res-norm 1e-6) X '(error riccati-did-not-converge))) (let* ((AtX (matrix-mul At X)) (XA (matrix-mul X A)) (XRX (matrix-mul X (matrix-mul R X))) (residual (matrix-add (matrix-add AtX XA) (matrix-add Q XRX))) (res-norm (matrix-frobenius-norm-hinf residual))) (if (< res-norm 1e-10) X (let* ((A-mod (matrix-add A (matrix-mul R X))) (dX (lyapunov-solve-hinf A-mod residual 100)) (X-new (matrix-sub X dX))) (let ((X-stabilized (matrix-psd-project X-new))) (loop X-stabilized (+ iter 1))))))))))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-div") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22620) (name alg-poly-div) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff alg-poly-zero? alg-poly-zero-over alg-poly-one-over alg-poly-add alg-add-coeffs alg-poly-neg alg-poly-sub alg-poly-scale alg-poly-mul list-set alg-poly-divmod alg-poly-monomial alg-poly-mod)) (answer "(define (alg-poly-div p1 p2) (car (alg-poly-divmod p1 p2)))"))
(task-entry (id "control-systems/state-space/ss-controllability-matrix") (skill control-systems) (module state-space) (tier 2) (difficulty 22621) (name ss-controllability-matrix) (type "(-> SS Matrix)") (description "Compute the controllability matrix C = [B AB A²B ... A^(n-1)B]") (notes ()) (section controllability) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs make-ss ss-from-lists ss-state-equation ss-output-equation *pade-coeffs-6* matrix-1norm matrix-pade-6 matrix-exp apply-permutation-to-matrix matrix-solve-system forward-substitute back-substitute ss-transition-matrix)) (answer "(define (ss-controllability-matrix sys) (let* ((A (ss-A sys)) (B (ss-B sys)) (n (ss-order sys)) (m (ss-inputs sys))) (let build ((k 0) (A-power (matrix-identity n)) (cols '())) (if (>= k n) (let* ((total-cols (* n m)) (result (make-matrix n total-cols 0))) (let fill-cols ((col-list cols) (col-idx 0)) (if (null? col-list) result (begin (do ((i 0 (+ i 1))) ((= i n)) (matrix-set! result i col-idx (matrix-ref (car col-list) i 0))) (fill-cols (cdr col-list) (+ col-idx 1)))))) (let* ((AkB (matrix-mul A-power B)) (new-cols (let extract-cols ((j 0) (acc '())) (if (>= j m) (reverse acc) (extract-cols (+ j 1) (cons (matrix-column-as-matrix AkB j) acc)))))) (build (+ k 1) (matrix-mul A-power A) (append cols new-cols)))))))"))
(task-entry (id "control-systems/transfer-function/tf-phase-deg") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22621) (name tf-phase-deg) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree tf-proper? tf-strictly-proper? tf-poles tf-zeros tf-from-poles-zeros tf-gain tf-eval tf-eval-real tf-dc-gain tf-freq-response tf-magnitude tf-magnitude-db tf-phase)) (answer "(define (tf-phase-deg tf frequencies) (let* ((phase-rad (tf-phase tf frequencies)) (n (vector-length phase-rad)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (* (vector-ref phase-rad i) (/ 180 pi))))))"))
(task-entry (id "control-systems/z-transform/dtf-series") (skill control-systems) (module z-transform) (tier 2) (difficulty 22621) (name dtf-series) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts dtf-order dtf-relative-degree dtf-proper? dtf-poles dtf-zeros dtf-gain dtf-from-poles-zeros dtf-eval dtf-eval-real dtf-freq-response dtf-magnitude dtf-magnitude-db dtf-phase dtf-phase-deg)) (answer "(define (dtf-series dtf1 dtf2) (let ((Ts1 (dtf-Ts dtf1)) (Ts2 (dtf-Ts dtf2))) (if (not (= Ts1 Ts2)) (quasiquote (error sample-time-mismatch (unquote Ts1) (unquote Ts2))) (make-dtf (poly-mul (dtf-num dtf1) (dtf-num dtf2)) (poly-mul (dtf-den dtf1) (dtf-den dtf2)) Ts1))))"))
(task-entry (id "control-systems/kalman/kalman-summary") (skill control-systems) (module kalman) (tier 2) (difficulty 22621) (name kalman-summary) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict kalman-update kalman-estimate kalman-gain kalman-batch kalman-residual kalman-mahalanobis make-log-kalman-filter log-kalman-update log-kalman-estimate log-kalman-mean log-kalman-predict-cost log-kalman-confidence-interval kalman-with-Q kalman-boost-Q)) (answer "(define (kalman-summary kf) (quasiquote ((mean unquote (kalman-mean kf)) (variance unquote (kalman-variance kf)) (std-dev unquote (sqrt (max 0 (kalman-variance kf)))) (Q unquote (kalman-Q kf)) (R unquote (kalman-R kf)) (gain unquote (kalman-gain kf)))))"))
(task-entry (id "control-systems/stability/nyquist-plot-points") (skill control-systems) (module stability) (tier 2) (difficulty 22621) (name nyquist-plot-points) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter routh-hurwitz-stable? has-sign-changes? routh-hurwitz-count-rhp count-sign-changes lyapunov-solve-continuous lyapunov-iterate-continuous lyapunov-solve-discrete lyapunov-iterate-discrete lyapunov-stable? matrix-positive-definite? matrix-frobenius-norm root-locus-points root-locus-breakaway root-locus-asymptotes)) (answer "(define (nyquist-plot-points tf num-points) (let* ((w-max 1000) (points '())) (do ((i 0 (+ i 1))) ((= i num-points) (reverse points)) (let* ((w (if (= i 0) 0.001 (* w-max (/ i (- num-points 1))))) (jw (make-complex 0 w)) (Gjw (tf-eval tf jw))) (set! points (cons Gjw points))))))"))
(task-entry (id "control-systems/controller-design/vector->row-matrix") (skill control-systems) (module controller-design) (tier 2) (difficulty 22621) (name vector->row-matrix) (type "Vector → Matrix") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector poly-eval-matrix pole-placement-bass-gura pole-placement pole-placement-mimo extract-pole-value compute-eigenvector-pair store-eigenpair! eigenvector-assignment matrix-col-vec matrix-set-col-from-vec! characteristic-polynomial matrix-trace poly-coeffs-vector vector-sub)) (answer "(define (vector->row-matrix v) (let* ((n (vector-length v)) (result (make-matrix 1 n 0))) (do ((i 0 (+ i 1))) ((= i n) result) (matrix-set! result 0 i (vector-ref v i)))))"))
