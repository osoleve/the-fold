(task-entry (id "algebra/galois/gf-ext-neg") (skill algebra) (module galois) (tier 0) (difficulty 314) (name gf-ext-neg) (type "") (description "") (notes ()) (section gf-extension-fields) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;primality)) (available (gf-prime gf-order gf-characteristic make-gf-ext-element gf-ext-element? gf-ext-coeffs gf-ext-modulus gf-ext-base-field gf-ext-normalize make-gf-extension make-gf-extension-large gf-ext-enumerate all-coeff-combinations gf-ext-add)) (answer "(define (gf-ext-neg a base-field n modulus) (let ((neg-fn (field-neg-fn base-field))) (make-gf-ext-element (map neg-fn (gf-ext-coeffs a)) modulus base-field)))"))
(task-entry (id "algebra/tropical/tropical-matrix-add") (skill algebra) (module tropical) (tier 0) (difficulty 314) (name tropical-matrix-add) (type "") (description "") (notes ()) (section matrix-operations) (deps (\x27;prelude \x27;matrix)) (available (make-semiring semiring? semiring-add semiring-mul semiring-zero semiring-one semiring-eq? min-plus-semiring max-plus-semiring tropical-add tropical-mul tropical-power tropical-matrix-identity tropical-matrix-mul)) (answer "(define (tropical-matrix-add sr A B) (let* ((m (matrix-rows A)) (n (matrix-cols A)) (data (make-vector (* m n) (semiring-zero sr)))) (do ((i 0 (+ i 1))) ((= i m)) (do ((j 0 (+ j 1))) ((= j n)) (let ((idx (+ (* i n) j))) (vector-set! data idx (tropical-add sr (matrix-ref A i j) (matrix-ref B i j)))))) (list 'matrix m n data)))"))
(task-entry (id "algebra/group/verify-identity") (skill algebra) (module group) (tier 0) (difficulty 315) (name verify-identity) (type "(-> Group Boolean)") (description "Check that e ∘ a = a ∘ e = a for all elements") (notes ()) (section group-axiom-verification) (deps (\x27;prelude)) (available (make-group group? group-elements group-op group-identity group-inverse-fn group-equal-fn group-order group-compose group-inverse group-power group-equal? element-order verify-closure verify-associativity)) (answer "(define (verify-identity g) (let ((elems (group-elements g)) (op (group-op g)) (e (group-identity g)) (eq? (group-equal-fn g))) (let loop ((es elems)) (if (null? es) #t (let ((a (car es))) (if (and (eq? (op e a) a) (eq? (op a e) a)) (loop (cdr es)) #f))))))"))
(task-entry (id "algebra/ring/ring-power") (skill algebra) (module ring) (tier 0) (difficulty 315) (name ring-power) (type "") (description "") (notes ()) (section ring-representation) (deps (\x27;prelude \x27;group)) (available (make-ring ring? ring-elements ring-add-op ring-mul-op ring-zero ring-one ring-neg-fn ring-equal-fn ring-order ring-add ring-mul ring-neg ring-sub ring-equal?)) (answer "(define (ring-power r a n) (cond ((= n 0) (ring-one r)) ((= n 1) a) ((even? n) (let ((half (ring-power r a (/ n 2)))) (ring-mul r half half))) (else (ring-mul r a (ring-power r a (- n 1))))))"))
