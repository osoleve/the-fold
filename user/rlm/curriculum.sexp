(task-entry (id "autodiff/traced-optics/extract-gradient") (skill autodiff) (module traced-optics) (tier 1) (difficulty 12705) (name extract-gradient) (type "") (description "") (notes ()) (section value-tracing) (deps (\x27;prelude \x27;reverse-diff lattice/optics/optics.ss lattice/physics/diff/traced-vec2.ss)) (available (trace-value untrace-value lift-at-optic traversal-over-indexed optic-gradient)) (answer "(define (extract-gradient traced-focus grads) (cond ((traced? traced-focus) (hashtable-ref grads (traced-id traced-focus) 0)) ((traced-vec2? traced-focus) (vec2 (hashtable-ref grads (traced-id (traced-vec2-x traced-focus)) 0) (hashtable-ref grads (traced-id (traced-vec2-y traced-focus)) 0))) ((just? traced-focus) (just (extract-gradient (from-just traced-focus) grads))) ((nothing? traced-focus) nothing) ((list? traced-focus) (map (lambda (tf) (extract-gradient tf grads)) traced-focus)) ((and (pair? traced-focus) (not (list? traced-focus))) (cons (extract-gradient (car traced-focus) grads) (extract-gradient (cdr traced-focus) grads))) (else 0)))"))
(task-entry (id "autodiff/higher-order-diff/hessian-numerical") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12706) (name hessian-numerical) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i)) (answer "(define (hessian-numerical f args epsilon) (let* ((n (length args)) (result (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n n result)) (do ((j 0 (+ j 1))) ((= j n)) (let* ((args-pp (list-update (list-update args i (lambda (x) (+ x epsilon))) j (lambda (x) (+ x epsilon)))) (args-pm (list-update (list-update args i (lambda (x) (+ x epsilon))) j (lambda (x) (- x epsilon)))) (args-mp (list-update (list-update args i (lambda (x) (- x epsilon))) j (lambda (x) (+ x epsilon)))) (args-mm (list-update (list-update args i (lambda (x) (- x epsilon))) j (lambda (x) (- x epsilon)))) (f-pp (apply f args-pp)) (f-pm (apply f args-pm)) (f-mp (apply f args-mp)) (f-mm (apply f args-mm)) (h-ij (/ (+ f-pp (- f-pm) (- f-mp) f-mm) (* 4 epsilon epsilon)))) (vector-set! result (+ (* i n) j) h-ij))))))"))
