(task-entry (id "linalg/quaternion/quat-add") (skill linalg) (module quaternion) (tier 0) (difficulty 419) (name quat-add) (type "") (description "") (notes ()) (section quaternion-arithmetic) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at quat? quat-identity? quat-unit? quat-w quat-x quat-y quat-z quat-scalar quat-vector quat->list list->quat)) (answer "(define (quat-add a b) (quat (+ (quat-w a) (quat-w b)) (+ (quat-x a) (quat-x b)) (+ (quat-y a) (quat-y b)) (+ (quat-z a) (quat-z b))))"))
(task-entry (id "linalg/matrix/matrix-scale") (skill linalg) (module matrix) (tier 0) (difficulty 419) (name matrix-scale) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose matrix-map matrix-map2 matrix-fold matrix-add matrix-sub matrix-hadamard)) (answer "(define (matrix-scale k m) (matrix-map (lambda (x) (* k x)) m))"))
(task-entry (id "linalg/matrix-eigen/spectral-radius") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 419) (name spectral-radius) (type "") (description "") (notes ()) (section symmetric-eigen) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop eigen-decomposition symmetric-eigen symmetric-eigen-loop symmetric-converged?)) (answer "(define (spectral-radius a . opts) (let* ((max-iter (if (and (pair? opts) (integer? (car opts))) (car opts) *eigen-max-iterations*)) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (tol (if (and (pair? rest1) (number? (car rest1))) (car rest1) *eigen-tolerance*)) (result (power-iteration a (vec-unit (matrix-rows a) 0) max-iter tol))) (if (and (pair? result) (eq? (car result) 'error)) result (abs (car result)))))"))
(task-entry (id "linalg/iterative-solvers/compute-givens") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 419) (name compute-givens) (type "") (description "") (notes ()) (section gmres) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres gmres-outer gmres-arnoldi gmres-arnoldi-loop apply-givens-rotations)) (answer "(define (compute-givens a-val b-val) (cond ((= b-val 0) (cons 1.0 0.0)) ((> (abs b-val) (abs a-val)) (let* ((t (/ a-val b-val)) (s (/ 1.0 (sqrt (+ 1 (* t t))))) (c (* s t))) (cons c s))) (else (let* ((t (/ b-val a-val)) (c (/ 1.0 (sqrt (+ 1 (* t t))))) (s (* c t))) (cons c s)))))"))
(task-entry (id "linalg/sparse/sparse-csr-ref") (skill linalg) (module sparse) (tier 0) (difficulty 419) (name sparse-csr-ref) (type "") (description "") (notes ()) (section csr-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr? make-sparse-csr sparse-csr-rows sparse-csr-cols sparse-csr-row-ptrs sparse-csr-col-indices sparse-csr-values sparse-csr-nnz)) (answer "(define (sparse-csr-ref m i j) (let* ((row-ptrs (sparse-csr-row-ptrs m)) (col-idx (sparse-csr-col-indices m)) (vals (sparse-csr-values m)) (start (vector-ref row-ptrs i)) (end (vector-ref row-ptrs (+ i 1)))) (let loop ((k start)) (cond ((= k end) 0) ((= (vector-ref col-idx k) j) (vector-ref vals k)) (else (loop (+ k 1)))))))"))
(task-entry (id "linalg/graph-laplacian/effective-resistance") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 419) (name effective-resistance) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue is-bipartite-spectral?)) (answer "(define (effective-resistance adj i j) (let* ((L (laplacian adj)) (n (matrix-rows L)) (result (symmetric-eigen L))) (if (and (pair? result) (eq? (car result) 'error)) result (let* ((eigenvalues (car result)) (eigenvectors (cdr result)) (tol 1e-10)) (let loop ((k 0) (sum 0)) (if (= k n) sum (let ((lambda-k (vector-ref eigenvalues k))) (if (< (abs lambda-k) tol) (loop (+ k 1) sum) (let* ((u-k (matrix-col eigenvectors k)) (diff (- (vector-ref u-k i) (vector-ref u-k j)))) (loop (+ k 1) (+ sum (/ (* diff diff) lambda-k))))))))))))"))
(task-entry (id "linalg/svd/matrix-rank") (skill linalg) (module svd) (tier 0) (difficulty 419) (name matrix-rank) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin matrix-slice-cols matrix-slice pseudoinverse build-sigma-pseudoinverse low-rank-approx)) (answer "(define (matrix-rank a . opts) (let* ((tol (if (pair? opts) (car opts) *svd-tolerance*)) (svd-result (svd a *svd-max-iterations* tol))) (if (and (pair? svd-result) (eq? (car svd-result) 'error)) svd-result (let* ((sigma (cadr svd-result)) (k (min (matrix-rows sigma) (matrix-cols sigma)))) (let loop ((i 0) (rank 0)) (if (= i k) rank (if (> (abs (matrix-ref sigma i i)) tol) (loop (+ i 1) (+ rank 1)) (loop (+ i 1) rank))))))))"))
(task-entry (id "linalg/numeric-instances/vec-sinh") (skill linalg) (module numeric-instances) (tier 0) (difficulty 419) (name vec-sinh) (type "") (description "") (notes ()) (section vec-floating-instance) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (vec+ vec- vec* vec-abs vec-signum vec-from-integer vec/ vec-recip vec-pi vec-exp vec-log vec-sqrt vec-pow vec-sin vec-cos vec-tan vec-asin vec-acos vec-atan)) (answer "(define (vec-sinh v) (vec-map (lambda (x) (/ (- (exp x) (exp (- x))) 2)) v))"))
(task-entry (id "linalg/dep-linalg/diff-hessian") (skill linalg) (module dep-linalg) (tier 0) (difficulty 419) (name diff-hessian) (type "Π n α. Diff (Vec n α) α → Vec n α → Matrix n n α") (description "Compute Hessian matrix (second derivatives).") (notes ()) (section differentiable-operations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (dep-linalg-types vec-append-typed vec-zip-typed vec-head-typed vec-tail-typed vec-map-typed vec-fold-typed matrix-mul-typed matrix-add-typed matrix-transpose-typed matrix-scale-typed vec-ref-safe matrix-ref-safe vec-nil-typed vec-cons-typed make-dep-linalg-ctx extend-ctx-with-dep-linalg diff-grad diff-jacobian)) (answer "(define (diff-hessian n A diff-fn x) (let ((hessian-fn (cdr (assq 'hessian diff-fn)))) (if hessian-fn (hessian-fn x) (error 'diff-hessian \"Cannot compute Hessian\" diff-fn))))"))
