(task-entry (id "statistics/link-functions/cauchit-link") (skill statistics) (module link-functions) (tier 1) (difficulty 11216) (name cauchit-link) (type "") (description "") (notes ()) (section link-function-structure) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available (make-link-function link-function? link-name link-g link-inverse link-derivative identity-link logit-link log-link probit-link probit-quantile probit-cdf probit-pdf inverse-link sqrt-link cloglog-link)) (answer "(define cauchit-link (make-link-function 'cauchit (lambda (mu) (let ((mu-safe (max (min mu 0.9999) 1e-4))) (tan-num (* (pi-value) (- mu-safe 0.5))))) (lambda (eta) (+ 0.5 (/ (atan eta) (pi-value)))) (lambda (mu) (let* ((mu-safe (max (min mu 0.9999) 1e-4)) (t (tan-num (* (pi-value) (- mu-safe 0.5))))) (* (pi-value) (+ 1 (* t t)))))))"))
(task-entry (id "statistics/ar-poly/ar-char-poly->string") (skill statistics) (module ar-poly) (tier 1) (difficulty 11216) (name ar-char-poly->string) (type "") (description "") (notes ()) (section rational-field-for-exact-coefficient-arithmetic) (deps (\x27;field \x27;algebra/polynomial)) (available (Q-field-ts ar-char-poly-vec ar-char-poly ar-companion-poly ma-char-poly arma-common-factors arma-reducible? arma-reduce algebra-poly->ar-coeffs algebra-poly->ma-coeffs ar-stable-simple? ma-invertible-simple? fit-poly-trend vector-fold ar-forecast-weights ar-impulse-response)) (answer "(define (ar-char-poly->string phi) (poly->string (ar-char-poly-vec phi) 'z))"))
(task-entry (id "statistics/ma/ma-forecast-se") (skill statistics) (module ma) (tier 1) (difficulty 11216) (name ma-forecast-se) (type "") (description "") (notes ()) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (moving-average weighted-moving-average exponential-moving-average ma-fit center-series-ma autocovariance-ma innovations-algorithm ma-compute-residuals ma-residual-sigma make-ma-result ma-coefficients ma-intercept ma-residuals ma-sigma ma-order ma-forecast)) (answer "(define (ma-forecast-se theta sigma q h) (let* ((se (make-vector h))) (do ((t 0 (+ t 1))) ((= t h) se) (let* ((max-j (min t q)) (sum (let loop ((j 0) (s 0)) (if (>= j max-j) s (loop (+ j 1) (+ s (expt (vector-ref theta j) 2))))))) (vector-set! se t (* sigma (sqrt (+ 1 sum))))))))"))
(task-entry (id "statistics/forecast/combine-forecasts-mean") (skill statistics) (module forecast) (tier 1) (difficulty 11216) (name combine-forecasts-mean) (type "") (description "") (notes ()) (section forecast-accuracy-metrics) (deps (\x27;prelude)) (available (mae mse rmse mape smape mase naive-forecast drift-forecast seasonal-naive-forecast mean-forecast forecast-intervals standard-normal-quantile-approx forecast-accuracy theil-u tracking-signal time-series-cv)) (answer "(define (combine-forecasts-mean forecasts) (if (null? forecasts) (vector) (let* ((h (vector-length (car forecasts))) (k (length forecasts)) (combined (make-vector h 0))) (for-each (lambda (fc) (do ((i 0 (+ i 1))) ((= i h)) (vector-set! combined i (+ (vector-ref combined i) (/ (vector-ref fc i) k))))) forecasts) combined)))"))
