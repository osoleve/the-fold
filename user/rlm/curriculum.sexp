(task-entry (id "linalg/dep-linalg/vec-tail-typed") (skill linalg) (module dep-linalg) (tier 0) (difficulty 404) (name vec-tail-typed) (type "Π n A. Vec (1+n) A → Vec n A") (description "Gets all but the first element of a non-empty vector.") (notes ()) (section vector-operations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (dep-linalg-types vec-append-typed vec-zip-typed vec-head-typed)) (answer "(define (vec-tail-typed n A v) (let ((len (vec-length v))) (if (<= len 1) (vec) (vec-from-list (cdr (vec->list v))))))"))
