(task-entry (id "diffgeo/charts/chart-apply") (skill diffgeo) (module charts) (tier 1) (difficulty 10708) (name chart-apply) (type "") (description "") (notes ()) (section chart-operations) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp)) (available (chart? chart-name chart-dim chart-domain-pred chart-coord-map chart-inverse-map make-chart chart-contains?)) (answer "(define (chart-apply chart point) (if (chart-contains? chart point) ((chart-coord-map chart) point) (quasiquote (error point-not-in-domain (unquote (chart-name chart))))))"))
(task-entry (id "diffgeo/tangent/tangent-add") (skill diffgeo) (module tangent) (tier 1) (difficulty 10708) (name tangent-add) (type "") (description "") (notes ()) (section tangent-vector-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts)) (available (tangent-vector? tangent-vector-point tangent-vector-chart tangent-vector-components tangent-vector-dim make-tangent-vector tangent-zero tangent-basis-vector)) (answer "(define (tangent-add tv1 tv2) (let ((p1 (tangent-vector-point tv1)) (p2 (tangent-vector-point tv2)) (c1 (tangent-vector-chart tv1)) (c2 (tangent-vector-chart tv2))) (cond ((not (equal? p1 p2)) (quasiquote (error different-base-points))) ((not (eq? (chart-name c1) (chart-name c2))) (quasiquote (error different-charts (unquote (chart-name c1)) (unquote (chart-name c2))))) (else (make-tangent-vector p1 c1 (vec-add (tangent-vector-components tv1) (tangent-vector-components tv2)))))))"))
(task-entry (id "diffgeo/lie-groups/make-so2") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10708) (name make-so2) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix)) (answer "(define (make-so2 theta) (let ((c (cos theta)) (s (sin theta)) (m (make-matrix 2 2 0))) (matrix-set! m 0 0 c) (matrix-set! m 0 1 (- s)) (matrix-set! m 1 0 s) (matrix-set! m 1 1 c) (list 'so2 m)))"))
(task-entry (id "diffgeo/curvature/make-euclidean-metric") (skill diffgeo) (module curvature) (tier 1) (difficulty 10708) (name make-euclidean-metric) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point)) (answer "(define (make-euclidean-metric chart) (let ((n (chart-dim chart))) (make-metric chart (lambda (coords) (matrix-identity n)))))"))
(task-entry (id "diffgeo/geodesics/geodesic-derivative") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10708) (name geodesic-derivative) (type "") (description "") (notes ()) (section geodesic-state) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration)) (answer "(define (geodesic-derivative metric state) (let ((coords (geodesic-state-coords state)) (velocity (geodesic-state-velocity state))) (cons velocity (geodesic-acceleration metric coords velocity))))"))
(task-entry (id "diffgeo/forms/permutation-sign") (skill diffgeo) (module forms) (tier 1) (difficulty 10708) (name permutation-sign) (type "") (description "") (notes ()) (section permutation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial)) (answer "(define (permutation-sign perm) (let ((inversions 0)) (let outer ((lst perm)) (when (not (null? lst)) (let inner ((rest (cdr lst))) (when (not (null? rest)) (when (> (car lst) (car rest)) (set! inversions (+ inversions 1))) (inner (cdr rest)))) (outer (cdr lst)))) (if (even? inversions) 1 -1)))"))
(task-entry (id "diffgeo/symbolic-metrics/make-spherical-metric-exact") (skill diffgeo) (module symbolic-metrics) (tier 1) (difficulty 10708) (name make-spherical-metric-exact) (type "(-> Chart MetricSymbolic)") (description "Spherical metric with exact derivatives") (notes ()) (section metric-derivative-protocol) (deps (\x27;curvature)) (available (metric-symbolic? make-metric-symbolic metric-symbolic-deriv-fn metric-chart* metric-fn* metric-dim* metric-at* make-polar-metric-exact)) (answer "(define (make-spherical-metric-exact chart) (let ((zero-3x3 (diagonal (vector 0 0 0)))) (make-metric-symbolic chart (lambda (coords) (let* ((r (vector-ref coords 0)) (theta (vector-ref coords 1)) (r2 (* r r)) (sin-theta (sin theta))) (diagonal (vector 1 r2 (* r2 sin-theta sin-theta))))) (lambda (coords) (let* ((r (vector-ref coords 0)) (theta (vector-ref coords 1)) (r2 (* r r)) (sin-theta (sin theta)) (cos-theta (cos theta)) (sin2-theta (* sin-theta sin-theta)) (dg (make-vector 3 #f))) (vector-set! dg 0 (diagonal (vector 0 (* 2 r) (* 2 r sin2-theta)))) (vector-set! dg 1 (diagonal (vector 0 0 (* r2 2 sin-theta cos-theta)))) (vector-set! dg 2 zero-3x3) dg)))))"))
(task-entry (id "fp/effects/eff-sequence") (skill fp) (module effects) (tier 1) (difficulty 10709) (name eff-sequence) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;continuation)) (available (make-effect-sig effect-sig? effect-sig-name effect-sig-operations make-operation operation? operation-name operation-param-type operation-result-type lookup-operation sig-State sig-Reader sig-Writer sig-Exception sig-NonDet sig-Console sig-Async make-effect-row effect-row? effect-row-effects empty-row row-contains? row-add row-remove row-union row-difference make-row-var row-var? row-var-name make-eff-pure eff-pure? eff-pure-value make-eff-op eff-op? eff-op-effect eff-op-cont eff-return make-eff-queue eff-queue? eff-queue-base eff-queue-conts eff-bind eff-normalize eff-apply-queue eff-apply-queue-step eff-map eff-ap perform make-effect effect? effect-tag effect-payload effect-label string-split-on string-titlecase make-handler handler? handler-return handler-effects handler-semantics handler-lookup deep-handler shallow-handler handle handle-deep handle-shallow compose-handlers nest-handlers with-handler state-get state-put state-modify state-gets make-state-handler run-state run-state-helper reader-ask reader-local reader-asks run-reader writer-tell writer-listen writer-pass run-writer run-writer-helper eff-throw eff-catch run-exception eff-try nondet-choose nondet-fail nondet-guard nondet-from-maybe run-nondet run-nondet-acc run-nondet-first run-nondet-bounded run-nondet-bounded-acc console-print console-read console-print-line run-console-pure run-console-helper async-fork async-await async-parallel run-async-sync *gensym-counter* eff-gensym)) (answer "(define (eff-sequence effs) (if (null? effs) (eff-return '()) (eff-bind (car effs) (lambda (x) (eff-bind (eff-sequence (cdr effs)) (lambda (xs) (eff-return (cons x xs))))))))"))
