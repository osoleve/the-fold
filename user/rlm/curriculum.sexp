(task-entry (id "numeric/wavelet/idwt-step") (skill numeric) (module wavelet) (tier 0) (difficulty 2512) (name idwt-step) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (haar-scaling-filter haar-wavelet-filter daubechies-4-scaling-filter qmf-wavelet-from-scaling daubechies-4-wavelet-filter daubechies-6-scaling-filter daubechies-6-wavelet-filter reverse-filter convolve-downsample upsample-convolve dwt-step dwt)) (answer "(define (idwt-step approx detail h g target-len) (let* ((up-approx (upsample-convolve approx h 2)) (up-detail (upsample-convolve detail g 2)) (n (min (vector-length up-approx) (vector-length up-detail) target-len)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (vector-set! result i (+ (vector-ref up-approx i) (vector-ref up-detail i))))))"))
