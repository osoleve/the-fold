(task-entry (id "random/bayesian/beta-binomial-posterior") (skill random) (module bayesian) (tier 1) (difficulty 12904) (name beta-binomial-posterior) (type "") (description "") (notes ()) (section conjugate-prior-beta-binomial) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta)) (answer "(define (beta-binomial-posterior prior k n) (let ((alpha (beta-prior-alpha prior)) (beta (beta-prior-beta prior))) (make-beta-prior (+ alpha k) (+ beta (- n k)))))"))
(task-entry (id "random/monte-carlo/sample-quantile") (skill random) (module monte-carlo) (tier 1) (difficulty 12904) (name sample-quantile) (type "") (description "") (notes ()) (section statistical-summary-functions) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem)) (answer "(define (sample-quantile samples p) (if (null? samples) 0 (let* ((sorted (sort-by < samples)) (n (length sorted)) (idx (* p (- n 1))) (lo (inexact->exact (floor idx))) (hi (min (+ lo 1) (- n 1))) (frac (- idx lo))) (+ (* (- 1 frac) (list-ref sorted lo)) (* frac (list-ref sorted hi))))))"))
