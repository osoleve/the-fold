(task-entry (id "fp/zipper/zipper-find") (skill fp) (module zipper) (tier 1) (difficulty 10636) (name zipper-find) (type "(-> (-> α Bool) (ListZipper α) (Maybe (ListZipper α)))") (description "Find first element matching predicate, returning zipper focused there") (notes ()) (section bulk-operations) (deps (\x27;prelude \x27;combinators)) (available (zipper-tag make-zipper zipper? zipper-left zipper-focus-maybe zipper-right zipper-empty zipper-empty? zipper-singleton list->zipper zipper->list zipper-from-position zipper-has-focus? zipper-can-go-left? zipper-can-go-right? zipper-left! zipper-right! zipper-start zipper-end zipper-goto zipper-position zipper-length zipper-focus zipper-focus-or zipper-set zipper-modify zipper-insert-left zipper-insert-right zipper-insert-focus zipper-delete zipper-delete-left zipper-delete-right zipper-map zipper-filter zipper-fold-left zipper-fold-right)) (answer "(define (zipper-find pred z) (let loop ((current (zipper-start z))) (cond ((not (zipper-has-focus? current)) nothing) ((pred (zipper-focus current)) (just current)) (else (let ((next (zipper-right! current))) (if (nothing? next) nothing (loop (from-just next))))))))"))
(task-entry (id "fp/tree-zipper/tree-zipper-right") (skill fp) (module tree-zipper) (tier 1) (difficulty 10636) (name tree-zipper-right) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators)) (available (tree-tag make-tree tree? tree-value tree-children tree-leaf tree-leaf? tree-node tree-size tree-depth tree-map tree-fold tree-flatten tree-flatten-acc tree-flatten-children tree-zipper-tag crumb-tag make-crumb crumb? crumb-value crumb-left crumb-right make-tree-zipper tree-zipper? tree-zipper-focus tree-zipper-crumbs tree->zipper zipper->tree tree-zipper-at-root? tree-zipper-at-leaf? tree-zipper-depth tree-zipper-up tree-zipper-down-left tree-zipper-down-right tree-zipper-down tree-zipper-left)) (answer "(define (tree-zipper-right z) (let ((crumbs (tree-zipper-crumbs z))) (if (null? crumbs) nothing (let* ((crumb (car crumbs)) (right (crumb-right crumb))) (if (null? right) nothing (let ((new-crumb (make-crumb (crumb-value crumb) (cons (tree-zipper-focus z) (crumb-left crumb)) (cdr right)))) (just (make-tree-zipper (car right) (cons new-crumb (cdr crumbs))))))))))"))
