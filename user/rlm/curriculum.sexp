(task-entry (id "statistics/summary-stats/covariance") (skill statistics) (module summary-stats) (tier 1) (difficulty 11211) (name covariance) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat)) (answer "(define (covariance xs ys) (if (not (= (length xs) (length ys))) (error 'covariance \"lists must have same length\") (let* ((n (length xs)) (mu-x (mean xs)) (mu-y (mean ys)) (prod-sum (fold-left + 0 (map (lambda (x y) (* (- x mu-x) (- y mu-y))) xs ys)))) (if (<= n 1) 0 (/ prod-sum (- n 1))))))"))
(task-entry (id "statistics/design-matrix/cbind") (skill statistics) (module design-matrix) (tier 1) (difficulty 11211) (name cbind) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix)) (answer "(define (cbind X1 X2) (let* ((m (matrix-rows X1)) (n1 (matrix-cols X1)) (n2 (matrix-cols X2)) (n (+ n1 n2)) (data (make-vector (* m n)))) (if (not (= m (matrix-rows X2))) (error 'cbind \"matrices must have same number of rows\") (begin (do ((i 0 (+ i 1))) ((= i m)) (do ((j 0 (+ j 1))) ((= j n1)) (vector-set! data (+ (* i n) j) (matrix-ref X1 i j))) (do ((j 0 (+ j 1))) ((= j n2)) (vector-set! data (+ (* i n) n1 j) (matrix-ref X2 i j)))) (list 'matrix m n data)))))"))
(task-entry (id "statistics/diagnostics/r-squared-predictor") (skill statistics) (module diagnostics) (tier 1) (difficulty 11211) (name r-squared-predictor) (type "(-> Matrix Nat Num)") (description "Compute R² from regressing column j on all other columns") (notes ()) (section collinearity-diagnostics) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers)) (available (hat-matrix hat-matrix-diagonal residuals-raw residuals-standardized residuals-studentized residuals-studentized-external cooks-distance cooks-distance-threshold dffits dffits-threshold vif)) (answer "(define (r-squared-predictor X j) (let* ((m (matrix-rows X)) (n (matrix-cols X)) (y (make-vector m)) (X-other-data (make-vector (* m (- n 1)))) (X-other (list 'matrix m (- n 1) X-other-data))) (do ((i 0 (+ i 1))) ((= i m)) (vector-set! y i (matrix-ref X i j)) (let ((col-idx 0)) (do ((k 0 (+ k 1))) ((= k n)) (when (not (= k j)) (vector-set! X-other-data (+ (* i (- n 1)) col-idx) (matrix-ref X i k)) (set! col-idx (+ col-idx 1)))))) (let* ((y-mean (let loop ((i 0) (s 0)) (if (= i m) (/ s m) (loop (+ i 1) (+ s (vector-ref y i)))))) (sst (let loop ((i 0) (s 0)) (if (= i m) s (loop (+ i 1) (+ s (expt (- (vector-ref y i) y-mean) 2)))))) (beta (matrix-least-squares X-other y))) (if (and (pair? beta) (eq? (car beta) 'error)) 0 (let* ((fitted (matrix-vec-mul X-other beta)) (sse (let loop ((i 0) (s 0)) (if (= i m) s (loop (+ i 1) (+ s (expt (- (vector-ref y i) (vector-ref fitted i)) 2))))))) (- 1 (/ sse (max sst 1e-10))))))))"))
(task-entry (id "statistics/linear/compute-weighted-se") (skill statistics) (module linear) (tier 1) (difficulty 11211) (name compute-weighted-se) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit linear-model-compute-diagnostics compute-coefficient-se compute-t-values compute-p-values compute-r-squared compute-adj-r-squared weighted-linear-fit weight-matrix weight-vector weighted-diagnostics)) (answer "(define (compute-weighted-se X weights mse) (let* ((m (matrix-rows X)) (p (matrix-cols X)) (XtWX-data (make-vector (* p p) 0)) (XtWX (list 'matrix p p XtWX-data))) (do ((j 0 (+ j 1))) ((= j p)) (do ((k 0 (+ k 1))) ((= k p)) (let ((sum (let loop ((i 0) (s 0)) (if (= i m) s (loop (+ i 1) (+ s (* (vector-ref weights i) (matrix-ref X i j) (matrix-ref X i k)))))))) (vector-set! XtWX-data (+ (* j p) k) sum)))) (let ((XtWX-inv (matrix-inverse XtWX))) (if (and (pair? XtWX-inv) (eq? (car XtWX-inv) 'error)) XtWX-inv (let ((se (make-vector p))) (do ((j 0 (+ j 1))) ((= j p) se) (vector-set! se j (sqrt (max (* (matrix-ref XtWX-inv j j) mse) 0)))))))))"))
(task-entry (id "statistics/regularized/elastic-net-update") (skill statistics) (module regularized) (tier 1) (difficulty 11211) (name elastic-net-update) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics compute-r-squared-ridge lasso-fit lasso-coordinate-descent lasso-partial-residual soft-threshold lasso-finalize count-nonzero elastic-net-fit elastic-net-coordinate-descent)) (answer "(define (elastic-net-update rho l1-penalty l2-penalty norm-sq) (let ((abs-rho (abs rho))) (if (<= abs-rho l1-penalty) 0 (/ (* (if (>= rho 0) 1 -1) (- abs-rho l1-penalty)) (max (+ norm-sq l2-penalty) 1e-10)))))"))
(task-entry (id "statistics/glm/poisson-fit") (skill statistics) (module glm) (tier 1) (difficulty 11211) (name poisson-fit) (type "") (description "") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available (glm-fit irls-loop irls-step weighted-least-squares irls-converged? irls-finalize compute-glm-se compute-z-values compute-z-pvalues compute-deviance-residuals logistic-fit)) (answer "(define (poisson-fit X y . opts) (apply glm-fit poisson-family log-link X y opts))"))
(task-entry (id "statistics/families/inverse-gaussian-family") (skill statistics) (module families) (tier 1) (difficulty 11211) (name inverse-gaussian-family) (type "") (description "") (notes ()) (section family-structure) (deps (\x27;prelude \x27;transcendental)) (available (make-glm-family glm-family? family-name family-variance family-deviance-contrib family-valid-mu? family-initialize gaussian-family binomial-family poisson-family gamma-family)) (answer "(define inverse-gaussian-family (make-glm-family 'inverse-gaussian (lambda (mu) (expt mu 3)) (lambda (y mu) (let* ((mu-safe (max mu 1e-10)) (y-safe (max y 1e-10))) (/ (expt (- y-safe mu-safe) 2) (* y-safe mu-safe mu-safe)))) (lambda (mu) (> mu 0)) (lambda (y) (max y 0.001))))"))
