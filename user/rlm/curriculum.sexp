(task-entry (id "random/probability/log-sum-exp") (skill random) (module probability) (tier 1) (difficulty 12937) (name log-sum-exp) (type "") (description "") (notes ()) (section importance-sampling-inference) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist condition assume sample-once sample-many weighted-samples)) (answer "(define (log-sum-exp xs) (if (null? xs) -inf.0 (let ((max-x (apply max xs))) (if (= max-x -inf.0) -inf.0 (+ max-x (log-num (fold-left + 0 (map (lambda (x) (exp-num (- x max-x))) xs))))))))"))
