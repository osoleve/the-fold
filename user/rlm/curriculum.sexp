(task-entry (id "physics/classical/rigid-body/rigid-body->body-2d") (skill physics/classical) (module rigid-body) (tier 2) (difficulty 23534) (name rigid-body->body-2d) (type "") (description "") (notes ()) (section conversion) (deps (\x27;prelude \x27;vec2)) (available (make-rigid-body rigid-body? rigid-body-pos rigid-body-vel rigid-body-angle rigid-body-angular-vel rigid-body-mass rigid-body-inv-mass rigid-body-inertia rigid-body-inv-inertia rigid-body-static? rigid-body-with-pos rigid-body-with-vel rigid-body-with-angle rigid-body-with-angular-vel rigid-body-with-mass rigid-body-with-inertia rigid-body-with-state make-static-rigid-body circle-inertia rectangle-inertia rod-inertia point-mass-inertia local-to-world world-to-local rigid-body-velocity-at apply-linear-impulse apply-angular-impulse apply-impulse-at-point rigid-body-kinetic-energy rigid-body-linear-momentum rigid-body-angular-momentum integrate-rigid-body body-2d->rigid-body)) (answer "(define (rigid-body->body-2d rigid-body) (let ((pos (rigid-body-pos rigid-body)) (vel (rigid-body-vel rigid-body)) (mass (rigid-body-mass rigid-body))) (list 'body-2d pos vel mass (if (= mass 0) 0 (/ 1 mass)))))"))
(task-entry (id "physics/classical/collision-detection/circle-circle-manifold") (skill physics/classical) (module collision-detection) (tier 2) (difficulty 23534) (name circle-circle-manifold) (type "") (description "") (notes ()) (section collision) (deps (\x27;prelude \x27;vec2)) (available (make-aabb aabb? aabb-min aabb-max aabb-center aabb-half-extents aabb-width aabb-height make-aabb-center make-aabb-from-points make-circle circle? circle-center circle-radius circle-aabb make-polygon polygon? polygon-vertices polygon-vertex-count polygon-vertex polygon-edge polygon-edges polygon-edge-normal polygon-normals polygon-aabb polygon-center make-box make-regular-polygon point-in-aabb? point-in-circle? point-in-polygon? aabb-aabb? aabb-aabb-manifold circle-circle?)) (answer "(define (circle-circle-manifold a b) (let* ((center-a (circle-center a)) (center-b (circle-center b)) (radius-a (circle-radius a)) (radius-b (circle-radius b)) (diff (vec2-sub center-b center-a)) (dist-sq (vec2-magnitude-sq diff)) (r-sum (+ radius-a radius-b))) (if (> dist-sq (* r-sum r-sum)) #f (let* ((dist (sqrt dist-sq)) (normal (if (< dist 1e-4) (vec2 1 0) (vec2-scale diff (/ 1 dist)))) (penetration (- r-sum dist)) (contact (vec2-add center-a (vec2-scale normal radius-a)))) (list normal penetration contact)))))"))
(task-entry (id "physics/classical/collision-response/resolve-collision-with-rotation") (skill physics/classical) (module collision-response) (tier 2) (difficulty 23534) (name resolve-collision-with-rotation) (type "") (description "") (notes ()) (section impulse) (deps (\x27;prelude \x27;vec2 \x27;integrators)) (available (make-manifold manifold? manifold-body-a manifold-body-b manifold-normal manifold-penetration manifold-contact make-material material? material-restitution material-static-friction material-dynamic-friction rubber-material metal-material wood-material ice-material default-material combine-materials velocity-at-point relative-velocity-at relative-velocity normal-velocity-at normal-velocity tangent-velocity get-inv-mass get-inv-inertia get-body-pos calculate-impulse-with-rotation calculate-impulse calculate-friction-impulse body-is-static? apply-impulse-at apply-impulse resolve-collision)) (answer "(define (resolve-collision-with-rotation manifold mat-a mat-b) (let* ((body-a (manifold-body-a manifold)) (body-b (manifold-body-b manifold)) (normal (manifold-normal manifold)) (contact (manifold-contact manifold)) (combined (combine-materials mat-a mat-b)) (restitution (car combined)) (static-friction (cadr combined)) (dynamic-friction (caddr combined)) (j-normal (calculate-impulse-with-rotation body-a body-b contact normal restitution))) (if (= j-normal 0) (list body-a body-b) (let* ((normal-impulse (vec2-scale normal j-normal)) (body-a-1 (apply-impulse-at body-a (vec2-neg normal-impulse) contact)) (body-b-1 (apply-impulse-at body-b normal-impulse contact)) (rel-vel (relative-velocity-at body-a-1 body-b-1 contact)) (normal-comp (vec2-scale normal (vec2-dot rel-vel normal))) (tangent-vel (vec2-sub rel-vel normal-comp)) (tangent-speed (vec2-magnitude tangent-vel))) (if (< tangent-speed 1e-4) (list body-a-1 body-b-1) (let* ((tangent (vec2-normalize tangent-vel)) (inv-mass-a (get-inv-mass body-a-1)) (inv-mass-b (get-inv-mass body-b-1)) (inv-i-a (get-inv-inertia body-a-1)) (inv-i-b (get-inv-inertia body-b-1)) (r-a (vec2-sub contact (get-body-pos body-a-1))) (r-b (vec2-sub contact (get-body-pos body-b-1))) (rt-a (vec2-cross r-a tangent)) (rt-b (vec2-cross r-b tangent)) (effective-mass-t (+ inv-mass-a inv-mass-b (* rt-a rt-a inv-i-a) (* rt-b rt-b inv-i-b))) (j-tangent (if (< effective-mass-t 1e-4) 0 (/ (- tangent-speed) effective-mass-t))) (j-friction (if (< (abs j-tangent) (* j-normal static-friction)) j-tangent (* (- j-normal) dynamic-friction (if (< j-tangent 0) -1 1)))) (friction-impulse (vec2-scale tangent j-friction)) (body-a-2 (apply-impulse-at body-a-1 friction-impulse contact)) (body-b-2 (apply-impulse-at body-b-1 (vec2-neg friction-impulse) contact))) (list body-a-2 body-b-2)))))))"))
(task-entry (id "physics/classical/constraint-graph/cg-cycle-analysis") (skill physics/classical) (module constraint-graph) (tier 2) (difficulty 23534) (name cg-cycle-analysis) (type "") (description "") (notes ()) (section topology) (deps (\x27;prelude \x27;simplicial-complex \x27;homology)) (available (make-constraint-graph constraint-graph? cg-adjacency cg-entity-constraints cg-entities cg-constraints cg-neighbors cg-constraints-for cg-find-islands make-island island? island-entities island-constraints island-size island-constraint-count cg-find-sccs make-scc scc? scc-entities scc-constraints scc-internal-constraints scc-size cg-scc-dag cg-toposort-constraints toposort-dag cg-color-constraints build-constraint-conflicts cg-chromatic-number cg-stats cg-print-stats cg->simplicial-complex cg-cycle-count cg-topology-analysis cg-find-bridges)) (answer "(define (cg-cycle-analysis graph) (let* ((topo (cg-topology-analysis graph)) (b1 (cdr (assq 'betti-1 topo))) (constraints (cg-constraints graph)) (bridges (cg-find-bridges graph)) (bridge-ids (make-hashtable equal-hash equal?)) (_ (for-each (lambda (c) (hashtable-set! bridge-ids (constraint-id c) #t)) bridges)) (cycle-constraints (if (> b1 0) (filter (lambda (c) (and (constraint-entity-b c) (not (hashtable-ref bridge-ids (constraint-id c) #f)))) constraints) '()))) (quasiquote ((cycle-count unquote b1) (has-cycles unquote (> b1 0)) (cycle-constraints unquote cycle-constraints) (bridge-constraints unquote bridges) (suggestions unquote (if (> b1 0) (format \"Found ~a independent cycle(s). ~a constraint(s) participate in cycles: ~a\" b1 (length cycle-constraints) (map constraint-id cycle-constraints)) \"No cycles detected - constraint system is tree-like.\"))))))"))
