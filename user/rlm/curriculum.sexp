(task-entry (id "numeric/pde-time/adaptive-euler-step") (skill numeric) (module pde-time) (tier 0) (difficulty 2520) (name adaptive-euler-step) (type "") (description "") (notes ()) (section adaptive) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;iterative-solvers)) (available (*pde-epsilon* pde-vec-add pde-vec-sub pde-vec-scale pde-vec-madd pde-vec-dot pde-vec-norm forward-euler-step forward-euler-matrix-step forward-euler-mass-step backward-euler-linear-step backward-euler-identity-step crank-nicolson-step crank-nicolson-identity-step mol-rhs mol-euler-step mol-rk4-step cfl-parabolic cfl-hyperbolic estimate-mesh-spacing)) (answer "(define (adaptive-euler-step f u t dt tol safety) (let* ((half-dt (/ dt 2)) (u-full (forward-euler-step f u t dt)) (u-half1 (forward-euler-step f u t half-dt)) (u-half2 (forward-euler-step f u-half1 (+ t half-dt) half-dt)) (error-vec (pde-vec-sub u-half2 u-full)) (error (pde-vec-norm error-vec)) (dt-new (if (< error 1e-30) (* 2 dt) (* dt safety (expt (/ tol error) 0.5))))) (values (if (< error tol) u-half2 u) (min dt-new (* 2 dt)) error)))"))
