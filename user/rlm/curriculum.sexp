(task-entry (id "linalg/svd/matrix-slice") (skill linalg) (module svd) (tier 0) (difficulty 415) (name matrix-slice) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin matrix-slice-cols)) (answer "(define (matrix-slice mat row-start row-end col-start col-end) (let* ((rows (- row-end row-start)) (cols (- col-end col-start)) (result (make-matrix rows cols 0))) (do ((i 0 (+ i 1))) ((= i rows) result) (do ((j 0 (+ j 1))) ((= j cols)) (matrix-set! result i j (matrix-ref mat (+ row-start i) (+ col-start j))))) result))"))
