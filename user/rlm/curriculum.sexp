(task-entry (id "random/distributions/random-gamma") (skill random) (module distributions) (tier 1) (difficulty 12946) (name random-gamma) (type "(-> Number Number (State RNG Number))") (description "State monad sampler for gamma distribution") (notes ()) (section gamma-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli bernoulli-pmf random-bernoulli geometric geometric-pmf geometric-cdf geometric-quantile random-geometric poisson poisson-pmf poisson-cdf random-poisson binomial binomial-pmf random-binomial gamma)) (answer "(define (random-gamma shape rate) (cond ((<= shape 0) (error 'random-gamma \"shape must be positive\" shape)) ((<= rate 0) (error 'random-gamma \"rate must be positive\" rate)) ((< shape 1) (state-bind (random-gamma (+ shape 1) 1) (lambda (x) (state-bind random-float (lambda (u) (state-pure (/ (* x (expt (max u 1e-300) (/ 1 shape))) rate))))))) (else (let* ((d (- shape (/ 1 3))) (c (/ 1 (sqrt (* 9 d))))) (rejection-sampler (state-bind random-normal-standard (lambda (z) (let ((v (+ 1 (* c z)))) (if (<= v 0) (state-pure #f) (state-bind random-float (lambda (u) (state-pure (list z u v)))))))) (lambda (zuv) (and zuv (let* ((z (car zuv)) (u (cadr zuv)) (v (caddr zuv)) (v3 (* v v v))) (and (or (< u (- 1 (* 0.0331 z z z z))) (< (safe-log u) (+ (* 0.5 z z) (* d (- 1 v3 (log-num v3)))))) (/ (* d v3) rate))))))))))"))
(task-entry (id "random/probability/prob-map-m") (skill random) (module probability) (tier 1) (difficulty 12946) (name prob-map-m) (type "") (description "") (notes ()) (section combinators) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist condition assume sample-once sample-many weighted-samples log-sum-exp normalize-log-weights importance-expectation importance-mean importance-variance rejection-sample rejection-samples prob-sequence prob-replicate)) (answer "(define (prob-map-m f xs) (prob-sequence (map f xs)))"))
