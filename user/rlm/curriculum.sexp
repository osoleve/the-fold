(task-entry (id "physics/classical/world/world-query-point") (skill physics/classical) (module world) (tier 2) (difficulty 23557) (name world-query-point) (type "") (description "") (notes ()) (section world) (deps (\x27;prelude \x27;vec2 \x27;integrators \x27;collision-detection \x27;collision-response \x27;raycasting \x27;constraints \x27;constraint-solver \x27;sort)) (available (make-entity entity? entity-id entity-body entity-shape entity-material entity-user-data entity-with-body entity-pos entity-vel entity-static? transform-shape entity-world-shape make-world-config config-fixed-dt config-max-substeps config-solver-iterations config-cell-size make-world world? world-entities world-gravity world-spatial-hash world-config world-time-acc world-constraints world-with-time-acc world-add-entity! world-remove-entity! world-get-entity world-entity-list world-update-entity! world-add-constraint! world-remove-constraint! world-get-constraint world-constraint-list world-update-constraint! make-force-acc force-acc-add! force-acc-get force-acc-clear! world-step! world-fixed-step! world-resolve-collision-velocities! world-correct-collision-positions! world-solve-constraint-velocities! world-correct-constraint-positions! world-integrate-velocities! world-integrate-positions! world-detect-collisions make-pair-key make-circle-entity make-box-entity make-static-circle make-static-box make-ground world-query-aabb)) (answer "(define (world-query-point world point) (let ((entities (world-entity-list world))) (filter (lambda (e) (let ((shape (entity-world-shape e))) (cond ((circle? shape) (point-in-circle? point shape)) ((aabb? shape) (point-in-aabb? point shape)) ((polygon? shape) (point-in-polygon? point shape)) (else #f)))) entities)))"))
