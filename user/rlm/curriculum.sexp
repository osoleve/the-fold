(task-entry (id "random/bayesian/gamma-posterior-mean") (skill random) (module bayesian) (tier 1) (difficulty 12920) (name gamma-posterior-mean) (type "") (description "") (notes ()) (section conjugate-prior-gamma-poisson) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior)) (answer "(define (gamma-posterior-mean prior) (/ (gamma-prior-shape prior) (gamma-prior-rate prior)))"))
(task-entry (id "random/monte-carlo/mh-thinned-sample") (skill random) (module monte-carlo) (tier 1) (difficulty 12920) (name mh-thinned-sample) (type "") (description "") (notes ()) (section metropolis-hastings-mcmc) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample)) (answer "(define (mh-thinned-sample log-target proposal initial n-samples burn-in thin) (let ((total-steps (+ burn-in (* n-samples thin)))) (state-bind (mh-chain log-target proposal initial total-steps) (lambda (all-samples) (state-pure (let loop ((samples (list-tail all-samples burn-in)) (i 0) (acc '())) (cond ((null? samples) (reverse acc)) ((= (modulo i thin) 0) (loop (cdr samples) (+ i 1) (cons (car samples) acc))) (else (loop (cdr samples) (+ i 1) acc)))))))))"))
(task-entry (id "random/variational-inference/full-gaussian-reparam") (skill random) (module variational-inference) (tier 1) (difficulty 12920) (name full-gaussian-reparam) (type "") (description "") (notes ()) (section full-covariance-gaussian) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements)) (answer "(define (full-gaussian-reparam vfamily epsilons) (let* ((means (full-gaussian-means vfamily)) (flat (full-gaussian-chol vfamily)) (n (length means)) (L (chol-flat-to-matrix flat n))) (map (lambda (mu-i L-row) (+ mu-i (fold-left + 0 (map * L-row (take (length L-row) epsilons))))) means L)))"))
