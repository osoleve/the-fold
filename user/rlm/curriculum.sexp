(task-entry (id "optimization/interval-contract/sum-interval-bounds") (skill optimization) (module interval-contract) (tier 1) (difficulty 12810) (name sum-interval-bounds) (type "") (description "") (notes ()) (section linear-contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract contract-linear-var remove-dim)) (answer "(define (sum-interval-bounds coeffs box) (if (null? coeffs) (interval-singleton 0) (let loop ((remaining coeffs) (acc (interval-singleton 0))) (if (null? remaining) acc (let* ((pair (car remaining)) (dim (car pair)) (coef (cdr pair)) (iv (list-ref box dim)) (scaled (interval-scale iv coef)) (new-acc (interval-add acc scaled))) (loop (cdr remaining) new-acc))))))"))
(task-entry (id "optimization/interval-newton/interval-find-all-roots") (skill optimization) (module interval-newton) (tier 1) (difficulty 12810) (name interval-find-all-roots) (type "(-> (-> Interval Interval) (-> Interval Interval) Interval Real Nat RootResult)") (description "") (notes ()) (section all-roots) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step interval-newton-step-rigorous interval-newton-root)) (answer "(define (interval-find-all-roots f-iv f-deriv-iv X0 tol max-iter) (let loop ((work-list (list X0)) (roots '()) (iter 0)) (cond ((null? work-list) (make-root-result roots iter 'converged)) ((>= iter max-iter) (let ((remaining-roots (map (lambda (iv) (cons iv 'possible)) work-list))) (make-root-result (append roots remaining-roots) iter 'max-iterations))) (else (let* ((X (car work-list)) (rest (cdr work-list))) (if (not (interval-contains-zero? (f-iv X))) (loop rest roots (+ iter 1)) (let ((step-result (interval-newton-step-rigorous f-iv f-deriv-iv X))) (case (car step-result) ((no-root) (loop rest roots (+ iter 1))) ((unique) (let ((refined (cdr step-result))) (if (< (interval-width refined) tol) (loop rest (cons (cons refined 'unique) roots) (+ iter 1)) (loop (cons refined rest) roots (+ iter 1))))) ((contracted) (let ((refined (cdr step-result))) (if (< (interval-width refined) tol) (loop rest (cons (cons refined 'exists) roots) (+ iter 1)) (loop (cons refined rest) roots (+ iter 1))))) ((division-by-zero no-improvement) (if (< (interval-width X) tol) (loop rest (cons (cons X 'possible) roots) (+ iter 1)) (let* ((pair (interval-bisect X)) (left (car pair)) (right (cdr pair))) (loop (cons left (cons right rest)) roots (+ iter 1))))) (else (loop rest roots (+ iter 1)))))))))))"))
(task-entry (id "optimization/line-search/curvature-condition?") (skill optimization) (module line-search) (tier 1) (difficulty 12811) (name curvature-condition?) (type "") (description "") (notes ()) (section overview) (deps (\x27;prelude \x27;reverse-diff)) (available (*armijo-c1* *wolfe-c2* *backtrack-rho* *max-ls-iters* *initial-step* *default-alpha-max* dot-product vec-add-scaled armijo-condition? armijo-backtrack armijo-backtrack-full)) (answer "(define (curvature-condition? grad-new-dot-d grad-old-dot-d c2) (>= grad-new-dot-d (* c2 grad-old-dot-d)))"))
(task-entry (id "optimization/convergence/cs-grad-norm") (skill optimization) (module convergence) (tier 1) (difficulty 12811) (name cs-grad-norm) (type "") (description "") (notes ()) (section convergence-state) (deps (\x27;prelude \x27;vec)) (available (make-convergence-criteria *default-convergence* convergence-criteria? cc-grad-tol cc-f-tol cc-x-tol cc-max-iter make-convergence-state convergence-state? cs-iter cs-f-val)) (answer "(define (cs-grad-norm cs) (list-ref cs 3))"))
(task-entry (id "optimization/first-order/newton-schulz-step") (skill optimization) (module first-order) (tier 1) (difficulty 12811) (name newton-schulz-step) (type "(-> Matrix Matrix)") (description "Single Newton-Schulz iteration: M @ (1.5*I - 0.5*M^T@M)") (notes ("Converges when spectral norm of M < sqrt(3)")) (section muon) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum adam adam-full rmsprop rmsprop-full adagrad adagrad-full gradient-descent-ls nesterov)) (answer "(define (newton-schulz-step m) (let* ((rows (matrix-rows m)) (cols (matrix-cols m)) (mt (matrix-transpose m)) (mtm (matrix-mul mt m)) (i (matrix-identity cols)) (scaled-i (matrix-scale 1.5 i)) (scaled-mtm (matrix-scale 0.5 mtm)) (bracket (matrix-sub scaled-i scaled-mtm))) (matrix-mul m bracket)))"))
(task-entry (id "optimization/newton/gradient-ls") (skill optimization) (module newton) (tier 1) (difficulty 12811) (name gradient-ls) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton make-positive-definite newton-cg newton-cg-full cg-newton-direction hessian-vector-product gauss-newton)) (answer "(define (gradient-ls r x) (let* ((residuals (apply r x)) (jac (jacobian-numerical r x)) (jt (matrix-transpose jac)) (grad-vec (matrix-vec-mul jt (list->vector residuals)))) (vector->list grad-vec)))"))
(task-entry (id "optimization/lbfgs/initial-hessian-scale") (skill optimization) (module lbfgs) (tier 1) (difficulty 12811) (name initial-hessian-scale) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list lbfgs-history-push take-n lbfgs-direction lbfgs-two-loop)) (answer "(define (initial-hessian-scale h) (if (= (lh-size h) 0) 1.0 (let* ((s (car (lh-s-list h))) (y (car (lh-y-list h))) (sy (dot-product s y)) (yy (dot-product y y))) (if (< yy 1e-15) 1.0 (/ sy yy)))))"))
