(task-entry (id "optimization/interval-contract/linear-le-contract") (skill optimization) (module interval-contract) (tier 1) (difficulty 12807) (name linear-le-contract) (type "") (description "") (notes ()) (section linear-contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor)) (answer "(define (linear-le-contract coeffs rhs box) (let loop ((remaining coeffs) (current-box box)) (if (null? remaining) current-box (let* ((pair (car remaining)) (dim (car pair)) (coef (cdr pair)) (others (remove-dim dim coeffs)) (other-bounds (sum-interval-bounds others current-box))) (if (eq? other-bounds 'empty) 'empty (let* ((other-lo (interval-lo other-bounds)) (other-hi (interval-hi other-bounds)) (iv (list-ref current-box dim)) (new-iv (contract-linear-var iv coef rhs other-lo other-hi))) (if (eq? new-iv 'empty) 'empty (loop (cdr remaining) (list-update current-box dim new-iv)))))))))"))
(task-entry (id "optimization/interval-newton/interval-newton-step") (skill optimization) (module interval-newton) (tier 1) (difficulty 12807) (name interval-newton-step) (type "(-> (-> Real Real) (-> Interval Interval) Interval NewtonStepResult)") (description "") (notes ()) (section newton-operator) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots)) (answer "(define (interval-newton-step f f-deriv-iv X) (let* ((m (interval-mid X)) (fm (f m)) (F-prime-X (f-deriv-iv X))) (cond ((interval-contains-zero? F-prime-X) (cons 'division-by-zero X)) (else (let* ((fm-iv (interval-singleton fm)) (quotient (interval-div fm-iv F-prime-X))) (if (error? quotient) (cons 'division-by-zero X) (let* ((newton-iv (interval-sub (interval-singleton m) quotient)) (intersection (interval-intersection newton-iv X))) (cond ((error? intersection) (cons 'no-root #f)) ((interval-subset? newton-iv X) (cons 'unique intersection)) ((< (interval-width intersection) (interval-width X)) (cons 'contracted intersection)) (else (cons 'no-improvement X))))))))))"))
(task-entry (id "optimization/line-search/armijo-condition?") (skill optimization) (module line-search) (tier 1) (difficulty 12808) (name armijo-condition?) (type "") (description "") (notes ()) (section overview) (deps (\x27;prelude \x27;reverse-diff)) (available (*armijo-c1* *wolfe-c2* *backtrack-rho* *max-ls-iters* *initial-step* *default-alpha-max* dot-product vec-add-scaled)) (answer "(define (armijo-condition? f-new f-old alpha grad-dot-d c1) (<= f-new (+ f-old (* c1 alpha grad-dot-d))))"))
(task-entry (id "optimization/convergence/convergence-state?") (skill optimization) (module convergence) (tier 1) (difficulty 12808) (name convergence-state?) (type "(-> α Bool)") (description "") (notes ()) (section convergence-state) (deps (\x27;prelude \x27;vec)) (available (make-convergence-criteria *default-convergence* convergence-criteria? cc-grad-tol cc-f-tol cc-x-tol cc-max-iter make-convergence-state)) (answer "(define (convergence-state? x) (and (pair? x) (eq? (car x) 'convergence-state)))"))
(task-entry (id "optimization/first-order/adagrad-full") (skill optimization) (module first-order) (tier 1) (difficulty 12808) (name adagrad-full) (type "(-> (-> (List TracedValue) TracedValue) (List Number) Number Number ConvergenceCriteria OptResult)") (description "Adagrad with all hyperparameters") (notes ()) (section adagrad) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search \x27;matrix)) (available (gradient-descent sgd momentum adam adam-full rmsprop rmsprop-full adagrad)) (answer "(define (adagrad-full f x0 lr epsilon criteria) (let* ((n (length x0)) (init-g (make-list n 0)) (init-grad (gradient f x0)) (init-f (apply f x0)) (init-state (initial-convergence-state init-f init-grad))) (let loop ((x x0) (g init-g) (state init-state)) (let ((reason (converged? criteria state))) (if reason (make-opt-result x (cs-f-val state) (gradient f x) (cs-iter state) reason) (let* ((grad (gradient f x)) (g-new (map (lambda (gi gradi) (+ gi (* gradi gradi))) g grad)) (x-new (map (lambda (xi gradi gi) (- xi (* lr (/ gradi (+ (sqrt gi) epsilon))))) x grad g-new)) (f-new (apply f x-new)) (grad-new (gradient f x-new)) (new-state (update-convergence-state state f-new grad-new x x-new))) (loop x-new g-new new-state)))))))"))
(task-entry (id "optimization/newton/cg-newton-direction") (skill optimization) (module newton) (tier 1) (difficulty 12808) (name cg-newton-direction) (type "") (description "") (notes ()) (section newtons-method) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;reverse-diff \x27;higher-order-diff \x27;convergence \x27;line-search)) (available (newton-method newton-method-full newton-solve-direction matrix-add-diagonal modified-newton make-positive-definite newton-cg newton-cg-full)) (answer "(define (cg-newton-direction f x grad max-iters tol) (let* ((n (length x)) (neg-grad (map - grad)) (hvp (lambda (v) (hessian-vector-product f x v))) (d (make-list n 0)) (r neg-grad) (p r) (rr (dot-product r r))) (if (< rr (* tol tol)) d (let loop ((d d) (r r) (p p) (rr rr) (iter 0)) (if (>= iter max-iters) d (let* ((hp (hvp p)) (php (dot-product p hp)) (_ (if (<= php 0) d #f))) (if (and _ (<= php 0)) (if (= iter 0) neg-grad d) (let* ((alpha (/ rr php)) (d-new (vec-add-scaled d p alpha)) (r-new (vec-add-scaled r hp (- alpha))) (rr-new (dot-product r-new r-new))) (if (< rr-new (* tol tol)) d-new (let* ((beta (/ rr-new rr)) (p-new (vec-add-scaled r-new p beta))) (loop d-new r-new p-new rr-new (+ iter 1))))))))))))"))
(task-entry (id "optimization/lbfgs/take-n") (skill optimization) (module lbfgs) (tier 1) (difficulty 12808) (name take-n) (type "") (description "") (notes ()) (section history-structure) (deps (\x27;prelude \x27;reverse-diff \x27;convergence \x27;line-search)) (available (make-lbfgs-history lbfgs-history? lh-max-size lh-size lh-s-list lh-y-list lh-rho-list lbfgs-history-push)) (answer "(define (take-n lst n) (if (or (null? lst) (= n 0)) '() (cons (car lst) (take-n (cdr lst) (- n 1)))))"))
