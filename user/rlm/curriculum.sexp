(task-entry (id "optics/optics/prism-over") (skill optics) (module optics) (tier 1) (difficulty 11018) (name prism-over) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id)) (answer "(define (prism-over prism f s) (let ((maybe-a (preview prism s))) (if (nothing? maybe-a) s (review prism (f (from-just maybe-a))))))"))
