(task-entry (id "statistics/chi-squared/unique-vector") (skill statistics) (module chi-squared) (tier 1) (difficulty 11206) (name unique-vector) (type "") (description "") (notes ()) (section goodness-of-fit-test) (deps (\x27;prelude \x27;matrix \x27;result-types \x27;stat/distributions)) (available (chi-squared-test-goodness chi-squared-test-goodness-uniform chi-squared-test-goodness-proportions chi-squared-test-independence vec-sum contingency-table)) (answer "(define (unique-vector v) (let* ((n (vector-length v)) (seen '())) (do ((i 0 (+ i 1))) ((= i n)) (let ((val (vector-ref v i))) (unless (member val seen) (set! seen (cons val seen))))) (list->vector (reverse seen))))"))
(task-entry (id "statistics/anova/tukey-hsd-bonferroni") (skill statistics) (module anova) (tier 1) (difficulty 11206) (name tukey-hsd-bonferroni) (type "") (description "") (notes ()) (section one-way-anova) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;stat/distributions)) (available (anova-one-way compute-grand-mean compute-ss-between compute-ss-within anova-eta-squared anova-omega-squared)) (answer "(define (tukey-hsd-bonferroni groups alpha) (let* ((k (length groups)) (n (apply + (map vector-length groups))) (means (map vec-mean groups)) (ns (map vector-length groups)) (ss-within (compute-ss-within groups means)) (df-within (- n k)) (ms-within (/ ss-within df-within)) (num-comparisons (/ (* k (- k 1)) 2)) (alpha-adj (/ alpha num-comparisons)) (results '())) (let loop-i ((i 0) (res '())) (if (>= i (- k 1)) (reverse res) (loop-i (+ i 1) (let loop-j ((j (+ i 1)) (r res)) (if (>= j k) r (let* ((mean-i (list-ref means i)) (mean-j (list-ref means j)) (ni (list-ref ns i)) (nj (list-ref ns j)) (se (sqrt (* ms-within (+ (/ 1 ni) (/ 1 nj))))) (diff (- mean-i mean-j)) (t-stat (/ (abs diff) se)) (p-value (t-pvalue-two-tailed t-stat df-within)) (significant? (< p-value alpha-adj))) (loop-j (+ j 1) (cons (list i j diff p-value significant?) r))))))))))"))
