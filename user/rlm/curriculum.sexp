(task-entry (id "clp/domain/domain->string") (skill clp) (module domain) (tier 1) (difficulty 10827) (name domain->string) (type "(-> Domain String)") (description "Convert domain to readable string representation") (notes ()) (section domain-display) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals interval<? domain-subtract-value domain-subtract domain-restrict-min domain-restrict-max domain->list domain-for-each domain-fold domain=? domain-subset?)) (answer "(define (domain->string dom) (if (null? dom) \"{}\" (string-append \"{\" (apply string-append (list-intersperse (map interval->string dom) \", \")) \"}\")))"))
(task-entry (id "clp/store/cstore-add-constraint") (skill clp) (module store) (tier 1) (difficulty 10827) (name cstore-add-constraint) (type "(-> CStore Constraint CStore)") (description "Add a constraint to the store") (notes ()) (section constraint-management) (deps (\x27;prelude \x27;logic \x27;domain)) (available (make-cstore cstore? cstore-subst cstore-domains cstore-constraints cstore-pending cstore-set-subst cstore-set-domains cstore-set-constraints cstore-set-pending cstore-get-domain cstore-set-domain alist-update alist-remove cstore-narrow-domain cstore-remove-value cstore-bind-var cstore-unify cstore-bind-term occurs? *constraint-counter* make-constraint constraint? constraint-id constraint-type constraint-vars constraint-propagator)) (answer "(define (cstore-add-constraint cs constraint) (let ((constraints (cstore-constraints cs))) (cstore-set-constraints cs (cons constraint constraints))))"))
