(task-entry (id "topology/homology/sc-boundary-matrix-print") (skill topology) (module homology) (tier 1) (difficulty 11832) (name sc-boundary-matrix-print) (type "(-> SC Integer Void)") (description "Print a boundary matrix with simplex labels") (notes ()) (section debugging-visualization) (deps (\x27;simplicial-complex)) (available (z2-matrix z2-matrix? z2-matrix-rows z2-matrix-cols z2-matrix-data z2-matrix-ref z2-matrix-set! z2-matrix-zero z2-matrix-copy z2-matrix-swap-rows! z2-matrix-add-row! z2-rank z2-nullity z2-rref z2-null-space z2-null-basis-vector list->hashtable-set hashtable-set-member? simplex-index build-simplex-index-table simplex-index-fast sc-boundary-matrix sc-betti sc-betti-numbers sc-homology-summary make-sphere make-torus make-klein-bottle make-projective-plane sc-connected-components list-index z2-matrix-print)) (answer "(define (sc-boundary-matrix-print sc k) (let* ((domain (sc-simplices-dim sc k)) (codomain (sc-simplices-dim sc (- k 1))) (mat (sc-boundary-matrix sc k))) (printf \"~nd_~a : C_~a -> C_~a~n\" k k (- k 1)) (printf \"Domain (~a-simplices):   ~a~n\" k (map simplex-vertices domain)) (printf \"Codomain (~a-simplices): ~a~n\" (- k 1) (map simplex-vertices codomain)) (z2-matrix-print mat)))"))
