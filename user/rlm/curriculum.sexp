(task-entry (id "physics/diff3d/diff-constraints3d/make-chain-system-3d") (skill physics/diff3d) (module diff-constraints3d) (tier 2) (difficulty 23058) (name make-chain-system-3d) (type "") (description "") (notes ()) (section spring-constraints) (deps (\x27;prelude \x27;vec3 \x27;reverse-diff \x27;traced-vec3 \x27;traced-quaternion \x27;traced-body3d)) (available (traced-spring-force-3d traced-spring-force-damped-3d make-spring-constraint-3d spring-constraint-3d-body-a spring-constraint-3d-anchor-a spring-constraint-3d-body-b spring-constraint-3d-anchor-b spring-constraint-3d-rest-length spring-constraint-3d-stiffness spring-constraint-3d-damping *distance-constraint-stiffness-3d* *distance-constraint-damping-3d* make-distance-constraint-3d make-anchor-constraint-3d anchor-constraint-3d-body anchor-constraint-3d-local-anchor anchor-constraint-3d-world-target anchor-constraint-3d-stiffness anchor-constraint-3d-damping traced-anchor-force-3d make-ball-socket-joint-3d ball-socket-joint-3d-body-a ball-socket-joint-3d-anchor-a ball-socket-joint-3d-body-b ball-socket-joint-3d-anchor-b ball-socket-joint-3d-stiffness ball-socket-joint-3d-damping traced-ball-socket-forces-3d make-hinge-joint-3d hinge-joint-3d-body-a hinge-joint-3d-anchor-a hinge-joint-3d-axis-a hinge-joint-3d-body-b hinge-joint-3d-anchor-b hinge-joint-3d-axis-b hinge-joint-3d-stiffness hinge-joint-3d-damping traced-hinge-forces-3d make-fixed-joint-3d fixed-joint-3d-body-a fixed-joint-3d-anchor-a fixed-joint-3d-body-b fixed-joint-3d-anchor-b fixed-joint-3d-ref-orientation fixed-joint-3d-stiffness fixed-joint-3d-damping traced-fixed-forces-3d constraint-type-3d traced-apply-spring-constraint-3d traced-apply-anchor-constraint-3d traced-apply-ball-socket-joint-3d traced-apply-hinge-joint-3d traced-apply-fixed-joint-3d traced-apply-constraint-3d traced-apply-all-constraints-3d traced-constraint-step-3d vector-map-3d make-pendulum-system-3d)) (answer "(define (make-chain-system-3d start-pos num-links link-length mass radius tape) (let* ((inertia (inertia-solid-sphere mass radius)) (bodies (list->vector (let loop ((i 0) (y (vec3-y start-pos))) (if (= i num-links) '() (let ((pos (lift-vec3 (vec3 (vec3-x start-pos) y (vec3-z start-pos)) tape)) (vel (lift-vec3 (vec3-zero) tape)) (orient (lift-quat (quat-identity) tape)) (omega (lift-vec3 (vec3-zero) tape))) (cons (make-traced-body-3d pos vel orient omega mass inertia) (loop (+ i 1) (- y link-length)))))))) (anchor (make-anchor-constraint-3d 0 (vec3-zero) start-pos *distance-constraint-stiffness-3d* *distance-constraint-damping-3d*)) (links (let loop ((i 0)) (if (>= i (- num-links 1)) '() (cons (make-ball-socket-joint-3d i (vec3-zero) (+ i 1) (vec3-zero) *distance-constraint-stiffness-3d* *distance-constraint-damping-3d*) (loop (+ i 1))))))) (values bodies (cons anchor links))))"))
