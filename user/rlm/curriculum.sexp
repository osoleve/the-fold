(task-entry (id "sim/bifurcation/detect-fold-from-param-reversal") (skill sim) (module bifurcation) (tier 2) (difficulty 23353) (name detect-fold-from-param-reversal) (type "(-> (Option (List Number Vec Symbol (List Complex))) (List Number Vec Symbol (List Complex)) (List Number Vec Symbol (List Complex)) (List Complex) (Option Symbol))") (description "Detect fold (saddle-node) from parameter direction reversal in arc-length data") (notes ("At a fold, parameter reaches extremum and direction reverses.\nA REAL eigenvalue crosses zero (distinguishes from Hopf where complex pair crosses).")) (section bifurcation-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance*)) (answer "(define (detect-fold-from-param-reversal prev-prev prev curr prev-eigs) (if (not prev-prev) #f (let* ((pp-param (car prev-prev)) (p-param (car prev)) (c-param (car curr)) (dp1 (- p-param pp-param)) (dp2 (- c-param p-param)) (reversal? (< (* dp1 dp2) 0)) (pp-eigs (cadddr prev-prev)) (curr-eigs (cadddr curr)) (has-real-zero-crossing (fold-has-real-eigenvalue-zero-crossing pp-eigs prev-eigs curr-eigs))) (if (and reversal? has-real-zero-crossing) 'saddle-node #f))))"))
(task-entry (id "sim/bifurcation/fold-has-real-eigenvalue-zero-crossing") (skill sim) (module bifurcation) (tier 2) (difficulty 23354) (name fold-has-real-eigenvalue-zero-crossing) (type "(-> (List Complex) (List Complex) (List Complex) Boolean)") (description "Check if a real eigenvalue crosses zero across the fold point") (notes ("For a true saddle-node: eigenvalue is real (small imaginary part),\npasses through near-zero at the fold, and changes sign across it.")) (section bifurcation-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal)) (answer "(define (fold-has-real-eigenvalue-zero-crossing pp-eigs prev-eigs curr-eigs) (if (or (null? pp-eigs) (null? prev-eigs) (null? curr-eigs)) #f (let ((n (length prev-eigs))) (any (lambda (i) (let* ((pp-e (list-ref pp-eigs i)) (p-e (list-ref prev-eigs i)) (c-e (list-ref curr-eigs i)) (pp-re (complex-real pp-e)) (pp-im (complex-imag pp-e)) (p-re (complex-real p-e)) (p-im (complex-imag p-e)) (c-re (complex-real c-e)) (c-im (complex-imag c-e)) (all-real? (and (< (abs pp-im) *fold-imaginary-tolerance*) (< (abs p-im) *fold-imaginary-tolerance*) (< (abs c-im) *fold-imaginary-tolerance*))) (near-zero? (<= (abs p-re) *fold-eigenvalue-tolerance*)) (sign-change? (< (* pp-re c-re) 0))) (and all-real? near-zero? sign-change?))) (iota n)))))"))
(task-entry (id "sim/bifurcation/detect-bifurcations") (skill sim) (module bifurcation) (tier 2) (difficulty 23355) (name detect-bifurcations) (type "(-> (List (List Number Vec Symbol (List Complex))) (Option ParamODE) (List (List Symbol Number Vec)))") (description "Detect bifurcation points from continuation data by analyzing eigenvalue transitions") (notes ("For arc-length continuation, also detects fold points via parameter direction reversal")) (section bifurcation-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing)) (answer "(define (detect-bifurcations continuation-data . opt-psys) (let ((psys (if (null? opt-psys) #f (car opt-psys)))) (if (or (null? continuation-data) (null? (cdr continuation-data))) '() (let loop ((prev-prev #f) (prev (car continuation-data)) (rest (cdr continuation-data)) (bifurcations '())) (if (null? rest) (reverse bifurcations) (let* ((curr (car rest)) (prev-param (car prev)) (curr-param (car curr)) (prev-eigs (cadddr prev)) (curr-eigs (cadddr curr)) (prev-stab (caddr prev)) (curr-stab (caddr curr)) (curr-fp (cadr curr)) (fold-bif (detect-fold-from-param-reversal prev-prev prev curr prev-eigs)) (bif (if fold-bif #f (detect-bifurcation-type prev-eigs curr-eigs prev-stab curr-stab)))) (let* ((effective-bif (or fold-bif bif)) (refined-bif (if (and psys effective-bif (eq? effective-bif 'pitchfork-or-transcritical)) (let ((sys (instantiate-at psys curr-param))) (classify-codim1-bifurcation sys curr-fp *normal-form-h*)) effective-bif)) (bif-param (if fold-bif prev-param curr-param)) (bif-fp (if fold-bif (cadr prev) curr-fp))) (loop prev curr (cdr rest) (if refined-bif (cons (list refined-bif bif-param bif-fp) bifurcations) bifurcations)))))))))"))
(task-entry (id "sim/bifurcation/detect-bifurcation-type") (skill sim) (module bifurcation) (tier 2) (difficulty 23356) (name detect-bifurcation-type) (type "(-> (List Complex) (List Complex) Symbol Symbol (Option Symbol))") (description "Determine bifurcation type from eigenvalue transition") (notes ("Order matters: pitchfork/transcritical checked first (stability change with persistence),\nthen Hopf (complex eigenvalues), then saddle-node (real eigenvalue crossing without stability change).")) (section bifurcation-detection) (deps (\x27;prelude \x27;vec \x27;matrix \x27;svd \x27;complex \x27;ode-system \x27;sim/stability \x27;chaos)) (available (any every analyze-stability-1d analyze-stability-general make-parameterized-ode param-ode? param-ode-maker instantiate-at *continuation-tolerance* *continuation-step-size* *continuation-max-newton* *use-robust-newton* find-fixed-point-solver continue-fixed-point *arclength-step* *arclength-max-correct* continue-fixed-point-arclength compute-tangent compute-parameter-jacobian solve-for-tangent-direction compute-tangent-at-fold augment-with-column extract-column subvector arclength-predict arclength-correct solve-bordered-system make-bordered-matrix orient-tangent *adaptive-eigenvalue-threshold* *adaptive-curvature-threshold* *adaptive-residual-threshold* *adaptive-residual-critical* *adaptive-min-step* *adaptive-max-step-multiplier* *adaptive-expansion-count* *adaptive-shrink-factor* *adaptive-expand-factor* compute-eigenvalue-factor compute-curvature-factor compute-residual-factor compute-adaptive-step should-expand? continue-fixed-point-arclength-adaptive arclength-correct-with-retry continue-fixed-point-adaptive find-fixed-point-with-retry find-fixed-point-robust-with-iters find-all-fixed-points generate-nd-grid remove-duplicate-points *fold-eigenvalue-tolerance* *fold-imaginary-tolerance* detect-fold-from-param-reversal fold-has-real-eigenvalue-zero-crossing detect-bifurcations)) (answer "(define (detect-bifurcation-type prev-eigs curr-eigs prev-stab curr-stab) (let* ((prev-reals (map complex-real prev-eigs)) (curr-reals (map complex-real curr-eigs)) (prev-imags (map complex-imag prev-eigs)) (curr-imags (map complex-imag curr-eigs)) (stab-changed (stability-changed? prev-stab curr-stab)) (real-zero-crossing (real-eigenvalue-zero-crossing? prev-reals curr-reals prev-imags))) (cond ((hopf-condition? prev-reals curr-reals prev-imags curr-imags) 'hopf) ((and stab-changed real-zero-crossing) 'pitchfork-or-transcritical) ((and real-zero-crossing (not stab-changed) (saddle-node-condition? prev-reals curr-reals prev-imags)) 'saddle-node) (else #f))))"))
