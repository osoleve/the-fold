(task-entry (id "dsl/reader/regex-reader-macro") (skill dsl) (module reader) (tier 1) (difficulty 11743) (name regex-reader-macro) (type "") (description "") (notes ()) (section readtable-data-structure) (deps (\x27;prelude \x27;combinators)) (available (make-readtable readtable? readtable-entries readtable-lookup readtable-extend readtable-remove make-readtable-stack readtable-stack? readtable-stack-push readtable-stack-pop readtable-stack-current readtable-stack-lookup make-reader-macro reader-macro? reader-macro-name reader-macro-transform reader-macro-delimiter dispatch-char? make-reader-token reader-token? reader-token-type reader-token-value reader-token-source make-reader-source-loc reader-source-loc-file reader-source-loc-line reader-source-loc-column no-reader-source delimiter-pairs delimiter-close delimiter-open make-reader-state reader-state? reader-state-filename reader-state-line reader-state-column reader-state-stack reader-state-source-loc reader-state-update-position reader-state-push-readtable reader-state-pop-readtable vector-reader-macro matrix-reader-macro)) (answer "(define regex-reader-macro (make-reader-macro 'regex (lambda (contents source-loc) (if (and (pair? contents) (string? (car contents))) (let ((pattern (car contents)) (flags (if (null? (cdr contents)) '() (cadr contents)))) (quasiquote (regex (unquote pattern) '(unquote flags)))) (quasiquote (regex \"\" '())))) #\\/))"))
(task-entry (id "dsl/staging/stage-fix") (skill dsl) (module staging) (tier 1) (difficulty 11743) (name stage-fix) (type "") (description "") (notes ()) (section staging-detection) (deps (\x27;prelude \x27;combinators \x27;quasi)) (available (make-code code? code-stage code-expr stage-quote? stage-splice? stage-run? make-stage-env stage-env? stage-env-level stage-env-bindings stage-env-fragments stage-env-incr stage-env-decr stage-env-bind stage-env-lookup stage-env-add-fragment stage-expand code-combine code-lift code-unlift code-type code-well-staged? stage-add stage-mul stage-sub stage-div stage-if stage-let stage-lambda stage-app make-csp csp? csp-name csp-value lift-csp power-staged power-specialized code->string compile-staged run-staged stage-match-clause? stage-match)) (answer "(define (stage-fix f) (let* ((rec-name (gensym 'rec)) (dummy (make-code 1 rec-name)) (body (f dummy))) (make-code (code-stage body) (quasiquote (letrec (((unquote rec-name) (unquote (code-expr body)))) (unquote rec-name))))))"))
(task-entry (id "dsl/tagless/make-env-expr-dict") (skill dsl) (module tagless) (tier 1) (difficulty 11744) (name make-env-expr-dict) (type "") (description "") (notes ()) (section generic-dictionary-operations) (deps (\x27;prelude)) (available (make-dict dict-tag dict-ops dict-ref dict-has? dict-extend dict-merge make-expr-dict expr-lit expr-add expr-neg eval-expr-dict pretty-expr-dict count-expr-dict depth-expr-dict example-expr-1 example-expr-2 make-mul-dict expr-mul eval-mul-dict pretty-mul-dict example-mul make-bool-dict bool-lit bool-and bool-or bool-not eval-bool-dict pretty-bool-dict make-cmp-dict cmp-eq cmp-lt cmp-gt eval-full-dict make-cond-dict cond-if-lazy eval-cond-dict pretty-cond-dict make-lazy-cond-dict lazy-if eval-lazy-cond-dict make-let-dict tl-let tl-var)) (answer "(define (make-env-expr-dict) (make-dict 'env-expr (quasiquote ((lit unquote (lambda (n) (lambda (env) n))) (add unquote (lambda (x y) (lambda (env) (+ (x env) (y env))))) (neg unquote (lambda (x) (lambda (env) (- (x env))))) (let unquote (lambda (name val body) (lambda (env) (let ((v (val env))) (body (cons (cons name v) env)))))) (var unquote (lambda (name) (lambda (env) (let ((pair (assq name env))) (if pair (cdr pair) (error 'var \"Unbound variable\" name))))))))))"))
(task-entry (id "dsl/match/select-column") (skill dsl) (module match) (tier 1) (difficulty 11744) (name select-column) (type "") (description "") (notes ()) (section decision-tree-representation) (deps (\x27;prelude \x27;combinators core/types/pattern-check.ss)) (available (make-as-pattern make-view-pattern make-active-pattern as-pattern? view-pattern? active-pattern? as-pattern-name as-pattern-inner view-pattern-fn view-pattern-inner active-pattern-name active-pattern-args make-leaf make-fail make-switch make-dt-guard leaf? fail? switch? dt-guard? leaf-action leaf-bindings switch-scrutinee switch-branches switch-default dt-guard-condition dt-guard-success dt-guard-failure make-branch branch? branch-tag branch-arity branch-subtree make-clause clause? clause-pattern clause-guard clause-body parse-pattern-extended parse-clause collect-bindings collect-bindings-from-pattern compile-match compile-clauses)) (answer "(define (select-column rows) (let* ((first-row (car rows)) (patterns (if (list? first-row) (car first-row) first-row)) (num-cols (if (list? patterns) (length patterns) 1))) (if (= num-cols 1) 0 (let loop ((idx 0)) (if (>= idx num-cols) 0 (let ((col-patterns (map (lambda (row) (let ((pats (if (list? row) (car row) row))) (if (list? pats) (list-ref pats idx) pats))) rows))) (if (any ctor-pattern? col-patterns) idx (loop (+ idx 1)))))))))"))
