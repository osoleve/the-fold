(task-entry (id "numeric/signal-poly/filter-simplify") (skill numeric) (module signal-poly) (tier 0) (difficulty 2527) (name filter-simplify) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;field \x27;algebra/polynomial \x27;digital-filters)) (available (Q-field-sig sig-make-polynomial sig-normalize-coeffs sig-poly-field sig-poly-coeffs sig-poly-degree sig-poly-zero? sig-poly-leading sig-poly-add sig-poly-sub sig-poly-mul list-set sig-poly-scale sig-poly-divmod sig-poly-zero-over sig-poly-one-over sig-poly-divmod-iter sig-poly-div sig-poly-mod sig-poly-gcd sig-poly-make-monic num-poly-coeffs-sig numeric->signal-poly signal->numeric-poly filter-num-poly filter-den-poly filter-coprime?)) (answer "(define (filter-simplify f) (let* ((num (filter-num-poly f)) (den (filter-den-poly f)) (gcd-poly (sig-poly-gcd num den))) (if (<= (sig-poly-degree gcd-poly) 0) f (let* ((num-simplified (sig-poly-div num gcd-poly)) (den-simplified (sig-poly-div den gcd-poly)) (b-coeffs (sig-poly-coeffs num-simplified)) (a-coeffs (sig-poly-coeffs den-simplified))) (make-iir-filter (list->vector b-coeffs) (list->vector a-coeffs))))))"))
(task-entry (id "numeric/interpolate/chebyshev-coeffs") (skill numeric) (module interpolate) (tier 0) (difficulty 2527) (name chebyshev-coeffs) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;numeric/polynomial)) (available (binary-search-segment binary-search-segment-vec lerp lerp-inverse interp-linear lagrange-basis interp-lagrange divided-differences interp-newton interp-hermite hermite-tangent-estimate thomas-algorithm cubic-spline-natural matrix-set! spline-eval interp-cubic-spline bezier-linear bezier-quadratic bezier-cubic bezier-general bezier-derivative polyfit linreg linreg-r2 chebyshev-nodes chebyshev-nodes-interval chebyshev-t)) (answer "(define (chebyshev-coeffs f n) (let ((nodes (chebyshev-nodes n)) (pi 3.141592653589793)) (let loop ((k 0) (result '())) (if (= k n) (reverse result) (let ((sum (apply + (map (lambda (x) (* (f x) (chebyshev-t k x))) nodes)))) (loop (+ k 1) (cons (* (/ (if (= k 0) 1 2) n) sum) result)))))))"))
