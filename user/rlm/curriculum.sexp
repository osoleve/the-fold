(task-entry (id "diffgeo/curvature/riemann-tensor") (skill diffgeo) (module curvature) (tier 1) (difficulty 10719) (name riemann-tensor) (type "") (description "") (notes ()) (section metric-tensor-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-decomp \x27;matrix-solvers \x27;charts \x27;tangent)) (available (*curvature-epsilon* metric? metric-chart metric-fn metric-dim make-metric metric-at metric-at-point make-euclidean-metric make-polar-metric make-spherical-metric make-cylindrical-metric metric-inverse metric-inner-product metric-norm metric-determinant christoffel-symbols compute-metric-derivatives christoffel-ref)) (answer "(define (riemann-tensor m coords . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *curvature-epsilon* (car epsilon-arg))) (n (metric-dim m)) (gamma (christoffel-symbols m coords eps)) (dgamma (compute-christoffel-derivatives m coords eps n)) (R (make-4d-array n))) (do ((l 0 (+ l 1))) ((= l n) R) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (do ((k 0 (+ k 1))) ((= k n)) (let ((term1 (dgamma-ref dgamma j l i k)) (term2 (dgamma-ref dgamma k l i j)) (sum 0)) (do ((mm 0 (+ mm 1))) ((= mm n)) (set! sum (+ sum (- (* (christoffel-ref gamma l j mm) (christoffel-ref gamma mm i k)) (* (christoffel-ref gamma l k mm) (christoffel-ref gamma mm i j)))))) (array-4d-set! R l i j k (+ (- term1 term2) sum)))))))))"))
(task-entry (id "diffgeo/geodesics/adaptive-geodesic-step") (skill diffgeo) (module geodesics) (tier 1) (difficulty 10719) (name adaptive-geodesic-step) (type "(-> Metric GeodesicState Num Num (Optional (Pair Vec Vec)) (List GeodesicState Num Num Nat (Pair Vec Vec)))") (description "Single adaptive RK5(4) step with error control and FSAL optimization") (notes ()) (section adaptive-integration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;curvature \x27;sort)) (available (*geodesic-epsilon* *geodesic-tolerance* *geodesic-max-iterations* make-geodesic-state geodesic-state? geodesic-state-coords geodesic-state-velocity geodesic-acceleration geodesic-derivative rk4-geodesic-step dp-c dp-a dp-b5 dp-b4 *adaptive-safety* *adaptive-min-scale* *adaptive-max-scale* dp-geodesic-step adaptive-step-size)) (answer "(define (adaptive-geodesic-step metric state dt tol . k1-cache-opt) (let loop ((h dt) (rejects 0) (k1-cache (if (null? k1-cache-opt) #f (car k1-cache-opt)))) (let* ((result (dp-geodesic-step metric state h k1-cache)) (y5 (car result)) (_ (cadr result)) (err (caddr result)) (k7 (cadddr result))) (if (<= err tol) (let ((h-new (adaptive-step-size h err tol 5))) (list y5 h h-new rejects k7)) (let ((h-new (adaptive-step-size h err tol 5))) (if (< h-new (* h 0.001)) (begin (list y5 h h rejects k7)) (loop h-new (+ rejects 1) k1-cache)))))))"))
(task-entry (id "diffgeo/forms/make-k-form") (skill diffgeo) (module forms) (tier 1) (difficulty 10719) (name make-k-form) (type "") (description "") (notes ()) (section k-form) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts \x27;tangent)) (available (multi-index? strictly-increasing? multi-index-degree generate-multi-indices multi-index->offset offset->multi-index list-index binomial permutation-sign shuffle-sign indices-overlap? merge-indices count-inversions-to-sort k-form? k-form-point k-form-chart k-form-degree k-form-components k-form-dim)) (answer "(define (make-k-form point chart degree components) (let* ((n (chart-dim chart)) (expected-size (binomial n degree))) (cond ((not (chart-contains? chart point)) (quasiquote (error point-not-in-chart (unquote (chart-name chart))))) ((not (= (vector-length components) expected-size)) (quasiquote (error wrong-component-count expected (unquote expected-size) got (unquote (vector-length components))))) (else (list 'k-form point chart degree components)))))"))
