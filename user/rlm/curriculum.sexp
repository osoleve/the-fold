(task-entry (id "physics-problems/simulation/capture-frames-with-final") (skill physics-problems) (module simulation) (tier 2) (difficulty 23623) (name capture-frames-with-final) (type "") (description "") (notes ()) (section rendering) (deps (\x27;prelude \x27;vec2 \x27;world \x27;ascii-renderer)) (available (make-problem-config problem-config? problem-config-width problem-config-height problem-config-scale problem-config-dt problem-config-frames-per-step default-problem-config high-res-problem-config make-ball make-ball-static make-box make-ground setup-problem-world setup-no-gravity-world setup-gravity-world simulate-step simulate-n-steps simulate-frames make-problem-renderer render-world-frame render-frames capture-frames)) (answer "(define (capture-frames-with-final world config n-frames) (let* ((renderer (make-problem-renderer config)) (worlds (simulate-frames world config n-frames)) (frames (render-frames worlds renderer)) (final-world (if (null? worlds) world (car (reverse worlds))))) (cons frames final-world)))"))
