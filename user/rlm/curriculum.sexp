(task-entry (id "optimization/interval-contract/make-linear-ge-contractor") (skill optimization) (module interval-contract) (tier 1) (difficulty 12811) (name make-linear-ge-contractor) (type "") (description "") (notes ()) (section linear-contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract contract-linear-var remove-dim sum-interval-bounds)) (answer "(define (make-linear-ge-contractor coeffs rhs) (let ((neg-coeffs (map (lambda (p) (cons (car p) (- (cdr p)))) coeffs))) (make-linear-le-contractor neg-coeffs (- rhs))))"))
(task-entry (id "optimization/interval-newton/interval-might-contain-root?") (skill optimization) (module interval-newton) (tier 1) (difficulty 12811) (name interval-might-contain-root?) (type "") (description "") (notes ()) (section all-roots) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step interval-newton-step-rigorous interval-newton-root interval-find-all-roots)) (answer "(define (interval-might-contain-root? f X) (let* ((lo (interval-lo X)) (hi (interval-hi X)) (mid (interval-mid X)) (f-lo (f lo)) (f-hi (f hi)) (f-mid (f mid))) (or (< (* f-lo f-hi) 0) (< (* f-lo f-mid) 0) (< (* f-mid f-hi) 0) (< (abs f-lo) 1e-10) (< (abs f-hi) 1e-10) (< (abs f-mid) 1e-10))))"))
(task-entry (id "optimization/line-search/strong-curvature-condition?") (skill optimization) (module line-search) (tier 1) (difficulty 12812) (name strong-curvature-condition?) (type "") (description "") (notes ()) (section overview) (deps (\x27;prelude \x27;reverse-diff)) (available (*armijo-c1* *wolfe-c2* *backtrack-rho* *max-ls-iters* *initial-step* *default-alpha-max* dot-product vec-add-scaled armijo-condition? armijo-backtrack armijo-backtrack-full curvature-condition?)) (answer "(define (strong-curvature-condition? grad-new-dot-d grad-old-dot-d c2) (<= (abs grad-new-dot-d) (* c2 (abs grad-old-dot-d))))"))
