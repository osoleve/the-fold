(task-entry (id "game-theory/coop-games/make-additive-game") (skill game-theory) (module coop-games) (tier 1) (difficulty 13237) (name make-additive-game) (type "") (description "") (notes ()) (section shapley-value) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference coalition-complement coalition-size coalition->list list->coalition all-coalitions coalition-subset? make-coop-game coop-game? coop-game-players coop-game-value coop-game-grand-coalition coop-game-type coop-game-cost? coop-game-value? allocation-total allocation-coalition-total imputation? make-factorial-cache shapley-weight shapley-value core-excess allocation-in-core? max-excess nucleolus nucleolus-iterate build-nucleolus-lp find-tight-coalitions extract-nucleolus-allocation bargaining-set nash-bargaining kalai-smorodinsky)) (answer "(define (make-additive-game values) (let* ((n (length values)) (v-vec (list->vector values))) (make-coop-game n (lambda (S) (allocation-coalition-total v-vec S)))))"))
(task-entry (id "game-theory/matching/extract-ilp-matches") (skill game-theory) (module matching) (tier 1) (difficulty 13237) (name extract-ilp-matches) (type "") (description "") (notes ()) (section weighted-matching-ilp) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market? market-proposers market-receivers market-proposer-prefs market-receiver-prefs market-num-proposers market-num-receivers stable-match gs-loop gs-process-proposal build-receiver-ranks build-rank-table receiver-prefers? find-receiver-idx find-proposer-idx extract-matching matching-stable? build-match-table-p build-match-table-r find-blocking-pair prefers-to? make-assignment-game assignment-game-value optimal-assignment-subset optimal-assignment extract-assignment-matches make-medical-residency-market make-school-choice-market make-random-preferences preference-rank stable-match-receiver-optimal same-matched-agents? symbol<? weighted-matching-ilp)) (answer "(define (extract-ilp-matches x n m) (let loop ((i 0) (j 0) (result '())) (cond ((= i n) (reverse result)) ((= j m) (loop (+ i 1) 0 result)) (else (let* ((var-idx (+ (* i m) j)) (val (vector-ref x var-idx))) (loop i (+ j 1) (if (> val 0.5) (cons (cons i j) result) result)))))))"))
(task-entry (id "game-theory/voting/build-margin-matrix") (skill game-theory) (module voting) (tier 1) (difficulty 13237) (name build-margin-matrix) (type "(-> PreferenceProfile (Vector (Vector Int)))") (description "Build matrix M where M[i][j] = margin of i over j. Complexity: O(V * N²) where V = voters, N = candidates") (notes ("Optimized: Instead of calling pairwise-margin for each pair O(V*N²*V), we iterate through the profile once and update all pairs per ranking")) (section schulze-method) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates profile-rankings profile-empty? list->set set=? for-all? position-of count-if argmax all-maxima plurality-scores borda-scores antiplurality-scores positional-score positional-winner positional-ranking plurality-winner borda-winner antiplurality-winner plurality-scores-all borda-scores-all pairwise-margin pairwise-beats? condorcet-winner? condorcet-winner condorcet-loser? copeland-score copeland-winner copeland-ranking minimax-score minimax-winner minimax-ranking smith-set any?)) (answer "(define (build-margin-matrix profile) (let* ((candidates (profile-candidates profile)) (n (length candidates)) (matrix (make-vector n))) (do ((i 0 (+ i 1))) ((>= i n)) (vector-set! matrix i (make-vector n 0))) (for-each (lambda (ranking) (let ((pos-of (make-eq-hashtable))) (let loop ((r ranking) (p 0)) (unless (null? r) (hashtable-set! pos-of (car r) p) (loop (cdr r) (+ p 1)))) (do ((i 0 (+ i 1))) ((>= i n)) (let ((ci (list-ref candidates i)) (row (vector-ref matrix i))) (do ((j 0 (+ j 1))) ((>= j n)) (unless (= i j) (let ((cj (list-ref candidates j))) (when (< (hashtable-ref pos-of ci n) (hashtable-ref pos-of cj n)) (vector-set! row j (+ (vector-ref row j) 1)) (vector-set! (vector-ref matrix j) i (- (vector-ref (vector-ref matrix j) i) 1)))))))))) profile) matrix))"))
(task-entry (id "game-theory/multi-winner/diversity-score") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13237) (name diversity-score) (type "") (description "") (notes ()) (section chamberlin-courant) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking ballot-with-weight ballot-top-choice count-votes stv stv-loop transfer-surplus transfer-eliminated stv-droop stv-hare make-approval-profile approval-profile-voters approval-profile-candidates approval-count approval-scores approval-winners pav-score pav-winners pav-loop sav-score sav-winners voter-satisfaction monroe-greedy monroe-loop monroe-candidate-score best-satisfaction cc-greedy cc-loop cc-marginal-score cc-total-satisfaction proportionality-score representation-coverage any?)) (answer "(define (diversity-score committee distance-fn) (if (< (length committee) 2) 0 (let* ((pairs (all-pairs committee)) (distances (map (lambda (p) (distance-fn (car p) (cdr p))) pairs))) (/ (apply + distances) (length pairs)))))"))
(task-entry (id "game-theory/fair-division/equalize-allocations") (skill game-theory) (module fair-division) (tier 1) (difficulty 13237) (name equalize-allocations) (type "") (description "") (notes ()) (section adjusted-winner) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax make-adjusted-winner-problem adjusted-winner)) (answer "(define (equalize-allocations goods points-1 points-2 alloc-1 alloc-2 score-1 score-2) (cond ((< (abs (- score-1 score-2)) 0.001) (vector (format-allocation goods alloc-1) (format-allocation goods alloc-2))) ((> score-1 score-2) (transfer-to-equalize goods points-1 points-2 alloc-1 alloc-2 score-1 score-2 0 1)) (else (let ((result (transfer-to-equalize goods points-2 points-1 alloc-2 alloc-1 score-2 score-1 1 0))) (vector (vector-ref result 1) (vector-ref result 0))))))"))
