(task-entry (id "game-theory/fair-division/adjusted-winner") (skill game-theory) (module fair-division) (tier 1) (difficulty 13236) (name adjusted-winner) (type "") (description "") (notes ()) (section adjusted-winner) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax make-adjusted-winner-problem)) (answer "(define (adjusted-winner prob) (let* ((goods (adjusted-winner-problem%-goods prob)) (points (adjusted-winner-problem%-points prob)) (n (vector-length goods)) (points-1 (vector-ref points 0)) (points-2 (vector-ref points 1)) (alloc-1 '()) (alloc-2 '()) (score-1 0) (score-2 0)) (let initial-loop ((i 0) (a1 '()) (a2 '()) (s1 0) (s2 0)) (if (>= i n) (equalize-allocations goods points-1 points-2 a1 a2 s1 s2) (let ((p1 (vector-ref points-1 i)) (p2 (vector-ref points-2 i))) (if (> p1 p2) (initial-loop (+ i 1) (cons (cons i 1) a1) a2 (+ s1 p1) s2) (if (> p2 p1) (initial-loop (+ i 1) a1 (cons (cons i 1) a2) s1 (+ s2 p2)) (initial-loop (+ i 1) (cons (cons i 1) a1) a2 (+ s1 p1) s2))))))))"))
