(task-entry (id "optics/format-iso/iso-time-unix") (skill optics) (module format-iso) (tier 1) (difficulty 11017) (name iso-time-unix) (type "") (description "") (notes ()) (section time) (deps (\x27;sort \x27;profunctor-optics)) (available (iso-utf8 iso-utf8-flip sexpr->string-fmt string->sexpr iso-sexpr-string sexpr->bytevector bytevector->sexpr iso-sexpr-bytevector iso-list-vector iso-alist-keys-sorted iso-number-string iso-exact-inexact iso-bool-int iso-bool-symbol iso-null-nothing iso-false-nothing string-split)) (answer "(define iso-time-unix (make-p-iso (lambda (ts) (let* ((parts (string-split ts #\\-)) (year (string->number (car parts))) (month (string->number (cadr parts))) (day (string->number (caddr parts)))) (+ (* (- year 1970) 365 24 60 60) (* (- month 1) 30 24 60 60) (* (- day 1) 24 60 60)))) (lambda (unix) (let* ((days (quotient unix (* 24 60 60))) (years (quotient days 365)) (year (+ 1970 years)) (remaining (- days (* years 365))) (month (+ 1 (quotient remaining 30))) (day (+ 1 (modulo remaining 30)))) (format \"~a-~a-~a\" year (if (< month 10) (format \"0~a\" month) month) (if (< day 10) (format \"0~a\" day) day))))))"))
