(task-entry (id "crypto/blake2b/blake2b-compress") (skill crypto) (module blake2b) (tier 1) (difficulty 10507) (name blake2b-compress) (type "(-> Vector Bytevector Integer Integer Boolean Void)") (description "") (notes ()) (section blake2b-compression) (deps ()) (available (u64-mask u64 u64+ rotr64 IV SIGMA G)) (answer "(define (blake2b-compress h block offset t last) (let ((v (make-vector 16))) (do ((i 0 (+ i 1))) ((= i 8)) (vector-set! v i (vector-ref h i))) (do ((i 0 (+ i 1))) ((= i 8)) (vector-set! v (+ i 8) (vector-ref IV i))) (vector-set! v 12 (bitwise-xor (vector-ref v 12) (u64 t))) (vector-set! v 13 (bitwise-xor (vector-ref v 13) (bitwise-arithmetic-shift-right t 64))) (when last (vector-set! v 14 (bitwise-xor (vector-ref v 14) u64-mask))) (let ((m (make-vector 16))) (do ((i 0 (+ i 1))) ((= i 16)) (vector-set! m i (bytevector-u64-ref block (+ offset (* i 8)) 'little))) (do ((round 0 (+ round 1))) ((= round 12)) (let ((s (vector-ref SIGMA round))) (G v 0 4 8 12 (vector-ref m (vector-ref s 0)) (vector-ref m (vector-ref s 1))) (G v 1 5 9 13 (vector-ref m (vector-ref s 2)) (vector-ref m (vector-ref s 3))) (G v 2 6 10 14 (vector-ref m (vector-ref s 4)) (vector-ref m (vector-ref s 5))) (G v 3 7 11 15 (vector-ref m (vector-ref s 6)) (vector-ref m (vector-ref s 7))) (G v 0 5 10 15 (vector-ref m (vector-ref s 8)) (vector-ref m (vector-ref s 9))) (G v 1 6 11 12 (vector-ref m (vector-ref s 10)) (vector-ref m (vector-ref s 11))) (G v 2 7 8 13 (vector-ref m (vector-ref s 12)) (vector-ref m (vector-ref s 13))) (G v 3 4 9 14 (vector-ref m (vector-ref s 14)) (vector-ref m (vector-ref s 15))))) (do ((i 0 (+ i 1))) ((= i 8)) (vector-set! h i (bitwise-xor (vector-ref h i) (bitwise-xor (vector-ref v i) (vector-ref v (+ i 8)))))))))"))
