(task-entry (id "egraph/cost/compute-costs") (skill egraph) (module cost) (tier 1) (difficulty 10005) (name compute-costs) (type "(-> EGraph CostModel (Hashtable ClassId Nat))") (description "Compute minimum cost for each e-class.") (notes ()) (section computation) (deps (\x27;prelude \x27;egraph/egraph \x27;sort)) (available (cost-model-tag make-cost-model cost-model? cost-model-name cost-model-fn)) (answer "(define (compute-costs eg cost-model) (let ((costs (make-hashtable equal-hash equal?)) (node-cost-fn (cost-model-fn cost-model)) (uf (egraph-uf eg)) (store (egraph-classes eg))) (for-each (lambda (root) (hashtable-set! costs root +inf.0)) (uf-roots uf)) (let loop ((changed #t) (iterations 0)) (if (or (not changed) (> iterations 1000)) costs (let ((any-changed #f)) (for-each (lambda (root) (let ((nodes (eclass-get-nodes store root))) (for-each (lambda (node) (let ((node-cost (compute-node-cost node costs node-cost-fn))) (when (< node-cost (hashtable-ref costs root +inf.0)) (hashtable-set! costs root node-cost) (set! any-changed #t)))) nodes))) (uf-roots uf)) (loop any-changed (+ iterations 1)))))))"))
