(task-entry (id "random/distributions/binomial-pmf") (skill random) (module distributions) (tier 1) (difficulty 12943) (name binomial-pmf) (type "(-> Nat Nat Number Number)") (description "Binomial probability mass at k") (notes ()) (section binomial-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli bernoulli-pmf random-bernoulli geometric geometric-pmf geometric-cdf geometric-quantile random-geometric poisson poisson-pmf poisson-cdf random-poisson binomial)) (answer "(define (binomial-pmf k n p) (if (or (< k 0) (> k n)) 0 (* (binomial-coeff n k) (expt p k) (expt (- 1 p) (- n k)))))"))
(task-entry (id "random/probability/rejection-samples") (skill random) (module probability) (tier 1) (difficulty 12943) (name rejection-samples) (type "") (description "") (notes ()) (section rejection-sampling) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist condition assume sample-once sample-many weighted-samples log-sum-exp normalize-log-weights importance-expectation importance-mean importance-variance rejection-sample)) (answer "(define (rejection-samples p seed n max-tries-per) (let loop ((prng (make-pcg seed 1)) (count n) (acc '())) (if (= count 0) (reverse acc) (let* ((result (run-prob p prng)) (value (car (car result))) (log-w (cdr (car result))) (new-prng (cdr result))) (if (> log-w -inf.0) (loop new-prng (- count 1) (cons value acc)) (let inner-loop ((tries max-tries-per) (g new-prng)) (if (<= tries 0) (loop g (- count 1) acc) (let* ((r (run-prob p g)) (v (car (car r))) (lw (cdr (car r))) (ng (cdr r))) (if (> lw -inf.0) (loop ng (- count 1) (cons v acc)) (inner-loop (- tries 1) ng))))))))))"))
(task-entry (id "random/bayesian/interpret-bayes-factor") (skill random) (module bayesian) (tier 1) (difficulty 12943) (name interpret-bayes-factor) (type "") (description "") (notes ()) (section bayesian-model-selection) (deps (\x27;prelude \x27;transcendental \x27;distributions)) (available (make-beta-prior beta-prior? beta-prior-alpha beta-prior-beta beta-binomial-posterior beta-posterior-mean beta-posterior-mode beta-posterior-variance beta-credible-interval make-normal-prior normal-prior? normal-prior-mean normal-prior-variance normal-normal-posterior normal-posterior-credible-interval make-gamma-prior gamma-prior? gamma-prior-shape gamma-prior-rate gamma-poisson-posterior gamma-posterior-mean gamma-posterior-variance gamma-posterior-mode make-dirichlet-prior dirichlet-prior? dirichlet-prior-alphas dirichlet-multinomial-posterior dirichlet-posterior-mean dirichlet-posterior-mode log-beta-pdf log-beta log-normal-pdf log-gamma-pdf log-poisson-pmf log-factorial kl-divergence-normal kl-divergence-beta digamma log-marginal-likelihood-beta-binomial log-binomial-coeff log-marginal-likelihood-normal-normal bayes-factor log-bayes-factor)) (answer "(define (interpret-bayes-factor bf) (cond ((> bf 100) 'decisive) ((> bf 30) 'very-strong) ((>= bf 10) 'strong) ((>= bf 3) 'substantial) ((> bf 1) 'barely-worth-mentioning) ((> bf 0.33) 'barely-worth-mentioning-against) ((>= bf 0.1) 'substantial-against) ((>= bf 0.033) 'strong-against) ((>= bf 0.01) 'very-strong-against) (else 'decisive-against)))"))
(task-entry (id "random/monte-carlo/list-tail-safe") (skill random) (module monte-carlo) (tier 1) (difficulty 12943) (name list-tail-safe) (type "") (description "") (notes ()) (section helper-functions) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate antithetic-integrate control-variate-estimate stratified-sample effective-sample-size split-into-batches gelman-rubin autocorrelation integrated-autocorrelation-time mcmc-diagnostics parallel-chains batch-sample progressive-sample run-mc mc-pi-estimate mc-normal-tail-prob)) (answer "(define (list-tail-safe lst n) (if (or (<= n 0) (null? lst)) lst (list-tail-safe (cdr lst) (- n 1))))"))
(task-entry (id "random/variational-inference/make-adam-state") (skill random) (module variational-inference) (tier 1) (difficulty 12943) (name make-adam-state) (type "") (description "") (notes ()) (section adam-optimizer-for-vi) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf vi-step-mf)) (answer "(define (make-adam-state num-params) (list 'adam-state (make-list num-params 0) (make-list num-params 0) 1))"))
(task-entry (id "random/prng/gen-deserialize") (skill random) (module prng) (tier 1) (difficulty 12944) (name gen-deserialize) (type "") (description "") (notes ()) (section generator-serialization-for-resumable-sessions) (deps (\x27;prelude \x27;state \x27;protocol)) (available (mask-32 mask-64 u32 u64 rotl32 rotr32 rotl64 rotr64 make-splitmix splitmix? splitmix-state splitmix-next splitmix-random make-pcg pcg? pcg-state pcg-inc pcg-next pcg-random make-xorshift128 xorshift128? xorshift128-s0 xorshift128-s1 xorshift128-next xorshift128-random random-u32-from random-u64-from random-float random-float-range random-int-range random-bool random-element shuffle sample weighted-choice random-list random-vector with-random with-random-stream gen-advance gen-split random-split random-bytes gen-serialize)) (answer "(define (gen-deserialize sexpr) (case (car sexpr) ((pcg) (list 'pcg (cadr sexpr) (caddr sexpr))) ((splitmix) (list 'splitmix (cadr sexpr))) ((xorshift128) (list 'xorshift128 (cadr sexpr) (caddr sexpr))) (else (error 'gen-deserialize \"unknown generator type\" (car sexpr)))))"))
(task-entry (id "random/distributions/random-binomial") (skill random) (module distributions) (tier 1) (difficulty 12944) (name random-binomial) (type "(-> Nat Number (State RNG Nat))") (description "State monad sampler for binomial distribution") (notes ()) (section binomial-distribution) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;protocol)) (available (horner-eval safe-log rejection-sampler log-gamma factorial binomial-coeff positive? random-normal-standard random-normal-pair *erfc-coeffs* *erfc-p* standard-normal-cdf standard-normal-pdf *quantile-num-coeffs* *quantile-den-coeffs* standard-normal-quantile normal normal-pdf normal-cdf normal-quantile random-normal exponential exponential-pdf exponential-cdf exponential-quantile random-exponential uniform uniform-pdf uniform-cdf uniform-quantile bernoulli bernoulli-pmf random-bernoulli geometric geometric-pmf geometric-cdf geometric-quantile random-geometric poisson poisson-pmf poisson-cdf random-poisson binomial binomial-pmf)) (answer "(define (random-binomial n p) (cond ((< n 0) (error 'random-binomial \"n must be non-negative\" n)) ((or (< p 0) (> p 1)) (error 'random-binomial \"p must be in [0,1]\" p)) ((= n 0) (state-pure 0)) ((= p 0) (state-pure 0)) ((= p 1) (state-pure n)) ((< n 20) (letrec ((sum-trials (lambda (k successes) (if (= k 0) (state-pure successes) (state-bind (random-bernoulli p) (lambda (success?) (sum-trials (- k 1) (if success? (+ successes 1) successes)))))))) (sum-trials n 0))) (else (let* ((mean (* n p)) (stddev (sqrt (* n p (- 1 p))))) (state-map (lambda (x) (min n (max 0 (inexact->exact (round x))))) (random-normal mean stddev))))))"))
(task-entry (id "random/probability/prob-sequence") (skill random) (module probability) (tier 1) (difficulty 12944) (name prob-sequence) (type "") (description "") (notes ()) (section combinators) (deps (\x27;prelude \x27;state \x27;prng \x27;distributions)) (available (make-prob prob? prob-state prob-get-prng prob-put-prng prob-get-weight prob-add-weight run-prob sample-prob weight-prob prob-pure prob-bind prob-then prob-map prob-ap sample prob-uniform prob-uniform-range prob-uniform-int prob-bernoulli prob-normal prob-exponential prob-poisson prob-geometric prob-binomial prob-gamma prob-beta prob-categorical factor score observe observe-dist condition assume sample-once sample-many weighted-samples log-sum-exp normalize-log-weights importance-expectation importance-mean importance-variance rejection-sample rejection-samples)) (answer "(define (prob-sequence probs) (if (null? probs) (prob-pure '()) (prob-bind (car probs) (lambda (x) (prob-bind (prob-sequence (cdr probs)) (lambda (xs) (prob-pure (cons x xs))))))))"))
