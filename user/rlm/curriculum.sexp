(task-entry (id "data/quadtree/quadtree-delete-if") (skill data) (module quadtree) (tier 0) (difficulty 1346) (name quadtree-delete-if) (type "(-> Quadtree Num Num (-> Point Boolean) Quadtree)") (description "Delete a point at (x,y) matching predicate. Predicate receives\nthe full point (x y data). Returns unchanged tree if no match found.") (notes ()) (section deletion) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build quadtree-build-auto list->quadtree quadtree-insert quadtree-insert-at-depth quadtree-split quadtree-range quadtree-range-rect quadtree-radius quadtree-nearest quadtree-nearest-rec bounds-min-dist-sq sort-by-bounds-dist quadtree-knn-pair-greater? quadtree-knn quadtree-knn-heap->list quadtree-knn-rec quadtree-size quadtree-depth quadtree-fold quadtree->list quadtree-delete)) (answer "(define (quadtree-delete-if tree x y pred) (cond ((quadtree-empty? tree) tree) ((quadtree-leaf? tree) (let ((bounds (quadtree-leaf-bounds tree)) (points (quadtree-leaf-points tree))) (if (not (bounds-contains? bounds x y)) tree (let ((new-points (delete-first-matching points x y pred))) (quadtree-leaf bounds new-points))))) ((quadtree-node? tree) (let ((bounds (quadtree-bounds tree))) (if (not (bounds-contains? bounds x y)) tree (let* ((cx (bounds-cx bounds)) (cy (bounds-cy bounds)) (ne (quadtree-ne tree)) (nw (quadtree-nw tree)) (se (quadtree-se tree)) (sw (quadtree-sw tree)) (new-tree (cond ((and (>= x cx) (>= y cy)) (quadtree-node bounds (quadtree-delete-if ne x y pred) nw se sw)) ((and (< x cx) (>= y cy)) (quadtree-node bounds ne (quadtree-delete-if nw x y pred) se sw)) ((and (>= x cx) (< y cy)) (quadtree-node bounds ne nw (quadtree-delete-if se x y pred) sw)) (else (quadtree-node bounds ne nw se (quadtree-delete-if sw x y pred)))))) (quadtree-try-merge new-tree)))))))"))
