(task-entry (id "fp/solve/extract-coeff-impl") (skill fp) (module solve) (tier 1) (difficulty 10613) (name extract-coeff-impl) (type "") (description "") (notes ()) (section equation-representation) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs collect-linear-coeffs-impl any-contains-var? contains-var? extract-poly-coefficients is-polynomial? polynomial-degree extract-coefficient-of-degree)) (answer "(define (extract-coeff-impl expr var-sym k) (cond ((num? expr) (if (= k 0) expr (num 0))) ((var? expr) (if (eq? (var-name expr) var-sym) (if (= k 1) (num 1) (num 0)) (if (= k 0) expr (num 0)))) ((sum? expr) (make-sum-from-terms (map (lambda (t) (extract-coeff-impl t var-sym k)) (sum-terms expr)))) ((power? expr) (if (and (var? (pow-base expr)) (eq? (var-name (pow-base expr)) var-sym) (num? (pow-exp expr))) (if (= k (num-val (pow-exp expr))) (num 1) (num 0)) (if (= k 0) (if (contains-var? expr var-sym) (num 0) expr) (num 0)))) ((product? expr) (let ((factors (product-factors expr))) (extract-product-coeff factors var-sym k))) ((difference? expr) (if (diff-right expr) (difference (extract-coeff-impl (diff-left expr) var-sym k) (extract-coeff-impl (diff-right expr) var-sym k)) (make-neg (extract-coeff-impl (diff-left expr) var-sym k)))) ((quotient? expr) (if (contains-var? (quot-denom expr) var-sym) (num 0) (division (extract-coeff-impl (quot-numer expr) var-sym k) (quot-denom expr)))) (else (num 0))))"))
(task-entry (id "fp/poly-canonical/partial-fractions-linear") (skill fp) (module poly-canonical) (tier 1) (difficulty 10613) (name partial-fractions-linear) (type "") (description "") (notes ()) (section partial-fractions) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial polynomial-expr? expr-degree extract-poly-coeffs extract-coeff-at extract-coeff-expanded extract-coeff-product expr-eval-at-zero polynomial->expr make-term simplify-rational partial-fractions)) (answer "(define (partial-fractions-linear numer-poly denom-poly var-sym) (let ((sqf (poly-square-free-factorization denom-poly))) (if (null? sqf) #f (if (and (= (length sqf) 1) (= (cdar sqf) 1) (= (poly-degree (caar sqf)) (poly-degree denom-poly))) #f #f))))"))
