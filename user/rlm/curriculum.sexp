(task-entry (id "geometry/shape-protocol/shapes-containing-point") (skill geometry) (module shape-protocol) (tier 1) (difficulty 12203) (name shapes-containing-point) (type "(-> (List Shape) Point3 (List Shape))") (description "Find all shapes containing the point") (notes ()) (section derived-operations) (deps (\x27;prelude \x27;protocol \x27;vec3 \x27;geometry)) (available (distance-to-segment scene-intersect-ray scene-aabb)) (answer "(define (shapes-containing-point shapes point) (filter (lambda (s) (shape-contains-point? s point)) shapes))"))
