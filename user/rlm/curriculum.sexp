(task-entry (id "geometry/convex-hull/extreme-point") (skill geometry) (module convex-hull) (tier 1) (difficulty 12221) (name extreme-point) (type "") (description "") (notes ()) (section extreme-points) (deps (\x27;prelude \x27;mesh-gen \x27;sort)) (available (cross-product-2d ccw? collinear? point2-distance-sq find-lowest-point polar-angle sort-by-polar-angle remove-collinear-except-furthest graham-scan point-line-distance find-extreme-points points-above-line find-furthest-from-line quickhull-recurse quickhull convex-hull convex-hull-area convex-hull-perimeter point-in-convex-hull? convex-hull-centroid convex-hull-diameter)) (answer "(define (extreme-point points direction) (let ((dx (point2-x direction)) (dy (point2-y direction))) (fold-left (lambda (best p) (let ((dot-best (+ (* (point2-x best) dx) (* (point2-y best) dy))) (dot-p (+ (* (point2-x p) dx) (* (point2-y p) dy)))) (if (> dot-p dot-best) p best))) (car points) (cdr points))))"))
