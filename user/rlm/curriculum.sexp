(task-entry (id "autodiff/typed-gradients/infer-gradient-dim") (skill autodiff) (module typed-gradients) (tier 1) (difficulty 12732) (name infer-gradient-dim) (type "") (description "") (notes ()) (section dimension-checked-gradient) (deps (core/base/prelude.ss core/types/dep-types.ss lattice/autodiff/higher-order-diff.ss)) (available (dim-gradient dim-gradient? dim-gradient-dim dim-gradient-values dim-gradient-ref dim-gradient-ok? make-gradient-spec gradient-spec? gradient-spec-input-dim gradient-spec-output-dim gradient-spec-fn safe-gradient safe-gradient-at dim-jacobian dim-jacobian? dim-jacobian-rows dim-jacobian-cols dim-jacobian-matrix safe-jacobian dim-hessian dim-hessian? dim-hessian-dim dim-hessian-matrix safe-hessian scalar-fn vector-fn t-gradient t-gradient-fn t-jacobian t-jacobian-fn t-hessian t-hessian-fn)) (answer "(define (infer-gradient-dim f expected-input-dim) (let* ((test-args (map (lambda (i) (+ i 1.0)) (iota expected-input-dim))) (test-gradient (gradient f test-args))) (if (list? test-gradient) (length test-gradient) (list 'error 'gradient-inference-failed test-gradient))))"))
(task-entry (id "autodiff/interval-autodiff/monotonic-dimension") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12732) (name monotonic-dimension) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op iv-traced-add iv-traced-sub iv-traced-mul iv-traced-div iv-traced-neg iv-traced-sqr iv-traced-sqrt iv-traced-exp iv-traced-log iv-traced-sin iv-traced-cos iv-traced-pow interval-backward interval-gradient gradient-sign monotonicity-info all-monotonic? any)) (answer "(define (monotonic-dimension grad-intervals) (let loop ((ivs grad-intervals) (idx 0)) (cond ((null? ivs) #f) ((not (interval-contains-zero? (car ivs))) idx) (else (loop (cdr ivs) (+ idx 1))))))"))
(task-entry (id "autodiff/higher-order-diff/rec-cos") (skill autodiff) (module higher-order-diff) (tier 1) (difficulty 12733) (name rec-cos) (type "") (description "") (notes ()) (section jacobian-computation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;comp-graph \x27;reverse-diff)) (available (jacobian jacobian-reverse jacobian-forward hessian hessian-reverse-forward gradient-i hessian-numerical vjp jvp grad directional-derivative second-derivative hessian-exact second-derivative-exact hod-list-update jet jet? jet-coeffs jet-order jet-coeff jet-deriv factorial jet-value jet-lift jet-variable rec-add rec-sub rec-mul rec-div rec-exp rec-log rec-sqrt rec-sin)) (answer "(define (rec-cos x) (if (number? x) (cos x) (jet-cos x)))"))
