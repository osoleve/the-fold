(task-entry (id "statistics/exponential/holt-damped") (skill statistics) (module exponential) (tier 1) (difficulty 11211) (name holt-damped) (type "") (description "") (notes ()) (section simple-exponential-smoothing-ses) (deps (\x27;prelude)) (available (simple-exponential-smooth ses-forecast optimize-ses-alpha holt-smooth holt-forecast holt-fitted holt-winters holt-winters-additive holt-winters-multiplicative hw-forecast hw-fitted)) (answer "(define (holt-damped xs alpha beta phi) (let* ((n (vector-length xs)) (level (make-vector n)) (trend (make-vector n)) (l0 (vector-ref xs 0)) (b0 (if (> n 1) (- (vector-ref xs 1) (vector-ref xs 0)) 0))) (vector-set! level 0 l0) (vector-set! trend 0 b0) (do ((t 1 (+ t 1))) ((= t n)) (let* ((lt-1 (vector-ref level (- t 1))) (bt-1 (vector-ref trend (- t 1))) (xt (vector-ref xs t)) (lt (+ (* alpha xt) (* (- 1 alpha) (+ lt-1 (* phi bt-1))))) (bt (+ (* beta (- lt lt-1)) (* (- 1 beta) (* phi bt-1))))) (vector-set! level t lt) (vector-set! trend t bt))) (list 'holt-damped-result alpha beta phi level trend (vector-ref level (- n 1)) (vector-ref trend (- n 1)))))"))
(task-entry (id "statistics/forecast/standard-normal-quantile-approx") (skill statistics) (module forecast) (tier 1) (difficulty 11211) (name standard-normal-quantile-approx) (type "") (description "") (notes ()) (section forecast-accuracy-metrics) (deps (\x27;prelude)) (available (mae mse rmse mape smape mase naive-forecast drift-forecast seasonal-naive-forecast mean-forecast forecast-intervals)) (answer "(define (standard-normal-quantile-approx p) (if (or (<= p 0) (>= p 1)) (if (<= p 0) -1000 1000) (let* ((a0 2.515517) (a1 0.802853) (a2 0.010328) (b1 1.432788) (b2 0.189269) (b3 0.001308) (sign (if (< p 0.5) -1 1)) (p* (if (< p 0.5) p (- 1 p))) (t (sqrt (* -2 (log p*)))) (num (+ a0 (* a1 t) (* a2 t t))) (den (+ 1 (* b1 t) (* b2 t t) (* b3 t t t)))) (* sign (- t (/ num den))))))"))
