(task-entry (id "data/graph-matrix/transitive-closure") (skill data) (module graph-matrix) (tier 0) (difficulty 1336) (name transitive-closure) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize adjacency-symmetrize-sparse degree-matrix degree-matrix-sparse complete-graph cycle-graph path-graph star-graph bipartite-graph adjacency-power adjacency-reachability matrix-power-fast *infinity*)) (answer "(define (transitive-closure adj) (let* ((n (matrix-rows adj)) (data (vector-copy (matrix-data adj)))) (do ((i 0 (+ i 1))) ((= i n)) (vector-set! data (+ (* i n) i) 1)) (do ((k 0 (+ k 1))) ((= k n)) (do ((i 0 (+ i 1))) ((= i n)) (do ((j 0 (+ j 1))) ((= j n)) (let ((ij (+ (* i n) j)) (ik (+ (* i n) k)) (kj (+ (* k n) j))) (when (and (> (vector-ref data ik) 0) (> (vector-ref data kj) 0)) (vector-set! data ij 1)))))) (list 'matrix n n data)))"))
