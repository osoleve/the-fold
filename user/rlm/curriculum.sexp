(task-entry (id "clp/domain/domain-for-each") (skill clp) (module domain) (tier 1) (difficulty 10823) (name domain-for-each) (type "(-> Domain (-> Int Void) Void)") (description "Apply procedure to each value in domain") (notes ()) (section domain-enumeration) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains? domain-size domain-min domain-max list-last domain-bounds domain-intersect domain-union merge-intervals interval<? domain-subtract-value domain-subtract domain-restrict-min domain-restrict-max domain->list)) (answer "(define (domain-for-each dom proc) (for-each (lambda (interval) (let loop ((n (car interval))) (when (<= n (cdr interval)) (proc n) (loop (+ n 1))))) dom))"))
