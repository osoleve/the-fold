(task-entry (id "game-theory/strategic-voting/find-strategic-equilibrium") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13205) (name find-strategic-equilibrium) (type "(-> PreferenceProfile VotingRule Nat (Result PreferenceProfile Symbol))") (description "Find Nash equilibrium using iterated best response. Starts from truthful profile, lets each voter optimize in round-robin order until convergence or cycle detection") (notes ("WARNING: O(N! * V * fuel) complexity. Only practical for small instances (≤6 candidates)")) (section nash-equilibrium) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves? is-strategic-equilibrium?)) (answer "(define (find-strategic-equilibrium true-profile voting-rule fuel) (if (null? true-profile) (list 'ok '()) (let* ((n (length true-profile)) (candidates (profile-candidates true-profile)) (all-ballots (permutations candidates)) (visited (make-hashtable equal-hash equal?))) (let loop ((current true-profile) (remaining-fuel fuel)) (cond ((<= remaining-fuel 0) (list 'err 'fuel-exhausted)) ((hashtable-ref visited current #f) (list 'err 'cycle)) (else (hashtable-set! visited current #t) (let find-improving-voter ((i 0)) (if (>= i n) (list 'ok current) (let* ((true-ranking (list-ref true-profile i)) (current-winner (voting-rule current)) (current-utility (voter-utility current-winner true-ranking)) (ballot-utilities (map (lambda (ballot) (let* ((new-profile (list-set current i ballot)) (winner (voting-rule new-profile))) (cons ballot (voter-utility winner true-ranking)))) all-ballots)) (max-utility (apply max (map cdr ballot-utilities)))) (if (> max-utility current-utility) (let* ((best-ballot (car (car (filter (lambda (bu) (= (cdr bu) max-utility)) ballot-utilities)))) (new-profile (list-set current i best-ballot))) (loop new-profile (- remaining-fuel 1))) (find-improving-voter (+ i 1))))))))))))"))
(task-entry (id "game-theory/voting-games/shapley-shubik-index") (skill game-theory) (module voting-games) (tier 1) (difficulty 13205) (name shapley-shubik-index) (type "(-> PreferenceProfile (Vector Real))") (description "Shapley-Shubik power index for voters based on induced majority game. This measures the probability that a voter is pivotal (turns a losing coalition into a winning one) under random orderings") (notes ()) (section power-indices) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any? coalition-can-elect-candidate?)) (answer "(define (shapley-shubik-index profile) (let* ((game (profile->majority-game profile)) (n (profile-voters profile)) (fuel (expt 2 n))) (shapley-value game fuel)))"))
(task-entry (id "game-theory/multi-winner/ballot-with-weight") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13205) (name ballot-with-weight) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot ballot-weight ballot-ranking)) (answer "(define (ballot-with-weight b new-weight) (cons new-weight (ballot-ranking b)))"))
(task-entry (id "game-theory/fair-division/integrate-density") (skill game-theory) (module fair-division) (tier 1) (difficulty 13205) (name integrate-density) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation)) (answer "(define (integrate-density f a b n) (let* ((h (/ (- b a) n)) (sum (+ (/ (f a) 2) (/ (f b) 2)))) (let loop ((i 1) (sum sum)) (if (>= i n) (* h sum) (loop (+ i 1) (+ sum (f (+ a (* i h)))))))))"))
