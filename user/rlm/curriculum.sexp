-state (* 2 d)))) (let loop ((iter 0) (vfamily initial-vfamily) (rng prng) (adam-state adam) (elbo-history '())) (if (>= iter num-iters) (list 'vi-result vfamily (reverse elbo-history) iter) (let*-values (((new-vfamily new-rng new-adam) (vi-step-adam-traced traced-log-joint vfamily rng adam-state learning-rate))) (let-values (((elbo final-rng) (if (= 0 (modulo iter track-every)) (elbo-estimate log-joint new-vfamily new-rng elbo-samples) (values #f new-rng)))) (loop (+ iter 1) new-vfamily final-rng new-adam (if elbo (cons (cons iter elbo) elbo-history) elbo-history))))))))))"))
