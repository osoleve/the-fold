(task-entry (id "diffgeo/tangent/differential") (skill diffgeo) (module tangent) (tier 1) (difficulty 10755) (name differential) (type "") (description "") (notes ()) (section tangent-vector-representation) (deps (\x27;prelude \x27;matrix \x27;vec \x27;charts)) (available (tangent-vector? tangent-vector-point tangent-vector-chart tangent-vector-components tangent-vector-dim make-tangent-vector tangent-zero tangent-basis-vector tangent-add tangent-sub tangent-scale tangent-negate tangent-change-chart cotangent-vector? cotangent-vector-point cotangent-vector-chart cotangent-vector-components cotangent-vector-dim make-cotangent-vector cotangent-zero cotangent-basis-form cotangent-add cotangent-sub cotangent-scale cotangent-negate covector-apply cotangent-change-chart pushforward pullback-at tangent-space? tangent-space-point tangent-space-chart tangent-space-dim make-tangent-space tangent-space-basis tangent-space-vector cotangent-space? cotangent-space-point cotangent-space-chart cotangent-space-dim make-cotangent-space cotangent-space-basis cotangent-space-form tangent-bundle? tangent-bundle-atlas make-tangent-bundle tangent-bundle-dim tangent-bundle-fiber tangent-bundle-section cotangent-bundle? cotangent-bundle-atlas make-cotangent-bundle cotangent-bundle-dim cotangent-bundle-fiber cotangent-bundle-section)) (answer "(define (differential f point chart . epsilon-arg) (let* ((eps (if (null? epsilon-arg) *jacobian-epsilon* (car epsilon-arg))) (coords (chart-apply chart point)) (n (chart-dim chart)) (grad (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n)) (let ((coords-plus (vec-copy coords)) (coords-minus (vec-copy coords))) (vector-set! coords-plus i (+ (vector-ref coords i) eps)) (vector-set! coords-minus i (- (vector-ref coords i) eps)) (let ((deriv (/ (- (f coords-plus) (f coords-minus)) (* 2 eps)))) (vector-set! grad i deriv)))) (make-cotangent-vector point chart grad)))"))
(task-entry (id "diffgeo/lie-groups/se2-exp") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10755) (name se2-exp) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp so2-log so3? so3-matrix make-so3-from-matrix make-so3 so3-identity so3-compose so3-inverse so3-act so3-alg? so3-alg-vec make-so3-alg so3-hat so3-vee so3-alg-to-matrix so3-matrix-to-alg so3-exp so3-log so3-axis-angle se2? se2-rotation se2-translation make-se2 make-se2-from-angle se2-identity se2-to-matrix matrix-to-se2 se2-compose se2-inverse se2-act se2-alg? se2-alg-omega se2-alg-v make-se2-alg se2-alg-to-matrix)) (answer "(define (se2-exp xi) (let* ((omega (se2-alg-omega xi)) (v (se2-alg-v xi)) (theta (abs omega))) (if (< theta *lie-epsilon*) (make-se2 (so2-identity) v) (let* ((s (sin omega)) (c (cos omega)) (R (make-so2 omega)) (V00 (/ s omega)) (V01 (/ (- c 1) omega)) (V10 (/ (- 1 c) omega)) (V11 (/ s omega)) (tx (+ (* V00 (vector-ref v 0)) (* V01 (vector-ref v 1)))) (ty (+ (* V10 (vector-ref v 0)) (* V11 (vector-ref v 1))))) (make-se2 R (vector tx ty))))))"))
