(task-entry (id "optimization/ilp/make-binary-ilp") (skill optimization) (module ilp) (tier 1) (difficulty 12812) (name make-binary-ilp) (type "") (description "") (notes ()) (section data-structures) (deps (\x27;lp)) (available (*ilp-tolerance* *ilp-max-nodes* *ilp-max-cuts* ilp? make-ilp ilp-c ilp-A ilp-b ilp-integers ilp-dims ilp->lp make-pure-ilp)) (answer "(define (make-binary-ilp c A b) (let* ((n (matrix-cols A)) (m (matrix-rows A)) (eye-n (matrix-identity n)) (A-ext (matrix-vstack A eye-n)) (b-ext (vec-append b (vec-ones n))) (A-slack (matrix-vstack (make-matrix m n 0) eye-n)) (A-full (matrix-hstack A-ext A-slack)) (c-full (vec-append c (vec-zeros n)))) (make-ilp c-full A-full b-ext (iota n))))"))
(task-entry (id "optimization/interval-global/ior-best-box") (skill optimization) (module interval-global) (tier 1) (difficulty 12812) (name ior-best-box) (type "") (description "") (notes ()) (section convergence-criteria) (deps (\x27;prelude \x27;interval \x27;heap)) (available (make-interval-convergence interval-convergence? ic-width-tol ic-max-iter ic-gap-tol *default-interval-convergence* make-interval-opt-result interval-opt-result? ior-candidates ior-best-upper ior-iterations ior-reason)) (answer "(define (ior-best-box result) (let ((candidates (ior-candidates result))) (if (null? candidates) #f (car candidates))))"))
(task-entry (id "optimization/interval-contract/make-linear-eq-contractor") (skill optimization) (module interval-contract) (tier 1) (difficulty 12812) (name make-linear-eq-contractor) (type "") (description "") (notes ()) (section linear-contractors) (deps (\x27;interval-global)) (available (contract-all contract-fixpoint contract-once box-equal? make-bound-contractor make-equality-contractor make-linear-le-contractor linear-le-contract contract-linear-var remove-dim sum-interval-bounds make-linear-ge-contractor)) (answer "(define (make-linear-eq-contractor coeffs rhs) (let ((le-contractor (make-linear-le-contractor coeffs rhs)) (ge-contractor (make-linear-ge-contractor coeffs rhs))) (lambda (box) (let ((box1 (le-contractor box))) (if (eq? box1 'empty) 'empty (ge-contractor box1))))))"))
(task-entry (id "optimization/interval-newton/interval-bisection-root") (skill optimization) (module interval-newton) (tier 1) (difficulty 12812) (name interval-bisection-root) (type "(-> (-> Real Real) Interval Real Nat BisectionResult)") (description "") (notes ()) (section bisection) (deps (\x27;interval \x27;interval-global)) (available (make-root-result root-result? root-result-roots root-result-iterations root-result-reason root-result-count root-result-unique-roots interval-newton-step interval-newton-step-rigorous interval-newton-root interval-find-all-roots interval-might-contain-root?)) (answer "(define (interval-bisection-root f X0 tol max-iter) (let ((lo (interval-lo X0)) (hi (interval-hi X0))) (let ((f-lo (f lo)) (f-hi (f hi))) (cond ((> (* f-lo f-hi) 0) (list 'failed 'no-sign-change 0)) (else (bisection-loop f lo hi f-lo f-hi tol max-iter 0))))))"))
