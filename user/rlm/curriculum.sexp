(task-entry (id "physics/classical3d/collision-detection3d/sphere-sphere?") (skill physics/classical3d) (module collision-detection3d) (tier 2) (difficulty 22406) (name sphere-sphere?) (type "") (description "") (notes ()) (section point-in-shape-tests) (deps (\x27;prelude \x27;vec3 \x27;shapes3d)) (available (point-in-aabb3d? point-in-sphere3d? point-in-box3d? closest-point-on-segment-3d closest-point-on-aabb3d closest-point-on-box3d)) (answer "(define (sphere-sphere? a b) (let ((dist-sq (vec3-distance-sq (sphere3d-center a) (sphere3d-center b))) (r-sum (+ (sphere3d-radius a) (sphere3d-radius b)))) (<= dist-sq (* r-sum r-sum))))"))
