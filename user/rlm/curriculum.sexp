(task-entry (id "algebra/polynomial/poly-square-free") (skill algebra) (module polynomial) (tier 0) (difficulty 336) (name poly-square-free) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at poly-power poly-equal? poly-divmod poly-divmod-loop poly-div poly-mod poly-divides? poly-gcd poly-make-monic poly-extended-gcd poly-ext-gcd-loop poly-lcm poly-eval poly-derivative poly-scalar-mul-int)) (answer "(define (poly-square-free p) (let ((p-prime (poly-derivative p))) (if (poly-zero? p-prime) p (poly-div p (poly-gcd p p-prime)))))"))
