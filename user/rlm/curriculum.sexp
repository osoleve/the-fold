(task-entry (id "data/kdtree/kdtree-knn") (skill data) (module kdtree) (tier 0) (difficulty 1319) (name kdtree-knn) (type "(-> KDTree Point Nat (List Point))") (description "Find k nearest points to query. Returns list sorted by distance (closest first).\nO(k log n) average case.") (notes ()) (section k-nearest-neighbors) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater?)) (answer "(define (kdtree-knn tree query k-count) (if (kdtree-empty? tree) '() (let* ((dim (point-dimension query)) (result-heap (kdtree-knn-rec tree query dim k-count heap-empty)) (pairs (knn-heap->list result-heap))) (reverse (map cdr pairs)))))"))
