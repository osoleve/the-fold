(task-entry (id "linalg/matrix-eigen/eigenvalue-condition") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 420) (name eigenvalue-condition) (type "") (description "") (notes ()) (section symmetric-eigen) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop qr-converged? qr-algorithm-shifted qr-algorithm-shifted-loop qr-iterate-once detect-complex-2x2-block extract-eigenvalues-with-complex-check wilkinson-shift inverse-iteration inverse-iteration-loop eigen-decomposition symmetric-eigen symmetric-eigen-loop symmetric-converged? spectral-radius)) (answer "(define (eigenvalue-condition a . opts) (let* ((max-iter (if (and (pair? opts) (integer? (car opts))) (car opts) *eigen-max-iterations*)) (rest1 (if (and (pair? opts) (integer? (car opts))) (cdr opts) opts)) (tol (if (and (pair? rest1) (number? (car rest1))) (car rest1) *eigen-tolerance*)) (eigenvalue-result (qr-algorithm-shifted a max-iter tol))) (cond ((and (pair? eigenvalue-result) (eq? (car eigenvalue-result) 'error)) eigenvalue-result) ((and (pair? eigenvalue-result) (eq? (car eigenvalue-result) 'complex-eigenvalues)) eigenvalue-result) (else (let* ((eigenvalues eigenvalue-result) (abs-eigenvalues (vec-map abs eigenvalues)) (max-ev (vec-max abs-eigenvalues)) (min-ev (vec-min abs-eigenvalues))) (if (< (abs min-ev) tol) +inf.0 (/ (abs max-ev) (abs min-ev))))))))"))
(task-entry (id "linalg/iterative-solvers/gmres-solve-update") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 420) (name gmres-solve-update) (type "") (description "") (notes ()) (section gmres) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop gauss-seidel gauss-seidel-loop sor sor-loop conjugate-gradient cg-loop pcg pcg-loop gmres gmres-outer gmres-arnoldi gmres-arnoldi-loop apply-givens-rotations compute-givens)) (answer "(define (gmres-solve-update h-data v-list g m n x0) (let ((y (make-vector m 0.0)) (k (if (= m 0) 1 m))) (do ((i (- m 1) (- i 1))) ((< i 0)) (let* ((sum (let loop ((j (+ i 1)) (s 0.0)) (if (>= j m) s (let ((h-idx (+ (* i k) j))) (loop (+ j 1) (+ s (* (vector-ref h-data h-idx) (vector-ref y j)))))))) (h-ii-idx (+ (* i k) i)) (h-ii (if (< h-ii-idx (vector-length h-data)) (vector-ref h-data h-ii-idx) 1.0))) (when (>= (abs h-ii) *iterative-tolerance*) (vector-set! y i (/ (- (vector-ref g i) sum) h-ii))))) (let ((x-new (vector-copy x0)) (v-rev (reverse v-list))) (do ((i 0 (+ i 1))) ((>= i (min m (length v-rev)))) (let ((vi (list-ref v-rev i)) (yi (vector-ref y i))) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! x-new j (+ (vector-ref x-new j) (* yi (vector-ref vi j))))))) (let ((res-norm (if (< m (vector-length g)) (abs (vector-ref g m)) 0.0))) (list x-new m res-norm)))))"))
(task-entry (id "linalg/sparse/sparse-csr-row") (skill linalg) (module sparse) (tier 0) (difficulty 420) (name sparse-csr-row) (type "") (description "") (notes ()) (section csr-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr? make-sparse-csr sparse-csr-rows sparse-csr-cols sparse-csr-row-ptrs sparse-csr-col-indices sparse-csr-values sparse-csr-nnz sparse-csr-ref)) (answer "(define (sparse-csr-row m i) (let* ((row-ptrs (sparse-csr-row-ptrs m)) (col-idx (sparse-csr-col-indices m)) (vals (sparse-csr-values m)) (start (vector-ref row-ptrs i)) (end (vector-ref row-ptrs (+ i 1)))) (do ((k (- end 1) (- k 1)) (result '() (cons (list (vector-ref col-idx k) (vector-ref vals k)) result))) ((< k start) result))))"))
(task-entry (id "linalg/graph-laplacian/total-effective-resistance") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 420) (name total-effective-resistance) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue is-bipartite-spectral? effective-resistance)) (answer "(define (total-effective-resistance adj) (let* ((L (laplacian adj)) (n (matrix-rows L)) (eigs (eigenvalues L))) (if (and (pair? eigs) (eq? (car eigs) 'error)) eigs (let ((tol 1e-10)) (* n (let loop ((i 0) (sum 0)) (if (= i (vector-length eigs)) sum (let ((lambda-i (vector-ref eigs i))) (if (< (abs lambda-i) tol) (loop (+ i 1) sum) (loop (+ i 1) (+ sum (/ 1.0 lambda-i))))))))))))"))
(task-entry (id "linalg/svd/matrix-condition-number") (skill linalg) (module svd) (tier 0) (difficulty 420) (name matrix-condition-number) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values build-sigma-matrix compute-u-from-av compute-v-from-atu complete-orthogonal-basis! find-orthogonal-vector count-nonzero-singular-values sort-singular-data svd-thin matrix-slice-cols matrix-slice pseudoinverse build-sigma-pseudoinverse low-rank-approx matrix-rank)) (answer "(define (matrix-condition-number a . opts) (let* ((tol (if (pair? opts) (car opts) *svd-tolerance*)) (sv (singular-values a tol))) (if (and (pair? sv) (eq? (car sv) 'error)) sv (let* ((n (vector-length sv)) (sigma-max (vector-ref sv 0)) (sigma-min (vector-ref sv (- n 1)))) (if (< sigma-min tol) +inf.0 (/ sigma-max sigma-min))))))"))
