(task-entry (id "linalg/vec/vec-approx-equal?") (skill linalg) (module vec) (tier 0) (difficulty 431) (name vec-approx-equal?) (type "(-> (Vec Num) (Vec Num) &opt Num Bool)") (description "Approximate equality within tolerance") (notes ()) (section vector-comparisons) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop vec-slice vec-add vec-sub vec-mul vec-div vec-scale vec-negate vec-dot vec-norm-squared vec-norm vec-norm-l1 vec-norm-linf vec-normalize vec-distance vec-equal?)) (answer "(define (vec-approx-equal? v1 v2 . epsilon-arg) (let ((epsilon (if (null? epsilon-arg) 1e-10 (car epsilon-arg)))) (and (= (vector-length v1) (vector-length v2)) (let ((n (vector-length v1))) (do ((i 0 (+ i 1)) (eq #t (and eq (< (abs (- (vector-ref v1 i) (vector-ref v2 i))) epsilon)))) ((or (= i n) (not eq)) eq))))))"))
(task-entry (id "linalg/quaternion/quat-lerp") (skill linalg) (module quaternion) (tier 0) (difficulty 431) (name quat-lerp) (type "") (description "") (notes ()) (section quaternion-arithmetic) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at quat? quat-identity? quat-unit? quat-w quat-x quat-y quat-z quat-scalar quat-vector quat->list list->quat quat-add quat-sub quat-neg quat-scale quat-mul quat-magnitude-sq quat-magnitude quat-normalize quat-conjugate quat-inverse quat-dot quat-angle)) (answer "(define (quat-lerp a b t) (quat-add (quat-scale a (- 1 t)) (quat-scale b t)))"))
(task-entry (id "linalg/matrix/ones") (skill linalg) (module matrix) (tier 0) (difficulty 431) (name ones) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose matrix-map matrix-map2 matrix-fold matrix-add matrix-sub matrix-hadamard matrix-scale matrix-negate matrix-mul matrix-vec-mul vec-matrix-mul matrix-equal? matrix-approx-equal? matrix-square? matrix-symmetric? matrix-trace frobenius-norm zeros)) (answer "(define (ones rows cols) (make-matrix rows cols 1))"))
(task-entry (id "linalg/sparse/sparse-csc-col") (skill linalg) (module sparse) (tier 0) (difficulty 431) (name sparse-csc-col) (type "") (description "") (notes ()) (section csr-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr? make-sparse-csr sparse-csr-rows sparse-csr-cols sparse-csr-row-ptrs sparse-csr-col-indices sparse-csr-values sparse-csr-nnz sparse-csr-ref sparse-csr-row sparse-csr-row-alist sparse-csc? make-sparse-csc sparse-csc-rows sparse-csc-cols sparse-csc-col-ptrs sparse-csc-row-indices sparse-csc-values sparse-csc-nnz sparse-csc-ref)) (answer "(define (sparse-csc-col m j) (let* ((col-ptrs (sparse-csc-col-ptrs m)) (row-idx (sparse-csc-row-indices m)) (vals (sparse-csc-values m)) (start (vector-ref col-ptrs j)) (end (vector-ref col-ptrs (+ j 1)))) (do ((k (- end 1) (- k 1)) (result '() (cons (list (vector-ref row-idx k) (vector-ref vals k)) result))) ((< k start) result))))"))
(task-entry (id "linalg/graph-laplacian/find-furthest-point") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 431) (name find-furthest-point) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue is-bipartite-spectral? effective-resistance total-effective-resistance laplacian-summary spectral-clustering spectral-clustering-unnorm k-smallest-indices spectral-embedding kmeans-cluster kmeans-init-pp nearest-centroid point-centroid-distance recompute-centroids)) (answer "(define (find-furthest-point points centroids skip-c k d n) (let loop ((i 0) (max-idx 0) (max-dist 0)) (if (= i n) max-idx (let ((min-dist-to-any +inf.0)) (do ((c 0 (+ c 1))) ((= c k)) (when (not (= c skip-c)) (let ((dist (let loop2 ((j 0) (sum 0)) (if (= j d) sum (let ((diff (- (matrix-ref points i j) (matrix-ref centroids c j)))) (loop2 (+ j 1) (+ sum (* diff diff)))))))) (set! min-dist-to-any (min min-dist-to-any dist))))) (if (> min-dist-to-any max-dist) (loop (+ i 1) i min-dist-to-any) (loop (+ i 1) max-idx max-dist))))))"))
(task-entry (id "linalg/numeric-instances/matrix-signum") (skill linalg) (module numeric-instances) (tier 0) (difficulty 431) (name matrix-signum) (type "") (description "") (notes ()) (section matrix-num-instance) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (vec+ vec- vec* vec-abs vec-signum vec-from-integer vec/ vec-recip vec-pi vec-exp vec-log vec-sqrt vec-pow vec-sin vec-cos vec-tan vec-asin vec-acos vec-atan vec-sinh vec-cosh vec-tanh vec-asinh vec-acosh vec-atanh matrix+ matrix- matrix-hadamard matrix* matrix-negate matrix-abs)) (answer "(define (matrix-signum m) (matrix-map (lambda (x) (cond ((< x 0) -1) ((> x 0) 1) (else 0))) m))"))
(task-entry (id "linalg/vec/vec-sum") (skill linalg) (module vec) (tier 0) (difficulty 432) (name vec-sum) (type "(-> (Vec Num) Num)") (description "Sum of all elements") (notes ()) (section vector-utilities) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop vec-slice vec-add vec-sub vec-mul vec-div vec-scale vec-negate vec-dot vec-norm-squared vec-norm vec-norm-l1 vec-norm-linf vec-normalize vec-distance vec-equal? vec-approx-equal?)) (answer "(define (vec-sum v) (vec-fold + 0 v))"))
(task-entry (id "linalg/quaternion/quat-nlerp") (skill linalg) (module quaternion) (tier 0) (difficulty 432) (name quat-nlerp) (type "") (description "") (notes ()) (section quaternion-arithmetic) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix quat-from-two-vectors quat-look-at quat? quat-identity? quat-unit? quat-w quat-x quat-y quat-z quat-scalar quat-vector quat->list list->quat quat-add quat-sub quat-neg quat-scale quat-mul quat-magnitude-sq quat-magnitude quat-normalize quat-conjugate quat-inverse quat-dot quat-angle quat-lerp)) (answer "(define (quat-nlerp a b t) (let ((b (if (< (quat-dot a b) 0) (quat-neg b) b))) (quat-normalize (quat-lerp a b t))))"))
(task-entry (id "linalg/matrix/matrix-identity") (skill linalg) (module matrix) (tier 0) (difficulty 432) (name matrix-identity) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix matrix-from-lists matrix-from-vec matrix-ref matrix-row matrix-col matrix-diagonal matrix-transpose matrix-map matrix-map2 matrix-fold matrix-add matrix-sub matrix-hadamard matrix-scale matrix-negate matrix-mul matrix-vec-mul vec-matrix-mul matrix-equal? matrix-approx-equal? matrix-square? matrix-symmetric? matrix-trace frobenius-norm zeros ones)) (answer "(define (matrix-identity n) (let ((data (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n n data)) (vector-set! data (+ (* i n) i) 1))))"))
(task-entry (id "linalg/sparse/coo->csr") (skill linalg) (module sparse) (tier 0) (difficulty 432) (name coo->csr) (type "") (description "") (notes ()) (section format-conversions) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices sparse-coo-col-indices sparse-coo-values sparse-coo-nnz sparse-coo-from-triplets sparse-coo-ref sparse-csr? make-sparse-csr sparse-csr-rows sparse-csr-cols sparse-csr-row-ptrs sparse-csr-col-indices sparse-csr-values sparse-csr-nnz sparse-csr-ref sparse-csr-row sparse-csr-row-alist sparse-csc? make-sparse-csc sparse-csc-rows sparse-csc-cols sparse-csc-col-ptrs sparse-csc-row-indices sparse-csc-values sparse-csc-nnz sparse-csc-ref sparse-csc-col)) (answer "(define (coo->csr coo) (let* ((rows (sparse-coo-rows coo)) (cols (sparse-coo-cols coo)) (row-idx (sparse-coo-row-indices coo)) (col-idx (sparse-coo-col-indices coo)) (vals (sparse-coo-values coo)) (nnz (sparse-coo-nnz coo))) (if (= nnz 0) (let ((row-ptrs (make-vector (+ rows 1) 0))) (make-sparse-csr rows cols row-ptrs (make-vector 0 0) (make-vector 0 0))) (let* ((indices (make-vector nnz 0))) (do ((k 0 (+ k 1))) ((= k nnz)) (vector-set! indices k k)) (vector-sort-by! (lambda (a b) (let ((ra (vector-ref row-idx a)) (rb (vector-ref row-idx b))) (or (< ra rb) (and (= ra rb) (< (vector-ref col-idx a) (vector-ref col-idx b)))))) indices) (let ((row-ptrs (make-vector (+ rows 1) 0)) (out-cols (make-vector nnz 0)) (out-vals (make-vector nnz 0))) (do ((k 0 (+ k 1)) (current-row 0 (vector-ref row-idx (vector-ref indices k)))) ((= k nnz) (do ((r (+ current-row 1) (+ r 1))) ((> r rows)) (vector-set! row-ptrs r nnz))) (let* ((idx (vector-ref indices k)) (r (vector-ref row-idx idx)) (c (vector-ref col-idx idx)) (v (vector-ref vals idx))) (when (> r current-row) (do ((prev-row (+ current-row 1) (+ prev-row 1))) ((> prev-row r)) (vector-set! row-ptrs prev-row k))) (vector-set! out-cols k c) (vector-set! out-vals k v))) (make-sparse-csr rows cols row-ptrs out-cols out-vals))))))"))
(task-entry (id "linalg/graph-laplacian/centroids-converged?") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 432) (name centroids-converged?) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector second-smallest-index laplacian-connected-components spectral-partition extract-induced-subgraph remap-partition spectral-partition-k subgraph-partition laplacian-trace laplacian-energy spectral-gap spectral-radius-laplacian laplacian-max-eigenvalue is-bipartite-spectral? effective-resistance total-effective-resistance laplacian-summary spectral-clustering spectral-clustering-unnorm k-smallest-indices spectral-embedding kmeans-cluster kmeans-init-pp nearest-centroid point-centroid-distance recompute-centroids find-furthest-point)) (answer "(define (centroids-converged? old new k d tol) (let loop ((c 0) (total 0)) (if (= c k) (< total tol) (let ((dist (let loop2 ((j 0) (sum 0)) (if (= j d) sum (let ((diff (- (matrix-ref new c j) (matrix-ref old c j)))) (loop2 (+ j 1) (+ sum (* diff diff)))))))) (loop (+ c 1) (+ total dist))))))"))
