(task-entry (id "linalg/dep-linalg/diff-grad") (skill linalg) (module dep-linalg) (tier 0) (difficulty 417) (name diff-grad) (type "Π n α. Diff (Vec n α) α → Vec n α → Vec n α") (description "Compute gradient of a scalar-valued differentiable function.") (notes ()) (section differentiable-operations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (dep-linalg-types vec-append-typed vec-zip-typed vec-head-typed vec-tail-typed vec-map-typed vec-fold-typed matrix-mul-typed matrix-add-typed matrix-transpose-typed matrix-scale-typed vec-ref-safe matrix-ref-safe vec-nil-typed vec-cons-typed make-dep-linalg-ctx extend-ctx-with-dep-linalg)) (answer "(define (diff-grad n A diff-fn x) (let ((gradient-fn (cdr (assq 'gradient diff-fn)))) (if gradient-fn (gradient-fn x) (error 'diff-grad \"Not a differentiable function\" diff-fn))))"))
(task-entry (id "linalg/vec/vec-sub") (skill linalg) (module vec) (tier 0) (difficulty 418) (name vec-sub) (type "(-> (Vec Num) (Vec Num) (Or (Vec Num) Error))") (description "Element-wise subtraction") (notes ()) (section vector-arithmetic) (deps (\x27;prelude \x27;iteration)) (available (make-vec vec-from-list vec->list vec vec-ref vec-length vec-empty? vec-first vec-last vec-map vec-fold vec-fold-right vec-zip-with vec-append vec-take vec-drop vec-slice vec-add)) (answer "(define (vec-sub v1 v2) (vec-zip-with - v1 v2))"))
