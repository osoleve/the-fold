(task-entry (id "autodiff/symbolic-diff/simplify-product") (skill autodiff) (module symbolic-diff) (tier 1) (difficulty 12714) (name simplify-product) (type "") (description "") (notes ()) (section expression-evaluation) (deps (\x27;diff \x27;reverse-diff)) (available (sym-gradient sym-jacobian sym-hessian autodiff-gradient eval-expr eval-expr-safe simplify simplify-once simplify-sum flatten-sums get-numeric collect-like-terms extract-coefficient make-sum-from-list)) (answer "(define (simplify-product factors) (let* ((flat-factors (flatten-products factors)) (numeric-prod (apply * (filter-map get-numeric flat-factors))) (non-numeric (filter (lambda (e) (not (num? e))) flat-factors))) (cond ((= numeric-prod 0) (num 0)) ((and (null? non-numeric) (= numeric-prod 1)) (num 1)) ((null? non-numeric) (num numeric-prod)) ((= numeric-prod 1) (make-product-from-list non-numeric)) (else (make-product-from-list (cons (num numeric-prod) non-numeric))))))"))
(task-entry (id "autodiff/interval-autodiff/iv-traced-add") (skill autodiff) (module interval-autodiff) (tier 1) (difficulty 12714) (name iv-traced-add) (type "") (description "") (notes ()) (section interval-traced-values) (deps (core/base/prelude.ss lattice/numeric/interval.ss)) (available (*interval-traced-id* interval-fresh-id reset-interval-traced-ids! interval-traced interval-traced? interval-traced-value interval-traced-id interval-traced-tape make-interval-tape interval-tape? interval-tape-entries interval-tape-push! make-interval-traced-var interval-traced-op)) (answer "(define (iv-traced-add a b) (let* ((av (interval-traced-value a)) (bv (interval-traced-value b)) (result (interval-add av bv)) (tape (or (and (interval-traced? a) (interval-traced-tape a)) (and (interval-traced? b) (interval-traced-tape b))))) (if tape (interval-traced-op 'add result (list a b) (list (interval-singleton 1) (interval-singleton 1)) tape) result)))"))
