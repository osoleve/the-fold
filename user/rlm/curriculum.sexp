(task-entry (id "clp/label/label-values") (skill clp) (module label) (tier 1) (difficulty 10809) (name label-values) (type "(-> VarOrder ValSelect CStore (List LVar) LVar Domain (Stream CStore))") (description "Try each value in domain for the selected variable") (notes ()) (section labeling-functions) (deps (\x27;propagate)) (available (input-order first-fail most-constrained max-regret min-value max-value mid-value label label-with)) (answer "(define (label-values var-order val-select cs vars var dom) (if (domain-empty? dom) stream-nil (let* ((val (val-select dom)) (cs1 (try-value cs var val)) (remaining-dom (domain-subtract-value dom val))) (stream-append (if cs1 (label-with var-order val-select cs1 vars) stream-nil) (lambda () (label-values var-order val-select cs vars var remaining-dom))))))"))
(task-entry (id "clp/clp/goal-=fd") (skill clp) (module clp) (tier 1) (difficulty 10809) (name goal-=fd) (type "(-> (Or LVar Int) (Or LVar Int) Goal)") (description "Constraint x = y") (notes ("Uses post-=fd to register constraint for re-propagation during labeling")) (section constraint-goals) (deps (\x27;global-constraints \x27;label)) (available (clp-succeed clp-fail clp-goal clp-conj clp-disj clp-conj* clp-disj* goal-in-range goal-in-domain)) (answer "(define (goal-=fd x y) (lambda (cs) (let ((result (post-=fd cs x y))) (if result (clp-succeed result) (clp-fail cs)))))"))
