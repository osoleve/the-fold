(task-entry (id "control-systems/z-transform/dtf-Ts") (skill control-systems) (module z-transform) (tier 2) (difficulty 22606) (name dtf-Ts) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den)) (answer "(define (dtf-Ts dtf) (cadddr dtf))"))
(task-entry (id "control-systems/tf-convert/pad-poly-coeffs") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22606) (name pad-poly-coeffs) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier faddeev-leverrier compute-tf-numerator tf->ss tf->ss-controllable)) (answer "(define (pad-poly-coeffs coeffs n) (let ((len (vector-length coeffs))) (if (>= len n) coeffs (let ((result (make-vector n 0)) (offset (- n len))) (do ((i 0 (+ i 1))) ((= i len) result) (vector-set! result (+ i offset) (vector-ref coeffs i)))))))"))
(task-entry (id "control-systems/kalman/kalman-predict") (skill control-systems) (module kalman) (tier 2) (difficulty 22606) (name kalman-predict) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R)) (answer "(define (kalman-predict kf) (let ((mean (kalman-mean kf)) (var (kalman-variance kf)) (Q (kalman-Q kf)) (R (kalman-R kf))) (make-kalman-filter mean (+ var Q) Q R)))"))
(task-entry (id "control-systems/stability/routh-array-iter") (skill control-systems) (module stability) (tier 2) (difficulty 22606) (name routh-array-iter) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array)) (answer "(define (routh-array-iter rows remaining) (if (<= remaining 0) (reverse rows) (let* ((prev-row (car rows)) (prev-prev-row (cadr rows)) (len (vector-length prev-row)) (new-row (make-vector len 0)) (a (vector-ref prev-prev-row 0)) (b (vector-ref prev-row 0))) (let ((b (if (< (abs b) 1e-15) 1e-15 b))) (do ((i 0 (+ i 1))) ((>= i (- len 1))) (let* ((c (if (< (+ i 1) len) (vector-ref prev-prev-row (+ i 1)) 0)) (d (if (< (+ i 1) len) (vector-ref prev-row (+ i 1)) 0)) (val (/ (- (* b c) (* a d)) b))) (vector-set! new-row i val))) (routh-array-iter (cons new-row rows) (- remaining 1))))))"))
(task-entry (id "control-systems/controller-design/make-row-vector") (skill control-systems) (module controller-design) (tier 2) (difficulty 22606) (name make-row-vector) (type "Nat × Nat → Matrix") (description "Create row vector with 1 at position idx, 0 elsewhere") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann)) (answer "(define (make-row-vector n idx) (let ((result (make-matrix 1 n 0))) (matrix-set! result 0 idx 1) result))"))
(task-entry (id "control-systems/digital-pid/make-pid-state") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22606) (name make-pid-state) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts)) (answer "(define (make-pid-state) (list 'pid-state 0 0 0))"))
(task-entry (id "control-systems/discrete-control/dss-D") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22606) (name dss-D) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C)) (answer "(define (dss-D sys) (if (dss? sys) (car (cddddr sys)) (ss-D sys)))"))
(task-entry (id "control-systems/hinf-synthesis/gp-C2") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22606) (name gp-C2) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1)) (answer "(define (gp-C2 gp) (list-ref gp 5))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-leading-coeff") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22606) (name alg-poly-leading-coeff) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree)) (answer "(define (alg-poly-leading-coeff p) (let ((coeffs (alg-poly-coeffs p))) (if (null? coeffs) (field-zero (alg-poly-field p)) (list-ref coeffs (- (length coeffs) 1)))))"))
(task-entry (id "control-systems/state-space/ss-outputs") (skill control-systems) (module state-space) (tier 2) (difficulty 22607) (name ss-outputs) (type "(-> SS Nat)") (description "Get the number of outputs") (notes ()) (section accessors) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs)) (answer "(define (ss-outputs sys) (matrix-rows (ss-C sys)))"))
(task-entry (id "control-systems/transfer-function/tf-relative-degree") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22607) (name tf-relative-degree) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order)) (answer "(define (tf-relative-degree tf) (- (poly-degree (tf-den tf)) (poly-degree (tf-num tf))))"))
(task-entry (id "control-systems/z-transform/dtf-order") (skill control-systems) (module z-transform) (tier 2) (difficulty 22607) (name dtf-order) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;control/discrete-control)) (available (dtf? make-dtf dtf-from-coeffs dtf-from-lists dtf-num dtf-den dtf-Ts)) (answer "(define (dtf-order dtf) (poly-degree (dtf-den dtf)))"))
(task-entry (id "control-systems/tf-convert/matrix-column") (skill control-systems) (module tf-convert) (tier 2) (difficulty 22607) (name matrix-column) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function)) (available (ss->tf ss->tf-leverrier faddeev-leverrier compute-tf-numerator tf->ss tf->ss-controllable pad-poly-coeffs)) (answer "(define (matrix-column M j) (let* ((rows (matrix-rows M)) (result (make-vector rows))) (do ((i 0 (+ i 1))) ((= i rows) result) (vector-set! result i (matrix-ref M i j)))))"))
(task-entry (id "control-systems/kalman/kalman-update") (skill control-systems) (module kalman) (tier 2) (difficulty 22607) (name kalman-update) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (kalman? make-kalman-filter kalman-mean kalman-variance kalman-Q kalman-R kalman-predict)) (answer "(define (kalman-update kf observation) (let* ((mean (kalman-mean kf)) (var (kalman-variance kf)) (Q (kalman-Q kf)) (R (kalman-R kf)) (K (if (zero? (+ var R)) 0 (/ var (+ var R)))) (new-mean (+ mean (* K (- observation mean)))) (new-var (* (- 1 K) var))) (make-kalman-filter new-mean (max 1e-4 new-var) Q R)))"))
(task-entry (id "control-systems/stability/routh-hurwitz-stable?") (skill control-systems) (module stability) (tier 2) (difficulty 22607) (name routh-hurwitz-stable?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/transfer-function \x27;control/state-space)) (available (ss-poles ss-stable? tf-stable? ss-marginally-stable? discrete-stable? routh-array routh-array-iter)) (answer "(define (routh-hurwitz-stable? poly) (let* ((array (routh-array poly)) (first-col (map (lambda (row) (vector-ref row 0)) array))) (not (has-sign-changes? first-col))))"))
(task-entry (id "control-systems/controller-design/poly-eval-matrix") (skill control-systems) (module controller-design) (tier 2) (difficulty 22607) (name poly-eval-matrix) (type "Poly × Matrix → Matrix") (description "Evaluate polynomial at matrix argument. p(A) = a_n*A^n + ... + a_1*A + a_0*I") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability)) (available (pid-tf pid-design-zn-open-loop pid-design-zn-closed-loop pid-design-imc pid-design-lambda pole-placement-ackermann make-row-vector)) (answer "(define (poly-eval-matrix poly A) (let* ((coeffs (poly-coeffs poly)) (n (matrix-rows A)) (I (matrix-identity n)) (deg (- (vector-length coeffs) 1))) (if (= deg 0) (matrix-scale (vector-ref coeffs 0) I) (let loop ((i 0) (result (matrix-scale (vector-ref coeffs 0) I))) (if (>= i deg) result (loop (+ i 1) (matrix-add (matrix-mul A result) (matrix-scale (vector-ref coeffs (+ i 1)) I))))))))"))
(task-entry (id "control-systems/digital-pid/pid-state?") (skill control-systems) (module digital-pid) (tier 2) (difficulty 22607) (name pid-state?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (make-digital-pid digital-pid? pid-Kp pid-Ki pid-Kd pid-Ts make-pid-state)) (answer "(define (pid-state? x) (and (pair? x) (eq? (car x) 'pid-state) (= (length x) 4)))"))
(task-entry (id "control-systems/discrete-control/dss-order") (skill control-systems) (module discrete-control) (tier 2) (difficulty 22607) (name dss-order) (type "") (description "") (notes ()) (section discrete-state-space) (deps (\x27;prelude \x27;matrix \x27;matrix-solvers \x27;matrix-eigen \x27;control/state-space)) (available (make-dss dss? dss-Ts dss-A dss-B dss-C dss-D)) (answer "(define (dss-order sys) (matrix-rows (dss-A sys)))"))
(task-entry (id "control-systems/hinf-synthesis/gp-D11") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22607) (name gp-D11) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available (make-generalized-plant gp? gp-A gp-B1 gp-B2 gp-C1 gp-C2)) (answer "(define (gp-D11 gp) (list-ref gp 6))"))
(task-entry (id "control-systems/poly-algebra/alg-poly-zero?") (skill control-systems) (module poly-algebra) (tier 2) (difficulty 22607) (name alg-poly-zero?) (type "") (description "") (notes ()) (section none) (deps (\x27;control/transfer-function \x27;field)) (available (alg-make-polynomial alg-normalize-coeffs alg-polynomial? alg-poly-field alg-poly-coeffs alg-poly-degree alg-poly-leading-coeff)) (answer "(define (alg-poly-zero? p) (let ((F (alg-poly-field p)) (coeffs (alg-poly-coeffs p))) (and (= (length coeffs) 1) ((field-equal-fn F) (car coeffs) (field-zero F)))))"))
(task-entry (id "control-systems/state-space/make-ss") (skill control-systems) (module state-space) (tier 2) (difficulty 22608) (name make-ss) (type "(-> Matrix Matrix Matrix Matrix (Either SS Error))") (description "Create a state space system, validating dimensions") (notes ()) (section construction) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-eigen \x27;svd)) (available (ss? ss-A ss-B ss-C ss-D ss-order ss-inputs ss-outputs)) (answer "(define (make-ss A B C D) (let ((n (matrix-rows A))) (cond ((not (= n (matrix-cols A))) (quasiquote (error A-not-square (unquote (matrix-shape A))))) ((not (= n (matrix-rows B))) (quasiquote (error B-rows-mismatch (unquote (matrix-rows B)) (unquote n)))) ((not (= n (matrix-cols C))) (quasiquote (error C-cols-mismatch (unquote (matrix-cols C)) (unquote n)))) ((not (= (matrix-rows D) (matrix-rows C))) (quasiquote (error D-rows-mismatch (unquote (matrix-rows D)) (unquote (matrix-rows C))))) ((not (= (matrix-cols D) (matrix-cols B))) (quasiquote (error D-cols-mismatch (unquote (matrix-cols D)) (unquote (matrix-cols B))))) (else (list 'ss A B C D)))))"))
(task-entry (id "control-systems/transfer-function/tf-proper?") (skill control-systems) (module transfer-function) (tier 2) (difficulty 22608) (name tf-proper?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;numeric/polynomial)) (available (tf? make-tf tf-from-coeffs tf-from-lists tf-num tf-den tf-order tf-relative-degree)) (answer "(define (tf-proper? tf) (>= (tf-relative-degree tf) 0))"))
