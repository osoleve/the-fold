(task-entry (id "physics/classical/ode-integrators/rk4-step") (skill physics/classical) (module ode-integrators) (tier 2) (difficulty 23507) (name rk4-step) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude)) (available (state-add state-sub state-scale state-madd euler-step midpoint-step heun-step)) (answer "(define (rk4-step f t state dt) (let* ((half-dt (/ dt 2)) (k1 (f t state)) (k2 (f (+ t half-dt) (state-madd state half-dt k1))) (k3 (f (+ t half-dt) (state-madd state half-dt k2))) (k4 (f (+ t dt) (state-madd state dt k3))) (weighted (state-add k1 (state-add (state-scale 2 k2) (state-add (state-scale 2 k3) k4))))) (state-madd state (/ dt 6) weighted)))"))
