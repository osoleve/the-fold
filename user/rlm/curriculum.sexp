(task-entry (id "game-theory/mechanism/first-price-auction") (skill game-theory) (module mechanism) (tier 1) (difficulty 13213) (name first-price-auction) (type "(-> (Vector Number) AuctionOutcome)") (description "First-price sealed-bid auction: highest bidder wins, pays their bid") (notes ("Not incentive compatible - bidders shade bids. Equilibrium bid = (n-1)/n × valuation for n risk-neutral bidders with uniform valuations. Ties broken by *tie-break-strategy*.")) (section single-item-auctions) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break make-bids bids-ref bids-length bids-max bids-second-max bids-winners make-auction-outcome auction-outcome-winner auction-outcome-payment auction-outcome-revenue)) (answer "(define (first-price-auction bids) (let* ((winners (bids-winners bids)) (winner (select-winner winners)) (payment (if winner (bids-ref bids winner) 0))) (make-auction-outcome winner payment)))"))
(task-entry (id "game-theory/evolutionary/pop-vec") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13213) (name pop-vec) (type "") (description "") (notes ()) (section population-state) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies sg-payoffs sg-num-strategies sg-payoff sg-strategy-name hawk-dove-game stag-hunt-symmetric pd-symmetric rps-game make-population population?)) (answer "(define (pop-vec pop) (cadr pop))"))
(task-entry (id "game-theory/mcdm/mcdm-copeland") (skill game-theory) (module mcdm) (tier 1) (difficulty 13213) (name mcdm-copeland) (type "(-> DecisionProblem Alternative)") (description "Find best alternative using Copeland method (pairwise wins - losses). Good when pairwise comparisons matter") (notes ()) (section aggregation-methods) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives dp-criteria dp-scores dp-score find-score cadar criterion-ranking dp->profile dp->weighted-profile mcdm-borda mcdm-schulze)) (answer "(define (mcdm-copeland dp) (copeland-winner (dp->profile dp)))"))
(task-entry (id "game-theory/normal-form/is-strictly-dominated-p1?") (skill game-theory) (module normal-form) (tier 1) (difficulty 13214) (name is-strictly-dominated-p1?) (type "") (description "") (notes ()) (section dominated-strategies) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1 game-payoff-p2 prisoners-dilemma matching-pennies battle-of-sexes stag-hunt chicken best-response-p1 best-response-p2 strictly-dominates-p1? strictly-dominates-p2?)) (answer "(define (is-strictly-dominated-p1? game i) (let ((n1 (game-num-strategies game 0))) (ormap (lambda (other) (and (not (= other i)) (strictly-dominates-p1? game other i))) (iota n1))))"))
