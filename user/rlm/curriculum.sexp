(task-entry (id "fp/trace/trace-rules-unique") (skill fp) (module trace) (tier 1) (difficulty 10618) (name trace-rules-unique) (type "(-> Trace (List Symbol))") (description "Get unique rules used in a trace.") (notes ()) (section trace-display-helpers) (deps (\x27;prelude)) (available (make-trace-step step? step-from step-to step-rule step-position step-bindings make-trace trace? trace-initial trace-steps trace-final trace-verified? trace-step-count trace-add-step trace-set-verified trace-append trace-rules-used)) (answer "(define (trace-rules-unique trace) (let loop ((rules (trace-rules-used trace)) (seen '()) (acc '())) (cond ((null? rules) (reverse acc)) ((memq (car rules) seen) (loop (cdr rules) seen acc)) (else (loop (cdr rules) (cons (car rules) seen) (cons (car rules) acc))))))"))
