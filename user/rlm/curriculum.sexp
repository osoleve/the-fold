(task-entry (id "game-theory/fair-division/round-robin") (skill game-theory) (module fair-division) (tier 1) (difficulty 13247) (name round-robin) (type "") (description "") (notes ()) (section discrete-fair-division) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players cake-set-valuation! cake-valuation integrate-density cake-total-value make-piece piece-empty piece-singleton piece-value piece-length piece-merge make-division division-assign! division-piece division->list proportional? envy-free? equitable? pareto-optimal? find-cut-point binary-search-cut cut-and-choose dubins-spanier dubins-spanier-recurse find-cut-point-from binary-search-cut-from list-index remove selfridge-conway selfridge-conway-no-trim selfridge-conway-with-trim find-value-endpoint argmax make-adjusted-winner-problem adjusted-winner equalize-allocations transfer-to-equalize transfer-loop update-fraction remove-good format-allocation make-discrete-problem discrete-problem-players discrete-problem-goods-count discrete-problem-valuation)) (answer "(define (round-robin dp) (let* ((n (discrete-problem-players dp)) (m (discrete-problem-goods-count dp)) (goods (discrete-problem%-goods dp)) (allocs (make-vector n '())) (available (make-vector m #t))) (let loop ((round 0) (player 0)) (if (>= round m) allocs (let* ((remaining (filter (lambda (j) (vector-ref available j)) (iota m)))) (if (null? remaining) allocs (let* ((best (car (sort-by (lambda (j1 j2) (> (discrete-problem-valuation dp player j1) (discrete-problem-valuation dp player j2))) remaining)))) (vector-set! available best #f) (vector-set! allocs player (cons (vector-ref goods best) (vector-ref allocs player))) (loop (+ round 1) (modulo (+ player 1) n)))))))))"))
