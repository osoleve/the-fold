(task-entry (id "data/graph-matrix/dijkstra") (skill data) (module graph-matrix) (tier 0) (difficulty 1339) (name dijkstra) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize adjacency-symmetrize-sparse degree-matrix degree-matrix-sparse complete-graph cycle-graph path-graph star-graph bipartite-graph adjacency-power adjacency-reachability matrix-power-fast *infinity* transitive-closure floyd-warshall has-negative-cycle?)) (answer "(define (dijkstra adj source) (let* ((n (adjacency-matrix-node-count adj)) (dist (make-vector n *infinity*)) (pred (make-vector n -1)) (visited (make-vector n #f)) (dist-cmp (lambda (a b) (<= (car a) (car b))))) (vector-set! dist source 0) (let loop ((heap (heap-insert-by dist-cmp (cons 0 source) heap-empty))) (if (heap-empty? heap) (cons dist pred) (let* ((top (heap-value heap)) (heap-rest (heap-delete-top-by dist-cmp heap)) (u (cdr top))) (if (vector-ref visited u) (loop heap-rest) (begin (vector-set! visited u #t) (let relax ((neighbors (adjacency-neighbors-with-weights adj u)) (h heap-rest)) (if (null? neighbors) (loop h) (let* ((edge (car neighbors)) (v (car edge)) (w (cdr edge))) (if (not (vector-ref visited v)) (let ((alt (+ (vector-ref dist u) w))) (if (< alt (vector-ref dist v)) (begin (vector-set! dist v alt) (vector-set! pred v u) (relax (cdr neighbors) (heap-insert-by dist-cmp (cons alt v) h))) (relax (cdr neighbors) h))) (relax (cdr neighbors) h))))))))))))"))
(task-entry (id "data/kdtree/kdtree-delete-node") (skill data) (module kdtree) (tier 0) (difficulty 1339) (name kdtree-delete-node) (type "") (description "") (notes ()) (section deletion) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater? kdtree-knn knn-heap->list kdtree-knn-rec kdtree-range kdtree-range-rec point-in-box? kdtree-radius kdtree-size kdtree-height kdtree-balanced? kdtree-fold kdtree->list kdtree-insert kdtree-insert-rec kdtree-insert-2d kdtree-insert-3d kdtree-delete kdtree-delete-2d kdtree-delete-3d kdtree-delete-rec)) (answer "(define (kdtree-delete-node tree k depth) (let ((left (kdtree-left tree)) (right (kdtree-right tree)) (axis (modulo depth k))) (cond ((and (kdtree-empty? left) (kdtree-empty? right)) kdtree-empty) ((not (kdtree-empty? right)) (let ((replacement (kdtree-find-min right axis k (+ depth 1)))) (kdtree-node replacement left (kdtree-delete-rec right replacement k (+ depth 1)) depth))) (else (let ((replacement (kdtree-find-min left axis k (+ depth 1)))) (kdtree-node replacement kdtree-empty (kdtree-delete-rec left replacement k (+ depth 1)) depth))))))"))
