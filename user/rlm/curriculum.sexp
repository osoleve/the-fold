(task-entry (id "game-theory/coop-games/coalition-complement") (skill game-theory) (module coop-games) (tier 1) (difficulty 13206) (name coalition-complement) (type "(-> Coalition Nat Coalition)") (description "Complement of S w.r.t. grand coalition of n players") (notes ()) (section coalition-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union coalition-intersection coalition-difference)) (answer "(define (coalition-complement S n) (bitwise-xor S (- (bitwise-arithmetic-shift-left 1 n) 1)))"))
