(task-entry (id "physics/classical/ascii-renderer/angle->arrow-char") (skill physics/classical) (module ascii-renderer) (tier 2) (difficulty 23544) (name angle->arrow-char) (type "") (description "") (notes ()) (section debug:) (deps (\x27;prelude \x27;vec2 user/creations/ascii-video.ss \x27;world \x27;sort)) (available (make-render-config render-config? config-width config-height config-scale config-origin-x config-origin-y default-render-config make-debug-options debug-options? debug-show-velocity debug-show-contacts debug-show-constraints debug-show-aabb default-debug-options full-debug-options make-render-style render-style? style-fill-char style-static-char style-box-h style-box-v style-corner style-velocity-char style-contact-char default-render-style minimal-render-style bold-render-style make-world-renderer renderer-config renderer-debug renderer-style default-world-renderer world->screen screen->world safe-frame-set! draw-line! draw-filled-circle! polygon-scanline-intersections fill-between-pairs! draw-filled-polygon! draw-filled-aabb! draw-aabb-outline! fmod)) (answer "(define (angle->arrow-char angle) (let* ((pi 3.141592653589793) (two-pi (* 2 pi)) (normalized (fmod (+ angle two-pi) two-pi)) (octant (inexact->exact (floor (* normalized (/ 8 two-pi)))))) (case octant ((0) #\\>) ((1) #\\\\) ((2) #\\v) ((3) #\\/) ((4) #\\<) ((5) #\\\\) ((6) #\\^) ((7) #\\/) (else #\\>))))"))
