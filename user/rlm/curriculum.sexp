 ((q-k) 'e-1) ((qi) 'q-j) ((q-i) 'qj) ((qj) 'qi) ((q-j) 'q-i))))) 'e1 (lambda (a) (case a ((e1) 'e1) ((e-1) 'e-1) ((qi) 'q-i) ((q-i) 'qi) ((qj) 'q-j) ((q-j) 'qj) ((qk) 'q-k) ((q-k) 'qk))) eq?)))"))
