(task-entry (id "geometry/mesh-gen/make-super-triangle") (skill geometry) (module mesh-gen) (tier 1) (difficulty 12242) (name make-super-triangle) (type "") (description "") (notes ()) (section delaunay) (deps (\x27;prelude \x27;sort \x27;vec \x27;geometry \x27;heap)) (available (make-point2 make-triangulation triangulation? triangulation-points triangulation-triangles triangulation-adjacency triangulation-boundary triangulation-count triangulation-point-index make-location location? location-triangle location-bary point2-x point2-y vertex-key make-tri2 tri2? tri2-p1 tri2-p2 tri2-p3 tri2-points orient2d tri2-signed-area tri2-area tri2-circumcenter tri2-circumradius-sq point-in-circumcircle? make-edge edge-p1 edge-p2 points-equal? edges-equal? tri2-edges edge-in-list? count-edge edge-key find-boundary-edges-hash segments-properly-intersect? edge-properly-intersects-edge? triangle-crosses-edge? triangle-crosses-any-constraint?)) (answer "(define (make-super-triangle points) (let* ((xs (map point2-x points)) (ys (map point2-y points)) (min-x (apply min xs)) (max-x (apply max xs)) (min-y (apply min ys)) (max-y (apply max ys)) (dx (- max-x min-x)) (dy (- max-y min-y)) (dmax (max dx dy)) (mid-x (/ (+ min-x max-x) 2.0)) (mid-y (/ (+ min-y max-y) 2.0)) (p1 (make-point2 (- mid-x (* 2.0 dmax)) (- mid-y dmax))) (p2 (make-point2 mid-x (+ mid-y (* 2.0 dmax)))) (p3 (make-point2 (+ mid-x (* 2.0 dmax)) (- mid-y dmax)))) (make-tri2 p1 p2 p3)))"))
(task-entry (id "geometry/voronoi/clip-to-bisector") (skill geometry) (module voronoi) (tier 1) (difficulty 12242) (name clip-to-bisector) (type "") (description "") (notes ()) (section bounded) (deps (\x27;prelude \x27;mesh-gen \x27;convex-hull \x27;sort)) (available (make-voronoi voronoi? voronoi-sites voronoi-vertices voronoi-edges voronoi-cells voronoi-unbounded voronoi-cell-unbounded? make-voronoi-edge vedge-v1 vedge-v2 vedge-site-left vedge-site-right point2-key key<? canonical-edge voronoi-edge-key build-edge-adjacency build-site-triangles angle-from-site order-cell-vertices build-cell voronoi-diagram find-unbounded-sites build-voronoi-edges edge-key->points find-site-index voronoi-cell-polygon voronoi-cell-centroid voronoi-neighbors voronoi-nearest-site point2-distance-sq clip-polygon-to-rect clip-to-halfplane intersect-vertical intersect-horizontal voronoi-bounded voronoi-bounded? voronoi-bounded-sites voronoi-bounded-cells voronoi-bounded-cell compute-bounded-cell)) (answer "(define (clip-to-bisector poly site neighbor) (let* ((mx (/ (+ (point2-x site) (point2-x neighbor)) 2)) (my (/ (+ (point2-y site) (point2-y neighbor)) 2)) (dx (- (point2-x neighbor) (point2-x site))) (dy (- (point2-y neighbor) (point2-y site)))) (clip-to-halfplane poly (lambda (p) (<= (point2-distance-sq p site) (point2-distance-sq p neighbor))) (lambda (p1 p2) (intersect-line-bisector p1 p2 site neighbor)))))"))
