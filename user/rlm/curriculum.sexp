(task-entry (id "statistics/design-matrix/chebyshev-features") (skill statistics) (module design-matrix) (tier 1) (difficulty 11218) (name chebyshev-features) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p chebyshev-t hermite-h laguerre-l legendre-features)) (answer "(define (chebyshev-features xs degree) (let* ((n (vector-length xs)) (ncols (+ degree 1)) (x-min (vec-min xs)) (x-max (vec-max xs)) (x-range (- x-max x-min)) (scale (lambda (x) (if (= x-range 0) 0 (- (* 2 (/ (- x x-min) x-range)) 1)))) (data (make-vector (* n ncols)))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n ncols data)) (let ((xi (scale (vector-ref xs i)))) (do ((d 0 (+ d 1))) ((> d degree)) (vector-set! data (+ (* i ncols) d) (chebyshev-t d xi)))))))"))
(task-entry (id "statistics/linear/linear-model-f-pvalue") (skill statistics) (module linear) (tier 1) (difficulty 11218) (name linear-model-f-pvalue) (type "") (description "") (notes ()) (section ordinary-least-squares) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats \x27;diagnostics \x27;stat/distributions)) (available (linear-model-fit linear-model-compute-diagnostics compute-coefficient-se compute-t-values compute-p-values compute-r-squared compute-adj-r-squared weighted-linear-fit weight-matrix weight-vector weighted-diagnostics compute-weighted-se linear-model-predict linear-model-predict-interval compute-XtX-inverse extract-row compute-leverage-single linear-model-f-statistic)) (answer "(define (linear-model-f-pvalue model) (let* ((f-stat (linear-model-f-statistic model)) (p (linear-model-p model)) (n (linear-model-n model)) (df1 (- p 1)) (df2 (- n p))) (if (or (<= df1 0) (<= df2 0)) 1 (f-pvalue f-stat df1 df2))))"))
(task-entry (id "statistics/regularized/matrix-scale") (skill statistics) (module regularized) (tier 1) (difficulty 11218) (name matrix-scale) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics compute-r-squared-ridge lasso-fit lasso-coordinate-descent lasso-partial-residual soft-threshold lasso-finalize count-nonzero elastic-net-fit elastic-net-coordinate-descent elastic-net-update cross-validate-lambda cv-error-for-lambda split-fold compute-mse-test find-min-index identity-matrix)) (answer "(define (matrix-scale s M) (let* ((m (matrix-rows M)) (n (matrix-cols M)) (data (make-vector (* m n)))) (do ((i 0 (+ i 1))) ((= i m)) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! data (+ (* i n) j) (* s (matrix-ref M i j))))) (list 'matrix m n data)))"))
(task-entry (id "statistics/link-functions/canonical-link") (skill statistics) (module link-functions) (tier 1) (difficulty 11218) (name canonical-link) (type "") (description "") (notes ()) (section link-function-structure) (deps (\x27;prelude \x27;transcendental \x27;special-functions)) (available (make-link-function link-function? link-name link-g link-inverse link-derivative identity-link logit-link log-link probit-link probit-quantile probit-cdf probit-pdf inverse-link sqrt-link cloglog-link cauchit-link make-power-link)) (answer "(define (canonical-link family-name) (case family-name ((gaussian) identity-link) ((binomial) logit-link) ((poisson) log-link) ((gamma) inverse-link) ((inverse-gaussian) (make-power-link -2)) (else (error 'canonical-link \"unknown family\" family-name))))"))
(task-entry (id "statistics/ar-poly/arma-model->string") (skill statistics) (module ar-poly) (tier 1) (difficulty 11218) (name arma-model->string) (type "") (description "") (notes ()) (section rational-field-for-exact-coefficient-arithmetic) (deps (\x27;field \x27;algebra/polynomial)) (available (Q-field-ts ar-char-poly-vec ar-char-poly ar-companion-poly ma-char-poly arma-common-factors arma-reducible? arma-reduce algebra-poly->ar-coeffs algebra-poly->ma-coeffs ar-stable-simple? ma-invertible-simple? fit-poly-trend vector-fold ar-forecast-weights ar-impulse-response ar-char-poly->string ma-char-poly->string)) (answer "(define (arma-model->string phi theta) (string-append \"X_t = (\" (poly->string (ma-char-poly theta) 'B) \") / (\" (poly->string (ar-char-poly-vec phi) 'B) \") * e_t\"))"))
(task-entry (id "statistics/ma/standard-normal-quantile-ma") (skill statistics) (module ma) (tier 1) (difficulty 11218) (name standard-normal-quantile-ma) (type "") (description "") (notes ()) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (moving-average weighted-moving-average exponential-moving-average ma-fit center-series-ma autocovariance-ma innovations-algorithm ma-compute-residuals ma-residual-sigma make-ma-result ma-coefficients ma-intercept ma-residuals ma-sigma ma-order ma-forecast ma-forecast-se make-forecast-result)) (answer "(define (standard-normal-quantile-ma p) (if (or (<= p 0) (>= p 1)) (if (<= p 0) -1000 1000) (let* ((a0 2.515517) (a1 0.802853) (a2 0.010328) (b1 1.432788) (b2 0.189269) (b3 0.001308) (sign (if (< p 0.5) -1 1)) (p* (if (< p 0.5) p (- 1 p))) (t (sqrt (* -2 (log p*)))) (num (+ a0 (* a1 t) (* a2 t t))) (den (+ 1 (* b1 t) (* b2 t t) (* b3 t t t)))) (* sign (- t (/ num den))))))"))
(task-entry (id "statistics/result-types/glm-link") (skill statistics) (module result-types) (tier 1) (difficulty 11219) (name glm-link) (type "") (description "") (notes ()) (section glm-results) (deps (\x27;prelude)) (available (make-linear-model-result linear-model? linear-model-coefficients linear-model-se linear-model-t-values linear-model-p-values linear-model-r-squared linear-model-adj-r-squared linear-model-residuals linear-model-fitted linear-model-sse linear-model-mse linear-model-n linear-model-p linear-model-df-residual linear-model-sigma make-glm-result glm-result? glm-family)) (answer "(define (glm-link m) (list-ref m 2))"))
(task-entry (id "statistics/summary-stats/vec-median") (skill statistics) (module summary-stats) (tier 1) (difficulty 11219) (name vec-median) (type "") (description "") (notes ()) (section basic-statistics-list-versions) (deps (\x27;prelude \x27;sort)) (available (mean variance variance-population std-dev std-dev-population median quantile quantile-from-sorted quantiles iqr range-stat covariance correlation vec-sum vec-mean vec-variance vec-std-dev vec-min vec-max)) (answer "(define (vec-median v) (median (vector->list v)))"))
(task-entry (id "statistics/design-matrix/hermite-features") (skill statistics) (module design-matrix) (tier 1) (difficulty 11219) (name hermite-features) (type "") (description "") (notes ()) (section standardization) (deps (\x27;prelude \x27;matrix \x27;summary-stats)) (available (add-intercept has-intercept? column-mean column-std standardize-columns unstandardize-coefficients unique-values dummy-encode one-hot-encode polynomial-features lists-to-design-matrix cbind rbind legendre-p chebyshev-t hermite-h laguerre-l legendre-features chebyshev-features)) (answer "(define (hermite-features xs degree) (let* ((n (vector-length xs)) (ncols (+ degree 1)) (mu (vec-mean xs)) (sigma (vec-std xs)) (scale (lambda (x) (if (= sigma 0) 0 (/ (- x mu) sigma)))) (data (make-vector (* n ncols)))) (do ((i 0 (+ i 1))) ((= i n) (list 'matrix n ncols data)) (let ((xi (scale (vector-ref xs i)))) (do ((d 0 (+ d 1))) ((> d degree)) (vector-set! data (+ (* i ncols) d) (hermite-h d xi)))))))"))
(task-entry (id "statistics/regularized/matrix-add") (skill statistics) (module regularized) (tier 1) (difficulty 11219) (name matrix-add) (type "") (description "") (notes ()) (section ridge-regression) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;summary-stats)) (available (ridge-fit ridge-diagnostics compute-r-squared-ridge lasso-fit lasso-coordinate-descent lasso-partial-residual soft-threshold lasso-finalize count-nonzero elastic-net-fit elastic-net-coordinate-descent elastic-net-update cross-validate-lambda cv-error-for-lambda split-fold compute-mse-test find-min-index identity-matrix matrix-scale)) (answer "(define (matrix-add A B) (let* ((m (matrix-rows A)) (n (matrix-cols A)) (data (make-vector (* m n)))) (do ((i 0 (+ i 1))) ((= i m)) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! data (+ (* i n) j) (+ (matrix-ref A i j) (matrix-ref B i j))))) (list 'matrix m n data)))"))
(task-entry (id "statistics/ma/arma-fit-simple") (skill statistics) (module ma) (tier 1) (difficulty 11219) (name arma-fit-simple) (type "") (description "") (notes ()) (section simple-moving-average-smoother) (deps (\x27;prelude \x27;result-types \x27;summary-stats \x27;acf-pacf)) (available (moving-average weighted-moving-average exponential-moving-average ma-fit center-series-ma autocovariance-ma innovations-algorithm ma-compute-residuals ma-residual-sigma make-ma-result ma-coefficients ma-intercept ma-residuals ma-sigma ma-order ma-forecast ma-forecast-se make-forecast-result standard-normal-quantile-ma)) (answer "(define (arma-fit-simple xs p q) (let* ((n (vector-length xs))) (if (< n (+ p q 5)) (list 'error 'insufficient-data n p q) (let* ((mean (vec-mean xs)) (centered (center-series-ma xs mean)) (acf-vals (acf centered (+ p q))) (R (make-toeplitz-ar acf-vals p)) (r (make-r-vector acf-vals p)) (phi (solve-toeplitz R r p))) (if (and (pair? phi) (eq? (car phi) 'error)) phi (let* ((ar-residuals (compute-ar-residuals centered phi p)) (ma-model (ma-fit ar-residuals q))) (if (and (pair? ma-model) (eq? (car ma-model) 'error)) ma-model (let* ((theta (ma-coefficients ma-model)) (sigma (ma-sigma ma-model))) (list 'arma-result phi theta mean sigma p q)))))))))"))
