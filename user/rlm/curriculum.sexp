(task-entry (id "clp/domain/domain-size") (skill clp) (module domain) (tier 1) (difficulty 10809) (name domain-size) (type "(-> Domain Nat)") (description "Count the number of values in the domain") (notes ()) (section domain-accessors) (deps (\x27;prelude \x27;sort)) (available (make-domain domain-singleton domain-from-list intervals-from-sorted list-uniq domain? domain-empty? domain-singleton? domain-contains?)) (answer "(define (domain-size dom) (let loop ((intervals dom) (count 0)) (if (null? intervals) count (loop (cdr intervals) (+ count (+ 1 (- (cdar intervals) (caar intervals))))))))"))
