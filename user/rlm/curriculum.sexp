(task-entry (id "linalg/vec2/vec2-from-angle") (skill linalg) (module vec2) (tier 0) (difficulty 406) (name vec2-from-angle) (type "(-> Number Vec2)") (description "Create unit vector from angle (radians)") (notes ()) (section \x32;d-specific-construction) (deps (\x27;prelude \x27;vec-common)) (available (vec2-cross vec2-perp-dot vec2-angle vec2-angle-between vec2-angle-to vec2-heading)) (answer "(define (vec2-from-angle angle) (vec2 (cos angle) (sin angle)))"))
(task-entry (id "linalg/quaternion/quat-from-two-vectors") (skill linalg) (module quaternion) (tier 0) (difficulty 406) (name quat-from-two-vectors) (type "") (description "") (notes ()) (section quaternion-construction) (deps (\x27;prelude \x27;vec3)) (available (quat quat-identity quat-zero quat-from-axis-angle quat-from-euler quat-from-rotation-matrix)) (answer "(define (quat-from-two-vectors v1 v2) (let* ((dot (vec3-dot v1 v2)) (cross (vec3-cross v1 v2))) (cond ((< dot -0.9999) (let* ((perp (if (< (abs (vec3-x v1)) 0.9) (vec3-cross v1 (vec3 1 0 0)) (vec3-cross v1 (vec3 0 1 0)))) (axis (vec3-normalize perp))) (quat 0 (vec3-x axis) (vec3-y axis) (vec3-z axis)))) (else (let* ((s (sqrt (* 2 (+ 1 dot)))) (inv-s (/ 1 s))) (quat-normalize (quat (/ s 2) (* (vec3-x cross) inv-s) (* (vec3-y cross) inv-s) (* (vec3-z cross) inv-s))))))))"))
(task-entry (id "linalg/matrix/matrix-from-lists") (skill linalg) (module matrix) (tier 0) (difficulty 406) (name matrix-from-lists) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec)) (available (matrix? matrix-rows matrix-cols matrix-data matrix-shape make-matrix)) (answer "(define (matrix-from-lists rows) (if (null? rows) (list 'matrix 0 0 (vector)) (let* ((m (length rows)) (n (length (car rows)))) (let check-rows ((rs rows) (i 0)) (cond ((null? rs) (let ((data (make-vector (* m n) 0))) (do ((i 0 (+ i 1)) (rs rows (cdr rs))) ((= i m)) (do ((j 0 (+ j 1)) (cs (car rs) (cdr cs))) ((= j n)) (vector-set! data (+ (* i n) j) (car cs)))) (list 'matrix m n data))) ((not (= (length (car rs)) n)) (quasiquote (error ragged-input row (unquote i) expected-length (unquote n) actual-length (unquote (length (car rs)))))) (else (check-rows (cdr rs) (+ i 1))))))))"))
(task-entry (id "linalg/matrix-decomp/qr-find-orthogonal-basis") (skill linalg) (module matrix-decomp) (tier 0) (difficulty 406) (name qr-find-orthogonal-basis) (type "") (description "Find a unit vector orthogonal to columns 0..j-1 of Q. Tries standard basis vectors e_0, e_1, ... until one works.") (notes ()) (section qr-decomposition) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*matrix-tolerance* matrix-copy matrix-set! matrix-column matrix-lu matrix-lu-solve)) (answer "(define (qr-find-orthogonal-basis q j m) (let find-loop ((k 0)) (if (= k m) #f (let* ((e-k (vec-unit m k)) (v (let orth-loop ((p 0) (curr e-k)) (if (= p j) curr (let* ((q-p (matrix-column q p)) (proj (vec-dot q-p curr))) (orth-loop (+ p 1) (vec-sub curr (vec-scale proj q-p))))))) (v-norm (vec-norm v))) (if (> v-norm *matrix-tolerance*) (vec-scale (/ 1.0 v-norm) v) (find-loop (+ k 1)))))))"))
(task-entry (id "linalg/matrix-solvers/matrix-least-squares") (skill linalg) (module matrix-solvers) (tier 0) (difficulty 406) (name matrix-least-squares) (type "") (description "") (notes ()) (section least-squares) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (matrix-forward-substitute matrix-back-substitute matrix-solve matrix-inverse permutation-parity matrix-determinant)) (answer "(define (matrix-least-squares a b) (let ((qr (matrix-qr a))) (if (and (pair? qr) (eq? (car qr) 'error)) qr (let* ((q (car qr)) (r (cadr qr)) (qt-b (matrix-vec-mul (matrix-transpose q) b))) (matrix-back-substitute r qt-b)))))"))
(task-entry (id "linalg/matrix-eigen/qr-converged?") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 406) (name qr-converged?) (type "") (description "") (notes ()) (section qr-algorithm) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations* power-iteration power-iteration-loop qr-algorithm qr-algorithm-loop)) (answer "(define (qr-converged? a tol) (let ((n (matrix-rows a))) (let row-loop ((i 1)) (if (>= i n) #t (let col-loop ((j 0)) (if (>= j i) (row-loop (+ i 1)) (if (> (abs (matrix-ref a i j)) tol) #f (col-loop (+ j 1)))))))))"))
(task-entry (id "linalg/iterative-solvers/gauss-seidel") (skill linalg) (module iterative-solvers) (tier 0) (difficulty 406) (name gauss-seidel) (type "") (description "") (notes ()) (section gauss-seidel-iteration) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (*iterative-tolerance* *iterative-max-iterations* residual converged? jacobi jacobi-loop)) (answer "(define (gauss-seidel a b . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (cond ((not (= n m)) (quasiquote (error not-square (unquote n) (unquote m)))) ((not (= n (vector-length b))) (quasiquote (error dimension-mismatch (unquote n) (unquote (vector-length b))))) (else (let* ((x0 (if (and (pair? opts) (vector? (car opts))) (car opts) (make-vector n 0.0))) (rest1 (if (and (pair? opts) (vector? (car opts))) (cdr opts) opts)) (max-iter (if (and (pair? rest1) (integer? (car rest1))) (car rest1) *iterative-max-iterations*)) (rest2 (if (and (pair? rest1) (integer? (car rest1))) (cdr rest1) rest1)) (tol (if (and (pair? rest2) (number? (car rest2))) (car rest2) *iterative-tolerance*))) (gauss-seidel-loop a b (vector-copy x0) 0 max-iter tol n))))))"))
(task-entry (id "linalg/sparse/sparse-coo-col-indices") (skill linalg) (module sparse) (tier 0) (difficulty 406) (name sparse-coo-col-indices) (type "") (description "") (notes ()) (section coo-format) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sort)) (available (*sparse-epsilon* sparse-coo? make-sparse-coo sparse-coo-rows sparse-coo-cols sparse-coo-row-indices)) (answer "(define (sparse-coo-col-indices m) (list-ref m 4))"))
(task-entry (id "linalg/graph-laplacian/second-smallest-index") (skill linalg) (module graph-laplacian) (tier 0) (difficulty 406) (name second-smallest-index) (type "") (description "") (notes ()) (section normalized-laplacian) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;sparse \x27;sort)) (available (laplacian laplacian-from-edges laplacian-normalized laplacian-random-walk algebraic-connectivity fiedler-vector)) (answer "(define (second-smallest-index v) (let ((n (vector-length v))) (if (< n 2) 0 (let loop ((i 0) (min-idx 0) (min-val +inf.0) (second-idx 0) (second-val +inf.0)) (if (= i n) second-idx (let ((val (abs (vector-ref v i)))) (cond ((< val min-val) (loop (+ i 1) i val min-idx min-val)) ((< val second-val) (loop (+ i 1) min-idx min-val i val)) (else (loop (+ i 1) min-idx min-val second-idx second-val)))))))))"))
(task-entry (id "linalg/svd/build-sigma-matrix") (skill linalg) (module svd) (tier 0) (difficulty 406) (name build-sigma-matrix) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp \x27;matrix-eigen)) (available (*svd-tolerance* *svd-max-iterations* svd svd-via-ata svd-via-aat eigenvalues->singular-values)) (answer "(define (build-sigma-matrix m n singular-values) (let ((sigma (make-matrix m n 0)) (k (min m n (vector-length singular-values)))) (do ((i 0 (+ i 1))) ((= i k) sigma) (matrix-set! sigma i i (vector-ref singular-values i)))))"))
