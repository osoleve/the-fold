(task-entry (id "geometry/obj-loader/faces->triangles") (skill geometry) (module obj-loader) (tier 1) (difficulty 12205) (name faces->triangles) (type "(-> (Vector Vec3) (List (List Number)) (List Triangle3))") (description "Convert face indices to triangles (handles n-gons by fan triangulation)") (notes ()) (section obj-loading) (deps (\x27;prelude \x27;geometry)) (available (parse-obj-line parse-vertex parse-face string-split load-obj-from-string)) (answer "(define (faces->triangles vertices faces) (append-map (lambda (face) (face->triangles vertices face)) faces))"))
