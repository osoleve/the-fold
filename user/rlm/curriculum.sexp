(task-entry (id "fp/simplify/extract-coefficient") (skill fp) (module simplify) (tier 1) (difficulty 10606) (name extract-coefficient) (type "(-> Expr (Values Number Expr))") (description "Extract numeric coefficient from term") (notes ("x → (1, x), 2*x → (2, x), -x → (-1, x)")) (section sum-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms)) (answer "(define (extract-coefficient term) (cond ((num? term) (values (num-val term) (num 1))) ((and (product? term) (>= (length (product-factors term)) 2) (num? (car (product-factors term)))) (let ((coef (num-val (car (product-factors term)))) (rest (cdr (product-factors term)))) (values coef (if (= (length rest) 1) (car rest) (cons '* rest))))) ((and (difference? term) (not (diff-right term))) (let-values (((c b) (extract-coefficient (diff-left term)))) (values (- c) b))) (else (values 1 term))))"))
(task-entry (id "fp/integrate/integrate-product") (skill fp) (module integrate) (tier 1) (difficulty 10606) (name integrate-product) (type "") (description "") (notes ()) (section basic-integration-rules) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table is-arcsin-integrand? is-arctan-integrand? integrate-basic)) (answer "(define (integrate-product expr var-sym depth) (let* ((factors (product-factors expr)) (const-factors (filter (lambda (f) (not (contains-var? f var-sym))) factors)) (var-factors (filter (lambda (f) (contains-var? f var-sym)) factors))) (cond ((null? var-factors) (product expr (var var-sym))) ((= (length var-factors) 1) (let ((int-var (integrate-internal (car var-factors) var-sym (+ depth 1)))) (if int-var (product (fold-left product (num 1) const-factors) int-var) #f))) (else #f))))"))
(task-entry (id "fp/solve/collect-linear-coeffs-impl") (skill fp) (module solve) (tier 1) (difficulty 10606) (name collect-linear-coeffs-impl) (type "") (description "") (notes ()) (section equation-representation) (deps (\x27;expr \x27;simplify)) (available (make-equation equation? equation-lhs equation-rhs equation->expr collect-linear-coeffs)) (answer "(define (collect-linear-coeffs-impl expr var-sym) (cond ((num? expr) (values (num 0) expr)) ((var? expr) (if (eq? (var-name expr) var-sym) (values (num 1) (num 0)) (values (num 0) expr))) ((sum? expr) (let loop ((terms (sum-terms expr)) (coeff-acc (num 0)) (const-acc (num 0))) (if (null? terms) (values (simplify coeff-acc) (simplify const-acc)) (let-values (((c k) (collect-linear-coeffs-impl (car terms) var-sym))) (loop (cdr terms) (sum coeff-acc c) (sum const-acc k)))))) ((product? expr) (let ((factors (product-factors expr))) (cond ((and (= (length factors) 2) (var? (cadr factors)) (eq? (var-name (cadr factors)) var-sym) (not (contains-var? (car factors) var-sym))) (values (car factors) (num 0))) ((and (= (length factors) 2) (var? (car factors)) (eq? (var-name (car factors)) var-sym) (not (contains-var? (cadr factors) var-sym))) (values (cadr factors) (num 0))) ((not (any-contains-var? factors var-sym)) (values (num 0) expr)) (else (values expr (num 0)))))) ((difference? expr) (if (diff-right expr) (let-values (((c1 k1) (collect-linear-coeffs-impl (diff-left expr) var-sym)) ((c2 k2) (collect-linear-coeffs-impl (diff-right expr) var-sym))) (values (simplify (difference c1 c2)) (simplify (difference k1 k2)))) (let-values (((c k) (collect-linear-coeffs-impl (diff-left expr) var-sym))) (values (simplify (make-neg c)) (simplify (make-neg k)))))) (else (if (contains-var? expr var-sym) (values expr (num 0)) (values (num 0) expr)))))"))
(task-entry (id "fp/poly-canonical/extract-coeff-expanded") (skill fp) (module poly-canonical) (tier 1) (difficulty 10606) (name extract-coeff-expanded) (type "") (description "") (notes ()) (section conversion) (deps (\x27;field \x27;algebra/polynomial \x27;expr \x27;simplify)) (available (Q-field-sym expr->polynomial polynomial-expr? expr-degree extract-poly-coeffs extract-coeff-at)) (answer "(define (extract-coeff-expanded expr var-sym k) (cond ((num? expr) (if (= k 0) (num-val expr) 0)) ((var? expr) (cond ((and (eq? (var-name expr) var-sym) (= k 1)) 1) ((and (eq? (var-name expr) var-sym) (not (= k 1))) 0) ((= k 0) 1) (else 0))) ((sum? expr) (apply + (map (lambda (t) (extract-coeff-expanded t var-sym k)) (sum-terms expr)))) ((difference? expr) (if (diff-right expr) (- (extract-coeff-expanded (diff-left expr) var-sym k) (extract-coeff-expanded (diff-right expr) var-sym k)) (- (extract-coeff-expanded (diff-left expr) var-sym k)))) ((product? expr) (extract-coeff-product (product-factors expr) var-sym k)) ((power? expr) (if (and (var? (pow-base expr)) (eq? (var-name (pow-base expr)) var-sym) (num? (pow-exp expr)) (= (num-val (pow-exp expr)) k)) 1 (if (and (= k 0) (not (and (var? (pow-base expr)) (eq? (var-name (pow-base expr)) var-sym)))) (expr-eval-at-zero (pow-base expr) var-sym) 0))) (else 0)))"))
