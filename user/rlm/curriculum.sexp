(task-entry (id "control-systems/hinf-synthesis/make-generalized-plant") (skill control-systems) (module hinf-synthesis) (tier 2) (difficulty 22600) (name make-generalized-plant) (type "Matrix^9 → GeneralizedPlant") (description "Create a generalized plant structure for H-infinity synthesis.\n  w: disturbance inputs (B1), z: performance outputs (C1)\n  u: control inputs (B2), y: measurement outputs (C2)") (notes ()) (section none) (deps (\x27;prelude \x27;matrix \x27;matrix-eigen \x27;matrix-solvers \x27;control/state-space \x27;control/transfer-function \x27;control/stability \x27;control/controller-design)) (available ()) (answer "(define (make-generalized-plant A B1 B2 C1 C2 D11 D12 D21 D22) (list 'gen-plant A B1 B2 C1 C2 D11 D12 D21 D22))"))
