(task-entry (id "data/quadtree/quadtree-insert") (skill data) (module quadtree) (tier 0) (difficulty 1327) (name quadtree-insert) (type "(-> Quadtree Num Num Any Quadtree)") (description "Insert a point at (x,y) with associated data into the quadtree") (notes ()) (section insertion) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build quadtree-build-auto list->quadtree)) (answer "(define (quadtree-insert tree x y data) (quadtree-insert-at-depth tree x y data 0))"))
