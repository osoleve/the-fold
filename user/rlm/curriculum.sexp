(task-entry (id "linalg/dep-linalg/diff-scalar") (skill linalg) (module dep-linalg) (tier 0) (difficulty 423) (name diff-scalar) (type "(Diff Int Int) → Int → Int") (description "Differentiate a scalar function at a point.") (notes ()) (section differentiable-operations) (deps (\x27;prelude \x27;vec \x27;matrix)) (available (dep-linalg-types vec-append-typed vec-zip-typed vec-head-typed vec-tail-typed vec-map-typed vec-fold-typed matrix-mul-typed matrix-add-typed matrix-transpose-typed matrix-scale-typed vec-ref-safe matrix-ref-safe vec-nil-typed vec-cons-typed make-dep-linalg-ctx extend-ctx-with-dep-linalg diff-grad diff-jacobian diff-hessian diff-compose diff-lift diff-primal)) (answer "(define (diff-scalar diff-fn x) (let ((grad-fn (cdr (assq 'gradient diff-fn)))) (if grad-fn (grad-fn x) 0.0)))"))
