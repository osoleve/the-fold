(task-entry (id "random/monte-carlo/mc-normal-tail-prob") (skill random) (module monte-carlo) (tier 1) (difficulty 12942) (name mc-normal-tail-prob) (type "") (description "") (notes ()) (section convenience-functions) (deps (\x27;prelude \x27;state \x27;transcendental \x27;prng \x27;distributions \x27;sort)) (available (sample-mean sample-variance sample-std sample-sem sample-quantile sample-median sample-min sample-max sample-summary mc-integrate mc-estimate importance-sample self-normalized-importance-sample rejection-sample rejection-sample-n rejection-sample-bounded mh-step mh-symmetric-step mh-chain mh-sample mh-thinned-sample random-walk-proposal multivariate-random-walk-proposal gibbs-step list-update gibbs-chain gibbs-sample antithetic-estimate antithetic-integrate control-variate-estimate stratified-sample effective-sample-size split-into-batches gelman-rubin autocorrelation integrated-autocorrelation-time mcmc-diagnostics parallel-chains batch-sample progressive-sample run-mc mc-pi-estimate)) (answer "(define (mc-normal-tail-prob threshold n) (let ((shifted-exponential (state-bind (random-exponential 1) (lambda (e) (state-pure (+ threshold e)))))) (state-bind (random-list n shifted-exponential) (lambda (samples) (let* ((weights (map (lambda (x) (/ (exp-num (* -0.5 x x)) (exp-num (- threshold x)))) samples)) (total-weight (fold-left + 0 weights)) (estimate (/ total-weight n (sqrt (* 2 (pi-value)))))) (state-pure estimate))))))"))
(task-entry (id "random/variational-inference/vi-step-mf") (skill random) (module variational-inference) (tier 1) (difficulty 12942) (name vi-step-mf) (type "") (description "") (notes ()) (section stochastic-gradient-descent-for-vi) (deps (\x27;prelude \x27;reverse-diff \x27;prng \x27;distributions \x27;bayesian)) (available (iota-vi make-mf-gaussian mf-gaussian? mf-gaussian-means mf-gaussian-log-stds mf-gaussian-stds mf-gaussian-dim sample-standard-normals mf-gaussian-reparam mf-gaussian-reparam-traced sample-mf-gaussian mf-gaussian-log-prob mf-gaussian-entropy make-full-gaussian full-gaussian? full-gaussian-means full-gaussian-chol full-gaussian-dim chol-flat-to-matrix chol-num-elements full-gaussian-reparam sample-full-gaussian full-gaussian-log-prob forward-solve butlast full-gaussian-entropy vfamily-dim vfamily-sample vfamily-log-prob vfamily-entropy vfamily-params vfamily-from-params elbo-estimate elbo-with-entropy elbo-gradient-mf traced-log-normal-pdf-sum make-traced-log-joint-normal-mean make-traced-log-joint-linear-regression take-traced drop-traced sum-traced traced-log-normal-pdf)) (answer "(define (vi-step-mf log-joint vfamily prng learning-rate) (let* ((d (mf-gaussian-dim vfamily)) (means (mf-gaussian-means vfamily)) (log-stds (mf-gaussian-log-stds vfamily))) (let-values (((epsilons new-prng) (sample-standard-normals d prng))) (let* ((grad (elbo-gradient-mf log-joint means log-stds epsilons)) (grad-means (take d grad)) (grad-log-stds (drop d grad)) (new-means (map (lambda (m g) (+ m (* learning-rate g))) means grad-means)) (new-log-stds (map (lambda (s g) (+ s (* learning-rate g))) log-stds grad-log-stds))) (values (make-mf-gaussian new-means new-log-stds) new-prng)))))"))
