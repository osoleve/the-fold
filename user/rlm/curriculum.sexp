(task-entry (id "statistics/glm/compute-z-pvalues") (skill statistics) (module glm) (tier 1) (difficulty 11208) (name compute-z-pvalues) (type "") (description "") (notes ()) (section irls-algorithm) (deps (\x27;prelude \x27;matrix \x27;matrix-decomp \x27;matrix-solvers \x27;result-types \x27;families \x27;link-functions \x27;stat/distributions)) (available (glm-fit irls-loop irls-step weighted-least-squares irls-converged? irls-finalize compute-glm-se compute-z-values)) (answer "(define (compute-z-pvalues z-values) (let* ((p (vector-length z-values)) (pv (make-vector p))) (do ((j 0 (+ j 1))) ((= j p) pv) (let* ((z (abs (vector-ref z-values j))) (pval (* 2 (- 1 (probit-cdf z))))) (vector-set! pv j pval)))))"))
