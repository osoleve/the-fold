(task-entry (id "data/collection-utils/collection-remove") (skill data) (module collection-utils) (tier 0) (difficulty 1317) (name collection-remove) (type "(-> Block Hash Block)") (description "Create new collection with member removed. Returns new collection block (original is immutable)") (notes ()) (section collection-construction) (deps (\x27;block \x27;sha256)) (available (foldr collection-hashes collection-size collection-empty? map-collection filter-collection fold-collection foldr-collection for-each-collection collection-find collection-any? collection-all? collection-count-matching collection-partition collection-group-by make-collection-from-blocks collection-add)) (answer "(define (collection-remove collection member-hash) (let* ((old-refs (block-refs collection)) (new-refs (list->vector (filter (lambda (h) (not (equal? h member-hash))) (vector->list old-refs))))) (make-block (block-tag collection) (block-payload collection) new-refs)))"))
(task-entry (id "data/graph-primitives/hash-in-list?") (skill data) (module graph-primitives) (tier 0) (difficulty 1317) (name hash-in-list?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;collection-utils)) (available (bytevector-hash make-visited visited-add visited-contains? visited-remove make-queue queue-empty? queue-normalize queue-enqueue queue-enqueue-all queue-dequeue make-stack stack-empty? stack-push stack-push-all stack-pop hash-equal?)) (answer "(define (hash-in-list? hash lst) (let loop ((l lst)) (cond ((null? l) #f) ((bytevector=? (car l) hash) #t) (else (loop (cdr l))))))"))
(task-entry (id "data/graph-matrix/adjacency-matrix-edge-count") (skill data) (module graph-matrix) (tier 0) (difficulty 1317) (name adjacency-matrix-edge-count) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count)) (answer "(define (adjacency-matrix-edge-count m) (if (sparse-csr? m) (sparse-csr-nnz m) (let ((data (matrix-data m)) (n (vector-length (matrix-data m)))) (let loop ((i 0) (count 0)) (if (= i n) count (loop (+ i 1) (if (= (vector-ref data i) 0) count (+ count 1))))))))"))
(task-entry (id "data/centrality/betweenness-from-source") (skill data) (module centrality) (tier 0) (difficulty 1317) (name betweenness-from-source) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality katz-power-series katz-centrality-from-edges closeness-centrality standard-closeness-node harmonic-closeness-node closeness-centrality-from-adj closeness-centrality-from-edges betweenness-centrality)) (answer "(define (betweenness-from-source adj s cb n) (let* ((dist (make-vector n -1)) (sigma (make-vector n 0)) (pred (make-vector n '())) (delta (make-vector n 0.0)) (stack '())) (vector-set! dist s 0) (vector-set! sigma s 1) (let bfs ((current-level (list s))) (when (not (null? current-level)) (let ((next-level '())) (for-each (lambda (v) (set! stack (cons v stack)) (do ((w 0 (+ w 1))) ((= w n)) (when (> (matrix-ref adj v w) 0) (cond ((= (vector-ref dist w) -1) (vector-set! dist w (+ (vector-ref dist v) 1)) (set! next-level (cons w next-level)) (vector-set! sigma w (vector-ref sigma v)) (vector-set! pred w (list v))) ((= (vector-ref dist w) (+ (vector-ref dist v) 1)) (vector-set! sigma w (+ (vector-ref sigma w) (vector-ref sigma v))) (vector-set! pred w (cons v (vector-ref pred w)))))))) current-level) (bfs next-level)))) (for-each (lambda (w) (for-each (lambda (v) (let ((frac (/ (vector-ref sigma v) (vector-ref sigma w) 1.0))) (vector-set! delta v (+ (vector-ref delta v) (* frac (+ 1 (vector-ref delta w))))))) (vector-ref pred w)) (when (not (= w s)) (vector-set! cb w (+ (vector-ref cb w) (vector-ref delta w))))) stack)))"))
(task-entry (id "data/graph-community/modularity-ilp") (skill data) (module graph-community) (tier 0) (difficulty 1317) (name modularity-ilp) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive prim-find-min mst-weight kruskal-mst uf-find uf-union connected-components is-connected? mst-from-adjacency)) (answer "(define (modularity-ilp adj) (let* ((n (matrix-rows adj)) (two-m (matrix-sum adj))) (if (or (= two-m 0) (< n 2)) (make-vector n 0) (let* ((m (/ two-m 2.0)) (degrees (compute-degrees adj n)) (B (compute-modularity-matrix adj degrees two-m n)) (ilp-data (build-modularity-ilp B n)) (result (ilp-solve ilp-data))) (if (ilp-optimal? result) (let ((sol (ilp-result-x result))) (let ((labels (make-vector n 0))) (do ((i 0 (+ i 1))) ((= i n) labels) (vector-set! labels i (inexact->exact (round (vector-ref sol i))))))) (make-vector n 0))))))"))
(task-entry (id "data/graph-layout/graph-nodes-lens") (skill data) (module graph-layout) (tier 0) (difficulty 1317) (name graph-nodes-lens) (type "") (description "") (notes ()) (section graph-representation) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node)) (answer "(define graph-nodes-lens (make-lens graph-nodes (lambda (val g) (graph-set-nodes g val))))"))
(task-entry (id "data/kdtree/kdtree-nearest-rec") (skill data) (module kdtree) (tier 0) (difficulty 1317) (name kdtree-nearest-rec) (type "") (description "") (notes ()) (section nearest-neighbor) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest)) (answer "(define (kdtree-nearest-rec tree query k best-dist best-point) (if (kdtree-empty? tree) (cons best-point best-dist) (let* ((node-point (kdtree-point tree)) (depth (kdtree-depth tree)) (axis (modulo depth k)) (dist-sq (point-distance-sq query node-point)) (new-best-dist (if (< dist-sq best-dist) dist-sq best-dist)) (new-best-point (if (< dist-sq best-dist) node-point best-point)) (query-coord (point-coord query axis)) (node-coord (point-coord node-point axis)) (go-left? (< query-coord node-coord)) (first-child (if go-left? (kdtree-left tree) (kdtree-right tree))) (second-child (if go-left? (kdtree-right tree) (kdtree-left tree)))) (let* ((result1 (kdtree-nearest-rec first-child query k new-best-dist new-best-point)) (best-after-first (cdr result1)) (point-after-first (car result1)) (split-dist-sq (let ((d (- query-coord node-coord))) (* d d)))) (if (< split-dist-sq best-after-first) (kdtree-nearest-rec second-child query k best-after-first point-after-first) result1)))))"))
