(task-entry (id "physics/classical3d/constraint-solver3d/compute-effective-mass-inv-3d") (skill physics/classical3d) (module constraint-solver3d) (tier 2) (difficulty 22406) (name compute-effective-mass-inv-3d) (type "") (description "") (notes ()) (section solver-constants) (deps (\x27;prelude \x27;vec3 \x27;quaternion \x27;rigid-body3d \x27;constraints3d)) (available (*baumgarte-factor-3d* *position-slop-3d* *angular-slop-3d* apply-impulse-at-point-3d apply-angular-impulse-3d velocity-at-point-3d)) (answer "(define (compute-effective-mass-inv-3d body-a body-b r-a r-b) (let* ((inv-mass-a (if body-a (rigid-body-3d-inv-mass body-a) 0)) (inv-mass-b (if body-b (rigid-body-3d-inv-mass body-b) 0)) (I-inv-a (if body-a (rigid-body-3d-world-inv-inertia body-a) (mat3-zero))) (I-inv-b (if body-b (rigid-body-3d-world-inv-inertia body-b) (mat3-zero))) (total-inv-mass (+ inv-mass-a inv-mass-b))) total-inv-mass))"))
