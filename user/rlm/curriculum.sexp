(task-entry (id "data/dict/dict-merge") (skill data) (module dict) (tier 0) (difficulty 1309) (name dict-merge) (type "(-> Dict Dict Dict)") (description "Merge two dictionaries") (notes ("If keys overlap, dict2 wins")) (section none) (deps (\x27;prelude)) (available (dict-empty dict-empty? dict-lookup dict-has-key? dict-assoc dict-dissoc dict-keys dict-values dict-entries)) (answer "(define (dict-merge dict1 dict2) (let loop ((remaining dict2) (result dict1)) (if (null? remaining) result (loop (cdr remaining) (dict-assoc (car (car remaining)) (cdr (car remaining)) result)))))"))
(task-entry (id "data/collection-utils/collection-find") (skill data) (module collection-utils) (tier 0) (difficulty 1309) (name collection-find) (type "(-> FSCap (-> Block Boolean) Block (Maybe Block))") (description "Find first block in collection matching predicate") (notes ()) (section collection-queries) (deps (\x27;block \x27;sha256)) (available (foldr collection-hashes collection-size collection-empty? map-collection filter-collection fold-collection foldr-collection for-each-collection)) (answer "(define (collection-find fs predicate collection) (let ((hashes (collection-hashes collection))) (let loop ((hashes hashes)) (if (null? hashes) #f (let ((block (fs-fetch fs (car hashes)))) (if (and block (predicate block)) block (loop (cdr hashes))))))))"))
(task-entry (id "data/graph-primitives/queue-enqueue-all") (skill data) (module graph-primitives) (tier 0) (difficulty 1309) (name queue-enqueue-all) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;collection-utils)) (available (bytevector-hash make-visited visited-add visited-contains? visited-remove make-queue queue-empty? queue-normalize queue-enqueue)) (answer "(define (queue-enqueue-all q items) (queue-normalize (cons (car q) (append (reverse items) (cdr q)))))"))
(task-entry (id "data/graph-homology/graph-is-forest?") (skill data) (module graph-homology) (tier 0) (difficulty 1309) (name graph-is-forest?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;homology)) (available (graph->simplicial-complex graph-adjacency->simplicial-complex graph-betti-numbers graph-betti-numbers-from-adjacency cycle-basis-homology edges-from-z2-null-vector graph-euler-characteristic graph-cycle-rank graph-is-tree?)) (answer "(define (graph-is-forest? edges vertices) (let ((betti (graph-betti-numbers edges vertices))) (= (cdr betti) 0)))"))
(task-entry (id "data/pagerank/vec-norm-1") (skill data) (module pagerank) (tier 0) (difficulty 1309) (name vec-norm-1) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*default-damping-factor* *pagerank-tolerance* *pagerank-max-iterations* adjacency->transition matrix-row-sum matrix-col-sum make-google-matrix pagerank-from-matrix pagerank-power-iteration)) (answer "(define (vec-norm-1 v) (vec-fold (lambda (acc x) (+ acc (abs x))) 0 v))"))
(task-entry (id "data/graph-matrix/make-adjacency-matrix") (skill data) (module graph-matrix) (tier 0) (difficulty 1309) (name make-adjacency-matrix) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges)) (answer "(define (make-adjacency-matrix n) (make-matrix n n 0))"))
(task-entry (id "data/centrality/katz-power-series") (skill data) (module centrality) (tier 0) (difficulty 1309) (name katz-power-series) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;vec \x27;matrix \x27;graph-matrix)) (available (*centrality-tolerance* *centrality-max-iterations* eigenvector-centrality eigenvector-power-iteration vec-distance eigenvector-average-oscillation eigenvector-normalize eigenvector-centrality-from-edges katz-centrality)) (answer "(define (katz-power-series adj alpha beta ones max-iter tol) (let ((n (matrix-rows adj))) (let loop ((x (vec-scale beta ones)) (term (vec-scale beta ones)) (iter 0)) (if (>= iter max-iter) x (let* ((a-term (matrix-vec-mul adj term)) (new-term (vec-scale alpha a-term)) (term-norm (vec-norm new-term))) (if (< term-norm tol) x (loop (vec-add x new-term) new-term (+ iter 1))))))))"))
(task-entry (id "data/graph-community/prim-find-min") (skill data) (module graph-community) (tier 0) (difficulty 1309) (name prim-find-min) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;graph-matrix \x27;ilp \x27;graph-homology)) (available (label-propagation label-prop-node-order most-frequent-neighbor-label communities->partition num-communities modularity matrix-sum prim-mst prim-mst-naive)) (answer "(define (prim-find-min weights in-mst n) (let loop ((i 0) (min-idx #f) (min-val +inf.0)) (if (= i n) min-idx (if (and (not (vector-ref in-mst i)) (< (vector-ref weights i) min-val)) (loop (+ i 1) i (vector-ref weights i)) (loop (+ i 1) min-idx min-val)))))"))
