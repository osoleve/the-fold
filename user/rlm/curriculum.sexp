(task-entry (id "algebra/polynomial/poly-power") (skill algebra) (module polynomial) (tier 0) (difficulty 321) (name poly-power) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs poly-neg poly-sub poly-scale poly-mul poly-mul-coeff-at)) (answer "(define (poly-power p n) (cond ((= n 0) (poly-one-over (poly-field p))) ((= n 1) p) ((even? n) (let ((half (poly-power p (/ n 2)))) (poly-mul half half))) (else (poly-mul p (poly-power p (- n 1))))))"))
(task-entry (id "algebra/multivariate/mono-compare-grevlex") (skill algebra) (module multivariate) (tier 0) (difficulty 321) (name mono-compare-grevlex) (type "") (description "") (notes ()) (section monomial-representation) (deps (\x27;prelude \x27;field \x27;sort)) (available (make-monomial sort-by-var symbol<? mono-one mono-var mono-power mono-degree mono-degree-in mono-vars mono-mul mono-merge mono-divides? mono-div mono-div-helper mono-lcm mono-lcm-helper mono-gcd mono-gcd-helper mono-equal? mono-compare-lex mono-compare-grlex)) (answer "(define (mono-compare-grevlex m1 m2 vars) (let ((d1 (mono-degree m1)) (d2 (mono-degree m2))) (cond ((> d1 d2) 1) ((< d1 d2) -1) (else (let loop ((vs (reverse vars))) (if (null? vs) 0 (let ((v (car vs))) (let ((e1 (mono-degree-in m1 v)) (e2 (mono-degree-in m2 v))) (cond ((< e1 e2) 1) ((> e1 e2) -1) (else (loop (cdr vs))))))))))))"))
(task-entry (id "algebra/poly-bridge/numeric->algebra-with-field") (skill algebra) (module poly-bridge) (tier 0) (difficulty 321) (name numeric->algebra-with-field) (type "(-> NumericPoly Field AlgebraPoly)") (description "Convert with explicit field specification") (notes ()) (section conversion-functions) (deps (\x27;field \x27;algebra/polynomial)) (available (alg-poly-coeffs alg-poly-degree alg-poly-field alg-poly-zero? alg-poly-leading-coeff alg-poly-add alg-poly-sub alg-poly-mul alg-poly-scale alg-poly-divmod alg-poly-div alg-poly-mod alg-poly-gcd alg-poly-extended-gcd alg-poly-derivative alg-poly-eval alg-poly-monic alg-poly->string alg-make-polynomial Q-field numeric->algebra)) (answer "(define (numeric->algebra-with-field p field) (let* ((coeffs-vec (cond ((vector? p) p) ((and (pair? p) (eq? (car p) 'poly) (vector? (cadr p))) (cadr p)) ((and (pair? p) (vector? (cdr p))) (cdr p)) (else (error 'numeric->algebra \"invalid polynomial format\")))) (coeffs-list (vector->list coeffs-vec)) (ascending (reverse coeffs-list))) (alg-make-polynomial field ascending)))"))
