(task-entry (id "game-theory/matching/make-matching-market") (skill game-theory) (module matching) (tier 1) (difficulty 13200) (name make-matching-market) (type "(-> (List Id) (List Id) (List (Id . List)) (List (Id . List)) Market)") (description "Create a matching market from proposers, receivers, and their preferences") (notes ("Example: (make-matching-market (m1 m2 m3) (w1 w2 w3) ((m1 w1 w2 w3) (m2 w2 w1 w3) (m3 w1 w3 w2)) ((w1 m2 m1 m3) (w2 m1 m2 m3) (w3 m1 m3 m2)))")) (section matching-market-data-structures) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available ()) (answer "(define (make-matching-market proposers receivers p-pref-list r-pref-list) (let ((p-prefs (make-pref-table p-pref-list)) (r-prefs (make-pref-table r-pref-list))) (make-matching-market% (list->vector proposers) (list->vector receivers) p-prefs r-prefs)))"))
(task-entry (id "game-theory/voting/make-preference-profile") (skill game-theory) (module voting) (tier 1) (difficulty 13200) (name make-preference-profile) (type "(-> (List (List Candidate)) PreferenceProfile)") (description "Create a preference profile from a list of rankings. Each ranking is a list of candidates in order of preference (best first). Example: ((a b c) (b a c) (c b a)) = 3 voters ranking candidates a,b,c") (notes ("Validates that: (1) All rankings contain the same candidates, (2) No ranking contains duplicate candidates")) (section preference-profiles) (deps (\x27;prelude \x27;sort)) (available ()) (answer "(define (make-preference-profile rankings) (if (null? rankings) '() (let ((first-ranking (car rankings))) (unless (= (length first-ranking) (length (list->set first-ranking))) (error 'make-preference-profile \"Rankings must not contain duplicate candidates\")) (let ((candidates (list->set first-ranking))) (if (for-all? (lambda (r) (and (= (length r) (length candidates)) (set=? candidates (list->set r)))) rankings) rankings (error 'make-preference-profile \"All rankings must contain same candidates without duplicates\"))))))"))
(task-entry (id "game-theory/strategic-voting/voter-utility") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13200) (name voter-utility) (type "") (description "Compute voter's utility for winner based on their true preferences. First-choice winner gives highest utility") (notes ()) (section utilities) (deps (\x27;prelude \x27;voting)) (available ()) (answer "(define (voter-utility winner true-ranking) (let ((pos (position-of winner true-ranking))) (if pos (- (length true-ranking) 1 pos) 0)))"))
(task-entry (id "game-theory/voting-games/profile->majority-game") (skill game-theory) (module voting-games) (tier 1) (difficulty 13200) (name profile->majority-game) (type "(-> PreferenceProfile CoopGame)") (description "Convert a preference profile to a simple majority game. Coalition S is winning iff |S| > n/2 (can control plurality outcome). This is the classical model: each voter has equal weight") (notes ()) (section profile-conversion) (deps (\x27;voting \x27;coop-games)) (available ()) (answer "(define (profile->majority-game profile) (let* ((n (profile-voters profile)) (quota (+ (quotient n 2) 1))) (make-coop-game n (lambda (S) (if (>= (coalition-size S) quota) 1 0)))))"))
(task-entry (id "game-theory/multi-winner/droop-quota") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13200) (name droop-quota) (type "(-> Nat Nat Nat)") (description "Droop quota: floor(votes / (seats + 1)) + 1. Most common quota - ensures at most k candidates can meet quota. Example: 100 voters, 5 seats → floor(100/6) + 1 = 17") (notes ()) (section quotas) (deps (\x27;voting)) (available ()) (answer "(define (droop-quota num-voters num-seats) (+ (floor (/ num-voters (+ num-seats 1))) 1))"))
(task-entry (id "game-theory/fair-division/make-cake") (skill game-theory) (module fair-division) (tier 1) (difficulty 13200) (name make-cake) (type "(-> Nat Cake)") (description "Create a cake to be divided among n players. Initially no valuations assigned") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available ()) (answer "(define (make-cake n) (make-cake% n (make-vector n #f)))"))
(task-entry (id "game-theory/mechanism/*tie-break-strategy*") (skill game-theory) (module mechanism) (tier 1) (difficulty 13200) (name *tie-break-strategy*) (type "") (description "") (notes ()) (section tie-breaking) (deps (\x27;prelude \x27;sort)) (available ()) (answer "(define *tie-break-strategy* (make-parameter 'first))"))
(task-entry (id "game-theory/evolutionary/make-symmetric-game") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13200) (name make-symmetric-game) (type "(-> (List Symbol) (List (List Number)) SymmetricGame)") (description "") (notes ()) (section symmetric-games) (deps (\x27;normal-form)) (available ()) (answer "(define (make-symmetric-game strategies payoff-matrix) (list 'symmetric-game (list->vector strategies) (list->vector (map list->vector payoff-matrix))))"))
(task-entry (id "game-theory/mcdm/make-decision-problem") (skill game-theory) (module mcdm) (tier 1) (difficulty 13200) (name make-decision-problem) (type "(-> (List Alternative) (List Criterion) (List (Triple Alternative Criterion Real)) DecisionProblem)") (description "Create a multi-criteria decision problem. Alternatives are the options to rank. Criteria are the evaluation dimensions. Scores maps (alternative, criterion) pairs to numeric values. Higher scores are better by default") (notes ("Scores list format: ((alt1 crit1 val1) (alt1 crit2 val2) ...). Missing scores default to 0")) (section decision-problem) (deps (\x27;voting)) (available ()) (answer "(define (make-decision-problem alternatives criteria scores) (when (not (= (length alternatives) (length (list->set alternatives)))) (error 'make-decision-problem \"Alternatives must be unique\")) (when (not (= (length criteria) (length (list->set criteria)))) (error 'make-decision-problem \"Criteria must be unique\")) (list 'decision-problem alternatives criteria scores))"))
(task-entry (id "game-theory/normal-form/game-num-strategies") (skill game-theory) (module normal-form) (tier 1) (difficulty 13201) (name game-num-strategies) (type "(-> Game Nat Nat)") (description "Get number of strategies for player (0 or 1)") (notes ()) (section game-representation) (deps (\x27;prelude)) (available (make-game)) (answer "(define (game-num-strategies game player) (if (= player 0) (vector-length (game%-strategies1 game)) (vector-length (game%-strategies2 game))))"))
(task-entry (id "game-theory/extensive-form/terminal?") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13201) (name terminal?) (type "(-> Node Bool)") (description "") (notes ()) (section node-types) (deps (\x27;prelude)) (available (make-terminal)) (answer "(define (terminal? node) (and (pair? node) (eq? (car node) 'terminal)))"))
(task-entry (id "game-theory/coop-games/coalition-singleton") (skill game-theory) (module coop-games) (tier 1) (difficulty 13201) (name coalition-singleton) (type "(-> Nat Coalition)") (description "Coalition containing only player i") (notes ()) (section coalition-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty)) (answer "(define (coalition-singleton i) (bitwise-arithmetic-shift-left 1 i))"))
(task-entry (id "game-theory/matching/make-pref-table") (skill game-theory) (module matching) (tier 1) (difficulty 13201) (name make-pref-table) (type "") (description "") (notes ()) (section matching-market-data-structures) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market)) (answer "(define (make-pref-table pref-list) (let ((table '())) (for-each (lambda (entry) (let ((id (car entry)) (prefs (cdr entry))) (set! table (cons (cons id prefs) table)))) pref-list) table))"))
(task-entry (id "game-theory/voting/profile-voters") (skill game-theory) (module voting) (tier 1) (difficulty 13201) (name profile-voters) (type "") (description "") (notes ()) (section preference-profiles) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile)) (answer "(define (profile-voters profile) (length profile))"))
(task-entry (id "game-theory/strategic-voting/social-welfare") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13201) (name social-welfare) (type "(-> Candidate PreferenceProfile Number)") (description "Utilitarian social welfare: sum of all voters' utilities for winner") (notes ()) (section utilities) (deps (\x27;prelude \x27;voting)) (available (voter-utility)) (answer "(define (social-welfare winner true-profile) (apply + (map (lambda (ranking) (voter-utility winner ranking)) true-profile)))"))
(task-entry (id "game-theory/voting-games/profile->weighted-voting-game") (skill game-theory) (module voting-games) (tier 1) (difficulty 13201) (name profile->weighted-voting-game) (type "") (description "") (notes ()) (section profile-conversion) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game)) (answer "(define (profile->weighted-voting-game profile weights) (let ((n (profile-voters profile))) (if (not (= n (length weights))) (error 'profile->weighted-voting-game \"weights length must match number of voters\") (let* ((total (apply + weights)) (quota (+ (floor (/ total 2)) 1))) (make-weighted-voting-game weights quota)))))"))
(task-entry (id "game-theory/multi-winner/hare-quota") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13201) (name hare-quota) (type "") (description "") (notes ()) (section quotas) (deps (\x27;voting)) (available (droop-quota)) (answer "(define (hare-quota num-voters num-seats) (floor (/ num-voters num-seats)))"))
(task-entry (id "game-theory/fair-division/cake?") (skill game-theory) (module fair-division) (tier 1) (difficulty 13201) (name cake?) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake)) (answer "(define (cake? x) (cake%? x))"))
(task-entry (id "game-theory/mechanism/select-winner") (skill game-theory) (module mechanism) (tier 1) (difficulty 13201) (name select-winner) (type "(-> (List Nat) (U Nat False))") (description "Select a single winner from list of tied winners using current tie-break strategy") (notes ()) (section tie-breaking) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy*)) (answer "(define (select-winner winners) (if (null? winners) #f (let ((strategy (*tie-break-strategy*))) (cond ((eq? strategy 'first) (car winners)) ((eq? strategy 'last) (car (reverse winners))) ((eq? strategy 'random) (list-ref winners (random (length winners)))) ((procedure? strategy) (let ((result (strategy winners))) (if (memv result winners) result (error 'select-winner \"custom tie-break strategy returned invalid winner\" result winners)))) (else (error 'select-winner \"invalid tie-break strategy (expected 'first, 'last, 'random, or procedure)\" strategy))))))"))
(task-entry (id "game-theory/evolutionary/symmetric-game?") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13201) (name symmetric-game?) (type "") (description "") (notes ()) (section symmetric-games) (deps (\x27;normal-form)) (available (make-symmetric-game)) (answer "(define (symmetric-game? x) (and (pair? x) (eq? (car x) 'symmetric-game)))"))
(task-entry (id "game-theory/mcdm/decision-problem?") (skill game-theory) (module mcdm) (tier 1) (difficulty 13201) (name decision-problem?) (type "") (description "") (notes ()) (section decision-problem) (deps (\x27;voting)) (available (make-decision-problem)) (answer "(define (decision-problem? x) (and (pair? x) (eq? 'decision-problem (car x))))"))
(task-entry (id "game-theory/normal-form/game-payoff") (skill game-theory) (module normal-form) (tier 1) (difficulty 13202) (name game-payoff) (type "(-> Game Nat Nat (Pair Number Number))") (description "Get payoff pair for strategy profile (i, j)") (notes ()) (section game-representation) (deps (\x27;prelude)) (available (make-game game-num-strategies)) (answer "(define (game-payoff game i j) (vector-ref (vector-ref (game%-payoffs game) i) j))"))
(task-entry (id "game-theory/extensive-form/terminal-payoffs") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13202) (name terminal-payoffs) (type "(-> TerminalNode (List Number))") (description "") (notes ()) (section node-types) (deps (\x27;prelude)) (available (make-terminal terminal?)) (answer "(define (terminal-payoffs node) (cadr node))"))
(task-entry (id "game-theory/coop-games/coalition-member?") (skill game-theory) (module coop-games) (tier 1) (difficulty 13202) (name coalition-member?) (type "(-> Nat Coalition Boolean)") (description "Is player i in coalition S?") (notes ()) (section coalition-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton)) (answer "(define (coalition-member? i S) (= 1 (bitwise-and 1 (bitwise-arithmetic-shift-right S i))))"))
(task-entry (id "game-theory/matching/pref-lookup") (skill game-theory) (module matching) (tier 1) (difficulty 13202) (name pref-lookup) (type "") (description "") (notes ()) (section matching-market-data-structures) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table)) (answer "(define (pref-lookup table id) (let ((entry (assoc id table))) (if entry (cdr entry) '())))"))
(task-entry (id "game-theory/voting/profile-candidates") (skill game-theory) (module voting) (tier 1) (difficulty 13202) (name profile-candidates) (type "") (description "") (notes ()) (section preference-profiles) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters)) (answer "(define (profile-candidates profile) (if (null? profile) '() (car profile)))"))
(task-entry (id "game-theory/strategic-voting/find-best-responses") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13202) (name find-best-responses) (type "(-> Nat PreferenceProfile VotingRule Ranking (List Ranking))") (description "Find all ballots that maximize voter's utility given current profile") (notes ()) (section best-response) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare)) (answer "(define (find-best-responses voter-idx current-profile voting-rule true-ranking) (let* ((candidates (profile-candidates current-profile)) (all-ballots (permutations candidates)) (ballot-utilities (map (lambda (ballot) (let* ((new-profile (list-set current-profile voter-idx ballot)) (winner (voting-rule new-profile)) (utility (voter-utility winner true-ranking))) (cons ballot utility))) all-ballots)) (max-utility (apply max (map cdr ballot-utilities)))) (map car (filter (lambda (bu) (= (cdr bu) max-utility)) ballot-utilities))))"))
(task-entry (id "game-theory/voting-games/profile->rule-induced-game") (skill game-theory) (module voting-games) (tier 1) (difficulty 13202) (name profile->rule-induced-game) (type "") (description "") (notes ()) (section profile-conversion) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game)) (answer "(define (profile->rule-induced-game profile voting-rule) (let* ((n (profile-voters profile)) (candidates (profile-candidates profile))) (make-coop-game n (lambda (S) (if (= S 0) 0 (let ((s-members (coalition->list S))) (if (coalition-can-elect-any? profile voting-rule s-members candidates) 1 0)))))))"))
(task-entry (id "game-theory/multi-winner/make-weighted-ballot") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13202) (name make-weighted-ballot) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota)) (answer "(define (make-weighted-ballot ranking) (cons 1 ranking))"))
(task-entry (id "game-theory/fair-division/cake-players") (skill game-theory) (module fair-division) (tier 1) (difficulty 13202) (name cake-players) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake?)) (answer "(define (cake-players c) (cake%-n c))"))
(task-entry (id "game-theory/mechanism/with-tie-break") (skill game-theory) (module mechanism) (tier 1) (difficulty 13202) (name with-tie-break) (type "(-> (U Symbol (-> (List Nat) Nat)) (-> a) a)") (description "Run thunk with the given tie-break strategy") (notes ("(with-tie-break 'random (lambda () (first-price-auction bids)))")) (section tie-breaking) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner)) (answer "(define (with-tie-break strategy thunk) (parameterize ((*tie-break-strategy* strategy)) (thunk)))"))
(task-entry (id "game-theory/evolutionary/sg-strategies") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13202) (name sg-strategies) (type "") (description "") (notes ()) (section symmetric-games) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game?)) (answer "(define (sg-strategies game) (cadr game))"))
(task-entry (id "game-theory/mcdm/dp-alternatives") (skill game-theory) (module mcdm) (tier 1) (difficulty 13202) (name dp-alternatives) (type "") (description "") (notes ()) (section decision-problem) (deps (\x27;voting)) (available (make-decision-problem decision-problem?)) (answer "(define (dp-alternatives dp) (list-ref dp 1))"))
(task-entry (id "game-theory/normal-form/game-payoff-p1") (skill game-theory) (module normal-form) (tier 1) (difficulty 13203) (name game-payoff-p1) (type "(-> Game Nat Nat Number)") (description "Get Player 1's payoff for strategy profile (i, j)") (notes ()) (section game-representation) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff)) (answer "(define (game-payoff-p1 game i j) (car (game-payoff game i j)))"))
(task-entry (id "game-theory/extensive-form/terminal-payoff") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13203) (name terminal-payoff) (type "(-> TerminalNode Nat Number)") (description "") (notes ()) (section node-types) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs)) (answer "(define (terminal-payoff node player) (list-ref (terminal-payoffs node) player))"))
(task-entry (id "game-theory/coop-games/coalition-union") (skill game-theory) (module coop-games) (tier 1) (difficulty 13203) (name coalition-union) (type "(-> Coalition Coalition Coalition)") (description "Union of two coalitions") (notes ()) (section coalition-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member?)) (answer "(define (coalition-union S T) (bitwise-ior S T))"))
(task-entry (id "game-theory/matching/matching-market?") (skill game-theory) (module matching) (tier 1) (difficulty 13203) (name matching-market?) (type "") (description "") (notes ()) (section matching-market-data-structures) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup)) (answer "(define (matching-market? x) (matching-market%? x))"))
(task-entry (id "game-theory/voting/profile-num-candidates") (skill game-theory) (module voting) (tier 1) (difficulty 13203) (name profile-num-candidates) (type "") (description "") (notes ()) (section preference-profiles) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates)) (answer "(define (profile-num-candidates profile) (if (null? profile) 0 (length (car profile))))"))
(task-entry (id "game-theory/strategic-voting/best-response-improves?") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13203) (name best-response-improves?) (type "(-> Nat PreferenceProfile VotingRule Ranking Bool)") (description "") (notes ()) (section best-response) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses)) (answer "(define (best-response-improves? voter-idx current-profile voting-rule true-ranking) (let* ((current-winner (voting-rule current-profile)) (current-utility (voter-utility current-winner true-ranking)) (best-responses (find-best-responses voter-idx current-profile voting-rule true-ranking)) (best-utility (voter-utility (voting-rule (list-set current-profile voter-idx (car best-responses))) true-ranking))) (> best-utility current-utility)))"))
(task-entry (id "game-theory/voting-games/coalition-can-elect-any?") (skill game-theory) (module voting-games) (tier 1) (difficulty 13203) (name coalition-can-elect-any?) (type "") (description "") (notes ()) (section profile-conversion) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game)) (answer "(define (coalition-can-elect-any? profile voting-rule coalition-members candidates) (for-all? (lambda (target-candidate) (coalition-can-elect-candidate? profile voting-rule coalition-members target-candidate)) candidates))"))
(task-entry (id "game-theory/multi-winner/ballot-weight") (skill game-theory) (module multi-winner) (tier 1) (difficulty 13203) (name ballot-weight) (type "") (description "") (notes ()) (section stv) (deps (\x27;voting)) (available (droop-quota hare-quota make-weighted-ballot)) (answer "(define (ballot-weight b) (car b))"))
(task-entry (id "game-theory/fair-division/cake-set-valuation!") (skill game-theory) (module fair-division) (tier 1) (difficulty 13203) (name cake-set-valuation!) (type "") (description "") (notes ()) (section cake-representation) (deps (\x27;prelude \x27;sort \x27;vec)) (available (make-cake cake? cake-players)) (answer "(define (cake-set-valuation! c i density-fn) (vector-set! (cake%-valuations c) i density-fn))"))
(task-entry (id "game-theory/mechanism/make-bids") (skill game-theory) (module mechanism) (tier 1) (difficulty 13203) (name make-bids) (type "(-> (List Number) (Vector Number))") (description "Create a bid profile from a list of bids") (notes ()) (section bid-representation) (deps (\x27;prelude \x27;sort)) (available (*tie-break-strategy* select-winner with-tie-break)) (answer "(define (make-bids bid-list) (list->vector bid-list))"))
(task-entry (id "game-theory/evolutionary/sg-payoffs") (skill game-theory) (module evolutionary) (tier 1) (difficulty 13203) (name sg-payoffs) (type "") (description "") (notes ()) (section symmetric-games) (deps (\x27;normal-form)) (available (make-symmetric-game symmetric-game? sg-strategies)) (answer "(define (sg-payoffs game) (caddr game))"))
(task-entry (id "game-theory/mcdm/dp-criteria") (skill game-theory) (module mcdm) (tier 1) (difficulty 13203) (name dp-criteria) (type "") (description "") (notes ()) (section decision-problem) (deps (\x27;voting)) (available (make-decision-problem decision-problem? dp-alternatives)) (answer "(define (dp-criteria dp) (list-ref dp 2))"))
(task-entry (id "game-theory/normal-form/game-payoff-p2") (skill game-theory) (module normal-form) (tier 1) (difficulty 13204) (name game-payoff-p2) (type "(-> Game Nat Nat Number)") (description "Get Player 2's payoff for strategy profile (i, j)") (notes ()) (section game-representation) (deps (\x27;prelude)) (available (make-game game-num-strategies game-payoff game-payoff-p1)) (answer "(define (game-payoff-p2 game i j) (cdr (game-payoff game i j)))"))
(task-entry (id "game-theory/extensive-form/make-decision") (skill game-theory) (module extensive-form) (tier 1) (difficulty 13204) (name make-decision) (type "(-> Nat (List Symbol) (List Node) DecisionNode)") (description "Create a decision node where player chooses from actions") (notes ()) (section node-types) (deps (\x27;prelude)) (available (make-terminal terminal? terminal-payoffs terminal-payoff)) (answer "(define (make-decision player actions children) (when (not (= (length actions) (length children))) (error 'make-decision \"actions and children must have same length\" (length actions) (length children))) (list 'decision player actions children))"))
(task-entry (id "game-theory/coop-games/coalition-intersection") (skill game-theory) (module coop-games) (tier 1) (difficulty 13204) (name coalition-intersection) (type "(-> Coalition Coalition Coalition)") (description "Intersection of two coalitions") (notes ()) (section coalition-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-solvers \x27;lp)) (available (coalition-empty coalition-singleton coalition-member? coalition-union)) (answer "(define (coalition-intersection S T) (bitwise-and S T))"))
(task-entry (id "game-theory/matching/market-proposers") (skill game-theory) (module matching) (tier 1) (difficulty 13204) (name market-proposers) (type "") (description "") (notes ()) (section matching-market-data-structures) (deps (\x27;prelude \x27;lp \x27;ilp \x27;coop-games \x27;sort)) (available (make-matching-market make-pref-table pref-lookup matching-market?)) (answer "(define (market-proposers m) (matching-market%-proposers m))"))
(task-entry (id "game-theory/voting/profile-rankings") (skill game-theory) (module voting) (tier 1) (difficulty 13204) (name profile-rankings) (type "") (description "") (notes ()) (section preference-profiles) (deps (\x27;prelude \x27;sort)) (available (make-preference-profile profile-voters profile-candidates profile-num-candidates)) (answer "(define (profile-rankings profile) profile)"))
(task-entry (id "game-theory/strategic-voting/is-strategic-equilibrium?") (skill game-theory) (module strategic-voting) (tier 1) (difficulty 13204) (name is-strategic-equilibrium?) (type "(-> PreferenceProfile PreferenceProfile VotingRule Bool)") (description "Check if no voter can benefit by unilateral deviation. This is O(N! * V) where N = candidates, V = voters") (notes ()) (section nash-equilibrium) (deps (\x27;prelude \x27;voting)) (available (voter-utility social-welfare find-best-responses best-response-improves?)) (answer "(define (is-strategic-equilibrium? reported-profile true-profile voting-rule) (let ((n (length reported-profile))) (let loop ((i 0)) (if (>= i n) #t (if (best-response-improves? i reported-profile voting-rule (list-ref true-profile i)) #f (loop (+ i 1)))))))"))
(task-entry (id "game-theory/voting-games/coalition-can-elect-candidate?") (skill game-theory) (module voting-games) (tier 1) (difficulty 13204) (name coalition-can-elect-candidate?) (type "") (description "") (notes ()) (section profile-conversion) (deps (\x27;voting \x27;coop-games)) (available (profile->majority-game profile->weighted-voting-game profile->rule-induced-game coalition-can-elect-any?)) (answer "(define (coalition-can-elect-candidate? profile voting-rule coalition-members target-candidate) (let* ((candidates (profile-candidates profile)) (others (remove target-candidate candidates)) (strategic-vote (cons target-candidate others)) (modified-profile (let build ((i 0) (rankings profile) (result '())) (if (null? rankings) (reverse result) (let ((ranking (car rankings))) (build (+ i 1) (cdr rankings) (cons (if (member i coalition-members) strategic-vote ranking) result))))))) (eq? target-candidate (voting-rule modified-profile))))"))
