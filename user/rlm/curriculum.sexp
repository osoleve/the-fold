(task-entry (id "physics/diff/diff-constraints/make-chain-system") (skill physics/diff) (module diff-constraints) (tier 2) (difficulty 23138) (name make-chain-system) (type "") (description "") (notes ()) (section spring-constraint) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body)) (available (traced-spring-force traced-spring-force-damped make-spring-constraint spring-constraint-body-a spring-constraint-anchor-a spring-constraint-body-b spring-constraint-anchor-b spring-constraint-rest-length spring-constraint-stiffness spring-constraint-damping *distance-constraint-stiffness* *distance-constraint-damping* make-distance-constraint make-anchor-constraint anchor-constraint-body anchor-constraint-local-anchor anchor-constraint-world-target anchor-constraint-stiffness anchor-constraint-damping traced-anchor-force make-revolute-joint revolute-joint-body-a revolute-joint-anchor-a revolute-joint-body-b revolute-joint-anchor-b revolute-joint-stiffness revolute-joint-damping traced-revolute-forces traced-angular-spring-torque constraint-type traced-apply-spring-constraint traced-apply-anchor-constraint traced-apply-revolute-joint traced-apply-constraint traced-apply-all-constraints traced-constraint-step vector-map make-pendulum-system)) (answer "(define (make-chain-system start-pos num-links link-length mass radius tape) (let* ((inertia (circle-inertia mass radius)) (bodies (list->vector (let loop ((i 0) (y (vec2-y start-pos))) (if (= i num-links) '() (let ((pos (lift-vec2 (vec2 (vec2-x start-pos) y) tape)) (vel (lift-vec2 (vec2-zero) tape)) (angle (make-traced-var 0 tape)) (omega (make-traced-var 0 tape))) (cons (make-traced-body pos vel angle omega mass inertia) (loop (+ i 1) (- y link-length)))))))) (anchor (make-anchor-constraint 0 (lift-vec2-const (vec2-zero)) (lift-vec2-const start-pos) *distance-constraint-stiffness* *distance-constraint-damping*)) (links (let loop ((i 0)) (if (>= i (- num-links 1)) '() (cons (make-distance-constraint i (lift-vec2-const (vec2-zero)) (+ i 1) (lift-vec2-const (vec2-zero)) link-length) (loop (+ i 1))))))) (values bodies (cons anchor links))))"))
