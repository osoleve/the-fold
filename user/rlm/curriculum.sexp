(task-entry (id "linalg/matrix-eigen/power-iteration") (skill linalg) (module matrix-eigen) (tier 0) (difficulty 402) (name power-iteration) (type "") (description "") (notes ()) (section power-iteration) (deps (\x27;prelude \x27;vec \x27;matrix \x27;matrix-decomp)) (available (*eigen-tolerance* *eigen-max-iterations*)) (answer "(define (power-iteration a . opts) (let* ((n (matrix-rows a)) (m (matrix-cols a))) (if (not (= n m)) (quasiquote (error not-square (unquote n) (unquote m))) (let* ((v0 (if (and (pair? opts) (vector? (car opts))) (car opts) (vec-unit n 0))) (rest1 (if (and (pair? opts) (vector? (car opts))) (cdr opts) opts)) (max-iter (if (and (pair? rest1) (integer? (car rest1))) (car rest1) *eigen-max-iterations*)) (rest2 (if (and (pair? rest1) (integer? (car rest1))) (cdr rest1) rest1)) (tol (if (and (pair? rest2) (number? (car rest2))) (car rest2) *eigen-tolerance*))) (power-iteration-loop a v0 0 max-iter tol 0)))))"))
