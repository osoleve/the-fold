(task-entry (id "diffgeo/lie-groups/make-so3-from-matrix") (skill diffgeo) (module lie-groups) (tier 1) (difficulty 10723) (name make-so3-from-matrix) (type "") (description "") (notes ()) (section so2-rotation-group) (deps (\x27;prelude \x27;matrix \x27;vec \x27;matrix-solvers)) (available (*lie-epsilon* *pi* identity-matrix matrix-set! matrix-trace skew-symmetric? so2? so2-matrix make-so2 so2-identity so2-angle so2-compose so2-inverse so2-act so2-alg? so2-alg-omega make-so2-alg so2-alg-to-matrix so2-matrix-to-alg so2-exp so2-log so3? so3-matrix)) (answer "(define (make-so3-from-matrix m) (cond ((not (and (= (matrix-rows m) 3) (= (matrix-cols m) 3))) (quasiquote (error invalid-dimension))) ((let* ((mT (matrix-transpose m)) (prod (matrix-mul m mT)) (I (identity-matrix 3))) (not (matrix-approx-equal? prod I *lie-epsilon*))) (quasiquote (error not-orthogonal))) (else (list 'so3 m))))"))
