(task-entry (id "numeric/digital-filters/fir-bandstop") (skill numeric) (module digital-filters) (tier 0) (difficulty 2510) (name fir-bandstop) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;complex \x27;dft \x27;convolution \x27;vec)) (available (rectangular-window hamming-window hann-window blackman-window kaiser-window bessel-i0 sinc fir-lowpass fir-highpass fir-bandpass)) (answer "(define (fir-bandstop low high order window-fn) (let* ((bp (fir-bandpass low high order window-fn)) (n (vector-length bp)) (half (quotient n 2)) (result (make-vector n))) (do ((i 0 (+ i 1))) ((= i n) result) (let ((val (- (vector-ref bp i)))) (vector-set! result i (if (= i half) (+ 1 val) val))))))"))
