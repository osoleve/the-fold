(task-entry (id "data/graph-matrix/path-graph") (skill data) (module graph-matrix) (tier 0) (difficulty 1329) (name path-graph) (type "") (description "") (notes ()) (section edge-list-representation) (deps (\x27;prelude \x27;vec \x27;matrix \x27;sparse \x27;heap)) (available (edge-list? edge-weighted? edge-from edge-to edge-weight infer-node-count *dense-adjacency-max-nodes* edges->adjacency-matrix adjacency-matrix->edges make-adjacency-matrix adjacency-matrix-add-edge! adjacency-matrix-remove-edge! adjacency-matrix-has-edge? adjacency-matrix-edge-weight edges->sparse-adjacency sparse-adjacency->edges adjacency-matrix-node-count adjacency-matrix-edge-count adjacency-out-degree adjacency-in-degree adjacency-neighbors adjacency-neighbors-with-weights adjacency-transpose adjacency-symmetrize adjacency-symmetrize-sparse degree-matrix degree-matrix-sparse complete-graph cycle-graph)) (answer "(define (path-graph n . opts) (let ((directed (if (null? opts) #f (car opts))) (data (make-vector (* n n) 0))) (do ((i 0 (+ i 1))) ((= i (- n 1)) (list 'matrix n n data)) (vector-set! data (+ (* i n) (+ i 1)) 1) (unless directed (vector-set! data (+ (* (+ i 1) n) i) 1)))))"))
(task-entry (id "data/graph-layout/layout-step") (skill data) (module graph-layout) (tier 0) (difficulty 1329) (name layout-step) (type "") (description "") (notes ()) (section iteration) (deps (\x27;prelude \x27;vec \x27;optics)) (available (make-graph-node node-id node-pos node-vel node-x node-y node-set-pos node-set-vel node-pos-lens node-vel-lens node-x-lens node-y-lens make-layout-graph graph-nodes graph-edges graph-set-nodes graph-find-node graph-nodes-lens graph-nodes-each graph-all-positions graph-all-velocities *repulsion-constant* *attraction-constant* *gravity-constant* *damping* *min-distance* *max-displacement* calculate-repulsion calculate-attraction)) (answer "(define (layout-step graph) (let* ((nodes (graph-nodes graph)) (edges (graph-edges graph)) (n (length nodes)) (nodes-vec (list->vector nodes)) (id-map (make-eq-hashtable)) (_ (let build-map ((ns nodes) (i 0)) (when (pair? ns) (hashtable-set! id-map (node-id (car ns)) i) (build-map (cdr ns) (+ i 1))))) (forces (make-vector n (vector 0.0 0.0)))) (let loop-i ((i 0) (nodes-i nodes)) (when (< i n) (let loop-j ((j (+ i 1)) (nodes-j (cdr nodes-i))) (when (< j n) (let* ((node-i (car nodes-i)) (node-j (car nodes-j)) (force (calculate-repulsion node-i node-j))) (vector-set! forces i (vec-add (vector-ref forces i) force)) (vector-set! forces j (vec-sub (vector-ref forces j) force)) (loop-j (+ j 1) (cdr nodes-j))))) (loop-i (+ i 1) (cdr nodes-i)))) (for-each (lambda (edge) (let* ((id1 (car edge)) (id2 (cdr edge)) (idx1 (hashtable-ref id-map id1 #f)) (idx2 (hashtable-ref id-map id2 #f))) (when (and idx1 idx2) (let* ((node1 (vector-ref nodes-vec idx1)) (node2 (vector-ref nodes-vec idx2)) (force (calculate-attraction node1 node2))) (vector-set! forces idx1 (vec-add (vector-ref forces idx1) force)) (vector-set! forces idx2 (vec-sub (vector-ref forces idx2) force)))))) edges) (let apply-gravity ((i 0) (ns nodes)) (when (pair? ns) (let* ((pos (node-pos (car ns))) (gravity (vec-scale (- *gravity-constant*) pos))) (vector-set! forces i (vec-add (vector-ref forces i) gravity))) (apply-gravity (+ i 1) (cdr ns)))) (graph-set-nodes graph (let loop ((i 0) (ns nodes) (result '())) (if (null? ns) (reverse result) (let* ((node (car ns)) (force (vector-ref forces i)) (vel (vec-scale *damping* (vec-add (node-vel node) force))) (vel-mag (vec-norm vel)) (vel-clamped (if (> vel-mag *max-displacement*) (vec-scale (/ *max-displacement* vel-mag) vel) vel)) (new-pos (vec-add (node-pos node) vel-clamped)) (new-node (node-set-pos (node-set-vel node vel-clamped) new-pos))) (loop (+ i 1) (cdr ns) (cons new-node result))))))))"))
(task-entry (id "data/kdtree/kdtree-fold") (skill data) (module kdtree) (tier 0) (difficulty 1329) (name kdtree-fold) (type "(-> (-> a Point a) a KDTree a)") (description "Left fold over all points in tree. (proc acc point) called for each point.\nIn-order traversal (left subtree, node, right subtree). O(n).\nSignature matches fold-left convention: accumulator first.") (notes ()) (section statistics) (deps (\x27;prelude \x27;sort \x27;heap)) (available (kdtree-empty kdtree-empty? kdtree-node kdtree-node? kdtree-point kdtree-left kdtree-right kdtree-depth point-dimension point-coord point-distance-sq point-distance kdtree-build list->kdtree kdtree-build-rec sort-by-axis kdtree-nearest kdtree-nearest-rec knn-pair-greater? kdtree-knn knn-heap->list kdtree-knn-rec kdtree-range kdtree-range-rec point-in-box? kdtree-radius kdtree-size kdtree-height kdtree-balanced?)) (answer "(define (kdtree-fold proc init tree) (if (kdtree-empty? tree) init (kdtree-fold proc (proc (kdtree-fold proc init (kdtree-left tree)) (kdtree-point tree)) (kdtree-right tree))))"))
(task-entry (id "data/quadtree/quadtree-split") (skill data) (module quadtree) (tier 0) (difficulty 1329) (name quadtree-split) (type "(-> Quadtree Nat Quadtree)") (description "Split a leaf node into 4 children. Depth parameter ensures\ncorrect depth tracking when re-inserting existing points into child nodes.") (notes ()) (section insertion) (deps (\x27;prelude \x27;sort \x27;heap)) (available (make-bounds bounds? bounds-cx bounds-cy bounds-hw bounds-hh bounds-contains? bounds-intersects? quadtree-empty quadtree-empty? quadtree-leaf quadtree-leaf? quadtree-leaf-bounds quadtree-leaf-points quadtree-node quadtree-node? quadtree-bounds quadtree-ne quadtree-nw quadtree-se quadtree-sw *quadtree-capacity* *quadtree-max-depth* quadtree-create quadtree-build quadtree-build-auto list->quadtree quadtree-insert quadtree-insert-at-depth)) (answer "(define (quadtree-split leaf depth) (let* ((bounds (quadtree-leaf-bounds leaf)) (points (quadtree-leaf-points leaf)) (cx (bounds-cx bounds)) (cy (bounds-cy bounds)) (hw (/ (bounds-hw bounds) 2)) (hh (/ (bounds-hh bounds) 2)) (ne-bounds (make-bounds (+ cx hw) (+ cy hh) hw hh)) (nw-bounds (make-bounds (- cx hw) (+ cy hh) hw hh)) (se-bounds (make-bounds (+ cx hw) (- cy hh) hw hh)) (sw-bounds (make-bounds (- cx hw) (- cy hh) hw hh)) (ne (quadtree-leaf ne-bounds '())) (nw (quadtree-leaf nw-bounds '())) (se (quadtree-leaf se-bounds '())) (sw (quadtree-leaf sw-bounds '())) (node (quadtree-node bounds ne nw se sw)) (child-depth (+ depth 1))) (fold-left (lambda (tree pt) (quadtree-insert-at-depth tree (car pt) (cadr pt) (caddr pt) child-depth)) node points)))"))
