(task-entry (id "egraph/extract/make-extraction-state") (skill egraph) (module extract) (tier 1) (difficulty 10001) (name make-extraction-state) (type "(-> EGraph CostModel ExtractionState)") (description "Create extraction state with precomputed best nodes.") (notes ()) (section state) (deps (\x27;prelude \x27;egraph/cost \x27;egraph/saturation)) (available (extraction-state-tag)) (answer "(define (make-extraction-state eg cost-model) (let ((costs (compute-costs eg cost-model)) (best-nodes (make-hashtable equal-hash equal?)) (uf (egraph-uf eg)) (store (egraph-classes eg)) (node-cost-fn (cost-model-fn cost-model))) (for-each (lambda (root) (let ((best-node #f) (best-cost +inf.0)) (for-each (lambda (node) (let ((c (compute-node-cost node costs node-cost-fn))) (when (< c best-cost) (set! best-cost c) (set! best-node node)))) (eclass-get-nodes store root)) (when best-node (hashtable-set! best-nodes root best-node)))) (uf-roots uf)) (vector extraction-state-tag eg costs best-nodes)))"))
