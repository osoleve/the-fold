(task-entry (id "data/heap/heap-delete-top-by") (skill data) (module heap) (tier 0) (difficulty 1322) (name heap-delete-top-by) (type "(-> (-> α α Boolean) Heap Heap)") (description "Remove top element using custom comparator.") (notes ()) (section generic-heap-operations) (deps (\x27;prelude)) (available (heap-empty heap-empty? heap-node heap-node? heap-rank heap-value heap-left heap-right make-heap-node heap-merge heap-insert heap-min heap-peek heap-delete-min heap-pop heap-merge-max heap-insert-max heap-max heap-delete-max heap-pop-max heap-merge-by heap-insert-by)) (answer "(define (heap-delete-top-by cmp heap) (if (heap-empty? heap) (error 'heap-delete-top-by \"Cannot delete from empty heap\") (heap-merge-by cmp (heap-left heap) (heap-right heap))))"))
(task-entry (id "data/graph-primitives/cycle-in-list?") (skill data) (module graph-primitives) (tier 0) (difficulty 1322) (name cycle-in-list?) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;sort \x27;collection-utils)) (available (bytevector-hash make-visited visited-add visited-contains? visited-remove make-queue queue-empty? queue-normalize queue-enqueue queue-enqueue-all queue-dequeue make-stack stack-empty? stack-push stack-push-all stack-pop hash-equal? hash-in-list? remove-hash unique-hashes path-length unique-cycles)) (answer "(define (cycle-in-list? cycle cycles) (let ((cycle-set (cdr cycle))) (let loop ((cs cycles)) (if (null? cs) #f (let ((other-set (cdr (car cs)))) (if (same-hash-set? cycle-set other-set) #t (loop (cdr cs))))))))"))
