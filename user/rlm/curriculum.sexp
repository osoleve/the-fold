(task-entry (id "algebra/polynomial/poly-neg") (skill algebra) (module polynomial) (tier 0) (difficulty 316) (name poly-neg) (type "") (description "") (notes ()) (section polynomial-representation) (deps (\x27;prelude \x27;field)) (available (make-polynomial polynomial? poly-field poly-coeffs poly-degree poly-leading-coeff poly-coeff-at poly-normalize-coeffs poly-zero? poly-zero-over poly-one-over poly-constant poly-monomial poly-x poly-add poly-add-coeffs)) (answer "(define (poly-neg p) (let* ((F (poly-field p)) (neg (field-neg-fn F))) (make-polynomial F (map neg (poly-coeffs p)))))"))
