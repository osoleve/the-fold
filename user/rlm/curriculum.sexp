(task-entry (id "fp/expr/expr=?") (skill fp) (module expr) (tier 1) (difficulty 10635) (name expr=?) (type "") (description "") (notes ()) (section predicates) (deps (\x27;prelude)) (available (num var make-sum make-product make-diff make-neg make-div make-pow make-app sum product difference division power num? var? sum? product? difference? quotient? power? app? num-val var-name sum-terms product-factors diff-left diff-right quot-numer quot-denom pow-base pow-exp app-fn app-arg list-all-equal?)) (answer "(define (expr=? e1 e2) (cond ((and (num? e1) (num? e2)) (= (num-val e1) (num-val e2))) ((and (var? e1) (var? e2)) (eq? (var-name e1) (var-name e2))) ((and (sum? e1) (sum? e2)) (and (= (length e1) (length e2)) (list-all-equal? (cdr e1) (cdr e2)))) ((and (product? e1) (product? e2)) (and (= (length e1) (length e2)) (list-all-equal? (cdr e1) (cdr e2)))) ((and (difference? e1) (difference? e2)) (and (= (length e1) (length e2)) (list-all-equal? (cdr e1) (cdr e2)))) ((and (quotient? e1) (quotient? e2)) (and (expr=? (quot-numer e1) (quot-numer e2)) (expr=? (quot-denom e1) (quot-denom e2)))) ((and (power? e1) (power? e2)) (and (expr=? (pow-base e1) (pow-base e2)) (expr=? (pow-exp e1) (pow-exp e2)))) ((and (app? e1) (app? e2)) (and (eq? (app-fn e1) (app-fn e2)) (expr=? (app-arg e1) (app-arg e2)))) (else #f)))"))
(task-entry (id "fp/simplify/simplify-double-angle-product") (skill fp) (module simplify) (tier 1) (difficulty 10635) (name simplify-double-angle-product) (type "(-> (List Expr) Expr)") (description "Apply double angle identity: 2*sin(x)*cos(x) = sin(2x)") (notes ()) (section trigonometric-identities) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow simplify-app expand expand-once expand-product expand-power-of-sum factor factor-sum find-common-factor get-factors divides? divide-out simplify-trig simplify-trig-once simplify-pythagorean-identity find-sin-squared find-matching-cos-squared)) (answer "(define (simplify-double-angle-product factors) (let ((has-two (exists (lambda (f) (and (num? f) (= (num-val f) 2))) factors)) (sin-term (find (lambda (f) (and (app? f) (eq? (app-fn f) 'sin))) factors)) (cos-term (find (lambda (f) (and (app? f) (eq? (app-fn f) 'cos))) factors))) (if (and has-two sin-term cos-term (expr=? (app-arg sin-term) (app-arg cos-term))) (let ((other-factors (filter (lambda (f) (and (not (and (num? f) (= (num-val f) 2))) (not (eq? f sin-term)) (not (eq? f cos-term)))) factors))) (if (null? other-factors) (make-app 'sin (product (num 2) (app-arg sin-term))) (make-product-from-list (cons (make-app 'sin (product (num 2) (app-arg sin-term))) other-factors)))) (make-product-from-list factors))))"))
