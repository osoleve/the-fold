(task-entry (id "fp/diff/deriv-fn") (skill fp) (module diff) (tier 1) (difficulty 10603) (name deriv-fn) (type "(-> Symbol Expr Expr)") (description "Compute derivative of named function, returns derivative evaluated at argument") (notes ()) (section basic-differentiation) (deps (\x27;expr)) (available (fold-sum fold-product deriv)) (answer "(define (deriv-fn fn arg) (case fn ((sin) (sym-cos arg)) ((cos) (make-neg (sym-sin arg))) ((tan) (division (num 1) (power (sym-cos arg) (num 2)))) ((exp) (sym-exp arg)) ((log) (division (num 1) arg)) ((sqrt) (division (num 1) (product (num 2) (sym-sqrt arg)))) ((asin) (division (num 1) (sym-sqrt (difference (num 1) (power arg (num 2)))))) ((acos) (make-neg (division (num 1) (sym-sqrt (difference (num 1) (power arg (num 2))))))) ((atan) (division (num 1) (sum (num 1) (power arg (num 2))))) ((sinh) (make-app 'cosh arg)) ((cosh) (make-app 'sinh arg)) ((tanh) (division (num 1) (power (make-app 'cosh arg) (num 2)))) (else (make-app 'D (make-app fn arg)))))"))
(task-entry (id "fp/simplify/simplify-sum") (skill fp) (module simplify) (tier 1) (difficulty 10603) (name simplify-sum) (type "(-> (List Expr) Expr)") (description "Simplify sum by collecting numeric terms and like terms") (notes ()) (section sum-simplification) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once)) (answer "(define (simplify-sum terms) (let* ((flat-terms (flatten-sums terms)) (numeric-sum (apply + (filter-map get-numeric flat-terms))) (non-numeric (filter (lambda (e) (not (num? e))) flat-terms)) (collected (collect-like-terms non-numeric))) (cond ((and (null? collected) (= numeric-sum 0)) (num 0)) ((null? collected) (num numeric-sum)) ((= numeric-sum 0) (make-sum-from-list collected)) (else (make-sum-from-list (cons (num numeric-sum) collected))))))"))
(task-entry (id "fp/integrate/is-arcsin-integrand?") (skill fp) (module integrate) (tier 1) (difficulty 10603) (name is-arcsin-integrand?) (type "") (description "") (notes ()) (section integration-table) (deps (\x27;diff \x27;simplify)) (available (integrate integrate-internal integrate-table)) (answer "(define (is-arcsin-integrand? expr var-sym) (and (quotient? expr) (num? (quot-numer expr)) (= (num-val (quot-numer expr)) 1) (app? (quot-denom expr)) (eq? (app-fn (quot-denom expr)) 'sqrt) (let ((inner (app-arg (quot-denom expr)))) (and (difference? inner) (num? (diff-left inner)) (= (num-val (diff-left inner)) 1) (power? (diff-right inner)) (var? (pow-base (diff-right inner))) (eq? (var-name (pow-base (diff-right inner))) var-sym) (num? (pow-exp (diff-right inner))) (= (num-val (pow-exp (diff-right inner))) 2)))))"))
