(task-entry (id "fp/simplify/simplify-trig-once") (skill fp) (module simplify) (tier 1) (difficulty 10631) (name simplify-trig-once) (type "(-> Expr Expr)") (description "Single pass of trigonometric simplification") (notes ()) (section trigonometric-identities) (deps (\x27;sort \x27;expr)) (available (get-numeric simplify simplify-once simplify-sum flatten-sums collect-like-terms extract-coefficient make-sum-from-list simplify-product flatten-products collect-like-bases extract-base-exponent make-product-from-list simplify-diff simplify-neg simplify-quot cancel-common-factors find-and-remove simplify-pow simplify-app expand expand-once expand-product expand-power-of-sum factor factor-sum find-common-factor get-factors divides? divide-out simplify-trig)) (answer "(define (simplify-trig-once expr) (cond ((num? expr) expr) ((var? expr) expr) ((sum? expr) (let ((terms (map simplify-trig-once (sum-terms expr)))) (simplify-pythagorean-identity terms))) ((product? expr) (let ((factors (map simplify-trig-once (product-factors expr)))) (simplify-double-angle-product factors))) ((difference? expr) (if (diff-right expr) (let ((left (simplify-trig-once (diff-left expr))) (right (simplify-trig-once (diff-right expr)))) (if (and (power? left) (power? right) (app? (pow-base left)) (app? (pow-base right)) (num? (pow-exp left)) (= (num-val (pow-exp left)) 2) (num? (pow-exp right)) (= (num-val (pow-exp right)) 2) (eq? (app-fn (pow-base left)) 'cos) (eq? (app-fn (pow-base right)) 'sin) (expr=? (app-arg (pow-base left)) (app-arg (pow-base right)))) (make-app 'cos (product (num 2) (app-arg (pow-base left)))) (difference left right))) (make-neg (simplify-trig-once (diff-left expr))))) ((power? expr) (power (simplify-trig-once (pow-base expr)) (simplify-trig-once (pow-exp expr)))) ((quotient? expr) (let ((numer (simplify-trig-once (quot-numer expr))) (denom (simplify-trig-once (quot-denom expr)))) (if (and (app? numer) (app? denom) (eq? (app-fn numer) 'sin) (eq? (app-fn denom) 'cos) (exp