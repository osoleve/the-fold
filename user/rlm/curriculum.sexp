(task-entry (id "geometry/obj-loader/parse-face") (skill geometry) (module obj-loader) (tier 1) (difficulty 12202) (name parse-face) (type "(-> (List String) (List Number))") (description "Handles v, v/vt, v/vt/vn, v//vn formats") (notes ()) (section obj-parsing) (deps (\x27;prelude \x27;geometry)) (available (parse-obj-line parse-vertex)) (answer "(define (parse-face parts) (map (lambda (part) (let ((idx-str (car (string-split part #\\/)))) (string->number idx-str))) (filter (lambda (s) (> (string-length s) 0)) parts)))"))
(task-entry (id "geometry/ascii-render/intensity->char") (skill geometry) (module ascii-render) (tier 1) (difficulty 12202) (name intensity->char) (type "(-> Number Char)") (description "Map intensity [0,1] to ASCII character") (notes ()) (section ascii-character-ramp) (deps (\x27;prelude \x27;geometry \x27;mesh-sdf)) (available (ascii-ramp ascii-ramp-len)) (answer "(define (intensity->char intensity) (let ((idx (min (- ascii-ramp-len 1) (max 0 (inexact->exact (floor (* intensity ascii-ramp-len))))))) (string-ref ascii-ramp idx)))"))
