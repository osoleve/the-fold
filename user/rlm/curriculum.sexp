(task-entry (id "physics/classical/particles/particle-system-step") (skill physics/classical) (module particles) (tier 2) (difficulty 23553) (name particle-system-step) (type "") (description "") (notes ()) (section particle) (deps (\x27;prelude \x27;sort \x27;vec2 \x27;prng)) (available (make-particle particle? particle-pos particle-vel particle-lifetime particle-max-life particle-size particle-color particle-user-data particle-alive? particle-age particle-with-pos particle-with-vel particle-with-state gravity-field wind-field drag-field attractor-field vortex-field turbulence-field combine-fields integrate-particle update-particle update-particles make-emitter emitter? emitter-pos emitter-rate emitter-spread emitter-direction emitter-speed-min emitter-speed-max emitter-lifetime-min emitter-lifetime-max emitter-size-min emitter-size-max emitter-color emitter-user-data emitter-accumulator emitter-with-pos emitter-with-direction emitter-with-accumulator spawn-particle emitter-emit make-particle-system particle-system? particle-system-emitters particle-system-particles particle-system-forces particle-system-count particle-system-add-emitter particle-system-add-force particle-system-add-particles)) (answer "(define (particle-system-step ps dt rng) (let* ((forces (particle-system-forces ps)) (updated-particles (update-particles (particle-system-particles ps) forces dt)) (emit-result (fold-left (lambda (acc e) (let* ((particles-so-far (car acc)) (emitters-so-far (cadr acc)) (current-rng (caddr acc)) (result (emitter-emit e dt current-rng)) (new-particles (car result)) (new-emitter (cadr result)) (new-rng (caddr result))) (list (append new-particles particles-so-far) (cons new-emitter emitters-so-far) new-rng))) (list '() '() rng) (particle-system-emitters ps))) (emitted (car emit-result)) (new-emitters (reverse (cadr emit-result))) (new-rng (caddr emit-result)) (all-particles (append emitted updated-particles)) (new-system (make-particle-system new-emitters all-particles forces))) (cons new-system new-rng)))"))
