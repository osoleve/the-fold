(task-entry (id "physics/classical/world/apply-force!") (skill physics/classical) (module world) (tier 2) (difficulty 23560) (name apply-force!) (type "") (description "") (notes ()) (section entity) (deps (\x27;prelude \x27;vec2 \x27;integrators \x27;collision-detection \x27;collision-response \x27;raycasting \x27;constraints \x27;constraint-solver \x27;sort)) (available (make-entity entity? entity-id entity-body entity-shape entity-material entity-user-data entity-with-body entity-pos entity-vel entity-static? transform-shape entity-world-shape make-world-config config-fixed-dt config-max-substeps config-solver-iterations config-cell-size make-world world? world-entities world-gravity world-spatial-hash world-config world-time-acc world-constraints world-with-time-acc world-add-entity! world-remove-entity! world-get-entity world-entity-list world-update-entity! world-add-constraint! world-remove-constraint! world-get-constraint world-constraint-list world-update-constraint! make-force-acc force-acc-add! force-acc-get force-acc-clear! world-step! world-fixed-step! world-resolve-collision-velocities! world-correct-collision-positions! world-solve-constraint-velocities! world-correct-constraint-positions! world-integrate-velocities! world-integrate-positions! world-detect-collisions make-pair-key make-circle-entity make-box-entity make-static-circle make-static-box make-ground world-query-aabb world-query-point world-raycast-closest world-raycast-all)) (answer "(define (apply-force! world id force) (world-update-entity! world id (lambda (e) (if (entity-static? e) e (let* ((body (entity-body e)) (inv-mass (body-inv-mass body)) (new-vel (vec2-add (body-vel body) (vec2-scale force inv-mass))) (new-body (body-with-vel body new-vel))) (entity-with-body e new-body))))))"))
(task-entry (id "physics/classical/particles/explosion-burst") (skill physics/classical) (module particles) (tier 2) (difficulty 23560) (name explosion-burst) (type "") (description "") (notes ()) (section burst) (deps (\x27;prelude \x27;sort \x27;vec2 \x27;prng)) (available (make-particle particle? particle-pos particle-vel particle-lifetime particle-max-life particle-size particle-color particle-user-data particle-alive? particle-age particle-with-pos particle-with-vel particle-with-state gravity-field wind-field drag-field attractor-field vortex-field turbulence-field combine-fields integrate-particle update-particle update-particles make-emitter emitter? emitter-pos emitter-rate emitter-spread emitter-direction emitter-speed-min emitter-speed-max emitter-lifetime-min emitter-lifetime-max emitter-size-min emitter-size-max emitter-color emitter-user-data emitter-accumulator emitter-with-pos emitter-with-direction emitter-with-accumulator spawn-particle emitter-emit make-particle-system particle-system? particle-system-emitters particle-system-particles particle-system-forces particle-system-count particle-system-add-emitter particle-system-add-force particle-system-add-particles particle-system-step make-empty-system make-simple-emitter make-explosion-emitter make-fountain-emitter make-fire-emitter burst)) (answer "(define (explosion-burst pos count rng) (let loop ((n count) (particles '()) (r rng)) (if (<= n 0) (cons particles r) (let* ((r1 (run-state (random-float-range 0 (* 2 3.14159)) r)) (angle (car r1)) (rng1 (cdr r1)) (r2 (run-state (random-float-range 50 200) rng1)) (speed (car r2)) (rng2 (cdr r2)) (r3 (run-state (random-float-range 0.5 1.5) rng2)) (lifetime (car r3)) (rng3 (cdr r3)) (vel (vec2-scale (vec2-from-angle angle) speed)) (p (make-particle pos vel lifetime lifetime 4 'orange #f))) (loop (- n 1) (cons p particles) rng3)))))"))
