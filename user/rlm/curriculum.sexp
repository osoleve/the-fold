(task-entry (id "info/entropy/entropy-log2") (skill info) (module entropy) (tier 1) (difficulty 11100) (name entropy-log2) (type "(-> Number Number)") (description "Logarithm base 2 with convention 0*log(0) = 0") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;transcendental)) (available ()) (answer "(define (entropy-log2 x) (if (<= x 0) 0 (log2 x)))"))
(task-entry (id "info/statistical-measures/bhattacharyya-coefficient") (skill info) (module statistical-measures) (tier 1) (difficulty 11100) (name bhattacharyya-coefficient) (type "(-> (List Real) (List Real) Real)") (description "Bhattacharyya coefficient BC(P,Q) = sum(sqrt(p_i * q_i)), range [0, 1]") (notes ()) (section bhattacharyya-distance) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available ()) (answer "(define (bhattacharyya-coefficient p q) (if (or (null? p) (null? q)) 0 (fold-left + 0 (map (lambda (pi qi) (if (or (< pi 0) (< qi 0)) 0 (sqrt (* pi qi)))) p q))))"))
(task-entry (id "info/channel-capacity/bsc-capacity") (skill info) (module channel-capacity) (tier 1) (difficulty 11100) (name bsc-capacity) (type "(-> Real Real)") (description "Channel capacity of BSC with crossover probability p") (notes ()) (section binary-symmetric-channel) (deps (\x27;entropy)) (available ()) (answer "(define (bsc-capacity p) (cond ((<= p 0) 1.0) ((>= p 1) 1.0) ((= p 0.5) 0.0) (else (- 1 (binary-entropy p)))))"))
(task-entry (id "info/rate-distortion/squared-error") (skill info) (module rate-distortion) (tier 1) (difficulty 11100) (name squared-error) (type "(-> Real Real Real)") (description "Squared error distortion d(x,y) = (x-y)^2") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available ()) (answer "(define (squared-error x y) (* (- x y) (- x y)))"))
(task-entry (id "info/coding/make-huffman-leaf") (skill info) (module coding) (tier 1) (difficulty 11100) (name make-huffman-leaf) (type "(-> Symbol Real Node)") (description "Create Huffman tree leaf node") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available ()) (answer "(define (make-huffman-leaf symbol prob) (list 'leaf symbol prob))"))
(task-entry (id "info/epiplexity/prequential-epiplexity") (skill info) (module epiplexity) (tier 1) (difficulty 11100) (name prequential-epiplexity) (type "(-> (List Number) (List Number) Number)") (description "Estimate epiplexity from online and final loss sequences") (notes ()) (section prequential-epiplexity) (deps (\x27;prelude \x27;entropy \x27;statistical-measures)) (available ()) (answer "(define (prequential-epiplexity online-losses final-losses) (cond ((and (null? online-losses) (null? final-losses)) 0) ((not (= (length online-losses) (length final-losses))) (error 'prequential-epiplexity \"loss lists must have equal length\")) (else (fold-left + 0 (map - online-losses final-losses)))))"))
(task-entry (id "info/model-selection-info/log-likelihood-gaussian") (skill info) (module model-selection-info) (tier 1) (difficulty 11100) (name log-likelihood-gaussian) (type "(-> (List Number) Number)") (description "Gaussian log-likelihood from residuals: -n/2 * (1 + log(2*pi*sigma^2))\n   where sigma^2 = (1/n) * sum(r_i^2). This is the maximized log-likelihood.") (notes ()) (section log-likelihoods) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available ()) (answer "(define (log-likelihood-gaussian residuals) (let* ((n (length residuals)) (ss (fold-left + 0 (map (lambda (r) (* r r)) residuals))) (sigma2 (/ ss n))) (if (<= sigma2 0) 0 (* -0.5 n (+ 1 (log-num (* 2 (pi-value) sigma2)))))))"))
(task-entry (id "info/empirical-info/discretize-uniform") (skill info) (module empirical-info) (tier 1) (difficulty 11100) (name discretize-uniform) (type "(-> (List Number) Nat (List Nat))") (description "Discretize continuous values into uniform bins.\n   Returns list of bin indices (0 to num-bins-1).") (notes ()) (section discretization) (deps (\x27;prelude \x27;entropy)) (available ()) (answer "(define (discretize-uniform xs num-bins) (if (or (null? xs) (<= num-bins 0)) '() (let* ((lo (apply min xs)) (hi (apply max xs)) (range (- hi lo))) (if (<= range 0) (map (lambda (_) 0) xs) (let ((bin-width (/ range num-bins))) (map (lambda (x) (let ((b (inexact->exact (floor (/ (- x lo) bin-width))))) (min b (- num-bins 1)))) xs))))))"))
(task-entry (id "info/partition-info/partition-entropy") (skill info) (module partition-info) (tier 1) (difficulty 11100) (name partition-entropy) (type "(-> Vector Number)") (description "Shannon entropy of partition sizes H(C) = -sum(n_k/n * log2(n_k/n)).\n   A partition with equally-sized communities has maximum entropy.\n   A single-community partition has zero entropy.") (notes ()) (section partition-entropy) (deps (\x27;prelude \x27;entropy)) (available ()) (answer "(define (partition-entropy labels) (let* ((n (vector-length labels)) (sizes (partition-sizes labels)) (probs (map (lambda (s) (/ s n)) sizes))) (entropy probs)))"))
(task-entry (id "optics/optics/grate?") (skill optics) (module optics) (tier 1) (difficulty 11101) (name grate?) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate)) (answer "(define (grate? x) (and (pair? x) (eq? (car x) 'grate)))"))
(task-entry (id "optics/profunctor-optics/p-fold-filtered") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11101) (name p-fold-filtered) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong? strong-profunctor strong-first strong-second pfirst psecond make-choice swap-either choice? choice-profunctor choice-left choice-right pleft pright make-closed closed-profunctor? closed-profunctor closed-fn pclosed make-wander wander? wander-strong wander-choice wander-wander pwander profunctor-fn strong-fn choice-fn closed-fn-instance wander-fn make-forget forget? run-forget profunctor-forget strong-forget make-tagged tagged? run-tagged profunctor-tagged choice-tagged make-star star? star-functor run-star profunctor-star make-p-iso p-iso? p-iso-forward p-iso-backward run-p-iso p-iso-compose make-p-lens p-lens? p-lens-getter p-lens-setter run-p-lens p-lens-compose make-p-prism p-prism? p-prism-match p-prism-build run-p-prism p-prism-compose make-p-affine p-affine? p-affine-preview p-affine-set run-p-affine p-affine-compose make-p-traversal p-traversal? p-traversal-traverse p-traversal-fold-fn run-p-traversal p-traversal-to-list p-traversal-over p-traversal-set p-traversal-compose p-traversal-each p-traversal-both p-traversal-filtered make-p-fold p-fold? p-fold-fn p-fold-to-list p-fold-preview p-fold-has p-fold-length p-fold-all p-fold-any p-fold-compose p-fold-each)) (answer "(define (p-fold-filtered pred) (make-p-fold (lambda (xs) (filter pred xs))))"))
(task-entry (id "info/entropy/any2") (skill info) (module entropy) (tier 1) (difficulty 11101) (name any2) (type "(-> (-> α β Bool) (List α) (List β) Bool)") (description "Check if predicate holds for any pair of corresponding elements") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2)) (answer "(define (any2 pred xs ys) (cond ((null? xs) #f) ((null? ys) #f) ((pred (car xs) (car ys)) #t) (else (any2 pred (cdr xs) (cdr ys)))))"))
(task-entry (id "info/statistical-measures/bhattacharyya-distance") (skill info) (module statistical-measures) (tier 1) (difficulty 11101) (name bhattacharyya-distance) (type "(-> (List Real) (List Real) Real)") (description "Bhattacharyya distance D_B(P,Q) = -ln(BC(P,Q)), range [0, +inf)") (notes ()) (section bhattacharyya-distance) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient)) (answer "(define (bhattacharyya-distance p q) (let ((bc (bhattacharyya-coefficient p q))) (if (<= bc 0) +inf.0 (- (log-num bc)))))"))
(task-entry (id "info/channel-capacity/bsc-transition-matrix") (skill info) (module channel-capacity) (tier 1) (difficulty 11101) (name bsc-transition-matrix) (type "(-> Real (List (List Real)))") (description "Transition probability matrix P(Y|X) for BSC") (notes ()) (section binary-symmetric-channel) (deps (\x27;entropy)) (available (bsc-capacity)) (answer "(define (bsc-transition-matrix p) (list (list (- 1 p) p) (list p (- 1 p))))"))
(task-entry (id "info/rate-distortion/absolute-error") (skill info) (module rate-distortion) (tier 1) (difficulty 11101) (name absolute-error) (type "(-> Real Real Real)") (description "Absolute error distortion d(x,y) = |x-y|") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available (squared-error)) (answer "(define (absolute-error x y) (abs (- x y)))"))
(task-entry (id "info/coding/make-huffman-internal") (skill info) (module coding) (tier 1) (difficulty 11101) (name make-huffman-internal) (type "(-> Node Node Node)") (description "Create Huffman tree internal node") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf)) (answer "(define (make-huffman-internal left right) (list 'internal (cons left right) (+ (huffman-prob left) (huffman-prob right))))"))
(task-entry (id "info/epiplexity/prequential-epiplexity-scalar") (skill info) (module epiplexity) (tier 1) (difficulty 11101) (name prequential-epiplexity-scalar) (type "(-> (List Number) Number Number)") (description "Estimate epiplexity assuming constant final baseline loss") (notes ()) (section prequential-epiplexity) (deps (\x27;prelude \x27;entropy \x27;statistical-measures)) (available (prequential-epiplexity)) (answer "(define (prequential-epiplexity-scalar online-losses baseline-loss) (if (null? online-losses) 0 (fold-left + 0 (map (lambda (l) (- l baseline-loss)) online-losses))))"))
(task-entry (id "info/model-selection-info/log-likelihood-gaussian-vec") (skill info) (module model-selection-info) (tier 1) (difficulty 11101) (name log-likelihood-gaussian-vec) (type "(-> Vec Number)") (description "Gaussian log-likelihood from a vector of residuals") (notes ()) (section log-likelihoods) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (log-likelihood-gaussian)) (answer "(define (log-likelihood-gaussian-vec residuals-vec) (let* ((n (vector-length residuals-vec)) (ss (let loop ((i 0) (s 0)) (if (= i n) s (let ((r (vector-ref residuals-vec i))) (loop (+ i 1) (+ s (* r r))))))) (sigma2 (/ ss n))) (if (<= sigma2 0) 0 (* -0.5 n (+ 1 (log-num (* 2 (pi-value) sigma2)))))))"))
(task-entry (id "info/empirical-info/default-num-bins") (skill info) (module empirical-info) (tier 1) (difficulty 11101) (name default-num-bins) (type "(-> Nat Nat)") (description "Sturges' rule for default bin count: ceil(1 + log2(n))") (notes ()) (section discretization) (deps (\x27;prelude \x27;entropy)) (available (discretize-uniform)) (answer "(define (default-num-bins n) (if (<= n 1) 1 (inexact->exact (ceiling (+ 1 (log2 n))))))"))
(task-entry (id "info/partition-info/partition-sizes") (skill info) (module partition-info) (tier 1) (difficulty 11101) (name partition-sizes) (type "(-> Vector (List Nat))") (description "Count the size of each community in a label vector.\n   Returns list of counts (one per distinct label), sorted by label.") (notes ()) (section partition-entropy) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy)) (answer "(define (partition-sizes labels) (let ((counts (make-hashtable equal-hash equal?))) (let loop ((i 0)) (if (= i (vector-length labels)) (let* ((keys (vector->list (hashtable-keys counts))) (sorted-keys (sort-labels keys))) (map (lambda (k) (hashtable-ref counts k 0)) sorted-keys)) (begin (let ((lbl (vector-ref labels i))) (hashtable-set! counts lbl (+ 1 (hashtable-ref counts lbl 0)))) (loop (+ i 1)))))))"))
(task-entry (id "optics/optics/grate-cotraverse-fn") (skill optics) (module optics) (tier 1) (difficulty 11102) (name grate-cotraverse-fn) (type "") (description "") (notes ()) (section iso) (deps (\x27;prelude \x27;combinators \x27;templates)) (available (make-iso iso? iso-forward iso-backward iso-view iso-review iso-over iso-flip iso-compose iso-id iso-curried iso-flipped iso-swapped iso-reversed iso-assoc-list iso-maybe-either iso-cons lens-id prism-over prism-set prism-compose prism-id prism-nil prism-cons affine-nth list-set-at make-affine affine? affine-getter affine-setter affine-preview affine-set affine-over affine-compose affine-id lens->affine prism->affine make-traversal traversal? traversal-traverse traversal-fold traversal-to-list traversal-over traversal-set traversal-compose traversal-each traversal-filtered filtered traversal-both traversal-left traversal-right traversal-just lens->traversal prism->traversal affine->traversal vec-element-lens vec-element-affine vec-elements-each make-fold fold-optic? fold-optic-fn fold-to-list fold-preview fold-has fold-length fold-all fold-any fold-sum fold-compose fold-each fold-filtered fold-taking fold-dropping drop-up-to traversal->fold lens->fold prism->fold make-getter getter? getter-fn getter-view getter-compose getter-id getter-fst getter-snd getter-to lens->getter iso->getter make-setter setter? setter-over-fn setter-over setter-set setter-compose setter-mapped setter-arg setter-result lens->setter traversal->setter iso->setter make-grate grate?)) (answer "(define (grate-cotraverse-fn g) (cadr g))"))
(task-entry (id "optics/profunctor-optics/p-fold-taking") (skill optics) (module profunctor-optics) (tier 1) (difficulty 11102) (name p-fold-taking) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators \x27;templates \x27;optics)) (available (make-profunctor profunctor? profunctor-dimap profunctor-lmap profunctor-rmap dimap lmap rmap make-strong strong? strong-profunctor strong-first strong-second pfirst psecond make-choice swap-either choice? choice-profunctor choice-left choice-right pleft pright make-closed closed-profunctor? closed-profunctor closed-fn pclosed make-wander wander? wander-strong wander-choice wander-wander pwander profunctor-fn strong-fn choice-fn closed-fn-instance wander-fn make-forget forget? run-forget profunctor-forget strong-forget make-tagged tagged? run-tagged profunctor-tagged choice-tagged make-star star? star-functor run-star profunctor-star make-p-iso p-iso? p-iso-forward p-iso-backward run-p-iso p-iso-compose make-p-lens p-lens? p-lens-getter p-lens-setter run-p-lens p-lens-compose make-p-prism p-prism? p-prism-match p-prism-build run-p-prism p-prism-compose make-p-affine p-affine? p-affine-preview p-affine-set run-p-affine p-affine-compose make-p-traversal p-traversal? p-traversal-traverse p-traversal-fold-fn run-p-traversal p-traversal-to-list p-traversal-over p-traversal-set p-traversal-compose p-traversal-each p-traversal-both p-traversal-filtered make-p-fold p-fold? p-fold-fn p-fold-to-list p-fold-preview p-fold-has p-fold-length p-fold-all p-fold-any p-fold-compose p-fold-each p-fold-filtered)) (answer "(define (p-fold-taking n) (make-p-fold (lambda (xs) (take n xs))))"))
(task-entry (id "info/entropy/plogp") (skill info) (module entropy) (tier 1) (difficulty 11102) (name plogp) (type "(-> Number Number)") (description "Compute p * log2(p) with convention 0 * log(0) = 0") (notes ()) (section utility-functions) (deps (\x27;prelude \x27;transcendental)) (available (entropy-log2 any2)) (answer "(define (plogp p) (if (<= p 0) 0 (* p (entropy-log2 p))))"))
(task-entry (id "info/statistical-measures/hellinger-distance") (skill info) (module statistical-measures) (tier 1) (difficulty 11102) (name hellinger-distance) (type "(-> (List Real) (List Real) Real)") (description "Hellinger distance, symmetric measure in [0, 1], H^2 = 1 - BC") (notes ()) (section hellinger-distance) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (bhattacharyya-coefficient bhattacharyya-distance)) (answer "(define (hellinger-distance p q) (if (or (null? p) (null? q)) 1 (let ((sum-sq (fold-left + 0 (map (lambda (pi qi) (let ((diff (- (sqrt (max 0 pi)) (sqrt (max 0 qi))))) (* diff diff))) p q)))) (sqrt (* 0.5 sum-sq)))))"))
(task-entry (id "info/channel-capacity/bsc-mutual-information") (skill info) (module channel-capacity) (tier 1) (difficulty 11102) (name bsc-mutual-information) (type "(-> Real Real Real)") (description "Mutual information I(X;Y) for BSC with input probability p-x") (notes ()) (section binary-symmetric-channel) (deps (\x27;entropy)) (available (bsc-capacity bsc-transition-matrix)) (answer "(define (bsc-mutual-information p-crossover p-x) (let* ((p-y0 (+ (* (- 1 p-x) (- 1 p-crossover)) (* p-x p-crossover))) (p-y1 (- 1 p-y0)) (h-y (binary-entropy p-y1)) (h-y-given-x (binary-entropy p-crossover))) (- h-y h-y-given-x)))"))
(task-entry (id "info/rate-distortion/hamming-distortion") (skill info) (module rate-distortion) (tier 1) (difficulty 11102) (name hamming-distortion) (type "(-> α α Nat)") (description "Hamming distortion d(x,y) = 0 if x=y, 1 otherwise") (notes ()) (section distortion-measures) (deps (\x27;entropy \x27;sort)) (available (squared-error absolute-error)) (answer "(define (hamming-distortion x y) (if (equal? x y) 0 1))"))
(task-entry (id "info/coding/huffman-leaf?") (skill info) (module coding) (tier 1) (difficulty 11102) (name huffman-leaf?) (type "(-> Node Boolean)") (description "") (notes ()) (section huffman-coding) (deps (\x27;entropy \x27;sort)) (available (make-huffman-leaf make-huffman-internal)) (answer "(define (huffman-leaf? node) (eq? (car node) 'leaf))"))
(task-entry (id "info/epiplexity/requential-epiplexity") (skill info) (module epiplexity) (tier 1) (difficulty 11102) (name requential-epiplexity) (type "(-> (List (List Number)) (List (List Number)) Number)") (description "Estimate epiplexity using Requential Coding (Teacher-Student approach)") (notes ()) (section requential-epiplexity) (deps (\x27;prelude \x27;entropy \x27;statistical-measures)) (available (prequential-epiplexity prequential-epiplexity-scalar)) (answer "(define (requential-epiplexity teacher-dists student-dists) (cond ((and (null? teacher-dists) (null? student-dists)) 0) ((not (= (length teacher-dists) (length student-dists))) (error 'requential-epiplexity \"distribution lists must have equal length\")) (else (fold-left + 0 (map kl-divergence teacher-dists student-dists)))))"))
(task-entry (id "info/model-selection-info/aic") (skill info) (module model-selection-info) (tier 1) (difficulty 11102) (name aic) (type "(-> Number Nat Number)") (description "Akaike Information Criterion: AIC = -2*logL + 2*k\n   where k is the number of estimated parameters. Lower is better.\n   Grounded in KL divergence: AIC estimates 2 * E[D_KL(truth || model)].") (notes ()) (section information-criteria) (deps (\x27;prelude \x27;entropy \x27;transcendental)) (available (log-likelihood-gaussian log-likelihood-gaussian-vec)) (answer "(define (aic log-lik k) (+ (* -2 log-lik) (* 2 k)))"))
(task-entry (id "info/empirical-info/entropy-empirical") (skill info) (module empirical-info) (tier 1) (difficulty 11102) (name entropy-empirical) (type "(-> (List Number) (Nat) Number)") (description "Estimate Shannon entropy from continuous sample data.\n   Discretizes via uniform binning then computes plug-in entropy.\n   Optional second argument specifies number of bins (default: Sturges' rule).") (notes ()) (section empirical-entropy) (deps (\x27;prelude \x27;entropy)) (available (discretize-uniform default-num-bins)) (answer "(define (entropy-empirical xs . opts) (if (null? xs) 0 (let* ((num-bins (if (and (pair? opts) (integer? (car opts))) (car opts) (default-num-bins (length xs)))) (bins (discretize-uniform xs num-bins))) (sample-entropy bins))))"))
(task-entry (id "info/partition-info/sort-labels") (skill info) (module partition-info) (tier 1) (difficulty 11102) (name sort-labels) (type "(-> (List Any) (List Any))") (description "Sort label keys for deterministic output") (notes ()) (section partition-entropy) (deps (\x27;prelude \x27;entropy)) (available (partition-entropy partition-sizes)) (answer "(define (sort-labels keys) (let loop ((remaining keys) (sorted '())) (if (null? remaining) sorted (loop (cdr remaining) (insert-sorted (car remaining) sorted)))))"))
