(task-entry (id "tiles/square/square-line") (skill tiles) (module square) (tier 1) (difficulty 12312) (name square-line) (type "(-> Coord Coord (List Coord))") (description "Get all coordinates on a straight line from c1 to c2. Uses Bresenham's line algorithm") (notes ()) (section range-and-area) (deps (\x27;prelude)) (available (square-coord square-offset-8 square-offset-4 square-neighbor square-neighbors-ortho square-neighbors-diag square-neighbors-all square-neighbors square-distance-manhattan square-distance-chebyshev square-distance-euclidean square-distance)) (answer "(define (square-line c1 c2) (let* ((x1 (coord-x c1)) (y1 (coord-y c1)) (x2 (coord-x c2)) (y2 (coord-y c2)) (dx (abs (- x2 x1))) (dy (abs (- y2 y1))) (sx (if (< x1 x2) 1 -1)) (sy (if (< y1 y2) 1 -1))) (let loop ((x x1) (y y1) (err (- dx dy)) (coords '())) (let ((new-coords (cons (square-coord x y) coords))) (if (and (= x x2) (= y y2)) (reverse new-coords) (let* ((e2 (* 2 err)) (new-x (if (> e2 (- dy)) (+ x sx) x)) (new-y (if (< e2 dx) (+ y sy) y)) (new-err (+ err (if (> e2 (- dy)) (- dy) 0) (if (< e2 dx) dx 0)))) (loop new-x new-y new-err new-coords)))))))"))
(task-entry (id "tiles/hex/hex-line") (skill tiles) (module hex) (tier 1) (difficulty 12312) (name hex-line) (type "(-> AxialCoord AxialCoord (List AxialCoord))") (description "Get hexes on a straight line from c1 to c2. Uses linear interpolation in cubic space") (notes ()) (section line-and-range) (deps (\x27;prelude)) (available (axial-coord cubic-coord offset-coord axial->cubic cubic->axial axial->offset offset->axial hex-axial-directions hex-neighbor hex-neighbors hex-neighbors-at-distance hex-distance)) (answer "(define (hex-line c1 c2) (let* ((cube1 (axial->cubic c1)) (cube2 (axial->cubic c2)) (N (hex-distance c1 c2))) (if (= N 0) (list c1) (let ((x1 (exact->inexact (cubic-coord%-x cube1))) (y1 (exact->inexact (cubic-coord%-y cube1))) (z1 (exact->inexact (cubic-coord%-z cube1))) (x2 (exact->inexact (cubic-coord%-x cube2))) (y2 (exact->inexact (cubic-coord%-y cube2))) (z2 (exact->inexact (cubic-coord%-z cube2)))) (let loop ((i 0) (coords '())) (if (> i N) (reverse coords) (let* ((t (/ i N)) (x (+ (* x1 (- 1 t)) (* x2 t))) (y (+ (* y1 (- 1 t)) (* y2 t))) (z (+ (* z1 (- 1 t)) (* z2 t))) (rx (round x)) (ry (round y)) (rz (round z)) (x-diff (abs (- rx x))) (y-diff (abs (- ry y))) (z-diff (abs (- rz z))) (final-cube (cond ((and (> x-diff y-diff) (> x-diff z-diff)) (cubic-coord (inexact->exact (- (- ry) rz)) (inexact->exact ry) (inexact->exact rz))) ((> y-diff z-diff) (cubic-coord (inexact->exact rx) (inexact->exact (- (- rx) rz)) (inexact->exact rz))) (else (cubic-coord (inexact->exact rx) (inexact->exact ry) (inexact->exact (- (- rx) ry))))))) (loop (+ i 1) (cons (cubic->axial final-cube) coords)))))))))"))
(task-entry (id "tiles/triangle/triangle-distance-manhattan") (skill tiles) (module triangle) (tier 1) (difficulty 12312) (name triangle-distance-manhattan) (type "(-> TriangleCoord TriangleCoord Integer)") (description "Approximate distance (sum of row/col differences). Underestimates true distance.") (notes ("For exact distance, use pathfinding (BFS/Dijkstra)")) (section distance) (deps (\x27;tiles/core)) (available (triangle-coord triangle-row triangle-col triangle-orientation triangle-coord-equal? triangle-coord-hash triangle-default-orientation triangle-flip triangle-neighbors-edge triangle-neighbors-vertex triangle-neighbors-all triangle-neighbors)) (answer "(define (triangle-distance-manhattan t1 t2) (+ (abs (- (triangle-row t2) (triangle-row t1))) (abs (- (triangle-col t2) (triangle-col t1))) (if (eq? (triangle-orientation t1) (triangle-orientation t2)) 0 1)))"))
(task-entry (id "tiles/pathfinding/find-path-astar") (skill tiles) (module pathfinding) (tier 1) (difficulty 12312) (name find-path-astar) (type "(-> Board Coord Coord (-> Coord (List Coord)) (-> Coord Coord Number) (Maybe (List Coord)))") (description "Find path on board using A*") (notes ()) (section board-integration) (deps (\x27;tiles/core)) (available (make-pqueue pqueue-empty? pqueue-insert pqueue-pop reconstruct-path bfs-path dijkstra-path astar-path board-walkable? board-cost find-path-bfs find-path-dijkstra)) (answer "(define (find-path-astar board start goal neighbor-fn heuristic-fn) (astar-path start goal neighbor-fn (lambda (c) (board-cost board c)) heuristic-fn (lambda (c) (board-walkable? board c))))"))
(task-entry (id "tiles/units/game-unit-can-reach") (skill tiles) (module units) (tier 1) (difficulty 12312) (name game-unit-can-reach) (type "(-> GameState Symbol Coord (-> Coord (List Coord)) Bool)") (description "Check if unit can reach destination within movement range") (notes ()) (section movement) (deps (\x27;tiles/core)) (available (make-unit unit-get-prop unit-set-prop make-game-state game-board game-place-unit game-remove-unit game-get-unit-at game-get-unit-coord game-all-units game-units-by-team game-move-unit)) (answer "(define (game-unit-can-reach gs unit-id dest neighbor-fn) (let* ((board (game-board gs)) (start (game-get-unit-coord gs unit-id)) (unit (game-get-unit-at gs start))) (if (and start unit) (let* ((movement (unit-get-prop unit 'movement 999)) (reachable (board-reachable board start movement neighbor-fn)) (reachable-coords (map car reachable))) (member dest reachable-coords)) #f)))"))
