(task-entry (id "physics/diff/diff-collision/traced-collision-step") (skill physics/diff) (module diff-collision) (tier 2) (difficulty 23113) (name traced-collision-step) (type "") (description "") (notes ()) (section circle-circle-collision-response) (deps (\x27;prelude \x27;vec2 \x27;reverse-diff \x27;traced-vec2 \x27;traced-body \x27;smooth-collision)) (available (traced-circle-collision-force traced-circle-collision-impulses traced-ground-collision-force traced-ground-collision-step make-collision-pair collision-pair-idx-a collision-pair-idx-b collision-pair-radius-a collision-pair-radius-b traced-accumulate-collision-forces effective-restitution traced-circles-overlapping? traced-circle-ground-overlapping?)) (answer "(define (traced-collision-step body radius others ground-y mat dt) (let* ((initial-force (lift-vec2-const (vec2-zero))) (initial-torque 0) (body-result (fold-left (lambda (acc other) (let* ((other-body (car other)) (other-radius (cadr other)) (force-acc (car acc)) (torque-acc (cadr acc))) (call-with-values (lambda () (traced-circle-collision-force body radius other-body other-radius mat)) (lambda (f t) (list (traced-vec2-add force-acc f) (traced-add torque-acc t)))))) (list initial-force initial-torque) others)) (force-from-bodies (car body-result)) (torque-from-bodies (cadr body-result)) (ground-result (if ground-y (call-with-values (lambda () (traced-ground-collision-force body radius ground-y mat)) (lambda (gf gt) (list (traced-vec2-add force-from-bodies gf) (traced-add torque-from-bodies gt)))) body-result)) (total-force (car ground-result)) (total-torque (cadr ground-result))) (traced-apply-central-force (traced-apply-torque body total-torque dt) total-force dt)))"))
