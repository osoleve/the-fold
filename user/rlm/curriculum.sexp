(task-entry (id "diffgeo/symbolic-metrics/spherical-christoffel-exact") (skill diffgeo) (module symbolic-metrics) (tier 1) (difficulty 10714) (name spherical-christoffel-exact) (type "(-> Vec ChristoffelTensor)") (description "Pre-computed Christoffel symbols for spherical coordinates") (notes ("Non-zero: Γ^r_{θθ}=-r, Γ^r_{φφ}=-r·sin²θ, Γ^θ_{rθ}=1/r, Γ^θ_{φφ}=-sinθcosθ, Γ^φ_{rφ}=1/r, Γ^φ_{θφ}=cotθ" "Returns +inf.0 at r=0 and θ=0,π (coordinate singularities)")) (section metric-derivative-protocol) (deps (\x27;curvature)) (available (metric-symbolic? make-metric-symbolic metric-symbolic-deriv-fn metric-chart* metric-fn* metric-dim* metric-at* make-polar-metric-exact make-spherical-metric-exact make-cylindrical-metric-exact make-euclidean-metric-exact christoffel-symbols-exact christoffel-symbols* polar-christoffel-exact)) (answer "(define (spherical-christoffel-exact coords) (let* ((r (vector-ref coords 0)) (theta (vector-ref coords 1)) (sin-t (sin theta)) (cos-t (cos theta)) (inv-r (/ 1.0 r)) (cot-t (/ cos-t sin-t)) (gamma (make-vector 3 #f))) (let ((gr (make-vector 3 #f))) (vector-set! gr 0 (vector 0 0 0)) (vector-set! gr 1 (vector 0 (- r) 0)) (vector-set! gr 2 (vector 0 0 (- (* r sin-t sin-t)))) (vector-set! gamma 0 gr)) (let ((gt (make-vector 3 #f))) (vector-set! gt 0 (vector 0 inv-r 0)) (vector-set! gt 1 (vector inv-r 0 0)) (vector-set! gt 2 (vector 0 0 (- (* sin-t cos-t)))) (vector-set! gamma 1 gt)) (let ((gp (make-vector 3 #f))) (vector-set! gp 0 (vector 0 0 inv-r)) (vector-set! gp 1 (vector 0 0 cot-t)) (vector-set! gp 2 (vector inv-r cot-t 0)) (vector-set! gamma 2 gp)) gamma))"))
