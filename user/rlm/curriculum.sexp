(task-entry (id "fp/free/kv-fmap") (skill fp) (module free) (tier 1) (difficulty 10625) (name kv-fmap) (type "") (description "") (notes ()) (section none) (deps (\x27;prelude \x27;combinators)) (available (pure-free free pure-free? free-suspended? from-pure-free from-free free-map make-free-queue free-queue? free-queue-base free-queue-fmap free-queue-conts free-bind free-normalize free-apply-queue free-apply-queue-step free-then free-ap lift-free fold-free iter-free run-free kv-get kv-put kv-delete)) (answer "(define (kv-fmap f cmd) (let ((tag (car cmd))) (cond ((eq? tag 'get) (let ((key (cadr cmd)) (k (caddr cmd))) (list 'get key (lambda (v) (f (k v)))))) ((eq? tag 'put) (let ((key (cadr cmd)) (val (caddr cmd)) (next (cadddr cmd))) (list 'put key val (f next)))) ((eq? tag 'delete) (let ((key (cadr cmd)) (next (caddr cmd))) (list 'delete key (f next)))) (else (error 'kv-fmap \"Unknown command\")))))"))
