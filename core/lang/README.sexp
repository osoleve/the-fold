((name "lang")
 (purpose "Language core - parsing, evaluation, compilation, and Rust codegen")
 (description "The parsing, evaluation and compilation pipeline for The Fold.
Includes parser combinators, spanned parsing, Fold syntax parser,
primitive dispatch, pure evaluation, type-directed evaluation,
normalization by evaluation (NbE), module system, and Rust code generation
for accelerating Layer 1 primitives via FFI.")
 (modules
  ((parse.ss "Parsec-style parser combinators")
   (span.ss "Position-aware parser combinators with source spans")
   (fold-parse.ss "Fold S-expression syntax parser")
   (prim.ss "Primitive function dispatcher")
   (eval.ss "Pure evaluator")
   (typed-eval.ss "Type-directed evaluation")
   (compile.ss "Compilation pipeline")
   (nbe.ss "Normalization by evaluation")
   (module.ss "Module system")
   (index.ss "Module index and discovery")
   ;; Rust codegen subsystem (v1.0)
   (rust-mapping.ss "Scheme to Rust type mapping")
   (rust-codegen.ss "IR nodes, serialization, fuel costs, autodiff gradients")
   (rust-compile.ss "Crate integration, cargo build commands")))
 (tests
  ((test-parse.ss "Parser combinator tests")
   (test-span.ss "Position-aware parsing tests")
   (test-fold-parse.ss "Fold parser tests")
   (test-par-pseq.ss "Parallel/sequential evaluation tests")
   (test-rust-codegen.ss "Rust codegen tests (280 tests)")))
 (dependencies (base types))
 (evaluation-strategy "call-by-value")
 (documentation "docs/rust-codegen.md")
 (rust-codegen
  (status "v1.2 complete")
  (version "1.2.0")
  (supported-primitives
   (arithmetic add sub mul div mod neg abs)
   (comparison lt le gt ge eq ne)
   (logical and or not)
   (bitwise bitand bitor bitxor bitnot shl shr)
   (math sqrt sin cos tan log floor ceil round min max))
  (supported-types i64 f64 bool u64 i32 f32)
  (features
   (type-safety "Type-specific result structs (I64Result, F64Result, BoolResult, U64Result, I32Result, F32Result)")
   (fuel-accounting "Automatic fuel cost computation from IR")
   (error-handling "Division-by-zero protection with runtime error status")
   (variadic-ops "N-ary add, mul, and, or, bitand, bitor, bitxor")
   (crate-integration "Generated modules in boundary/ffi/rust-accel/src/generated/")
   (ffi-loader "Dynamic function loading via boundary/ffi/rust-loader.ss")
   (autodiff-compat "Gradient formulas documented for reverse-mode AD")
   (closures "R-Lambda for non-capturing closures, compiles to Rust closures |x| body")
   (capturing-closures "R-Closure with free variable analysis, auto-detects captures, uses move semantics")
   (recursion "R-Letrec for recursive bindings, compiles to local fn definitions")
   (fuel-threading "Recursive functions receive __fuel param, panic on exhaustion, caught by catch_unwind"))
  (ir-nodes
   (R-Literal "value [type]" "Constants (number, bool, string)")
   (R-Var "symbol" "Variable reference")
   (R-Call "op arg..." "Operation/function call")
   (R-Let "symbol value" "Let binding")
   (R-If "cond then else" "Conditional expression")
   (R-Block "stmt... expr" "Statement block with final expr")
   (R-Fn "name params ret body" "Top-level function definition")
   (R-Lambda "params ret body" "Non-capturing anonymous function")
   (R-Closure "captures params ret body" "Capturing closure with move semantics")
   (R-Letrec "name params ret body in-expr" "Recursive binding with local fn"))
  (limitations
   (letrec-no-capture "R-Letrec generates Rust fn items which cannot capture outer scope variables")
   (panic-fuel "Fuel exhaustion uses panic/catch_unwind; cleaner Option<T> approach is future work")
   (guard-scoping "Division-by-zero guards check top-level only; nested closures/letrec unguarded (safe: no incorrect guards)")
   (typed-only "Only typed lambdas supported; untyped (fn (x) ...) rejected")
   (move-only "Captured values use move semantics; Clone required for reuse"))
  (future-work
   (letrec-captures "R-Letrec with captures requires defunctionalization (struct passing)")
   (function-pointers "First-class function types in FFI parameters")
   (option-fuel "Replace panic-based fuel with Option<T> return types for cleaner propagation")
   (scoped-guards "Generate division guards locally within lambda/letrec bodies")
   (eval-integration "Automatic hot-path acceleration")
   (layer-2 "Bytevectors, strings")
   (layer-3 "Crypto primitives"))))
