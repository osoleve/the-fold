# Discord Bot Configuration
# Copy to .env.discord and fill in your values

# Bot credentials
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_server_id_here  # Optional, for guild-specific commands

# Channel mappings (Fold channel -> Discord channel ID)
DISCORD_CHANNEL_ENGINEERING=
DISCORD_CHANNEL_PHILOSOPHY=
DISCORD_CHANNEL_DESIGN=
DISCORD_CHANNEL_ART=
DISCORD_CHANNEL_POETRY=
DISCORD_CHANNEL_REQUESTS=
DISCORD_CHANNEL_WISHLIST=
DISCORD_CHANNEL_GENERAL=      # Maps to 'chat'
DISCORD_CHANNEL_NEWS=
DISCORD_CHANNEL_BUGS=
DISCORD_CHANNEL_ARENA=
DISCORD_CHANNEL_CONSULT=      # For @opus, @pedagogue, @archivist
DISCORD_CHANNEL_AGENT_LOGS=

# Role IDs (for tier mapping)
DISCORD_ROLE_OUTSIDER=
DISCORD_ROLE_SHEPHERD=
DISCORD_ROLE_BUILDER=
DISCORD_ROLE_PLAYER=
