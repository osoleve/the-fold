#!/usr/bin/env bash
#
# Post-commit hook for The Fold
#
# Features:
#   1. Auto-deploys technical report when chapter files change
#   2. QA review with model fallback:
#      - gemini-3-pro-preview (best quality)
#      - gemini-3-flash (fast fallback)
#      - local vLLM (if running)
#      - local llama with nemotron (last resort)
#
# Install: git config core.hooksPath .githooks
#

set -e

# Colors for terminal output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# ============================================================================
# Part 1: Technical Report Auto-Deploy
# ============================================================================

# Check if any technical report files were committed
REPORT_FILES=$(git diff-tree --no-commit-id --name-only -r HEAD | grep -E '^docs/technical-report/' || true)

if [ -n "$REPORT_FILES" ]; then
    echo ""
    echo -e "${YELLOW}[POST-COMMIT]${NC} Technical report files changed, rebuilding and deploying..."
    echo ""

    # Run the full deploy pipeline
    if scheme --script docs/technical-report/assemble.ss --deploy; then
        echo ""
        echo -e "${GREEN}[POST-COMMIT]${NC} Technical report deployed successfully."
    else
        echo -e "${YELLOW}[POST-COMMIT]${NC} Warning: Deploy failed (non-blocking)"
    fi
fi

# ============================================================================
# Part 2: QA Review with Model Fallback
# ============================================================================

# Configuration
VLLM_PORT=8000
LLAMA_SERVE_SCRIPT="$HOME/llama-spark-plugin/scripts/llama-serve.sh"
LLAMA_STOP_SCRIPT="$HOME/llama-spark-plugin/scripts/llama-stop.sh"
LLAMA_STATE_FILE="$HOME/.llama-server-state.json"
LLAMA_PORT=30000
LLAMA_MODEL="nemotron"
LLAMA_STARTUP_TIMEOUT=120  # Large models can take time to load

# Get commit info
COMMIT_HASH=$(git rev-parse --short HEAD)
COMMIT_MSG=$(git log -1 --pretty=%s)
COMMIT_DATE=$(date +%Y-%m-%d)

# Get list of changed Scheme files (comparing to parent commit)
CHANGED_FILES=$(git diff-tree --no-commit-id --name-only -r HEAD | grep -E '\.(ss|scm)$' || true)

# Skip QA if no Scheme files changed
if [ -z "$CHANGED_FILES" ]; then
    echo -e "${YELLOW}[post-commit]${NC} No Scheme files changed, skipping QA review"
    exit 0
fi

# Create output directory if needed
mkdir -p docs/peer-review

OUTPUT_FILE="docs/peer-review/gemini-qa-${COMMIT_HASH}-${COMMIT_DATE}.md"

# Build list of directories to include (for Gemini)
INCLUDE_DIRS=""
for file in $CHANGED_FILES; do
    dir=$(dirname "$file")
    if [ "$dir" != "." ]; then
        INCLUDE_DIRS="$INCLUDE_DIRS --include-directories $dir"
    fi
done

# Build the review prompt
REVIEW_PROMPT="You are reviewing a commit to The Fold, a Chez Scheme codebase.

Commit: ${COMMIT_HASH}
Message: ${COMMIT_MSG}

Changed files:
${CHANGED_FILES}

Please review the changes for:
1. **Correctness**: Logic errors, edge cases, off-by-one errors
2. **Style**: Consistency with Scheme idioms, naming conventions
3. **Documentation**: Are doc forms present and accurate?
4. **Testing**: Are there corresponding tests? Any missing test cases?
5. **Performance**: Any obvious inefficiencies?

Be concise. Focus on actionable issues. If the code looks good, say so briefly.

Format your response as markdown with sections for each category where you have findings."

# Function to check if llama-server is running
llama_is_running() {
    if [[ -f "$LLAMA_STATE_FILE" ]]; then
        local pid=$(jq -r '.pid' "$LLAMA_STATE_FILE" 2>/dev/null)
        local port=$(jq -r '.port' "$LLAMA_STATE_FILE" 2>/dev/null)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            # Verify it's actually responding
            if curl -s --max-time 5 "http://127.0.0.1:${port:-$LLAMA_PORT}/health" | grep -q "ok"; then
                return 0
            fi
        fi
    fi
    return 1
}

# Function to start llama-server
start_llama_server() {
    echo -e "${YELLOW}[post-commit]${NC} Starting local llama-server with $LLAMA_MODEL..."

    # Clean up stale state if server isn't actually running
    if [[ -f "$LLAMA_STATE_FILE" ]]; then
        local pid=$(jq -r '.pid' "$LLAMA_STATE_FILE" 2>/dev/null)
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$LLAMA_STATE_FILE"
        fi
    fi

    # Start the server
    if [[ -x "$LLAMA_SERVE_SCRIPT" ]]; then
        "$LLAMA_SERVE_SCRIPT" "$LLAMA_MODEL" --port "$LLAMA_PORT" &
        local serve_pid=$!

        # Wait for server to be ready
        local elapsed=0
        while [[ $elapsed -lt $LLAMA_STARTUP_TIMEOUT ]]; do
            if curl -s --max-time 2 "http://127.0.0.1:$LLAMA_PORT/health" | grep -q "ok"; then
                echo -e "${GREEN}[post-commit]${NC} Llama server ready"
                return 0
            fi
            sleep 5
            elapsed=$((elapsed + 5))
            echo -e "${YELLOW}[post-commit]${NC}   ... waiting for llama-server ($elapsed/${LLAMA_STARTUP_TIMEOUT}s)"
        done

        echo -e "${RED}[post-commit]${NC} Llama server failed to start within ${LLAMA_STARTUP_TIMEOUT}s"
        return 1
    else
        echo -e "${RED}[post-commit]${NC} Llama serve script not found: $LLAMA_SERVE_SCRIPT"
        return 1
    fi
}

# Function to run review via llama
run_llama_review() {
    local output_file="$1"

    # Read the changed files content to include in context
    local file_contents=""
    for file in $CHANGED_FILES; do
        if [[ -f "$file" ]]; then
            file_contents="${file_contents}

=== $file ===
$(head -500 "$file")"
        fi
    done

    # Build the full prompt with file contents
    local full_prompt="${REVIEW_PROMPT}

Here are the file contents for reference:
${file_contents}"

    # Call llama-server's completion endpoint
    local response
    response=$(curl -s --max-time 300 "http://127.0.0.1:$LLAMA_PORT/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "$(jq -n \
            --arg prompt "$full_prompt" \
            '{
                model: "local",
                messages: [
                    {role: "user", content: $prompt}
                ],
                max_tokens: 4096,
                temperature: 0.3
            }')" 2>&1)

    if echo "$response" | jq -e '.choices[0].message.content' > /dev/null 2>&1; then
        echo "$response" | jq -r '.choices[0].message.content' >> "$output_file"
        return 0
    else
        echo "Llama API error: $response" >> "$output_file"
        return 1
    fi
}

# Function to check if vLLM is running
vllm_is_running() {
    curl -sf --max-time 5 "http://127.0.0.1:$VLLM_PORT/health" > /dev/null 2>&1
}

# Function to get the vLLM model name
vllm_model_name() {
    curl -s --max-time 5 "http://127.0.0.1:$VLLM_PORT/v1/models" | jq -r '.data[0].id' 2>/dev/null
}

# Function to run review via vLLM
run_vllm_review() {
    local output_file="$1"
    local model_name
    model_name=$(vllm_model_name)

    if [[ -z "$model_name" || "$model_name" == "null" ]]; then
        echo -e "${YELLOW}[post-commit]${NC} vLLM: could not determine model name"
        return 1
    fi

    echo -e "${YELLOW}[post-commit]${NC} Using vLLM model: $model_name"

    # Read the changed files content to include in context
    local file_contents=""
    for file in $CHANGED_FILES; do
        if [[ -f "$file" ]]; then
            file_contents="${file_contents}

=== $file ===
$(head -500 "$file")"
        fi
    done

    # Build the full prompt with file contents
    local full_prompt="${REVIEW_PROMPT}

Here are the file contents for reference:
${file_contents}"

    # Call vLLM's OpenAI-compatible endpoint
    local response
    response=$(curl -s --max-time 300 "http://127.0.0.1:$VLLM_PORT/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "$(jq -n \
            --arg model "$model_name" \
            --arg prompt "$full_prompt" \
            '{
                model: $model,
                messages: [
                    {role: "user", content: $prompt}
                ],
                max_tokens: 4096,
                temperature: 0.3
            }')" 2>&1)

    if echo "$response" | jq -e '.choices[0].message.content' > /dev/null 2>&1; then
        echo "$response" | jq -r '.choices[0].message.content' >> "$output_file"
        return 0
    else
        echo -e "${YELLOW}[post-commit]${NC} vLLM API error: $(echo "$response" | head -c 200)"
        return 1
    fi
}

# Function to try Gemini with a specific model
try_gemini() {
    local model="$1"
    local output_file="$2"
    local temp_file=$(mktemp)

    echo -e "${YELLOW}[post-commit]${NC} Trying $model..."

    # Run gemini and capture output
    if gemini -m "$model" $INCLUDE_DIRS "$REVIEW_PROMPT" > "$temp_file" 2>&1; then
        # Check if output contains capacity/quota errors
        if grep -qi "capacity\|quota\|429\|RESOURCE_EXHAUSTED" "$temp_file"; then
            echo -e "${YELLOW}[post-commit]${NC} $model: capacity exhausted"
            rm -f "$temp_file"
            return 1
        fi
        cat "$temp_file" >> "$output_file"
        rm -f "$temp_file"
        return 0
    else
        local exit_code=$?
        # Check for rate limit in output
        if grep -qi "capacity\|quota\|429\|RESOURCE_EXHAUSTED" "$temp_file"; then
            echo -e "${YELLOW}[post-commit]${NC} $model: capacity exhausted (exit $exit_code)"
        else
            echo -e "${YELLOW}[post-commit]${NC} $model: failed (exit $exit_code)"
        fi
        rm -f "$temp_file"
        return 1
    fi
}

# Main review logic with fallback chain
run_review_with_fallback() {
    local output_file="$1"
    local reviewer=""
    local success=false

    # Check if gemini CLI is available
    if command -v gemini &> /dev/null; then
        # Try Gemini 3 Pro first
        if try_gemini "gemini-3-pro-preview" "$output_file"; then
            reviewer="Gemini 3 Pro"
            success=true
        # Fall back to Gemini 3 Flash
        elif try_gemini "gemini-3-flash" "$output_file"; then
            reviewer="Gemini 3 Flash"
            success=true
        fi
    else
        echo -e "${YELLOW}[post-commit]${NC} Gemini CLI not found, trying local models"
    fi

    # Fall back to vLLM (if running)
    if [[ "$success" != "true" ]] && vllm_is_running; then
        echo -e "${YELLOW}[post-commit]${NC} Falling back to vLLM"
        if run_vllm_review "$output_file"; then
            reviewer="Local vLLM ($(vllm_model_name))"
            success=true
        else
            echo -e "${YELLOW}[post-commit]${NC} vLLM review failed, trying llama"
        fi
    fi

    # Fall back to local llama (last resort)
    if [[ "$success" != "true" ]]; then
        echo -e "${YELLOW}[post-commit]${NC} Falling back to local llama ($LLAMA_MODEL)"

        # Start llama if not running
        if ! llama_is_running; then
            if ! start_llama_server; then
                echo -e "${RED}[post-commit]${NC} All models failed"
                echo "" >> "$output_file"
                echo "*Review failed - all models unavailable*" >> "$output_file"
                return 1
            fi
        fi

        if run_llama_review "$output_file"; then
            reviewer="Local Llama ($LLAMA_MODEL)"
            success=true
        else
            echo -e "${RED}[post-commit]${NC} Local llama review failed"
            echo "" >> "$output_file"
            echo "*Review failed - see error above*" >> "$output_file"
            return 1
        fi
    fi

    # Return the reviewer name via global
    USED_REVIEWER="$reviewer"
    return 0
}

# Generate the review header
echo -e "${YELLOW}[post-commit]${NC} Running QA review on: $CHANGED_FILES"

cat << EOF > "$OUTPUT_FILE"
# Gemini QA Review: ${COMMIT_HASH}

**Date**: ${COMMIT_DATE}
**Commit**: \`${COMMIT_HASH}\` - ${COMMIT_MSG}
**Reviewer**: (pending)

## Changed Files

$(echo "$CHANGED_FILES" | sed 's/^/- /')

---

## Review

EOF

# Run the review with fallback
USED_REVIEWER=""
if run_review_with_fallback "$OUTPUT_FILE"; then
    # Update the reviewer in the header
    sed -i "s/\*\*Reviewer\*\*: (pending)/**Reviewer**: ${USED_REVIEWER} (automated post-commit hook)/" "$OUTPUT_FILE"
    echo -e "${GREEN}[post-commit]${NC} Review completed with $USED_REVIEWER"
else
    sed -i "s/\*\*Reviewer\*\*: (pending)/**Reviewer**: Failed (all models unavailable)/" "$OUTPUT_FILE"
fi

echo "" >> "$OUTPUT_FILE"
echo "---" >> "$OUTPUT_FILE"
echo "*Generated automatically by post-commit hook*" >> "$OUTPUT_FILE"

echo -e "${GREEN}[post-commit]${NC} QA review saved to: $OUTPUT_FILE"

exit 0
