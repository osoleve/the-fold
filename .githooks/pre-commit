#!/usr/bin/env bash
# Pre-commit hook for The Fold
# Runs tests, lints, and checks before allowing commits
#
# Checks:
#   1. Scheme test suite (always)
#   2. Large file detection (always)
#   3. Layer boundary violations (when core/ or lattice/ .ss files staged)
#   4-6. Rust fmt/clippy/compile (when .rs files staged)
#
# Install: git config core.hooksPath .githooks

set -e

echo "Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Track failures
FAILED=0
CHECK_NUM=0

# Detect staged file types
RUST_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)
SCHEME_PURITY_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(core|lattice)/.*\.ss$' || true)

# Count total checks
TOTAL_CHECKS=2
[ -n "$SCHEME_PURITY_STAGED" ] && TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
[ -n "$RUST_STAGED" ] && TOTAL_CHECKS=$((TOTAL_CHECKS + 3))

# ============================================================================
# Check 1: Scheme test suite
# ============================================================================
CHECK_NUM=$((CHECK_NUM + 1))
echo -e "${YELLOW}[$CHECK_NUM/$TOTAL_CHECKS]${NC} Running Scheme test suite..."
if scheme --script test-all.ss > /dev/null 2>&1; then
    echo -e "  ${GREEN}✓${NC} All tests passed"
else
    echo -e "  ${RED}✗${NC} Tests failed"
    echo "  Run 'scheme --script test-all.ss' to see details"
    FAILED=1
fi

# ============================================================================
# Check 2: Large file detection
# ============================================================================
CHECK_NUM=$((CHECK_NUM + 1))
echo -e "${YELLOW}[$CHECK_NUM/$TOTAL_CHECKS]${NC} Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only --diff-filter=A | while read f; do
    if [ -f "$f" ]; then
        size=$(wc -c < "$f")
        if [ "$size" -gt 512000 ]; then
            echo "$f ($(( size / 1024 ))KB)"
        fi
    fi
done)
if [ -n "$LARGE_FILES" ]; then
    echo -e "  ${RED}✗${NC} Large files detected (>500KB):"
    echo "$LARGE_FILES" | sed 's/^/      /'
    FAILED=1
else
    echo -e "  ${GREEN}✓${NC} No large files"
fi

# ============================================================================
# Check 3: Layer boundary violations
# ============================================================================
#
# Architecture: boundary/ → lattice/ → core/
#   - core/ must not load from lattice/ or boundary/
#   - lattice/ must not load from boundary/
#
# Only checks newly added lines in staged files.
# Test files (test-*) and bench files (bench-*) are exempt.
# Known exceptions listed in .githooks/purity-exceptions.
#
if [ -n "$SCHEME_PURITY_STAGED" ]; then
    CHECK_NUM=$((CHECK_NUM + 1))
    echo -e "${YELLOW}[$CHECK_NUM/$TOTAL_CHECKS]${NC} Checking layer boundary violations..."

    EXCEPTIONS_FILE=".githooks/purity-exceptions"
    VIOLATIONS=""

    for file in $SCHEME_PURITY_STAGED; do
        # Skip test and bench files — they legitimately need boundary I/O
        bname=$(basename "$file")
        case "$bname" in
            test-*|bench-*) continue ;;
        esac

        # Check if file is in the exceptions list
        if [ -f "$EXCEPTIONS_FILE" ] && grep -q "^${file}" "$EXCEPTIONS_FILE" 2>/dev/null; then
            continue
        fi

        # Rule 1: core/ must not load from lattice/ or boundary/
        if echo "$file" | grep -q '^core/'; then
            hits=$(git diff --cached -U0 "$file" | grep '^\+' | grep -v '^\+\+\+' | grep -E '\(load "(lattice|boundary)/' || true)
            if [ -n "$hits" ]; then
                VIOLATIONS="${VIOLATIONS}  ${file}: core/ cannot load from lattice/ or boundary/\n"
                while IFS= read -r line; do
                    VIOLATIONS="${VIOLATIONS}    ${line}\n"
                done <<< "$hits"
            fi
        fi

        # Rule 2: lattice/ must not load from boundary/
        if echo "$file" | grep -q '^lattice/'; then
            hits=$(git diff --cached -U0 "$file" | grep '^\+' | grep -v '^\+\+\+' | grep -E '\(load "boundary/' || true)
            if [ -n "$hits" ]; then
                VIOLATIONS="${VIOLATIONS}  ${file}: lattice/ cannot load from boundary/\n"
                while IFS= read -r line; do
                    VIOLATIONS="${VIOLATIONS}    ${line}\n"
                done <<< "$hits"
            fi
        fi
    done

    if [ -n "$VIOLATIONS" ]; then
        echo -e "  ${RED}✗${NC} Layer boundary violations detected:"
        echo -e "$VIOLATIONS"
        echo -e "  The architecture requires: boundary/ → lattice/ → core/"
        echo -e "  If this is intentional, add the file to ${EXCEPTIONS_FILE}"
        FAILED=1
    else
        echo -e "  ${GREEN}✓${NC} No layer violations"
    fi

    # Check for stale exceptions — files listed but no longer violating.
    # This ensures the exceptions list tightens as violations get fixed.
    STALE=""
    if [ -f "$EXCEPTIONS_FILE" ]; then
        while IFS= read -r line; do
            # Skip comments and blank lines
            case "$line" in \#*|"") continue ;; esac
            # Extract file path (first field, before any comment)
            efile=$(echo "$line" | awk '{print $1}')
            [ -z "$efile" ] && continue

            # File deleted? Exception is stale.
            if [ ! -f "$efile" ]; then
                STALE="${STALE}  ${efile}  (file no longer exists)\n"
                continue
            fi

            # Check if the file still actually has a violation
            still_violates=""
            if echo "$efile" | grep -q '^core/'; then
                still_violates=$(grep -E '\(load "(lattice|boundary)/' "$efile" 2>/dev/null || true)
            elif echo "$efile" | grep -q '^lattice/'; then
                still_violates=$(grep -E '\(load "boundary/' "$efile" 2>/dev/null || true)
            fi

            if [ -z "$still_violates" ]; then
                STALE="${STALE}  ${efile}  (violation has been fixed!)\n"
            fi
        done < "$EXCEPTIONS_FILE"
    fi

    if [ -n "$STALE" ]; then
        echo -e "  ${YELLOW}!${NC} Stale purity exceptions (remove from ${EXCEPTIONS_FILE}):"
        echo -e "$STALE"
        FAILED=1
    fi
fi

# ============================================================================
# Checks 4-6: Rust (only if .rs files staged)
# ============================================================================
if [ -n "$RUST_STAGED" ]; then
    RUST_DIR="boundary/ffi/rust-accel"

    CHECK_NUM=$((CHECK_NUM + 1))
    echo -e "${YELLOW}[$CHECK_NUM/$TOTAL_CHECKS]${NC} Checking Rust formatting..."
    if (cd "$RUST_DIR" && cargo fmt --check > /dev/null 2>&1); then
        echo -e "  ${GREEN}✓${NC} Rust code formatted correctly"
    else
        echo -e "  ${RED}✗${NC} Rust formatting issues found"
        echo "  Run 'cd $RUST_DIR && cargo fmt' to fix"
        FAILED=1
    fi

    CHECK_NUM=$((CHECK_NUM + 1))
    echo -e "${YELLOW}[$CHECK_NUM/$TOTAL_CHECKS]${NC} Running Clippy lints..."
    if (cd "$RUST_DIR" && cargo clippy --all-targets 2>&1 | grep -q "^error"); then
        echo -e "  ${RED}✗${NC} Clippy found errors"
        echo "  Run 'cd $RUST_DIR && cargo clippy --all-targets' to see details"
        FAILED=1
    else
        echo -e "  ${GREEN}✓${NC} Clippy passed (warnings allowed)"
    fi

    CHECK_NUM=$((CHECK_NUM + 1))
    echo -e "${YELLOW}[$CHECK_NUM/$TOTAL_CHECKS]${NC} Checking Rust compiles..."
    if (cd "$RUST_DIR" && cargo check > /dev/null 2>&1); then
        echo -e "  ${GREEN}✓${NC} Rust compiles successfully"
    else
        echo -e "  ${RED}✗${NC} Rust compilation failed"
        echo "  Run 'cd $RUST_DIR && cargo check' to see errors"
        FAILED=1
    fi
fi

# ============================================================================
# Summary
# ============================================================================
echo ""
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}Pre-commit checks failed.${NC}"
    echo "Fix the issues above or commit with --no-verify to skip."
    exit 1
else
    echo -e "${GREEN}All pre-commit checks passed.${NC}"
    exit 0
fi
