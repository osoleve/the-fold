#!/usr/bin/env bash
# Pre-commit hook for The Fold
# Runs the test suite before allowing commits
#
# Install: git config core.hooksPath .githooks
# Or use pre-commit framework: pip install pre-commit && pre-commit install

set -e

echo "Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track failures
FAILED=0

# 1. Run the test suite
echo -e "${YELLOW}[1/3]${NC} Running test suite..."
if scheme --script test-all.ss > /dev/null 2>&1; then
    echo -e "  ${GREEN}✓${NC} All tests passed"
else
    echo -e "  ${RED}✗${NC} Tests failed"
    echo "  Run 'scheme --script test-all.ss' to see details"
    FAILED=1
fi

# 2. Check for debug prints in core/lattice
echo -e "${YELLOW}[2/3]${NC} Checking for debug prints..."
if grep -rn "^\s*(display " --include="*.ss" core/ lattice/ 2>/dev/null; then
    echo -e "  ${RED}✗${NC} Found debug prints (see above)"
    FAILED=1
else
    echo -e "  ${GREEN}✓${NC} No debug prints found"
fi

# 3. Check for large files being added
echo -e "${YELLOW}[3/3]${NC} Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only --diff-filter=A | while read f; do
    if [ -f "$f" ]; then
        size=$(wc -c < "$f")
        if [ "$size" -gt 512000 ]; then
            echo "$f ($(( size / 1024 ))KB)"
        fi
    fi
done)
if [ -n "$LARGE_FILES" ]; then
    echo -e "  ${RED}✗${NC} Large files detected (>500KB):"
    echo "$LARGE_FILES" | sed 's/^/      /'
    FAILED=1
else
    echo -e "  ${GREEN}✓${NC} No large files"
fi

# Summary
echo ""
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}Pre-commit checks failed.${NC}"
    echo "Fix the issues above or commit with --no-verify to skip."
    exit 1
else
    echo -e "${GREEN}All pre-commit checks passed.${NC}"
    exit 0
fi
