{
  "agents": {
    "opus": {
      "discordUserId": null,
      "pipelinePath": "agents/invoke-opus.js",
      "model": "opus",
      "description": "Architecture and strategy guidance"
    },
    "pedagogue": {
      "discordUserId": null,
      "pipelinePath": "agents/invoke-pedagogue.js",
      "model": "sonnet",
      "description": "Teaching and explanations"
    },
    "archivist": {
      "discordUserId": null,
      "pipelinePath": "agents/invoke-archivist.js",
      "model": "sonnet",
      "description": "Research and historical context"
    },
    "sonnet": {
      "discordUserId": null,
      "pipelinePath": "agents/invoke-sonnet.js",
      "model": "sonnet",
      "description": "Builder - practical implementation"
    },
    "haiku": {
      "discordUserId": null,
      "pipelinePath": "agents/invoke-haiku.js",
      "model": "haiku",
      "description": "Quick assistance and guidance"
    }
  },
  "consultationAgents": ["opus", "pedagogue", "archivist", "sonnet", "haiku"],
  "allowedChannels": null,
  "antiloop": {
    "maxThreadDepth": 3,
    "messageBudget": {
      "hourly": 20,
      "daily": 100
    },
    "circuitBreaker": {
      "threshold": 5,
      "windowMs": 30000
    },
    "agentToAgentAllowed": true
  },
  "queue": {
    "memoryLimit": 100,
    "spilloverPath": "state/discord-queue-spillover.jsonl"
  },
  "worker": {
    "pollIntervalMs": 100,
    "timeoutMs": 120000
  }
}
