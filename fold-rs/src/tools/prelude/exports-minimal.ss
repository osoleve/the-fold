 (cons 'cddar cddar)
 (cons 'cdddr cdddr)
 (cons 'caaaar caaaar)
 (cons 'caaadr caaadr)
 (cons 'caadar caadar)
 (cons 'caaddr caaddr)
 (cons 'cadaar cadaar)
 (cons 'cadadr cadadr)
 (cons 'caddar caddar)
 (cons 'cadddr cadddr)
 (cons 'cdaaar cdaaar)
