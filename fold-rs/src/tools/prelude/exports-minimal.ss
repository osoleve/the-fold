 ; Function combinators
 (cons 'id id)
 (cons 'const const)
 (cons 'compose compose)
 (cons 'pipe pipe)
 (cons 'flip flip)
 (cons 'complement complement)
 (cons 'curry2 curry2)
 (cons 'uncurry2 uncurry2)
