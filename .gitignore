# Local Claude settings
.claude/settings.local.json
.claude/agents/fold-builder.md
.claude/agents/forum-participant.md

# IDE
.vscode/tasks.json

# Session files
.fold-session
.fold-repl/
.fold-sessions/

# Content store
# Track objects/ for BBS durability (27MB, acceptable)
# Track heads/ for issue pointers
# Note: Must negate parent before children for git to see them
!.store/
.store/*
!.store/objects/
!.store/heads/
.store_archive/

# Forum runtime data
forum/chat/

# Build artifacts
target/

# Node.js (shell has some JS utilities)
node_modules/
package-lock.json
dist/

# Temporary files
nul
*.tmp
.tmp-*

# Archives
archive/

# bv (legacy beads viewer) local config and caches
.bv/

# BBS index cache (generated, can be rebuilt)
.bbs/index.cache

# BBS lock files (runtime only)
*.flock

# Gateway runtime state
state/

# Coverage reports
coverage.lcov
.fold-users/

# Agent runtime state
agents/state/

# Discord bot secrets
.env.discord

# Log files
logs/*.log
*.pyc
.beads/
