# Claude Code
.claude/settings.local.json
.claude/*.local.md
.claude/worktrees/

# IDE
.vscode/

# Session and runtime state
.fold/
.fold-session
.fold-repl/
.fold-sessions/
.rlm/
.bbs/counter
.bbs/index.cache
*.flock

# Content store (selective tracking)
# Track objects/ for BBS durability and heads/bbs/ for issue pointers
# Must negate parent before children for git to see them
!.store/
.store/*
!.store/objects/
!.store/heads/
.store/heads/history/
.store_archive/

# Build artifacts
target/
node_modules/
package.json
package-lock.json
dist/

# Python
*.pyc
__pycache__/

# Temporary files
*.tmp
.tmp-*
.test-cache/

# Logs
*.log

# Secrets
.env.*

# Generated outputs
docs/peer-review/
docs/*.html
data/

# Generated reports
user/prism-reports/
user/rlm/lens-exploration/

# W&B and sweep logs
user/rlm/wandb/
user/rlm/sweeps/

# Training artifacts (regenerate with scripts in user/rlm/)
user/rlm/training/
!user/rlm/training/*.py
user/rlm/models/
user/rlm/bench-results-*.sexp
user/rlm/*.jsonl
user/rlm/curriculum/*.jsonl
user/rlm/curriculum/lattice-tasks/
user/rlm/curriculum/lattice-meta.json
user/rlm/pytorch-ft/trainer_output/
user/rlm/pytorch-ft/models/

# Media artifacts
user/creations/*.gif
user/creations/*.mp4
user/creations/*.txt

# Local plugins (not part of the repo)
vllm-spark-plugin/
