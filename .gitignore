# Local Claude settings
.claude/settings.local.json
.claude/*.local.md

# Git worktrees
.worktrees/

# IDE
.vscode/tasks.json

# Session files
.fold-session
.fold-repl/
.fold-sessions/

# Content store
# Track objects/ for BBS durability (27MB, acceptable)
# Track heads/bbs/ for issue pointers
# Note: Must negate parent before children for git to see them
!.store/
.store/*
!.store/objects/
!.store/heads/
.store/heads/history/
.store/heads/flashmob/
.store_archive/

# Local CAS working directory
.fold/

# Build artifacts
target/

# Node.js (shell has some JS utilities)
node_modules/
package-lock.json
dist/

# Temporary files
nul
*.tmp
.tmp-*

# Archives
archive/

# BBS runtime state (counters, caches)
.bbs/counter
.bbs/index.cache

# Flashmob runtime state
.flashmob/

# BBS lock files (runtime only)
*.flock

# Gateway runtime state
state/

# Coverage reports
coverage.lcov
.fold-users/

# Agent runtime state
agents/state/

# Discord bot secrets
.env.discord

# Log files
logs/*.log
*.pyc
.beads/

# Generated training data (regenerate with gen-discovery.ss / sft-synth.ss)
user/rlm/training/

# Generated QA reviews (post-commit hook output)
docs/peer-review/

# Visual artifacts
user/creations/*.gif
user/creations/*.mp4
user/creations/*.txt
user/demos/lorenz-butterfly-hq.mp4
llama-spark-plugin/
