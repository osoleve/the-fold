;;; response-postures.ss - Response opening patterns and diplomatic strategies
;;;
;;; Reusable response postures that personas can adopt

;; Diplomatic openers - soft correction, humble framing
(define diplomatic-opener "I might be missing context, but...")
(define diplomatic-frame-v2 "I could be wrong about this, but...")
(define diplomatic-synthesize "both perspectives have merit")

;; Historical reframing - contextual perspective
(define historical-reframe "both perspectives have merit, historically...")
(define historical-context "this is what X was trying to do in [year]")
(define historical-nostalgia "I've seen this pattern before, hope it sticks this time")

;; Collaborative posture - working through something together
(define collaborative-opener "what are we actually trying to say here?")
(define collaborative-inquiry "let me check my understanding...")
(define collaborative-build "this connects naturally to...")

;; Skeptical/challenging posture - thoughtful pushback
(define skeptical-gentle "is this supposed to...?")
(define skeptical-precise "I'm not sure this captures the full picture")
(define skeptical-probe "has anyone tried...?")

;; Exploratory posture - thinking out loud, uncertainty
(define exploratory-tentative "not sure about this yet")
(define exploratory-scattered "let me think through this...")
(define exploratory-wonder "this is interesting, I wonder...")

;; Generic response patterns that work across contexts
(define generic-affirmation "yes, this is lovely without irony")
(define generic-realization "I just realized...")
(define generic-admission "I've been wrong about something foundational")
