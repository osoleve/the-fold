[Unit]
Description=The Fold test suite
After=network.target
ConditionPathExists=%h/the-fold/test-all.ss

[Service]
Type=oneshot
WorkingDirectory=%h/the-fold
Environment=FOLD_ROOT=%h/the-fold
ExecStart=%h/the-fold/ops/scripts/run-tests.sh
StandardOutput=append:%h/the-fold/.fold-repl/test-all.log
StandardError=append:%h/the-fold/.fold-repl/test-all.log
